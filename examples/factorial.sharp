mod main;

// a function, a loop, and numbers put into text
def main() {
    for(n : decimal = 0; n <= 20; n++) {
        println("" + n + "! is " + factorial(n));
    }
}

def factorial(n: decimal) : decimal {
    result : decimal = 1;
    for(i : decimal = 2; i <= n; i++) {
        result = result * i;
    }
    return result;
}
