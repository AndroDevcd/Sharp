mod main;

import (
    std.io,
    std.system
)

// write a file, read it back, copy it, and clean up
def main() {
    folder := platform_info.temp_directory();
    source := new file(folder + "/sharp_example_input.txt");
    copy := new file(folder + "/sharp_example_output.txt");

    try {
        source.write_text("first line\nsecond line\n");

        words := source.read_text();
        copy.write_text(words);                         // or, without reading it: source.copy_to(copy);

        println("copied " + words.size() + " characters:");
        print(copy.read_text());
    } catch(e: exception) {
        println("the copy failed: " + e.get_message());
    }

    source.remove();
    copy.remove();
}
