mod main;

import (
    std.io
)

count := new atomic_counter();          // a number several threads may change at once

def count_up(args: object[]) : decimal {
    for(i : decimal = 0; i < 1000; i++) {
        count.increment();
    }
    return 0;
}

/**
 * Two threads add to the same number. With a plain number some additions
 * would be lost; an atomic_counter makes each one whole. (For an object
 * shared between threads there is atomic_ref<t>.)
 */
def main() {
    first := new thread("counter 1", count_up);
    second := new thread("counter 2", count_up);
    first.start();
    second.start();
    first.join();
    second.join();
    println("count = " + count.read());    // always 2000
}
