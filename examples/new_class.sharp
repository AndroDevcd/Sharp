mod main;

/**
 * A class: fields, a constructor, an init block, functions, and a static
 * part shared by every object.
 */
class coffee {
    static cups_made : decimal = 0;             // one number for the whole class

    water : decimal;                            // a field, set by the constructor
    grounds : decimal = 15;                     // a field with a value to start with

    // an init block runs for every new object, before the constructor
    init {
        cups_made = cups_made + 1;
    }

    coffee(ounces: decimal) {
        water = ounces;
    }

    // a second constructor: a small cup
    coffee() {
        water = 6;
    }

    def brew() {
        println("brewing with " + water + " oz of water and " + grounds + " g of coffee");
    }

    def stronger() : coffee {
        grounds = grounds + 5;
        return self;                            // giving itself back lets calls be chained
    }
}

def main() {
    small := new coffee();
    small.brew();

    large := new coffee(12);
    large.stronger().stronger().brew();

    println("" + coffee.cups_made + " cups made");
}
