mod main;

import (
    std.text
)

// text to numbers and numbers to text
def main() {
    // text to a whole number
    count : decimal = number_parser.parse_int("100500");
    println("count + 1 = " + (count + 1));

    // text to a number with a fraction
    price : decimal = number_parser.parse_double("100.5");
    println("price * 2 = " + (price * 2));

    // text that is not a number: ask for a fallback instead of an exception
    println("not a number gives " + number_parser.parse_int_or("twelve", 0));

    // a number to text: putting it next to text is enough
    words : string = "" + count;
    println("as text it has " + words.size() + " characters");

    // a number to text with a fixed number of decimals
    println("two decimals: " + number_format.fixed(3.14159, 2));
}
