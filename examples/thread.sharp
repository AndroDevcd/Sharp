mod main;

import (
    std.io
)

// called when a thread ends with an exception nobody caught
class report_it : uncaught_exception_handler {
    override def uncaught_exception(err: throwable) {
        println("a thread failed: " + err.get_message());
    }
}

def greet(args: object[]) : decimal {
    println("hello from a thread");
    return 0;
}

def fail(args: object[]) : decimal {
    throw new error("something went wrong");
}

/**
 * Threads: a function run beside the rest of the program. join() waits for
 * one to finish. (For most background work coroutines are lighter: see
 * coroutines.sharp.)
 */
def main() {
    first := new thread("greeter", greet);
    first.start();
    first.join();

    // a thread can be given a block instead of a named function
    second := new thread("block", { args -> (decimal)
        println("hello from a block");
        return 0;
    });
    second.start();
    second.join();

    // an exception that leaves a thread goes to its handler
    third := new thread("failing", fail);
    third.set_exception_handler(new report_it());
    third.start();
    third.join();

    println("all three are done");
}
