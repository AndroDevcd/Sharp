mod main;

import (
    std.math
)

/**
 * A small neural network that learns "exclusive or": 1 when its two inputs
 * differ, 0 when they are the same. It is trained on 5000 random pairs and
 * then asked the four questions.
 *
 * Classes, lists of objects, arrays of numbers and the math functions, in
 * one program.
 */
alias list<neuron> as layer;

// one wire from a neuron to a neuron of the next layer
class connection {
    weight : decimal;
    last_change : decimal;
}

class neuron {
    static learning_rate : decimal = 0.35;
    static momentum : decimal = 0.5;

    output : decimal;
    gradient : decimal;
    index : decimal;                                // its place in its layer
    wires := new list<connection>();                // one to each neuron of the next layer

    neuron(outputs: decimal, place: decimal) {
        for(i : decimal = 0; i < outputs; i++) {
            wire := new connection();
            wire.weight = rand_unit();
            wires.add(wire);
        }
        index = place;
    }

    // its output from the layer before: the weighted sum, squeezed into -1 .. 1
    def feed_forward(before: layer) {
        sum : decimal = 0;
        foreach(from in before) {
            sum = sum + from.output * from.wires.at(index).weight;
        }
        output = tanh(sum);
    }

    def slope(x: decimal) : decimal {
        return 1.0 - x * x;
    }

    def output_gradient(wanted: decimal) {
        gradient = (wanted - output) * slope(output);
    }

    def hidden_gradient(next: layer) {
        sum : decimal = 0;
        for(n : decimal = 0; n < next.size() - 1; n++) {
            sum = sum + wires.at(n).weight * next.at(n).gradient;
        }
        gradient = sum * slope(output);
    }

    // move the weights that lead INTO this neuron a little towards a better answer
    def learn(before: layer) {
        foreach(from in before) {
            wire := from.wires.at(index);
            change : decimal = learning_rate * from.output * gradient + momentum * wire.last_change;
            wire.last_change = change;
            wire.weight = wire.weight + change;
        }
    }
}

class net {
    layers := new list<layer>();

    // sizes: how many neurons each layer has; every layer gets one more that is always 1 (the bias)
    net(sizes: decimal[]) {
        for(l : decimal = 0; l < sizeof(sizes); l++) {
            made := new layer();
            outputs : decimal = 0;
            if(l < sizeof(sizes) - 1) { outputs = sizes[l + 1]; }
            for(n : decimal = 0; n <= sizes[l]; n++) {
                made.add(new neuron(outputs, n));
            }
            made.last().output = 1;
            layers.add(made);
        }
    }

    def feed_forward(inputs: decimal[]) {
        for(i : decimal = 0; i < sizeof(inputs); i++) {
            layers.at(0).at(i).output = inputs[i];
        }
        for(l : decimal = 1; l < layers.size(); l++) {
            before := layers.at(l - 1);
            for(n : decimal = 0; n < layers.at(l).size() - 1; n++) {
                layers.at(l).at(n).feed_forward(before);
            }
        }
    }

    def back_propagate(wanted: decimal[]) {
        last := layers.last();
        for(n : decimal = 0; n < last.size() - 1; n++) {
            last.at(n).output_gradient(wanted[n]);
        }
        for(l : decimal = layers.size() - 2; l > 0; l--) {
            hidden := layers.at(l);
            for(n : decimal = 0; n < hidden.size(); n++) {
                hidden.at(n).hidden_gradient(layers.at(l + 1));
            }
        }
        for(l : decimal = layers.size() - 1; l > 0; l--) {
            for(n : decimal = 0; n < layers.at(l).size() - 1; n++) {
                layers.at(l).at(n).learn(layers.at(l - 1));
            }
        }
    }

    def answer() : decimal {
        return layers.last().at(0).output;
    }
}

def main() {
    set_seed(7);                                    // the same training every run
    brain := new net(new decimal[] { 2, 4, 1 });

    for(round : decimal = 0; round < 5000; round++) {
        a : decimal = rand_index(2);
        b : decimal = rand_index(2);
        brain.feed_forward(new decimal[] { a, b });
        brain.back_propagate(new decimal[] { a != b ? 1 : 0 });
    }

    println("exclusive or, as the network learned it:");
    right : decimal = 0;
    for(a : decimal = 0; a < 2; a++) {
        for(b : decimal = 0; b < 2; b++) {
            brain.feed_forward(new decimal[] { a, b });
            said : decimal = brain.answer() > 0.5 ? 1 : 0;
            wanted : decimal = a != b ? 1 : 0;
            if(said == wanted) { right++; }
            println("  " + a + " xor " + b + " = " + said);
        }
    }
    println("" + right + " of 4 right");
}
