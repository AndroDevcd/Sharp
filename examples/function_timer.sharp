mod main;

import (
    std.io,
    std.time
)

def timed_func() { // perform a computation for a random amount of time
    for(i := 0; i < 1_000_000; i++) {}
    thread.sleep(rand_int(0, 3) * 1000); // sleep for a random amount of time between 1 - 3 seconds
}

/**
 * This program shows how to time the execution of a program
 *
 * Here we use the 'measure_time' function of std.time to measure how long
 * the code took. What it gives is a duration: to_string() writes it as
 * "2.004s", to_millis() gives the milliseconds as a number.
 */
def main() {
   took := measure_time { timed_func(); };
   println("function took " + took.to_string());
}
