mod main;

import (
    std.io,
    std.time
)

// work that takes a moment
def slow_work() {
    total : decimal = 0;
    for(i : decimal = 0; i < 1000000; i++) {
        total = total + i;
    }
    thread.sleep(200);          // and a fifth of a second of waiting
}

/**
 * How long did that take? measure_time { } runs a block and gives a duration:
 * to_string() writes it as "0.204s", to_millis() gives the milliseconds.
 */
def main() {
    took := measure_time { slow_work(); };
    println("the work took " + took.to_string());
    if(took.to_millis() >= 200) {
        println("that is at least the 200 ms it waited");
    }
}
