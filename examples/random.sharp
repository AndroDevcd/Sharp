mod main;

// random numbers from the standard library
def main() {
    set_seed(utc_mills().value % 1000000);               // a different sequence every run (leave it out, or give
                                                // the same number, for the same sequence every time)

    println("0 to 1:        " + rand_unit());
    println("a die:         " + rand_range(1, 6));
    println("a coin:        " + rand_bool());
    println("an index of 5: " + rand_index(5));
    println("a password:    " + rand_string(12));

    cards := new decimal[] { 1, 2, 3, 4, 5 };
    rand_shuffle(cards);
    print("shuffled:      ");
    foreach(card in cards) {
        print("" + card + " ");
    }
    println("");
}
