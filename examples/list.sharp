mod main;

/**
 * A class of your own that works in a `foreach`: it implements loopable<t>
 * and hands over its elements.
 */
class countdown : loopable<decimal> {
    private numbers : decimal[];

    countdown(from: decimal) {
        numbers = new decimal[from];
        for(i : decimal = 0; i < from; i++) {
            numbers[i] = from - i;
        }
    }

    override def get_elements() : decimal[]? {
        return numbers;
    }
}

// the standard library's list<t>: add, read, sort, loop
def main() {
    numbers := new list<int>();
    numbers.add(1);
    numbers.add(10);
    numbers.add(3);
    numbers.add(2);

    println("as added:");
    for(i : decimal = 0; i < numbers.size(); i++) {
        println("  " + i + ": " + numbers.at(i));
    }

    // sort takes a comparison of two elements: below zero when a comes first
    numbers.sort({ a, b -> return a.value - b.value; });

    println("sorted:");
    foreach(n in numbers) {
        println("  " + n);
    }

    println("a class of our own in a foreach:");
    foreach(n in new countdown(3)) {
        println("  " + n);
    }
}
