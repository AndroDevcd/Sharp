/*
* memcopy(src, dest, dest_start, src_start, src_end): the elements src[src_start .. src_end - 1]
* are copied to dest, from dest[dest_start] on. One version per kind of array.
*
* KNOWN TO THE COMPILER BY NAME. With -O the compiler shares a text literal
* that is only ever read (compiler/backend/optimizer/passes/calls/
* shared_literals.sharp). It cannot read an `asm` body, so it is TOLD that
* every `memcopy` of this module only reads its FIRST argument, `src`.
* Keep that true: a memcopy that writes into `src`, keeps a reference to it
* or hands it to something that does would change shared literals under the
* program's feet. (`dest` is written, and the compiler knows that.) If this
* ever has to change, change `find_read_only_arguments` in that file too.
*/
def memcopy(src: object[], dest: object[],  dest_start: _int32, src_start: _int32, src_end: _int32) {
    asm {
        pushl [dest]
        pushl [src]
        ipushl [dest_start]
        ipushl [src_start]
        ipushl [src_end]
        int 0x21
    }
}

def memcopy(src: decimal[], dest: decimal[],  dest_start: _int32, src_start: _int32, src_end: _int64) {
    asm {
        pushl [dest]
        pushl [src]
        ipushl [dest_start]
        ipushl [src_start]
        ipushl [src_end]
        int 0x21
    }
}

