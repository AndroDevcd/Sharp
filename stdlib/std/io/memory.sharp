def copy(src: object, src_start: _int32, src_end: _int32) : object? {
    asm {
        pushl [src]
        ipushl [src_start]
        ipushl [src_end]
        int 0x37
        popObj2
        returnObj
        ret 0
    }

    return null; // to satisfy the compiler
}

