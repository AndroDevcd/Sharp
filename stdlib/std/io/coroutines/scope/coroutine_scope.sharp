mod std.io.coroutines;

/**
 * coroutine_scope - an object that owns coroutines, so that they can be
 * cancelled and waited for as a unit. Give one to everything that has a life
 * time: a connection, a window, a request.
 *
 * USAGE
 *     class connection {
 *         scope := new coroutine_scope();
 *
 *         def open() {
 *             scope.launch(self, { s: object -> c := s as connection; c.read_loop(); });
 *             scope.launch(self, { s: object -> c := s as connection; c.ping_loop(); });
 *         }
 *
 *         def close() {
 *             scope.cancel_and_join();         // both loops have stopped when this returns
 *         }
 *     }
 *
 * A failing coroutine cancels the scope and with it all the others, unless the
 * scope was made with coroutine_scope.supervisor(). The scope's own job has no
 * code: it is active until cancel() or complete() is called.
 *
 * The coroutines run on other fibers: THE CLOSURE RULE (builders.sharp)
 * applies to the blocks handed to launch().
 *
 * Kotlin equivalent: CoroutineScope(Job() + dispatcher) / CoroutineScope(SupervisorJob()).
 * (The function coroutine_scope { } in scopes.sharp is Kotlin's coroutineScope { }.)
 *
 * LOCKING DISCIPLINE: the only state is the job, which locks itself.
 */
class coroutine_scope {

    private scope_job : job?;

    /** A scope whose coroutines run on the default pool. */
    coroutine_scope() {
        setup(dispatchers.default_pool(), 0);
    }

    /** A scope whose coroutines run on `where`. */
    coroutine_scope(where: coroutine_dispatcher) {
        setup(where, 0);
    }

    private def setup(where: coroutine_dispatcher, supervising: decimal) {
        created := new job();
        created.dispatcher = where;
        created.supervisor = supervising;
        scope_job = created;
    }

    /** A scope in which a failing coroutine does not cancel the others. Kotlin: CoroutineScope(SupervisorJob()) */
    static def supervisor() : coroutine_scope {
        scope := new coroutine_scope();
        scope.scope_job!!.supervisor = 1;
        return scope;
    }

    /** supervisor() with a dispatcher */
    static def supervisor(where: coroutine_dispatcher) : coroutine_scope {
        scope := new coroutine_scope(where);
        scope.scope_job!!.supervisor = 1;
        return scope;
    }

    /** the job that is the parent of every coroutine of this scope */
    def get_job() : job {
        return scope_job!!;
    }

    /** Start a coroutine in this scope. Does not suspend. In a cancelled scope the result is a cancelled job. Kotlin: scope.launch { } */
    def launch(block: ()()) : job {
        return start_coroutine(new job(block), scope_job, null);
    }

    /** launch() with a state object handed to the coroutine: block(state) */
    def launch(state: object?, block: (object)()) : job {
        return start_coroutine(new job(state, block), scope_job, null);
    }

    /** launch() for a coroutine_body object */
    def launch(task: coroutine_body) : job {
        return start_coroutine(new job(task), scope_job, null);
    }

    /** true until the scope is cancelled or completed. Kotlin: scope.isActive */
    def is_active() : bool {
        return scope_job!!.is_active();
    }

    /** number of coroutines of this scope that are not finished yet */
    def active_count() : decimal {
        return scope_job!!.child_count();
    }

    /** Cancel every coroutine of the scope; no new ones can be started afterwards. Does not suspend. Kotlin: scope.cancel() */
    def cancel() {
        scope_job!!.cancel();
    }

    /** Cancel the coroutines that are running now but keep the scope usable. Kotlin: coroutineContext.cancelChildren() */
    def cancel_children() {
        scope_job!!.cancel_children();
    }

    /** cancel(), then wait until every coroutine has stopped. SUSPENDS; a cancellation point for the caller. */
    def cancel_and_join() {
        scope_job!!.cancel_and_join();
    }

    /**
     * Wait until every coroutine that is in the scope right now is finished.
     * The scope stays open. SUSPENDS; a cancellation point for the caller.
     * Kotlin: scope.coroutineContext.job.children.forEach { it.join() }
     */
    def join_children() {
        kids := scope_job!!.children();
        for(i : decimal = 0; i < sizeof(kids); i++) {
            kids[i].join();
        }
    }

    /**
     * No more coroutines will be started: finish the scope when the running
     * ones are done, and wait for that. SUSPENDS; a cancellation point for
     * the caller. Kotlin: (job as CompletableJob).complete(); job.join()
     */
    def complete_and_join() {
        scope_job!!.complete();
        scope_job!!.join();
    }
}
