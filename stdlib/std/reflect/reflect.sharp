mod std.reflect;

import ( std.io )

/**
 * REFLECTION: a program looking at its own classes
 *
 *      shape := reflect.of<user>();                    // from a type
 *      shape := reflect.of(someone)!!;                 // from an object
 *      shape := reflect.find("app.models#user")!!;     // from a full name
 *
 *      foreach(field in shape.fields()) {
 *          print(field.name + " : " + field.type.name + "\n");     // "tags : list<string>"
 *      }
 *
 *      someone := reflect.create<user>("ann", new int(31));        // any constructor
 *      age := shape.field("age")!!;
 *      age.number(someone)                             // 31
 *      age.write(someone, 32);                         // checked: a wrong value is refused here
 *      shape.function("greet")!!.call(someone, "bob")  // what greet("bob") gives
 *
 *      view := reflect.on(someone);                    // one object, by names
 *      view.read("home.city")
 *      view.write("age", 33);
 *      view.to_text()                                  // user(name=ann, age=33, home=address(city=oslo))
 *
 * The classes: class_info (a class, an interface or an enum), field_info,
 * function_info, type_info (what a field, a parameter or a result is),
 * object_view (one object with its class), enum_value. Each is made the
 * first time it is asked for and kept; nothing is made when a program starts.
 *
 * WHAT IS IN THE PROGRAM. An executable holds only what its text uses: a
 * field no code names and a function no code calls are left out. Reflection
 * shows what is there, so code that works by NAMES says what it needs:
 *
 *      reflect.of<t>(), reflect.create<t>()    all of t stays: fields, functions, constructors
 *      reflects<t>()                           the fields of t and its constructor without
 *                                              parameters stay, and the same for the class of
 *                                              each field (what json.to<t> says)
 *      the compiler option -eager              everything stays (for reflect.find of any class)
 *
 * reflect.of(object) and reflect.find(name) always work, and show what stayed.
 *
 * Numbers. A value that is read or handed over as an `object` is an object: a
 * number travels as an `int`, `long`, `double` ... object (`new int(31)`), and
 * read() gives one back. number() and write(target, 31) take and give plain
 * numbers.
 *
 *      Java comparison: Class, Field, Method and Constructor of
 *      java.lang.reflect; Kotlin: KClass and its members.
 */
class reflect {
    /** one slot per class of the program: its class_info, once it was asked for */
    private static known : object[]?;
    private static keeper : reflect_keeper = new reflect_keeper();

    /**
     * The class the type `t` is. All of `t` stays in the program (see the top
     * of this file).
     *
     * @throws reflect_exception when t is not a class (a number, an array)
     */
    static def of<t>() : class_info {
        reflects_whole<t>();
        return of_token(new type_token<t>());
    }

    /** the class an object is of; null for null and for what is not an object of a class (an array) */
    static def of(target: object?) : class_info? {
        said := reflect_vm.class_of(target);
        if(said[1] < 0 || said[2] != 0) { return null; }
        return by_number(said[1]);
    }

    /** what an object is, also when it is an array or null (`nothing`) */
    static def type_of(target: object?) : type_info {
        said := reflect_vm.class_of(target);
        if(said[0] < 0) { return new type_info(type_info.NOTHING, 0 - 1, 0); }
        return new type_info(said[0], said[1], said[2]);
    }

    /** the class with a full name: "std#string", "app.models#user", "std#list<std#string>"; null when the program has none */
    static def find(full_name: string) : class_info? {
        id : _int64 = reflect_vm.find(full_name);
        if(id < 0) { return null; }
        return by_number(id);
    }

    /** every class the program holds */
    static def classes() : list<class_info> {
        all := new list<class_info>();
        count : _int64 = reflect_vm.facts(0, 0, 0)[0];
        for(id : _int64 = 0; id < count; id++) { all.add(by_number(id)); }
        return all;
    }

    /** one object together with its class, for work by names (object_view) */
    static def on(target: object) : object_view {
        return new object_view(target);
    }

    /** a new `t` made with its constructor without parameters */
    static def create<t>() : t {
        return of<t>().create() as t;
    }

    /** a new `t` made with the constructor that takes this */
    static def create<t>(first: object?) : t {
        return of<t>().create(first) as t;
    }

    static def create<t>(first: object?, second: object?) : t {
        return of<t>().create(first, second) as t;
    }

    static def create<t>(first: object?, second: object?, third: object?) : t {
        return of<t>().create(first, second, third) as t;
    }

    static def create<t>(first: object?, second: object?, third: object?, fourth: object?) : t {
        return of<t>().create(first, second, third, fourth) as t;
    }

    /** the class with a number (the VM's number for it; class_info.id) */
    static def by_number(id: _int64) : class_info {
        lock(keeper) {
            if(known == null) { known = new object[reflect_vm.facts(0, 0, 0)[0]]; }
            found : object? = known[id];
            if(found != null) { return found as class_info; }
            made := new class_info(id);
            known[id] = made;
            return made;
        }
        throw new reflect_exception("no class number " + id);
    }

    /** the class a token names: std.reflect#type_token<app#user> -> app#user */
    private static def of_token(token: object) : class_info {
        said := reflect_vm.class_of(token);
        name : string = reflect_vm.text(1, said[1], 0);
        inner : string = reflect_names.inside(name);
        id : _int64 = reflect_vm.find(inner);
        if(id < 0) { throw new reflect_exception("`" + inner + "` is not a class of this program (a number or an array has no class)"); }
        return by_number(id);
    }
}

/**
 * KNOWN TO THE COMPILER BY NAME (compiler, backend/finalizer/layout/kept.sharp):
 * for `t` and the class of every field under it, every field and the
 * constructor without parameters stay in the executable. What code says that
 * fills objects by the names in a text (json.to<t>). Does nothing at run time.
 */
def reflects<t>() { }

/**
 * KNOWN TO THE COMPILER BY NAME: all of `t` and of the classes above it stays
 * in the executable - fields, functions, constructors. What reflect.of<t>()
 * says. Does nothing at run time.
 */
def reflects_whole<t>() { }

/** what by_number locks while it looks a class up: two threads asking for one class get the same class_info */
class reflect_keeper {
    reflect_keeper() { }
}

/** an object whose class carries a type in its name; how reflect.of<t>() finds t without an object of it */
class type_token<t> {
    type_token() { }
}

/** what reflection refuses: a field given a wrong value, a function called with wrong arguments, a class that is not there */
class reflect_exception base exception {
    public reflect_exception(message : string?) -> base(message) {}
}

/** class names as the program holds them: "module#name<module#argument, ...>" */
class reflect_names {
    /** what stands between the first `<` and the last `>` ("" when there is none) */
    static def inside(name: string) : string {
        first : _int64 = 0 - 1;
        last : _int64 = 0 - 1;
        for(i : _int64 = 0; i < sizeof(name.data); i++) {
            if(name.data!![i] == '<' && first < 0) { first = i; }
            if(name.data!![i] == '>') { last = i; }
        }
        if(first < 0 || last <= first + 1) { return new string(""); }
        return io_strings.trim(new string(name.data!!, first + 1, last));
    }

    /** the parts of "a, b<c, d>, e" between the commas that are not inside `<...>` */
    static def parts(text: string) : list<string> {
        found := new list<string>();
        depth : _int64 = 0;
        start : _int64 = 0;
        for(i : _int64 = 0; i <= sizeof(text.data); i++) {
            at_end : decimal = i == sizeof(text.data);
            if(!at_end && text.data!![i] == '<') { depth++; }
            if(!at_end && text.data!![i] == '>') { depth--; }
            if(at_end || (text.data!![i] == ',' && depth == 0)) {
                if(i > start) { found.add(io_strings.trim(new string(text.data!!, start, i))); }
                start = i + 1;
            }
        }
        return found;
    }

    /** a full name without its modules: "std#list<app.models#user>" -> "list<user>" */
    static def short(full_name: string) : string {
        made := new string_builder();
        start : _int64 = 0;         // where the name being read began
        for(i : _int64 = 0; i <= sizeof(full_name.data); i++) {
            at_end : decimal = i == sizeof(full_name.data);
            ch : _int64 = at_end ? 0 : full_name.data!![i];
            if(ch == '#') { start = i + 1; continue; }
            if(at_end || ch == '<' || ch == '>' || ch == ',' || ch == ' ') {
                if(i > start) { made.append(new string(full_name.data!!, start, i)); }
                if(ch == ',') { made.append(", "); }
                else if(ch == '<' || ch == '>') { made.append(ch as _int8); }
                start = i + 1;
            }
        }
        return made.to_string()!!;
    }

    /** "home.city" -> home, city */
    static def steps(path: string) : list<string> {
        found := new list<string>();
        start : _int64 = 0;
        for(i : _int64 = 0; i <= sizeof(path.data); i++) {
            if(i == sizeof(path.data) || path.data!![i] == '.') {
                if(i > start) { found.add(new string(path.data!!, start, i)); }
                start = i + 1;
            }
        }
        return found;
    }

    /** "app.models#user" -> "app.models" ("" for a name without a module) */
    static def module_of(full_name: string) : string {
        for(i : _int64 = 0; i < sizeof(full_name.data); i++) {
            if(full_name.data!![i] == '<') { break; }
            if(full_name.data!![i] == '#') { return new string(full_name.data!!, 0, i); }
        }
        return new string("");
    }
}
