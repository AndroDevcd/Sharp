mod std.guikit.layout.scrolling;

import (
    std.guikit.*
)

/**
 * scroller - a window onto content that is bigger than the room there is.
 *
 *      scroll(modifier().fill()) {                       // scrolls up and down
 *          for(i : _int64 = 1; i <= 200; i++) { text("row " + i); }
 *      }
 *
 *      scroll_row(modifier().fill_width()) {             // scrolls sideways
 *          for(i : _int64 = 0; i < count; i++) { photo_card(i); }
 *      }
 *
 * The content is laid out at its full size along the scrolling direction; the
 * scroller shows the part that fits and lets the wheel (or dragging the bar)
 * move it. Give the scroller a limit that way - modifier().fill(), .grow(1),
 * .height(n) - otherwise it is simply as big as its content and there is
 * nothing to scroll.
 *
 * A sideways scroller moves with the wheel too (and with a sideways wheel or
 * touchpad swipe). When a scroller is already at its end, the turn of the
 * wheel is passed on to a scroller around it.
 *
 * HOW IT WORKS: the scroll position is `offset`, the number of pixels the
 * content has moved (up, or left). arrange() places the content that far
 * before the scroller's own corner, and the scroller is a `clipper`, so the
 * view paints the content cut off at the scroller's edges and the mouse
 * cannot reach things that are scrolled out. Scrolling changes `offset` and
 * arranges again - it does not rebuild anything.
 *
 * The offset is the scroller's own memory (not your state), so it implements
 * `stateful`: when the screen is rebuilt, the new scroller adopts the old
 * one's offset and the list stays where the user left it.
 *
 * Both directions are ONE class: `sideways` says which way is "along". The
 * few places that differ ask long_of_me() instead of naming width or
 * height. (Compose: Modifier.verticalScroll / horizontalScroll. Android:
 * ScrollView / HorizontalScrollView.)
 */
stable class scroller base widget : behavior, clipper, wheel_target, pointer_target, drag_scroller, stateful, overlay_painter {
    private sideways : _int64 = 0;          // 1: scrolls left-right; 0: up-down
    private offset : decimal = 0;           // how far the content is moved, in pixels
    private feel : stagger?;                // rows that trail behind while scrolling (null: one rigid sheet)
    private content_long : decimal = 0;     // the full size of the content along the scrolling direction
    private grab : decimal = 0 - 1;         // while the bar is dragged: where in the bar it was grabbed (-1: not dragging)

    private static const WHEEL_STEP : decimal = 48;     // pixels per wheel notch
    private static const BAR_THICK : decimal = 6;

    scroller(content: element, across: _int64) {
        attach(self);
        sideways = across;
        me.add_kid(content.node());
    }

    override def kind() : string {
        if(sideways == 1) { return "scroller-row"; }
        return "scroller";
    }

    override def clips() : _int64 { return 1; }

    override def measure(min_w: decimal, max_w: decimal, min_h: decimal, max_h: decimal) {
        // Across the scrolling direction the content gets the scroller's own
        // range. Along it, the content may be as big as it likes (0 ..
        // UNBOUNDED): that is the whole point. The scroller answers with the
        // content's size, and the view then pulls that into what the scroller
        // is allowed - the difference is what scrolls.
        content : view = me.kids.at(0);
        if(sideways == 1) { content.measure(0, UNBOUNDED, min_h, max_h); }
        else { content.measure(min_w, max_w, 0, UNBOUNDED); }
        me.content_w = content.want_w;
        me.content_h = content.want_h;
    }

    override def arrange() {
        content : view = me.kids.at(0);
        if(sideways == 1) { content_long = content.want_w; }
        else { content_long = content.want_h; }

        offset = num.between(offset, 0, furthest());
        if(sideways == 1) { content.arrange(num.nearest(me.inner_x() - offset), me.inner_y(), content.want_w, content.want_h); }
        else { content.arrange(me.inner_x(), num.nearest(me.inner_y() - offset), content.want_w, content.want_h); }
    }

    /** the scroller's own size along the scrolling direction */
    private def long_of_me() : decimal {
        if(sideways == 1) { return me.w; }
        return me.h;
    }

    /** the largest offset there is: the content's far edge at the scroller's far edge */
    private def furthest() : decimal {
        inner : decimal = me.inner_h();
        if(sideways == 1) { inner = me.inner_w(); }
        return num.larger(0, content_long - inner);
    }

    /** how the rows behave while scrolling: SCROLL_PLAIN (the default) or SCROLL_STAGGER (stagger.sharp) */
    def scroll_feel(how: _int64) : scroller {
        feel = null;
        if(how == SCROLL_STAGGER) { feel = new stagger(); }
        return self;
    }

    private def scroll_to(position: decimal) {
        moved : decimal = num.between(position, 0, furthest());
        if(moved != offset) {
            if(feel != null && sideways == 0) { feel!!.push(offset - moved); }     // the content moves the other way
            offset = moved;
            arrange();                                     // only this subtree moves; nothing is rebuilt
            if(ui_host.current != null) { ui_host.current!!.repaint(); }
        }
    }

    // ------------------------------------------------------------ the wheel

    override def wheel(dx: decimal, dy: decimal) : _int64 {
        if(furthest() <= 0) {
            return 0;                                      // nothing to scroll here: let an outer scroller have it
        }
        // up-down: the wheel. Sideways: a sideways wheel if there is one, else the ordinary wheel.
        turn : decimal = dy;
        if(sideways == 1 && dx != 0) { turn = 0 - dx; }

        before : decimal = offset;
        scroll_to(offset - turn * WHEEL_STEP);
        if(offset == before) {
            return 0;                                      // already at the end: an outer scroller may continue
        }
        return 1;
    }

    /** the content was dragged (a finger on a touch screen, or the mouse): move with it */
    override def drag_by(dx: decimal, dy: decimal) {
        if(grab >= 0) {
            return;                                        // the BAR is being dragged: that is handled in pointer()
        }
        if(sideways == 1) { scroll_to(offset - dx); }
        else { scroll_to(offset - dy); }
    }

    // ------------------------------------------------------------ the bar

    private def bar_length() : decimal {
        length : decimal = long_of_me();
        return num.larger(24, length * length / num.larger(1, content_long));
    }

    /** how far along the scroller the bar starts */
    private def bar_start() : decimal {
        if(furthest() <= 0) { return 0; }
        return (long_of_me() - bar_length()) * offset / furthest();
    }

    override def pointer(what: _int64, x: decimal, y: decimal) {
        // the mouse position along the scroller, and across it measured from the far edge
        along : decimal = y - me.y;
        from_edge : decimal = me.x + me.w - x;
        if(sideways == 1) {
            along = x - me.x;
            from_edge = me.y + me.h - y;
        }

        if(what == POINTER_PRESS) {
            grab = 0 - 1;
            // only a press ON the bar starts a drag
            if(furthest() > 0 && from_edge <= BAR_THICK + 6 && along >= bar_start() && along <= bar_start() + bar_length()) {
                grab = along - bar_start();
            }
        } else if(what == POINTER_DRAG) {
            if(grab >= 0) {
                track : decimal = long_of_me() - bar_length();
                if(track > 0) {
                    scroll_to((along - grab) / track * furthest());
                }
            }
        } else {
            grab = 0 - 1;
        }
    }

    override def paint(p: painter) {
        // the rows are the children of the one thing that scrolls (usually a column)
        if(feel != null && me.kid_count() > 0) {
            feel!!.sway(me.kids.at(0), me.y, me.h);
        }
    }


    override def paint_over(p: painter) {
        if(furthest() <= 0 || ui_host.current == null) {
            return;
        }
        look : theme = ui_host.current!!.look;
        tint : color = look.text_dim.with_alpha(110);
        if(me.hovered == 1 || grab >= 0) { tint = look.text_dim.with_alpha(200); }

        if(sideways == 1) {
            p.rect(me.x + bar_start() + 2, me.y + me.h - BAR_THICK - 3, bar_length() - 4, BAR_THICK, BAR_THICK / 2, tint);
        } else {
            p.rect(me.x + me.w - BAR_THICK - 3, me.y + bar_start() + 2, BAR_THICK, bar_length() - 4, BAR_THICK / 2, tint);
        }
    }

    // ------------------------------------------------------------ memory across rebuilds

    override def adopt(old: behavior) {
        if(old is scroller) {
            before := old as scroller;
            offset = before.offset;
            grab = before.grab;
            if(feel != null && before.feel != null) { feel = before.feel; }     // a movement that is dying down carries on
        }
    }
}
