mod std.guikit.layout.scrolling;

import (
    std.guikit.*
)

/**
 * One run of items in a lazy list: how many there are, and the function that
 * builds the widgets of item number i (counting from 0 within this run).
 */
local stable class lazy_section {
    count : _int64;
    build_one : (_int64)();

    lazy_section(how_many: _int64, each: (_int64)()) {
        count = how_many;
        build_one = each;
    }
}

/**
 * lazy_list - a scrolling list that only builds the items you can see. Made
 * with lazy_column(...) - items under each other, scrolling up and down - or
 * lazy_row(...) - items side by side, scrolling left and right.
 *
 *      lazy_column(modifier().fill()) {
 *          item { text("Contacts").size(22).bold(); }          // one fixed row
 *          items(people.size()) { i: _int64 ->           // one row per person,
 *              contact_row(people.at(i));                      // built only when it scrolls into view
 *          }
 *          item { text("end of list").dim(); }
 *      }.gap(4)
 *
 *      lazy_row(modifier().fill_width().height(120)) {   // a shelf of cards
 *          items(photos.size()) { i: _int64 -> photo_card(photos.at(i)); };
 *      }.gap(8)
 *
 * These are THE scrolling lists: a widget is a noun, and "scroll" is the verb of
 * a scroll_state (below) - there is no `scroll { }` word. A list that built,
 * measured and kept EVERY item, visible or not, would be fine for dozens of
 * rows and hopeless for fifty thousand. A lazy list is told HOW MANY items
 * there are and HOW to build item i, and it builds just the handful that fit
 * the window - so a list of a million rows opens instantly and scrolls
 * smoothly, and a list of ten costs nothing extra.
 *
 *   .gap(n)      room between the items
 *
 * THE PROGRAM CAN MOVE IT TOO (scroll_state.sharp): lazy_column(where, ...)
 * { ... } or lazy_row(where, ...) { ... } with a scroll_state, then
 * where.scroll_to(n) brings item n into view and where.animate_scroll_to(n)
 * glides it there - the least that does it, so an item already in view moves
 * nothing.
 *
 * ONLY item { } AND items(n) { i -> } GO INSIDE lazy_column { } / lazy_row { }.
 * A widget written straight into the block would be built eagerly, which is
 * exactly what this list exists to avoid - so that is an error, and so is item
 * or items anywhere else (gui.lazy_target).
 *
 * (Android: RecyclerView with a LinearLayoutManager, VERTICAL or HORIZONTAL.
 * Compose: LazyColumn / LazyRow with item / items. The idea is the same in all
 * of them: "virtualisation".)
 *
 * HOW IT WORKS
 *
 *   BOTH DIRECTIONS ARE ONE CLASS: `sideways` says which way is "along" - the
 *   way it scrolls; "across" is the other. The few places that differ ask
 *   long_of() / long_of_me() / measure_item() instead of naming width or
 *   height. The words below say "row" and "top" for the up-down case; read
 *   "item" and "start" for a lazy_row.
 *
 *   The scroll position is not a number of pixels (nobody knows how long a
 *   million rows are without building them). It is "which row is at the top,
 *   and how many pixels of that row have scrolled out": `first` and
 *   `first_cut`. (Compose's LazyListState keeps the same pair:
 *   firstVisibleItemIndex and firstVisibleItemScrollOffset.)
 *
 *   Every layout, `fill` works from that pair:
 *     1. if the top row has scrolled DOWN past the top edge (first_cut below
 *        0), build the rows before it until the gap is covered;
 *     2. if the top row has scrolled entirely out, let it go and move on to
 *        the next;
 *     3. from the top row, build and measure row after row until the window
 *        is full;
 *     4. if the rows ran out before the window was full, the list was
 *        scrolled past its end: pull it back and go again.
 *
 *   The rows that exist right now are the list's children (`rows`, with
 *   `rows_first` the number of the first of them) - so painting, clicking and
 *   focus work on them like on any other widgets. Rows that leave the window
 *   are dropped; rows that come in are built by the section's function.
 *
 *   WHO REBUILDS: a row is built during layout, not during anyone's build().
 *   So the list remembers the composable that was building when the list
 *   itself was made (`owner`) and puts it back as "the one building" while a
 *   row's function runs. A state read inside a row therefore signs up that
 *   composable; when the state changes, it rebuilds, makes a new lazy list,
 *   and the visible rows are built afresh from the new data.
 *
 *   ACROSS A REBUILD the new list adopts the scroll position, and each row it
 *   builds takes over the memory of the old list's row with the same number
 *   (the reconciler) - so a counter or a text field inside a visible row keeps
 *   what it had. A row that scrolls out of view is gone, and with it what only
 *   that row remembered; keep what matters in your own state.
 *
 *   The scroll bar is an estimate: rows are assumed to be as long, on
 *   average, as the ones built so far.
 */
stable class lazy_list base widget : behavior, clipper, wheel_target, drag_scroller, stateful, overlay_painter {
    private sideways : _int64 = 0;              // 1: a lazy_row, scrolling left-right; 0: a lazy_column, up-down
    private sections : list<lazy_section> = new list<lazy_section>();
    private total : _int64 = 0;                 // how many rows there are in all
    private space : decimal = 0;

    private first : _int64 = 0;                 // the number of the row at the top of the window
    private first_cut : decimal = 0;            // how many pixels of that row have scrolled out above the top

    private rows : list<view> = new list<view>();   // the rows that exist now, in order
    private rows_first : _int64 = 0;                // the number of rows.at(0)

    // the rows of the list this one replaced, to hand their memory on (cleared after the first layout)
    private old_rows : list<view>?;
    private old_first : _int64 = 0;

    private owner : composable?;                // who was building when this list was made
    private typical : decimal = 40;             // the average length of a row, for the scroll bar
    private shown_long : decimal = 0;           // the window's length along the scrolling direction, from the last layout
    private at_end : _int64 = 0;                // 1: the last row is in view and the list cannot scroll further

    // moving it from the program (scroll_state.sharp)
    private bound : scroll_state?;              // the handle the program moves it with (lazy_column(where, ...)); null: none
    private gliding : _int64 = 0;               // 1 while an animate_scroll_to is on its way
    private glide_left : decimal = 0;           // the pixels it has still to move (positive: the content moves towards the start)

    private static const WHEEL_STEP : decimal = 48;
    private static const GLIDE_RATE : decimal = 12;     // the share of the way left that a second of glide covers (so it eases out)
    private static const BAR_THICK : decimal = 6;

    /**
     * `where` is the handle the program moves the list with (scroll_state.sharp), or null for none;
     * `across` 1 makes a lazy_row, 0 a lazy_column. The words lazy_column / lazy_row make these.
     */
    lazy_list(where: scroll_state?, across: _int64) {
        attach(self);
        owner = ui_host.building;
        bound = where;
        sideways = across;
    }

    /** run the block that says what is in the list: item { } and items(n) { } */
    def content(block: ()()) : lazy_list {
        scope.fill(me, block);
        if(me.kid_count() > 0) {
            throw new illegal_state_exception("inside `lazy_column { ... }` / `lazy_row { ... }` rows are written with `item { ... }` or `items(count) { i -> ... }`; a widget written straight into the block would be built eagerly");
        }
        return self;
    }

    /** how the rows behave while scrolling: SCROLL_PLAIN (the default) or SCROLL_STAGGER (stagger.sharp; its lag is up-down, so a lazy_row stays plain) */
    def scroll_feel(how: _int64) : lazy_list {
        feel = null;
        if(how == SCROLL_STAGGER && sideways == 0) { feel = new stagger(); }
        return self;
    }

    private feel : stagger?;                // rows that trail behind while scrolling (null: one rigid sheet)

    /** room between the rows, in pixels */
    def gap(pixels: decimal) : lazy_list {
        space = pixels;
        return self;
    }

    /** one more run of rows (called by item and items) */
    def add_section(how_many: _int64, each: (_int64)()) {
        if(how_many > 0) {
            sections.add(new lazy_section(how_many, each));
            total = total + how_many;
        }
    }

    override def clips() : _int64 { return 1; }

    override def kind() : string {
        if(sideways == 1) { return "lazy_row"; }
        return "lazy_column";
    }

    // ------------------------------------------------------------ the two directions

    /** a row's length along the scrolling direction */
    private def long_of(line: view) : decimal {
        if(sideways == 1) { return line.want_w; }
        return line.want_h;
    }

    /** the list's own length along the scrolling direction */
    private def long_of_me() : decimal {
        if(sideways == 1) { return me.w; }
        return me.h;
    }

    /**
     * Measure a row: across the scrolling direction it gets the list's own size (`across`), along it
     * as much as it likes - that is what scrolls. A lazy_row given no height takes each item's own.
     */
    private def measure_item(line: view, across: decimal) {
        if(sideways == 1) {
            if(num.is_bounded(across) == 0) { line.measure(0, UNBOUNDED, 0, UNBOUNDED); }
            else { line.measure(0, UNBOUNDED, across, across); }
        } else {
            line.measure(across, across, 0, UNBOUNDED);
        }
    }

    // ------------------------------------------------------------ building one row

    /** build row number `index`: the widgets its section's function makes, in a box of their own */
    private def build_row(index: _int64) : view {
        // find the section the row is in, and its number within that section
        within : _int64 = index;
        at : _int64 = 0;
        while(at < sections.size() - 1 && within >= sections.at(at).count) {
            within = within - sections.at(at).count;
            at = at + 1;
        }
        section : lazy_section = sections.at(at);

        // The row's own container is made with NO container open, so it lands
        // nowhere by itself; then the section's function fills it - with the
        // list's owner as "the one building", so states read in the row sign
        // that composable up.
        open_before : view? = scope.open;
        builder_before : composable? = ui_host.building;
        scope.open = null;
        box := new column();
        if(sideways == 1) { box.node().fill_h = 1; }        // a lazy_row's item is as tall as the row
        else { box.node().fill_w = 1; }                     // a lazy_column's row is as wide as the column
        ui_host.building = owner;
        scope.open = box.node();
        section.build_one(within);
        scope.open = open_before;
        ui_host.building = builder_before;

        made : view = box.node();
        me.add_kid(made);

        // settle it in: builds composables in the row, and takes over the
        // memory of the old list's row with this number, if it had one
        before : view? = null;
        if(old_rows != null) {
            slot : _int64 = index - old_first;
            if(slot >= 0 && slot < old_rows!!.size()) {
                before = old_rows!!.at(slot);
            }
        }
        reconciler.settle(made, before);
        return made;
    }

    private def drop_row(line: view) {
        me.remove_kid(line);
    }

    /** the length a row takes in the list: its own, plus the gap after it */
    private def step_of(line: view) : decimal {
        return long_of(line) + space;
    }

    // ------------------------------------------------------------ layout

    override def measure(min_w: decimal, max_w: decimal, min_h: decimal, max_h: decimal) {
        // a lazy list needs a limit along its direction to know what "visible" means; without one it shows a window's worth
        along : decimal = max_h;
        across : decimal = max_w;
        if(sideways == 1) {
            along = max_w;
            across = max_h;
        }
        if(num.is_bounded(along) == 0) { along = 600; }
        shown_long = along;

        if(total == 0) {
            while(rows.size() > 0) {
                drop_row(rows.at(0));
                rows.remove_at(0);
            }
            if(sideways == 1) {
                me.content_w = 0;
                me.content_h = 0;
                if(num.is_bounded(across) == 1) { me.content_h = across; }
            } else {
                me.content_w = max_w;
                me.content_h = 0;
            }
            return;
        }

        fill(across, along);
        old_rows = null;                        // the old list's rows have handed on what they knew

        if(sideways == 1) {
            me.content_w = along;
            if(num.is_bounded(across) == 1) { me.content_h = across; }
            else { me.content_h = tallest_row(); }      // no height given: as tall as the tallest item in view
        } else {
            me.content_w = max_w;
            me.content_h = along;
        }
    }

    /** the height of the tallest row that exists now (a lazy_row with no height of its own takes this) */
    private def tallest_row() : decimal {
        most : decimal = 0;
        for(i : _int64 = 0; i < rows.size(); i++) {
            most = num.larger(most, rows.at(i).want_h);
        }
        return most;
    }

    /** make `rows` exactly the rows that are in view for the current scroll position (see "HOW IT WORKS") */
    private def fill(across: decimal, along: decimal) {
        if(first > total - 1) { first = total - 1; }
        if(first < 0) { first = 0; }

        // the rows kept from last time are only useful if they still begin at `first`
        if(rows.size() > 0 && rows_first != first) {
            sync_rows_to_first();
        }
        if(rows.size() == 0) {
            rows.add(build_row(first));
            rows_first = first;
        }
        measure_item(rows.at(0), across);

        // a scroll_to / animate_scroll_to is waiting on the handle: slide to the row (aim), then settle as usual
        if(bound != null) {
            asked : _int64 = bound!!.take();
            if(asked >= 0) { aim(asked, bound!!.is_smooth(), across, along); }
        }

        again : _int64 = 1;
        rounds : _int64 = 0;
        while(again == 1 && rounds < 3) {
            again = 0;
            rounds = rounds + 1;

            // 1. scrolled down past the top of the first row: bring in the rows before it
            while(first_cut < 0 && first > 0) {
                first = first - 1;
                rows_first = first;
                rows.insert(0, build_row(first));
                measure_item(rows.at(0), across);
                first_cut = first_cut + step_of(rows.at(0));
            }
            if(first_cut < 0) { first_cut = 0; }           // at the very top: no further

            // 2. the first row has scrolled out entirely: let it go
            while(rows.size() > 1 && first_cut >= step_of(rows.at(0))) {
                first_cut = first_cut - step_of(rows.at(0));
                drop_row(rows.at(0));
                rows.remove_at(0);
                first = first + 1;
                rows_first = first;
            }

            // 3. row after row until the window is full
            bottom : decimal = 0 - first_cut;
            used : _int64 = 0;
            sum : decimal = 0;
            while(bottom < along && first + used < total) {
                if(used >= rows.size()) {
                    rows.add(build_row(first + used));
                }
                line : view = rows.at(used);
                measure_item(line, across);
                bottom = bottom + step_of(line);
                sum = sum + long_of(line);
                used = used + 1;
            }
            // rows kept from last time that are now below the window
            while(rows.size() > used) {
                last : _int64 = rows.size() - 1;
                drop_row(rows.at(last));
                rows.remove_at(last);
            }
            if(used > 0) { typical = sum / used; }

            // 4. the rows ran out before the window was full: scrolled past the end - pull back
            at_end = 0;
            if(first + used >= total) {
                at_end = 1;
                short_by : decimal = along - (bottom - space);
                if(short_by > 0 && (first > 0 || first_cut > 0)) {
                    first_cut = first_cut - short_by;
                    again = 1;
                } else if(short_by < 0) {
                    at_end = 0;                             // the last row is in view but not yet fully
                }
            }
        }
    }

    /**
     * The scroll position moved to a different first row than the kept rows
     * start at. Keep the rows both have in common; the others are dropped here
     * and built by fill() as it needs them.
     */
    private def sync_rows_to_first() {
        // rows before the new first row: gone
        while(rows.size() > 0 && rows_first < first) {
            drop_row(rows.at(0));
            rows.remove_at(0);
            rows_first = rows_first + 1;
        }
        // the kept rows start AFTER the new first row: nothing of them lines up cheaply - start over
        if(rows.size() > 0 && rows_first != first) {
            while(rows.size() > 0) {
                drop_row(rows.at(0));
                rows.remove_at(0);
            }
        }
    }

    /**
     * Move so that row `index` is in view - the least that does it (scroll_state.sharp). A row above
     * the window: the rows down to it are brought in above, as step 1 of fill does, and the window
     * slides up to it. A row below: the rows down to it are built and measured, and the window slides
     * until its end shows. A row in view: nothing. The slide is a change to first_cut, exactly as a
     * turn of the wheel is, and the rest of fill() then settles first / first_cut as it always does.
     * With `smooth` the change is spread over the next frames instead (glide_on).
     */
    private def aim(index: _int64, smooth: _int64, across: decimal, along: decimal) {
        if(index < 0 || index >= total) { return; }

        while(index < first) {
            first = first - 1;
            rows_first = first;
            rows.insert(0, build_row(first));
            measure_item(rows.at(0), across);
            first_cut = first_cut + step_of(rows.at(0));
        }
        while(rows.size() <= index - first) {
            rows.add(build_row(first + rows.size()));
        }

        top : decimal = 0 - first_cut;                  // where the row begins, from the start of the window
        for(i : _int64 = 0; i < index - first; i++) {
            measure_item(rows.at(i), across);
            top = top + step_of(rows.at(i));
        }
        line : view = rows.at(index - first);
        measure_item(line, across);
        bottom : decimal = top + long_of(line);

        shift : decimal = 0;
        if(top < 0) { shift = top; }
        else if(bottom > along) { shift = bottom - along; }

        if(smooth == 1) {
            glide_left = glide_left + shift;
            if(glide_left > 0.5 || glide_left < 0 - 0.5) {
                gliding = 1;
                if(ui_host.current != null) { ui_host.current!!.request_frame(); }
            }
        } else {
            first_cut = first_cut + shift;
        }
    }

    override def arrange() {
        at : decimal = me.inner_y() - first_cut;
        if(sideways == 1) { at = me.inner_x() - first_cut; }
        count : _int64 = rows.size();
        for(i : _int64 = 0; i < count; i++) {
            line : view = rows.at(i);
            if(sideways == 1) { line.arrange(num.nearest(at), me.inner_y(), line.want_w, line.want_h); }
            else { line.arrange(me.inner_x(), num.nearest(at), line.want_w, line.want_h); }
            at = at + step_of(line);
        }
    }

    // ------------------------------------------------------------ scrolling

    override def wheel(dx: decimal, dy: decimal) : _int64 {
        if(total == 0) {
            return 0;
        }
        // up-down: the wheel. Sideways: a sideways wheel (or touchpad swipe) if there is one, else the ordinary wheel.
        turn : decimal = dy;
        if(sideways == 1 && dx != 0) { turn = 0 - dx; }

        // nothing further that way: let a scrolling area around this list have the turn
        if(turn > 0 && first == 0 && first_cut <= 0) { return 0; }
        if(turn < 0 && at_end == 1) { return 0; }

        first_cut = first_cut - turn * WHEEL_STEP;
        if(feel != null) { feel!!.push(turn * WHEEL_STEP); }
        if(ui_host.current != null) {
            ui_host.current!!.relayout();       // other rows come into view: they are built in the next layout
        }
        return 1;
    }

    /** the rows were dragged (a finger on a touch screen, or the mouse): move with it */
    override def drag_by(dx: decimal, dy: decimal) {
        if(total == 0) {
            return;
        }
        moved : decimal = dy;
        if(sideways == 1) { moved = dx; }
        first_cut = first_cut - moved;
        if(feel != null) { feel!!.push(moved); }
        if(ui_host.current != null) {
            ui_host.current!!.relayout();
        }
    }

    override def paint(p: painter) {
        if(gliding == 1) { glide_on(); }
        if(feel != null) {
            feel!!.sway(me, me.y, me.h);
        }
    }

    /** one frame of an animate_scroll_to: move part of the way left, easing out, until it is there */
    private def glide_on() {
        if(ui_host.current == null) { gliding = 0; glide_left = 0; return; }
        host := ui_host.current!!;
        // nothing further that way (an end of the list): done, as a turn of the wheel is
        if((glide_left > 0 && at_end == 1) || (glide_left < 0 && first == 0 && first_cut <= 0)) {
            gliding = 0;
            glide_left = 0;
            return;
        }
        move : decimal = glide_left;
        if(move > 0.5 || move < 0 - 0.5) { move = glide_left * num.smaller(1, host.step * GLIDE_RATE); }
        first_cut = first_cut + move;
        glide_left = glide_left - move;
        if(feel != null) { feel!!.push(0 - move); }
        if(glide_left < 0.5 && glide_left > 0 - 0.5) {
            gliding = 0;
            glide_left = 0;
        } else {
            host.request_frame();
        }
        host.relayout();                    // other rows come into view: they are built in the next layout
    }


    override def paint_over(p: painter) {
        if(total == 0 || ui_host.current == null) {
            return;
        }
        // an estimate: all rows as long as the typical one
        each : decimal = typical + space;
        whole : decimal = total * each;
        if(whole <= shown_long) {
            return;
        }
        scrolled : decimal = first * each + first_cut;
        length : decimal = long_of_me();
        bar : decimal = num.larger(24, length * shown_long / whole);
        place : decimal = (length - bar) * num.between(scrolled / (whole - shown_long), 0, 1);

        look : theme = ui_host.current!!.look;
        tint : color = look.text_dim.with_alpha(110);
        if(me.hovered == 1) { tint = look.text_dim.with_alpha(200); }
        if(sideways == 1) {
            p.rect(me.x + place + 2, me.y + me.h - BAR_THICK - 3, bar - 4, BAR_THICK, BAR_THICK / 2, tint);
        } else {
            p.rect(me.x + me.w - BAR_THICK - 3, me.y + place + 2, BAR_THICK, bar - 4, BAR_THICK / 2, tint);
        }
    }

    // ------------------------------------------------------------ across rebuilds

    override def adopt(old: behavior) {
        if(old is lazy_list) {
            before := old as lazy_list;
            first = before.first;
            first_cut = before.first_cut;
            typical = before.typical;
            old_rows = before.rows;
            gliding = before.gliding;           // a glide under way carries on
            glide_left = before.glide_left;
            if(feel != null && before.feel != null) { feel = before.feel; }
            old_first = before.rows_first;
        }
    }
}
