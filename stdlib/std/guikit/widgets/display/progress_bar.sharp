mod std.guikit.widgets.display;

import (
    std.guikit.*
)

/**
 * progress_bar - how far along something is. Made with gui.progress(...).
 *
 *      gui.progress(done.value / total)            // a fraction: 0 = nothing, 1 = finished
 *
 * It only SHOWS a number (nobody drags it), so it takes a plain value, not a
 * state: build() runs again when your state changes and makes a bar with the
 * new fraction. It is as wide as the room on offer.
 * (Compose: LinearProgressIndicator. HTML: progress.)
 */
stable class progress_bar base widget : behavior, has_value {
    private done : decimal = 0;

    private static const TALL : decimal = 8;

    progress_bar(fraction: decimal) {
        attach(self);
        done = num.between(fraction, 0, 1);
        me.fill_w = 1;
    }

    override def kind() : string { return "progress"; }

    /** how far along it is, 0 to 1 (asked by UI tests: behavior.sharp, WHAT A WIDGET TELLS ABOUT ITSELF) */
    override def value_shown() : decimal { return done; }

    override def measure(min_w: decimal, max_w: decimal, min_h: decimal, max_h: decimal) {
        me.content_w = 80;
        me.content_h = TALL;
    }

    override def arrange() {
    }

    override def paint(p: painter) {
        t : theme = ui_host.current!!.look;
        top : decimal = me.inner_y() + (me.inner_h() - TALL) / 2;
        p.rect(me.inner_x(), top, me.inner_w(), TALL, TALL / 2, t.surface_high);
        if(done > 0) {
            p.rect(me.inner_x(), top, num.larger(TALL, me.inner_w() * done), TALL, TALL / 2, t.primary);
        }
    }
}
