        }

        if(series.painter_of != null) {
            for(i : _int64 = 0; i < count; i++) {
                m : mark = spot;
                m.index = i;
                m.count = count;
                m.value = series.values[i];
                m.x = pen.xs[i];
                m.y = pen.ys[i];
                m.size = pen.sizes[i];
                m.opacity = pen.solids[i];
                m.tint = own;
                series.painter_of!!(p, m);
            }
        } else if(series.dot > 0) {
            for(i : _int64 = 0; i < count; i++) {
                if(pen.solids[i] > 0 && pen.sizes[i] > 0) {
                    pen.circle(pen.xs[i], pen.ys[i], pen.sizes[i], ink(own, pen.solids[i]));
                }
            }
            pen.show_circles(p);
        }

        if(cut == 1) { p.unclip(); }
        return moving;
    }

    /** the names of the series, each beside a sign in its colour, in one row at height `y` */
    private def paint_legend(p: painter, legend: chart_legend, f: font, y: decimal, look: theme) {
        if(legend.viewer != null) {
            // the entries are widgets: only their places are decided here
            count : _int64 = key_views.size();
            if(count == 0) {
                return;
            }
            all : decimal = legend.apart * (count - 1);
            for(i : _int64 = 0; i < count; i++) { all = all + key_views.at(i).want_w; }
            at : decimal = plot_left;
            if(legend.sideways == ALIGN_CENTER) { at = plot_left + (plot_w - all) / 2; }
            if(legend.sideways == ALIGN_END) { at = plot_left + plot_w - all; }
            row_h : decimal = largest(key_views, 0);
            for(i : _int64 = 0; i < count; i++) {
                box : view = key_views.at(i);
                place(box, at, y + (row_h - box.want_h) / 2);
                at = at + box.want_w + legend.apart;
            }
            return;
        }
        series_count : _int64 = layers.size();
        sign_w : decimal = 16;                      // the sign and the room after it
        if(legend.mark_kind == LEGEND_LINE) { sign_w = 22; }
        pad : decimal = 0;                          // the room inside a pill, left and right
        if(legend.boxed == 1) { pad = 9; }

        // how wide the row is: it may sit at the left, in the middle or at the right
        wide : decimal = 0;
        entries : _int64 = 0;
        for(j : _int64 = 0; j < series_count; j++) {
            if(layers.at(j).name == "") { continue; }
            wide = wide + pad * 2 + sign_w + f.width_of(layers.at(j).name);
            entries = entries + 1;
        }
        if(entries == 0) {
            return;
        }
        wide = wide + legend.apart * (entries - 1);
        x : decimal = plot_left;
        if(legend.sideways == ALIGN_CENTER) { x = plot_left + (plot_w - wide) / 2; }
        if(legend.sideways == ALIGN_END) { x = plot_left + plot_w - wide; }

        words_tint : color = look.text_dim;
        if(legend.tint != null) { words_tint = legend.tint!!; }
        middle : decimal = y + f.line_height / 2;
        for(j : _int64 = 0; j < series_count; j++) {
            series : chart_series = layers.at(j);
            if(series.name == "") { continue; }
            own : color = tint_of(j, series, look);
            name_w : decimal = f.width_of(series.name);
            if(legend.boxed == 1) {
                p.rect(x, y - 3, pad * 2 + sign_w + name_w, f.line_height + 6, (f.line_height + 6) / 2, look.surface_high);
            }
            x = x + pad;
            if(legend.mark_kind == LEGEND_DOT) {
                p.circle(x + 5, middle, 5, own);
            } else if(legend.mark_kind == LEGEND_LINE) {
                p.rect(x, middle - 1.5, 16, 3, 1.5, own);
            } else {
                p.rect(x, middle - 5, 10, 10, 3, own);
            }
            p.text(series.name, x + sign_w, y, f, words_tint);
            x = x + sign_w + name_w + pad + legend.apart;
        }
    }

    /**
     * What marks the place the mouse points at BEHIND the marks: an upright
     * line through it, or the whole place tinted (chart_marker.guide).
     */
    private def paint_guide(p: painter, hot: _int64, bar_count: _int64, look: theme) {
        how : chart_marker = pointing!!;
        which : _int64 = how.guide_kind;
        if(which == GUIDE_AUTO) {
            which = GUIDE_LINE;
            if(bar_count > 0) { which = GUIDE_NONE; }       // the bar lights up instead
        }
        x : decimal = x_of(hot);
        if(which == GUIDE_BAND) {
            tint : color = look.text.with_alpha(18);
            if(how.guide_tint != null) { tint = how.guide_tint!!; }
            wide : decimal = plot_w / places;
            if(centred == 0 && places > 1) { wide = plot_w / (places - 1); }
            from : decimal = num.larger(plot_left, x - wide / 2);
            to : decimal = num.smaller(plot_left + plot_w, x + wide / 2);
            p.rect(from, plot_top, to - from, plot_h, 4, tint);
        } else if(which == GUIDE_LINE) {
            tint : color = look.text_dim.with_alpha(120);
            if(how.guide_tint != null) { tint = how.guide_tint!!; }
            if(how.broken == 1) {
                for(y : decimal = plot_top; y < plot_top + plot_h; y = y + 8) {
                    pen.rect(num.nearest(x), y, 1, num.smaller(4, plot_top + plot_h - y), tint.packed);
                }
                pen.show_rects(p);
            } else {
                p.rect(num.nearest(x), plot_top, 1, plot_h, tint);
            }
        }
    }

    /**
     * What the mouse points at, ON TOP of the marks: a ring on every line's
     * point there, and the box.
     *
     * What the box SAYS is a chart_tip: a heading and a line for each series,
     * unless the marker's own function fills it (chart_marker.tip). Either
     * way the box is measured from its lines here, and placed here - beside
     * the mouse on the side that has the room, or above the place's highest
     * mark - so nobody who styles or fills it works out a position.
     */
    private def paint_marker(p: painter, hot: _int64, zero: decimal, bar_count: _int64, f: font, look: theme, now: decimal) {
        how : chart_marker = pointing!!;
        host := ui_host.current!!;
        x : decimal = x_of(hot);

        told.index = hot;
        told.name = place_name(hot);
        told.x = x;
        told.left = plot_left;
        told.top = plot_top;
        told.width = plot_w;
        told.height = plot_h;
        told.mouse_x = host.mouse_x;
        told.mouse_y = host.mouse_y;

        // the rings, the highest mark of the place, and the usual lines of the box
        card.clear();
        if(how.heading != null) { card.title(how.heading!!(hot)); }
        else if(across != null) { card.title(told.name); }
        series_count : _int64 = layers.size();
        highest : decimal = plot_top + plot_h;
        found : _int64 = 0;
        for(j : _int64 = 0; j < series_count; j++) {
            series : chart_series = layers.at(j);
            if(hot >= series.count) { continue; }
            own : color = tint_of(j, series, look);
            y : decimal = y_of(series.value_at(hot, change_part(now, hot, series.count)));
            if(series.is_bars() == 1 && piled == 1) { y = y_of(sum_up[hot]); }      // the top of the pile
            if(y < highest) { highest = y; }
            if(series.is_bars() == 0 && how.ring > 0) {
                inside : color = look.on_primary;
                if(how.ring_tint != null) { inside = how.ring_tint!!; }
                p.circle(x, y, how.ring, own);
                p.circle(x, y, how.ring / 2, inside);
            }
            words : string = written(series.values[hot]);
            if(how.writer != null) { words = how.writer!!(series.values[hot]); }
            if(series.name != "") { words = series.name + "  " + words; }
            card.line(own, words);
            found = found + 1;
        }
        if(found == 0) {
            return;
        }

        if(how.painter_of != null) {
            how.painter_of!!(p, told);
            return;
        }
        back : color = look.surface_high;
        edge : color = look.border;
        words_tint : color = look.text;
        if(how.back != null) { back = how.back!!; edge = how.back!!; }
        if(how.edge != null) { edge = how.edge!!; }
        if(how.ink != null) { words_tint = how.ink!!; }

        if(how.viewer != null) {
            // THE BOX IS A WIDGET: built for this place when the mouse comes to it, kept while it stays
            if(tip_view == null || tip_for != hot) {
                drop_tip();
                tip_view = holder(2, { -> how.viewer!!(told); });
                tip_for = hot;
                reconciler.settle(tip_view!!, null);
            }
            box : view = tip_view!!;
            box.pad_left = 10;
            box.pad_right = 10;
            box.pad_top = 8;
            box.pad_bottom = 8;
            if(how.boxed == 1) {
                box.back = back;
                box.border_w = 1;
                box.border_c = edge;
            }
            box.measure(0, me.inner_w(), 0, me.inner_h());
            box.corner = num.smaller(how.round, box.want_h / 2);
            place(box, tip_x(x, box.want_w, how.over), tip_y(highest, box.want_h, how.over));
            return;
        }
        if(how.boxed == 0) {
            return;
        }
        if(how.filler != null) {
            card.clear();
            how.filler!!(told, card);
        }
        rows : _int64 = card.size();
        if(rows == 0) {
            return;
        }

        // ---- how big the box is
        bold : font = host.font_of(look.small_size, 1);
        box_w : decimal = 0;
        for(i : _int64 = 0; i < rows; i++) {
            wide : decimal = f.width_of(card.texts.at(i));
            if(card.kind_at(i) == chart_tip.TITLE) { wide = bold.width_of(card.texts.at(i)); }
            if(card.kind_at(i) == chart_tip.DOTTED) { wide = wide + 16; }
            if(wide > box_w) { box_w = wide; }
        }
        pad : decimal = 10;
        if(rows == 1) { pad = 12; }                 // one line alone: a label, with a little more room at its ends
        box_w = box_w + pad * 2;
        box_h : decimal = rows * (f.line_height + 3) + 9;
        box_x : decimal = tip_x(x, box_w, how.over);
        box_y : decimal = tip_y(highest, box_h, how.over);
        radius : decimal = num.smaller(how.round, box_h / 2);

        p.rect(box_x, box_y, box_w, box_h, radius, back);
        p.outline(box_x, box_y, box_w, box_h, radius, 1, edge);
        y : decimal = box_y + 6;
        for(i : _int64 = 0; i < rows; i++) {
            which : _int64 = card.kind_at(i);
            if(which == chart_tip.TITLE) {
                p.text(card.texts.at(i), box_x + pad, y, bold, words_tint);
            } else if(which == chart_tip.DOTTED) {
                p.circle(box_x + pad + 4, y + f.line_height / 2, 4, card.tints.at(i));
                p.text(card.texts.at(i), box_x + pad + 16, y, f, words_tint);
            } else {
                p.text(card.texts.at(i), box_x + pad, y, f, words_tint);
            }
            y = y + f.line_height + 3;
        }
    }

    /**
     * Where the marker's box goes, across: over the place when it stands
     * above the marks, else beside the place on the side that has the room -
     * and never outside the chart.
     */
    private def tip_x(x: decimal, box_w: decimal, over: _int64) : decimal {
        lowest : decimal = me.inner_x();
        highest : decimal = num.larger(lowest, me.inner_x() + me.inner_w() - box_w);
        if(over == 1) {
            return num.between(x - box_w / 2, lowest, highest);
        }
        at : decimal = x + 14;
        if(at + box_w > me.inner_x() + me.inner_w()) { at = x - 14 - box_w; }
        return num.between(at, lowest, highest);
    }

    /** ... and down: just above the place's highest mark, or at the height of the mouse */
    private def tip_y(highest_mark: decimal, box_h: decimal, over: _int64) : decimal {
        if(over == 1) {
            return num.larger(me.inner_y(), highest_mark - box_h - 14);
        }
        return num.between(ui_host.current!!.mouse_y - box_h - 10, me.inner_y(), num.larger(me.inner_y(), plot_top + plot_h - box_h));
    }
}

/**
 * chart_pen - the lists a chart fills and hands to the painter in one go.
 *
 * A curve is a few hundred short lines and a fill under it a few thousand
 * small boxes; painted one call at a time they would cost far more to hand
 * over than to paint (painter.sharp, "many shapes in one call"). The lists
 * are kept between frames, so a chart that is moving makes nothing new.
 *
 * It also holds the POINTS of the line being painted (xs, ys) and the PATH
 * through them (path_x, path_y): the same points for a straight line, many
 * more for a curve.
 */
local stable class chart_pen {
    lowest : decimal = 0;               // what find_extent found
    highest : decimal = 0;

    // the points of a line, as the motion left them
    xs : decimal[] = new decimal[0];
    ys : decimal[] = new decimal[0];
    sizes : decimal[] = new decimal[0];
    solids : decimal[] = new decimal[0];
    private slopes : decimal[] = new decimal[0];

    // the path through them
    path_x : decimal[] = new decimal[64];
    path_y : decimal[] = new decimal[64];
    path_n : _int64 = 0;

    private rx : decimal[] = new decimal[256];
    private ry : decimal[] = new decimal[256];
    private rw : decimal[] = new decimal[256];
    private rh : decimal[] = new decimal[256];
    private rc : _int64[] = new _int64[256];
    private rects : _int64 = 0;

    private ax : decimal[] = new decimal[256];
    private ay : decimal[] = new decimal[256];
    private bx : decimal[] = new decimal[256];
    private by : decimal[] = new decimal[256];
    private lc : _int64[] = new _int64[256];
    private lines : _int64 = 0;

    private cx : decimal[] = new decimal[64];
    private cy : decimal[] = new decimal[64];
    private cr : decimal[] = new decimal[64];
    private cc : _int64[] = new _int64[64];
    private circles : _int64 = 0;

    private static const PIECES : _int64 = 10;      // straight pieces between two points of a curve
    private static const DASH : decimal = 7;
    private static const GAP : decimal = 5;

    private static def longer(old: decimal[], room: _int64) : decimal[] {
        made : decimal[] = new decimal[room];
        count : _int64 = sizeof(old);
        for(i : _int64 = 0; i < count; i++) { made[i] = old[i]; }
        return made;
    }

    private static def longer(old: _int64[], room: _int64) : _int64[] {
        made : _int64[] = new _int64[room];
        count : _int64 = sizeof(old);
        for(i : _int64 = 0; i < count; i++) { made[i] = old[i]; }
        return made;
    }

    // ---------------------------------------------------------------- boxes, lines, circles

    def rect(x: decimal, y: decimal, w: decimal, h: decimal, packed: _int64) {
        if(rects == sizeof(rx)) {
            room : _int64 = rects * 2;
            rx = longer(rx, room);
            ry = longer(ry, room);
            rw = longer(rw, room);
            rh = longer(rh, room);
            rc = longer(rc, room);
        }
        rx[rects] = x;
        ry[rects] = y;
        rw[rects] = w;
        rh[rects] = h;
        rc[rects] = packed;
        rects = rects + 1;
    }

    def show_rects(p: painter) {
        if(rects > 0) { p.rects(rx, ry, rw, rh, rc, rects); }
        rects = 0;
    }

    def line(x1: decimal, y1: decimal, x2: decimal, y2: decimal, packed: _int64) {
        if(lines == sizeof(ax)) {
            room : _int64 = lines * 2;
            ax = longer(ax, room);
            ay = longer(ay, room);
            bx = longer(bx, room);
            by = longer(by, room);
            lc = longer(lc, room);
        }
        ax[lines] = x1;
        ay[lines] = y1;
        bx[lines] = x2;
        by[lines] = y2;
        lc[lines] = packed;
        lines = lines + 1;
    }

    def show_lines(p: painter, thickness: decimal) {
        if(lines > 0) { p.lines(ax, ay, bx, by, thickness, lc, lines); }
        lines = 0;
    }

    def circle(x: decimal, y: decimal, radius: decimal, packed: _int64) {
        if(circles == sizeof(cx)) {
            room : _int64 = circles * 2;
            cx = longer(cx, room);
            cy = longer(cy, room);
            cr = longer(cr, room);
            cc = longer(cc, room);
        }
        cx[circles] = x;
        cy[circles] = y;
        cr[circles] = radius;
        cc[circles] = packed;
        circles = circles + 1;
    }

    def show_circles(p: painter) {
        if(circles > 0) { p.circles(cx, cy, cr, cc, circles); }
        circles = 0;
    }

    // ---------------------------------------------------------------- the path of a line

    /** make room for the points of a line */
    def points(count: _int64) {
        if(sizeof(xs) < count) {
            xs = new decimal[count];
            ys = new decimal[count];
            sizes = new decimal[count];
            solids = new decimal[count];
            slopes = new decimal[count];
        }
    }

    private def to(x: decimal, y: decimal) {
        if(path_n == sizeof(path_x)) {
            path_x = longer(path_x, path_n * 2);
            path_y = longer(path_y, path_n * 2);
        }
        path_x[path_n] = x;
        path_y[path_n] = y;
        path_n = path_n + 1;
    }

    /** lay the path through the first `count` points: straight, stepped or curved */
    def trace(route: _int64, count: _int64) {
        path_n = 0;
        if(count == 0) {
            return;
        }
        to(xs[0], ys[0]);
        if(route == LINE_STEPPED) {
            for(i : _int64 = 1; i < count; i++) {
                to(xs[i], ys[i - 1]);
                to(xs[i], ys[i]);
            }
            return;
        }
        if(route != LINE_CURVED || count < 3) {
            for(i : _int64 = 1; i < count; i++) {
                to(xs[i], ys[i]);
            }
            return;
        }

        // A CURVE THAT NEVER SWINGS PAST A POINT. Each point gets a slope; between
        // two points the curve is the cubic that leaves the first with its slope
        // and arrives at the second with its own (a Hermite spline). The slopes
        // are chosen so the curve cannot rise above the higher or dip below the
        // lower of two neighbours - a chart must not show a peak the numbers do
        // not have: where the line turns (a peak, a valley) the slope is 0;
        // elsewhere it is the harmonic mean of the slopes of the two straight
        // pieces that meet there, which leans towards the flatter one.
        // (Fritsch and Carlson's "monotone" cubic, 1980.)
        for(i : _int64 = 0; i < count; i++) {
            before : decimal = 0;
            after : decimal = 0;
            if(i > 0 && xs[i] != xs[i - 1]) { before = (ys[i] - ys[i - 1]) / (xs[i] - xs[i - 1]); }
            if(i < count - 1 && xs[i + 1] != xs[i]) { after = (ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]); }
            if(i == 0) { slopes[i] = after; }
            else if(i == count - 1) { slopes[i] = before; }
            else if(before * after <= 0) { slopes[i] = 0; }
            else { slopes[i] = 2 * before * after / (before + after); }
        }
        for(i : _int64 = 0; i < count - 1; i++) {
            wide : decimal = xs[i + 1] - xs[i];
            for(k : _int64 = 1; k <= PIECES; k++) {
                s : decimal = k;
                s = s / PIECES;
                s2 : decimal = s * s;
                s3 : decimal = s2 * s;
                y : decimal = (2 * s3 - 3 * s2 + 1) * ys[i] + (s3 - 2 * s2 + s) * wide * slopes[i]
                            + (3 * s2 - 2 * s3) * ys[i + 1] + (s3 - s2) * wide * slopes[i + 1];
                to(xs[i] + s * wide, y);
            }
        }
    }

    /** the path as lines of one colour: whole, or in dashes measured along it */
    def stroke(broken: _int64, packed: _int64) {
        if(broken == 0) {
            for(i : _int64 = 1; i < path_n; i++) {
                line(path_x[i - 1], path_y[i - 1], path_x[i], path_y[i], packed);
            }
            return;
        }
        drawing : _int64 = 1;               // in a dash (1) or in the gap after it (0)
        left : decimal = DASH;              // how much of it is still to come
        for(i : _int64 = 1; i < path_n; i++) {
            dx : decimal = path_x[i] - path_x[i - 1];
            dy : decimal = path_y[i] - path_y[i - 1];
            long : decimal = sqrt(dx * dx + dy * dy);
            if(long <= 0) { continue; }
            at : decimal = 0;
            while(at < long) {
                take : decimal = left;
                if(take > long - at) { take = long - at; }
                if(drawing == 1) {
                    line(path_x[i - 1] + dx * at / long, path_y[i - 1] + dy * at / long,
                         path_x[i - 1] + dx * (at + take) / long, path_y[i - 1] + dy * (at + take) / long, packed);
                }
                at = at + take;
                left = left - take;
                if(left <= 0.001) {
                    drawing = 1 - drawing;
                    left = GAP;
                    if(drawing == 1) { left = DASH; }
                }
            }
        }
    }

    /**
     * The area between the path and the level `zero`, as solid as `strength`
     * (0 .. 1) at the path and fading to nothing at `zero`.
     *
     * It is made of upright columns two pixels wide, each cut into sixteen
     * boxes that get fainter towards `zero` - enough of them that the eye sees
     * one even fade and not steps. Plain boxes are painted pixel-exact
     * (triangles get a soft edge, which would show as a seam between every
     * two of them), so the columns join without a mark.
     */
    def fill_under(zero: decimal, tint: color, strength: decimal) {
        if(path_n < 2) {
            return;
        }
        bands : _int64 = 16;
        piece : _int64 = 0;                 // the piece of the path the column is under
        last : decimal = path_x[path_n - 1];
        for(x : decimal = num.whole(path_x[0]); x < last; x = x + 2) {
            middle : decimal = num.between(x + 1, path_x[0], last);
            while(piece < path_n - 2 && path_x[piece + 1] < middle) { piece = piece + 1; }
            y : decimal = path_y[piece];
            run : decimal = path_x[piece + 1] - path_x[piece];
            if(run > 0) { y = y + (path_y[piece + 1] - y) * (middle - path_x[piece]) / run; }

            tall : decimal = (zero - y) / bands;        // below `zero` this is negative: the boxes then run upwards
            for(k : _int64 = 0; k < bands; k++) {
                alpha : _int64 = tint.alpha * strength * (1 - (k + 0.5) / bands);
                box_y : decimal = y + tall * k;
                box_h : decimal = tall;
                if(tall < 0) {
                    box_y = box_y + tall;
                    box_h = 0 - tall;
                }
                rect(x, box_y, num.smaller(2, last - x), box_h, tint.packed - tint.alpha + alpha);
            }
        }
    }
}
