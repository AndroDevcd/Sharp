mod std.guikit.charts;

import (
    std,
    std.math,
    std.guikit.*
)

/**
 * chart - numbers as bars and lines. Made with chart(...).
 *
 *      chart(modifier().fill_width().height(240)) {
 *          bars("Sales", sales).corner(6);
 *          line("Target", target).curved().dots(4);
 *
 *          x_axis(months);
 *          y_axis().ticks(5);
 *          grid_lines().dashed();
 *          legend();
 *          marker();
 *      }.enter(motion.grow().stagger(0.04));
 *
 * WHAT GOES IN THE BLOCK
 *
 *   bars(...)  line(...)      the data: any number of each, drawn in the order written (series.sharp)
 *   x_axis(...)  y_axis()     the words along the bottom and the numbers up the side (parts.sharp)
 *   grid_lines()              level lines behind the marks
 *   legend()                  the names of the series
 *   marker()                  the place under the mouse is marked and its numbers are shown
 *
 * Each of them only works inside chart { }; written anywhere else it stops
 * the program with an error that says so. Ordinary `if` and `for` work in
 * the block, as in every block of this library.
 *
 * EACH OF THEM TAKES A BLOCK OF ITS OWN, and then what it would have written
 * is built from widgets instead - any widgets, your composables too:
 *
 *      x_axis(months) { text(it.words).size(13); if(it.index == best) { chip("best"); } }
 *      legend { text(it.name).color(it.tint!!); }
 *      marker { text(months[it.index]).bold(); progress(share[it.index]); }
 *      bars("Sales", sales) { if(it.value >= goal) { chip("goal"); } }
 *
 * AND ANY OTHER WIDGET CAN BE WRITTEN IN THE BLOCK. It is laid over the
 * marks, where its modifier says in the chart's own terms:
 *
 *      chip("launch day", modifier().at(4, revenue[4]));       // over place 4, at that number's height
 *      text("goal", modifier().at_value(8000));                // on the level of 8000
 *      button("Details", modifier().at_place(11)) { open(); }; // over place 11, at the top
 *
 * (with no place said, it sits in the top left corner of the marks' area).
 *
 * AND ON THE CHART ITSELF
 *
 *   .stacked()                bars stand on top of each other instead of side by side
 *   .range(low, high)         the numbers the y axis runs between (else: round numbers around the data)
 *   .enter(motion)            how the marks appear (motion.sharp); a series can say its own
 *   .change(motion)           how they get from old numbers to new ones
 *   .on_select { i -> }       a place was clicked: i is its number, 0 the first
 *   .hover(state)             keep a state at the place under the mouse (-1: none): anything on
 *                             the screen can then follow what the chart is pointed at
 *
 * THE NUMBERS ARE PLAIN VALUES, not a state - like progress(fraction). When
 * your state changes, build() runs again and makes a chart from the new
 * numbers; the marks then glide from where they were to where they belong.
 * One made with new numbers every second is a live chart.
 *
 * (Compose: Vico's CartesianChartHost with its layers. Android: MPAndroidChart's
 * CombinedChart. HTML: Chart.js.)
 *
 * HOW IT WORKS
 *
 *   A chart is ONE widget that paints everything itself; the things said in
 *   its block are not widgets but notes it keeps (chart.open is the chart
 *   whose block is running, as scope.open is for containers).
 *
 *   Painting goes from numbers to pixels in three steps:
 *
 *     1. THE SCALE. The lowest and highest number are found (with bars: 0
 *        is always in), and widened to round numbers so the y axis reads
 *        0, 50, 100 and not 0, 47, 94. `y_of` turns a number into a place.
 *     2. EVERY MARK AT REST. Place i of n is a slot of the width; a bar
 *        fills its share of the slot, a point sits in the slot's middle
 *        (with no bars in the chart, the points run from edge to edge).
 *     3. THE MOTION. Each mark is handed to the motion with how far along
 *        it is, and painted as the motion leaves it.
 *
 *   MOVING. Nothing here is a timer. The chart knows WHEN things began (a
 *   series' `born`, the chart's `change_at`, in the host's clock) and works
 *   out from the time of each frame where everything is; while something is
 *   on its way it asks the host for another frame.
 *
 *   WIDGETS IN A CHART. Every place a chart writes words - the labels of
 *   the axes, the legend, the marker's box, the marks themselves - can hold
 *   widgets instead (the block of its word), and widgets written straight
 *   into the chart's block are laid over the marks. Each is an ordinary
 *   CHILD of the chart: built with the chart (make_views), so the reconciler
 *   carries its memory across rebuilds like any other; measured in the
 *   chart's measure, which is how the chart knows the room a row of labels
 *   needs; and put in its place while PAINTING, where the places are worked
 *   out anyway - they move with every frame of a motion, and layout is not
 *   run for that. Only the marker's box is different: what it holds depends
 *   on where the mouse is, so it is built when the mouse comes to a place
 *   (tip_view).
 *
 *   NEW NUMBERS. A rebuild makes a NEW chart object. The reconciler hands it
 *   the old one (adopt, below): the new chart takes over when each series
 *   appeared, and - if the numbers differ - notes where every mark stands on
 *   the screen at this moment as the place to glide from. So a change in the
 *   middle of a change starts from wherever the marks are.
 */
stable class chart base widget : behavior, stateful, pointer_target, overlay_painter {
    /** the chart whose block is running right now (null: none) */
    static open : chart?;

    private static palette : list<color>?;

    private layers : list<chart_series> = new list<chart_series>();
    private across : chart_axis?;               // the x axis, when one was said
    private up : chart_axis?;                   // the y axis
    private behind : chart_grid?;
    private names : chart_legend?;
    private pointing : chart_marker?;

    private piled : _int64 = 0;                 // 1: bars on top of each other
    private fixed : _int64 = 0;                 // 1: the program said the range
    private fixed_low : decimal = 0;
    private fixed_high : decimal = 1;
    private entering : motion?;
    private changing : motion = motion.glide();
    private picked : (_int64)()?;

    private bars_enter : motion = motion.grow().stagger(0.03);
    private line_enter : motion = motion.draw_on();

    // ---- moving (see MOVING, above)
    private change_at : decimal = 0 - 1;        // when the glide to the present numbers began; -1: none is running
    private old_low : decimal = 0;              // the scale the glide began from
    private old_high : decimal = 1;
    private painted_at : decimal = 0 - 1;       // the time of the last paint; -1: never painted
    private low : decimal = 0;                  // the scale as it was last painted
    private high : decimal = 1;

    // ---- where things were last painted (the mouse is answered from these)
    private plot_left : decimal = 0;
    private plot_top : decimal = 0;
    private plot_w : decimal = 1;
    private plot_h : decimal = 1;
    private places : _int64 = 0;                // how many places there are across
    private centred : _int64 = 0;               // 1: a place is a slot and marks sit in its middle (there are bars)

    private pen : chart_pen = new chart_pen();
    private spot : mark = new mark();
    private told : chart_hover = new chart_hover();     // what the marker's functions are told

    // ---- the widgets in it (WIDGETS IN A CHART, above)
    private x_views : list<view> = new list<view>();    // one for each place, when the x axis builds its labels
    private y_views : list<view> = new list<view>();    // one for each number of the y axis
    private key_views : list<view> = new list<view>();  // one for each named series, when the legend builds its entries
    private loose : _int64 = 0;                         // the first so many children: widgets written straight into the block
    private shown_mark : mark = new mark();             // the mark a series' block is told of
    private tracked : state<_int64>?;                   // the state that follows the place under the mouse (hover)
    private tip_view : view?;                           // what the marker's box holds right now
    private tip_for : _int64 = 0 - 1;                   // the place it was built for

    // the marker's box, when it is painted and not a widget, waits until the chart's widgets are
    // painted (paint_over): the place it is for (-1: none), and what paint() knew about it
    private late_hot : _int64 = 0 - 1;
    private late_zero : decimal = 0;
    private late_bars : _int64 = 0;

    // the scale the numbers call for (find_scale): where the shown scale is, or is gliding to
    private scale_low : decimal = 0;
    private scale_high : decimal = 1;
    private scale_step : decimal = 1;
    private bar_series_count : _int64 = 0;
    private card : chart_tip = new chart_tip();         // what the marker's box says
    private sum_up : decimal[] = new decimal[0];        // stacked bars: how high the pile at each place is so far
    private sum_down : decimal[] = new decimal[0];

    chart() {
        attach(self);
        me.fill_w = 1;
    }

    // ================================================================ what the program says

    /** run the block: what it says (bars, line, x_axis ...) is noted in this chart */
    def content(block: ()()) : chart {
        chart_before : chart? = open;
        scope_before : view? = scope.open;
        open = self;
        scope.open = me;                        // a widget written in the block is the chart's own: laid over the marks (modifier().at)
        block();
        scope.open = scope_before;
        open = chart_before;
        loose = me.kid_count();
        make_views();
        return self;
    }

    /**
     * Build the widgets of every part that asked for them (.view): each is
     * made by running the part's block into a small container of its own,
     * which becomes a child of the chart.
     */
    private def make_views() {
        find_scale();
        if(across != null && across!!.viewer != null) {
            axis : chart_axis = across!!;
            for(i : _int64 = 0; i < places; i++) {
                label : axis_label = axis.dressed(i, 0, place_name(i));
                x_views.add(holder(1, { -> axis.viewer!!(label); }));
            }
        }
        make_y_views();
        if(names != null && names!!.viewer != null) {
            legend : chart_legend = names!!;
            look : theme = gui.current_theme();
            entry := new legend_entry();
            series_count : _int64 = layers.size();
            for(j : _int64 = 0; j < series_count; j++) {
                if(layers.at(j).name == "") { continue; }
                entry.index = j;
                entry.name = layers.at(j).name;
                entry.tint = tint_of(j, layers.at(j), look);
                key_views.add(holder(0, { -> legend.viewer!!(entry); }));
            }
        }
        series_count : _int64 = layers.size();
        for(j : _int64 = 0; j < series_count; j++) {
            series : chart_series = layers.at(j);
            if(series.viewer == null) { continue; }
            shown_mark.count = series.count;
            shown_mark.is_bar = series.is_bars();
            shown_mark.tint = tint_of(j, series, gui.current_theme());
            for(i : _int64 = 0; i < series.count; i++) {
                shown_mark.index = i;
                shown_mark.value = series.values[i];
                series.views.add(holder(1, { -> series.viewer!!(shown_mark); }));
            }
        }
    }

    /** the widgets of the y axis' numbers. Made again when the scale is changed after the block (stacked, range). */
    private def make_y_views() {
        count : _int64 = y_views.size();
        for(i : _int64 = 0; i < count; i++) {
            me.remove_kid(y_views.at(i));
        }
        y_views.clear();
        if(up == null || up!!.viewer == null || places == 0) {
            return;
        }
        axis : chart_axis = up!!;
        first : decimal = (0 - num.whole(0 - scale_low / scale_step)) * scale_step;
        tick : _int64 = 0;
        for(v : decimal = first; v <= scale_high + scale_step / 2; v = v + scale_step) {
            label : axis_label = axis.dressed(tick, v, written(v));
            y_views.add(holder(0, { -> axis.viewer!!(label); }));
            tick = tick + 1;
        }
    }

    /**
     * Run `fill` into a new container and make that a child of the chart:
     * a row (upright 0), a column with its children in the middle (1) or a
     * column with them at the left (2). It is not painted until paint()
     * gives it a place.
     */
    private def holder(upright: _int64, fill: ()()) : view {
        scope_before : view? = scope.open;
        chart_before : chart? = open;
        scope.open = null;                      // the container itself must not land in whatever is open
        open = null;                            // (a chart made INSIDE the block opens itself)
        box : view = me;
        if(upright == 2) {
            made := new column();
            made.gap(4).content(fill);
            box = made.node();
        } else if(upright == 1) {
            made := new column();
            made.align(ALIGN_CENTER).gap(2).content(fill);
            box = made.node();
        } else {
            made := new row();
            made.gap(6).content(fill);
            box = made.node();
        }
        scope.open = scope_before;
        open = chart_before;
        me.add_kid(box);
        box.hidden = 1;
        return box;
    }

    /** put a widget of the chart at (x, y), at the size it asked for, and let it be painted */
    private def place(box: view, x: decimal, y: decimal) {
        box.hidden = 0;
        box.arrange(x, y, box.want_w, box.want_h);
    }

    /** the tallest (across 0) or widest (across 1) of some widgets */
    private static def largest(boxes: list<view>, across: _int64) : decimal {
        most : decimal = 0;
        count : _int64 = boxes.size();
        for(i : _int64 = 0; i < count; i++) {
            size : decimal = boxes.at(i).want_h;
            if(across == 1) { size = boxes.at(i).want_w; }
            if(size > most) { most = size; }
        }
        return most;
    }

    /** the widget in the marker's box is not wanted any more: out of the tree, and its composables are told */
    private def drop_tip() {
        if(tip_view != null) {
            me.remove_kid(tip_view!!);
            reconciler.retire(tip_view!!);
            tip_view = null;
        }
        tip_for = 0 - 1;
    }

    /**
     * The chart whose block is running - or, outside any, an error that names
     * what was written and where it belongs (as scope.inside does for tab(...)).
     */
    static def inside(written: string) : chart {
        if(open == null) {
            throw new illegal_state_exception("`" + written + "` only works inside `chart { ... }`");
        }
        return open!!;
    }

    def add(series: chart_series) { layers.add(series); }
    def set_x_axis(axis: chart_axis) { across = axis; }
    def set_y_axis(axis: chart_axis) { up = axis; }
    def set_grid(grid: chart_grid) { behind = grid; }
    def set_legend(legend: chart_legend) { names = legend; }
    def set_marker(marker: chart_marker) { pointing = marker; }

    /** bars stand on top of each other instead of side by side */
    def stacked() : chart {
        piled = 1;
        find_scale();
        make_y_views();
        return self;
    }

    /** the numbers the y axis runs between */
    def range(lowest: decimal, highest: decimal) : chart {
        fixed = 1;
        fixed_low = lowest;
        fixed_high = highest;
        find_scale();
        make_y_views();
        return self;
    }

    /** how the marks appear */
    def enter(how: motion) : chart {
        entering = how;
        return self;
    }

    /** how the marks get from old numbers to new ones */
    def change(how: motion) : chart {
        changing = how;
        return self;
    }

    /**
     * Keep `target` at the place the mouse points at (0: the first; -1: none).
     * It is an ordinary state, so whatever is built from it follows the mouse:
     * a panel beside the chart, a second chart that lights up the same place.
     *
     *      pointed := state(0 - 1);
     *      chart { ... }.hover(pointed);
     *      if(pointed.value >= 0) { text("you are looking at " + months[pointed.value]); }
     */
    def hover(target: state<_int64>) : chart {
        tracked = target;
        return self;
    }

    /** run this when a place is clicked, with its number (0: the first) */
    def on_select(action: (_int64)()) : chart {
        picked = action;
        return self;
    }

    // ================================================================ as a widget

    override def kind() : string { return "chart"; }

    override def measure(min_w: decimal, max_w: decimal, min_h: decimal, max_h: decimal) {
        // the widgets in it may each be as big as they like, up to the chart's own room
        count : _int64 = me.kid_count();
        for(i : _int64 = 0; i < count; i++) {
            me.kids.at(i).measure(0, max_w, 0, max_h);
        }
        me.content_w = 240;
        me.content_h = 180;
    }

    override def arrange() {
    }

    override def pointer(what: _int64, x: decimal, y: decimal) {
        if(what == POINTER_PRESS && picked != null) {
            at : _int64 = place_at(x, y);
            if(at >= 0) { picked!!(at); }
        }
    }

    /**
     * Take over from the chart this one replaces after a rebuild: when its
     * series appeared, and - when the numbers are not the same - where every
     * mark stands right now, as the place to glide from (NEW NUMBERS, above).
     */
    override def adopt(old: behavior) {
        if(!(old is chart)) {
            return;
        }
        before := old as chart;
        if(before.painted_at < 0) {
            return;                             // it never reached the screen: there is nothing to carry on from
        }
        now : decimal = before.painted_at;
        if(ui_host.current != null) { now = ui_host.current!!.now; }

        mine : _int64 = layers.size();
        theirs : _int64 = before.layers.size();
        differs : _int64 = 0;
        if(mine != theirs) { differs = 1; }
        for(j : _int64 = 0; j < mine && j < theirs; j++) {
            fresh : chart_series = layers.at(j);
            was : chart_series = before.layers.at(j);
            if(fresh.is_bars() != was.is_bars()) { differs = 1; continue; }
            fresh.born = was.born;
            if(fresh.same_numbers(was) == 0) { differs = 1; }
        }

        if(differs == 0) {
            // the same numbers: a glide that is running carries on as it was
            for(j : _int64 = 0; j < mine; j++) {
                layers.at(j).start = before.layers.at(j).start;
            }
            change_at = before.change_at;
            old_low = before.old_low;
            old_high = before.old_high;
            return;
        }

        for(j : _int64 = 0; j < mine && j < theirs; j++) {
            fresh : chart_series = layers.at(j);
            was : chart_series = before.layers.at(j);
            if(fresh.is_bars() != was.is_bars()) { continue; }
            for(i : _int64 = 0; i < fresh.count; i++) {
                if(i < was.count) {
                    fresh.start[i] = was.value_at(i, before.change_part(now, i, was.count));
                } else if(fresh.is_bars() == 1 || was.count == 0) {
                    fresh.start[i] = 0;                         // a new bar grows from nothing
                } else {
                    fresh.start[i] = was.value_at(was.count - 1, 1);    // a new point of a line leaves from the line's old end
                }
            }
        }
        change_at = now;
        old_low = before.low;
        old_high = before.high;
    }

    /** how much of the glide to the present numbers mark i has done at time `now` (1: there is none, or it is over) */
    def change_part(now: decimal, i: _int64, count: _int64) : decimal {
        if(change_at < 0) { return 1; }
        return changing.progress(now - change_at, i, count);
    }

    // ================================================================ numbers to pixels

    /** where the number `v` is, down the screen */
    private def y_of(v: decimal) : decimal {
        return plot_top + plot_h - (v - low) / (high - low) * plot_h;
    }

    /** where the middle of place i is, across the screen (2.5: half way between the third and the fourth) */
    private def x_of(i: decimal) : decimal {
        if(centred == 1 || places < 2) {
            return plot_left + plot_w * (i + 0.5) / places;
        }
        return plot_left + plot_w * i / (places - 1);
    }

    /** the place under a point of the window, or -1 when the point is not over the marks */
    private def place_at(px: decimal, py: decimal) : _int64 {
        if(places == 0 || px < plot_left - 4 || px > plot_left + plot_w + 4 || py < plot_top - 4 || py > plot_top + plot_h + 4) {
            return 0 - 1;
        }
        at : _int64 = 0;
        if(centred == 1 || places < 2) {
            at = (px - plot_left) / (plot_w / places);
        } else {
            at = num.nearest((px - plot_left) / (plot_w / (places - 1)));
        }
        if(at < 0) { at = 0; }
        if(at >= places) { at = places - 1; }
        return at;
    }

    /** the colour of series number `index` when it was given none: the theme's own first, then a fixed row of others */
    private def tint_of(index: _int64, series: chart_series, look: theme) : color {
        if(series.tint != null) { return series.tint!!; }
        if(index == 0) { return look.primary; }
        if(palette == null) {
            made := new list<color>();
            made.add(new color(45, 190, 160, 255));
            made.add(new color(245, 170, 60, 255));
            made.add(new color(235, 95, 140, 255));
            made.add(new color(150, 110, 245, 255));
            made.add(new color(90, 200, 240, 255));
            palette = made;
        }
        return palette!!.at((index - 1) % palette!!.size());
    }

    /** a colour as the one number the painter takes, `opacity` (0 .. 1) as solid as it is */
    private static def ink(c: color, opacity: decimal) : _int64 {
        if(opacity >= 1) { return c.packed; }
        if(opacity < 0) { opacity = 0; }
        alpha : _int64 = c.alpha * opacity;
        return c.packed - c.alpha + alpha;
    }

    /** the colour `part` of the way from a to b, as the painter's number */
    private static def between(a: color, b: color, part: decimal, opacity: decimal) : _int64 {
        return gui.pack(a.red + (b.red - a.red) * part, a.green + (b.green - a.green) * part,
                        a.blue + (b.blue - a.blue) * part, (a.alpha + (b.alpha - a.alpha) * part) * opacity);
    }

    /** how a number is written: the y axis' own way when it has one */
    private def written(v: decimal) : string {
        if(up != null && up!!.writer != null) { return up!!.writer!!(v); }
        return chart_text.number(v);
    }

    /**
     * A round distance between the numbers of the y axis, so that about
     * `wanted` of them fit between low and high: 1, 2, 2.5 or 5 times a power of ten.
     */
    private static def round_step(lowest: decimal, highest: decimal, wanted: _int64) : decimal {
        raw : decimal = (highest - lowest) / wanted;
        if(raw <= 0) { return 1; }
        size : decimal = 1;
        while(size * 10 <= raw) { size = size * 10; }
        while(size > raw) { size = size / 10; }
        times : decimal = raw / size;               // 1 .. 10
        if(times <= 1) { return size; }
        if(times <= 2) { return 2 * size; }
        if(times <= 2.5) { return 2.5 * size; }
        if(times <= 5) { return 5 * size; }
        return 10 * size;
    }

    /**
     * The scale the numbers call for (scale_low, scale_high) and the distance
     * between the numbers of the y axis (scale_step) - and, on the way, how
     * many places and how many series of bars there are.
     */
    private def find_scale() {
        series_count : _int64 = layers.size();
        places = 0;
        bar_series_count = 0;
        for(j : _int64 = 0; j < series_count; j++) {
            if(layers.at(j).count > places) { places = layers.at(j).count; }
            if(layers.at(j).is_bars() == 1) { bar_series_count = bar_series_count + 1; }
        }
        wanted : _int64 = 5;
        if(up != null) { wanted = up!!.wanted; }
        scale_low = fixed_low;
        scale_high = fixed_high;
        scale_step = round_step(scale_low, scale_high, wanted);
        if(fixed == 0) {
            find_extent(bar_series_count);
            scale_low = pen.lowest;
            scale_high = pen.highest;
            if(scale_high == scale_low) { scale_high = scale_low + 1; }
            scale_step = round_step(scale_low, scale_high, wanted);
            scale_low = num.whole(scale_low / scale_step) * scale_step;
            scale_high = (0 - num.whole(0 - scale_high / scale_step)) * scale_step;
        }
        if(scale_high <= scale_low) { scale_high = scale_low + 1; }
    }

    // ================================================================ painting

    override def paint(p: painter) {
        host := ui_host.current!!;
        look : theme = host.look;
        now : decimal = host.now;
        painted_at = now;
        late_hot = 0 - 1;
        moving : _int64 = 0;

        // the widgets in it are painted only where this frame gives them a place
        kid_count : _int64 = me.kid_count();
        for(i : _int64 = 0; i < kid_count; i++) {
            me.kids.at(i).hidden = 1;
        }

