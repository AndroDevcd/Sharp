mod std.guikit.platform;

import (
    std.guikit.*
)

/**
 * window - a real operating-system window you can paint and get events from.
 *
 * This is the BASE the whole GUI stands on: open it, read events, paint a
 * frame, show it, repeat. The declarative layer (gui.column(), gui.button(),
 * state()) and the game canvas both render onto exactly this; they add no new
 * way to reach the screen, they only arrange what gets painted here.
 *
 * You do not load anything or manage any handle - make one through the front
 * door and drive it:
 *
 *      w := gui.window("hello", 640, 400);
 *      p := w.painter();
 *      while(w.is_open()) {
 *          e := w.next_event();
 *          while(e.kind != EVENT_NONE) {
 *              if(e.kind == EVENT_QUIT) { w.close(); }
 *              e = w.next_event();
 *          }
 *          w.clear(gui.rgb(24, 28, 40));
 *          p.circle(320, 200, 50, gui.rgb(255, 200, 0));
 *          w.show();
 *      }
 *
 * One window at a time for now. The user can resize it: ask width() and
 * height() each frame (or watch for EVENT_RESIZE) rather than remembering the
 * size you opened it with.
 */

/**
 * How a window sits on the screen.
 *
 *      windowed     an ordinary window of the size it was opened with
 *      maximized    fills the desktop; the title bar and the taskbar stay
 *      fullscreen   the whole screen and nothing else, at the resolution the
 *                   screen already has (a game, a kiosk on a Raspberry Pi)
 *
 * Open in a mode with gui.run("App", window_mode.fullscreen, ...), change it
 * while the program runs with gui.set_mode(...) or gui.fullscreen(true / false).
 * (The numbers are the ones the native side uses: MODE_* in sharpgui.cpp.)
 */
enum window_mode {
    windowed = 0,
    maximized = 1,
    fullscreen = 2
}

stable class window {
    // The native backend's id for this window (0 = not open). Private: the
    // outside world speaks to a window through its methods, never its handle.
    private handle : _int64 = 0;

    // The one event object, refilled by next_event() (no garbage per event),
    // and the one painter.
    private current : event;
    private brush : painter;

    // the mode to go back to when fullscreen(0) ends a fullscreen(1)
    private before_fullscreen : window_mode = window_mode.windowed;

    // ---- A WINDOW THAT IS NOT THERE (window(w, h), below): what stands in for the real one
    private pretend : bool = false;
    private pretend_open : bool = false;
    private pretend_w : _int32 = 0;
    private pretend_h : _int32 = 0;
    private sent : list<event> = new list<event>();        // the events send(...) put in, the oldest first
    private static pretend_clock : decimal = 0;              // seconds: moved only by pass_time (never back, also between windows)

    /**
     * A WINDOW THAT IS NOT THERE: nothing opens on any screen and the native
     * library is not loaded. It has a size, a clock and events like a real
     * one, but they are whatever the program says they are:
     *
     *      send(e)             an event to hand out from next_event()
     *      pass_time(0.5)      the clock moves on by half a second
     *      resize(w, h)        the size changes
     *
     * Painting on it paints nowhere (its painter is silent). It is what a UI test runs a screen on
     * (std.guikit.testing): the screen is built, laid out and clicked exactly
     * as on a real window, in no time, on a machine without a display.
     */
    window(w: _int32, h: _int32) {
        current = new event();
        brush = new painter();
        brush.silent = true;                           // it paints nowhere (painter.sharp)
        pretend = true;
        pretend_open = true;
        pretend_w = w;
        pretend_h = h;
        font.by_rule = true;                           // no font files without the native library (font.sharp)
    }

    /** is this a window that is not there? */
    def is_pretend() : bool {
        return pretend;
    }

    /**
     * Hand this event out from next_event(), after those sent before it and
     * before whatever the real mouse and keyboard did. On a window that is not
     * there these are the only events there are; on a real one it is how a UI
     * test that is being watched presses and types (std.guikit.testing).
     */
    def send(e: event) {
        sent.add(e);
    }

    /** a window that is not there: its clock moves on by this many seconds */
    def pass_time(seconds: decimal) {
        if(seconds > 0) { pretend_clock = pretend_clock + seconds; }
    }

    /** a window that is not there: it has this size from now on */
    def resize(w: _int32, h: _int32) {
        pretend_w = w;
        pretend_h = h;
    }

    window(title: string, w: _int32, h: _int32) {
        font.by_rule = false;
        surface.ensure_loaded();                       // first window loads the native lib
        current = new event();
        brush = new painter();
        handle = surface_open(title, w, h);
    }

    /**
     * The same, opened in a mode. w and h are still the size of the window
     * itself: what it has when it is, or goes back to being, windowed.
     */
    window(title: string, w: _int32, h: _int32, opened_as: window_mode) {
        font.by_rule = false;
        surface.ensure_loaded();
        current = new event();
        brush = new painter();
        code : _int64 = opened_as.ordinal;
        surface_mode(code);                            // before the window exists: the mode it opens in
        handle = surface_open(title, w, h);
    }

    /** change how the window sits on the screen, while it is open */
    def set_mode(next: window_mode) {
        if(handle == 0) {
            return;
        }
        code : _int64 = next.ordinal;
        surface_mode(code);
    }

    /** how the window sits on the screen right now (the user's own maximize button counts) */
    def mode() : window_mode {
        if(pretend) { return window_mode.windowed; }
        code : _int64 = surface_mode(0 - 1);           // a number that is no mode: only asks
        if(code == 2) { return window_mode.fullscreen; }
        if(code == 1) { return window_mode.maximized; }
        return window_mode.windowed;
    }

    /** true: take the whole screen. false: go back to what the window was before. */
    def fullscreen(on: bool) {
        if(on) {
            was : window_mode = mode();
            if(was != window_mode.fullscreen) {
                before_fullscreen = was;
            }
            set_mode(window_mode.fullscreen);
        } else if(mode() == window_mode.fullscreen) {
            set_mode(before_fullscreen);
        }
    }

    /** does the window have the whole screen? */
    def is_fullscreen() : bool {
        return mode() == window_mode.fullscreen;
    }

    /** is the window still open? (false if it never opened, or was closed) */
    def is_open() : bool {
        return handle != 0 || pretend_open;
    }

    /**
     * The next thing that happened. When nothing is waiting, its kind is
     * EVENT_NONE. The same event object is handed back every time, refilled.
     */
    def next_event() : event {
        if(pretend) {
            if(!pretend_open || sent.size() == 0) {
                current.kind = EVENT_NONE;
                return current;
            }
            return sent.pop_first();
        }
        if(handle == 0) {
            current.kind = EVENT_NONE;
            return current;
        }
        if(sent.size() > 0) {
            return sent.pop_first();
        }
        current.refill();
        return current;
    }

    /** what you draw with (see the painter class) */
    def painter() : painter {
        return brush;
    }

    /** the width of the drawing area right now, in pixels */
    def width() : _int32 {
        if(pretend) { return pretend_w; }
        return surface_width();
    }

    /** the height of the drawing area right now, in pixels */
    def height() : _int32 {
        if(pretend) { return pretend_h; }
        return surface_height();
    }

    /**
     * Seconds since the window opened, as a decimal (1.5 = one and a half
     * seconds). Animations and games measure with it: remember the last
     * frame's time and move things by (now - last) * speed.
     */
    def time() : decimal {
        if(pretend) { return pretend_clock; }
        return surface_time();
    }

    /** paint the whole window one colour: the start of every frame */
    def clear(c: color) {
        if(pretend) { return; }
        surface_fill(c.packed);
    }

    /** show the frame just painted. Waits for the screen's refresh (~60 fps). */
    def show() {
        if(pretend) { return; }
        surface_present();
    }

    /** take the window down. is_open() is false afterwards. */
    def close() {
        pretend_open = false;
        if(handle != 0) {
            surface_close(handle);
            handle = 0;
        }
    }
}
