    /** the symbols of one block: plain bytes, and repeats as a length and a distance back */
    private def codes(literals: huffman_codes, distances: huffman_codes) {
        length_base : _int64[] = deflate_tables.length_base;
        length_extra : _int64[] = deflate_tables.length_extra;
        distance_base : _int64[] = deflate_tables.distance_base;
        distance_extra : _int64[] = deflate_tables.distance_extra;
        while(true) {
            found : _int64 = decode(literals);
            if(found < 256) {
                if(made >= sizeof(out)) { grow(made + 1); }
                out[made] = found;
                made++;
            } else if(found == 256) {
                return;
            } else {
                found = found - 257;
                if(found >= 29) { throw new compress_exception("the compressed data is damaged (a length that does not exist)"); }
                length : _int64 = length_base[found] + need(length_extra[found]);
                found = decode(distances);
                if(found >= 30) { throw new compress_exception("the compressed data is damaged (a distance that does not exist)"); }
                back : _int64 = distance_base[found] + need(distance_extra[found]);
                if(back > made) { throw new compress_exception("the compressed data is damaged (a repeat from before the start)"); }
                if(made + length > sizeof(out)) { grow(made + length); }
                // byte by byte: a repeat may overlap what it writes ("1 back, 10 long" is ten times the last byte)
                from : _int64 = made - back;
                for(i : _int64 = 0; i < length; i++) { out[made + i] = out[from + i]; }
                made = made + length;
            }
        }
    }
}

/** compression: repeats found through a table of where each three bytes were seen, written in the fixed codes */
class deflater {
    private source : _int8[];
    private size : _int64 = 0;
    private out : _int8[];
    private made : _int64 = 0;
    private held : _int64 = 0;
    private held_bits : _int64 = 0;

    private static const TABLE : _int64 = 32768;            // places in the table of last positions
    private static const WINDOW : _int64 = 32768;           // how far back a repeat may reach
    private static const TRIES : _int64 = 48;               // earlier positions looked at for each repeat

    deflater(data: _int8[]?) {
        if(data == null) { source = new _int8[0]; }
        else { source = data!!; }
        size = sizeof(data);
        out = new _int8[size / 2 + 64];
    }

    private def bits(value: _int64, count: _int64) {
        held = held | (value << held_bits);
        held_bits = held_bits + count;
        while(held_bits >= 8) {
            if(made >= sizeof(out)) {
                next := new _int8[sizeof(out) * 2];
                memcopy(out, next, 0, 0, made);
                out = next;
            }
            out[made] = held & 0xFF;
            made++;
            held = held >> 8;
            held_bits = held_bits - 8;
        }
    }

    /** a code is written from its highest bit down: turn it round, then write it like any bits */
    private def code(value: _int64, count: _int64) {
        turned : _int64 = 0;
        for(i : _int64 = 0; i < count; i++) {
            turned = (turned << 1) | (value & 1);
            value = value >> 1;
        }
        bits(turned, count);
    }

    /** one symbol (a byte, the end, or a length) in the fixed codes */
    private def symbol(value: _int64) {
        if(value < 144) { code(0x30 + value, 8); }
        else if(value < 256) { code(0x190 + (value - 144), 9); }
        else if(value < 280) { code(value - 256, 7); }
        else { code(0xC0 + (value - 280), 8); }
    }

    private def repeat(length: _int64, back: _int64) {
        length_base : _int64[] = deflate_tables.length_base;
        index : _int64 = 28;
        if(length < 258) {
            index = 0;
            while(index < 27 && length_base[index + 1] <= length) { index++; }
        }
        symbol(257 + index);
        extra : _int64 = deflate_tables.length_extra[index];
        if(extra > 0) { bits(length - length_base[index], extra); }

        distance_base : _int64[] = deflate_tables.distance_base;
        index = 0;
        while(index < 29 && distance_base[index + 1] <= back) { index++; }
        code(index, 5);
        extra = deflate_tables.distance_extra[index];
        if(extra > 0) { bits(back - distance_base[index], extra); }
