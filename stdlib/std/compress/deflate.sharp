    def run() : _int8[] {
        bits(1, 1);         // the last block
        bits(1, 2);         // in the fixed codes
        head := new _int32[TABLE];              // the last position each three bytes were seen at, plus 1 (0: never)
        earlier := new _int32[size + 1];        // for each position: the one before it with the same three bytes, plus 1
        data : _int8[] = source;
        at : _int64 = 0;
        while(at < size) {
            best : _int64 = 0;
            best_back : _int64 = 0;
            if(at + 3 <= size) {
                key : _int64 = (((data[at] & 0xFF) << 10) ^ ((data[at + 1] & 0xFF) << 5) ^ (data[at + 2] & 0xFF)) & (TABLE - 1);
                candidate : _int64 = head[key];
                most : _int64 = size - at;
                if(most > 258) { most = 258; }
                tries : _int64 = 0;
                while(candidate != 0 && tries < TRIES) {
                    from : _int64 = candidate - 1;
                    if(at - from > WINDOW) { break; }
                    if(data[from + best] == data[at + best]) {
                        same : _int64 = 0;
                        while(same < most && data[from + same] == data[at + same]) { same++; }
