    def operator!=(num : double) := value!=num.value;
    def operator==(num : double) := value==num.value;
    def operator!=(num : decimal) := value!=num;
    def operator==(num : decimal) := value==num;
    def operator!=(num : _int8) := value!=num;
    def operator==(num : _int8) := value==num;
