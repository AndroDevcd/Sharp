mod std.system;

import ( std.io, std.math )

/**
 * Writes log messages with a level, optionally a time stamp, and a name, to
 * the console, to files, or to any text_writer.
 *
 *     log := new logger("server");
 *     log.add_console();
 *     log.add_file(new file("server.log"));
 *     log.set_level(logger.level_debug);
 *
 *     log.info("listening on port 8080");
 *     log.warn("disk almost full");
 *     log.debug("request took 12 ms");
 *     log.close();
 *
 *     2026-11-12 09:30:00.123 INFO  [server] listening on port 8080
 *
 * Levels, from chatty to serious: trace, debug, info, warn, error. A logger
 * writes the messages at its level and above (info by default) and drops
 * the rest; logger.level_off silences it.
 *
 * Format. Every message becomes one line built from a pattern with the
 * placeholders {time} {level} {name} {message}; the default is
 * "{time} {level} [{name}] {message}". set_format() changes it. The level
 * is padded to five characters so that the messages line up.
 *
 * Time. {time} is the time in UTC as "YYYY-MM-DD HH:MM:SS.mmm". The clock
 * can be replaced with set_clock() (a function that returns milliseconds
 * since 1970) - tests use that to get the same output on every run - or
 * time stamps can be left out altogether with set_timestamps(false), which
 * also removes "{time} " from the default format.
 *
 * Targets. A logger without a target writes nothing. File targets append
 * to their file. By default every message is flushed to all targets right
 * away, so nothing is lost when the program stops; for a file that means
 * rewriting it on every message (the runtime cannot append), which is fine
 * for ordinary logs and slow for very large ones - set_auto_flush(false)
 * and flush() or close() at the end are the remedy.
 *
 * A file that must not grow without end: add_rotating_file("server.log",
 * 1000000, 5) really appends (nothing is rewritten), and when the file
 * passes a million bytes it becomes server.log.1 - the old .1 becomes .2,
 * and so on, the fifth is deleted - and a new server.log is started.
 *
 * Several threads may log to one logger: each message is written whole,
 * one after the other.
 */
class logger {
    /* the levels */
    static const level_trace : decimal = 0;
    static const level_debug : decimal = 1;
    static const level_info : decimal = 2;
    static const level_warn : decimal = 3;
    static const level_error : decimal = 4;
    /** a level for set_level() that lets nothing through */
    static const level_off : decimal = 5;

    private logger_name : string;
    private level : decimal = 2;
    private targets := new list<text_writer>();
    private rotating := new list<rotating_log_file>();
    private pattern : string = "{time} {level} [{name}] {message}";
    private custom_pattern : decimal = 0;
    private timestamps : decimal = 1;
    private auto_flush : decimal = 1;
    private closed : decimal = 0;

    private has_clock : decimal = 0;
    private clock : ()(decimal);

    /** how many messages were written (passed the level) */
    private written : decimal = 0;
    /** how many messages were dropped because of the level */
    private dropped : decimal = 0;

    /** a logger called `name` at level info, without targets */
    logger(name: string) {
        logger_name = name;
    }

    /* ------------------------------------------------------------------ */
    /* configuration                                                       */
    /* ------------------------------------------------------------------ */

    /** the name given to the constructor, shown as {name} */
    def name() : string {
        return logger_name;
    }

    /**
     * Write messages of `new_level` and above (logger.level_trace .. logger.level_error,
     * or logger.level_off for none). Returns this logger.
     * Throws illegal_argument_exception for a number that is not a level.
     */
    def set_level(new_level: decimal) : logger {
        if(new_level < 0 || new_level > 5 || (new_level as _int32) != new_level) {
            throw new illegal_argument_exception("logger: not a level: " + io_strings.number_to_string(new_level));
        }
        level = new_level;
        return self;
    }

    /** the lowest level that is written */
    def get_level() : decimal {
        return level;
    }

    /** true when a message of `message_level` would be written - to skip building an expensive message that would be dropped */
    def is_enabled(message_level: decimal) : bool {
        return message_level >= level && level < 5;
    }

    /** the name of a level as it appears in messages: "TRACE", "DEBUG", "INFO", "WARN", "ERROR" ("OFF" for logger.level_off, "?" otherwise) */
    static def level_name(which: decimal) : string {
        if(which == 0) return "TRACE";
        if(which == 1) return "DEBUG";
        if(which == 2) return "INFO";
        if(which == 3) return "WARN";
        if(which == 4) return "ERROR";
        if(which == 5) return "OFF";
        return "?";
    }

    /**
     * The level with the given name, in any case: "debug", "WARN",
     * "warning" (same as warn), "off" ...
     * Throws illegal_argument_exception for any other word - for reading
     * the level from a configuration file or the command line.
     */
    static def level_of(word: string) : decimal {
        lower := io_strings.to_lower(io_strings.trim(word));
        if(lower == "trace") return 0;
        if(lower == "debug") return 1;
        if(lower == "info") return 2;
        if(lower == "warn") return 3;
        if(lower == "warning") return 3;
        if(lower == "error") return 4;
        if(lower == "off") return 5;
        throw new illegal_argument_exception("logger: not a level: " + word);
    }

    /** also print messages on the console. Returns this logger. */
    def add_console() : logger {
        targets.add(new console_writer());
        return self;
    }

    /**
     * Also append messages to the file `target` (created when it does not
     * exist). Returns this logger.
     * Throws io_exception when `target` is a directory.
     */
    def add_file(target: file) : logger {
        targets.add(new file_writer(target, true));
        return self;
    }

    /**
     * Also append messages to the file at `path`, and start a new file when
     * it has grown past `most_bytes`: the full one is kept as `path`.1, the
     * one before as `path`.2 ... up to `keep` old files (0: none is kept).
     * Returns this logger. Throws io_exception when the file cannot be opened.
     */
    def add_rotating_file(path: string, most_bytes: decimal, keep: decimal) : logger {
        if(most_bytes < 1) { throw new illegal_argument_exception("logger: a rotating file needs room for at least one byte"); }
        if(keep < 0) { throw new illegal_argument_exception("logger: the number of old files to keep cannot be negative"); }
        rotating.add(new rotating_log_file(path, most_bytes, keep));
        return self;
    }

    /** also write messages to `target` (a string_writer in tests, a buffered_writer, ...). Returns this logger. */
    def add_writer(target: text_writer) : logger {
        targets.add(target);
        return self;
    }

    /** how many targets the logger writes to */
    def target_count() : decimal {
        return targets.size() + rotating.size();
    }

    /**
     * The pattern every line is built from. Placeholders: {time} {level}
     * {name} {message}; everything else is copied as it is. Returns this
     * logger.
     */
    def set_format(new_pattern: string) : logger {
        pattern = new_pattern;
        custom_pattern = 1;
        return self;
    }

    /**
     * Show time stamps (true, the default) or not (false). Without them
     * {time} is replaced by nothing, and the default format loses its
     * "{time} " at the front. Returns this logger.
     */
    def set_timestamps(enabled: bool) : logger {
        if(enabled) {
            timestamps = 1;
        } else {
            timestamps = 0;
        }
        return self;
    }

    /**
     * Take the time from `source` instead of the clock of the machine: a
     * function without parameters that returns milliseconds since
     * 1970-01-01 00:00 UTC. Returns this logger.
     */
    def set_clock(source: ()(decimal)) : logger {
        clock = source;
        has_clock = 1;
        return self;
    }

    /** flush all targets after every message (true, the default) or only on flush() / close() (false). Returns this logger. */
    def set_auto_flush(enabled: bool) : logger {
        if(enabled) {
            auto_flush = 1;
        } else {
            auto_flush = 0;
        }
        return self;
    }

    /* ------------------------------------------------------------------ */
    /* logging                                                             */
    /* ------------------------------------------------------------------ */

    /** log `message` at level trace: very detailed tracing */
    def trace(message: string) {
        log(0, message);
    }

    /** log `message` at level debug: details for finding problems */
    def debug(message: string) {
        log(1, message);
    }

    /** log `message` at level info: normal events worth noting */
    def info(message: string) {
        log(2, message);
    }

    /** log `message` at level warn: something is odd but the program goes on */
    def warn(message: string) {
        log(3, message);
    }

    /** log `message` at level error: something failed */
    def error(message: string) {
        log(4, message);
    }

    /** log an exception at level error: `message`, then ": " and the message of the exception */
    def log_exception(message: string, problem: throwable) {
        buf := new char_buffer(128);
        buf.append(message).append(": ").append(problem.get_message());
        log(4, buf.build());
    }

    /**
     * Log `message` at `message_level` (logger.level_trace .. logger.level_error): when
     * the level is enabled, one line is written to every target.
     * Throws illegal_state_exception when the logger was closed,
     * illegal_argument_exception for a number that is not a level, and
     * io_exception when a file target cannot be written.
     */
    def log(message_level: decimal, message: string) {
        if(closed) {
            throw new illegal_state_exception("logger: the logger \"" + logger_name + "\" is closed");
        }
        if(message_level < 0 || message_level > 4 || (message_level as _int32) != message_level) {
            throw new illegal_argument_exception("logger: not a level for a message: " + io_strings.number_to_string(message_level));
        }
        if(message_level < level) {
            dropped++;
            return;
        }

        line := format_line(message_level, message);
        // one message at a time: two threads' lines must not be mixed, in a file or on the console
        lock(self) {
            written++;
            count : decimal = targets.size();
            for(i : decimal = 0; i < count; i++) {
                target := targets.at(i);
                target.write_line(line);
                if(auto_flush) {
                    target.flush();
                }
            }
            for(i : decimal = 0; i < rotating.size(); i++) {
                rotating.at(i).write_line(line, auto_flush != 0);
            }
        }
    }

    /** the line for one message, without a line end: the pattern with its placeholders filled in */
    def format_line(message_level: decimal, message: string) : string {
        used : string = pattern;
        if(!custom_pattern && !timestamps) {
            used = "{level} [{name}] {message}";
        }

        buf := new char_buffer(sizeof(used.data) + sizeof(message.data) + 32);
        n : decimal = sizeof(used.data);
        i : decimal = 0;
        while(i < n) {
            if(used.data[i] == '{') {
                if(matches(used, i, "{time}")) {
                    if(timestamps) {
                        buf.append(format_time(now()));
                    }
                    i += 6;
                    continue;
                }
                if(matches(used, i, "{level}")) {
                    buf.append(io_strings.pad_right(level_name(message_level), 5, ' '));
                    i += 7;
                    continue;
                }
                if(matches(used, i, "{name}")) {
                    buf.append(logger_name);
                    i += 6;
                    continue;
                }
                if(matches(used, i, "{message}")) {
                    buf.append(message);
                    i += 9;
                    continue;
                }
            }
            buf.append_char(used.data[i]);
            i++;
        }
        return buf.build();
    }

    /** true when `text` has `word` at index `at` */
    private static def matches(text: string, at: decimal, word: string) : bool {
        m : decimal = sizeof(word.data);
        if(at + m > sizeof(text.data)) {
            return false;
        }
        for(k : decimal = 0; k < m; k++) {
            if(text.data[at + k] != word.data[k]) {
                return false;
            }
        }
        return true;
    }

    /** the current time in milliseconds since 1970, from the injected clock or the machine */
    private def now() : decimal {
        if(has_clock) {
            return clock();
        }
        return utc_mills().value;
    }

    /**
     * Milliseconds since 1970-01-01 00:00 UTC as "YYYY-MM-DD HH:MM:SS.mmm"
     * (UTC, the proleptic Gregorian calendar). Negative values (before
     * 1970) are treated as 0.
     */
    static def format_time(mills: decimal) : string {
        if(mills < 0 || mills != mills) {
            mills = 0;
        }
        mills = floor(mills);
        ms : decimal = mills % 1000;
        seconds : decimal = (mills - ms) / 1000;
        second : decimal = seconds % 60;
        minutes : decimal = (seconds - second) / 60;
        minute : decimal = minutes % 60;
        hours : decimal = (minutes - minute) / 60;
        hour : decimal = hours % 24;
        days : decimal = (hours - hour) / 24;

        /*
        * Days since 1970-01-01 to year / month / day (the "civil from
        * days" method): shift the start to 0000-03-01 so that the leap day
        * is the last day of a year, then work in 400 year eras.
        */
        z : decimal = days + 719468;
        era : decimal = (z - z % 146097) / 146097;
        day_of_era : decimal = z - era * 146097;
        t1 : decimal = (day_of_era - day_of_era % 1460) / 1460;
        t2 : decimal = (day_of_era - day_of_era % 36524) / 36524;
        t3 : decimal = (day_of_era - day_of_era % 146096) / 146096;
        y0 : decimal = day_of_era - t1 + t2 - t3;
        year_of_era : decimal = (y0 - y0 % 365) / 365;
        year : decimal = year_of_era + era * 400;
        c1 : decimal = (year_of_era - year_of_era % 4) / 4;
        c2 : decimal = (year_of_era - year_of_era % 100) / 100;
        day_of_year : decimal = day_of_era - (365 * year_of_era + c1 - c2);
        m0 : decimal = 5 * day_of_year + 2;
        month_index : decimal = (m0 - m0 % 153) / 153;
        d0 : decimal = 153 * month_index + 2;
        day : decimal = day_of_year - (d0 - d0 % 5) / 5 + 1;
        month : decimal = month_index + 3;
        if(month > 12) {
            month -= 12;
        }
        if(month <= 2) {
            year++;
        }

        buf := new char_buffer(24);
        buf.append(io_strings.pad_left(io_strings.int_to_string(year), 4, '0')).append_char('-');
        buf.append(io_strings.pad_left(io_strings.int_to_string(month), 2, '0')).append_char('-');
        buf.append(io_strings.pad_left(io_strings.int_to_string(day), 2, '0')).append_char(' ');
        buf.append(io_strings.pad_left(io_strings.int_to_string(hour), 2, '0')).append_char(':');
        buf.append(io_strings.pad_left(io_strings.int_to_string(minute), 2, '0')).append_char(':');
        buf.append(io_strings.pad_left(io_strings.int_to_string(second), 2, '0')).append_char('.');
        buf.append(io_strings.pad_left(io_strings.int_to_string(ms), 3, '0'));
        return buf.build();
    }

    /** how many messages were written so far (they passed the level) */
    def get_written() : decimal {
        return written;
    }

    /** how many messages were dropped so far because their level was below the level of the logger */
    def get_dropped() : decimal {
        return dropped;
    }

    /**
     * Hand everything on to where it goes (files are written now).
     * Throws io_exception when a file cannot be written.
     */
    def flush() {
        lock(self) {
            count : decimal = targets.size();
            for(i : decimal = 0; i < count; i++) {
                targets.at(i).flush();
            }
            for(i : decimal = 0; i < rotating.size(); i++) { rotating.at(i).flush(); }
        }
    }

    /**
     * Flush and close all targets; logging afterwards throws
     * illegal_state_exception. Closing twice is fine.
     * Throws io_exception when a file cannot be written.
     */
    def close() {
        if(closed) {
            return;
        }
        closed = 1;
        lock(self) {
            count : decimal = targets.size();
            for(i : decimal = 0; i < count; i++) {
                targets.at(i).close();
            }
            for(i : decimal = 0; i < rotating.size(); i++) { rotating.at(i).close(); }
        }
    }
}

/**
 * A log file that is appended to and replaced by a new one when it is full
 * (logger.add_rotating_file). It is kept open; each line goes to the end of
 * the file, so nothing that is there is written again.
 */
class rotating_log_file {
    private path : string;
    private most : decimal;
    private keep : decimal;
    private stream : file_stream?;
    private size : decimal = 0;

    rotating_log_file(path: string, most: decimal, keep: decimal) {
        self->path = path;
        self->most = most;
        self->keep = keep;
        start();
    }

    private def start() {
        opened := file_stream.open(path, "a");
        stream = opened;
        size = new file(path).size();
    }

    def write_line(line: string, flush_now: bool) {
        if(stream == null) { return; }
        if(size > 0 && size + sizeof(line.data) + 1 > most) { rotate(); }
        stream!!.write_text(line);
        stream!!.write_text("\n");
        size = size + sizeof(line.data) + 1;
        if(flush_now) { stream!!.flush(); }
    }

    /** server.log -> server.log.1 -> server.log.2 ... ; the oldest is deleted; a new server.log is started */
    private def rotate() {
        stream!!.close();
        stream = null;
        if(keep < 1) {
            new file(path).remove();
        } else {
            // (a rename that did not work is passed over: the log goes on in a new file either way)
            oldest := new file(path + "." + (keep as _int64));
            if(oldest.exists()) { oldest.remove(); }
            for(number : _int64 = (keep as _int64) - 1; number >= 1; number--) {
                older := new file(path + "." + number);
                if(older.exists()) { file_natives.rename(older.path, path + "." + (number + 1)); }
            }
            file_natives.rename(path, path + ".1");
        }
        start();
    }

    def flush() {
        if(stream != null) { stream!!.flush(); }
    }

    def close() {
        if(stream != null) { stream!!.close(); stream = null; }
    }
}
