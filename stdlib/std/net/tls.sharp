    /** tell the other side this end is done (TLS's own goodbye, so it knows nothing was cut off) */
    private def goodbye_schannel() {
        if(context == null || outgoing == null) { return; }
        cred : c_memory = schannel_credential(checked);
        order := new c_memory(4);
        answer := new c_memory(16);
        attributes := new c_memory(4);
        expiry := new c_memory(8);
