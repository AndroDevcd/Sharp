mod std.text;

import ( std.io )

/**
 * template
 *
 * A text with named placeholders in braces that are filled in later:
 *
 *     t := new template("Dear {name}, your order {id} ships on {day}.");
 *     t.put("name", "Ada").put_int("id", 1042).put("day", "Monday");
 *     t.render()        "Dear Ada, your order 1042 ships on Monday."
 *
 * Rules
 *  - a placeholder is '{', a name, '}'. A name is made of letters, digits,
 *    '_', '.' and '-'; spaces directly inside the braces are ignored, so
 *    "{ name }" is the same as "{name}".
 *  - "{{" gives one '{' and "}}" gives one '}' (to write braces as text).
 *  - anything else in braces is not a placeholder and is copied as it is:
 *    "{}", "{a b}", "{x:y}", and a '{' that is never closed.
 *  - a placeholder whose name has no value is, by default, left in the
 *    output unchanged ("{day}"), so missing values are easy to spot. Choose
 *    another behaviour with set_missing_value("") or set_strict(true).
 *  - values are inserted as they are; a value containing "{x}" is NOT filled
 *    in again.
 *
 * The same template can be rendered many times with changing values: put()
 * with a name that already has a value replaces it.
 */
class template {
    private text : string = "";

    /* names[i] has the value values[i] */
    private names : list<string> = new list<string>();
    private values : list<string> = new list<string>();

    /* what to do about a placeholder without a value */
    private strict : decimal = 0;
    private missing_value : string = "";
    private has_missing_value : decimal = 0;

    /** A template with the given text and no values yet. */
    template(text: string) {
        self->text = text;
    }

    /** Index of `name` in names, or -1. */
    private def find(name: string): decimal {
        count : decimal = names.size();
        for(i : decimal = 0; i < count; i++) {
            if(names.at(i) == name) return i;
        }
        return -1;
    }

    /** true if `c` may be part of a placeholder name. */
    private static def is_name_char(c: decimal): bool {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '_' || c == '.' || c == '-';
    }

    /**
     * Sets the value for the placeholder `name`, replacing an earlier value.
     * Returns this template, so calls can be chained.
     * Throws illegal_argument_exception if the name is empty.
     */
    def put(name: string, value: string): template {
        if(sizeof(name.data) == 0)
            throw new illegal_argument_exception("put: the placeholder name cannot be empty");

        at : decimal = find(name);
        if(at >= 0) {
            values.put(at, value);
        } else {
            names.add(name);
            values.add(value);
        }
        return self;
    }

    /** put with a whole number as the value, written without decimals: put_int("count", 3) fills in "3". */
    def put_int(name: string, value: decimal): template {
        return put(name, number_format.integer(value));
    }

    /** put with a number as the value, written with exactly `decimals` decimals: put_number("price", 9.5, 2) fills in "9.50". */
    def put_number(name: string, value: decimal, decimals: int): template {
        return put(name, number_format.fixed(value, decimals));
    }

    /**
     * Sets several values at once: names[i] gets values[i].
     * Throws illegal_argument_exception if the arrays have different lengths.
     */
    def put_all(new_names: string[], new_values: string[]): template {
        count : decimal = sizeof(new_names);
        if(count != sizeof(new_values))
            throw new illegal_argument_exception("put_all: there must be as many values as names");
        for(i : decimal = 0; i < count; i++) {
            put(new_names[i], new_values[i]);
        }
        return self;
    }

    /** true if a value has been set for `name`. */
    def has(name: string): bool {
        return find(name) >= 0;
    }

    /** The value set for `name`, or `fallback` if there is none. */
    def value_of(name: string, fallback: string): string {
        at : decimal = find(name);
        if(at < 0) return fallback;
        return values.at(at);
    }

    /** Forgets the value of `name` (nothing happens if it has none). Returns this template. */
    def remove(name: string): template {
        at : decimal = find(name);
        if(at >= 0) {
            names.remove_at(at);
            values.remove_at(at);
        }
        return self;
    }

    /** Forgets all values. The text and the missing-value settings are kept. */
    def clear(): template {
        names.clear();
        values.clear();
        return self;
    }

    /**
     * true: render() throws no_such_element_exception when a placeholder has no
     * value. false (the default): see set_missing_value.
     */
    def set_strict(on: bool): template {
        strict = on;
        return self;
    }

    /**
     * The text to put in place of a placeholder that has no value (often "").
     * Without this call such a placeholder is left in the output unchanged.
     */
    def set_missing_value(value: string): template {
        missing_value = value;
        has_missing_value = 1;
        return self;
    }

    /** The template text as given to the constructor. */
    def source(): string {
        return text;
    }

    /**
     * If a placeholder starts at the '{' at position `open`, returns the
     * position of its closing '}'; otherwise -1.
     */
    private def placeholder_end(open: decimal): decimal {
        d := text.data;
        n : decimal = sizeof(d);
        i : decimal = open + 1;
        while(i < n && d[i] == ' ') { i++; }
        name_start : decimal = i;
        while(i < n && is_name_char(d[i])) { i++; }
        if(i == name_start) return -1;
        while(i < n && d[i] == ' ') { i++; }
        if(i < n && d[i] == '}') return i;
        return -1;
    }

    /** The name inside the placeholder that runs from the '{' at `open` to the '}' at `close`. */
    private def placeholder_name(open: decimal, close: decimal): string {
        d := text.data;
        from : decimal = open + 1;
        to : decimal = close;
        while(from < to && d[from] == ' ') { from++; }
        while(to > from && d[to - 1] == ' ') { to--; }
        return new string(d!!, from, to);
    }

    /**
     * The names of the placeholders in the text, each once, in the order they
     * first appear. A text without placeholders gives an array of length 0.
     */
    def placeholders(): string[] {
        found := new list<string>();
        d := text.data;
        n : decimal = sizeof(d);
        i : decimal = 0;
        while(i < n) {
            c : decimal = d[i];
            if(c == '{' && i + 1 < n && d[i + 1] == '{') {
                i += 2;
            } else if(c == '{') {
                close : decimal = placeholder_end(i);
                if(close < 0) {
                    i++;
                } else {
                    name := placeholder_name(i, close);
                    known : decimal = 0;
                    count : decimal = found.size();
                    for(k : decimal = 0; k < count; k++) {
                        if(found.at(k) == name) known = 1;
                    }
                    if(!known) found.add(name);
                    i = close + 1;
                }
            } else {
                i++;
            }
        }

        if(found.is_empty()) return new string[0];
        return found.get_elements()!!;
    }

    /**
     * The text with every placeholder replaced by its value.
     * Throws no_such_element_exception if a placeholder has no value and
     * set_strict(true) was called.
     */
    def render(): string {
        d := text.data;
        n : decimal = sizeof(d);
        out := new char_buffer();
        i : decimal = 0;
        while(i < n) {
            c : decimal = d[i];
            if(c == '{' && i + 1 < n && d[i + 1] == '{') {
                out.append_char('{');
                i += 2;
            } else if(c == '}' && i + 1 < n && d[i + 1] == '}') {
                out.append_char('}');
                i += 2;
            } else if(c == '{') {
                close : decimal = placeholder_end(i);
                if(close < 0) {
                    out.append_char(c);                 // not a placeholder: an ordinary brace
                    i++;
                } else {
                    name := placeholder_name(i, close);
                    at : decimal = find(name);
                    if(at >= 0) {
                        out.append(values.at(at));
                    } else if(strict) {
                        throw new no_such_element_exception("template: no value for placeholder {" + name + "}");
                    } else if(has_missing_value) {
                        out.append(missing_value);
                    } else {
                        out.append(new string(d!!, i, close + 1));     // leave it as it is
                    }
                    i = close + 1;
                }
            } else {
                out.append_char(c);
                i++;
            }
        }
        return out.build();
    }

    /**
     * One-off rendering: `text` with each placeholder names[i] replaced by
     * values[i]. Placeholders without a value are left unchanged.
     * Throws illegal_argument_exception if the arrays have different lengths.
     */
    static def render(text: string, names: string[], values: string[]): string {
        return new template(text).put_all(names, values).render();
    }

    /** Same as render(), so a template can be printed directly. */
    override def to_string() : string? {
        return render();
    }
}
