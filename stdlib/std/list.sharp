    /** true when the list has no elements. O(1). */
    def is_empty() : bool {
        return n_elements == 0;
    }

    /** true when an element equals `element` (compared with `==`). O(n). */
    def contains(element: T) : bool {
        for(i : _int64 = 0; i < n_elements; i++) {
            if(element == data[i]) return true;
        }
        return false;
    }

    /** Position of the last element that equals `element`, or -1 (index_of gives the first). O(n). */
    def last_index_of(element: T) : _int64 {
        for(i : _int64 = n_elements - 1; i >= 0; i--) {
            if(element == data[i]) return i;
        }
        return -1;
    }

    /**
     * A new array with the elements, in order. Unlike get_elements() it
     * never returns null: an empty list gives an array of length 0. O(n).
     */
    def to_array() : T[] {
        result := new T[n_elements];
        for(i : _int64 = 0; i < n_elements; i++)
            result[i] = data[i];
        return result;
    }

    /**
     * A new, independent list with the elements at positions
     * from .. to - 1 (`from` included, `to` not). O(to - from).
     *
     * @throws out_of_bounds_exception when from < 0, to > size() or from > to
     */
    def sub_list(from: int, to: int) : list<T> {
        if(from.value < 0 || to.value > n_elements || from.value > to.value)
            throw new out_of_bounds_exception("sub_list: range $from..$to is out of bounds");

        result := new list<T>();
        for(i : _int64 = from.value; i < to.value; i++)
            result.add(data[i]);
        return result;
    }

    /** Reverse the order of the elements in place. O(n). */
    def reverse() {
        low : _int64 = 0;
        high : _int64 = n_elements - 1;
        while(low < high) {
            held := data[low];
            data[low] = data[high];
            data[high] = held;
            low++;
            high--;
        }
    }

    /**
     * Sort the list in place. `compare(a, b)` answers a negative number
     * when a sorts before b, 0 when they sort the same, a positive number
     * when a sorts after b:
     *
     *     numbers.sort({ a: int, b: int -> (decimal) return a.value - b.value; });
     *
     * O(n log n) for any input, and stable - elements that compare as equal
     * keep their order (see sort_array).
     */
    def sort(compare: (T, T)(decimal)) {
        if(n_elements < 2) return;
        sort_array(data!!, n_elements, compare);
    }

    /**
     * Sort the first `count` elements of an array in place. This is the
     * merge sort of the library: list.sort, arrays<T>.sort and the sorted
     * functions of a list all come here.
     *
     * Written bottom-up (loops only, no recursion): sorted runs of length
     * 1, 2, 4, 8, ... are merged pairwise until one run covers everything.
     * Always O(n log n) comparisons, also for input that is sorted or
     * reversed, and stable. Uses one spare array of `count` elements.
     */
    static def sort_array(items: T[], count: _int64, compare: (T, T)(decimal)) {
        if(count < 2) return;

        source := items;            // the array the current runs are in
        target := new T[count];     // the array they are merged into
        in_spare : _int64 = 0;      // 1 while `source` is the spare array
        for(width : _int64 = 1; width < count; width = width * 2) {
            for(low : _int64 = 0; low < count; low = low + width * 2) {
                middle : _int64 = low + width;
                if(middle > count) middle = count;
                high : _int64 = low + width * 2;
                if(high > count) high = count;

                // merge source[low, middle) and source[middle, high) into target[low, high)
                left : _int64 = low;
                right : _int64 = middle;
                out : _int64 = low;
                while(left < middle && right < high) {
                    // "<=" takes from the left run on a tie: that keeps the sort stable
                    if(compare(source[left], source[right]) <= 0) target[out++] = source[left++];
                    else target[out++] = source[right++];
                }
                while(left < middle) target[out++] = source[left++];
                while(right < high) target[out++] = source[right++];
            }

            held := source;
            source = target;
            target = held;
            in_spare = 1 - in_spare;
        }

        // the last pass may have written the spare array: its elements go back
        if(in_spare) {
            for(i : _int64 = 0; i < count; i++) items[i] = source[i];
        }
    }

    /** The text of the exception for a bad index. */
    /**
     * Raise the exception for a position outside the list. It is a function of
     * its own so that `at` and `[]` stay a test and a read: small enough for the
     * optimizer to put them straight into the loop that calls them.
     */
    private def fail_out_of_bounds(index: int) {
        throw new out_of_bounds_exception(out_of_bounds_msg(index));
    }

    private def out_of_bounds_msg(index: int) : string {
        // (an int object, so the size prints as "3" and not "3.0000000000000000")
        count : int = n_elements;
        return "Index: $index, size: $count";
    }
}
