mod settings;

class settings {
    /*
     * Activate aggressive error reporting for the compiler.
     */
    show_all_errors := false;

    /*
     * Only compile all the files
     */
    compile_only := false;

    /*
     * Output file to write to
     */
    output_file := "out";

    /*
     * Target api version for the standard library
     */
    target_api := "0.3.0";

    /*
     * Name of new project to create
     */
    new_project_dir : string = "";

    /*
     * Location of the project you want to compile
     */
    project_dir : string = "";

    /*
     * List of user defined library paths
     */
    libraries := new list<string>();

    /*
     * Set code to be debuggable (flag only used in manifest creation)
     */
    debug := true;

    /*
     * Easter egg to enable magic mode
     */
    magic := false;

    /*
     * Set the max target threads to compile with
     */ 
    target_threads := 0;

    /*
     * Developer mode for extra data printouts
     */ 
    developer := false;

    /*
     * Target platform to run on
     */ 
    target : int = alpha_cr4.ordinal;

    /*
     * Display warnings
     */
    warnings := true;

    /*
     * Enable warnings as errors
     */
    werrors := false;

    /*
     * Maximum errors the compiler will allow
     */
    max_errors := 1000;

    /*
     * Set how compiler processes files to be compiled
     */
    mode := file_mode;

    /*
     * Run source code after successful compilation
     */
    run := false; 

    /*
     * Clean cache before compilation
     */
    clean_build := false;

    /*
     * Set to optimize code
     */
    optimize := false;

    /*
     * Set compiler threads to be throttled for less energy consumption
     */
    throttle_threads := false;

    /*
     * Application version
     */
    version : string = "1.0";

    /*
     * List of ignored directories
     */
    ignored_directories := new list<string>();

    /*
     * List of ignored files
     */
    ignored_files := new list<string>();
}

options: settings = new settings();
settings_file_name : string = "settings.json";

// WARNING SWITCHES
const __w_general := 0;
const __w_access := 1;
const __w_ambig := 2;
const __w_decl := 3;
const __w_main := 4;
const __w_cast := 5;
const __w_init := 6;
const __w_null := 7;
const __w_dep := 8;

warning_options := new var[]
{
    true,    // general warnings
    true,    // waccess
    true,   // wambig
    true,   // wdecl
    true,   // wmain
    true,   // wcast
    true,    // winit
    true,    // wnull
    true    // wdep
};

enum compilation_mode {
    /*
    * This mode specifies that you must explicitly pass in
    * any files that you want compiled
    */
    file_mode,

    /*
    * This mode specifies that you want to run the compiler in project mode,
    * signifying that you do not have to explicitly provide any files to be compiled.
    * Any additional files and or directories added to the options will also be added
    * to the compilation list as well.
    */
    project_mode
};