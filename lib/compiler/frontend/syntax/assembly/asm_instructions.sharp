    table.put("distore", "L");
    table.put("smovr2", "AR");
    table.put("putf", "AR");
    table.put("smovr3", "L");
    table.put("istorel", "LL");
    table.put("distorel", "LL");
    table.put("popl", "A");
    table.put("pushNull", "");
    table.put("ipushl", "A");
    table.put("pushl", "A");
    table.put("itest", "R");
    table.put("invokeDelegate", "LLL");
    table.put("get", "R");
    table.put("isadd", "LL");
    table.put("disadd", "LL");
    table.put("je", "L");
    table.put("jne", "L");
    table.put("ipopl", "A");
    table.put("cmp", "RL");
