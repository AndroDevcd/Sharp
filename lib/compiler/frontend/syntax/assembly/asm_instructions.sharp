    table.put("tlsMovl", "L");
    table.put("dup", "");
    table.put("popObj2", "");
    table.put("swap", "");
    table.put("ldc", "RL");
    table.put("neg", "RR");
    table.put("dneg", "RR");
    table.put("dsqrt", "RR");
    table.put("dfloor", "RR");
    table.put("dceil", "RR");
    table.put("dabs", "RR");
