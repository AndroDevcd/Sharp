mod backend.finalizer.sni;

import (
    std.io
)

/**
 * sni.h, THE INTERFACE A NATIVE LIBRARY IS WRITTEN AGAINST - as text.
 *
 * A COPY of lib/runtime/sni/sni.h, made by build-scripts/embed_sni_header.py.
 * Never edit this file: change sni.h and run the script again.
 */
def sni_header_text() : string {
    text := new string_builder("");
    text.append("//\n");
    text.append("// SNI - THE SHARP NATIVE INTERFACE\n");
    text.append("// ================================\n");
    text.append("// How a Sharp program calls a function written in C++, and what that function\n");
    text.append("// may do while it runs. This one header is everything a native library sees of\n");
    text.append("// the VM; it is copied next to your code by `sharpc -sni <folder>`.\n");
    text.append("//\n");
    text.append("// THE WHOLE IDEA IN FOUR LINES\n");
    text.append("//\n");
    text.append("//      Sharp:    native \"sensors\" { def read(port: _int32) : decimal; }\n");
    text.append("//                load_library(\"sensors\");                     (before the first call)\n");
    text.append("//      build:    sharpc main.sharp -o app -sni native/        (writes native/sensors_sni.h and .cpp)\n");
    text.append("//      C++:      double sensors_read(sni_env* env, int32_t port) { return 0.5 * port; }\n");
    text.append("//      library:  g++ -shared native/*.cpp -o sensors.dll      (or sensors.so)\n");
    text.append("//\n");
    text.append("// Your function gets real C++ types for numbers. Everything else - text, an\n");
    text.append("// array, any object - arrives as an `sni_ref`, and you ask `env` about it.\n");
    text.append("//\n");
    text.append("// THE THREE THINGS TO KNOW\n");
    text.append("//\n");
    text.append("//   1. A REFERENCE (`sni_ref`) you were handed, or that `env` gave you, is good\n");
    text.append("//      until your function returns. To hold on to an object for longer, ask:\n");
    text.append("//      `env->keep(ref)` - and `env->drop(ref)` when you are done with it.\n");
    text.append("//\n");
    text.append("//   2. A LOOP THAT RUNS FOR A WHILE asks `env->should_stop()` now and then and\n");
    text.append("//      returns when it says yes. The VM cannot interrupt C++; this is how a\n");
    text.append("//      thread that is asked to stop gets to stop.\n");
    text.append("//\n");
    text.append("//   3. A PROBLEM is reported with `env->raise(\"std#illegal_argument_exception\",\n");
    text.append("//      \"port must be 0 or more\")`, followed by a plain `return`. The exception\n");
    text.append("//      is raised in Sharp, at the call.\n");
    text.append("//\n");
    text.append("// This header is plain C underneath (a table of functions with a version\n");
    text.append("// number), with C++ spellings on top, so `env->text(s)` in C++ is\n");
    text.append("// `env->api->text(env, s)` in C.\n");
    text.append("//\n");
    text.append("//      Java comparison: the JNI's JNIEnv, jobject, NewGlobalRef.\n");
    text.append("//\n");
    text.append("\n");
    text.append("#ifndef SHARP_SNI_H\n");
    text.append("#define SHARP_SNI_H\n");
    text.append("\n");
    text.append("#include <stdint.h>\n");
    text.append("\n");
    text.append("#ifdef __cplusplus\n");
    text.append("#include <string>\n");
    text.append("extern \"C\" {\n");
    text.append("#endif\n");
    text.append("\n");
    text.append("/** The version of this interface. A library says which one it was built with; the VM refuses one it does not know. */\n");
    text.append("#define SNI_VERSION 1\n");
    text.append("\n");
    text.append("/** A reference to a Sharp object: text, an array, an instance of a class. 0 is null. Never look inside it. */\n");
    text.append("typedef struct sni_object_* sni_ref;\n");
    text.append("\n");
    text.append("/** One argument or one result, as the generated glue passes it: a whole number, a decimal, or a reference. */\n");
    text.append("typedef union sni_value {\n");
    text.append("    int64_t i;\n");
    text.append("    double d;\n");
    text.append("    sni_ref r;\n");
    text.append("} sni_value;\n");
    text.append("\n");
    text.append("/**\n");
    text.append(" * The elements of a number array (or the bytes of a text), read and written in\n");
    text.append(" * place - no copy is made. `data` points at `count` elements of `element_size`\n");
    text.append(" * bytes each. It stays right for as long as you may use the reference it came\n");
    text.append(" * from. `data` is null for null and for an array without elements.\n");
    text.append(" */\n");
    text.append("typedef struct sni_array {\n");
    text.append("    void* data;\n");
    text.append("    int64_t count;\n");
    text.append("    int32_t element_size;       // 1, 2, 4 or 8\n");
    text.append("    int32_t kind;               // SNI_INT8 ... SNI_DECIMAL: what the elements are\n");
    text.append("} sni_array;\n");
    text.append("\n");
    text.append("/** The kinds of number an array can hold (for `new_array`, and in `sni_array.kind`). */\n");
    text.append("#define SNI_INT8    0\n");
    text.append("#define SNI_INT16   1\n");
    text.append("#define SNI_INT32   2\n");
    text.append("#define SNI_INT64   3\n");
    text.append("#define SNI_UINT8   4\n");
    text.append("#define SNI_UINT16  5\n");
    text.append("#define SNI_UINT32  6\n");
    text.append("#define SNI_UINT64  7\n");
    text.append("#define SNI_DECIMAL 9\n");
    text.append("\n");
    text.append("struct sni_env;\n");
    text.append("\n");
    text.append("/** What the VM offers a native function. New entries are only ever added at the end. */\n");
    text.append("typedef struct sni_api {\n");
    text.append("    int32_t version;\n");
    text.append("\n");
    text.append("    /** 1 when this thread was asked to stop (or the program is ending): return as soon as you can. */\n");
    text.append("    int32_t (*should_stop)(struct sni_env* env);\n");
    text.append("\n");
    text.append("    /** Report a problem: an exception of this Sharp class (`module#class`) with this message is raised when you return. */\n");
    text.append("    void (*raise)(struct sni_env* env, const char* class_name, const char* message);\n");
    text.append("    /** 1 when a problem was reported (by you, or by something `env` did for you) and not cleared. */\n");
    text.append("    int32_t (*pending)(struct sni_env* env);\n");
    text.append("    /** Forget the reported problem. */\n");
    text.append("    void (*clear)(struct sni_env* env);\n");
    text.append("\n");
    text.append("    /** Keep an object alive after your function returns. Returns the reference to use from then on. */\n");
    text.append("    sni_ref (*keep)(struct sni_env* env, sni_ref ref);\n");
    text.append("    /** Give a kept reference back. */\n");
    text.append("    void (*drop)(struct sni_env* env, sni_ref ref);\n");
    text.append("\n");
    text.append("    /** The elements of a number array, in place. */\n");
    text.append("    sni_array (*array)(struct sni_env* env, sni_ref array);\n");
    text.append("    /** A new number array of `count` elements of this kind (SNI_INT8 ...), all 0. */\n");
    text.append("    sni_ref (*new_array)(struct sni_env* env, int32_t kind, int64_t count);\n");
    text.append("\n");
    text.append("    /** The bytes of a Sharp string (UTF-8, NOT ended by a 0), in place. */\n");
    text.append("    sni_array (*text)(struct sni_env* env, sni_ref string);\n");
    text.append("    /** A new Sharp string holding these `count` bytes. */\n");
    text.append("    sni_ref (*new_text)(struct sni_env* env, const char* chars, int64_t count);\n");
    text.append("} sni_api;\n");
    text.append("\n");
    text.append("/** What every native function is handed first: the way back into the VM. Use it only on the thread it was given to. */\n");
    text.append("typedef struct sni_env {\n");
    text.append("    const sni_api* api;\n");
    text.append("    void* thread;               // the VM's own; nothing for a library to read\n");
    text.append("\n");
    text.append("#ifdef __cplusplus\n");
    text.append("    bool should_stop() { return api->should_stop(this) != 0; }\n");
    text.append("\n");
    text.append("    void raise(const char* class_name, const char* message) { api->raise(this, class_name, message); }\n");
    text.append("    void raise(const char* class_name, const std::string& message) { api->raise(this, class_name, message.c_str()); }\n");
    text.append("    bool pending() { return api->pending(this) != 0; }\n");
    text.append("    void clear() { api->clear(this); }\n");
    text.append("\n");
    text.append("    sni_ref keep(sni_ref ref) { return api->keep(this, ref); }\n");
    text.append("    void drop(sni_ref ref) { api->drop(this, ref); }\n");
    text.append("\n");
    text.append("    sni_array array(sni_ref ref) { return api->array(this, ref); }\n");
    text.append("    sni_ref new_array(int32_t kind, int64_t count) { return api->new_array(this, kind, count); }\n");
    text.append("\n");
    text.append("    /** A copy of a Sharp string's text (\"\" for null). */\n");
    text.append("    std::string text(sni_ref string) {\n");
    text.append("        sni_array bytes = api->text(this, string);\n");
    text.append("        return bytes.data == nullptr ? std::string() : std::string((const char*) bytes.data, (size_t) bytes.count);\n");
    text.append("    }\n");
    text.append("    sni_ref new_text(const std::string& chars) { return api->new_text(this, chars.data(), (int64_t) chars.size()); }\n");
    text.append("    sni_ref new_text(const char* chars) { return new_text(std::string(chars == nullptr ? \"\" : chars)); }\n");
    text.append("#endif\n");
    text.append("} sni_env;\n");
    text.append("\n");
    text.append("// ---------------------------------------------------------------------------------\n");
    text.append("// What a library exports. `sharpc -sni` writes all of it (<library>_sni.cpp): you\n");
    text.append("// never fill these in by hand.\n");
    text.append("// ---------------------------------------------------------------------------------\n");
    text.append("\n");
    text.append("/** The glue of one native function: unpacks `arguments`, calls your function, stores what it returned in `result`. */\n");
    text.append("typedef void (*sni_glue)(sni_env* env, sni_value* arguments, sni_value* result);\n");
    text.append("\n");
    text.append("/** One native function of a library: its Sharp name, its signature as text, and its glue. */\n");
    text.append("typedef struct sni_function {\n");
    text.append("    const char* name;           // \"sensors#__srt_global.read\"\n");
    text.append("    const char* signature;      // \"(_int32)decimal\": the VM compares it with the program's\n");
    text.append("    sni_glue glue;\n");
    text.append("} sni_function;\n");
    text.append("\n");
    text.append("/** A library's table. The one function a library exports, `sni_library_table`, returns it. */\n");
    text.append("typedef struct sni_library {\n");
    text.append("    int32_t version;            // SNI_VERSION when it was built\n");
    text.append("    const char* name;           // \"sensors\"\n");
    text.append("    int32_t count;\n");
    text.append("    const sni_function* functions;\n");
    text.append("} sni_library;\n");
    text.append("\n");
    text.append("#if defined(_WIN32) || defined(__CYGWIN__)\n");
    text.append("#define SNI_EXPORT __declspec(dllexport)\n");
    text.append("#else\n");
    text.append("#define SNI_EXPORT __attribute__((visibility(\"default\")))\n");
    text.append("#endif\n");
    text.append("\n");
    text.append("#ifdef __cplusplus\n");
    text.append("}\n");
    text.append("#endif\n");
    text.append("\n");
    text.append("#endif //SHARP_SNI_H\n");
    return text.build();
}
