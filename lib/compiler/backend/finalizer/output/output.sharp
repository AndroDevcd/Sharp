mod backend.finalizer.output;

import (
    std.io,
    backend.finalizer.layout
)

/**
 * THE EXECUTABLE FILE: the last step of code generation (doc/codegen.md 2.2, section 3)
 *
 * Everything is decided by now - every class, field and function has its
 * number (layout), every function its code (bytecode). This step only puts it
 * into the bytes the VM's loader reads, section by section, and writes them
 * to the output file in one go.
 *
 *      write_executable(layout, options, "/tmp/hello")
 *
 * The bootstrap never compresses the file: the loader reads an uncompressed
 * file of any size, and Sharp has no zlib (codegen.md 3.10, G5).
 *
 * The files of this package (module `backend.finalizer.output`):
 *
 *      output.sharp            this front door: write_executable
 *      byte_buffer.sharp       the bytes: big-endian int32, texts, flag chars
 *      sections.sharp          header, manifest, symbols, strings, constants, data, code, meta
 *
 * (The texts of the decimal constants are made when the code is: layout/tables.sharp.)
 *
 *      C++ comparison: finalizer/generation/file_generator.cpp.
 */
def executable_bytes(layout: program_layout, options: executable_options) : _int8[] {
    out := new byte_buffer();
    write_header(out);
    write_manifest(out, layout, options);
    write_symbols(out, layout);
    write_strings(out, layout);
    write_constants(out, layout);
    write_function_records(out, layout);
    write_code(out, layout);
    write_meta(out, layout, options);
    write_externs(out, layout, options);
    return out.to_array();
}

/**
 * Write the executable to `path`. Returns "" when it was written, otherwise
 * what went wrong (the folder does not exist, the file cannot be written).
 */
def write_executable(layout: program_layout, options: executable_options, path: string) : string {
    bytes := executable_bytes(layout, options);
    try {
        target := new file(path);
        target.write_bytes(bytes);
    } catch(e: exception) {
        return why_not_written(path);
    }
    return "";
}

/**
 * The reason a file could not be written, in words, with the fix. (The
 * library's exception only repeats the path: "could not write file: X".)
 * The folder it goes into is looked at: missing, a file, or there and not
 * writable.
 */
def why_not_written(path: string) : string {
    folder : string = ".";
    parent : string? = file_natives.parent_of(path);
    if(parent != null && sizeof(parent!!.data) > 0) { folder = parent!!; }
    into := new file(folder);
    if(!into.exists()) {
        return "could not write `" + path + "`: the folder `" + folder + "` does not exist\n  = help: make it first (`mkdir -p " + folder + "`), or write the executable somewhere else with -o";
    }
    if(!into.is_directory()) {
        return "could not write `" + path + "`: `" + folder + "` is a file, not a folder\n  = help: write the executable somewhere else with -o";
    }
    target := new file(path);
    if(target.is_directory()) {
        return "could not write `" + path + "`: that is a folder\n  = help: name the executable inside it: `-o " + path + "/<name>`";
    }
    return "could not write `" + path + "`: the folder `" + folder + "` is not writable (permission), or the disk is full\n  = help: write the executable into a folder you may write to, with -o";
}
