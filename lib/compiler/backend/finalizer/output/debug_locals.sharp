mod backend.finalizer.output;

import (
    std.io,
    frontend.lexer,
    frontend.syntax.tree,
    backend.types.declarations,
    backend.types.type_system,
    backend.finalizer.ir,
    backend.finalizer.layout
)

/**
 * THE DEBUGGER'S SECTION: WHAT sdb NEEDS AND THE VM DOES NOT
 *
 * To the VM a local variable is a numbered slot of a frame and a `bool` field
 * is a one-byte number; the names and the fine kinds are gone once the code is
 * made. With -dbg they are kept, in a section of their own at the very end of
 * the file, so that sdb (lib/debugger) can show `note = "milk"` where the VM
 * only has "slot 2", and `ready = true` where it has 1:
 *
 *      3B
 *      38                                      the program's names were replaced (-obf, an `obfuscate` block)
 *      37                                      the program was optimized (-O)
 *      per function that has any variable:
 *          3A   its address (int32)   how many variables follow (int32)
 *          per variable:
 *              its name (text)   kind   first line   last line   (int32 each)
 *              slot (int32)
 *              how many steps follow (int32), then per step: a field (int32)
 *              field (int32)
 *      per class that has a `bool` field:
 *          39   its address (int32)   how many fields follow (int32)
 *          per field:  its place among the class's fields   kind      (int32 each)
 *      0A 1D
 *
 * A VARIABLE
 *
 *      kind        what it holds - LOCAL_OBJECT, or which number (below);
 *                  LOCAL_BOOL_ARRAY: an array whose elements are bools.
 *                  With LOCAL_OF_LOOP_HEAD added: the variable of a `for` or
 *                  `foreach` head. Its line is the loop's line, which runs again
 *                  on every turn - so being ON its line does not mean it has no
 *                  value yet, as it does for every other variable.
 *      first line, last line
 *                  where the variable can be named: from the line it is declared
 *                  on to the last line of the block (or `for`, `foreach`, `catch`)
 *                  it is declared in.
 *                  first line 0: from the function's start - `self`, a parameter.
 *                  last line 0: to the function's end - those two, and a variable
 *                  of the function's outermost block.
 *                  Two variables of one name in two blocks are two entries; the
 *                  lines say which one a place in the code means. Before its
 *                  first line a variable's slot holds whatever was there.
 *      slot, steps, field
 *                  WHERE IT LIVES (its "home"):
 *                    field -1    in the function's frame, at `slot` (codegen.md 4.4)
 *                    field >= 0  in a closure record (6.12) - a lambda uses it. The
 *                                record is found by reading `slot` of the frame,
 *                                then, for each step, that field of the record
 *                                reached so far (its `@parent`); the variable is
 *                                `field` of the record reached last.
 *                    field -2    a `localized` variable (6.17): each fiber has its own, at
 *                                the bottom of the fiber's stack - `slot` counted from there
 *
 * WHICH VARIABLES OF A FUNCTION
 *   - `self`, its parameters and the locals a programmer wrote (the compiler's
 *     own hidden locals are left out). One a lambda uses is in the function's
 *     own record, whose slot the frame keeps.
 *   - for a LAMBDA also every variable of the functions around it that lambdas
 *     use - what its code can name beyond its own: they are in the record it
 *     was handed (a hidden parameter) and that record's parents. `self` is among
 *     them when a lambda uses the object. They are written BEFORE the lambda's
 *     own, so that of two with one name the lambda's own is found last and wins.
 *
 * A BOOL FIELD
 *      its place   the field's position in the class's record of the symbol
 *                  section (write_class: the instance fields first, with those of
 *                  the classes above, then the static ones)
 *      kind        LOCAL_BOOL or LOCAL_BOOL_ARRAY
 *
 * WHEN IT IS WRITTEN
 *   - with -dbg: the variables and the bool fields - but NOT WITH -O. The
 *     optimizer packs slots and removes variables (optimizer/passes/registers/
 *     slot_packing.sharp), so after it a slot number says nothing about the
 *     variable that was written: no table is better than a wrong one. The
 *     section then holds 37 alone, so that sdb can say why it shows no variables.
 *   - when names were replaced: 38, with or without -dbg. sdb does not open
 *     such a program without its name map (`<output>.names`): every name it
 *     would show and take is one nobody wrote.
 *
 * WHERE IT STANDS: after the extern section, where the loader of an older VM
 * has stopped reading (as the extern section did when it was new) - and an
 * executable built without -dbg and without -obf is byte for byte what it was.
 * The VM's side: lib/runtime/exe/exe_processor.cpp, process_debugger_data.
 *
 * WITH -obf the names written are the new ones (obfuscation/obfuscation.sharp
 * renames the locals of a function it renames: `local_variable.carried_name`).
 */
const EXE_DEBUGGER          : _int64 = 0x3b;
const EXE_DEBUGGER_FUNCTION : _int64 = 0x3a;
const EXE_DEBUGGER_CLASS    : _int64 = 0x39;
const EXE_DEBUGGER_RENAMED  : _int64 = 0x38;
const EXE_DEBUGGER_OPTIMIZED : _int64 = 0x37;

const LOCAL_OBJECT     : _int64 = 0;    // an object or an array (or null)
const LOCAL_DECIMAL    : _int64 = 1;
const LOCAL_BOOL       : _int64 = 2;
const LOCAL_INT8       : _int64 = 3;
const LOCAL_INT16      : _int64 = 4;
const LOCAL_INT32      : _int64 = 5;
const LOCAL_INT64      : _int64 = 6;
const LOCAL_UINT8      : _int64 = 7;
const LOCAL_UINT16     : _int64 = 8;
const LOCAL_UINT32     : _int64 = 9;
const LOCAL_UINT64     : _int64 = 10;
const LOCAL_BOOL_ARRAY : _int64 = 11;   // an array of bools
const LOCAL_TEXT       : _int64 = 12;   // a `string` (or null): an object like any other, but one sdb can make a new one of
const LOCAL_IN_THE_FIBER : _int64 = 0 - 2;  // a variable's `field` when it is `localized`
const LOCAL_OF_LOOP_HEAD : _int64 = 0x100;  // added to the kind of a `for` / `foreach` head's variable

/** one variable as the section carries it (the fields are described at the top of this file) */
class local_entry {
    name : string;
    kind : _int64 = LOCAL_OBJECT;
    first_line : _int64 = 0;
    last_line : _int64 = 0;
    slot : _int64 = 0 - 1;
    steps : number_list;
    field : _int64 = 0 - 1;

    local_entry(name: string) {
        self->name = name;
        steps = new number_list();
    }
}

def write_debugger_section(out: byte_buffer, layout: program_layout, options: executable_options) {
    if(options.debug == 0 && options.obfuscated == 0) { return; }
    out.byte(EXE_DEBUGGER);
    if(options.obfuscated != 0) { out.byte(EXE_DEBUGGER_RENAMED); }
    if(options.debug != 0 && options.optimized != 0) { out.byte(EXE_DEBUGGER_OPTIMIZED); }
    if(options.debug == 0 || options.optimized != 0) {
        out.byte(0x0a);
        out.byte(EXE_END);
        return;
    }
    for(i : _int64 = 0; i < layout.functions.size(); i++) {
        made := layout.functions.at(i);
        if(made.made_from != MADE_FROM_BODY) { continue; }
        entries := entries_of(made);
        if(entries.size() == 0) { continue; }

        out.byte(EXE_DEBUGGER_FUNCTION);
        out.int32(made.address);
        out.int32(entries.size());
        for(j : _int64 = 0; j < entries.size(); j++) {
            entry := entries.at(j);
            out.text(entry.name);
            out.int32(entry.kind);
            out.int32(entry.first_line);
            out.int32(entry.last_line);
            out.int32(entry.slot);
            out.int32(entry.steps.count);
            for(k : _int64 = 0; k < entry.steps.count; k++) { out.int32(entry.steps.at(k)); }
            out.int32(entry.field);
        }
    }
    for(i : _int64 = 0; i < layout.classes.size(); i++) {
        write_bool_fields(out, layout.classes.at(i));
    }
    out.byte(0x0a);
    out.byte(EXE_END);
}

/** the variables of one function, in the order the section lists them */
def entries_of(made: function_layout) : list<local_entry> {
    entries := new list<local_entry>();
    has_self : _int64 = 1 - made.is_static;

    add_outer_entries(made, has_self, entries);
    if(has_self == 1) {
        own_self := new local_entry("self");
        own_self.slot = 0;
        entries.add(own_self);
    }
    if(made.of.locals == null) { return entries; }
    locals : list<local_variable> = made.of.locals!!;
    for(i : _int64 = 0; i < locals.size(); i++) {
        variable := locals.at(i);
        if(variable.is_hidden == 1) { continue; }
        entry := entry_for(variable);
        if(variable.storage == null) {
            entry.slot = variable.slot;
        } else if(variable.is_captured == 1 && made.own_record_slot >= 0) {
            // a lambda uses it: it is in this function's own closure record
            entry.slot = made.own_record_slot;
            entry.field = variable.storage!!.address;
        } else if(variable.is_localized == 1) {
            // one per fiber: at the bottom of each fiber's stack
            entry.slot = variable.storage!!.address;
            entry.field = LOCAL_IN_THE_FIBER;
        }
        entries.add(entry);
    }
    return entries;
}

/**
 * What a lambda can name beyond its own variables: the captured variables of
 * the functions around it. They are in the record it was handed, and in the
 * records reached from there by `@parent`, one more step for each function
 * further out.
 */
def add_outer_entries(made: function_layout, has_self: _int64, entries: list<local_entry>) {
    if(made.record_parameter_slot < 0) { return; }
    record : closure_record? = handed_record(made.of);
    steps := new number_list();
    self_found : _int64 = has_self;

    for(depth : _int64 = 0; record != null && depth < 1000; depth++) {
        current := record!!;
        if(self_found == 0 && current.captures_self == 1 && current.self_field != null) {
            outer_self := new local_entry("self");
            outer_self.slot = made.record_parameter_slot;
            copy_steps(steps, outer_self.steps);
            outer_self.field = current.self_field!!.address;
            entries.add(outer_self);
            self_found = 1;
        }
        for(i : _int64 = 0; i < current.variables.size(); i++) {
            variable := current.variables.at(i);
            if(variable.is_hidden == 1 || variable.storage == null) { continue; }
            entry := entry_for(variable);
            entry.slot = made.record_parameter_slot;
            copy_steps(steps, entry.steps);
            entry.field = variable.storage!!.address;
            entries.add(entry);
        }
        if(current.parent == null || current.parent_field == null) { return; }
        steps.add(current.parent_field!!.address);
        record = current.parent;
    }
}

def copy_steps(from: number_list, to: number_list) {
    for(i : _int64 = 0; i < from.count; i++) { to.add(from.at(i)); }
}

/** a variable's entry, without its home */
def entry_for(variable: local_variable) : local_entry {
    name : string = variable.name;
    if(variable.carried_name != null) { name = variable.carried_name!!; }
    entry := new local_entry(name);
    entry.kind = local_kind_of(variable.type);
    scope : _int64 = scope_node_of(variable);
    if(scope >= 0) {
        scope_kind : _int64 = variable.unit.parsed!!.tree.kinds!![scope];
        if(scope_kind == N_FOR || scope_kind == N_FOREACH) { entry.kind = entry.kind | LOCAL_OF_LOOP_HEAD; }
    }
    entry.first_line = first_line_of(variable);
    entry.last_line = last_line_of(variable);
    return entry;
}

/** the `bool` fields of one class, when it has any */
def write_bool_fields(out: byte_buffer, made: class_layout) {
    places := new number_list();
    kinds := new number_list();
    for(i : _int64 = 0; i < made.instance_fields.size(); i++) {
        kind : _int64 = bool_kind_of(made.instance_fields.at(i));
        if(kind != LOCAL_OBJECT) { places.add(i); kinds.add(kind); }
    }
    for(i : _int64 = 0; i < made.static_fields.size(); i++) {
        kind : _int64 = bool_kind_of(made.static_fields.at(i));
        if(kind != LOCAL_OBJECT) { places.add(made.instance_fields.size() + i); kinds.add(kind); }
    }
    if(places.count == 0) { return; }

    out.byte(EXE_DEBUGGER_CLASS);
    out.int32(made.address);
    out.int32(places.count);
    for(i : _int64 = 0; i < places.count; i++) {
        out.int32(places.at(i));
        out.int32(kinds.at(i));
    }
}

/** LOCAL_BOOL or LOCAL_BOOL_ARRAY for a field that is one; LOCAL_OBJECT for every other declaration */
def bool_kind_of(declared: sharp_declaration) : _int64 {
    if(declared.kind != D_FIELD) { return LOCAL_OBJECT; }
    type : resolved_type? = (declared as sharp_field).value_type;
    if(type == null) { return LOCAL_OBJECT; }
    kind : _int64 = local_kind_of(type!!);
    if(kind == LOCAL_BOOL || kind == LOCAL_BOOL_ARRAY) { return kind; }
    return LOCAL_OBJECT;
}

/** what a slot of this type holds: LOCAL_OBJECT, or which number */
def local_kind_of(type: resolved_type) : _int64 {
    if(type.is_array == 1) {
        if(type.kind == RT_INTEGER && type.is_bool_type == 1) { return LOCAL_BOOL_ARRAY; }
        return LOCAL_OBJECT;
    }
    if(type.kind == RT_DECIMAL) { return LOCAL_DECIMAL; }
    if(type.kind == RT_CLASS && type.class_of != null
       && type.class_of!!.name == "string" && type.class_of!!.owner == null && type.class_of!!.module.name == "std") {
        return LOCAL_TEXT;
    }
    if(type.kind != RT_INTEGER) { return LOCAL_OBJECT; }
    if(type.is_bool_type == 1) { return LOCAL_BOOL; }
    if(type.is_signed == 1) {
        if(type.bits == 8) { return LOCAL_INT8; }
        if(type.bits == 16) { return LOCAL_INT16; }
        if(type.bits == 32) { return LOCAL_INT32; }
        return LOCAL_INT64;
    }
    if(type.bits == 8) { return LOCAL_UINT8; }
    if(type.bits == 16) { return LOCAL_UINT16; }
    if(type.bits == 32) { return LOCAL_UINT32; }
    return LOCAL_UINT64;
}

/**
 * The node whose text a variable can be named in: the nearest block, `for`,
 * `foreach` or `catch` around its declaration. -1 when that is the whole
 * function: a parameter, or a variable of the function's outermost block.
 */
def scope_node_of(variable: local_variable) : _int64 {
    if(variable.is_parameter == 1 || variable.unit.parsed == null) { return 0 - 1; }
    tree := variable.unit.parsed!!.tree;
    if(variable.node < 0 || variable.node >= tree.count) { return 0 - 1; }

    node : _int64 = tree.parents!![variable.node];
    while(node >= 0) {
        kind : _int64 = tree.kinds!![node];
        if(kind == N_FOR || kind == N_FOREACH || kind == N_CATCH) { return node; }
        if(kind == N_BLOCK) {
            around : _int64 = tree.parents!![node];
            if(around < 0) { return 0 - 1; }
            holder : _int64 = tree.kinds!![around];
            if(holder == N_FUNCTION || holder == N_CONSTRUCTOR || holder == N_INIT || holder == N_LAMBDA) { return 0 - 1; }
            return node;
        }
        node = tree.parents!![node];
    }
    return 0 - 1;
}

/** the line a variable is declared on; 0 for a parameter: it is there from the function's start */
def first_line_of(variable: local_variable) : _int64 {
    if(variable.is_parameter == 1 || variable.unit.parsed == null) { return 0; }
    p := variable.unit.parsed!!;
    if(variable.node < 0 || variable.node >= p.tree.count) { return 0; }
    return line_of(p.table, p.start_of(p.tree.tokens!![variable.node]));
}

/** the last line a variable can be named on; 0 when that is the function's end */
def last_line_of(variable: local_variable) : _int64 {
    scope : _int64 = scope_node_of(variable);
    if(scope < 0) { return 0; }
    p := variable.unit.parsed!!;
    return line_of(p.table, p.start_of(last_token_in(p.tree, scope)));
}
