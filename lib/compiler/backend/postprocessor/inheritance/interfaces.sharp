mod backend.postprocessor.inheritance;

import (
    std.io,
    frontend.lexer,
    frontend.diagnostics,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system
)

/**
 * INTERFACES
 * (the C++ compiler: postprocessor/interface_processor.cpp)
 *
 *      class circle base shape : printable, comparable<circle> { }
 *
 * Each name after the `:` is checked and the class is given its interfaces
 * as objects:
 *
 *      sharp_class.interfaces              [ printable, comparable ]
 *      sharp_class.interface_bindings      what each one's type parameters stand for
 *                                          (comparable's T is circle)
 *
 *      E0324   it is not an interface      class circle : shape
 *      E0325   the same interface twice    class circle : printable, printable
 *
 * A generic interface may be listed several times with DIFFERENT type
 * arguments - `class both : comparable<int>, comparable<string>` are two
 * interfaces, each asking for its own `compare`. Only the same interface with
 * the same arguments is "twice". (For a generic class, `: comparable<A>,
 * comparable<B>` can still turn out to be the same interface in one instance;
 * class_bases.sharp reports that when the instance is made.)
 *
 * (Whether the class DEFINES what its interfaces ask for: overrides.sharp.)
 */
def link_interfaces(prog: sharp_program, problems: list<diagnostic>) {
    for(i : _int64 = 0; i < prog.all_classes.size(); i++) {
        declared := prog.all_classes.at(i);
        for(j : _int64 = 0; j < declared.interface_types.size(); j++) {
            add_interface(declared, declared.interface_types.at(j), problems);
        }
    }
}

/**
 * May the class wrongly listed after `:` be taken as the base class that
 * was meant? Only for a class that writes no `base` of its own, when the
 * named type is a plain class (not an array, not an interface or enum), and
 * when taking it makes no circle (`class a : b` and `class b : a`).
 */
def can_take_as_base(declared: sharp_class, named: sharp_declaration?, plain: _int64) : _int64 {
    if(named == null || named!!.kind != D_CLASS || declared.kind != D_CLASS || declared.base_type != null || plain == 0) { return 0; }
    up : sharp_class? = named as sharp_class;
    for(depth : _int64 = 0; up != null && depth < 256; depth++) {
        if(up == declared) { return 0; }
        up = up!!.base_class;
    }
    return 1;
}

/**
 * One name written after the `:` of `declared`: checked (E0324, E0325) and,
 * when it is an interface, added to the class with its type arguments.
 */
def add_interface(declared: sharp_class, written: sharp_type, problems: list<diagnostic>) {
    seen := look_through(written, null);
    if(seen.is_unknown()) {                 // the name was not found: reported already
        declared.members_uncertain = 1;
        return;
    }

    named := seen.type.declaration;
    if(names_type_parameter(written)) {
        // class tagged<T> : T - which interface that is, is known per instance (class_bases.sharp)
        declared.inherits_from_parameter = 1;
        return;
    }
    if(seen.type.form != TYPE_NAMED || seen.is_array == 1 || named!!.kind != D_INTERFACE) {
        d := error_at_node("E0324", "`" + written.to_text() + "` is not an interface", written.unit, written.node)
            .with_label("only interfaces can be listed after the `:`");

        if(named != null && named!!.kind == D_CLASS) {
            d.with_related_place(place_of_node(named!!.unit, named!!.node, "`" + named!!.name + "` is declared as a class here"));
            if(declared.base_type == null) {
                d.with_help("to inherit from the class `" + named!!.name + "`, write  class " + declared.name
                            + " base " + written.to_text() + " { ... }");
            } else {
                d.with_note("`" + declared.name + "` already has the base class `" + declared.base_type!!.to_text()
                            + "`, and a class has one base class only");
            }
        } else if(seen.type.form == TYPE_NATIVE || seen.is_array == 1) {
            // `alias _int64 as num;  class c : num { }`: a number (or an array) where an interface belongs
            what := "the number type `" + seen.type.to_text() + "`";
            if(seen.type.form != TYPE_NATIVE) { what = "an array type"; }
            if(seen.is_array == 1) { what = "an array type"; }
            if(!(written.to_text() == seen.type.to_text()) && seen.is_array == 0) { what = "an alias of " + what; }
            d.with_note("`" + written.to_text() + "` is " + what + ": a class can only inherit from a class and list interfaces; a value of it is kept in a field");
            d.with_help("to keep one in the class, give it a field:  class " + declared.name + " { value : " + written.to_text() + "; }");
        } else if(named != null && named!!.kind == D_ENUM) {
            d.with_related_place(place_of_node(named!!.unit, named!!.node, "`" + named!!.name + "` is declared as an enum here"));
            d.with_note("an enum is a fixed list of values; nothing can inherit from it or implement it");
            d.with_help("to keep one of its values in the class, give it a field:  class " + declared.name + " { value : " + written.to_text() + "; }");
        }
        problems.add(d);
        if(can_take_as_base(declared, named, seen.type.form == TYPE_NAMED && seen.is_array == 0)) {
            // `class job_failed : exception`: C# and Kotlin write the base class
            // after the `:`. The meaning is plain, so the rest of the program
            // is checked AS IF `base exception` were written: its constructor
            // `-> base(message)`, `throw` and `catch` of it then say nothing
            // more. (Error recovery by repair: one mistake, one message.)
            declared.base_type = written;
            declared.base_assumed = 1;
            set_named_base(declared, problems);
            d.with_note("the rest of the program is checked as if `base " + written.to_text() + "` were written");
            return;
        }
        declared.members_uncertain = 1;
        return;
    }

    found : sharp_class = named as sharp_class;
    for(i : _int64 = 0; i < declared.interfaces.size(); i++) {
        if(declared.interfaces.at(i) == found
           && same_type_arguments(declared.interface_bindings.at(i).arguments, seen.type.arguments)) {
            problems.add(error_at_node("E0325", "`" + declared.name + "` lists the interface `" + found.name + "` twice",
                                       written.unit, written.node)
                .with_label("listed already")
                .with_help("remove one of them"));
            return;
        }
    }

    declared.interfaces.add(found);
    declared.interface_bindings.add(new type_bindings(found.type_parameters, seen.type.arguments));
}

/** are two lists of written type arguments the same types, one by one? (two empty lists are) */
def same_type_arguments(first: list<sharp_type>, second: list<sharp_type>) : _int64 {
    if(first.size() != second.size()) { return 0; }
    for(i : _int64 = 0; i < first.size(); i++) {
        if(!same_type(first.at(i), second.at(i), null, 0)) { return 0; }
    }
    return 1;
}
