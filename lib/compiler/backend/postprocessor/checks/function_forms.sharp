mod backend.postprocessor.checks;

import (
    std.io,
    frontend.lexer,
    frontend.diagnostics,
    backend.postprocessor.inheritance,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system
)

/**
 * FUNCTIONS THAT ARE DECLARED IN A FORM THAT MEANS NOTHING
 *
 *      native def clock() : _int64 { return 0; }       E0365   native, and a body
 *      def operator+(other: money) : money { ... }     E0366   an operator outside any class
 *
 * NATIVE. `native` says "the runtime has this function"; the declaration is
 * only its name and types, for the compiler to check calls against. A body
 * would never run. (The C++ compiler stops with an internal error, "could
 * not resolve function", when it meets one.)
 *
 * OPERATORS. `a + b` calls `a.operator+(b)`: the object on the left is
 * `self`. An operator function therefore has to be a member of a class -
 * written in it, or added to it with `mutate money { def operator+(...) }`.
 * Declared at the top of a file with no class in front of the name it has no
 * `self` and no operator would ever find it. (The C++ compiler stops with
 * "unknown ast type" there.)
 *
 * How many parameters an operator function can have: operator_functions.sharp.
 */
def check_function_forms(prog: sharp_program, problems: list<diagnostic>) {
    for(i : _int64 = 0; i < prog.module_list.size(); i++) {
        module := prog.module_list.at(i);
        for(j : _int64 = 0; j < module.functions.size(); j++) {
            function := module.functions.at(j);
            report_native_with_body(function, problems);
            if(function.is_operator == 1 && function.owner == null && function.extends == null) {
                report_operator_outside_class(function, problems);
            }
        }
    }

    for(i : _int64 = 0; i < prog.all_classes.size(); i++) {
        declared := prog.all_classes.at(i);
        for(j : _int64 = 0; j < declared.functions.size(); j++) {
            // (an extension function is in its module's list too, and was looked at there)
            if(declared.functions.at(j).extension_of == null) { report_native_with_body(declared.functions.at(j), problems); }
        }
    }
}

/** E0365 */
def report_native_with_body(function: sharp_function, problems: list<diagnostic>) {
    // `...` among the parameters is C's: only a function of an extern block has it
    if(function.variadic_from >= 0 && sizeof(function.extern_library.data) == 0) {
        problems.add(error_at_node("E0365", "`...` among the parameters of `" + function.name + "`, which is not a C function", function.unit, function.node)
            .with_label("only a function of an `extern` block can have `...`")
            .with_note("`...` says where the variable arguments of a C function begin: `def printf(format: string, ..., count: c_int) : c_int;`")
            .with_help("a Sharp function that takes any number of values takes an array or a list"));
    }
    if(!function.has(FLAG_NATIVE) || !function.has_body()) { return; }

    start : _int64 = function.body;
    if(start < 0) { start = function.expression; }
    problems.add(error_at_node("E0365", "the native function `" + function.name + "` cannot have a body", function.unit, start)
        .with_label("this code would never run")
        .with_related_place(place_of_node(function.unit, function.node, "declared `native` here"))
        .with_note("`native` means the runtime provides the function; the declaration only tells the compiler its name, parameters and result")
        .with_help("end the declaration with `;` instead of a body:  native def " + function_text(function, null) + ";")
        .with_help("or remove `native` if the function is meant to be written in Sharp"));
}

/** E0366 */
def report_operator_outside_class(function: sharp_function, problems: list<diagnostic>) {
    first : sharp_type? = null;
    if(function.parameters.size() > 0 && function.parameters.at(0).type != null) {
        first = function.parameters.at(0).type;
    }

    d := error_at_node("E0366", "`" + function.name + "` is declared outside any class", function.unit, function.node)
        .with_label("an operator function must belong to a class")
        .with_note("`a " + operator_symbol(function.name) + " b` calls `a." + function.name + "(b)`: the value on the left is `self`, and what is on the right is the parameter. A function at the top of a file has no `self`");

    // The fix is offered in the two forms the whole toolchain builds: inside
    // the class, or added to it with `mutate` (an extension function,
    // `def money.operator+`, is accepted by this compiler but not by the C++
    // one, so it is not offered). A plain number has its operators built in
    // and cannot be given more: no `def _int64.operator+` either.
    if(first == null || first!!.form != TYPE_NAMED || first!!.is_array == 1) {
        d.with_help("an operator is declared inside the class of the value on its left, with the value on the right as its one parameter:  class money { def " + function.name + "(other: money) : money { ... } }");
        if(first != null) {
            d.with_note("a `" + first!!.to_text() + "` is not a class: its operators are built in and cannot be added to");
        }
    } else {
        type_text : string = first!!.to_text();
        d.with_help("move it into `" + type_text + "`, without the left operand (that is `self`):  def " + function.name + "(other: " + type_text + ") : " + type_text + " { ... }");
        d.with_help("or add it to `" + type_text + "` from here:  mutate " + type_text + " { def " + function.name + "(other: " + type_text + ") : " + type_text + " { ... } }");
    }
    problems.add(d);
}
