mod backend.compiler.program;

import (
    std.io,
    frontend.diagnostics,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system,
    backend.compiler.context
)

/**
 * THE ENTRY POINT: which `main` the program starts at
 *
 * A program starts at a GLOBAL function called `main` (declared in a module,
 * not in a class) that has one of four forms:
 *
 *      def main(args: string[]) : int          the arguments; the result is the exit code
 *      def main(args: string[])
 *      def main()
 *      def main() : int
 *
 * The VM calls it through `platform.kernel#platform`, which holds one function
 * value per form (`main`, `main2`, `main3`, `main4`); the code generator
 * fills in the one that matches (`analysed_program.main_form`).
 *
 *      E0930   a second entry point: two global functions of these forms
 *      W1015   a global `main` that is not one of the forms: it will not be run
 *
 * A function called `main` inside a class is an ordinary function. No `main`
 * at all is not an analysis error (D18): the standard library on its own has
 * none. Building an executable without one is for code generation to refuse
 * (the C++ compiler says "could not locate main method").
 *
 * DIFFERS FROM THE C++ COMPILER (D81). It warns "main method might not be
 * executed" only when the parameters fit and the result does not
 * (`def main() : _int64`); a `main(n: int)` is silently not the entry point.
 * The bootstrap gives W1015 for both.
 *
 * DIFFERS (D87). `def main() := start();` - a `main` whose result is worked
 * out from its expression - is an entry point here when that result is
 * nothing or an `int`. The C++ compiler looks at `main` before it has worked
 * the result out, warns "might not be executed" and then finds no `main`.
 *
 * The result may be written `int?` (the C++ compiler compares the class
 * only, and runs such a `main`); the parameter may be `string[]?`.
 *
 *      C++ comparison: `check_main_method_signature` in
 *      compiler/functions/function_compiler.cpp (`user_main_method`,
 *      `main_method_sig`).
 */
def find_main_function(session: analysis_session, analysed: analysed_program) {
    prog : sharp_program = session.prog;
    for(i : _int64 = 0; i < prog.module_list.size(); i++) {
        functions := prog.module_list.at(i).functions;
        for(j : _int64 = 0; j < functions.size(); j++) {
            function := functions.at(j);
            if(function.name != "main" || function.owner != null || function.extends != null) { continue; }
            // `def main() { }` written twice is "declared twice" (E0331): that is the one mistake
            if(function.declared_twice == 1) { continue; }
            consider_main(session, analysed, function);
        }
    }
    if(analysed.main_function != null) { prog.main_function = analysed.main_function; }
}

/** one global function called `main`: the entry point, a second one (E0930), or not one at all (W1015) */
def consider_main(session: analysis_session, analysed: analysed_program, function: sharp_function) {
    form : _int64 = main_form_of(session, function);
    context := declaration_context(session, function);
    if(context == null) { return; }
    if(form == MAIN_NONE) {
        report_main_not_run(context!!, function);
        return;
    }
    if(analysed.main_function == null) {
        analysed.main_function = function;
        analysed.main_form = form;
        return;
    }
    first : sharp_function = analysed.main_function!!;
    d := error_at_names("E0930", "the program has a second `main`: `" + main_text(function) + "`", function.unit, function.node);
    d.with_label("a second entry point");
    d.with_related_place(place_of_declaration(first, "the program already starts here: `" + main_text(first) + "`"));
    d.with_note("a program starts at ONE global function called `main`, whatever form it has");
    d.with_help("rename one of them (`def start(args: string[])`), or move it into a class, where `main` is an ordinary name");
    report(context!!, d);
}

/** W1015: a global `main` whose parameters or result are none of the four forms */
def report_main_not_run(context: analysis_context, function: sharp_function) {
    d := error_at_names("W1015", "`" + main_text(function) + "` will not be run: it is not a form the program can start at",
                        function.unit, function.node);
    d.with_label("not an entry point");
    d.with_note("a program starts at `def main()`, `def main() : int`, `def main(args: string[])` or `def main(args: string[]) : int`");
    if(function.parameters.size() == 1) {
        d.with_help("to receive the command line, write `def main(args: string[]) : int`");
    } else if(function.parameters.size() == 0) {
        d.with_help("to return an exit code, write `def main() : int` (the class `int`, not `_int32` or `_int64`)");
    } else {
        d.with_help("a program gets its arguments as one array: `def main(args: string[]) : int`; or give this function another name");
    }
    report(context, d);
}

/**
 * Which of the four forms a global `main` has (MAIN_ARGS_INT ...), or
 * MAIN_NONE. The parameter is any array of `string` (`string[]?` too: the
 * C++ compiler compares parameters without their `?`); the result is
 * nothing, or the class `int` (`int?` too: it compares the class alone).
 */
def main_form_of(session: analysis_session, function: sharp_function) : _int64 {
    if(function.is_generic()) { return MAIN_NONE; }
    takes_arguments : _int64 = 0;
    if(function.parameters.size() == 1) {
        if(!is_text_array(session, function.parameters.at(0).value_type)) { return MAIN_NONE; }
        takes_arguments = 1;
    } else if(function.parameters.size() != 0) {
        return MAIN_NONE;
    }

    result : resolved_type? = function.result_type;
    gives_nothing : _int64 = function.returns_nil == 1 || (result != null && result!!.is_nil()) || (result == null && function.return_type == null && function.expression < 0);
    if(gives_nothing == 1) {
        if(takes_arguments == 1) { return MAIN_ARGS; }
        return MAIN_NO_ARGS;
    }
    if(result == null || !is_int_object(session, result!!)) { return MAIN_NONE; }
    if(takes_arguments == 1) { return MAIN_ARGS_INT; }
    return MAIN_NO_ARGS_INT;
}

/** `string[]` (or `string[]?`) */
def is_text_array(session: analysis_session, type: resolved_type?) : _int64 {
    if(type == null) { return 0; }
    found : resolved_type = type!!;
    return found.kind == RT_CLASS && found.is_array == 1 && found.class_of == session.known.string_class;
}

/** the class `std#int` (or `int?`), not an array */
def is_int_object(session: analysis_session, type: resolved_type) : _int64 {
    return type.kind == RT_CLASS && type.is_array == 0 && type.class_of == session.known.int_class;
}

/** `main(args: string[]) : int` as written, for messages */
def main_text(function: sharp_function) : string {
    text := new string_builder("main(");
    for(i : _int64 = 0; i < function.parameters.size(); i++) {
        if(i > 0) { text.append(", "); }
        parameter := function.parameters.at(i);
        text.append(parameter.name);
        if(parameter.value_type != null) { text.append(": ").append(parameter.value_type!!.to_text()); }
    }
    text.append(")");
    if(function.result_type != null && !function.result_type!!.is_nil()) { text.append(" : ").append(function.result_type!!.to_text()); }
    return text.build();
}
