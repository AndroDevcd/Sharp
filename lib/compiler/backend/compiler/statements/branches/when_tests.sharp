mod backend.compiler.statements.branches;

import (
    std.io,
    frontend.lexer,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system,
    backend.types.typed_tree,
    backend.compiler.context,
    backend.compiler.conversions,
    backend.compiler.expressions.arithmetic
)

/**
 * ONE VALUE OF A `when` CLAUSE AS A TEST
 *
 *      when(code) { 404 -> ... }           the test is   code == 404
 *
 * With the subject (held in its hidden local) on the left, the value on the
 * right, the test is what `==` means for those two (doc/backend.md 7.8.1,
 * decided by the LEFT side - here the subject):
 *
 *      subject             value                       the test
 *      ------------------  --------------------------  ----------------------------------------
 *      a number            a number or number object   the numbers are compared
 *      an object           `null`                      "is there no object?"
 *      an object           anything its class has an   that `operator==` (a `string` subject
 *                          `operator==` for            compares the text)
 *      an object, `object` another object              "the same object?" (enum values: the same value)
 *      a function value    a function value, null      `function_value.same` / the null test
 *
 * Anything else cannot be compared (E0616). The result must be a condition:
 * a number, or the `bool` object an `operator==` usually gives back.
 *
 * W1020: the same constant (or enum value) twice in one `when` - the later
 * clause can never run for it, because the first clause that fits wins.
 *
 *      C++ comparison: when_statement.cpp hands each value to
 *      `compile_binary_expression` with the operator `==`; its messages are
 *      those of the binary operator ("must be of type class or numeric to
 *      use `==`").
 */

/** the test "subject == value", as a condition; an error node (reported) when they cannot be compared */
def compare_with_subject(context: analysis_context, subject: local_variable, value: bound_expression) : bound_expression {
    error_type : resolved_type = context.session.types.error_type;
    if(value.type.kind == RT_ERROR || subject.type.kind == RT_ERROR) { return new bound_error(context.unit, value.node, error_type); }

    node : _int64 = value.node;
    left := new bound_local(context.unit, node, subject);
    type : resolved_type = subject.type;
    compared : bound_expression? = null;

    if(type.is_number()) {
        if(as_plain_number(context, value, 0) != null) { compared = number_operation(context, node, P_EQEQ, left, value); }
    } else if(type.kind == RT_CLASS && type.is_array == 0) {
        if(value.type.kind == RT_NULL) { compared = null_test(context, node, P_EQEQ, left, value); }
        else {
            compared = call_operator(context, node, left, "operator==", one_argument(value));
            if(compared == null) { compared = same_object_test(context, node, P_EQEQ, left, value); }
        }
    } else if(type.kind == RT_FUNCTION && type.is_array == 0) {
        if(value.type.kind == RT_NULL) { compared = null_test(context, node, P_EQEQ, left, value); }
        else if(value.type.kind == RT_FUNCTION) { compared = function_value_test(context, node, P_EQEQ, left, value); }
        if(compared == null) { compared = same_object_test(context, node, P_EQEQ, left, value); }
    } else if(type.kind != RT_NULL) {
        compared = same_object_test(context, node, P_EQEQ, left, value);
    }

    if(compared == null) {
        report_not_comparable(context, subject, value, "");
        return new bound_error(context.unit, node, error_type);
    }
    if(compared!!.type.kind == RT_ERROR) { return compared!!; }

    condition := as_plain_number(context, compared!!, 1);
    if(condition == null) {
        report_not_comparable(context, subject, value, "`==` on `" + type.to_text() + "` gives " + described_type(compared!!.type)
                              + ", which is not a condition");
        return new bound_error(context.unit, node, error_type);
    }
    return condition!!;
}

/** E0616: the value and the subject cannot be compared with `==` */
def report_not_comparable(context: analysis_context, subject: local_variable, value: bound_expression, why: string) {
    type : resolved_type = subject.type;
    d := problem_over(context, "E0616", "this value cannot be compared with the subject of `when`, which is " + described_type(type), value.node);
    d.with_label(described_value(value));
    d.with_note("each value of a clause is tested as `subject == value`, by the rules of the operator `==`");
    if(sizeof(why.data) > 0) { d.with_note(why); }

    if(type.is_number()) {
        d.with_help("the subject is a number, so each value must be a number too");
    } else if(type.kind == RT_CLASS && type.is_array == 0 && sizeof(why.data) == 0) {
        d.with_help("give `" + type.to_text() + "` a way to compare itself with " + described_type(value.type) + ": `def operator==(other: "
                    + value.type.to_text() + ") : bool { ... }`");
    } else if(type.kind == RT_NULL) {
        d.with_help("`when(null)` has nothing to compare: put the value you meant to test between the parentheses");
    }
    report(context, d);
}

/**
 * W1020: `1 -> ...` after an earlier `1 -> ...` (or the same enum value, or
 * the same text). Only values the compiler knows are compared.
 */
def report_if_seen_before(context: analysis_context, value: bound_expression, seen: list<bound_expression>) {
    if(value.constant == null && value.kind != BX_ENUM_VALUE) { return; }
    for(i : _int64 = 0; i < seen.size(); i++) {
        earlier := seen.at(i);
        if(is_same_value(earlier, value)) {
            d := problem_over(context, "W1020", "`" + source_text_of(context, value.node) + "` is already a value of an earlier clause", value.node);
            d.with_label("this clause never runs for it");
            d.with_related_place(place_of_node(context.unit, earlier.node, "first given here"));
            d.with_note("the clauses of a `when` are tried in order and the first that fits runs; a later one never sees this value");
            d.with_help("remove it from this clause");
            report(context, d);
            return;
        }
    }
    seen.add(value);
}

/** are the two values the same constant, or the same enum value? */
def is_same_value(a: bound_expression, b: bound_expression) : _int64 {
    if(a.kind == BX_ENUM_VALUE || b.kind == BX_ENUM_VALUE) {
        if(a.kind != BX_ENUM_VALUE || b.kind != BX_ENUM_VALUE) { return 0; }
        if((a as bound_enum_value).value == (b as bound_enum_value).value) { return 1; }
        return 0;
    }
    if(a.constant == null || b.constant == null) { return 0; }
    first : constant_value = a.constant!!;
    second : constant_value = b.constant!!;
    if(first.kind != second.kind) { return 0; }
    if(first.kind == CONST_TEXT) {
        if(first.text == null || second.text == null) { return 0; }
        if(first.text!! == second.text!!) { return 1; }
        return 0;
    }
    if(first.kind == CONST_DECIMAL) { return first.number == second.number; }
    return first.integer == second.integer;
}
