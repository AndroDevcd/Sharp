mod backend.optimizer.analysis;

import (
    std.io,
    backend.finalizer.ir
)

/**
 * WHAT IS KNOWN ABOUT THE LABELS OF A FUNCTION
 *
 * Two facts the passes that move and remove code need:
 *
 *  - which labels are the ranges of a `try` (its start, the end of its block,
 *    its end, a handler, its finally): PROTECTED labels. The bytecode step
 *    reads the try record off their pcs (codegen.md 3.8), so they must stay
 *    where they are, and the instruction just before an END label must stay
 *    too: it is the jump (or the `throw`) that closes the range, and the VM's
 *    rule R1 (4.7) needs a range to end in it, never in a call;
 *  - how many jumps go to each label: a label nobody jumps to and no `try`
 *    names can go, and the two blocks it separated become one.
 *
 *      C++ comparison: the C++ optimizer keeps the try table's pcs in a list
 *      of its own and moves them with the code (`for_each_try_pc`).
 */
class label_facts {
    names_try : number_list;        // per label: 1 when a `try` names it
    closes_range : number_list;     // per label: 1 when it is one past a range of a `try` (block end, end, finally end)
    jumps_to : number_list;         // per label: how many jumps go to it

    label_facts() {
        names_try = new number_list();
        closes_range = new number_list();
        jumps_to = new number_list();
    }

    /** may the label be removed when no jump goes to it? */
    def is_protected(label: _int64) : _int64 {
        return names_try.at(label) == 1;
    }
}

/** the facts of every label of a function, as its IR is now */
def label_facts_of(code: ir_function) : label_facts {
    facts := new label_facts();
    for(i : _int64 = 0; i < code.label_count; i++) {
        facts.names_try.add(0);
        facts.closes_range.add(0);
        facts.jumps_to.add(0);
    }
    tries_count : _int64 = code.tries.size().value as _int64;
    for(t : _int64 = 0; t < tries_count; t++) {
        region := code.tries.at(t);
        facts.names_try.replace(region.start, 1);
        facts.names_try.replace(region.block_end, 1);
        facts.names_try.replace(region.end, 1);
        facts.closes_range.replace(region.block_end, 1);
        facts.closes_range.replace(region.end, 1);
        for(h : _int64 = 0; h < region.handlers.count; h++) { facts.names_try.replace(region.handlers.at(h), 1); }
        if(region.has_finally == 1) {
            facts.names_try.replace(region.finally_start, 1);
            facts.names_try.replace(region.finally_end, 1);
            facts.closes_range.replace(region.finally_end, 1);
        }
    }
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = 0; i < total; i++) {
        made := code.instructions.at(i);
        if(is_jump(made)) { facts.jumps_to.replace(made.number, facts.jumps_to.at(made.number) + 1); }
    }
    return facts;
}

/**
 * Does the instruction at `index` close the range of a `try`: is the next
 * instruction that makes code (labels and `line` marks make none) preceded
 * by a label that ends a range? Such an instruction is never removed (R1).
 */
def closes_a_range(code: ir_function, facts: label_facts, index: _int64) : _int64 {
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = index + 1; i < total; i++) {
        made := code.instructions.at(i);
        if(made.kind == IR_LABEL) {
            if(facts.closes_range.at(made.number) == 1) { return 1; }
        } else if(made.kind != IR_LINE) {
            return 0;
        }
    }
    return 0;
}

/**
 * The first instruction at or after `index` that makes code: labels and
 * `line` marks are passed over. -1 when there is none (the end).
 */
def next_real_instruction(code: ir_function, index: _int64) : _int64 {
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = index; i < total; i++) {
        kind : _int64 = code.instructions.at(i).kind;
        if(kind != IR_LABEL && kind != IR_LINE) { return i; }
    }
    return 0 - 1;
}

/** the index of the instruction that places `label`, or -1 */
def place_of_label(code: ir_function, label: _int64) : _int64 {
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = 0; i < total; i++) {
        made := code.instructions.at(i);
        if(made.kind == IR_LABEL && made.number == label) { return i; }
    }
    return 0 - 1;
}

/** the index of every label's place, one pass (-1 for a label that is not placed) */
def places_of_labels(code: ir_function) : number_list {
    places := new number_list();
    for(i : _int64 = 0; i < code.label_count; i++) { places.add(0 - 1); }
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = 0; i < total; i++) {
        made := code.instructions.at(i);
        if(made.kind == IR_LABEL) { places.replace(made.number, i); }
    }
    return places;
}
