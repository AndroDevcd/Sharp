mod backend.optimizer;

import (
    std.io
)

/**
 * WHAT THE COMMAND LINE ASKS OF THE OPTIMIZER
 *
 * As in the C++ compiler (lib/grammar/main.cpp): one switch.
 *
 *      -O  -O1  -O2  -O3       every optimization on (the levels are accepted and all mean the same)
 *      -O0                     off again (the default)
 *      -n<name>                with -O: leave one optimization out, e.g. -nloop-rotation
 *      -Oreport                print what the optimizer did
 *      -Otrace <function>      print the IR of that function (its full name, as -ir prints it) after
 *                              every pass that changed it: for finding which pass made code wrong
 *
 * `-n<name>` takes the C++ compiler's names, so a command line written for
 * one compiler works with the other. Some of those passes are not in this
 * optimizer (doc/codegen.md 13.6 says which and why); their names are
 * accepted and leave nothing out. This optimizer has passes the C++ one
 * does not, with names of their own.
 *
 *      C++ comparison: `optimization_names`, `pass_enabled` in
 *      backend/optimizer/bytecode_optimizer.cpp.
 */
class optimizer_settings {
    on : _int64 = 0;                    // -O
    report : _int64 = 0;                // -Oreport
    left_out : list<string>;            // the names given with -n<name>
    trace : string = "";                // -Otrace: the full name of the function to show after each pass

    optimizer_settings() {
        left_out = new list<string>();
    }

    /** is the optimization with this name (one of `optimization_names`) to run? */
    def runs(name: string) : _int64 {
        if(on == 0) { return 0; }
        for(i : _int64 = 0; i < left_out.size(); i++) {
            if(left_out.at(i) == name) { return 0; }
        }
        return 1;
    }
}

/**
 * Every name -n<name> accepts: first the C++ optimizer's, in its order, then
 * the four of this one. `is_done_here` says which of them this optimizer
 * has.
 */
def optimization_names() : list<string> {
    names := new list<string>();
    names.add("stack-forwarding");
    names.add("copy-propagation");
    names.add("object-copies");
    names.add("constant-propagation");
    names.add("dead-stores");
    names.add("dead-code");
    names.add("jump-cleanup");
    names.add("unreachable-code");
    names.add("inline-calls");
    names.add("box-elimination");
    names.add("native-returns");
    names.add("loop-formula");
    names.add("loop-unrolling");
    names.add("loop-rotation");
    names.add("loop-registers");
    names.add("copy-coalescing");
    names.add("immediates");
    names.add("register-hand-off");
    names.add("slot-packing");
    names.add("pure-functions");
    names.add("devirtualization");
    names.add("common-subexpressions");
    names.add("null-checks");
    names.add("loop-invariants");
    names.add("bounds-checks");
    names.add("closure-elimination");
    names.add("escape-analysis");
    names.add("string-concatenation");
    names.add("shared-literals");
    return names;
}

/** is `name` an optimization -n<name> can leave out? */
def is_optimization_name(name: string) : _int64 {
    names := optimization_names();
    for(i : _int64 = 0; i < names.size(); i++) {
        if(names.at(i) == name) { return 1; }
    }
    return 0;
}

/** does this optimizer have the optimization of that name (else the name is only accepted)? */
def is_done_here(name: string) : _int64 {
    return !(name == "stack-forwarding" || name == "loop-registers");
}

/** all the names, for a message: " a b c" */
def optimization_names_text() : string {
    names := optimization_names();
    text := new string_builder("");
    for(i : _int64 = 0; i < names.size(); i++) { text.append(" " + names.at(i)); }
    return text.build();
}
