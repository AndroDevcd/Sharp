mod backend.optimizer.passes.values;

import (
    std.io,
    backend.finalizer.ir,
    backend.optimizer.analysis
)

/**
 * COPY PROPAGATION: after `copy %a, %b`, a read of %a may read %b instead
 *
 *      copy %4, %1                     copy %4, %1                 (now dead: passes/removal takes it)
 *      int_binary add %5, %4, %3   ->  int_binary add %5, %1, %3
 *
 * The generator makes many such copies: the value of a local held over while
 * the rest of an expression runs (codegen.md 5.3, `held_over`), a value moved
 * into a local, a result moved into the slot it is returned from. Reading the
 * original instead leaves the copy with nobody to read it, and it goes.
 *
 * The textbook "available copies" problem (the dragon book, 9.1.8): a copy
 * `copy %a, %b` is available at a point when every path to it passes the copy
 * and then writes neither %a nor %b. A forward data-flow problem whose meet
 * is "the same copy on every path, or none":
 *
 *      for every slot a that some copy writes: copy_of[a] = b, or none
 *      writing slot x       -> copy_of[x] = none, and every copy_of[a] == x becomes none
 *      `copy %a, %b`        -> copy_of[a] = b   (or b's own original, when b is a copy itself)
 *
 * At the entry of the function and of every handler nothing is available (a
 * handler is entered from the middle of blocks). A copy that narrows a
 * number (`copy %a, %b as _int8`) does not make %a equal to %b: it is not
 * followed.
 *
 * The C++ optimizer has two passes for this, "copy propagation" (numbers in
 * registers) and "object copies" (references in slots); here one pass does
 * both, and the two names switch its two halves: `-ncopy-propagation` stops
 * it for numbers, `-nobject-copies` for references.
 *
 *      C++ comparison: passes/pass_copy_propagation.cpp, pass_object_copies.cpp.
 */

/** a copy that is no longer (or not yet) followed on any path: the table's "nothing seen yet" */
const COPY_NOT_SEEN : _int64 = 0 - 2;
/** no copy is available for the slot */
const COPY_NONE : _int64 = 0 - 1;

/** run the pass; the number of slot reads it changed */
def propagate_copies(analyses: function_analyses, numbers: _int64, references: _int64) : _int64 {
    code := analyses.code;
    slots : _int64 = code.slot_count();
    index := new _int64[slots + 1];
    followed_slots := new number_list();
    for(s : _int64 = 0; s <= slots; s++) { index[s] = 0 - 1; }
    total : _int64 = code.instructions.size().value as _int64;
    for(i : _int64 = 0; i < total; i++) {
        made := code.instructions.at(i);
        if(is_plain_copy(made) && index[made.target] < 0) {
            is_reference : _int64 = code.slot_kinds.at(made.target) == SLOT_REF;
            if((is_reference && references == 1) || (!is_reference && numbers == 1)) {
                index[made.target] = followed_slots.count;
                followed_slots.add(made.target);
            }
        }
    }
    followed : _int64 = followed_slots.count;
    if(followed == 0) { return 0; }
    graph := analyses.graph();
    blocks : _int64 = graph.block_count();
    if(blocks * followed > CONSTANT_TABLE_LIMIT) { return 0; }
    reached := reachable_blocks(graph);

    copy_out := new _int64[blocks * followed + 1];
    for(i : _int64 = 0; i < blocks * followed; i++) { copy_out[i] = COPY_NOT_SEEN; }
    state := new _int64[followed + 1];
    based_on := new _int64[slots + 1];      // per slot: how many followed copies have it as their original now

    // ---- the available copies at the start and the end of every block, until nothing changes
    changed : _int64 = 1;
    while(changed == 1) {
        changed = 0;
        for(b : _int64 = 0; b < blocks; b++) {
            if(reached[b] == 0) { continue; }
            forget_originals(state, followed, based_on);
            copies_at_block_start(graph, reached, copy_out, b, followed, state);
            count_originals(state, followed, based_on);
            for(i : _int64 = graph.starts[b]; i < graph.ends[b]; i++) {
                after_instruction(code.instructions.at(i), index, followed_slots, state, based_on);
            }
            offset : _int64 = b * followed;
            for(p : _int64 = 0; p < followed; p++) {
                if(copy_out[offset + p] != state[p]) { copy_out[offset + p] = state[p]; changed = 1; }
            }
        }
    }

    // ---- the rewrite: each read of a followed slot with a copy available reads the original
    changes : _int64 = 0;
    for(b : _int64 = 0; b < blocks; b++) {
        if(reached[b] == 0) { continue; }
        forget_originals(state, followed, based_on);
        copies_at_block_start(graph, reached, copy_out, b, followed, state);
        count_originals(state, followed, based_on);
        for(i : _int64 = graph.starts[b]; i < graph.ends[b]; i++) {
            made := code.instructions.at(i);
            k : _int64 = 0;
            read : _int64 = slot_read(made, 0);
            while(read >= 0) {
                if(index[read] >= 0 && state[index[read]] >= 0) {
                    replace_slot_read(made, k, state[index[read]]);
                    changes++;
                }
                k++;
                read = slot_read(made, k);
            }
            after_instruction(made, index, followed_slots, state, based_on);
        }
    }
    if(changes > 0) { analyses.changed_reads(); }
    return changes;
}

/** `copy %a, %b` that does not narrow, between two different slots */
def is_plain_copy(made: ir_instruction) : _int64 {
    return made.kind == IR_COPY && made.number == NARROW_NONE && made.target >= 0 && made.first >= 0
           && made.target != made.first;
}

/** the copies available entering block `b`: none at the entry and at a handler, else the meet of the predecessors */
def copies_at_block_start(graph: flow_graph, reached: _int64[], copy_out: _int64[], b: _int64, followed: _int64, state: _int64[]) {
    if(b == 0 || graph.is_handler[b] == 1) {
        for(p : _int64 = 0; p < followed; p++) { state[p] = COPY_NONE; }
        return;
    }
    for(p : _int64 = 0; p < followed; p++) { state[p] = COPY_NOT_SEEN; }
    for(i : _int64 = graph.first_predecessor[b]; i < graph.first_predecessor[b + 1]; i++) {
        from : _int64 = graph.predecessors[i];
        if(reached[from] == 0) { continue; }
        offset : _int64 = from * followed;
        for(p : _int64 = 0; p < followed; p++) {
            theirs : _int64 = copy_out[offset + p];
            if(theirs == COPY_NOT_SEEN) { continue; }
            if(state[p] == COPY_NOT_SEEN) { state[p] = theirs; }
            else if(state[p] != theirs) { state[p] = COPY_NONE; }
        }
    }
    // a path no block has been seen on yet still counts as "no copy" once the block is entered
}

/** `based_on` counted for a state: per slot, how many copies have it as their original */
def count_originals(state: _int64[], followed: _int64, based_on: _int64[]) {
    for(p : _int64 = 0; p < followed; p++) {
        if(state[p] >= 0) { based_on[state[p]] = based_on[state[p]] + 1; }
    }
}

/** `based_on` back to all 0, before another state is taken: only the slots the state counted are touched */
def forget_originals(state: _int64[], followed: _int64, based_on: _int64[]) {
    for(p : _int64 = 0; p < followed; p++) {
        if(state[p] >= 0) { based_on[state[p]] = 0; }
    }
}

/** followed copy `place` becomes `value` (an original, or COPY_NONE), and `based_on` follows */
def set_copy(state: _int64[], based_on: _int64[], place: _int64, value: _int64) {
    if(state[place] >= 0) { based_on[state[place]] = based_on[state[place]] - 1; }
    state[place] = value;
    if(value >= 0) { based_on[value] = based_on[value] + 1; }
}

/**
 * The available copies after one instruction (the rules in the header).
 * `based_on` says how many copies have a slot as their original, so the
 * search for the copies a write ends is made only when there are some.
 */
def after_instruction(made: ir_instruction, index: _int64[], followed_slots: number_list, state: _int64[], based_on: _int64[]) {
    written : _int64 = slot_written(made);
    if(written < 0) { return; }
    // the copies whose original is overwritten are no longer equal to it
    if(based_on[written] > 0) {
        for(p : _int64 = 0; p < followed_slots.count; p++) {
            if(state[p] == written) { set_copy(state, based_on, p, COPY_NONE); }
        }
    }
    place : _int64 = index[written];
    if(place < 0) { return; }
    if(is_plain_copy(made)) {
        original : _int64 = made.first;
        if(index[original] >= 0 && state[index[original]] >= 0) { original = state[index[original]]; }
        if(original == written) { set_copy(state, based_on, place, COPY_NONE); } else { set_copy(state, based_on, place, original); }
        return;
    }
    set_copy(state, based_on, place, COPY_NONE);
}
