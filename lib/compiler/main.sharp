mod main;

import (
    std.io,
    std.io.*,
    platform.kernel,
    configuration,
    cache,
    frontend.lexer,
    frontend.syntax.parser,
    frontend.syntax.printing,
    frontend.syntax.tree,
    frontend.diagnostics,
    backend.postprocessor.imports,
    backend.postprocessor.inheritance,
    backend.postprocessor.members,
    backend.postprocessor.names,
    backend.reports,
    backend.ide,
    backend.compiler.context,
    backend.compiler.driver,
    backend.compiler.flow,
    backend.compiler.initializers,
    backend.compiler.components,
    backend.compiler.obfuscation,
    backend.compiler.program,
    backend.preprocessor,
    std.io.coroutines,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system
)

/*
 * THE DRIVER: one run of the compiler, from the command line to the exit code.
 *
 *      main                    1. the command line is read into `options` (configuration/)
 *                              2. the files to compile are gathered: the ones named, a project's
 *                                 folder and its settings.json, the library folders
 *                              3. exec_runtime compiles them
 *      exec_runtime            every stage in order, timed: parse, the analysis stages, then code
 *                              generation (generate_executable) and, with -run, the program
 *
 * THE EXIT CODE of the compiler:
 *
 *      0       the program compiled: no errors (warnings do not count)
 *      1       the command line was refused, a file is missing, or the program has errors
 *              and nothing was written
 *      other   with -run: what the program itself ended with
 *
 * so a build script can write `sharpc main.sharp -o app && sharp app`.
 * (C++ comparison: lib/grammar/main.cpp ends with 1 for a refused option and
 * with 0 after every compile, with errors or without; ending with 1 for a
 * program with errors is deliberate here - doc/codegen.md, section 10.)
 *
 * The files of this folder (module `main`) - the driver, top down:
 *      main.sharp                  this front door: main, and the run of the stages
 *      source_folders.sharp        which files are compiled: the .sharp files below a folder
 *                                  (-L, -p), the library, the files left out (-ignore)
 *      left_out_modules.sharp      a module that is missing because -ignoredir left its files out
 *      parsing.sharp               every file parsed, several at a time
 *      broken_declarations.sharp   the body stages on a program whose declarations have errors
 *      executable.sharp            the options handed to the backend: the executable, the warnings
 *      project.sharp               --new-project, where the output goes, -run
 * and below it:
 *      configuration/              the options: the command line, settings.json (module `configuration`)
 *      cache/                      the build cache of a project
 *      frontend/, backend/         the compiler itself (doc/backend.md, doc/codegen.md)
 */
def main(args: string[]) : int {
    // (the code is handed to exit(): on a runtime built before 2026-11-15 what `main`
    //  returns did not become the exit code of the process - tests/suite/known_bugs)
    code := compile_from_command_line(args);
    if(code != 0) { exit(code); }
    return 0;
}

/** one run of the compiler; returns its exit code (the table above) */
def compile_from_command_line(args: string[]) : int {
    if(args == null) {
        help();
        return 1;
    }

    read_command_line(args);
    files := options.source_files;
    warn_about_options_that_do_nothing();

    if(options.new_project_dir != "") {
       create_project();
       // (only the project was asked for: done. With files or -p as well, the compile goes on)
       if(files.size() == 0 && options.compile_mode == compilation_mode.file_mode) { return 0; }
    }

    if(files.size() == 0 && options.compile_mode == compilation_mode.file_mode){
        help();
        return 1;
    }

    if(options.lexer_stats_only) {
        print_lexer_stats(files, 20);
        return 0;
    }

    if(options.parser_stats_only) {
        return print_parser_stats(files, 10) > 0 ? 1 : 0;
    }

    if(options.parser_tree_only) {
        foreach(name in files) {
            parsed := parse_source(name, file_utils.read_text(name).data!!);
            print_syntax_tree(parsed);
            print_diagnostics(parsed.errors);
        }
        return 0;
    }

    // which files are compiled (source_folders.sharp)
    if(options.compile_mode == compilation_mode.project_mode) {
        add_project_files(files);
        // settings.json: the options of the project, and the library version it is built with
        process_settings();
        // the project's tests folder: left out of the program, or (-tests) where the build starts
        apply_tests_folder();
    } else if(options.tests) {
        error_with_help("-tests builds the tests of a PROJECT: there is no project here",
                        "name the project (`-P <folder>`), or name the tests folder itself: `-testdir <folder>`");
    }
    // (-analysis and -ir show the last file of the program: noted before the library's files,
    //  which are added after it)
    if(files.size() > 0) { options.inspected_file = files.at(files.size() - 1); }
    add_library_files(options.library_version);
    check_source_files(files);
    // (the files are absolute now: so must the name of the inspected one be)
    if(sizeof(options.inspected_file.data) > 0) { options.inspected_file = new file(options.inspected_file).absolute_path(); }
    remove_ignored_files(files);
    if(!options.compile) { check_output_is_not_a_source(files, output_path()); }
    return exec_runtime(files);
}

/**
 * Options that the others make pointless are said once, not dropped in
 * silence: with -c nothing is written, so there is nothing to run (-run) and
 * no native interface files to write (-sni).
 */
def warn_about_options_that_do_nothing() {
    if(!options.compile) { return; }
    if(options.run_source) {
        warning("-run does nothing together with -c: no executable is written, so none is run");
    }
    if(options.sni_folder_given) {
        warning("-sni does nothing together with -c: no code is generated");
    }
}

/**
* We dont want to max out the CPU if green mode is set to true
* So we cut the maximum available threads in half. While this will consume less power,
* it will result in longer build times overall.
*/
def throttle_max_threads() {
    threads := vm.hardware_concurrency() * 2;
    threads -= 4;

    if(threads > 3)
       threads /= 2;
    dispatchers.set_parallelism(threads.value);
}

/** the clock, in milliseconds: for timing the stages */
def now_ms() : decimal {
    return vm.time_in_nanoseconds().value / 1000000;
}

/**
 * Compile the files: every stage in order. Returns the exit code of the
 * compiler - 0 when the program has no errors (and, with -run, the program
 * ended with 0), else 1 or what the program ended with.
 */
def exec_runtime(files: list<string>) : int {
    if(files.size() == 0) {
       error("no files were found to be compiled, have you excluded your project directory by chance?");
    }

    if(options.green_mode) {
        throttle_max_threads();
    }

    if(options.clean_build) {
       flush_cache();
    }

    stage_started : decimal = now_ms();
    open_cache();
    units := parse_all(files);
    update_cache(units);
    parse_ms : decimal = now_ms() - stage_started;

    // ---- report: every problem of every file, then one line for the whole build
    // (the syntax errors of all files are printed through the same -errlmt limit as the
    //  errors of the later stages; a file that could not be read at all is one line of its own)
    problems : decimal = 0;
    failed_files : decimal = 0;
    syntax_errors := new list<diagnostic>();
    foreach(unit in units) {
        if(!unit.is_good()) {
            failed_files++;
            if(unit.parsed == null) { problems += print_unit_errors(unit); }
            else { syntax_errors.add_all(unit.parsed!!.errors); }
        }
    }
    problems += print_within_limit(syntax_errors, options.max_errors as _int64);

    if(problems > 0) {
        println("" + (problems as _int64) + " error(s) in " + (failed_files as _int64) + " of "
                + units.size() + " file(s)");
        if(options.ide_folder != "") { write_syntax_errors_for_editor(options.ide_folder, units); }
        return 1;
    }

    // (`progress`: printed by the debug compiler only - configuration/build_kind.sharp)
    if(cache_enabled()) {
        progress("parsed " + units.size() + " file(s), no errors: "
                + (unchanged_files as _int64) + " unchanged since the last build, "
                + (changed_files as _int64) + " new or changed");
    } else {
        progress("parsed " + units.size() + " file(s), no errors");
    }

    // ---- mock<T>(): the classes it asked for are written out and join the program as units of
    //      their own (frontend/syntax/tree/mocks.sharp). One that cannot be written says why.
    mock_units := make_mock_units(units);
    mock_problems : decimal = 0;
    foreach(mock_unit in mock_units) {
        if(mock_unit.parsed == null) {
            mock_problems += print_unit_errors(mock_unit);
        } else if(!mock_unit.is_good()) {
            mock_problems += print_within_limit(mock_unit.parsed!!.errors, options.max_errors as _int64);
        }
        units.add(mock_unit);
    }
    if(mock_problems > 0) {
        println("" + (mock_problems as _int64) + " error(s)");
        return 1;
    }

    // ---- names: what every file declares, and what every type name means
    found := new list<diagnostic>();
    stage_started = now_ms();
    whole_program := pre_process(units, found);
    // (no standard library at all: said once, alone, before its missing names set off
    //  a message each - backend/compiler/program/required_declarations.sharp)
    in_project : _int64 = options.compile_mode == compilation_mode.project_mode ? 1 : 0;
    if(report_library_missing_first(whole_program, found, in_project) == 1) {
        print_within_limit(found, options.max_errors as _int64);
        println("" + (count_errors(found) as _int64) + " error(s)");
        return 1;
    }
    process_imports(whole_program, found);
    collect_ms : decimal = now_ms() - stage_started;

    stage_started = now_ms();
    resolve_type_names(whole_program, found);
    resolve_ms : decimal = now_ms() - stage_started;

    stage_started = now_ms();
    check_classes(whole_program, found);
    checks_ms : decimal = now_ms() - stage_started;

    // ---- generics and members: what every declared type is, what every class has.
    // ---- bodies: every function body and field value becomes a typed tree
    // (backend/compiler/driver).
    // When the declarations stages (1-4) reported errors, these stages still run - a
    // misspelt type in one body or a missing interface function in one class must not hide
    // every mistake in every other body - but only their messages about BODIES are kept
    // (`analyse_bodies_after_declaration_errors`): what they would say about declarations is the
    // same mistake again in other words. A broken name is the error type there, so it sets
    // off nothing. The later passes (flow, components, initializers, program checks) run there
    // too; only the completeness self-check waits for a program whose declarations are sound.
    stage_started = now_ms();
    bodies : analysis_session? = null;
    declaration_errors : decimal = count_errors(found);
    if(declaration_errors == 0) {
        resolve_members(whole_program, found);
    }
    members_ms : decimal = now_ms() - stage_started;

    stage_started = now_ms();
    whole_program.tests_folder = options.tests_dir;      // (which `main` the program starts at: main_function.sharp)
    if(count_errors(found) == 0) {
        bodies = analyse_bodies(whole_program, found);
    } else {
        analyse_bodies_after_declaration_errors(whole_program, found, declaration_errors == 0);
    }
    bodies_ms : decimal = now_ms() - stage_started;

    // ---- flow: can every statement be reached, does every path of a function
    // that returns a value return one (backend/compiler/flow) - a pass over
    // the typed statements the body stages built.
    stage_started = now_ms();
    if(bodies != null) {
        check_flow(bodies!!);
    }
    flow_ms : decimal = now_ms() - stage_started;

    // ---- unused generics: a generic class or function the program makes no instance of
    // has no body the stages above looked at. Each is analysed once as a stand-in whose
    // type arguments are unknown, and what is wrong in it is a warning (W1039): the
    // stand-ins are not part of the program (backend/compiler/driver/unused_blueprints.sharp).
    stage_started = now_ms();
    if(bodies != null) {
        stand_ins := analyse_unused_blueprints(bodies!!);
        check_flow_from(bodies!!, stand_ins.analysed_functions);
        forget_stand_ins(bodies!!, stand_ins);
    }
    blueprints_ms : decimal = now_ms() - stage_started;

    // ---- components: what only the whole program can say about the dependency-injection
    // system (backend/compiler/components) - a component or a definition declared twice,
    // definitions that need each other in a circle, the definition every `inject` field
    // receives - and the names listed in `obfuscate` blocks (backend/compiler/obfuscation).
    // Before the initializers: an injected field is set up like a field with a value.
    stage_started = now_ms();
    if(bodies != null) {
        check_components(bodies!!);
        check_obfuscate_blocks(bodies!!);
    }
    components_ms : decimal = now_ms() - stage_started;

    // ---- initializers: in what order objects, classes and the program are set up
    // (backend/compiler/initializers) - a pass over the finished field values and
    // constructors.
    stage_started = now_ms();
    if(bodies != null) { order_initializers(bodies!!); }
    initializers_ms : decimal = now_ms() - stage_started;

    // ---- completeness: the self-check that no expression was left without a type and
    // without a message (backend/compiler/program/completeness.sharp). The first such
    // expression of each file is reported (E0991), so a program the analysis did not fully
    // understand never ends with "analysis complete: no errors".
    stage_started = now_ms();
    unknown : unknown_count? = null;
    if(bodies != null) { unknown = check_completeness(bodies!!); }
    completeness_ms : decimal = now_ms() - stage_started;

    // ---- program checks: what only the whole program can say (backend/compiler/program) - the
    // entry point `main`, fields nothing gives a value, the platform's start-up functions, unused
    // names - and what the program reaches from main. The result is the analysed program: the
    // one object a code generator is handed (backend/types/program/analysed_program.sharp).
    stage_started = now_ms();
    analysed : analysed_program? = null;
    if(bodies != null) {
        bodies!!.extra_warnings = options.extra_warnings ? 1 : 0;
        analysed = check_program(bodies!!);
    }
    program_ms : decimal = now_ms() - stage_started;

    // The warning switches (-w, -w<kind>, -werror) decide what is printed and what counts as an
    // error; the analysed program is told the result, because that is what code generation asks.
    warnings_set := warning_settings_from_options();
    // ... and they are printed in the order of the program text, the files in the order
    // they were given (frontend/diagnostics/message_order.sharp).
    shown := in_source_order(apply_warning_settings(found, warnings_set, whole_program), files);
    // (a module that is missing because -ignore / -ignoredir took its files away: said on the E0303)
    explain_modules_left_out(shown);
    if(analysed != null) { count_problems(analysed!!, shown); }

    if(options.show_declarations) {
        print_declarations(whole_program);
    }
    if(options.show_analysis && bodies != null && files.size() > 0) {
        print_analysis(whole_program, options.inspected_file);
        if(analysed != null) { print_program_summary(analysed!!); }
    }
    if(options.show_analysis_stats && bodies != null) {
        print_analysis_stats(bodies!!);
        if(analysed != null) { print_program_summary(analysed!!); }
        if(unknown != null) { println(unknown_line(unknown!!)); }
    }

    if(options.ide_folder != "") {
        write_for_editor(options.ide_folder, units, whole_program, shown, bodies, analysed);
    }

    name_errors : decimal = print_within_limit(shown, options.max_errors as _int64);
    hidden_line := library_warnings_line(warnings_set);
    if(sizeof(hidden_line.data) > 0) { progress(hidden_line); }
    if(name_errors > 0) {
        println("" + (name_errors as _int64) + " error(s)");
        return 1;
    }
    progress("names resolved in " + whole_program.module_list.size() + " module(s)");
    if(options.show_timings) {
        println("time: parsing " + (parse_ms as _int64) + " ms, declarations " + (collect_ms as _int64)
                + " ms, type names " + (resolve_ms as _int64) + " ms, class checks " + (checks_ms as _int64)
                + " ms, members " + (members_ms as _int64) + " ms, bodies " + (bodies_ms as _int64) + " ms, flow "
                + (flow_ms as _int64) + " ms, unused generics " + (blueprints_ms as _int64) + " ms, components " + (components_ms as _int64) + " ms, initializers "
                + (initializers_ms as _int64) + " ms, completeness " + (completeness_ms as _int64) + " ms, program checks "
                + (program_ms as _int64) + " ms");
        if(unknown != null) { println(unknown_line(unknown!!)); }
    }

    // The last line of a build in which every stage ran and found nothing wrong.
    // The test scripts look for it (tests/backend.sh): a compiler that stopped
    // half way - an exception, a stage that returned early - does not print it.
    progress("analysis complete: no errors");

    // ---- code generation (backend/finalizer, doc/codegen.md): only for a program analysis found
    // nothing wrong in. `-c` compiles only: nothing is written. Without `-o` the file is `out`
    // (project.sharp, output_path), as the C++ compiler names it. Its steps have a `time:`
    // line of their own.
    if(analysed == null) { return 1; }
    if(options.compile) { return 0; }
    // `-ide <folder>` is the editor asking "is this right, and what is in it?" (backend/ide): it wants
    // the folder's files, not an executable - and a folder of library files has no `main` to start one
    // at. So -ide checks only, like -c, unless the command line names a file to write with -o.
    if(options.ide_folder != "" && !options.out_given) { return 0; }

    written := output_path();
    if(!generate_executable(analysed!!, files, written)) { return 1; }

    // ---- -run: the program that was just written, on the runtime
    if(options.run_source) { return run_program(written); }
    return 0;
}
