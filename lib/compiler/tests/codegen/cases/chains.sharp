/*
 * CHAINS OF ANY LENGTH (doc/codegen.md 13.3, backend.md D103). A chain is one
 * operator or call after another on the same level - not nesting:
 *
 *      a + b + c + ...             each `+` is the left operand of the next
 *      a || b || c ...             the same for `||` and `&&`
 *      c1 ? x : c2 ? y : ...       each `? :` is the "else" value of the one before
 *      "a" + b + "c" + ...         calls of operator+, each the object of the next
 *      if .. else if .. else if    each `if` is the else part of the one before
 *
 * The generator follows each of them in a LOOP. With one level of recursion
 * per link a chain of a few hundred links ran the compiler out of the VM's
 * stack (it ended in stack_overflow_exception); the C++ compiler takes them.
 * Each chain below has 300 links.
 *
 *   - a sum of 300 whole numbers; of whole numbers and decimals mixed; one
 *     whose terms store into the variable the other terms read (the right
 *     operand runs first: codegen.md 6.0);
 *   - 300 `||` of which the last holds, 300 `&&` that all hold;
 *   - a ladder of 300 `? :`;
 *   - a text put together from 300 pieces (its length is printed);
 *   - a ladder of 300 `else if` with an `else`.
 */

def sums() {
    a : _int64 = 1;
    half : decimal = 0.5;
    show(
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a +
        a + a + a + a + a + a + a + a + a + a + a + a
    );
    show_decimal(
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a +
        half + a + half + a + half + a + half + a + half + a + half + a
    );
    show(
        (a = a + 1) + a + (a = a + 1) + a + (a = a + 1) + a + (a = a + 1) + a
    );
}

