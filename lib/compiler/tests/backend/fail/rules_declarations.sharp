// expect: E0303 E0301 E0333 E0333 E0346 E0302 E0351 E0352 E0331 E0384 E0900 E0331
mod app;

// The "Leftovers: rules" stage: mistakes in declarations that used to slip
// through, or to set off messages of their own after the first. Each line
// marked E.... is the one message; the lines marked "quiet" were follow-ons.

import ( std, std.io, std.utils )                   // E0303 (did you mean `std.util`?)
def takes_range(r: range) { }                       // quiet: `range` is in the module that import meant
def makes_range() { r := range.of(1, 2); }          // quiet: so is the `range` named as a value

// a misspelt base class: one E0301, nothing about what the class then is not
class oops base exeption {                          // E0301
    oops() -> base("x") { }                         // quiet: not "no constructor of `_object_` takes ..."
}
class point_like { point_like(x: decimal) { } }
class needs_point<T base point_like> { }
def throws_oops() {
    try { throw new oops(); }                       // quiet: not "oops is not a throwable"
    catch(e: oops) { }                              // quiet
    h : needs_point<oops>?;                         // quiet: not "oops is not a point_like"
}

// two init(x) conversions that take the same value
class celsius {
    init(degrees: _int64) { }
    init(other_name: _int64) { }                    // E0333
}
def make_celsius() { c : celsius = 5; }             // quiet: not "more than one constructor" (E0503)
// ... and two that only fall together in one instance of a generic class
class reading<T> {
    init(value: T) { }
    init(count: _int64) { }                         // E0333 (in reading<_int64>)
}
def make_reading() { r : reading<_int64> = 5; ok : reading<string>? = null; }

// an interface function declared again, without a body, by the class that lists the interface
interface drawable { def draw(n: _int64); }
class shape : drawable { def draw(n: _int64); }     // E0346 (and not E0341 on top)
class square base shape { override def draw(n: _int64) { } }

// an alias and a nested class with one name: E0302 alone, no W1001 beside it
class h { alias _int64 as x; class x { } }          // E0302

// a type argument a bound refuses: the instance is not analysed, so nothing is
// reported from inside the library's hash_map and its entry<...>
def keeps_functions() { funcs := new hash_map<string, (decimal)(decimal)>(); }     // E0351

// a generic function that makes ever deeper instances: ONE E0352, not one per written type
def wrap<T>(x: T, depth: _int64) : _int64 {
    if(depth == 0) return 0;
    l := new list<T>();                             // E0352
    l.add(x);
    return 1 + wrap<list<T>>(l, depth - 1);         // quiet: the same chain
}
def start_wrap() { wrap<int>(new int(1), 3); }

// an extension function that clashes with a member: E0331, and its body is not
// analysed as a module function (no "`self` cannot be used here", no "no `x`")
class spot { x : _int64; def twice() : _int64 { return x * 2; } }
def spot.twice() : _int64 { return self.x * 2 + x; }    // E0331

// an extension function for a generic class names ALL its type parameters in order, or none of them
class pair<A, B> { first : A?; second : B?; }
def pair<B, A>.swapped() : B? { return first; }     // E0384 (and nothing about `first` in its body)

// a component declared twice: E0900, and its definitions are not "a second definition" on top
class service { }
component tools { single { new service() } }
component tools { single { new service() } }        // E0900

def main() { }
def main() { }                                      // E0331 alone: not "a second entry point" (E0930) as well
