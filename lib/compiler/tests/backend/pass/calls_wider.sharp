mod calls_wider;

import ( std.io )

/**
 * CALLS THE BOOTSTRAP ACCEPTS AND THE C++ COMPILER DOES NOT
 * (doc/backend.md section 5: D3 ranking, D53 type arguments worked out).
 * Each line says which function is chosen.
 */

class animal { }
class dog base animal { }

def dd(a: _int64) : _int64 { return 1; }
def dd(a: decimal) : _int64 { return 2; }
def obj(a: object) : _int64 { return 1; }
def obj(a: animal) : _int64 { return 2; }
def widen(a: _int32) : _int64 { return 1; }
def widen(a: _int64) : _int64 { return 2; }

def identity<T>(x: T) : T { return x; }
def first_or<T>(items: list<T>, fallback: T) : T {
    if(items.size() > 0) { return items.at(0); }
    return fallback;
}
def last_of<T>(items: T[]) : T { return items[sizeof(items) - 1]; }

def wider() {
    a : _int64 = dd(2);                         // dd(_int64): the same kind of number, nothing lost (7.6 step 7a)
    b : _int64 = obj(new dog());                // obj(animal): an upcast (rank 2) before `object` (rank 3)
    small : _int8 = 3;
    c : _int64 = widen(small);                  // widen(_int32): the narrower of two lossless widenings
    d : _int64 = identity(5);                   // identity<_int32>, worked out from the argument
    names := new list<string>();
    e : string = first_or(names, "none");       // first_or<string>: list<T> against list<string>
    f : string = last_of({ "x", "y" });         // last_of<string>: T[] against string[]
}
