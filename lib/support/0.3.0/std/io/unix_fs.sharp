mod std.io;

/**
 * UnixFileSystem represents the high level version of the operations
 * that you can invoke on a linux file system. Not much needs to be changed in
 * this file other than normalizing the path name
 */
protected class unix_fs base file_system {
    private slash := '/';

    override def path_separator() : char {
        return slash;
    }

    /**
    * Make sure we know that our path has the correct
    * path seperators to be accessed:
    *
    *   - a back slash becomes a forward slash ("a\b" -> "a/b")
    *   - several slashes in a row become one ("a//b" -> "a/b")
    *   - a slash at the end is removed ("a/b/" -> "a/b"), except for the
    *     root itself ("/" stays "/", and "///" becomes "/")
    *
    * "." and ".." are left alone (see path.normalize() for that). There is
    * no limit on the length of the path.
    */
    override def normalize(pathname: string) : string {
        n : var = sizeof(pathname.data);
        buf := new char_buffer(n + 1);
        last_was_slash : var = 0;

        for(i : var = 0; i < n; i++) {
            ch : var = pathname.data[i];
            if(ch == '/' || ch == '\\') {
                if(!last_was_slash) {
                    buf.append_char('/');
                }
                last_was_slash = 1;
            } else {
                buf.append_char(ch);
                last_was_slash = 0;
            }
        }

        // remove the trailing slash, but keep a lone "/" (the root)
        if(last_was_slash && buf.length() > 1) {
            buf.truncate(buf.length() - 1);
        }
        return buf.to_string()!!;
    }

     /**
      * Return the simple boolean attributes for the file or directory denoted
      * by the given abstract pathname, or zero if it does not exist or some
      * other I/O error occurs.
      *
      * The runtime does not report "hidden" on unix; by the unix convention
      * a file is hidden when its name starts with a period, and that bit is
      * added here.
      */
     override def get_attributes(f: file) : int {
        path := f.path.data;
        attrs: var = 0;

        /*
        * This will perform the os call to request the
        * file attributes of the given abstract pathname
        */
        asm {
            pushl [path]
            int 0x25
            smovr2 [attrs], ebx
        };

        if(attrs != 0) {
            // find the first character of the name (behind the last slash)
            name_start : var = 0;
            for(i : var = sizeof(path) - 1; i >= 0; i--) {
                if(path[i] == '/') {
                    name_start = i + 1;
                    break;
                }
            }
            if(name_start < sizeof(path) && path[name_start] == '.') {
                attrs = attrs | file_system.file_hidden;
            }
        }

        return attrs;
     }


     /**
      * Check whether the file or directory denoted by the given abstract
      * pathname may be accessed by this process.  The second argument specifies
      * which access, ACCESS_READ, ACCESS_WRITE or ACCESS_EXECUTE, to check.
      * Returns 0 when the access is allowed and something else if access is
      * denied or an I/O error occurs
      */
     override def check_access(f: file, access: int) : int {
        path := f.path.data;
        _access := access.value;
        result : var = 0;

        /*
        * This will perform the os call to request the
        * file access stats of the given abstract pathname
        */
        asm {
            pushl [path]
            loadl ebx, [_access]
            int 0x24
            smovr2 [result], ebx
        };

        return result;
     }
}
