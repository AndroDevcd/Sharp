mod std.io;

/**
 * WinFileSystem represents the high level version of the operations
 * that you can invoke on a windows file system. Not much needs to be changed in
 * this file other than normalizing the path name.
 *
 * Windows does not classify access execute aso a request for that will fail
 * before we even interrupt the vm
 */
protected class win_fs base file_system {
    private slash := '\\';

    override def path_separator() : char {
        return slash;
    }

    /**
    * Make sure we know that our path has the correct
    * path seperators to be accessed:
    *
    *   - a forward slash becomes a back slash ("a/b" -> "a\b")
    *   - several separators in a row become one ("a\\b" -> "a\b"), except
    *     for two at the very beginning, which name a server share
    *     ("\\server\share" stays as it is)
    *   - a separator at the end is removed ("a\b\" -> "a\b"), except when
    *     the path is a root ("\" and "C:\" stay)
    *
    * "." and ".." are left alone (see path.normalize() for that). There is
    * no limit on the length of the path.
    */
    override def normalize(pathname: string) : string {
        n : var = sizeof(pathname.data);
        buf := new char_buffer(n + 1);
        last_was_slash : var = 0;
        i : var = 0;

        // keep the two separators that start a server share
        if(n >= 2 && (pathname.data[0] == '/' || pathname.data[0] == '\\')
            && (pathname.data[1] == '/' || pathname.data[1] == '\\')) {
            buf.append_char('\\');
            buf.append_char('\\');
            last_was_slash = 1;
            i = 2;
        }

        for(; i < n; i++) {
            ch : var = pathname.data[i];
            if(ch == '/' || ch == '\\') {
                if(!last_was_slash) {
                    buf.append_char('\\');
                }
                last_was_slash = 1;
            } else {
                buf.append_char(ch);
                last_was_slash = 0;
            }
        }

        // remove the trailing separator, but keep "\" and "C:\" (roots)
        len : var = buf.length();
        if(last_was_slash && len > 1) {
            is_drive_root : var = (len == 3 && buf.char_at(1) == ':');
            is_share_start : var = (len == 2);
            if(!is_drive_root && !is_share_start) {
                buf.truncate(len - 1);
            }
        }
        return buf.to_string()!!;
    }

     /**
      * Return the simple boolean attributes for the file or directory denoted
      * by the given abstract pathname, or zero if it does not exist or some
      * other I/O error occurs.
      */
     override def get_attributes(f: file) : int {
        path := f.path.data;
        attrs : var = 0;

        /*
        * This will perform the os call to request the
        * file attributes of the given abstract pathname
        */
        asm {
            pushl [path]
            int 0x25
            smovr2 [attrs], ebx
        };

        return attrs;
     }


     /**
      * Check whether the file or directory denoted by the given abstract
      * pathname may be accessed by this process.  The second argument specifies
      * which access, ACCESS_READ, ACCESS_WRITE or ACCESS_EXECUTE, to check.
      * Returns 0 when the access is allowed and something else if access is
      * denied or an I/O error occurs. Execute access cannot be asked for on
      * windows and always answers -1.
      */
     override def check_access(f: file, access: int) : int {
        path := f.path.data;
        _access := access.value;
        result : var = 0;

        // unsupported on windows
        if(access == file_system.access_execute)
            return -1;

        /*
        * This will perform the os call to request the
        * file access stats of the given abstract pathname
        */
        asm {
            pushl [path]
            loadl ebx, [_access]
            int 0x24
            smovr2 [result], ebx
        };

        return result;
     }
}
