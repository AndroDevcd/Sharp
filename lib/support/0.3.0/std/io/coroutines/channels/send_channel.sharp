mod std.io.coroutines.channels;

/**
 * send_channel<t> - the sending end of a channel: what a producer is given.
 *
 * USAGE
 *     def produce_numbers(out: send_channel<int>) {
 *         for(i : var = 0; i < 10; i++) { out.send(i); }
 *         out.close();
 *     }
 *
 * Handing out only this interface makes it plain that the function sends and
 * never receives. channel<t> implements it.
 *
 * Kotlin equivalent: kotlinx.coroutines.channels.SendChannel<E>.
 */
interface send_channel<t> {
    /** Hand `value` over; SUSPENDS while the channel is full. Cancellation point. Throws closed_channel_exception on a closed channel. */
    def send(value: t);

    /** send() that never waits: false when the channel is full or closed. */
    def try_send(value: t) : bool;

    /** No more elements will be sent. What was sent before can still be received. */
    def close();

    /** true after close() or cancel() */
    def is_closed_for_send() : bool;
}
