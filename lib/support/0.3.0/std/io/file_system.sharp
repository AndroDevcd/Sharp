mod std.io;

import (
    platform,
    platform.kernel
)

/**
 * FileSystem serves as the abstract base level class for the underlying
 * filesystem residing on the host OS. This class contains a set of delegates
 * that must be implemented that are OS dependant (unix_fs, win_fs).
 *
 * This is the only place where the file system calls of the runtime are made
 * (the `asm { ... int 0x.. }` blocks). Programs do not use this class; they
 * use `file`, which forwards to it.
 *
 * What the runtime offers, and therefore what everything in std.io is built
 * from: read a whole file, write a whole file, create / delete a file,
 * create / delete an (empty) directory, rename, attributes, access checks,
 * size, time stamps, absolute path, current directory, disk space. There are
 * no file handles: a file is always read or written in one piece.
 *
 * Every call is given the path exactly as the `file` object holds it (it may
 * be relative to the current directory), so the calls also work for files
 * that do not exist yet.
 */
protected class file_system {

    /**
    * Get current path seperator based on os
    *
    * linux /
    * windows \
    */
    def path_separator() : char;

    /**
    * Make sure we know that our path has the correct
    * path seperators to be accessed
    */
    def normalize(path: string) : string;

     /**
      * Resolve the given abstract pathname into absolute form.  Invoked by the
      * getAbsolutePath method in the File class.
      *
      * For a path that exists the operating system resolves it (on unix this
      * also follows symbolic links and removes "." and ".."). For a path that
      * does not exist (yet) the absolute form is worked out here: a path that
      * already starts at a root is returned as it is, anything else is put
      * behind the current directory.
      */
     def resolve(f: file) : string {
        /* native code */
        path := f.path.data;

        /*
        * This will perform the os call to request the
        * full path of the given abstract pathname
        */
        asm {
            pushl [path]
            int 0x20
            popl [path]
        };

        if(path != null && sizeof(path) > 0) {
            return "$path";
        }

        if(is_rooted(f.path)) {
            return f.path;
        }

        sep : decimal = path_separator().value;
        cwd := current_directory();
        buf := new char_buffer(sizeof(cwd.data) + sizeof(f.path.data) + 2);
        buf.append(cwd);
        if(sizeof(cwd.data) == 0 || cwd.data[sizeof(cwd.data) - 1] != sep) {
            buf.append_char(sep);
        }
        buf.append(f.path);
        return buf.to_string()!!;
     }

     /**
      * True when the path starts at a root of the file system: "/..." on
      * unix; a drive ("C:..."), a server share or a leading separator on
      * windows.
      */
     def is_rooted(path: string) : bool {
        n : decimal = sizeof(path.data);
        if(n == 0) {
            return false;
        }
        first : decimal = path.data[0];
        if(first == '/' || first == 92) { // 92 is the back slash
            return true;
        }
        if(build.is_windows() && n >= 2 && path.data[1] == ':'
            && ((first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z'))) {
            return true;
        }
        return false;
     }

     /**
      * The directory the program was started in (relative paths are relative
      * to it). Throws io_exception when the operating system does not tell.
      */
     static def current_directory() : string {
        path : _int8[];

        /*
        * This will perform the os call to request the
        * current working directory
        */
        asm {
            int 0x4f
            popl [path]
        };

        if(path == null) {
            throw new io_exception("could not retrieve current directory");
        }

        return "$path";
     }


    /* Constants for file attributes */
    static const file_exists       := 0x01;
    static const file_regular      := 0x02;
    static const file_directory    := 0x04;
    static const file_block_device := 0x08;
    static const file_character    := 0x10;
    static const file_fifo_pipe    := 0x20;
    static const file_unknown      := 0x40;
    static const file_hidden       := 0x80;

     /**
      * Return the simple boolean attributes for the file or directory denoted
      * by the given abstract pathname, or zero if it does not exist or some
      * other I/O error occurs.
      */
     def get_attributes(f: file) : int;

     /* Constants for file access flags */
     static const access_read    := 0x04;
     static const access_write   := 0x02;
     static const access_execute := 0x01;
     static const access_ok      := 0x00;

     /**
      * Check whether the file or directory denoted by the given abstract
      * pathname may be accessed by this process.  The second argument specifies
      * which access, ACCESS_READ, ACCESS_WRITE or ACCESS_EXECUTE, to check.
      * Returns 0 when the access is allowed and something else if access is
      * denied or an I/O error occurs
      */
     def check_access(f: file, access: int) : int;

     /**
      * Set on or off the access permission (to owner only or to all) to the file
      * or directory denoted by the given abstract pathname, based on the parameters
      * enable, access and oweronly. Returns 0 on success, -1 when the file
      * does not exist (or for execute access on windows), otherwise the
      * error number of the operating system.
      */
     def set_permission(f: file, access: int, enable: bool, owneronly: bool) : int {
        // native code here
        path := f.path.data;
        _access : _int64 = access.value;
        _enable : _int64 = enable.value;
        _owneronly : _int64 = owneronly.value;
        result : _int64 = 0;

        if(build.is_windows() && access == access_execute)
            return -1;

        /*
        * This will perform the os call to request the
        * file permissions of the given abstract pathname to be changed
        */
        asm {
            pushl [path]
            loadl ebx, [_access]
            loadl egx, [_enable]
            loadl ecx, [_owneronly]
            int 0x2e
            smovr2 [result], ebx
        };

        return result;
     }

     static const last_access        := 0x02;
     static const last_status_change := 0x01;
     static const last_modification  := 0x00;

     /**
      * Return the time (seconds since 1970) at which the file or directory
      * denoted by the given abstract pathname was last modified (or accessed,
      * or had its status changed - see the constants above), or zero if it
      * does not exist or some other I/O error occurs.
      */
     def last_modified_time(f: file, stat_id: int) : long {
        // native code
        path := f.path.data;
        _stat_id : _int64 = stat_id.value;
        time : _int64 = 0;

        /*
        * This will perform the os call to request the
        * time stamps of the given abstract pathname
        */
        asm {
            pushl [path]
            loadl ebx, [_stat_id]
            int 0x26
            smovr2 [time], ebx
        }

        return time;
     }

     /**
      * Return the length in bytes of the file denoted by the given abstract
      * pathname, or zero if it does not exist, is a directory, or some other
      * I/O error occurs.
      */
     def get_length(f: file) : int {
        // native code here
        path := f.path.data;
        size : _int64 = 0;

        if(!f.is_file())
            return 0;

        /*
        * This will perform the os call to request the
        * size of the given abstract pathname
        */
        asm {
            pushl [path]
            int 0x27
            smovr2 [size], ebx
        };

        // the runtime answers -1 for a file it cannot look at
        if(size < 0) {
            return 0;
        }

        return size;
     }


    /**
     * Create a new empty file with the given pathname. An existing file with
     * that name is emptied (file.create() checks for that first). Nothing
     * happens when the file cannot be created (e.g. its directory does not
     * exist); check with file.exists() afterwards.
     */
    def create_file(pathname: string) {
        // native code here
        path := pathname.data;

        /*
        * This will perform the os call to request the
        * file to be created
        */
        asm {
            pushl [path]
            int 0x28
        };
    }

    /**
     * Delete the directory denoted by the given abstract pathname. The
     * directory has to be empty (file.delete_recursively() removes a
     * directory with everything in it). Returns 0 when the directory was
     * removed and something else when it was not (not empty, not there, no
     * permission).
     */
    private def delete_directory(f: file) : int {
        // native code here
        path := f.path.data;
        result : _int64 = 0;

        /*
        * This will perform the os call to request the
        * directory to be deleted
        */
        asm {
            pushl [path]
            int 0x2c
            smovr2 [result], ebx
        };

        return result;
    }

    /**
     * Delete the file or (empty) directory denoted by the given abstract
     * pathname. Returns 0 when it was removed and something else when it was
     * not (it does not exist, a directory is not empty, no permission).
     */
    def delete(f: file) : int {
        // native code here
        path := f.path.data;
        result : _int64 = 0;

        if(f.is_directory())
            return delete_directory(f);

        /*
        * This will perform the os call to request the
        * file to be deleted
        */
        asm {
            pushl [path]
            int 0x29
            smovr2 [result], ebx
        };

        return result;
    }

    /**
     * List the elements of the directory denoted by the given abstract
     * pathname: the names (not paths) of the files and directories directly
     * inside it, sorted by character code, without "." and "..". Returns
     * null when the pathname is not a directory and an empty array for an
     * empty directory.
     *
     * See directory_listing for how the names are found.
     */
    def list(f: file) : string[]? {
        if(!f.is_directory())
            return null;

        names := directory_listing.names(f.path);
        count : decimal = names.size().value;
        result := new string[count];
        for(i : decimal = 0; i < count; i++) {
            result[i] = names.at(i);
        }
        return result;
    }

    /**
     * The paths of all regular files below the given directory, in every
     * sub directory, as the runtime reports them (path of the directory +
     * separator + path below it), in no particular order.
     *
     * This is the directory call of the runtime as it is, with its limits:
     * names that start with '.' are skipped (files and whole directories),
     * and directories themselves are not reported, so an empty directory is
     * invisible. Returns null when nothing was found or the pathname is not a
     * directory.
     */
    def list_tree_files(f: file) : string[]? {
        // native code here
        path := f.path.data;
        files: string[];

        if(!f.is_directory())
            return null;

        /*
        * This will perform the os call to request the
        * list of files
        */
        asm {
            pushl [path]
            int 0x2a
            popl [files]
        };

        return files;
    }

    /**
     * Create a new directory denoted by the given abstract pathname. The
     * directory it is created in has to exist. Returns 0 when the directory
     * was created and something else when it was not.
     */
    def create_directory(f: file) : int {
        // native code here
        path := f.get_path().data;
        result: _int64;

        /*
        * This will perform the os call to request the
        * directory to be created
        */
        asm {
            pushl [path]
            int 0x2b
            smovr2 [result], ebx
        };

        return result;
    }

    /**
     * Rename the file or directory denoted by the first abstract pathname to
     * the second abstract pathname. Returns 0 when the operation succeeds
     * and something else when it does not.
     */
    def rename(f1: file, f2: file) : int {
        // native code here
        path := f1.path.data;
        rename := f2.get_path().data;
        result : _int64 = 0;

        /*
        * This will perform the os call to request the
        * file to be renamed
        */
        asm {
            pushl [rename]
            pushl [path]
            int 0x30
            smovr2 [result], ebx
        };

        return result;
    }

    /**
     * The whole content of the file as a string, every byte one character.
     * Returns null when the file is empty, does not exist or cannot be read
     * (the runtime does not tell these apart; file.read_text() does).
     */
    static def read(f: file) : string? {
        path := f.path.data;
        data : string?;

        /*
        * This will perform the os call to request the
        * file to be read
        */
        asm {
            pushl [path]
            int 0x2f
            popl [data]
        };

        return data;
    }


    /**
     * Replace the content of the file with `data` (every character one
     * byte), creating the file when it does not exist. Returns 0 when the
     * file was written and something else when it could not be opened for
     * writing (e.g. the directory does not exist).
     */
    static def write(f: file, data: string) : int {
        path := f.path.data;
        raw := data.data;
        result : _int64 = 0;

        if(raw == null || sizeof(raw) == 0) {
            /*
            * The write call of the runtime needs at least one character.
            * Creating the file anew leaves it empty, which is what writing
            * nothing means.
            */
            asm {
                pushl [path]
                int 0x28
            };

            if(f.is_file() && f.length() == 0) {
                return 0;
            }
            return 1;
        }

        /*
        * This will perform the os call to request the
        * file to be written
        */
        asm {
            pushl [raw]
            pushl [path]
            int 0x31
            smovr2 [result], ebx
        };

        return result;
    }

    /**
     * Set the last-modified time of the file or directory denoted by the
     * given abstract pathname (seconds since 1970). Returns the time that
     * was set, or -1 when the file does not exist.
     */
    public def set_last_modified_time(f: file, time: long) : int {
        // native code here
        path := f.path.data;
        _time : _int64 = time.value;
        result : _int64 = 0;

        /*
        * This will perform the os call to request the
        * time stamp to be changed
        */
        asm {
            pushl [path]
            loadl ebx, [_time]
            int 0x2d
            smovr2 [result], ebx
        }

        return result;
    }

    /**
     * Mark the file or directory denoted by the given abstract pathname as
     * read-only. Returns 0 when the operation succeeds.
     */
    public def set_read_only(f: file) : int {
        set_permission(f, access_write, false, true);
        return set_permission(f, access_read, true, true);
    }

    /* -- Disk usage -- */
    static const space_total  := 0;
    static const space_free   := 1;
    static const space_usable := 2;

    /**
     * The size in bytes of the partition the program runs on (space_total),
     * or the bytes that are not in use (space_free) or can be used by this
     * program (space_usable). -1 when the operating system does not tell.
     */
    static def get_space_available(request: int) : long {
        // native code here
        result : _int64 = 0;
        // (the asm block used to load `request` itself: an `int` object, not a
        //  number, so the interrupt got whatever happened to be in its slot)
        _request : _int64 = request.value;

        /*
        * This will perform the os call to request the
        * disk space
        */
        asm {
            loadl ebx, [_request]
            int 0x32
            smovr2 [result], ebx
        }

        return result;
    }
}
