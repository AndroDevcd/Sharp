mod std;

import ( std.math )

/**
* Created by bknun on 9/5/2022
*
* @class hash_table
*
* Description:
* The thread safe variant of hash_map: the same map from keys to values
* with O(1) average lookup, with every operation run inside lock(self) so
* that several threads may use one table at the same time.
*
*     hits := new hash_table<string, int>();
*     hits.put("home", 1);
*     hits.at("home");                // 1
*     hits.contains_key("about");     // false
*     hits.remove("home");
*
* Each single call is atomic; a SEQUENCE of calls is not ("if it is not in
* the table, put it" can still be interleaved with another thread).
*
* How it works: an array of buckets; `key.hash()` picks the bucket and the
* entries of one bucket form a chain that is searched with `==`. When the
* table holds more than `threshold` (0.75) entries per bucket the bucket
* array is doubled.
*/
class hash_table<k base _object_, v base _object_> {
    /** the buckets: data[i] is the first entry of the chain of bucket i, or null */
    data: entry<k, v>[];
    /** the table grows when it holds more than threshold * (number of buckets) entries */
    threshold := 0.75;
    /** the number of entries at which the next growth happens */
    max_size := 96;
    /** the number of entries (read it, do not write it) */
    size : var;

    private static const default_capacity := 128;

    /** Create an empty table with `initialCapacity` buckets (it grows when needed). */
    public hash_table(initialCapacity: int) {
        data = new entry<k,v>[initialCapacity.value];
        max_size = (sizeof(data) * threshold);
    }

    /** Create an empty table with 128 buckets. */
    public hash_table() {
        data = new entry<k,v>[default_capacity];
    }

    /**
     * Change how full the table may get before it grows: the next growth
     * happens at threshold * (number of buckets) entries.
     */
    def set_threshold(threshold: int) {
        lock (self) {
            self->threshold = threshold.value;
            max_size = (sizeof(data) * threshold.value);
        }
    }

    /** The bucket a key belongs to: its hash, made non-negative, modulo the number of buckets. */
    private def hash(key: k) : var {
        return abs(key.hash() % sizeof(data)).value;
    }

    /** 1 when the two keys are equal (compared with `==`), otherwise 0. */
    private def same_key(a: k, b: k) : var {
        if(a == b) return 1;
        return 0;
    }

    /** Double the number of buckets and move every entry to its new bucket. Called with the lock held. */
    private def resize() {
        old_data := data;
        data = new entry<k,v>[sizeof(old_data) * 2];
        max_size = sizeof(data) * threshold;

        for(i : var = 0; i < sizeof(old_data); i++) {
            item := old_data[i];
            while(item != null) {
                following := item.next;
                index : var = hash(item.key);
                item.next = data[index];
                data[index] = item;
                item = following;
            }
        }
    }

    /** The entry that holds `key`, or null. Called with the lock held. */
    private def find_entry(key: k) : entry<k, v> {
        item := data[hash(key)];
        while(item != null) {
            if(same_key(item.key, key)) return item;
            item = item.next;
        }
        return item;
    }

    /** Remove every entry; the table goes back to 128 buckets. */
    def clear() {
        lock (self) {
            data = new entry<k,v>[default_capacity];
            max_size = (sizeof(data) * threshold);
            size = 0;
        }
    }

    /** The value stored for a key, or null when the table does not have the key. O(1) on average. */
    public def at(key: k) : v? {
        lock (self) {
            item := find_entry(key);
            if(item == null) return null;
            return item.value;
        }
    }

    /** true when the table has the key. O(1) on average. */
    public def contains_key(key: k) : bool {
        lock (self) {
            return find_entry(key) != null;
        }
    }

    /**
     * Store a value for a key, replacing the value the key had before.
     * O(1) on average.
     *
     * @return true when the key is new, false when an existing value was replaced
     */
    public def put(key: k, value: v) : bool {
        lock (self) {
            item := find_entry(key);
            if(item != null) {
                item.value = value;
                return false;
            }

            if(size >= max_size.value) resize();

            index : var = hash(key);
            added := new entry<k,v>(key, value);
            added.next = data[index];
            data[index] = added;
            size++;
            return true;
        }
    }

    /**
     * Remove a key and its value. O(1) on average.
     *
     * @return true when the key was removed, false when the table did not have it
     */
    public def remove(key: k) : bool {
        lock (self) {
            index : var = hash(key);
            previous : entry<k,v>? = null;
            item := data[index];
            while(item != null) {
                if(same_key(item.key, key)) {
                    if(previous == null) data[index] = item.next;
                    else previous!!.next = item.next;
                    size--;
                    return true;
                }
                previous = item;
                item = item.next;
            }
            return false;
        }
    }

    /** A snapshot of all keys, in bucket order (which looks random). O(n). */
    public def keys() : list<k> {
        lock (self) {
            result := new list<k>();
            for(i : var = 0; i < sizeof(data); i++) {
                item := data[i];
                while(item != null) {
                    result.add(item.key);
                    item = item.next;
                }
            }
            return result;
        }
    }

    /** A snapshot of all values, in the same order as keys(). O(n). */
    public def values() : list<v> {
        lock (self) {
            result := new list<v>();
            for(i : var = 0; i < sizeof(data); i++) {
                item := data[i];
                while(item != null) {
                    result.add(item.value);
                    item = item.next;
                }
            }
            return result;
        }
    }

    /** One link of a bucket chain: a key, its value, and the next entry of the same bucket. */
    class entry<k, v> {
        protected key: k;
        protected value: v;
        protected next: entry<k, v>;

        public entry(key: k, value: v) {
            self->key = key;
            self->value = value;
        }

        public def to_string() : string {
            return "key " + key + " value " + value;
        }
    }
}
