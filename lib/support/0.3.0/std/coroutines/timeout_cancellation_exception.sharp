mod std.coroutines;

/**
 * timeout_cancellation_exception - thrown by with_timeout() when its block did
 * not finish in time.
 *
 * USAGE
 *     try {
 *         with_timeout(500, { -> slow_work(); });
 *     } catch(e: timeout_cancellation_exception) {
 *         println("gave up after half a second");
 *     }
 *
 * It is a cancellation_exception: inside the block it arrives at the next
 * cancellation point like any other cancellation, and a coroutine that lets it
 * escape ends as cancelled, not as failed. Use with_timeout_or_null() to get
 * null instead of an exception.
 *
 * Kotlin equivalent: kotlinx.coroutines.TimeoutCancellationException.
 * (std's timeout_exception is the thread level one, thrown by future.result(ms).)
 */
class timeout_cancellation_exception base cancellation_exception {
    public timeout_cancellation_exception(message : string?) -> base(message) {}
}
