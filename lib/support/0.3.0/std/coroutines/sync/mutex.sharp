mod std.coroutines.sync;

import (
    std.io.fiber,
    std.coroutines
)

/**
 * mutex - a lock for coroutines: one at a time, the others are SUSPENDED (not
 * spinning, not blocking their thread) until it is their turn.
 *
 * USAGE
 *     guard := new mutex();
 *
 *     guard.with_lock({ ->            // acquire, run the block, release - whatever happens
 *         balance.value = balance.value + 10;
 *     });
 *
 *     guard.acquire();                // or by hand, when the two ends are in different places
 *     try { ... } finally { guard.release(); }
 *
 * WHEN TO USE IT INSTEAD OF lock(obj) { }
 *   lock(obj) is for a few instructions. A fiber that sleeps (delay, channel,
 *   join ...) while it holds lock(obj) keeps everybody else out, and an
 *   exception that leaves a lock block does not release it. A mutex may be
 *   held across suspension points, waiting for it can be cancelled, and it is
 *   handed over in the order the waiters arrived.
 *
 * It is NOT reentrant: a coroutine that calls acquire() while it holds the
 * mutex waits for itself for ever (try_acquire() returns false).
 * It works from plain fibers and threads as well.
 *
 * Kotlin equivalent: kotlinx.coroutines.sync.Mutex (acquire = lock,
 * release = unlock, with_lock = withLock; `lock` is a keyword in Sharp).
 * C++ equivalent: std::mutex whose lock() suspends a fiber.
 *
 * LOCKING DISCIPLINE
 *   `lk` (a stripe of lock_stripes, picked once) guards held, owner and
 *   waiters, and is the guard of every waiter queued here. No other lock is
 *   taken while it is held, nothing throws and no user code runs inside a lock
 *   block.
 *   release() with waiters does not unlock: it hands the mutex straight to the
 *   oldest waiter (held stays 1, owner becomes that fiber), so nobody can jump
 *   the queue.
 *
 * Suspends: acquire(), with_lock(). Cancellation: acquire() is a cancellation
 * point; a cancelled wait does not get the mutex.
 */
class mutex {

    private lk : object = lock_stripes.next();
    private held : var = 0;
    private owner : fiber?;
    private waiters : wait_queue = new wait_queue();

    /** an unlocked mutex */
    mutex() {}

    /**
     * Take the mutex, waiting for it if somebody else has it.
     *
     * SUSPENDS while it is taken. A cancellation point: checked on entry; when
     * the caller is cancelled while it waits it is taken out of the queue and
     * cancellation_exception is thrown (the mutex is then NOT held).
     * Kotlin: Mutex.lock()
     */
    def acquire() {
        ensure_active();

        me := fiber.current();
        w : waiter? = null;
        lock(lk) {
            if(held == 0) {
                held = 1;
                owner = me;
            } else {
                w = new waiter(lk);
                waiters.add(w!!);
            }
        }

        if(w == null) {
            return;
        }

        // RESUMED means release() made this fiber the owner already
        if(await_waiter(w!!, -1) != 1) {
            lock(lk) {
                waiters.remove(w!!);
            }
            throw_cancellation();
        }
    }

    /**
     * Take the mutex if it is free right now.
     * @return true when the caller holds it now
     * Never suspends, not a cancellation point. Kotlin: Mutex.tryLock()
     */
    def try_acquire() : bool {
        me := fiber.current();
        got : var = 0;
        lock(lk) {
            if(held == 0) {
                held = 1;
                owner = me;
                got = 1;
            }
        }
        return got;
    }

    /**
     * Give the mutex back; the coroutine that has waited longest gets it.
     * Never suspends. Any fiber may release (hand-over patterns are allowed),
     * holds_lock() tells who holds it.
     * @throws illegal_state_exception when the mutex is not held
     * Kotlin: Mutex.unlock()
     */
    def release() {
        next_owner : waiter? = null;
        was_free : var = 0;

        lock(lk) {
            if(held == 0) {
                was_free = 1;
            } else {
                next_owner = waiters.pop_waiting(1);        // waiter.RESUMED
                if(next_owner != null) {
                    owner = next_owner!!.fib;
                } else {
                    held = 0;
                    owner = null;
                }
            }
        }

        if(was_free != 0) {
            throw new illegal_state_exception("release() of a mutex that is not held");
        }
        if(next_owner != null) {
            next_owner!!.unpark();
        }
    }

    /**
     * acquire(), run `block`, release() - also when the block throws (the
     * exception is thrown on after the release).
     *
     * The block runs in-line and may capture locals. SUSPENDS while it waits
     * for the mutex; a cancellation point (a cancelled wait does not run the
     * block).
     * @throws illegal_state_exception when called from inside the block of
     *         another with_lock() on the same fiber, of this or any other
     *         mutex (THE NESTING RULE, std/coroutines/scope/scopes.sharp: the
     *         runtime cannot continue a fiber with one function on its stack
     *         twice). Take the second mutex with acquire() / release() instead.
     * Kotlin: mutex.withLock { }
     */
    def with_lock(block: ()()) {
        check_scope_nesting(32, "mutex.with_lock");
        acquire();

        error : throwable? = null;
        mark_scope(32);
        try {
            block();
        } catch(t: throwable) {
            error = t;
        }
        unmark_scope(32);

        release();
        if(error != null) {
            throw error!!;
        }
    }

    /** true while somebody holds the mutex. Kotlin: Mutex.isLocked */
    def is_locked() : bool {
        return held != 0;
    }

    /** true when the calling fiber is the one that holds the mutex. Kotlin: Mutex.holdsLock(owner) */
    def holds_lock() : bool {
        me := fiber.current();
        mine : var = 0;
        lock(lk) {
            if(held != 0 && owner != null) {
                if((owner as object) == (me as object)) {
                    mine = 1;
                }
            }
        }
        return mine;
    }

    /** number of coroutines waiting for the mutex right now */
    def waiting_count() : var {
        count : var = 0;
        lock(lk) {
            count = waiters.size();
        }
        return count;
    }
}
