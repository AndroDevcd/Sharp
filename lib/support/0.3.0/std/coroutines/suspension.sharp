mod std.coroutines;

import (
    std.io,
    std.io.fiber
)

/**
 * suspension.sharp - the suspension points of a coroutine: delay, yield,
 * ensure_active, and the one function every blocking operation of the library
 * waits through (await_waiter).
 *
 * USAGE
 *     launch({ ->
 *         for(i : var = 0; i < 100; i++) {
 *             crunch(i);
 *             ensure_active();     // stop here if somebody cancelled us
 *         }
 *         delay(250);              // sleep a quarter of a second, wakes at once when cancelled
 *         yield();                 // let the other coroutines of this thread run
 *     });
 *
 * Kotlin equivalents: delay(), yield(), ensureActive(), coroutineContext[Job].
 *
 * WHO IS "THE CURRENT COROUTINE"
 * running_job is fiber-local (the `localized` keyword gives every fiber its
 * own copy): each coroutine fiber stores its job there when it starts, and the
 * in-line scopes (coroutine_scope { }, with_timeout { }, run_blocking { })
 * swap in their own job for as long as their block runs. A fiber that is not a
 * coroutine (the main function outside run_blocking, a plain thread, a slice)
 * has null there: for it the functions below simply never throw.
 */

/** the job of the coroutine or scope the calling fiber is running in; fiber-local */
localized running_job : job?;

/**
 * The job of the coroutine (or in-line scope) this code runs in, or null
 * outside any coroutine. Does not suspend.
 * Kotlin: coroutineContext[Job] / currentCoroutineContext().job
 */
def current_job() : job? {
    return running_job;
}

/** set the current job of this fiber; for the builders and scopes of this module */
def set_current_job(j: job?) {
    running_job = j;
}

/**
 * Throw cancellation_exception if the current coroutine was cancelled, return
 * otherwise. The cheapest cancellation point: put it in long loops that do not
 * suspend. Does not suspend. Outside a coroutine it does nothing.
 * Kotlin: ensureActive()
 */
def ensure_active() {
    j := running_job;
    if(j != null) {
        if(j!!.cancel_flag != 0) {
            j!!.throw_cancelled();
        }
    }
}

/** true unless the current coroutine was cancelled (true outside a coroutine). Kotlin: isActive */
def is_active() : bool {
    j := running_job;
    if(j != null) {
        return j!!.cancel_flag == 0;
    }
    return true;
}

/**
 * Throw the exception a cancelled wait of the current coroutine ends with.
 * For the blocking operations of the library, after await_waiter() returned
 * waiter.CANCELLED.
 */
def throw_cancellation() {
    j := running_job;
    if(j != null) {
        j!!.throw_cancelled();
    }
    throw new cancellation_exception("job was cancelled");
}

/**
 * Sleep for `ms` milliseconds without blocking the thread: other coroutines
 * run meanwhile.
 *
 * SUSPENDS. A cancellation point: throws cancellation_exception at once when
 * the coroutine is (or gets) cancelled, it does not sleep the rest of the time.
 * Outside a coroutine it is a plain sleep of the calling fiber.
 * `ms` of 0 or less only gives other coroutines a turn (like yield()).
 * Kotlin: delay(timeMillis)
 *
 * (std.io.fiber also has a delay(): the bare runtime timer, not cancellable.
 * A file that imports both modules gets this one by writing
 * std.coroutines#delay(ms), or simply by not importing std.io.fiber.)
 */
def delay(ms: var) {
    j := running_job;
    if(j == null) {
        waiter.sleep_raw(ms);
        return;
    }

    ensure_active();
    if(ms <= 0) {
        waiter.yield_fiber();
        ensure_active();
        return;
    }

    // nothing ever resumes this waiter: it ends by its time limit or by a cancellation
    w := new waiter(j!!.lk);
    if(await_waiter(w, ms) == 2) {      // waiter.CANCELLED
        throw_cancellation();
    }
}

/**
 * Let the other coroutines that are ready run, then continue.
 * SUSPENDS for a moment. A cancellation point (checked before and after).
 * Kotlin: yield()
 */
def yield() {
    ensure_active();
    waiter.yield_fiber();
    ensure_active();
}

/**
 * Sleep on `w` until it is claimed - THE way a blocking operation of the
 * library waits, because it makes the wait a cancellation point: the current
 * job remembers the waiter and job.cancel() claims it with waiter.CANCELLED.
 *
 * The waiter must already be published (queued in the resource, under its
 * guard) and the caller must hold no lock.
 *
 * @param ms  a time limit in milliseconds, or a negative number for none
 * @return    the waiter's final state: waiter.RESUMED, CANCELLED, TIMED_OUT or
 *            CLOSED. After CANCELLED or TIMED_OUT the waiter may still be in
 *            its wait_queue: the caller removes it (under the guard) and, for
 *            CANCELLED, calls throw_cancellation().
 *
 * SUSPENDS. Never throws by itself. Outside a coroutine it is a plain
 * park()/park_for().
 * Kotlin equivalent: suspendCancellableCoroutine { }
 */
def await_waiter(w: waiter, ms: var) : var {
    j := running_job;
    if(j == null) {
        if(ms < 0) {
            w.park();
        } else {
            w.park_for(ms);
        }
        return w.state;
    }

    current := j!!;
    if(current.set_waiter(w) == 0) {
        // cancelled before the sleep began: withdraw, unless somebody resumed us first
        guard := w.guard;
        lock(guard) {
            w.abandon(2);       // waiter.CANCELLED
        }
        w.park();               // returns at once; finishes the handshake if another fiber claimed the waiter
        return w.state;
    }

    if(ms < 0) {
        w.park();
    } else {
        w.park_for(ms);
    }

    current.clear_waiter();
    return w.state;
}
