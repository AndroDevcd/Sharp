mod std.coroutines.channels;

import ( std.coroutines )

/**
 * produce<t> - start a coroutine that fills a channel, and get the receiving
 * end of that channel.
 *
 * USAGE
 *     squares := produce<int>.start({ out: send_channel<int> ->
 *         for(i : var = 1; i <= 5; i++) { out.send(i * i); }
 *     });                                              // the channel is closed when the block returns
 *
 *     squares.for_each({ n: int -> println("$n"); });  // 1 4 9 16 25
 *
 *     // with a buffer and a state object (THE CLOSURE RULE: no captured locals)
 *     lines := produce<string>.start(64, file, { out: send_channel<string>, s: object ->
 *         f := s as text_source;
 *         while(f.has_more()) { out.send(f.next_line()); }
 *     });
 *
 * The coroutine is a child of the current coroutine or scope, like launch.
 * The channel is closed when the block ends - normally, by an exception or by
 * a cancellation - so the consumer's loop always ends. When the consumer calls
 * cancel() on the channel the producer's next send() fails and the producer
 * ends quietly. An exception of the block (other than that) fails the
 * producer's job and with it the parent scope, as for launch.
 *
 * The language has no generic functions, so `produce` is a class whose static
 * functions do the work; write the element type once: produce<int>.start(...).
 * `t` must be an object type.
 *
 * Kotlin equivalent: produce { send(x) }.
 *
 * No locking: the fields are written before the coroutine is started and only
 * read by its own fiber.
 */
class produce<t> : coroutine_body {

    private target : channel<t>?;
    private fn0 : (send_channel<t>)();
    private fn1 : (send_channel<t>, object)();
    private arg : object?;

    private produce() {}

    /** Start a producer on a rendezvous channel: each send waits for the consumer. Does not suspend. */
    static def start(block: (send_channel<t>)()) : receive_channel<t> {
        return start(0, block);
    }

    /** Start a producer on a channel of the given capacity (see `channels`). */
    static def start(capacity: var, block: (send_channel<t>)()) : receive_channel<t> {
        task := new produce<t>();
        created := new channel<t>(capacity);
        task.target = created;
        task.fn0 = block;
        launch(task);
        return created;
    }

    /** start() with a state object handed to the block: block(out, state) */
    static def start(capacity: var, state: object, block: (send_channel<t>, object)()) : receive_channel<t> {
        task := new produce<t>();
        created := new channel<t>(capacity);
        task.target = created;
        task.fn1 = block;
        task.arg = state;
        launch(task);
        return created;
    }

    /** runs the block, then closes the channel whatever happened */
    override def run_body() {
        out := target!!;
        sink : send_channel<t> = out;
        error : throwable? = null;

        try {
            if(fn0 != 0) {
                fn0(sink);
            } else {
                fn1(sink, arg!!);
            }
        } catch(gone: closed_channel_exception) {
            // the consumer cancelled the channel: nothing left to produce for, not an error
            if(!out.is_cancelled()) {
                error = gone;
            }
        } catch(problem: throwable) {
            // (not called `t`: that is the type parameter of this class)
            error = problem;
        }

        out.close();
        if(error != null) {
            throw error!!;
        }
    }
}
