mod std.collections;

/**
 * @class bit_set
 *
 * A growable row of bits, each either on (1) or off (0), addressed by an
 * index that starts at 0. It is the compact way to keep a yes/no flag for a
 * large range of small numbers (visited markers, a sieve, sets of ids):
 * 30 flags are packed into every native number.
 *
 *     seen := new bit_set();
 *     seen.set_bit(3);
 *     seen.set_bit(1000);         // grows automatically
 *     seen.test(3);               // 1
 *     seen.test(4);               // 0  (bits that were never touched are off)
 *     seen.cardinality();         // 2  (how many bits are on)
 *
 * Two bit sets can be combined bit by bit with and_with / or_with /
 * xor_with / and_not, which makes a bit_set a fast set of small integers
 * (intersection, union, difference).
 *
 * Storage: an array of native numbers ("words"), 30 bits used in each.
 * (30 rather than 32 or 64 keeps every word a small positive integer, for
 * which the shift and bit operators of the VM are exact.)
 *
 * (`set` is a keyword of the language, hence the names set_bit / clear_bit.)
 */
class bit_set {
    /** words[i] holds the bits i*30 .. i*30 + 29; bit b of the word is index i*30 + b */
    private words : decimal[];

    private static const bits_per_word : decimal = 30;
    /** a word with all 30 bits on: 2^30 - 1 */
    private static const full_word : decimal = 1073741823;

    /** Create an empty bit set (all bits off). */
    bit_set() {
        words = new decimal[2];
    }

    /**
     * Create an empty bit set with room for the bits 0 .. bit_count - 1, so
     * that it does not have to grow while those are used.
     *
     * @throws illegal_argument_exception when bit_count is negative
     */
    bit_set(bit_count: int) {
        if(bit_count.value < 0)
            throw new illegal_argument_exception("bit_set: negative size");
        words = new decimal[word_index(bit_count.value) + 1];
    }

    /**
     * Turn a bit on. O(1) (O(n) when the set has to grow).
     *
     * @throws out_of_bounds_exception when index is negative
     */
    def set_bit(index: int) {
        check_index(index.value);
        w : decimal = word_index(index.value);
        ensure_words(w + 1);
        words[w] = words[w] | (1 << (index.value % bits_per_word));
    }

    /**
     * Turn a bit off. O(1).
     *
     * @throws out_of_bounds_exception when index is negative
     */
    def clear_bit(index: int) {
        check_index(index.value);
        w : decimal = word_index(index.value);
        if(w >= sizeof(words)) return;      // beyond the stored words everything is off already
        words[w] = words[w] & (full_word - (1 << (index.value % bits_per_word)));
    }

    /**
     * Turn a bit on (value != 0) or off (value == 0). O(1).
     *
     * @throws out_of_bounds_exception when index is negative
     */
    def assign(index: int, value: decimal) {
        if(value) set_bit(index);
        else clear_bit(index);
    }

    /**
     * Switch a bit: on becomes off, off becomes on. O(1).
     *
     * @throws out_of_bounds_exception when index is negative
     */
    def flip(index: int) {
        if(test(index)) clear_bit(index);
        else set_bit(index);
    }

    /**
     * Is the bit on? Bits that were never set are off. O(1).
     *
     * @return 1 when the bit is on, 0 when it is off
     * @throws out_of_bounds_exception when index is negative
     */
    def test(index: int) : decimal {
        check_index(index.value);
        w : decimal = word_index(index.value);
        if(w >= sizeof(words)) return 0;
        return (words[w] >> (index.value % bits_per_word)) & 1;
    }

    /**
     * Turn on every bit from `from` up to, but not including, `to`.
     *
     * @throws out_of_bounds_exception when from is negative or from > to
     */
    def set_range(from: int, to: int) {
        check_range(from.value, to.value);
        for(i : decimal = from.value; i < to.value; i++)
            set_bit(i);
    }

    /**
     * Turn off every bit from `from` up to, but not including, `to`.
     *
     * @throws out_of_bounds_exception when from is negative or from > to
     */
    def clear_range(from: int, to: int) {
        check_range(from.value, to.value);
        for(i : decimal = from.value; i < to.value; i++)
            clear_bit(i);
    }

    /** Turn every bit off. O(n). */
    def clear() {
        for(i : decimal = 0; i < sizeof(words); i++)
            words[i] = 0;
    }

    /** Number of bits that are on. O(n) in the number of words. */
    def cardinality() : decimal {
        total : decimal = 0;
        for(i : decimal = 0; i < sizeof(words); i++) {
            word : decimal = words[i];
            // clearing the lowest bit that is on, once per such bit
            while(word != 0) {
                word = word & (word - 1);
                total++;
            }
        }
        return total;
    }

    /** 1 when no bit is on, otherwise 0. O(n) in the number of words. */
    def is_empty() : decimal {
        for(i : decimal = 0; i < sizeof(words); i++) {
            if(words[i] != 0) return 0;
        }
        return 1;
    }

    /**
     * Index of the highest bit that is on, plus one; 0 when no bit is on.
     * (So all bits at index >= length() are off.)
     */
    def length() : decimal {
        for(w : decimal = sizeof(words) - 1; w >= 0; w--) {
            if(words[w] != 0) {
                for(b : decimal = bits_per_word - 1; b >= 0; b--) {
                    if((words[w] >> b) & 1) return w * bits_per_word + b + 1;
                }
            }
        }
        return 0;
    }

    /**
     * Index of the first bit that is ON at or after `from`, or -1 when there
     * is none. Loop over all bits that are on with:
     *
     *     for(i : decimal = bits.next_set_bit(0); i >= 0; i = bits.next_set_bit(i + 1)) ...
     *
     * @throws out_of_bounds_exception when from is negative
     */
    def next_set_bit(from: int) : decimal {
        check_index(from.value);
        limit : decimal = sizeof(words) * bits_per_word;
        i : decimal = from.value;
        while(i < limit) {
            w : decimal = word_index(i);
            if(words[w] == 0) {
                i = (w + 1) * bits_per_word;        // nothing in this word: skip it whole
            } else {
                if((words[w] >> (i % bits_per_word)) & 1) return i;
                i++;
            }
        }
        return -1;
    }

    /**
     * Index of the first bit that is OFF at or after `from`. There always is
     * one, because the bits beyond the stored ones are off.
     *
     * @throws out_of_bounds_exception when from is negative
     */
    def next_clear_bit(from: int) : decimal {
        check_index(from.value);
        limit : decimal = sizeof(words) * bits_per_word;
        i : decimal = from.value;
        while(i < limit) {
            w : decimal = word_index(i);
            if(words[w] == full_word) {
                i = (w + 1) * bits_per_word;        // this word is all on: skip it whole
            } else {
                if(((words[w] >> (i % bits_per_word)) & 1) == 0) return i;
                i++;
            }
        }
        return i;
    }

    /** Keep only the bits that are also on in `other` (intersection). `other` is not changed. */
    def and_with(other: bit_set) {
        for(i : decimal = 0; i < sizeof(words); i++) {
            if(i < sizeof(other.words)) words[i] = words[i] & other.words[i];
            else words[i] = 0;
        }
    }

    /** Also turn on every bit that is on in `other` (union). `other` is not changed. */
    def or_with(other: bit_set) {
        ensure_words(sizeof(other.words));
        for(i : decimal = 0; i < sizeof(other.words); i++)
            words[i] = words[i] | other.words[i];
    }

    /** Switch every bit that is on in `other` (afterwards a bit is on when it was on in exactly one of the two). */
    def xor_with(other: bit_set) {
        ensure_words(sizeof(other.words));
        for(i : decimal = 0; i < sizeof(other.words); i++)
            words[i] = words[i] ^ other.words[i];
    }

    /** Turn off every bit that is on in `other` (difference). `other` is not changed. */
    def and_not(other: bit_set) {
        for(i : decimal = 0; i < sizeof(words); i++) {
            if(i < sizeof(other.words))
                words[i] = words[i] & (full_word - other.words[i]);
        }
    }

    /** 1 when at least one bit is on in both sets, otherwise 0. */
    def intersects(other: bit_set) : decimal {
        for(i : decimal = 0; i < sizeof(words); i++) {
            if(i < sizeof(other.words)) {
                if((words[i] & other.words[i]) != 0) return 1;
            }
        }
        return 0;
    }

    /** 1 when exactly the same bits are on in both sets (their capacities may differ), otherwise 0. */
    def same_bits(other: bit_set) : decimal {
        longest : decimal = sizeof(words);
        if(sizeof(other.words) > longest) longest = sizeof(other.words);

        for(i : decimal = 0; i < longest; i++) {
            mine : decimal = 0;
            theirs : decimal = 0;
            if(i < sizeof(words)) mine = words[i];
            if(i < sizeof(other.words)) theirs = other.words[i];
            if(mine != theirs) return 0;
        }
        return 1;
    }

    /** A new, independent bit set with the same bits on. */
    def copy_of() : bit_set {
        result := new bit_set();
        result.or_with(self);
        return result;
    }

    /** The indexes of all bits that are on, in ascending order. */
    def to_list() : list<int> {
        result := new list<int>();
        for(i : decimal = next_set_bit(0); i >= 0; i = next_set_bit(i + 1))
            result.add(new int(i));
        return result;
    }

    /** The indexes of the bits that are on, like "{1, 5, 64}" ("{}" when none is). */
    def to_string() : string {
        text := "{";
        first : decimal = 1;
        for(i : decimal = next_set_bit(0); i >= 0; i = next_set_bit(i + 1)) {
            if(!first) text = text + ", ";
            first = 0;
            text = text + new int(i);
        }
        return text + "}";
    }

    /** Which word holds the bit: index / 30, rounded down. */
    private def word_index(index: decimal) : decimal {
        return (index - (index % bits_per_word)) / bits_per_word;
    }

    /** Grow the word array (keeping its contents) so that it has at least `wanted` words. */
    private def ensure_words(wanted: decimal) {
        if(wanted <= sizeof(words)) return;

        length : decimal = sizeof(words) * 2;
        if(length < wanted) length = wanted;
        bigger := new decimal[length];
        for(i : decimal = 0; i < sizeof(words); i++)
            bigger[i] = words[i];
        words = bigger;
    }

    private def check_index(index: decimal) {
        if(index < 0) {
            i : int = index;
            throw new out_of_bounds_exception("bit_set: negative index $i");
        }
    }

    private def check_range(from: decimal, to: decimal) {
        if(from < 0 || from > to) {
            a : int = from;
            b : int = to;
            throw new out_of_bounds_exception("bit_set: invalid range $a..$b");
        }
    }
}
