mod std.collections;

/**
 * Generic functions on lists.
 *
 * These are ordinary functions with type parameters (`def name<T>(...)`), so
 * they are called with the types written out:
 *
 *      words := list_of<string>("alpha", "beta");
 *      first := first_or<string>(words, "none");
 *      sizes := transform<string, int>(words) { it.size() };
 *
 * The older helper classes (collections<T>, transforms<T, R>, lists<T>) carry
 * the same kind of function as static members, from before the language had
 * generic functions.
 */

/** a new list holding `a` and `b` */
def list_of<T>(a: T, b: T) : list<T> {
    result := new list<T>();
    result.add(a);
    result.add(b);
    return result;
}

/** the first element of `items`, or `fallback` when the list is empty */
def first_or<T>(items: list<T>, fallback: T) : T {
    if(items.size() == 0) { return fallback; }
    return items.at(0);
}

/**
 * A new list with f(element) for every element of `items`, in order.
 * (`map` in most languages; C++: std::transform.)
 */
def transform<T, R>(items: list<T>, f: (T)(R)) : list<R> {
    result := new list<R>();
    for(i : var = 0; i < items.size(); i++) {
        result.add(f(items.at(i)));
    }
    return result;
}
