mod std.collections;

/**
 * @class var_arrays
 *
 * Static helpers for arrays of NATIVE numbers (var[]): sorting, searching,
 * copying, and the usual aggregates (min, max, sum, average).
 *
 *     samples := new var[4];
 *     samples[0] = 3;  samples[1] = 1.5;  samples[2] = 9;  samples[3] = 2;
 *     var_arrays.sort(samples);                   // 1.5, 2, 3, 9
 *     var_arrays.binary_search(samples, 3);       // 2
 *     var_arrays.sum(samples);                    // 15.5
 *
 * For arrays of objects (int[], string[], ...) use `arrays<T>` instead.
 */
class var_arrays {

    /**
     * Sort an array in place, smallest number first.
     *
     * Bottom-up merge sort (loops only, no recursion): always O(n log n),
     * also for sorted or reversed input. Uses one temporary array of the
     * same length.
     */
    static def sort(items: var[]) {
        n : var = sizeof(items);
        if(n < 2) return;

        source := items;            // the array the current runs are in
        target := new var[n];       // the array they are merged into
        in_items : var = 1;         // is `source` the caller's array?

        for(width : var = 1; width < n; width = width * 2) {
            for(low : var = 0; low < n; low = low + width * 2) {
                middle : var = low + width;
                if(middle > n) middle = n;
                high : var = low + width * 2;
                if(high > n) high = n;

                // merge source[low, middle) and source[middle, high) into target[low, high)
                left : var = low;
                right : var = middle;
                out : var = low;
                while(left < middle && right < high) {
                    if(source[left] <= source[right]) target[out++] = source[left++];
                    else target[out++] = source[right++];
                }
                while(left < middle) target[out++] = source[left++];
                while(right < high) target[out++] = source[right++];
            }

            swap_arrays := source;
            source = target;
            target = swap_arrays;
            in_items = !in_items;
        }

        // after an odd number of passes the result is in the temporary array
        if(!in_items) {
            for(i : var = 0; i < n; i++)
                items[i] = source[i];
        }
    }

    /** Sort an array in place, largest number first. O(n log n). */
    static def sort_descending(items: var[]) {
        sort(items);
        reverse(items);
    }

    /** A sorted copy (smallest first); the array itself is not changed. O(n log n). */
    static def sorted(items: var[]) : var[] {
        result := copy_of(items, sizeof(items));
        sort(result);
        return result;
    }

    /** 1 when no number is smaller than the one in front of it, otherwise 0. O(n). */
    static def is_sorted(items: var[]) : var {
        for(i : var = 1; i < sizeof(items); i++) {
            if(items[i - 1] > items[i]) return 0;
        }
        return 1;
    }

    /**
     * Find `key` in an array that is sorted smallest first, by halving the
     * search range. O(log n).
     *
     * @return the index of an element equal to `key`. When there is none:
     *         -(insertion point) - 1, where the insertion point is the index
     *         the key would have to be inserted at to keep the array sorted.
     *         The result is >= 0 exactly when the key was found.
     */
    static def binary_search(items: var[], key: var) : var {
        low : var = 0;
        high : var = sizeof(items) - 1;
        while(low <= high) {
            middle : var = (low + high) >> 1;
            if(items[middle] == key) return middle;
            if(items[middle] < key) low = middle + 1;
            else high = middle - 1;
        }
        return 0 - low - 1;
    }

    /** Reverse the order of the numbers in place. O(n). */
    static def reverse(items: var[]) {
        low : var = 0;
        high : var = sizeof(items) - 1;
        while(low < high) {
            held : var = items[low];
            items[low] = items[high];
            items[high] = held;
            low++;
            high--;
        }
    }

    /** Store the same number in every slot. O(n). */
    static def fill(items: var[], value: var) {
        for(i : var = 0; i < sizeof(items); i++)
            items[i] = value;
    }

    /**
     * A new array of length `new_length` that starts with the numbers of
     * `items`; a longer length is padded with 0, a shorter one cuts the end
     * off. O(new_length).
     *
     * @throws illegal_argument_exception when new_length is negative
     */
    static def copy_of(items: var[], new_length: var) : var[] {
        if(new_length < 0)
            throw new illegal_argument_exception("var_arrays.copy_of: negative length");

        result := new var[new_length];
        n : var = sizeof(items);
        if(new_length < n) n = new_length;
        for(i : var = 0; i < n; i++)
            result[i] = items[i];
        return result;
    }

    /**
     * A new array with the numbers items[from] .. items[to - 1].
     *
     * @throws out_of_bounds_exception when from < 0, to > length or from > to
     */
    static def copy_of_range(items: var[], from: var, to: var) : var[] {
        if(from < 0 || to > sizeof(items) || from > to)
            throw new out_of_bounds_exception("var_arrays.copy_of_range: the range is outside the array");

        result := new var[to - from];
        for(i : var = from; i < to; i++)
            result[i - from] = items[i];
        return result;
    }

    /** Index of the first number equal to `value`, or -1. O(n). */
    static def index_of(items: var[], value: var) : var {
        for(i : var = 0; i < sizeof(items); i++) {
            if(items[i] == value) return i;
        }
        return -1;
    }

    /** 1 when a number equals `value`, otherwise 0. O(n). */
    static def contains(items: var[], value: var) : var {
        return index_of(items, value) >= 0;
    }

    /**
     * The smallest number. O(n).
     *
     * @throws illegal_argument_exception when the array is empty
     */
    static def min(items: var[]) : var {
        if(sizeof(items) == 0)
            throw new illegal_argument_exception("var_arrays.min: the array is empty");
        best : var = items[0];
        for(i : var = 1; i < sizeof(items); i++) {
            if(items[i] < best) best = items[i];
        }
        return best;
    }

    /**
     * The largest number. O(n).
     *
     * @throws illegal_argument_exception when the array is empty
     */
    static def max(items: var[]) : var {
        if(sizeof(items) == 0)
            throw new illegal_argument_exception("var_arrays.max: the array is empty");
        best : var = items[0];
        for(i : var = 1; i < sizeof(items); i++) {
            if(items[i] > best) best = items[i];
        }
        return best;
    }

    /** All numbers added up (0 for an empty array). O(n). */
    static def sum(items: var[]) : var {
        total : var = 0;
        for(i : var = 0; i < sizeof(items); i++)
            total += items[i];
        return total;
    }

    /**
     * The arithmetic mean: sum / length. O(n).
     *
     * @throws illegal_argument_exception when the array is empty
     */
    static def average(items: var[]) : var {
        if(sizeof(items) == 0)
            throw new illegal_argument_exception("var_arrays.average: the array is empty");
        return sum(items) / sizeof(items);
    }

    /** 1 when both arrays have the same length and the same number at every position, otherwise 0. O(n). */
    static def equals(first: var[], second: var[]) : var {
        if(sizeof(first) != sizeof(second)) return 0;
        for(i : var = 0; i < sizeof(first); i++) {
            if(first[i] != second[i]) return 0;
        }
        return 1;
    }

    /** A new `list` with every number boxed as a `double`, in the same order. O(n). */
    static def to_list(items: var[]) : list<double> {
        result := new list<double>();
        for(i : var = 0; i < sizeof(items); i++)
            result.add(new double(items[i]));
        return result;
    }
}
