mod backend.postprocessor.checks;

import (
    std.io,
    frontend.lexer,
    frontend.syntax.tree,
    frontend.diagnostics,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system
)

/**
 * WHAT A DECLARATION IS WHEN IT DOES NOT SAY
 *
 *      class point { x : decimal; }        nobody wrote `public`: who may use point, and x?
 *      count : decimal = 0;                a global: does it belong to an object?
 *
 * The preprocessor recorded the modifier words that are WRITTEN. This step
 * adds the ones the language implies, so that every later stage can simply
 * ask `declared.has(FLAG_PUBLIC)` or `has(FLAG_STATIC)` and get the answer
 * that holds. The rules are the C++ compiler's (the file each comes from is
 * named):
 *
 *      class, interface, enum      public unless private / protected is written
 *                                  an enum is also `ext`: only the compiler makes its objects
 *                                                                      (class_preprocessor, enum_preprocessor)
 *      field                       public unless ...                   (field_preprocessor)
 *      global variable             ... and static: it belongs to no object
 *      `localized` variable        static (one per thread, never per object)
 *      enum value                  public static const excuse          (enum_preprocessor)
 *      function, constructor       public unless ...                   (function_processor)
 *      global / native function    ... and static
 *      alias                       in a module: public. In a class: PRIVATE. Always static
 *                                                                      (alias_preprocessor)
 *      getter, setter              with no words of its own: exactly its field's.
 *                                  With words: public unless ...       (field_processor)
 *
 * [differs from the C++ compiler] Its function_processor adds `public` to
 * EVERY function, private ones too - which is why it never refuses a call
 * of a private function. Here a private function is private; calling it
 * from outside is the warning W1022 of the calls stage (backend.md, D8).
 *
 * Run before any generic instance is made: the members of an instance are
 * copies of the blueprint's and take its flags as they are.
 */
def apply_default_access(prog: sharp_program) {
    for(i : _int64 = 0; i < prog.module_list.size(); i++) {
        module := prog.module_list.at(i);
        for(j : _int64 = 0; j < module.fields.size(); j++) { default_field_flags(module.fields.at(j)); }
        for(j : _int64 = 0; j < module.functions.size(); j++) { default_function_flags(module.functions.at(j)); }
        for(j : _int64 = 0; j < module.aliases.size(); j++) { default_alias_flags(module.aliases.at(j)); }
    }

    for(i : _int64 = 0; i < prog.all_classes.size(); i++) {
        declared := prog.all_classes.at(i);
        declared.flags = with_default_access(declared.flags, FLAG_PUBLIC);
        if(declared.kind == D_ENUM) { declared.flags = declared.flags | FLAG_EXT; }

        for(j : _int64 = 0; j < declared.enum_values.size(); j++) {
            value := declared.enum_values.at(j);
            value.flags = value.flags | FLAG_PUBLIC | FLAG_STATIC | FLAG_CONST | FLAG_EXCUSE;
        }
        for(j : _int64 = 0; j < declared.fields.size(); j++) { default_field_flags(declared.fields.at(j)); }
        for(j : _int64 = 0; j < declared.functions.size(); j++) { default_function_flags(declared.functions.at(j)); }
        for(j : _int64 = 0; j < declared.constructors.size(); j++) { default_function_flags(declared.constructors.at(j)); }
        for(j : _int64 = 0; j < declared.aliases.size(); j++) { default_alias_flags(declared.aliases.at(j)); }
    }
}

/** the flags with `fallback` added when none of public / private / protected is among them */
def with_default_access(flags: _int64, fallback: _int64) : _int64 {
    if((flags & (FLAG_PUBLIC | FLAG_PRIVATE | FLAG_PROTECTED)) == 0) { return flags | fallback; }
    return flags;
}

/** a field: public unless it says otherwise; a global or `localized` one is static */
def default_field_flags(field: sharp_field) {
    field.flags = with_default_access(field.flags, FLAG_PUBLIC);
    if(field.owner == null || field.has(FLAG_LOCALIZED)) { field.flags = field.flags | FLAG_STATIC; }

    if(field.getter != null) { default_accessor_flags(field.getter!!, field); }
    if(field.setter != null) { default_accessor_flags(field.setter!!, field); }
}

/** has this declaration modifier words of its own in the source? */
def has_written_modifiers(declared: sharp_declaration) : _int64 {
    return declared.unit.parsed!!.tree.child_of_kind(declared.node, N_MODIFIERS) >= 0;
}

/** a getter or setter: its own words if it has any (public unless ...), else exactly its field's */
def default_accessor_flags(accessor: sharp_function, field: sharp_field) {
    if(has_written_modifiers(accessor)) {
        accessor.flags = with_default_access(accessor.flags, FLAG_PUBLIC);
    } else {
        accessor.flags = field.flags - (field.flags & FLAG_MUTATED);
    }
}

/** a function or constructor: public unless it says otherwise; a global or native function is static */
def default_function_flags(function: sharp_function) {
    function.flags = with_default_access(function.flags, FLAG_PUBLIC);
    // (an extension function is a member of a class even when it is not attached to one yet)
    if(function.kind == D_FUNCTION && ((function.owner == null && function.extends == null) || function.has(FLAG_NATIVE))) {
        function.flags = function.flags | FLAG_STATIC;
    }
}

/** an alias: public in a module, private in a class; always static */
def default_alias_flags(named: sharp_alias) {
    if(named.owner == null) { named.flags = with_default_access(named.flags, FLAG_PUBLIC); }
    else { named.flags = with_default_access(named.flags, FLAG_PRIVATE); }
    named.flags = named.flags | FLAG_STATIC;
}
