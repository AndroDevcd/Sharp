mod backend.postprocessor.checks;

import (
    std.io,
    frontend.lexer,
    frontend.syntax.tree,
    frontend.diagnostics,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system
)

/**
 * THE WORDS IN FRONT OF A DECLARATION
 * (the C++ compiler: parse_access_flags in backend/astparser/ast_parser.cpp)
 *
 *      public static const limit : decimal = 10;
 *      ^^^^^^ ^^^^^^ ^^^^^   "modifiers" - the parser took any of them, in any order, anywhere
 *
 * Which words a declaration may have depends on what it is:
 *
 *      class, interface, enum      public private protected local stable ext
 *      field, global variable      public private protected static excuse local const
 *      function                    public private protected override local static native
 *      constructor                 public private protected
 *      init                        static
 *      getter, setter              public private protected local static
 *      alias                       public private protected local static   (access words: W1040, see below)
 *      local variable              excuse const
 *
 *      E0360   a word this kind of declaration cannot have     override class a { }
 *      E0361   the same word twice                             static static x : int;
 *      E0362   the words are in the wrong order                static public x : int;
 *      E0363   `local` on a member of a class                  (it means "this file only", for module-level things)
 *      E0364   two of public / private / protected
 *      W1007   `static` where everything is static anyway      a global, an alias, a native function
 *      W1009   `local` together with public / private / protected: `local` wins
 *
 * THE ORDER is the C++ compiler's: access (public private protected), then
 * override, excuse, local, static, const, stable, ext, native. Its test is
 * looser than "strictly in this order" (it lets `public const static`
 * through), and since such a program compiles and runs today, the test here
 * is exactly as loose: see is_in_accepted_order.
 *
 * One declaration gets one message about its modifiers: the first of the
 * mistakes above that applies.
 *
 * The tree is a flat array, so "every list of modifiers in the program" is
 * one loop over each file's nodes.
 */
def check_modifiers(prog: sharp_program, problems: list<diagnostic>) {
    for(i : _int64 = 0; i < prog.files.size(); i++) {
        unit := prog.files.at(i).unit;
        tree : syntax_tree = unit.parsed!!.tree;
        kinds : _uint8[] = tree.kinds!!;

        for(node : _int64 = 0; node < tree.count; node++) {
            if(kinds[node] == N_MODIFIERS) {
                check_modifier_list(unit, node, problems);
            }
        }
    }
}

/** is the declaration `node` written directly in a class body (or in a `mutate` block, which adds to one)? */
def is_written_in_class(tree: syntax_tree, node: _int64) : _int64 {
    up : _int64 = tree.parents!![node];
    return up >= 0 && tree.kinds!![up] == N_MEMBERS;
}

/** is `node` a declaration of a module (written at the top of a file)? */
def is_written_in_module(tree: syntax_tree, node: _int64) : _int64 {
    up : _int64 = tree.parents!![node];
    return up >= 0 && tree.kinds!![up] == N_FILE;
}

/** one list of modifier words: is each allowed on this kind of declaration, written once, and in the accepted order? */
def check_modifier_list(unit: source_unit, modifiers: _int64, problems: list<diagnostic>) {
    p : parse_state = unit.parsed!!;
    tree : syntax_tree = p.tree;

    declaration : _int64 = tree.parents!![modifiers];
    if(declaration < 0) { return; }
    kind : _int64 = tree.kinds!![declaration];

    // ---- what this kind of declaration may have
    access : _int64 = FLAG_PUBLIC | FLAG_PRIVATE | FLAG_PROTECTED;
    allowed : _int64 = 0;
    what : string = "";
    in_class : _int64 = is_written_in_class(tree, declaration);

    if(kind == N_CLASS) { allowed = access | FLAG_LOCAL | FLAG_STABLE | FLAG_EXT; what = "a class"; }
    else if(kind == N_INTERFACE) { allowed = access | FLAG_LOCAL | FLAG_STABLE | FLAG_EXT; what = "an interface"; }
    else if(kind == N_ENUM) { allowed = access | FLAG_LOCAL | FLAG_STABLE | FLAG_EXT; what = "an enum"; }
    else if(kind == N_FUNCTION) { allowed = access | FLAG_OVERRIDE | FLAG_LOCAL | FLAG_STATIC | FLAG_NATIVE; what = "a function"; }
    else if(kind == N_CONSTRUCTOR) { allowed = access; what = "a constructor"; }
    else if(kind == N_INIT) { allowed = FLAG_STATIC; what = "an init block"; }
    else if(kind == N_GETTER) { allowed = access | FLAG_LOCAL | FLAG_STATIC; what = "a getter"; in_class = 0; }
    else if(kind == N_SETTER) { allowed = access | FLAG_LOCAL | FLAG_STATIC; what = "a setter"; in_class = 0; }
    else if(kind == N_ALIAS) {
        if(!in_class && !is_written_in_module(tree, declaration)) { return; }   // an alias in a block: the statement stages
        allowed = access | FLAG_LOCAL | FLAG_STATIC; what = "an alias";
    }
    else if(kind == N_VARIABLE) {
        if(in_class) { allowed = access | FLAG_STATIC | FLAG_EXCUSE | FLAG_LOCAL | FLAG_CONST; what = "a field"; }
        else if(is_written_in_module(tree, declaration)) {
            allowed = access | FLAG_STATIC | FLAG_EXCUSE | FLAG_LOCAL | FLAG_CONST; what = "a global variable";
        }
        else { allowed = FLAG_EXCUSE | FLAG_CONST; what = "a local variable"; }
    }
    else { return; }

    // ---- the words, in the order written
    seen : _int64 = 0;
    count : _int64 = 0;
    word : _int64 = tree.first_child!![modifiers];
    while(word >= 0) {
        flag : _int64 = flag_of_keyword(p.kinds[tree.tokens!![word]]);
        text := node_text(unit, word);
        count++;

        if((allowed & flag) == 0) {
            report_modifier_not_allowed(unit, word, text, flag, what, kind, allowed, problems);
            return;
        }
        if((seen & flag) != 0) {
            problems.add(error_at_node("E0361", "`" + text + "` is written twice", unit, word)
                .with_label("said already")
                .with_help("remove one of them"));
            return;
        }
        if((flag & access) != 0 && (seen & access) != 0) {
            problems.add(error_at_node("E0364", "`" + text + "` and `" + flag_words(seen & access)
                                       + "` cannot both apply", unit, word)
                .with_label("a second answer to \"who may use this?\"")
                .with_note("`public`: everybody. `protected`: the class, the classes below it and its module. `private`: the class only")
                .with_help("keep one of them"));
            return;
        }
        if(flag == FLAG_LOCAL && in_class) {
            problems.add(error_at_node("E0363", "`local` cannot be used on a member of a class", unit, word)
                .with_label("`local` means \"visible in this file only\"")
                .with_note("it is for what a module declares: classes, global variables and functions. A member of a class is hidden with `private` or `protected`")
                .with_help("write `private` instead, or mark the class itself `local`"));
            return;
        }
        seen = seen | flag;
        word = tree.next_sibling!![word];
    }

    if(count > 1 && !is_in_accepted_order(unit, modifiers)) {
        problems.add(error_at_node("E0362", "the modifiers of this declaration are in the wrong order", unit, tree.first_child!![modifiers])
            .with_label("written as `" + words_as_written(unit, modifiers) + "`")
            .with_note("the order is: public / private / protected, override, excuse, local, static, const, stable, ext, native")
            .with_help("write:  " + flag_words(seen)));
        return;
    }

    // ---- the things that are allowed but say nothing
    if(kind == N_ALIAS && (seen & (access | FLAG_LOCAL)) != 0) {
        report_alias_access_word(unit, modifiers, seen & (access | FLAG_LOCAL), in_class, problems);
    } else if((seen & FLAG_LOCAL) != 0 && (seen & access) != 0) {
        problems.add(error_at_node("W1009", "`local` already decides who may use this; `" + flag_words(seen & access)
                                   + "` has no effect", unit, tree.first_child!![modifiers])
            .with_label("`local` (this file only) wins over `" + flag_words(seen & access) + "`")
            .with_help("remove `" + flag_words(seen & access) + "`, or remove `local`")
            .as_warning());
    }
    if((seen & FLAG_STATIC) != 0) {
        why : string = "";
        if(kind == N_ALIAS) { why = "an alias is a name for a type; it never belongs to one object"; }
        else if(kind == N_FUNCTION && (seen & FLAG_NATIVE) != 0) { why = "a `native` function is always static"; }
        else if((kind == N_FUNCTION || kind == N_VARIABLE) && is_written_in_module(tree, declaration)) {
            why = "what is declared outside any class belongs to no object; it is static already";
        }
        if(sizeof(why.data) > 0) {
            problems.add(error_at_node("W1007", "`static` says nothing here", unit, static_word_of(unit, modifiers))
                .with_label(why)
                .with_help("remove `static`")
                .as_warning());
        }
    }
}

/**
 * W1040: `private alias string as text;` - the word is accepted and ignored.
 * Who may name an alias follows from where it is declared: in a module,
 * everybody; in a class, that class only. (The C++ parser drops the words;
 * declare.sharp `alias_flags` gives the alias its real access.) The warning
 * says what the alias really is, so `public alias` in a class does not
 * surprise anybody when a use outside the class is refused.
 */
def report_alias_access_word(unit: source_unit, modifiers: _int64, written: _int64, in_class: _int64,
                             problems: list<diagnostic>) {
    words := flag_words(written);
    d := error_at_node("W1040", "`" + words + "` has no effect on an alias", unit, unit.parsed!!.tree.first_child!![modifiers])
        .with_label("ignored");
    if(in_class) {
        d.with_note("an alias declared in a class is always private: only that class may name it");
        d.with_help("remove `" + words + "`; to name the type from outside the class, declare the alias outside the class, or write the type it stands for");
    } else {
        d.with_note("an alias declared outside any class is always public: every module that imports this one may name it");
        d.with_help("remove `" + words + "`; to keep the name to one class, declare the alias inside that class");
    }
    problems.add(d.as_warning());
}

/** "public static": the modifier words for a flags number, without the space flags_text() ends with */
def flag_words(flags: _int64) : string {
    text := flags_text(flags);
    chars : _int8[]? = text.data;
    words := new string_builder("");
    for(i : _int64 = 0; i + 1 < sizeof(chars); i++) {
        words.append(chars!![i]);
    }
    return words.build();
}

/** the N_MODIFIER node of the word `static` in a list */
def static_word_of(unit: source_unit, modifiers: _int64) : _int64 {
    p : parse_state = unit.parsed!!;
    tree : syntax_tree = p.tree;
    word : _int64 = tree.first_child!![modifiers];
    while(word >= 0) {
        if(p.kinds[tree.tokens!![word]] == K_STATIC) { return word; }
        word = tree.next_sibling!![word];
    }
    return modifiers;
}

/** the modifier words as they stand in the source: "static public" */
def words_as_written(unit: source_unit, modifiers: _int64) : string {
    tree : syntax_tree = unit.parsed!!.tree;
    text := new string_builder("");
    word : _int64 = tree.first_child!![modifiers];
    while(word >= 0) {
        if(text.size() > 0) { text.append(" "); }
        text.append(node_text(unit, word));
        word = tree.next_sibling!![word];
    }
    return text.build();
}

/**
 * The place of a modifier in the order of the C++ compiler:
 * public private protected override excuse local static const stable (unstable) ext native
 */
def order_position(flag: _int64) : _int64 {
    if(flag == FLAG_PUBLIC) { return 0; }
    if(flag == FLAG_PRIVATE) { return 1; }
    if(flag == FLAG_PROTECTED) { return 2; }
    if(flag == FLAG_OVERRIDE) { return 3; }
    if(flag == FLAG_EXCUSE) { return 4; }
    if(flag == FLAG_LOCAL) { return 5; }
    if(flag == FLAG_STATIC) { return 6; }
    if(flag == FLAG_CONST) { return 7; }
    if(flag == FLAG_STABLE) { return 8; }
    if(flag == FLAG_EXT) { return 10; }
    if(flag == FLAG_NATIVE) { return 11; }
    return 12;
}

/**
 * The order test of the C++ compiler, as it is. The FIRST word fixes a
 * starting point in the order (an access word: `override` onwards; `static`:
 * `const` onwards ...). The k-th word after it must then stand at that point
 * plus (k - 1) or later - which is less than "each word after the one before
 * it": `public const static` passes, `static public` does not.
 */
def is_in_accepted_order(unit: source_unit, modifiers: _int64) : _int64 {
    p : parse_state = unit.parsed!!;
    tree : syntax_tree = p.tree;

    word : _int64 = tree.first_child!![modifiers];
    first : _int64 = order_position(flag_of_keyword(p.kinds[tree.tokens!![word]]));
    start : _int64 = first + 1;
    if(first <= 2) { start = 3; }       // any access word: what follows starts at `override`

    k : _int64 = 1;
    word = tree.next_sibling!![word];
    while(word >= 0) {
        if(k > 8) { return 0; }
        earliest : _int64 = start + k - 1;
        if(k >= 5) { earliest = start + k; }
        if(order_position(flag_of_keyword(p.kinds[tree.tokens!![word]])) < earliest) { return 0; }
        k++;
        word = tree.next_sibling!![word];
    }
    return 1;
}

/** E0360, with what the word is for and what could be meant */
def report_modifier_not_allowed(unit: source_unit, word: _int64, text: string, flag: _int64, what: string, kind: _int64,
                                allowed: _int64, problems: list<diagnostic>) {
    d := error_at_node("E0360", "`" + text + "` cannot be used on " + what, unit, word)
        .with_label("not a modifier of " + what);

    if(kind == N_CONSTRUCTOR) {
        d.with_note("a constructor always belongs to its class and always makes a new object; it cannot be static, native or overridden");
        if(flag == FLAG_STATIC) { d.with_help("for a function that makes objects and is called on the class, write:  static def create(...) : the_class { return new the_class(...); }"); }
    } else if(kind == N_INIT) {
        d.with_note("an init block is not called by anyone, so nothing can be hidden or overridden: it runs when an object is made, or for `static init` when the class is first used");
    } else if(flag == FLAG_OVERRIDE) {
        d.with_note("`override` is for a function that defines a function declared without a body in a base class or interface");
    } else if(flag == FLAG_NATIVE) {
        d.with_note("`native` marks a function the runtime provides");
    } else if(flag == FLAG_CONST && kind == N_FUNCTION) {
        d.with_note("`const` is for variables: one that is given its value once");
    } else if(flag == FLAG_STABLE || flag == FLAG_EXT) {
        d.with_note("`stable` (cannot be changed by `mutate`) and `ext` (objects are made by the compiler only) are for classes");
    } else if(flag == FLAG_STATIC && (kind == N_CLASS || kind == N_INTERFACE || kind == N_ENUM)) {
        d.with_note("a class declared inside another class never needs an object of the outer one; there is nothing for `static` to change");
    } else if(flag == FLAG_EXCUSE) {
        d.with_note("`excuse` is for a variable: \"do not check that this is given a value\"");
    }

    if(allowed != 0) {
        d.with_help(what + " can have:  " + flag_words(allowed));
    }
    d.with_help("remove `" + text + "`");
    problems.add(d);
}
