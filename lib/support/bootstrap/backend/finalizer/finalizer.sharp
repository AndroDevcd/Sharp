mod backend.finalizer;

import (
    std.io,
    platform.kernel,
    frontend.diagnostics,
    backend.types.declarations,
    backend.types.program,
    backend.types.type_system,
    backend.finalizer.ir,
    backend.finalizer.layout,
    backend.finalizer.generation,
    backend.finalizer.bytecode,
    backend.finalizer.verify,
    backend.finalizer.output,
    backend.finalizer.listing,
    backend.finalizer.obfuscation,
    backend.optimizer
)

/**
 * CODE GENERATION: the analysed program becomes an executable the VM runs
 * (doc/codegen.md; this is the front door of backend/finalizer)
 *
 *      analysed_program
 *         |  1. layout       what is kept; addresses of classes, functions, field slots;
 *         |                  the function-type table; what the generator adds   (layout/)
 *         |  2. generation   every kept function: typed tree -> IR                (generation/)
 *         |  2a. optimizer   only with -O: the IR made faster (backend/optimizer)
 *         |  3. bytecode     IR -> VM words; line table; frame numbers            (bytecode/)
 *         |  4. verify       every function's words checked                       (verify/)
 *         |  5. write        the file of codegen.md section 3                     (output/)
 *         v
 *      the executable          (and with -listing a readable text of it: listing/)
 *
 * Each step is one pass over the whole program and has its entry on the
 * `time:` line. A program reaches this only when analysis ended with no error
 * (`analysed.errors == 0`). Every node of the typed tree has code since stage
 * 4 (codegen.md 13.4); a node the generator still meets without a lowering is
 * a bug of the compiler, reported and never written wrongly:
 *
 *      error[E0970]: internal error: code generation has no code for <what> at <file>:<line>
 *
 * and no file is written.
 *
 * The codes of code generation (codegen.md 13; reserved E0970 - E0979):
 *
 *      E0970   internal error: the verifier refused the code of a function, or an
 *              IR instruction has no VM sequence
 *      E0971   an `obfuscate` block asks for a name to be renamed that the VM finds by name
 *      E0972   a function is too large for the encoding of the VM's instructions
 *      E0975   an executable needs a `main` function
 *      E0978   a function's body nests deeper than the generator can follow (a limit)
 *
 * The packages of code generation:
 *
 *      finalizer.sharp     this front door: generate_program, the options of the command line
 *      layout/             numbers and names for everything
 *      ir/                 the intermediate form
 *      generation/         typed tree -> IR
 *      bytecode/           IR -> VM instructions
 *      verify/             the bytecode verifier
 *      output/             the executable file
 *      listing/            -listing: the file as readable text
 *      obfuscation/        -obf and `obfuscate { }`: the names in the file replaced (E0971)
 *
 *      C++ comparison: `finalize_compilation` in finalizer/finalizer.cpp:
 *      `optimize()` (mark what is used, assign addresses), then `generate()`.
 */

/** what the command line asks of code generation (executable.sharp fills it in) */
class generation_request {
    output : string = "";               // -o: where the executable goes
    application : string = "";          // the name in the manifest (the C++ compiler writes the -o text)
    version : string = "1.0";           // -v
    target : _int64 = 2;                // -target (2: alpha, the C++ default)
    debug : _int64 = 0;                 // -dbg: the debug flag of the manifest, and the source text in the meta section
    eager : _int64 = 0;                 // -eager: keep everything analysis has, reached or not
    listing : _int64 = 0;               // -listing (or -d): write <output>.listing
    show_ir : _int64 = 0;               // -ir: print the IR of the functions of the last file given
    inspected_file : string = "";       // ... that file: the program's last, never a library file (empty: the last in file_order)
    rename_names : _int64 = 0;          // -obf: rename everything the `obfuscate` blocks do not keep (6.17)
    file_order : list<string>;          // the source files, as the command line gave them
    max_errors : _int64 = 10;           // how many functions without code (E0970) to show before "and n more"
    optimizer : optimizer_settings;     // -O, -n<name>, -Oreport (backend/optimizer)

    generation_request() {
        file_order = new list<string>();
        optimizer = new optimizer_settings();
    }
}

/** what code generation did: the messages, and the numbers for the summary and the `time:` line */
class generation_result {
    problems : list<diagnostic>;
    plain_errors : list<string>;        // messages without a place in the source (E0975, E0970 ...)
    written : _int64 = 0;               // 1: the file was written
    functions : _int64 = 0;
    classes : _int64 = 0;
    not_generated : _int64 = 0;         // functions with a node the generator has no code for (E0970)
    too_deep : _int64 = 0;              // functions whose body nests deeper than the generator can follow (E0978)
    renamed : _int64 = 0;               // names obfuscation replaced (listed in <output>.names)
    layout_ms : decimal = 0;
    obfuscation_ms : decimal = 0;
    generation_ms : decimal = 0;
    optimizer_ms : decimal = 0;
    bytecode_ms : decimal = 0;
    optimized : optimizer_report?;      // what the optimizer did (with -O)
    write_ms : decimal = 0;

    generation_result() {
        problems = new list<diagnostic>();
        plain_errors = new list<string>();
    }

    /** how many messages code generation has: with a place in the source, and without */
    def error_count() : _int64 {
        return (problems.size().value as _int64) + (plain_errors.size().value as _int64);
    }
}

/** the time now, in milliseconds (for the `time:` line) */
def clock_ms() : decimal {
    return vm.time_in_nanoseconds().value / 1000000;
}

/** generate the executable for an analysed program without errors */
def generate_program(analysed: analysed_program, request: generation_request) : generation_result {
    result := new generation_result();

    // ---- where the VM starts: platform.srt_init, which sets the program up and calls `main`
    if(analysed.main_function == null || analysed.startup_function == null) {
        report_no_main(analysed, result);
        return result;
    }

    // ---- 1. layout
    started : decimal = clock_ms();
    layout := lay_out_program(analysed, request.eager, request.file_order);
    result.layout_ms = clock_ms() - started;
    result.functions = layout.functions.size().value as _int64;
    result.classes = layout.classes.size().value as _int64;
    if(layout.entry == null) {
        result.plain_errors.add("error[E0970]: internal error: the function the VM starts at was not laid out\n");
        return result;
    }
    // the names the file will carry, when -obf or an `obfuscate` block asks for new ones (obfuscation/)
    started = clock_ms();
    renamed := rename_for_obfuscation(layout, request.rename_names);
    result.obfuscation_ms = clock_ms() - started;
    if(renamed.problems.size() > 0) {
        for(i : _int64 = 0; i < renamed.problems.size(); i++) { result.problems.add(renamed.problems.at(i)); }
        return result;
    }

    // ---- 2. generation
    started = clock_ms();
    shown : _int64 = 0;
    for(i : _int64 = 0; i < layout.functions.size(); i++) {
        made := layout.functions.at(i);
        problem := generate_function(made, layout);
        if(problem == null) { continue; }
        if(problem!!.is_too_deep == 1) {
            // a limit of this compiler, not a missing lowering
            result.too_deep++;
            result.problems.add(nested_too_deeply_message(made, problem!!));
            continue;
        }
        result.not_generated++;
        if(shown < request.max_errors) {
            result.problems.add(not_generated_message(made, problem!!));
            shown++;
        }
    }
    result.generation_ms = clock_ms() - started;
    if(result.not_generated == 0 && result.too_deep == 0 && request.optimizer.on == 1) {
        // ---- 2a. the optimizer (-O): the IR in, better IR out
        started = clock_ms();
        result.optimized = optimize_program(layout, request.optimizer);
        result.optimizer_ms = clock_ms() - started;
    }
    // (-ir shows the IR the bytecode step gets: after the optimizer, with -O)
    if(request.show_ir == 1 && request.file_order.size() > 0) {
        shown_file : string = request.inspected_file;
        if(sizeof(shown_file.data) == 0) { shown_file = request.file_order.at(request.file_order.size().value - 1); }
        print_ir_of_file(layout, shown_file);
    }
    if(result.not_generated > 0) {
        if(result.not_generated > shown) {
            result.plain_errors.add("... and " + (result.not_generated - shown) + " more function(s) code generation has no code for\n");
        }
        return result;
    }
    if(result.too_deep > 0) { return result; }

    // ---- 3. bytecode, 4. verify
    started = clock_ms();
    for(i : _int64 = 0; i < layout.functions.size(); i++) {
        made := layout.functions.at(i);
        made.code = lower_function(made, layout.constants);
        if(made.selection_problem != null) {
            result.plain_errors.add("error[E0970]: internal error: the code of `" + made.full_name + "` could not be made: "
                + made.selection_problem!! + "\n  = note: this is a bug of the compiler, not of the program; -ir shows the IR\n");
            continue;
        }
        if(made.encoding_problem != null) {
            // (a number in an `asm` block wider than 32 bits is refused by analysis, at the number: E0926)
            result.plain_errors.add("error[E0972]: the code of `" + made.full_name + "` does not fit the VM's instructions: "
                + made.encoding_problem!! + "\n"
                + "  = note: each instruction has fields of fixed width; a function with more local variables, constants or code than they can number cannot be written\n"
                + "  = help: split `" + made.full_name + "` into smaller functions\n");
            continue;
        }
        refusal := verify_function(made, layout);
        if(refusal != null) {
            result.plain_errors.add("error[E0970]: internal error: the code of `" + made.full_name + "` is wrong: "
                + refusal!! + "\n  = note: this is a bug of the compiler, not of the program; -listing shows the code\n");
        }
    }
    result.bytecode_ms = clock_ms() - started;
    if(result.optimized != null) {
        words : _int64 = 0;
        for(i : _int64 = 0; i < layout.functions.size(); i++) {
            made := layout.functions.at(i);
            if(made.code != null) { words = words + made.code!!.words.count; }
        }
        result.optimized!!.words = words;
    }
    if(result.error_count() > 0) {
        // the listing shows the code the verifier refused (for the compiler's own bugs, E0970)
        if(request.listing == 1) { write_listing(layout, request.output + ".listing"); }
        return result;
    }

    // ---- 5. the file
    started = clock_ms();
    options := new executable_options();
    options.application = request.application;
    options.version = request.version;
    options.target = request.target;
    options.debug = request.debug;
    layout.application_id = application_id_of(request.application, layout.functions.size().value as _int64);
    problem := write_executable(layout, options, request.output);
    if(sizeof(problem.data) > 0) {
        result.plain_errors.add("error: " + problem + "\n");
        return result;
    }
    if(request.listing == 1) {
        listing_problem := write_listing(layout, request.output + ".listing");
        if(sizeof(listing_problem.data) > 0) { result.plain_errors.add("error: " + listing_problem + "\n"); }
    }
    if(renamed.names.renamed > 0) {
        map_problem := write_name_map(renamed.names, request.output + ".names");
        if(sizeof(map_problem.data) > 0) { result.plain_errors.add("error: " + map_problem + "\n"); }
        result.renamed = renamed.names.renamed;
    }
    result.write_ms = clock_ms() - started;
    result.written = 1;
    return result;
}

/**
 * E0975: no `main` the program can start at. When the program HAS global
 * functions called `main`, each of a form the runtime cannot call (W1015 was
 * given for it), the error points at the first one and says so - "there is
 * no main" would be wrong. Otherwise it has no place in the source: there is
 * nothing to point at.
 *
 * The help names `-c` for a file that is not meant to be a program (a
 * library file): without `-o` the compiler still writes `out`.
 */
def report_no_main(analysed: analysed_program, result: generation_result) {
    for(m : _int64 = 0; m < analysed.modules.size(); m++) {
        functions := analysed.modules.at(m).functions;
        for(i : _int64 = 0; i < functions.size(); i++) {
            candidate := functions.at(i);
            if(candidate.owner != null || candidate.name != "main") { continue; }
            d := error_at_node("E0975", "this program has no `main` it can start at: this `main` has a form the runtime cannot call",
                               candidate.unit, candidate.node);
            d.with_label("not one of the four forms of `main` (warning W1015 above)");
            d.with_note("the runtime starts a program by calling `main` in one of these forms: `def main()`, `def main() : int`, `def main(args: string[])`, `def main(args: string[]) : int`");
            d.with_help("give it one of those forms, or compile without making an executable: `-c`");
            result.problems.add(d);
            return;
        }
    }
    result.plain_errors.add("error[E0975]: this program has no `main` function, and an executable starts there\n"
        + "  = note: the VM starts every program at platform.srt_init, which sets the program up and then calls `main`\n"
        + "  = help: add one:  def main() { }   - or, for files that are not a program (a library), check them without writing an executable:  -c\n");
}

/**
 * The application id of the manifest: native libraries check it. The C++
 * compiler takes a random number; here it is a fixed function of the
 * program, so that the same input gives the same bytes (codegen.md 8.1, G6).
 */
def application_id_of(name: string, functions: _int64) : _int64 {
    hash : _int64 = 5381;
    raw : _int8[]? = name.data;
    if(raw != null) {
        characters : _int8[] = raw!!;
        for(i : _int64 = 0; i < sizeof(characters); i++) { hash = ((hash * 33) + (characters[i] & 0xff)) & 1073741823; }
    }
    return (hash + functions * 7919) & 1073741823;
}

/**
 * E0970 for the first node of a function the generator has no code for.
 * Since stage 4 every node of the typed tree has a lowering (codegen.md 9,
 * 13.4), so meeting one is a bug of the compiler - a node analysis should
 * never have left in a program without errors, or a lowering that is
 * missing - and the file is not written.
 */
def not_generated_message(made: function_layout, problem: not_generated) : diagnostic {
    d := error_at_node("E0970", "internal error: code generation has no code for " + problem.what + " at " + problem.place(),
                       problem.unit, problem.node);
    d.with_label("code generation has no code for this");
    d.with_note("in `" + made.full_name + "`, which the program reaches");
    d.with_note("this is a bug of the compiler, not of the program: every construct of the language has code (doc/codegen.md 9)");
    return d;
}

/**
 * E0978: the body of a function nests deeper than the generator's walk can
 * follow on the VM's stack (generation.sharp, `generate_function`). Analysis
 * has the same limit and the same kind of message (E0992, backend.md D103);
 * a body can pass there and stop here because the generator's frames are
 * larger. A limit of this compiler, not a mistake in the program.
 */
def nested_too_deeply_message(made: function_layout, problem: not_generated) : diagnostic {
    d := error_at_node("E0978", "the body of `" + made.of.name + "` is nested too deeply for this compiler to generate code for",
                       problem.unit, problem.node);
    d.with_label("code generation ran out of stack inside this body");
    d.with_note("each block or expression inside another takes the compiler one level deeper; this body goes deeper than its stack holds");
    d.with_help("move the inner blocks, or the innermost parts of the expression, into functions of their own");
    return d;
}

/** -ir: the IR of every generated function written in the last file given */
def print_ir_of_file(layout: program_layout, file: string) {
    for(i : _int64 = 0; i < layout.functions.size(); i++) {
        made := layout.functions.at(i);
        if(made.ir != null && made.of.unit.file == file) { print(ir_text(made.ir!!)); }
    }
}
