mod std.util;

/**
 * @class uuid
 *
 * A universally unique identifier: 128 bits, written as 32 hexadecimal
 * digits in five groups, 8-4-4-4-12:
 *
 *     123e4567-e89b-42d3-a456-426614174000
 *
 *     id := uuid.random();                    // a new random (version 4) id
 *     text := id.to_string();
 *     same := uuid.parse(text);
 *     (id == same).value                      // true
 *
 * VERSION 4 LAYOUT (RFC 4122 / RFC 9562). 122 of the 128 bits are random;
 * six are fixed and mark the kind of uuid:
 *
 *     xxxxxxxx-xxxx-4xxx-Vxxx-xxxxxxxxxxxx
 *                   ^    ^
 *                   |    variant: the top two bits of byte 8 are 1 0, so V is 8, 9, a or b
 *                   version: the top four bits of byte 6 are 0100
 *
 * random() takes its bits from the runtime's random generator (std#rand,
 * seeded from the clock unless set_seed() was called); random(generator)
 * takes them from a std#seeded_random and is fully reproducible. Neither
 * source is cryptographically secure: the ids are fine as database keys and
 * correlation ids but must not be used as secrets (session tokens, password
 * reset links).
 *
 * A uuid is a VALUE and cannot be changed after it is made.
 */
class uuid {
    /** the 16 bytes, most significant first, each 0 .. 255 */
    private bytes : decimal[];

    private uuid(bytes: decimal[]) {
        self->bytes = bytes;
    }

    /** the "nil" uuid: all 128 bits zero, 00000000-0000-0000-0000-000000000000 */
    static def nil_uuid(): uuid {
        return new uuid(new decimal[16]);
    }

    /** a new random version 4 uuid from the runtime's random generator */
    static def random(): uuid {
        data := new decimal[16];
        for(i : decimal = 0; i < 16; i++) {
            data[i] = rand_index(256);
        }
        return new uuid(stamp_version_4(data));
    }

    /**
     * A new random version 4 uuid whose bits come from `generator`: the same
     * seed gives the same sequence of uuids.
     */
    static def random(generator: seeded_random): uuid {
        data := new decimal[16];
        for(i : decimal = 0; i < 16; i++) {
            data[i] = generator.next_int(256);
        }
        return new uuid(stamp_version_4(data));
    }

    /** overwrite the six fixed bits: version 4 in byte 6, variant "10" in byte 8 */
    private static def stamp_version_4(data: decimal[]): decimal[] {
        data[6] = (data[6] & 15) | 64;          // 0100 xxxx
        data[8] = (data[8] & 63) | 128;         // 10xx xxxx
        return data;
    }

    /**
     * A uuid from its 16 bytes, most significant first; the array is copied.
     * Throws illegal_argument_exception when the array does not hold
     * exactly 16 whole numbers in 0 .. 255.
     */
    static def from_bytes(values: decimal[]): uuid {
        if(sizeof(values) != 16)
            throw new illegal_argument_exception("uuid: 16 bytes are needed");

        data := new decimal[16];
        for(i : decimal = 0; i < 16; i++) {
            value : decimal = values[i];
            if(value < 0 || value > 255 || value != (value as _int64))
                throw new illegal_argument_exception("uuid: a byte must be a whole number in 0 .. 255");
            data[i] = value;
        }
        return new uuid(data);
    }

    /**
     * Read a uuid from its text form: 36 characters, hexadecimal digits in
     * groups of 8-4-4-4-12 separated by "-". Capital and small letters are
     * both accepted. Any version is accepted, not only version 4.
     *
     * Throws parse_exception for anything else.
     */
    static def parse(text: string): uuid {
        if(text.size() != 36)
            throw new parse_exception("uuid: a uuid has 36 characters: " + text);

        data := new decimal[16];
        index : decimal = 0;
        position : decimal = 0;

        while(position < 36) {
            if(position == 8 || position == 13 || position == 18 || position == 23) {
                if(text.at(position).value != '-')
                    throw new parse_exception("uuid: expected '-' at position " + snprintf('l', position, 0) + ": " + text);
                position++;
            } else {
                high : decimal = hex_value(text.at(position).value);
                low : decimal = hex_value(text.at(position + 1).value);
                if(high < 0 || low < 0)
                    throw new parse_exception("uuid: not a hexadecimal digit: " + text);
                data[index++] = high * 16 + low;
                position += 2;
            }
        }
        return new uuid(data);
    }

    /** like parse(), but returns null instead of throwing when the text is not a uuid */
    static def parse_or_null(text: string): uuid? {
        try {
            return parse(text);
        } catch(e: parse_exception) {
            return null;
        }
        return null;
    }

    /** true when parse(text) would succeed */
    static def is_valid(text: string): bool {
        return (parse_or_null(text) as object) != null;
    }

    /** the value 0 .. 15 of a hexadecimal digit, or -1 for any other character */
    private static def hex_value(ch: decimal): decimal {
        if(ch >= '0' && ch <= '9') return ch - '0';
        if(ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
        if(ch >= 'A' && ch <= 'F') return ch - 'A' + 10;
        return 0 - 1;
    }

    private static def hex_digit(value: decimal): decimal {
        if(value < 10) return '0' + value;
        return 'a' + (value - 10);
    }

    /** the version number 0 .. 15: the top four bits of byte 6 (4 for random uuids, 0 for nil) */
    def version_number(): decimal {
        return bytes[6] >> 4;
    }

    /**
     * The variant: 2 for the standard layout of RFC 4122 (top bits of byte 8
     * are "10"), 0 for the old NCS layout ("0x"), 6 for Microsoft GUIDs
     * ("110") and 7 for the reserved pattern ("111").
     */
    def variant(): decimal {
        top : decimal = bytes[8] >> 5;          // the top three bits
        if(top < 4) return 0;
        if(top < 6) return 2;
        return top;
    }

    /** true for the nil uuid (all bits zero) */
    def is_nil(): bool {
        for(i : decimal = 0; i < 16; i++) {
            if(bytes[i] != 0) return false;
        }
        return true;
    }

    /** a copy of the 16 bytes, most significant first */
    def to_bytes(): decimal[] {
        result := new decimal[16];
        for(i : decimal = 0; i < 16; i++) {
            result[i] = bytes[i];
        }
        return result;
    }

    /**
     * Three-way comparison, byte by byte from the most significant: -1, 0
     * or 1. This is the same order as comparing the text forms.
     */
    def compare_to(other: uuid): decimal {
        for(i : decimal = 0; i < 16; i++) {
            if(bytes[i] != other.bytes[i]) {
                if(bytes[i] < other.bytes[i]) return 0 - 1;
                return 1;
            }
        }
        return 0;
    }

    /** true when all 128 bits are equal */
    def operator==(other: uuid): bool {
        return compare_to(other) == 0;
    }

    /** true when at least one bit differs */
    def operator!=(other: uuid): bool {
        return compare_to(other) != 0;
    }

    /** true when this uuid sorts before `other` */
    def operator<(other: uuid): bool {
        return compare_to(other) < 0;
    }

    /** true when this uuid sorts after `other` */
    def operator>(other: uuid): bool {
        return compare_to(other) > 0;
    }

    /** the text form in small letters: "123e4567-e89b-42d3-a456-426614174000" */
    override def to_string(): string? {
        text := new _int8[36];
        position : decimal = 0;

        for(i : decimal = 0; i < 16; i++) {
            if(i == 4 || i == 6 || i == 8 || i == 10) {
                text[position++] = '-';
            }
            text[position++] = hex_digit(bytes[i] >> 4);
            text[position++] = hex_digit(bytes[i] & 15);
        }
        return new string(text);
    }

    /** a hash code over all 16 bytes (equal uuids have equal hashes) */
    override def hash(): int {
        result : decimal = 17;
        for(i : decimal = 0; i < 16; i++) {
            result = (result * 31 + bytes[i]) % 2147483647;
        }
        return result;
    }
}
