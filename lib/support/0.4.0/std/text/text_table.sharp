mod std.text;

/**
 * text_table
 *
 * Lays out rows of text in columns for printing in a terminal or a log:
 *
 *     t := new text_table(new string[] { "item", "qty", "price" });
 *     t.align(1, text_table.right).align(2, text_table.right);
 *     t.add_row(new string[] { "pear", "3", "1.20" });
 *     t.add_row(new string[] { "melon", "12", "24.00" });
 *     println(t.render());
 *
 *     +-------+-----+-------+
 *     | item  | qty | price |
 *     +-------+-----+-------+
 *     | pear  |   3 |  1.20 |
 *     | melon |  12 | 24.00 |
 *     +-------+-----+-------+
 *
 * Every column is as wide as its widest cell (header included). Columns are
 * left aligned unless align() says otherwise. With set_border(false) the
 * frame is left out and columns are separated by two spaces, with a line of
 * dashes under the headers:
 *
 *     item   qty  price
 *     -----  ---  -----
 *     pear     3   1.20
 *
 * Cells are single lines; a line end inside a cell would break the layout
 * (render does not check for it). Width is counted in characters (bytes).
 * render() can be called any number of times, also between add_row calls.
 */
class text_table {
    /** align(column, text_table.left): the cell text starts at the left edge of the column (the default). */
    static const left : decimal = 0;
    /** align(column, text_table.right): the cell text ends at the right edge of the column (for numbers). */
    static const right : decimal = 1;
    /** align(column, text_table.center): the cell text is in the middle of the column. */
    static const center : decimal = 2;

    private columns : decimal = 0;
    private headers : string[]? = null;
    private alignment : decimal[]? = null;

    /* all cells, row after row: the cell of row r, column c is cells.at(r * columns + c) */
    private cells : list<string> = new list<string>();
    private rows : decimal = 0;

    private bordered : decimal = 1;

    /**
     * A table with one column per header.
     * Throws illegal_argument_exception if there are no headers.
     */
    text_table(headers: string[]) {
        columns = sizeof(headers);
        if(columns == 0)
            throw new ill_arg_except("text_table: a table needs at least one column");

        self->headers = new string[columns];
        alignment = new decimal[columns];
        for(c : decimal = 0; c < columns; c++) {
            self->headers[c] = clean(headers[c]);
        }
    }

    /** `text`, or "" if it is null (so a missing cell prints as an empty one). */
    private static def clean(text: string?): string {
        if((text as object) == null) return new string();
        return text!!;
    }

    /**
     * Sets how column `column` (0 = first) is aligned: text_table.left,
     * text_table.right or text_table.center. The header is aligned the same way.
     * Returns this table, so calls can be chained.
     * Throws out_of_bounds_exception if there is no such column,
     * illegal_argument_exception if `mode` is not one of the three values.
     */
    def align(column: int, mode: int): text_table {
        if(column.value < 0 || column.value >= columns)
            throw new bounds_except("align: there is no column $column in a table of ${new int(columns)} columns");
        if(mode.value < 0 || mode.value > 2)
            throw new ill_arg_except("align: mode must be text_table.left, right or center");
        alignment[column.value] = mode.value;
        return self;
    }

    /** true (the default) draws the frame of + - | characters; false gives the plain layout. */
    def set_border(on: bool): text_table {
        bordered = on.value;
        return self;
    }

    /**
     * Adds a row. A row with fewer cells than the table has columns is filled
     * up with empty cells; null cells count as empty.
     * Throws illegal_argument_exception if the row has MORE cells than columns.
     */
    def add_row(row: string[]): text_table {
        given : decimal = sizeof(row);
        if(given > columns)
            throw new ill_arg_except("add_row: the row has " + number_format.integer(given)
                + " cells but the table has only " + number_format.integer(columns) + " columns");

        for(c : decimal = 0; c < columns; c++) {
            if(c < given) cells.add(clean(row[c]));
            else cells.add("");
        }
        rows++;
        return self;
    }

    /** The number of rows added so far (the header row is not counted). */
    def row_count(): decimal {
        return rows;
    }

    /** The number of columns. */
    def column_count(): decimal {
        return columns;
    }

    /**
     * The text of the cell in row `row`, column `column` (both from 0).
     * Throws out_of_bounds_exception if there is no such cell.
     */
    def cell(row: int, column: int): string {
        if(row.value < 0 || row.value >= rows || column.value < 0 || column.value >= columns)
            throw new bounds_except("cell: there is no cell at row $row, column $column");
        return cells.at(row.value * columns + column.value);
    }

    /** Removes all rows. Headers, alignment and the border setting are kept. */
    def clear(): text_table {
        cells.clear();
        rows = 0;
        return self;
    }

    /** The width of every column: the length of its longest cell or header. */
    private def measure(): decimal[] {
        widths := new decimal[columns];
        for(c : decimal = 0; c < columns; c++) {
            widths[c] = sizeof(headers[c].data);
        }
        for(r : decimal = 0; r < rows; r++) {
            for(c : decimal = 0; c < columns; c++) {
                len : decimal = sizeof(cells.at(r * columns + c).data);
                if(len > widths[c]) widths[c] = len;
            }
        }
        return widths;
    }

    /** Appends `text` in a field of `width` characters, aligned by `mode`. */
    private static def append_cell(out: text_buffer, text: string, width: decimal, mode: decimal) {
        missing : decimal = width - sizeof(text.data);
        before : decimal = 0;
        if(mode == right) before = missing;
        else if(mode == center) before = (missing - missing % 2) / 2;

        for(i : decimal = 0; i < before; i++) {
            out.append_char(' ');
        }
        out.append(text);
        for(i : decimal = before; i < missing; i++) {
            out.append_char(' ');
        }
    }

    /** Appends a frame line such as "+-----+----+" and a line end. */
    private def append_rule(out: text_buffer, widths: decimal[]) {
        out.append_char('+');
        for(c : decimal = 0; c < columns; c++) {
            for(i : decimal = 0; i < widths[c] + 2; i++) {
                out.append_char('-');
            }
            out.append_char('+');
        }
        out.append_char('\n');
    }

    /** Appends one line of cells (`row` < 0 = the headers) and a line end. */
    private def append_row(out: text_buffer, widths: decimal[], row: decimal) {
        if(bordered) out.append_char('|');
        for(c : decimal = 0; c < columns; c++) {
            text : string = "";
            if(row < 0) text = headers[c];
            else text = cells.at(row * columns + c);

            if(bordered) {
                out.append_char(' ');
                append_cell(out, text, widths[c], alignment[c]);
                out.append_char(' ');
                out.append_char('|');
            } else {
                if(c > 0) out.append("  ");
                append_cell(out, text, widths[c], alignment[c]);
            }
        }
        if(!bordered) trim_trailing_spaces(out);
        out.append_char('\n');
    }

    /** Removes spaces at the end of the builder (the plain layout has no reason to pad the last column). */
    private static def trim_trailing_spaces(out: text_buffer) {
        while(out.length() > 0 && out.last() == ' ') {
            out.drop_last();
        }
    }

    /**
     * The whole table as text: one line per row, each line ending in "\n"
     * (including the last one), ready for print().
     */
    def render(): string {
        widths := measure();
        out := new text_buffer();

        if(bordered) {
            append_rule(out, widths);
            append_row(out, widths, -1);
            append_rule(out, widths);
            for(r : decimal = 0; r < rows; r++) {
                append_row(out, widths, r);
            }
            append_rule(out, widths);
        } else {
            append_row(out, widths, -1);
            for(c : decimal = 0; c < columns; c++) {
                if(c > 0) out.append("  ");
                for(i : decimal = 0; i < widths[c]; i++) {
                    out.append_char('-');
                }
            }
            out.append_char('\n');
            for(r : decimal = 0; r < rows; r++) {
                append_row(out, widths, r);
            }
        }
        return out.build();
    }

    /** The lines of render() as an array, without the line ends. */
    def render_lines(): string[] {
        return render().trim_end_chars("\n").split("\n");
    }

    /** Same as render(), so a table can be printed directly. */
    override def to_string() : string? {
        return render();
    }
}
