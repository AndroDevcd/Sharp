mod std;

import (
    std.io
)

/**
* Created by bknun on 9/3/2022
* 
* @class string
*
* Description:
* This class serves as a wrapper over the native type _int8[]
* to allow for extended functionality with some string building/processing
* support
*/
class string : loopable<_int8> {
    data : _int8[]?;
        private set value -> { data = value; }

    string(str : _int8[]?) {
        if(str != null) {
            append(str!!);
        }
    }

    init(str : _int8[]) {
       append(str);
    }

    string(ch: _int8) {
        append(ch);
    }

    string(str : char[]) {
        if(str != null) {
            data = new _int8[sizeof(str)];
            iter : decimal = 0;
            foreach(ch in str) {
                data[iter++] = ch.value;
            }
        }
    }

    string(str: string) {
        if(str != null && str.data != null) {
            append(str.data!!);
        }
    }

    string(str : _int8[], offset: int) {
       data = copy(str, offset.value, sizeof(str));
    }

    string(str : char[], start: int, end: int) {
        if((end.value - start.value) > 0) {
            data = new _int8[end.value - start.value];
            array := new char_array(str).get_elements();
            memcopy(array!!, data!!, 0, start.value, end.value);
        }
    }

    string(str : _int8[], start: int, end: int) {
        if((end.value - start.value) > 0) {
            data = new _int8[end.value - start.value];
            memcopy(str, data!!, 0, start.value, end.value);
        }
    }

    /**
     * The characters str[start .. end - 1], for positions that are plain
     * numbers (a loop counter, a field): no `int` object is made for them.
     */
    string(str : _int8[], start: _int64, end: _int64) {
        if((end - start) > 0) {
            data = new _int8[end - start];
            memcopy(str, data!!, 0, start, end);
        }
    }

    def replace(pos : int, ch: char) : string {
        if(pos.value >= sizeof(data)) {
            throw bounds_error(pos);
        }

        data[pos.value] = ch.value;
        return self;
    }

    /**
     * Add one character at the end; returns this string.
     *
     * KNOWN TO THE COMPILER BY NAME, like append(_int8[]?) below: `ch` is
     * only read.
     */
    def append(ch: char) : string
    {
        if(data == null)
            data = new _int8[1];
        else
            realloc(data!!, sizeof(data) + 1);

        data[sizeof(data) - 1] = ch.value;
        return self;
    }

    def empty() : bool = sizeof(data)==0;

    def not_empty() : bool = !empty();

    /**
     * Add the characters of `immstr` at the end (nothing for null); returns
     * this string. The characters are COPIED: `immstr` is not kept.
     *
     * KNOWN TO THE COMPILER BY NAME. With -O the compiler shares a text
     * literal that is only ever read, and replaces the copy a new string
     * makes of its literal (lib/compiler/backend/optimizer/passes/calls/
     * shared_literals.sharp). For that it relies on three things here,
     * without reading this body:
     *
     *   - `immstr` is only READ: never changed, never stored in a field or
     *     anywhere else, never returned. (The identity test below is the one
     *     exception it knows about: it can only be true for this string's own
     *     array, which is being changed and so is never a shared literal.)
     *   - On a string that was just made (`data` is null) the result is a
     *     string whose `data` holds exactly the characters of `immstr` - so
     *     the compiler may store a fresh literal array into `data` directly
     *     instead of calling this. The same goes for the constructor
     *     string(_int8[]?) and for init(_int8[]) above, which call it.
     *   - The field is called `data`.
     *
     * Keep all three true, or change `find_read_only_arguments` and
     * `string_shape` in that file with it.
     */
    def append(immstr: _int8[]?) : string
    {
        if(immstr == null) return self;
        else if(immstr == data) {
            // s += s: the text is added to itself. It is copied first,
            // because growing `data` below would change what is being read.
            twin := new _int8[sizeof(data)];
            memcopy(data!!, twin, 0, 0, sizeof(data));
            return append(twin);
        }

        old_size : decimal = sizeof(data);

        if(data == null)
            data = new _int8[sizeof(immstr)];
        else
            realloc(data!!, sizeof(data) + sizeof(immstr));

        memcopy(immstr!!, data!!, old_size, 0, sizeof(immstr));
        return self;
    }

    def append(immstr: _int8[]?, len: int) : string
    {
        if(immstr == null) return self;
        else if(len.value < 0)
            throw new error("length cannot be less than zero");
        else if(len.value > sizeof(immstr))
            throw new error("length of: $len is greater than the string: ${sizeof(immstr)}");
        else if(immstr == data)
            throw new error("attempting to append string data from instance, use substring first");

        old_size : decimal = sizeof(data);

        if(data == null)
            data = new _int8[len.value];
        else
            realloc(data!!, sizeof(data) + len.value);

        memcopy(immstr!!, data!!, old_size, 0, len.value);
        return self;
    }

    def operator+(immstr : _int8[]?) : string {
        s := new string(data);
        // An empty string literal arrives here as null (an array of no
        // characters), so null means "nothing to add": "abc" + "" is "abc".
        // (It used to append the text "null".)
        if(immstr == null) {
            return s;
        }
        return s.append(immstr!!);
    }

    def to_lower() : string {
        str := new string();
        if(data != null) {
            str.data = copy(data!!, 0, sizeof(data));

            iter : decimal = 0;
            foreach(ch in data) {
                if('A' <= ch && ch <= 'Z')
                    str.data[iter] =  'a' + (ch - 'A');
                iter++;
            }
        }

        return str;
    }

    def operator+(obj : printable?) : string {
        objstr := obj?.to_string();
        // `objstr == null` would call operator==(_int8[]?) and be true for every EMPTY
        // string (an empty string and null both have size 0), which made "" print as
        // "null". Comparing the reference itself asks the real question.
        if((objstr as object) == null) {
            return new string(data).append("null");
        }
        return joined(objstr?.data);
    }

   def operator+(str : string?) : string {
        // reference comparison: an empty string is not null (see operator+(printable?))
        if((str as object) == null) {
            return new string(data).append("null");
        }
        return joined(str?.data);
   }

    override def to_string() : string? = new string(data);

    def operator==(str : _int8[]?) : bool {
        if(sizeof(data) != sizeof(str))
            return false;

        iter := 0;
        foreach(ch in str) {
            if(ch != data[iter++]) {
                return false;
            }
        }

        return true;
    }

    def operator==(str : string?) : bool {
        if(sizeof(data) != sizeof(str?.data))
            return false;

        iter := 0;
        foreach(ch in str?.data) {
            if(ch != data[iter++]) {
                return false;
            }
        }

        return true;
    }


    def operator!=(str : _int8[]?) := !operator==(str);
    def operator!=(str : string?) := !operator==(str);

    def operator=( immstr: _int8[]? )
    {
        if (immstr == null) data = null;
        else
            data = copy(immstr!!, 0, sizeof(immstr));
    }

    def at(pos : int) : char {
        if(pos.value >= sizeof(data) || pos.value < 0)
            throw bounds_error(pos.value);
        return data[pos.value];
    }

    def operator[](pos: int) := at(pos);

    override def get_elements() := data;

    def to_char_array() : char_array?
    {
        if(data == null) return null;
        return new char_array(copy(data!!, 0, sizeof(data)));
    }


    def starts_with(prefix: string) : bool {
        if (prefix == null || (sizeof(prefix.data) > sizeof(data))) {
            return false;
        }

        for(i := 0; i < sizeof(prefix.data); i++)
        {
            if(data[i]!=prefix.data[i])
                return false;
        }
        return true;
    }

    def find(str: string) : bool {
        M := str.size();
        N := sizeof(data);

        /* A loop to slide pat[] one by one */
        for (i := 0; i <= N - M; i++) {
            j := 0;

            /* For current index i, check for
            pattern match */
            for (; j < M; j++)
                if (data[i + j]
                    != str.data[j])
                    break;

            if (j == M)
                return true;
        }

        return false;
    }

    def ends_with(postfix: string) : bool {
        // (a postfix as long as the string itself can still match: "abc" ends with "abc")
        if(sizeof(postfix.data) > sizeof(data))
            return false;

        index := 0;
        for(i := sizeof(data) - sizeof(postfix.data); i < sizeof(data); i++){
            if(data[i] != postfix.data[index++])
                return false;
        }

        return true;
    }

    def operator+(flag : bool) : string {
        return operator+(flag ? "true" : "false");
    }

    def operator+(num : _int8) : string {
        s := new string(data);
        return s.append(num);
    }

    // Adding a number goes straight from the number to its digits and copies each
    // side once. ("" + x used to make a number object for x and two more for the
    // formatter's arguments, a string of the digits, a copy of the left side, and
    // then a copy of both.)

    def operator+(num : decimal) : string {
        return joined(digits_of('n', num));
    }

    def operator+(num : _int16) : string {
        return joined(digits_of('l', num));
    }

    def operator+(num : _int32) : string {
        return joined(digits_of('l', num));
    }

    def operator+(num : _int64) : string {
        return joined(digits_of('l', num));
    }

    def operator+(num : _uint8) : string {
        return operator+(num as _int8);
    }

    def operator+(num : _uint16) : string {
        return joined(digits_of('l', num));
    }

    def operator+(num : _uint32) : string {
        return joined(digits_of('l', num));
    }

    def operator+(num : _uint64) : string {
        return joined(digits_of('L', num));
    }

    /** the digits of a number, from the VM's formatter (snprintf): 'l' whole, 'L' unsigned whole, 'n' decimal */
    private def digits_of(kind: _int64, num: decimal) : _int8[]? {
        result : _int8[]? = null;
        _kind : _int64 = kind;
        _num : decimal = num;
        _precision : _int64 = 0;
        asm {
            loadl egx, [_kind]
            loadl ebx, [_num]
            loadl ecx, [_precision]
            int 0x1
            movl [result]
            popObj
        }
        return result;
    }

    /** a new string: this one followed by `tail`, made with one allocation and one copy of each */
    private def joined(tail: _int8[]?) : string {
        s := new string();
        here : _int64 = sizeof(data);
        more : _int64 = sizeof(tail);
        if(here + more == 0) {
            return s;
        }
        both := new _int8[here + more];
        if(here > 0) { memcopy(data!!, both, 0, 0, here); }
        if(more > 0) { memcopy(tail!!, both, here, 0, more); }
        s.data = both;
        return s;
    }

    def size() := sizeof(data);

    def operator+=( obj: printable? ) : string
    {
        str := obj?.to_string();
        // reference comparison: an empty string is not null (see operator+(printable?))
        if((str as object) == null) {
            return append("null");
        } else if(str?.data == null) {
            return self;
        } else {
            return append(str?.data);
        }
    }

    def operator+=( str: string ) := append(str.data!!);

    // s += 5, s += 2.5: the number is added as text, exactly as `s + 5` writes
    // it. One version per number type, like operator+ above, so that every
    // number has exactly one that fits ('c' is an _int8: the character itself).
    def operator+=( flag: bool ) := append((new string("") + flag).data);
    def operator+=( ch: _int8 ) := append(ch);
    def operator+=( num: decimal ) := append((new string("") + num).data);
    def operator+=( num: _int16 ) := append((new string("") + num).data);
    def operator+=( num: _int32 ) := append((new string("") + num).data);
    def operator+=( num: _int64 ) := append((new string("") + num).data);
    def operator+=( num: _uint8 ) := append(num as _int8);
    def operator+=( num: _uint16 ) := append((new string("") + num).data);
    def operator+=( num: _uint32 ) := append((new string("") + num).data);
    def operator+=( num: _uint64 ) := append((new string("") + num).data);

    def operator+=( str: _int8[]? ) := append(str);

    def substring(start_pos: int, end_pos: int) : string {
        if((start_pos.value >= sizeof(data)) || (start_pos.value < 0))
            throw bounds_error(start_pos);
        if(end_pos.value < start_pos.value)
            throw new ill_arg_except(
                "end_pos: $end_pos cannot be less than the start_pos: $start_pos");


        str := new string();
        str.data = copy(data!!, start_pos.value, end_pos.value);
        return str;
    }

    private def bounds_error(pos : int) : bounds_except {
        return new bounds_except("Index out of bounds exception at: $pos with size of: ${sizeof(data)}");
    }

    override def hash() : int {
        const p := 31;
        const m := 1e9 + 9;
        hash_value := 0;
        p_pow : decimal = 1;
        foreach(c in data) {
            hash_value = (hash_value + (c - 'a' + 1) * p_pow) % m;
            p_pow = (p_pow * p) % m;
        }

        return hash_value;
    }
}
