mod std.reflect;


const _type_int8   : decimal = 0;
const _type_int16  : decimal = 1;
const _type_int32  : decimal = 2;
const _type_int64  : decimal = 3;
const _type_uint8  : decimal = 4;
const _type_uint16 : decimal = 5;
const _type_uint32 : decimal = 6;
const _type_uint64 : decimal = 7;
const _type_fn_ptr : decimal = 8;
const _type_var    : decimal = 9;
const _type_object : decimal = 10;
const _type_class  : decimal = 11;

class data_type {
    type_function: _function_?;
    type_class: _class_?;
    type: int;

    override def to_string(): string? {
        return "type(type=$type, class=${type_class != null ? type_class!!.full_name : new string("")}, type_function=$type_function)";
    }
}
