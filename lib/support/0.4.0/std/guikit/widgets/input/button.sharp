mod std.guikit.widgets.input;

import (
    std.guikit.*
)

/** the looks a button can have (button.style) */
const BUTTON_FILLED  : _int64 = 0;      // solid in the theme's primary colour: the main action
const BUTTON_OUTLINE : _int64 = 1;      // a border and no fill: a secondary action
const BUTTON_PLAIN   : _int64 = 2;      // just the words: the quietest
const BUTTON_DANGER  : _int64 = 3;      // solid in the theme's danger colour: delete, discard

/**
 * button - words you can click. Made with button(...).
 *
 *      button("Save") { save(); }
 *      button("Cancel") { close(); }.outline()
 *      button("Delete", modifier().enable(can_delete.value)) { remove(item); }.danger()
 *
 *   .outline() / .plain() / .danger()     another look (default: filled)
 *   modifier().enable(0)                  greyed out, cannot be clicked
 *
 * The button reacts to the mouse by itself (lighter under it, darker while
 * pressed) and can be reached with Tab and clicked with Enter or Space.
 *
 * HOW IT WORKS: a button has no input code of its own. Its view carries the
 * click handler (view.on_click), and the host does the pressing, releasing and
 * keyboard clicking for every view that has one. The button only decides how
 * big it is and how it looks for the view's hovered / pressed flags.
 * (Compose: Button / OutlinedButton / TextButton. Android: Button.)
 */
stable class button base widget : behavior {
    private words : string = "";
    private look : _int64 = BUTTON_FILLED;

    button(caption: string, action: ()()) {
        attach(self);
        words = caption;
        me.on_click = action;
    }

    /** a border and no fill: a secondary action */
    def outline() : button {
        look = BUTTON_OUTLINE;
        return self;
    }

    /** just the words */
    def plain() : button {
        look = BUTTON_PLAIN;
        return self;
    }

    /** the theme's danger colour: delete, discard */
    def danger() : button {
        look = BUTTON_DANGER;
        return self;
    }

    override def kind() : string { return "button"; }

    override def measure(min_w: decimal, max_w: decimal, min_h: decimal, max_h: decimal) {
        host := ui_host.current!!;
        f : font = host.font_of(host.look.text_size);
        // the words, with room to breathe; never shorter than the theme's control height
        me.content_w = f.width_of(words) + host.look.space * 4;
        me.content_h = num.larger(f.line_height + host.look.space, host.look.control_height);
    }

    override def arrange() {
    }

    override def paint(p: painter) {
        host := ui_host.current!!;
        t : theme = host.look;
        f : font = host.font_of(t.text_size);
        radius : decimal = t.radius;
        if(me.corner > 0) { radius = me.corner; }

        // the colours for this look, then adjusted for hovered / pressed / disabled
        fill : color? = t.primary;
        ink : color = t.on_primary;
        if(look == BUTTON_DANGER) {
            fill = t.danger;
        } else if(look == BUTTON_OUTLINE || look == BUTTON_PLAIN) {
            fill = null;
            ink = t.primary;
        }

        if(me.enabled == 0) {
            if(fill != null) { fill = t.surface_high; }
            ink = t.text_dim;
        } else if(me.pressed == 1) {
            if(look == BUTTON_FILLED) { fill = t.primary_low; }
            else if(look == BUTTON_DANGER) { fill = t.danger.with_alpha(200); }
            else { fill = t.primary.with_alpha(60); }
        } else if(me.hovered == 1) {
            if(look == BUTTON_FILLED) { fill = t.primary_high; }
            else if(look == BUTTON_DANGER) { fill = t.danger.with_alpha(225); }
            else { fill = t.primary.with_alpha(30); }
        }

        if(fill != null) {
            p.rect(me.x, me.y, me.w, me.h, radius, fill!!);
        }
        if(look == BUTTON_OUTLINE) {
            edge : color = t.primary;
            if(me.enabled == 0) { edge = t.border; }
            p.outline(me.x, me.y, me.w, me.h, radius, 1.5, edge);
        }

        // the words in the middle
        text_w : decimal = f.width_of(words);
        p.text(words, me.x + (me.w - text_w) / 2, me.y + (me.h - f.line_height) / 2, f, ink);
    }
}
