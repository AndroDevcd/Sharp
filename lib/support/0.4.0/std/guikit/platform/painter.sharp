mod std.guikit.platform;

import (
    std.guikit.*
)

/**
 * One area drawing is cut down to (see painter.clip). Kept in a stack so
 * areas can nest: a list inside a panel inside a window.
 */
local stable class clip_area {
    x : decimal;
    y : decimal;
    w : decimal;
    h : decimal;

    clip_area(ax: decimal, ay: decimal, aw: decimal, ah: decimal) {
        x = ax;
        y = ay;
        w = aw;
        h = ah;
    }
}

/**
 * painter - the thing you draw with. Shapes, lines, text and pictures.
 *
 * Get it from the window and paint between clear() and show():
 *
 *      p := w.painter();
 *      w.clear(background);
 *      p.rect(20, 20, 200, 80, 12, card);               // a round-cornered box
 *      p.circle(60, 60, 18, accent);
 *      p.text("Hello", 90, 48, title_font, white);
 *      w.show();
 *
 * HOW POSITIONS WORK: (0, 0) is the top-left corner, x grows to the right, y
 * grows DOWN. Every shape is placed by its top-left corner and its width and
 * height - except circles, placed by their centre. Numbers are decimals, so
 * things can move smoothly between pixels.
 *
 * Things painted later cover things painted earlier (like real paint).
 * Colours with alpha below 255 let what is underneath show through.
 *
 * TWO THINGS THE FRAMEWORK USES (and you may too):
 *   - clip(x, y, w, h) ... unclip(): paint only inside an area. They nest.
 *   - move_origin(x, y) ... restore_origin(): make (0, 0) mean somewhere else,
 *     so a piece of drawing code can pretend it owns the whole window. A canvas
 *     in the middle of a layout is handed a painter set up like this.
 *
 * This is the "immediate" layer: you say what to paint, every frame. Games use
 * it directly (the canvas); the declarative layer - gui.column(), gui.button()
 * - is built ON it and calls it for you. Java comparison: Graphics2D.
 * Android: Canvas. HTML: the 2D canvas context.
 */
stable class painter {
    // where (0, 0) is right now, in window pixels
    private ox : decimal = 0;
    private oy : decimal = 0;

    // the clip areas that are open, innermost last (in window pixels)
    private clips : list<clip_area> = new list<clip_area>();

    // how solid everything is painted right now: 1 fully, 0 not at all (see fade)
    private level : decimal = 1;

    // ---------------------------------------------------------------- boxes

    /** a filled rectangle */
    def rect(x: decimal, y: decimal, w: decimal, h: decimal, c: color) {
        draw_rect(ox + x, oy + y, w, h, 0, ink(c));
    }

    /** a filled rectangle with round corners (`radius` pixels) */
    def rect(x: decimal, y: decimal, w: decimal, h: decimal, radius: decimal, c: color) {
        draw_rect(ox + x, oy + y, w, h, radius, ink(c));
    }

    /**
     * Only the border of a rectangle, `thickness` pixels wide, drawn inside
     * the area (a border never makes the box bigger). radius 0: square corners.
     */
    def outline(x: decimal, y: decimal, w: decimal, h: decimal, radius: decimal, thickness: decimal, c: color) {
        draw_rect_line(ox + x, oy + y, w, h, radius, thickness, ink(c));
    }

    // ---------------------------------------------------------------- lines and circles

    /** a straight line from (x1, y1) to (x2, y2), `thickness` pixels wide */
    def line(x1: decimal, y1: decimal, x2: decimal, y2: decimal, thickness: decimal, c: color) {
        draw_line(ox + x1, oy + y1, ox + x2, oy + y2, thickness, ink(c));
    }

    /** a filled circle around the centre (cx, cy) */
    def circle(cx: decimal, cy: decimal, radius: decimal, c: color) {
        draw_circle(ox + cx, oy + cy, radius, ink(c));
    }

    /** only the ring of a circle, `thickness` pixels wide, inside the radius */
    def ring(cx: decimal, cy: decimal, radius: decimal, thickness: decimal, c: color) {
        draw_circle_line(ox + cx, oy + cy, radius, thickness, ink(c));
    }

    /**
     * any outline, filled: corner i is (xs[i], ys[i]), in order around the shape.
     *
     *      p.polygon(new decimal[] { 10, 60, 35 }, new decimal[] { 50, 50, 10 }, red);     // a triangle
     */
    def polygon(xs: decimal[], ys: decimal[], c: color) {
        fill_polygon(xs, ys, sizeof(xs), ox, oy, ink(c));
    }

    /** the same from only the first `count` corners - so one pair of arrays can be filled again every frame */
    def polygon(xs: decimal[], ys: decimal[], count: _int64, c: color) {
        fill_polygon(xs, ys, count, ox, oy, ink(c));
    }

    /**
     * the same with the corners as text, "x y x y x y ...", already moved by the
     * painter's origin (at_x, at_y). Much slower than the arrays: every number is
     * turned into text here and read back on the other side.
     */
    def polygon(points: string, c: color) {
        draw_polygon(points, ink(c));
    }

    // ---------------------------------------------------------------- layers
    //
    // Painting "to one side" first, so that a whole box - with everything in
    // it - can then be put on the screen turned, enlarged, blurred or cut to a
    // shape (native/layers.cpp explains how). Between begin_layer() and
    // end_layer(...) everything is painted exactly as usual.

    /** from now on paint into a new layer. Gives 1 - or 0 when no layer could be made (then do not call end_layer) */
    def begin_layer() : _int64 {
        made : _int64 = layer_begin();
        if(made == 1) {
            reclip();                       // the new layer starts with nothing cut off: put the open clip back
        }
        return made;
    }

    /** of what the open layer holds, keep only what is inside this box with round corners */
    def mask_layer(x: decimal, y: decimal, w: decimal, h: decimal, radius: decimal) {
        layer_mask(ox + x, oy + y, w, h, radius);
        reclip();
    }

    /**
     * Close the layer and put its area (x, y, w, h) on what is underneath:
     * turned `angle` degrees clockwise and `scale` times its size, both
     * around the area's middle, and blurred by about `blur` pixels (0: sharp).
     */
    def end_layer(x: decimal, y: decimal, w: decimal, h: decimal, angle: decimal, scale: decimal, blur: decimal) {
        layer_end(ox + x, oy + y, w, h, angle, scale, 255, blur);
        reclip();
    }

    /** make the graphics card's clip area the innermost open one again (a change of layer forgets it) */
    private def reclip() {
        open : _int64 = clips.size().value;
        if(open == 0) {
            draw_unclip();
        } else {
            outer := clips.at(open - 1);
            draw_clip(outer.x, outer.y, outer.w, outer.h);
        }
    }

    /** where the painter's (0, 0) is right now, across - for code that hands whole coordinates to the graphics card */
    def at_x(x: decimal) : decimal { return ox + x; }
    def at_y(y: decimal) : decimal { return oy + y; }

    // ---------------------------------------------------------------- text

    /**
     * One line of text. (x, y) is the TOP-LEFT corner of the text, like every
     * other shape. For more lines, step y by f.line_height.
     */
    def text(words: string, x: decimal, y: decimal, f: font, c: color) {
        draw_text(f.id, words, ox + x, oy + y, ink(c));
    }

    // ---------------------------------------------------------------- pictures

    /** a picture at its own size */
    def image(picture: image, x: decimal, y: decimal) {
        draw_image(picture.id, ox + x, oy + y, picture.width, picture.height, solid(255));
    }

    /** a picture stretched (or shrunk) to w x h */
    def image(picture: image, x: decimal, y: decimal, w: decimal, h: decimal) {
        draw_image(picture.id, ox + x, oy + y, w, h, solid(255));
    }

    /** a picture stretched to w x h and see-through: opacity 0 (invisible) .. 255 (solid) */
    def image(picture: image, x: decimal, y: decimal, w: decimal, h: decimal, opacity: _int32) {
        draw_image(picture.id, ox + x, oy + y, w, h, solid(opacity));
    }

    // ---------------------------------------------------------------- clipping

    /**
     * From now on, paint only inside this area; anything outside it is cut
     * off. A scrolling list uses this so its rows do not spill over its edge.
     * Areas nest: inside another clip, only the part BOTH allow is painted.
     * Every clip() needs its unclip().
     */
    def clip(x: decimal, y: decimal, w: decimal, h: decimal) {
        left : decimal = ox + x;
        top : decimal = oy + y;
        right : decimal = left + w;
        bottom : decimal = top + h;

        // cut it down to the area that is already open, if there is one
        open : _int64 = clips.size().value;
        if(open > 0) {
            outer := clips.at(open - 1);
            if(left < outer.x) { left = outer.x; }
            if(top < outer.y) { top = outer.y; }
            if(right > outer.x + outer.w) { right = outer.x + outer.w; }
            if(bottom > outer.y + outer.h) { bottom = outer.y + outer.h; }
        }
        if(right < left) { right = left; }
        if(bottom < top) { bottom = top; }

        clips.add(new clip_area(left, top, right - left, bottom - top));
        draw_clip(left, top, right - left, bottom - top);
    }

    /** end the innermost clip(): back to the area that was open before it */
    def unclip() {
        open : _int64 = clips.size().value;
        if(open == 0) {
            return;
        }
        clips.remove_at(open - 1);
        if(open == 1) {
            draw_unclip();
        } else {
            outer := clips.at(open - 2);
            draw_clip(outer.x, outer.y, outer.w, outer.h);
        }
    }

    // ---------------------------------------------------------------- moving (0, 0)

    /** where (0, 0) is now, in window pixels (to hand back to restore_origin) */
    def origin_x() : decimal { return ox; }
    def origin_y() : decimal { return oy; }

    /** from now on (0, 0) means the point (x, y) of the current coordinates */
    def move_origin(x: decimal, y: decimal) {
        ox = ox + x;
        oy = oy + y;
    }

    /** put (0, 0) back where origin_x() / origin_y() said it was */
    def restore_origin(x: decimal, y: decimal) {
        ox = x;
        oy = y;
    }

    // ---------------------------------------------------------------- fading

    /**
     * From now on, paint everything this much more see-through: 1 changes
     * nothing, 0.5 makes everything half as solid, 0 invisible. It multiplies
     * with a fade that is already on, so a faded panel inside a faded screen is
     * fainter still. Returns the level that was on before: hand it to unfade()
     * when done.
     *
     *      before := p.fade(0.5);
     *      ... paint things ...
     *      p.unfade(before);
     *
     * This is how a widget's opacity and the fade animations work: the whole
     * subtree is painted between a fade() and its unfade(). Every colour passes
     * through the level on its way to the native side (ink, below), so nothing
     * that paints needs to know it is being faded.
     */
    def fade(amount: decimal) : decimal {
        before : decimal = level;
        level = level * amount;
        if(level < 0) { level = 0; }
        if(level > 1) { level = 1; }
        return before;
    }

    /** put back the level fade() returned */
    def unfade(before: decimal) {
        level = before;
    }

    /** a colour as the native side wants it (0xRRGGBBAA), with its alpha scaled by the fade level */
    private def ink(c: color) : _int64 {
        if(level >= 1) {
            return c.packed;
        }
        faded : _int64 = c.alpha * level;
        return c.packed - c.alpha + faded;       // alpha is the lowest byte: swap it for the faded one
    }

    /** an opacity 0..255 scaled by the fade level */
    private def solid(opacity: _int32) : _int32 {
        if(level >= 1) {
            return opacity;
        }
        scaled : _int32 = opacity * level;
        return scaled;
    }

    /** forget every clip, move and fade: the start of a frame (the framework calls this) */
    def reset() {
        ox = 0;
        oy = 0;
        level = 1;
        if(clips.size().value > 0) {
            clips.clear();
            draw_unclip();
        }
    }
}
