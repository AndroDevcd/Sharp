mod std.io.coroutines;

/**
 * coroutine_body - the code a coroutine runs.
 *
 * USAGE
 *     class download : coroutine_body {
 *         url : string;
 *         download(url: string) { self->url = url; }
 *         override def run_body() { fetch(url); }
 *     }
 *
 *     launch(new download("http://..."));      // an object instead of a lambda
 *
 * WHY IT EXISTS
 * 1. A lambda that runs on another fiber cannot see the local variables of the
 *    function that created it (see builders.sharp, "THE CLOSURE RULE"). An
 *    object that implements coroutine_body carries its own data in its fields,
 *    which is the cleanest way to hand state to a coroutine.
 * 2. Methods are only dispatched at run time through an interface reference.
 *    job calls run_body() through this interface, which is what lets
 *    deferred<t> replace it with a version that keeps the result.
 *
 * Kotlin equivalent: the `block: suspend CoroutineScope.() -> Unit` parameter
 * of launch. Java equivalent: java.lang.Runnable.
 *
 * run_body() may suspend (delay, join, channel operations, ...) and may throw:
 * the exception ends the coroutine and is handled by its job.
 */
interface coroutine_body {
    def run_body();
}
