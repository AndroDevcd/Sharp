mod std.io.coroutines.channels;

import (
    std.io.fiber,
    std.collections,
    std.io.coroutines
)

/**
 * channel<t> - a queue between coroutines: send() on one side, receive() on
 * the other, and whoever is too fast is suspended until the other side has
 * caught up.
 *
 * USAGE
 *     numbers := new channel<int>(16);                 // see `channels` for the capacities
 *
 *     launch(numbers, { s: object ->                   // the producer (state object: THE CLOSURE RULE)
 *         out := s as channel<int>;
 *         for(i : decimal = 0; i < 100; i++) { out.send(i); }
 *         out.close();
 *     });
 *
 *     total : decimal = 0;
 *     for( ;; ) {                                      // the consumer
 *         n := numbers.receive_or_null();
 *         if(n == null) { break; }                     // closed and empty
 *         total += n!!.value;
 *     }
 *     // or: numbers.for_each({ n: int -> ... });
 *
 * Any number of coroutines may send and receive on the same channel; every
 * element is received exactly once. Elements of one sender arrive in the order
 * they were sent. Waiting senders and receivers are served first come first
 * served. It works the same from plain fibers and threads (there the waits
 * simply cannot be cancelled).
 *
 * CLOSING
 *   close()   "nothing more will be sent". Elements that are in the channel,
 *             including those of senders that are still waiting, can be
 *             received; after that receive() throws closed_channel_exception
 *             and receive_or_null() returns null. send() throws at once.
 *   cancel()  close() from the consumer side: also throws away what is in the
 *             channel and makes waiting senders fail.
 *
 * `t` must be an object type (channel<int>, not channel<decimal>).
 *
 * Kotlin equivalent: kotlinx.coroutines.channels.Channel<E>.
 * Java equivalent: java.util.concurrent.BlockingQueue (SynchronousQueue,
 * ArrayBlockingQueue, LinkedBlockingQueue for the first three capacities).
 * Go equivalent: chan T.
 *
 * LOCKING DISCIPLINE
 *   `lk` (a stripe of lock_stripes, picked once) guards buffer, senders,
 *   receivers, closed and cancelled, and is the guard of every waiter queued
 *   here. No other lock is taken while it is held, nothing that can throw and
 *   no user code runs inside a lock block; waiters are unparked and exceptions
 *   thrown after the lock is released.
 *   A waiting sender carries its element in waiter.item; a waiting receiver is
 *   handed its element through waiter.item.
 *
 * Suspends: send (full), receive / receive_or_null / for_each / to_list
 * (empty). All of them are cancellation points. try_send, try_receive, close,
 * cancel and the queries never suspend.
 */
class channel<t> : send_channel<t>, receive_channel<t> {

    private lk : object = lock_stripes.next();
    /** 0 rendezvous, n > 0 buffered, -1 unlimited, -2 conflated (see `channels`) */
    private capacity : decimal = 0;
    /** 1 for channels.UNLIMITED */
    private unlimited : decimal = 0;
    /** 1 for channels.CONFLATED */
    private conflated : decimal = 0;
    private buffer : deque<t> = new deque<t>();
    private senders : wait_queue = new wait_queue();
    private receivers : wait_queue = new wait_queue();
    private closed : decimal = 0;
    private cancelled : decimal = 0;

    /** A rendezvous channel: every send waits for a receive. Kotlin: Channel() */
    channel() {}

    /**
     * @param capacity 0 (channels.RENDEZVOUS), a buffer size, channels.UNLIMITED
     *                 or channels.CONFLATED
     * @throws illegal_argument_exception for any other negative number
     */
    channel(capacity: decimal) {
        // (compared with the named constants: a negative literal inside a longer
        //  condition, like `c == -1 || ...`, is parsed as -(1 || ...))
        if(capacity < channels.CONFLATED) {
            throw new illegal_argument_exception("channel capacity must be 0, positive, channels.UNLIMITED or channels.CONFLATED");
        }
        self->capacity = capacity;
        if(capacity == channels.UNLIMITED) {
            unlimited = 1;
        }
        if(capacity == channels.CONFLATED) {
            conflated = 1;
        }
    }

    /** the capacity the channel was created with */
    def get_capacity() : decimal {
        return capacity;
    }

    /** number of elements waiting in the buffer right now */
    def size() : decimal {
        count : decimal = 0;
        lock(lk) {
            count = buffer.size();
        }
        return count;
    }

    /** true when no element is waiting in the buffer right now */
    def is_empty() : bool {
        return size() == 0;
    }

    // ------------------------------------------------------------------------------
    // sending
    // ------------------------------------------------------------------------------

    /**
     * Hand `value` to a receiver, or put it into the buffer.
     *
     * SUSPENDS while the channel is full (always, for a rendezvous channel
     * without a waiting receiver). A cancellation point: checked on entry, and
     * a cancelled wait takes the element back and throws.
     * @throws closed_channel_exception when the channel is closed (also when it
     *         is cancelled while this call waits)
     * @throws cancellation_exception when the calling coroutine is cancelled
     * Kotlin: SendChannel.send(element)
     */
    override def send(value: t) {
        ensure_active();

        w : waiter? = null;
        taker : waiter? = null;
        refused : decimal = 0;

        lock(lk) {
            if(closed != 0) {
                refused = 1;
            } else {
                taker = receivers.pop_waiting_with(1, value);       // waiter.RESUMED
                if(taker == null) {
                    if(conflated != 0) {
                        buffer.clear();
                        buffer.add_last(value);
                    } else if(unlimited != 0 || buffer.size() < capacity) {
                        buffer.add_last(value);
                    } else {
                        w = new waiter(lk);
                        w!!.item = value;
                        senders.add(w!!);
                    }
                }
            }
        }

        if(taker != null) {
            taker!!.unpark();
        }
        if(refused != 0) {
            throw new closed_channel_exception("send on a closed channel");
        }
        if(w == null) {
            return;
        }

        outcome : decimal = await_waiter(w!!, -1);
        if(outcome == 1) {          // a receiver took the element
            return;
        }
        if(outcome == 4) {          // waiter.CLOSED: the channel was cancelled
            throw new closed_channel_exception("the channel was cancelled while send was waiting");
        }

        lock(lk) {
            senders.remove(w!!);
        }
        throw_cancellation();
    }

    /**
     * send() that never waits.
     * @return true when the element was handed over or buffered; false when
     *         the channel is full or closed
     * Never suspends, not a cancellation point.
     * Kotlin: trySend(element).isSuccess
     */
    override def try_send(value: t) : bool {
        taker : waiter? = null;
        accepted : decimal = 0;

        lock(lk) {
            if(closed == 0) {
                taker = receivers.pop_waiting_with(1, value);
                if(taker != null) {
                    accepted = 1;
                } else if(conflated != 0) {
                    buffer.clear();
                    buffer.add_last(value);
                    accepted = 1;
                } else if(unlimited != 0 || buffer.size() < capacity) {
                    buffer.add_last(value);
                    accepted = 1;
                }
            }
        }

        if(taker != null) {
            taker!!.unpark();
        }
        return accepted;
    }

    // ------------------------------------------------------------------------------
    // receiving
    // ------------------------------------------------------------------------------

    /**
     * Take the next element.
     *
     * SUSPENDS while the channel is empty. A cancellation point.
     * @throws closed_channel_exception when the channel is closed and empty
     * @throws cancellation_exception when the calling coroutine is cancelled
     * Kotlin: ReceiveChannel.receive()
     */
    override def receive() : t {
        element := take(1);
        return element!!;
    }

    /**
     * receive() that returns null when the channel is closed and empty.
     * SUSPENDS while the channel is empty and open. A cancellation point.
     * Kotlin: receiveCatching().getOrNull()
     */
    override def receive_or_null() : t? {
        return take(0);
    }

    /** the one implementation of receive: `strict` decides between exception and null for a closed channel */
    private def take(strict: decimal) : t? {
        ensure_active();

        w : waiter? = null;
        giver : waiter? = null;
        element : object? = null;
        have : decimal = 0;
        finished : decimal = 0;

        lock(lk) {
            if(buffer.size() > 0) {
                element = buffer.remove_first();
                have = 1;

                // room for the element of the sender that has waited longest
                giver = senders.pop_waiting(1);
                if(giver != null) {
                    buffer.add_last(giver!!.item as t);
                }
            } else {
                giver = senders.pop_waiting(1);         // rendezvous: straight from the sender
                if(giver != null) {
                    element = giver!!.item;
                    have = 1;
                } else if(closed != 0) {
                    finished = 1;
                } else {
                    w = new waiter(lk);
                    receivers.add(w!!);
                }
            }
        }

        if(giver != null) {
            giver!!.unpark();
        }
        if(have != 0) {
            return element as t;
        }
        if(finished != 0) {
            if(strict != 0) {
                throw new closed_channel_exception("receive on a closed channel");
            }
            return null;
        }

        outcome : decimal = await_waiter(w!!, -1);
        if(outcome == 1) {          // a sender handed its element over
            return w!!.item as t;
        }
        if(outcome == 4) {          // waiter.CLOSED
            if(strict != 0) {
                throw new closed_channel_exception("the channel was closed while receive was waiting");
            }
            return null;
        }

        lock(lk) {
            receivers.remove(w!!);
        }
        throw_cancellation();
        return null;
    }

    /**
     * receive() that never waits: the next element, or null when nothing is
     * there right now (empty or closed - is_closed_for_receive() tells).
     * Never suspends, not a cancellation point.
     * Kotlin: tryReceive().getOrNull()
     */
    override def try_receive() : t? {
        giver : waiter? = null;
        element : object? = null;
        have : decimal = 0;

        lock(lk) {
            if(buffer.size() > 0) {
                element = buffer.remove_first();
                have = 1;
                giver = senders.pop_waiting(1);
                if(giver != null) {
                    buffer.add_last(giver!!.item as t);
                }
            } else {
                giver = senders.pop_waiting(1);
                if(giver != null) {
                    element = giver!!.item;
                    have = 1;
                }
            }
        }

        if(giver != null) {
            giver!!.unpark();
        }
        if(have != 0) {
            return element as t;
        }
        return null;
    }

    /**
     * Call `action(element)` for every element until the channel is closed and
     * empty. The way to "iterate over a channel".
     *
     * The action runs in-line in the calling fiber (it may capture locals).
     * SUSPENDS while it waits for the next element; a cancellation point.
     * An exception of the action ends the loop and is thrown on; the channel
     * is left as it is.
     * Do not call for_each from inside the action of another for_each on the
     * same fiber (THE NESTING RULE, std/io/coroutines/scope/scopes.sharp); use a
     * receive_or_null() loop for the inner one.
     * Kotlin: for (x in channel) { } / consumeEach { }
     */
    override def for_each(action: (t)()) {
        for( ;; ) {
            element := take(0);
            if(element == null) {
                break;
            }
            action(element!!);
        }
    }

    /**
     * Receive everything until the channel is closed and return it as a list.
     * SUSPENDS until the channel is closed; a cancellation point.
     * Kotlin: channel.toList()
     */
    def to_list() : list<t> {
        result := new list<t>();
        for( ;; ) {
            element := take(0);
            if(element == null) {
                break;
            }
            result.add(element!!);
        }
        return result;
    }

    // ------------------------------------------------------------------------------
    // closing
    // ------------------------------------------------------------------------------

    /**
     * No more elements will be sent. Receivers that are waiting on the empty
     * channel wake up (closed_channel_exception / null); elements that are
     * still in the channel stay receivable. Closing twice is harmless.
     * Never suspends.
     * Kotlin: SendChannel.close()
     */
    override def close() {
        woken : waiter? = null;

        lock(lk) {
            if(closed == 0) {
                closed = 1;

                // receivers only wait when there is nothing to receive, so nothing will ever come for them
                for( ;; ) {
                    w := receivers.pop_waiting(4);      // waiter.CLOSED
                    if(w == null) {
                        break;
                    }
                    w!!.next = woken;
                    woken = w;
                }
            }
        }

        unpark_all(woken);
    }

    /**
     * The consumer gives up: closes the channel, throws away the elements that
     * are waiting in it and makes senders that are waiting fail with
     * closed_channel_exception. Never suspends.
     * Kotlin: ReceiveChannel.cancel()
     */
    override def cancel() {
        woken : waiter? = null;

        lock(lk) {
            closed = 1;
            cancelled = 1;
            buffer.clear();

            for( ;; ) {
                w := receivers.pop_waiting(4);
                if(w == null) {
                    break;
                }
                w!!.next = woken;
                woken = w;
            }
            for( ;; ) {
                w := senders.pop_waiting(4);
                if(w == null) {
                    break;
                }
                w!!.next = woken;
                woken = w;
            }
        }

        unpark_all(woken);
    }

    /** wake a chain of claimed waiters (linked through waiter.next, which is free once a waiter left its queue) */
    private static def unpark_all(chain: waiter?) {
        current := chain;
        while(current != null) {
            following := current!!.next;
            current!!.next = null;
            current!!.unpark();
            current = following;
        }
    }

    /** true after close() or cancel(): send() will throw. Kotlin: isClosedForSend */
    override def is_closed_for_send() : bool {
        return closed != 0;
    }

    /** true after cancel() */
    def is_cancelled() : bool {
        return cancelled != 0;
    }

    /** true when the channel is closed and nothing is left to receive. Kotlin: isClosedForReceive */
    override def is_closed_for_receive() : bool {
        done : decimal = 0;
        lock(lk) {
            if(closed != 0 && buffer.size() == 0 && senders.size() == 0) {
                done = 1;
            }
        }
        return done;
    }
}
