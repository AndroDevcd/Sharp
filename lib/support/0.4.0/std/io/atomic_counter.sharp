mod std.io;

/**
 * atomic_counter - a number that many fibers and threads can change at the
 * same time without losing updates.
 *
 * USAGE
 *     hits := new atomic_counter();            // starts at 0
 *     hits.increment();                        // from any fiber, any thread
 *     hits.add(5);
 *     n : decimal = hits.read();
 *     if(hits.compare_and_set(6, 0)) { ... }   // "set to 0, but only if it is still 6"
 *
 * WHY NOT atomic<int> (std.io)
 * atomic<t> returns a new number object from every ++ and takes its arguments
 * as objects; this class works on native numbers (decimal) and allocates nothing,
 * which matters when 10,000 coroutines count something. (atomic<decimal> itself
 * does not compile.)
 *
 * Java equivalent: java.util.concurrent.atomic.AtomicLong.
 * C++ equivalent: std::atomic<long> (implemented with a lock here, the
 * runtime has no compare-and-swap instruction).
 *
 * LOCKING DISCIPLINE: lock(self) guards `value`. Every method takes it for a
 * few instructions, never calls out while holding it, and never nests it.
 *
 * Nothing here suspends (a fiber that finds the lock taken waits for it, which
 * lasts a few instructions).
 */
class atomic_counter {

    private value : decimal = 0;

    /** a counter that starts at 0 */
    atomic_counter() {}

    /** a counter that starts at `initial` */
    atomic_counter(initial: decimal) {
        value = initial;
    }

    /** the current value. Java: get() */
    def read() : decimal {
        result : decimal = 0;
        lock(self) {
            result = value;
        }
        return result;
    }

    /** replace the value. Java: set(v) */
    def write(new_value: decimal) {
        lock(self) {
            value = new_value;
        }
    }

    /** add 1 and return the new value. Java: incrementAndGet() */
    def increment() : decimal {
        result : decimal = 0;
        lock(self) {
            value = value + 1;
            result = value;
        }
        return result;
    }

    /** subtract 1 and return the new value. Java: decrementAndGet() */
    def decrement() : decimal {
        result : decimal = 0;
        lock(self) {
            value = value - 1;
            result = value;
        }
        return result;
    }

    /** add `amount` (may be negative) and return the new value. Java: addAndGet(n) */
    def add(amount: decimal) : decimal {
        result : decimal = 0;
        lock(self) {
            value = value + amount;
            result = value;
        }
        return result;
    }

    /** add `amount` and return the value from BEFORE the addition. Java: getAndAdd(n) */
    def fetch_add(amount: decimal) : decimal {
        result : decimal = 0;
        lock(self) {
            result = value;
            value = value + amount;
        }
        return result;
    }

    /** replace the value and return the old one. Java: getAndSet(v) */
    def exchange(new_value: decimal) : decimal {
        result : decimal = 0;
        lock(self) {
            result = value;
            value = new_value;
        }
        return result;
    }

    /**
     * Set the value to `new_value` only if it is `expected` right now.
     * @return true when the value was changed
     * Java: compareAndSet(expected, new)
     */
    def compare_and_set(expected: decimal, new_value: decimal) : bool {
        changed : decimal = 0;
        lock(self) {
            if(value == expected) {
                value = new_value;
                changed = 1;
            }
        }
        return changed != 0;
    }

    /** make the value at least `candidate`; returns the value afterwards */
    def raise_to(candidate: decimal) : decimal {
        result : decimal = 0;
        lock(self) {
            if(candidate > value) {
                value = candidate;
            }
            result = value;
        }
        return result;
    }

    /** the value as text, e.g. "42" */
    override def to_string() : string? {
        whole : int = read();
        return "$whole";
    }
}
