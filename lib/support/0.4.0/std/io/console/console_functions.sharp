def read_line() : string {
    ch : char;
    message : string = "";

    ch = read_char();
    while((ch != 13) && (ch != 10)) { // \r\n
        message.append(ch);
        ch = read_char();
    }

    flush();
    return message;
}

def read_passwd() : string {
    ch : char;
    message : string = "";

    ch = read_raw_char();
    while((ch != 13) && (ch != 10)) { // \r\n
        message.append(ch);
        ch = read_raw_char();
    }

    flush();
    return message;
}

def read_char() : char {
    return read_ch(true);
}

/**
 * IS A KEY WAITING TO BE READ? - without waiting for one.
 *
 * `read_char()` waits until a key is pressed, which stops everything else the program does.
 * A program that has to keep going - a game's loop, a machine's control loop - asks first:
 *
 *      if(key_waiting()) {
 *          key := read_raw_char();         // comes back at once: the key is already there
 *      }
 *
 * (C: kbhit(). Java has no such thing: System.in.available() is the nearest.)
 * It is 0 when the input is not a console at all (a file, a pipe that has ended).
 */
def key_waiting() : _int64 {
    result : _int64 = 0;
    asm {
        int 0x1b
        smovr2 [result], cmt
    }
    return result != 0;
}

def read_raw_char() : char {
    return read_ch(false);
}

def println(str: string) {
    print_chars(str.data);
    print_char('\n');
}

def println(o: printable?) {
    str := o?.to_string();

    if(str == null) {
        print_chars("null");
    } else if(str?.data != null) {
        print_chars(str?.data);
    }
    print_char('\n');
}

def print(o: printable?) {
    str := o?.to_string();

    if(str == null) {
        print_chars("null");
    } else if(str?.data != null) {
        print_chars(str?.data);
    }
}

def print(data: double) {
    print_num(data);
}

def flush() {
    asm { int 0x34 }
}

