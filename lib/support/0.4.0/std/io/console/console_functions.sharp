/** what read_line() remembers between two lines */
class console_line_end {
    /** 1 when the last line read ended with `\r`: a `\n` right after it belongs to that line end */
    static after_return : _int64 = 0;
}

def read_line() : string {
    ch : char;
    message : string = "";

    // (the Enter key gives `\r` alone, so the line ends there; input that has "\r\n" line ends
    //  gives its `\n` as the first character of the next read, which is left out here)
    ch = read_char();
    if(console_line_end.after_return && ch == 10) {
        ch = read_char();
    }
    console_line_end.after_return = 0;
    while((ch != 13) && (ch != 10) && (ch != 0 - 1)) { // \r\n, or the input has ended
        message.append(ch);
        ch = read_char();
    }
    if(ch == 13) {
        console_line_end.after_return = 1;
    }

    flush();
    return message;
}

def read_passwd() : string {
    ch : char;
    message : string = "";

    ch = read_raw_char();
    while((ch != 13) && (ch != 10) && (ch != 0 - 1)) { // \r\n, or the input has ended
        message.append(ch);
        ch = read_raw_char();
    }

    flush();
    return message;
}

def read_char() : char {
    return read_ch(true);
}

/**
 * IS A KEY WAITING TO BE READ? - without waiting for one.
 *
 * `read_char()` waits until a key is pressed, which stops everything else the program does.
 * A program that has to keep going - a game's loop, a machine's control loop - asks first:
 *
 *      if(key_waiting()) {
 *          key := read_raw_char();         // comes back at once: the key is already there
 *      }
 *
 * (C: kbhit(). Java has no such thing: System.in.available() is the nearest.)
 * It is false when the input is not a console at all (a file, a pipe that has ended).
 */
def key_waiting() : bool {
    result : _int64 = 0;
    asm {
        int 0x1b
        smovr2 [result], cmt
    }
    return result != 0;
}

def read_raw_char() : char {
    return read_ch(false);
}

def println(str: string) {
    print_chars(str.data);
    print_char('\n');
}

def println(o: printable?) {
    str := o?.to_string();

    if(str == null) {
        print_chars("null");
    } else if(str?.data != null) {
        print_chars(str?.data);
    }
    print_char('\n');
}

def print(o: printable?) {
    str := o?.to_string();

    if(str == null) {
        print_chars("null");
    } else if(str?.data != null) {
        print_chars(str?.data);
    }
}

def print(data: double) {
    print_num(data);
}

def flush() {
    asm { int 0x34 }
}

/** milliseconds since 1970-01-01T00:00:00Z (dates, durations and clocks: std.time) */
def utc_mills() : long {
    now : _int64 = vm.time_in_nanoseconds().value / 1000000;
    return now;
}

/** nanoseconds since 1970-01-01T00:00:00Z, good to about 256 of them */
def nano_time() : long {
    return vm.time_in_nanoseconds();
}

def exit(val : int) {
    vm.exit(val.value);
}

def exit() {
    vm.exit(0);
}

/** how many bytes an object takes in memory (the object itself: not what its fields refer to) */
def memory_size(data: object) : _int64 {
    result : _int64;

    asm {
        pushl [data]
        int 0x33
        smovr2 [result], ebx
    }
    return result;
}

/** how many bytes an array of objects takes in memory (the array itself: not its elements) */
def memory_size(data: object[]) : _int64 {
    result : _int64;

    asm {
        pushl [data]
        int 0x33
        smovr2 [result], ebx
    }

    return result;
}

local def print_chars(str: char_array) {
    foreach(ch in str) {
        asm {
            loadl ebx, [ch]
            putc ebx
        }
    }

    flush();
}

/**
 * Print a decimal. `dput` is the instruction that prints a register AS A
 * DECIMAL; the plain `put` prints it as a whole number and would show the raw
 * bits of the decimal instead (println(5) used to print 4617315517961601024).
 */
local def print_num(val: double) {
    _val : decimal = val.value;

    asm {
        loadl ebx, [_val]
        dput ebx
    }

    flush();
}

local def print_char(val: char) {
    _val := val.value;

    asm {
        loadl ebx, [_val]
        putc ebx
    }

    flush();
}

local def print_numbers(str: char_array) {
    asm {
        movi ebx, '['
        movi egx, ' '
        putc ebx
        putc egx
    }
    for(i := 0; i < sizeof(str); i++) {
        ch := str.data[i];
        asm {
            loadl ebx, [ch]
            put ebx
        }

        if((i + 1) < sizeof(str)) {
            asm {
                movi ebx, ','
                movi egx, ' '
                putc ebx
                putc egx
            }
        }
    }

    asm {
        movi ebx, ' '
        movi egx, ']'
        putc ebx
        putc egx
    }

    flush();
}

// "[ 1, 2, 3 ]": the pieces every array of numbers is printed with
local def list_start() {
    asm {
        movi ebx, '['
        movi egx, ' '
        putc ebx
        putc egx
    }
}

local def list_between() {
    asm {
        movi ebx, ','
        movi egx, ' '
        putc ebx
        putc egx
    }
}

local def list_end() {
    asm {
        movi ebx, ' '
        movi egx, ']'
        putc ebx
        putc egx
    }

    flush();
}

local def put_whole(value: _int64) {
    asm {
        loadl ebx, [value]
        put ebx
    }
}

local def print_numbers(str: decimal[]) {
    list_start();
    for(i : _int64 = 0; i < sizeof(str); i++) {
        if(i > 0) { list_between(); }
        one : decimal = str[i];
        asm {
            loadl ebx, [one]
            dput ebx
        }
    }
    list_end();
}

local def print_numbers(str: _int16[]) {
    list_start();
    for(i : _int64 = 0; i < sizeof(str); i++) {
        if(i > 0) { list_between(); }
        put_whole(str[i]);
    }
    list_end();
}

local def print_numbers(str: _int32[]) {
    list_start();
    for(i : _int64 = 0; i < sizeof(str); i++) {
