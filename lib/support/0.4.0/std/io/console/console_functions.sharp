local def print_chars(str: _int16[]) {
    print_chars(str);
}

/**
 * One key from the console; `echo` says whether the console shows it.
 *
 * Both numbers are WHOLE numbers (`_int64`), because the VM's `get` instruction reads a whole
 * number from `cmt` and puts a whole number into the register. They used to be `decimal`: the
 * key's number, stored into a decimal as it was, read back as 0 - every key was the key 0, and
 * read_line() never saw an Enter.
 */
local def read_ch(echo: _int64) : char {
    result  : _int64 = 0;

    asm {
        loadl cmt, [echo]
        get ebx
        smovr2 [result], ebx
    }

    return result;
}

