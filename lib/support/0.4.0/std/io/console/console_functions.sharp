mod std.io.console;

import (
    platform.kernel
)

def strtod(str: string) : double {
    data := str.data;
    result : decimal;

    asm {
        pushl [data]
        int 0x43
        smovr2 [result], ebx
    }

    return result;
}

/**
 * The number written in `digits`, read the way strtod() reads it, for a
 * caller that has the characters and wants the plain number: no string and
 * no `double` object is made.
 */
def chars_to_decimal(digits: _int8[]) : decimal {
    result : decimal;

    asm {
        pushl [digits]
        int 0x43
        smovr2 [result], ebx
    }

    return result;
}

def snprintf(fmt: int, num: double, precision: int) : string {
    result : _int8[]? = null;
    _fmt : _int64 = fmt.value;
    _num : decimal = num.value;
    _precision : _int64 = precision.value;
    asm {
        loadl egx, [_fmt]
        loadl ebx, [_num]
        loadl ecx, [_precision]
        int 0x1
        movl [result]
        popObj
    }
    return new string(result);
}

def sys(str: string) : int {
    cmd := str.data;
    result : _int64;
    asm {
        pushl [cmd]
        int 0x1a
        smovr2 [result], cmt
    }

    return result;
}

