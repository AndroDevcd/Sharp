mod std.math;

/**
 * Turning native numbers into readable text.
 *
 * Concatenating a `decimal` to a string prints 16 decimals ("2.5000000000000000").
 * The classes of this module (vector2, complex, matrix ...) use
 * number_to_string() for their to_string() so that 2.5 prints as "2.5" and
 * 3 prints as "3".
 */

/**
 * The shortest ordinary decimal text for v:
 *
 *     3        -> "3"            -0.5   -> "-0.5"
 *     2.50     -> "2.5"          0.1    -> "0.1"
 *     NaN      -> "NaN"          1 / 0  -> "Infinity"   -1 / 0 -> "-Infinity"
 *
 * Algorithm: whole numbers (below 9 * 10^18) print without a decimal point.
 * Otherwise the number is printed with 1, 2, 3 ... 17 decimals until reading
 * the text back gives exactly v again. A number that needs more than 17
 * decimals (very small, e.g. 1e-20) or a whole number beyond 9 * 10^18 is
 * printed in scientific notation with 6 decimals ("1.000000e-20").
 */
def number_to_string(v: decimal): string {
    if(v != v) return "NaN";
    if((v - v) != 0) {
        if(v > 0) return "Infinity";
        return "-Infinity";
    }

    if(floor_of(v) == v) {
        if(absolute(v) < 9000000000000000000) {
            return snprintf('l', v, 0);
        }
        return snprintf('e', v, 0);
    }

    for(decimals : decimal = 1; decimals <= 17; decimals++) {
        text := snprintf('f', v, decimals);
        if(strtod(text).value == v) {
            return text;
        }
    }
    return snprintf('e', v, 0);
}

/**
 * v with exactly `decimals` digits after the decimal point, rounded:
 * number_to_fixed(3.14159, 2) is "3.14", number_to_fixed(2, 3) is "2.000",
 * number_to_fixed(2.5, 0) is "3".
 *
 * Throws illegal_argument_exception when decimals is negative or above 100.
 */
def number_to_fixed(v: decimal, decimals: decimal): string {
    if(decimals < 0 || decimals > 100)
        throw new illegal_argument_exception("number_to_fixed: decimals must be in 0 .. 100");

    if(decimals == 0) {
        return snprintf('l', round_half_away(v), 0);
    }
    return snprintf('f', v, decimals);
}
