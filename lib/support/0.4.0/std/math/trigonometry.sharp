mod std.math;

/**
 * Trigonometry on native numbers: angle conversion, the two argument arc
 * tangent, the reciprocal functions, the inverse hyperbolic functions and
 * angle normalisation.
 *
 * sin / cos / tan / asin / acos / atan / sinh / cosh / tanh already exist in
 * math.sharp (they return `double` objects); sin_of / cos_of / tan_of in
 * native_math.sharp are the native twins of the first three. All angles are
 * in radians unless a function name says degrees.
 */

/** degrees -> radians: to_radians(180) == pi */
def to_radians(degrees: decimal): decimal {
    return degrees * RADIANS_PER_DEGREE;
}

/** radians -> degrees: to_degrees(pi) == 180 */
def to_degrees(radians: decimal): decimal {
    return radians * DEGREES_PER_RADIAN;
}

/** arc sine as a native number, in -pi/2 .. pi/2; NaN outside -1 .. 1 */
def asin(v: decimal): decimal { return math_call(v, 0, 0x6); }

/** arc cosine as a native number, in 0 .. pi; NaN outside -1 .. 1 */
def acos(v: decimal): decimal { return math_call(v, 0, 0x7); }

/** arc tangent as a native number, in -pi/2 .. pi/2 */
def atan(v: decimal): decimal { return math_call(v, 0, 0x8); }

/**
 * The angle of the point (x, y) seen from the origin, in -pi .. pi. Unlike
 * atan(y / x) it knows the quadrant and copes with x == 0:
 * atan2(1, 1) == pi/4, atan2(1, -1) == 3pi/4, atan2(-1, 0) == -pi/2.
 * Note the argument order: y first (the same as C, Java and Kotlin).
 */
def atan2(y: decimal, x: decimal): decimal { return math_call(y, x, 0x9); }

/** hyperbolic sine as a native number: (e^v - e^-v) / 2 */
def sinh(v: decimal): decimal { return math_call(v, 0, 0x3); }

/** hyperbolic cosine as a native number: (e^v + e^-v) / 2 */
def cosh(v: decimal): decimal { return math_call(v, 0, 0x4); }

/** hyperbolic tangent as a native number: sinh / cosh, always in -1 .. 1 */
def tanh(v: decimal): decimal { return math_call(v, 0, 0x5); }

/** secant: 1 / cos. Infinite where the cosine is 0. */
def sec(radians: decimal): decimal {
    return 1 / cos(radians);
}

/** cosecant: 1 / sin. Infinite where the sine is 0. */
def csc(radians: decimal): decimal {
    return 1 / sin(radians);
}

/** cotangent: cos / sin. Infinite where the sine is 0. */
def cot(radians: decimal): decimal {
    return cos(radians) / sin(radians);
}

/**
 * Inverse hyperbolic sine, defined for every number.
 * Formula: log(v + sqrt(v^2 + 1)), using asinh(-v) == -asinh(v) so the sum
 * inside the logarithm never cancels for negative v.
 */
def asinh(v: decimal): decimal {
    if(v < 0) return 0 - log((0 - v) + sqrt(v * v + 1));
    return log(v + sqrt(v * v + 1));
}

/**
 * Inverse hyperbolic cosine, defined for v >= 1 (NaN below 1).
 * Formula: log(v + sqrt(v^2 - 1)).
 */
def acosh(v: decimal): decimal {
    return log(v + sqrt(v * v - 1));
}

/**
 * Inverse hyperbolic tangent, defined for -1 < v < 1 (+-infinity at +-1,
 * NaN outside). Formula: log((1 + v) / (1 - v)) / 2.
 */
def atanh(v: decimal): decimal {
    return log((1 + v) / (1 - v)) / 2;
}

/**
 * Bring an angle in radians into 0 <= angle < 2 pi by adding or removing
 * whole turns: normalize_radians(-pi/2) == 3pi/2.
 */
def normalize_radians(radians: decimal): decimal {
    result : decimal = radians - floor(radians / TAU) * TAU;
    if(result >= TAU) result = 0;       // rounding can land exactly on a full turn
    return result;
}

/**
 * Bring an angle in degrees into 0 <= angle < 360:
 * normalize_degrees(-90) == 270, normalize_degrees(725) == 5.
 */
def normalize_degrees(degrees: decimal): decimal {
    result : decimal = degrees - floor(degrees / 360) * 360;
    if(result >= 360) result = 0;
    return result;
}

/**
 * The shortest way to turn from angle `from` to angle `to`, both in degrees,
 * as a signed angle in -180 .. 180 (positive = counter clockwise):
 * angle_difference_degrees(350, 10) == 20, angle_difference_degrees(10, 350) == -20.
 */
def angle_difference_degrees(from: decimal, to: decimal): decimal {
    difference : decimal = normalize_degrees(to - from);
    if(difference > 180) difference -= 360;
    return difference;
}
