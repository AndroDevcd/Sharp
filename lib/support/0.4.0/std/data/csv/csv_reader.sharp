mod std.data;

import ( std.io )

/**
 * Reads CSV (comma separated values) text: rows of fields.
 *
 *     rows := csv_reader.parse("name,age\nAda,36\n\"Smith, John\",41\n");
 *     rows.at(2).at(0)                  // Smith, John   (rows: list<csv_row>)
 *
 *     reader := new csv_reader(new file("people.csv").read_text());
 *     reader.set_separator(';');
 *     header := reader.read_header();
 *     while(reader.has_next()) {
 *         row := reader.next_row();
 *         name := row.at(reader.column_index("name"));
 *     }
 *
 * The format (RFC 4180, with the usual freedoms):
 *   - a row ends at a line end: "\n", "\r\n" or "\r"; the last row does not
 *     need one
 *   - fields are separated by the separator: ',' unless set_separator()
 *     says otherwise (';' and tab are common)
 *   - a field may be put in double quotes; then it can contain separators,
 *     line ends and - written twice - double quotes: "say ""hi""" is
 *     say "hi". Outside quotes nothing is special but separator and line
 *     end: a quote in the middle of an unquoted field is kept as it is, and
 *     spaces around fields are part of the fields (see set_trim()).
 *   - rows may have different numbers of fields
 *   - an empty line is skipped (see set_skip_empty_lines()); a line with
 *     only separators is a row of empty fields
 *
 * A row is a csv_row. Malformed text throws csv_exception with the
 * line and column: a quoted field that is never closed, or text right
 * behind a closing quote.
 *
 * The whole text is in memory; rows are taken from it one by one. Configure
 * the reader before reading the first row. Not thread safe.
 */
class csv_reader {
    private chars : _int8[]?;
    private count : decimal = 0;
    private pos : decimal = 0;

    private separator : decimal = ',';
    private quote : decimal = '"';
    private skip_empty : decimal = 1;
    private trim : decimal = 0;

    /** the names read by read_header(), or null */
    private header : list<string>?;
    /** how many rows next_row() has returned (the header counts) */
    private rows_read : decimal = 0;

    /** a reader for the CSV text `text` (null or "" is a text without rows) */
    csv_reader(text: string) {
        if(!io_strings.is_null(text)) {
            chars = text.data;
            count = sizeof(text.data);
        }
    }

    /** all rows of `text`, with the default settings (comma, double quote). Throws csv_exception for malformed text. */
    static def parse(text: string) : list<csv_row> {
        return new csv_reader(text).read_all();
    }

    /** all rows of `text` with the fields separated by `separator`. Throws csv_exception for malformed text or an impossible separator. */
    static def parse(text: string, separator: decimal) : list<csv_row> {
        reader := new csv_reader(text);
        reader.set_separator(separator);
        return reader.read_all();
    }

    /**
     * All rows of the file `source`, with the default settings.
     * Throws io_exception when the file does not exist or is a directory,
     * csv_exception for malformed text.
     */
    static def parse_file(source: file) : list<csv_row> {
        return new csv_reader(source.read_text()).read_all();
    }

    /**
     * Separate fields at the character `ch` instead of the comma. Returns
     * this reader.
     * Throws csv_exception when `ch` is the quote character or a line end.
     */
    def set_separator(ch: decimal) : csv_reader {
        if(ch == quote || ch == '\n' || ch == '\r') {
            throw new csv_exception("the separator cannot be the quote character or a line end");
        }
        separator = ch;
        return self;
    }

    /**
     * Use the character `ch` instead of the double quote to enclose fields
     * (the single quote is sometimes used). Returns this reader.
     * Throws csv_exception when `ch` is the separator or a line end.
     */
    def set_quote(ch: decimal) : csv_reader {
        if(ch == separator || ch == '\n' || ch == '\r') {
            throw new csv_exception("the quote character cannot be the separator or a line end");
        }
        quote = ch;
        return self;
    }

    /** skip lines without any character (true, the default) or report them as a row with one empty field (false). Returns this reader. */
    def set_skip_empty_lines(enabled: bool) : csv_reader {
        if(enabled) { skip_empty = 1; } else { skip_empty = 0; }
        return self;
    }

    /**
     * Remove spaces and tabs around unquoted fields (true) or keep fields
     * exactly as written (false, the default). Quoted fields are never
     * trimmed, but spaces between a quote and the separator are then
     * allowed. Returns this reader.
     */
    def set_trim(enabled: bool) : csv_reader {
        if(enabled) { trim = 1; } else { trim = 0; }
        return self;
    }

    /** step over empty lines when they are to be skipped */
    private def skip_empty_lines() {
        if(skip_empty) {
            while(pos < count && (chars[pos] == '\n' || chars[pos] == '\r')) {
                pos++;
            }
        }
    }

    /** true when there is another row to read */
    def has_next() : bool {
        skip_empty_lines();
        return pos < count;
    }

    /**
     * The next row. When read_header() was called before, the row knows
     * the column names (csv_row.field).
     * Throws illegal_state_exception when there are no more rows (ask
     * has_next() first) and csv_exception when the row is malformed.
     */
    def next_row() : csv_row {
        return new csv_row(next_fields(), header);
    }

    /**
     * The fields of the next row as a plain list.
     * Throws illegal_state_exception when there are no more rows and
     * csv_exception when the row is malformed.
     */
    def next_fields() : list<string> {
        skip_empty_lines();
        if(pos >= count) {
            throw new illegal_state_exception("csv_reader: no more rows");
        }

        row := new list<string>();
        buf := new char_buffer(64);
        while(true) {
            // ---- one field starts here
            buf.clear();
            if(trim) {
                while(pos < count && (chars[pos] == ' ' || chars[pos] == '\t') && chars[pos] != separator) {
                    pos++;
                }
            }

            if(pos < count && chars[pos] == quote) {
                opening : decimal = pos;
                pos++;
                closed : decimal = 0;
                while(pos < count) {
                    ch : decimal = chars[pos];
                    if(ch == quote) {
                        if(pos + 1 < count && chars[pos + 1] == quote) {
                            buf.append_char(quote); // a doubled quote is one quote
                            pos += 2;
                        } else {
                            pos++;
                            closed = 1;
                            break;
                        }
                    } else {
                        buf.append_char(ch);
                        pos++;
                    }
                }
                if(!closed) {
                    fail("the quoted field that starts here is never closed", opening);
                }
                if(trim) {
                    while(pos < count && (chars[pos] == ' ' || chars[pos] == '\t') && chars[pos] != separator) {
                        pos++;
                    }
                }
                if(pos < count && chars[pos] != separator && chars[pos] != '\n' && chars[pos] != '\r') {
                    fail("expected a separator or the end of the line after the closing quote", pos);
                }
                row.add(buf.build());
            } else {
                start : decimal = pos;
                while(pos < count && chars[pos] != separator && chars[pos] != '\n' && chars[pos] != '\r') {
                    pos++;
                }
                end : decimal = pos;
                if(trim) {
                    while(end > start && (chars[end - 1] == ' ' || chars[end - 1] == '\t')) {
                        end--;
                    }
                }
                if(end > start) {
                    row.add(new string(chars!!, start, end));
                } else {
                    row.add("");
                }
            }

            // ---- behind the field: a separator, a line end or the end of the text
            if(pos < count && chars[pos] == separator) {
                pos++;
                continue; // another field follows (maybe an empty one at the end of the text)
            }
            if(pos < count) {
                if(chars[pos] == '\r' && pos + 1 < count && chars[pos + 1] == '\n') {
                    pos += 2;
                } else {
                    pos++;
                }
            }
            break;
        }

        rows_read++;
        return row;
    }

    /**
     * All rows that have not been read yet. An
     * empty list when there are none.
     * Throws csv_exception when a row is malformed.
     */
    def read_all() : list<csv_row> {
        rows := new list<csv_row>();
        while(has_next()) {
            rows.add(next_row());
        }
        return rows;
    }

    /**
     * Read the next row as the header: the names of the columns. They are
     * remembered for column_index(). Returns the names.
     * Throws illegal_state_exception when there is no row to read,
     * csv_exception when it is malformed.
     */
    def read_header() : list<string> {
        names := next_fields();
        header = names;
        return names;
    }

    /**
     * The position (from 0) of the column called `name` in the header that
     * read_header() read, or -1 when there is no such column. Names are
     * compared exactly (case matters).
     * Throws illegal_state_exception when read_header() was not called.
     */
    def column_index(name: string) : decimal {
        if(header == null) {
            throw new illegal_state_exception("csv_reader: column_index() needs read_header() first");
        }
        total : decimal = header!!.size();
        for(i : decimal = 0; i < total; i++) {
            if(io_strings.equals(header!!.at(i), name)) {
                return i;
            }
        }
        return 0 - 1;
    }

    /** how many rows have been read so far (the header counts as one) */
    def get_rows_read() : decimal {
        return rows_read;
    }

    /** throw a csv_exception about the character at index `at` */
    private def fail(what: string, at: decimal) {
        line : decimal = 1;
        column : decimal = 1;
        for(i : decimal = 0; i < at && i < count; i++) {
            if(chars[i] == '\n') {
                line++;
                column = 1;
            } else if(chars[i] == '\r' && !(i + 1 < count && chars[i + 1] == '\n')) {
                line++;
                column = 1;
            } else {
                column++;
            }
        }
        throw new csv_exception(what + " at line " + io_strings.int_to_string(line) + ", column "
            + io_strings.int_to_string(column), line, column);
    }
}
