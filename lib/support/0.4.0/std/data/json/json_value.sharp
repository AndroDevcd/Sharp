mod std.data;

import ( std.io, std.math )

/**
 * One JSON value: null, a boolean, a number, a string, an array of values
 * or an object (names with values). A whole JSON document is a json_value
 * whose arrays and objects hold more json_values.
 *
 * Reading:
 *
 *     doc := json_parser.parse("{\"name\": \"Ada\", \"tags\": [\"a\", \"b\"], \"age\": 36}");
 *     name := doc.member("name").as_string();          // "Ada"
 *     age := doc.number_or("age", 0);                  // 36
 *     second := doc.member("tags").at(1).as_string();  // "b"
 *     missing := doc.find("email");                    // null
 *
 * Building:
 *
 *     doc := json_value.new_object();
 *     doc.put_string("name", "Ada").put_number("age", 36);
 *     tags := json_value.new_array();
 *     tags.add_string("a").add_string("b");
 *     doc.put("tags", tags);
 *     text := doc.to_string();     // {"name":"Ada","age":36,"tags":["a","b"]}
 *
 * One class is used for all six kinds; kind() / is_...() tell which one a
 * value is. Using a value as the wrong kind (as_number() on a string, at()
 * on an object, ...) throws json_exception.
 *
 * Objects keep their members in the order they were added, and a name
 * occurs only once: putting a name again replaces its value.
 *
 * The names an object hands out (key_at(), keys()) are COPIES: strings can
 * be changed in place, and the stored name may be shared with other objects
 * of the same document (the parser makes each name once).
 *
 * Numbers are native numbers (decimal): whole numbers are exact up to 2^53.
 *
 * Arrays and objects are changed in place and are shared, not copied, when
 * put into another value (deep_copy() makes an independent copy). Do not
 * put a value into itself: writing or comparing such a structure never
 * ends. Not thread safe.
 *
 * (`get` and `set` are keywords of the language, which is why the functions
 * are called at / member / find and put / put_at.)
 */
class json_value {
    /* the six kinds, as returned by kind() */
    static const kind_null : _int64 = 0;
    static const kind_bool : _int64 = 1;
    static const kind_number : _int64 = 2;
    static const kind_string : _int64 = 3;
    static const kind_array : _int64 = 4;
    static const kind_object : _int64 = 5;

    /** which of the six kinds this value is */
    private value_kind : _int64 = 0;
    /** the number of a number, and 1 / 0 for a boolean */
    private number : decimal = 0;
    /** the text of a string; null for the other kinds */
    private text : string?;
    /*
    * The elements of an array, or the member values of an object (in the
    * order of `names`): items[0 .. count - 1]. The arrays are made when the
    * first element arrives and are usually longer than `count`, so that
    * adding has room. (They used to be two list objects for every array and
    * object, each with an array of its own.)
    */
    private items : json_value[]?;
    /** the member names of an object: names[0 .. count - 1] */
    private names : string[]?;
    private count : _int64 = 0;
    private static const first_capacity : _int64 = 6;

    /*
    * Looking a name up by comparing it with every member is fine for small
    * objects and slow for large ones, so objects with many members get a
    * hash table: `slots` holds member positions + 1 (0 = empty slot), found
    * by hashing the name and probing forward. It is built when needed and
    * thrown away when a member is removed.
    */
    private slots : _int32[]?;
    private static const index_threshold : _int64 = 12;

    private json_value(kind: _int64) {
        value_kind = kind;
    }

    /* ------------------------------------------------------------------ */
    /* creating                                                            */
    /* ------------------------------------------------------------------ */

    /** a new null value */
    static def of_null() : json_value {
        return new json_value(kind_null);
    }

    /** a new boolean value */
    static def of_bool(value: bool) : json_value {
        v := new json_value(kind_bool);
        if(value) {
            v.number = 1;
        }
        return v;
    }

    /**
     * A new number value. NaN and infinities can be stored but JSON has no
     * way to write them: json_writer throws for them.
     */
    static def of_number(value: decimal) : json_value {
        v := new json_value(kind_number);
        v.number = value;
        return v;
    }

    /** a new string value (a null string becomes "") */
    static def of_string(value: string) : json_value {
        v := new json_value(kind_string);
        if(!io_strings.is_null(value)) {
            v.text = value;
        } else {
            v.text = "";
        }
        return v;
    }

    /** a new, empty array */
    static def new_array() : json_value {
        return new json_value(kind_array);
    }

    /** a new, empty object */
    static def new_object() : json_value {
        return new json_value(kind_object);
    }

    /* ------------------------------------------------------------------ */
    /* kind                                                                */
    /* ------------------------------------------------------------------ */

    /** the kind of this value: one of json_value.kind_null, kind_bool, kind_number, kind_string, kind_array, kind_object */
    def kind() : _int64 {
        return value_kind;
    }

    /** the kind as a word: "null", "boolean", "number", "string", "array" or "object" */
    def kind_name() : string {
        return name_of_kind(value_kind);
    }

    private static def name_of_kind(kind: _int64) : string {
        if(kind == kind_null) return "null";
        if(kind == kind_bool) return "boolean";
        if(kind == kind_number) return "number";
        if(kind == kind_string) return "string";
        if(kind == kind_array) return "array";
        return "object";
    }

    def is_null() : bool { return value_kind == kind_null; }
    def is_bool() : bool { return value_kind == kind_bool; }
    def is_number() : bool { return value_kind == kind_number; }
    def is_string() : bool { return value_kind == kind_string; }
    def is_array() : bool { return value_kind == kind_array; }
    def is_object() : bool { return value_kind == kind_object; }

    /** throw unless this value is of the given kind */
    private def expect_kind(kind: _int64) {
        if(value_kind != kind) {
            throw new json_exception("expected a JSON " + name_of_kind(kind) + " but this value is a "
                + name_of_kind(value_kind));
        }
    }

    /* ------------------------------------------------------------------ */
    /* simple values                                                       */
    /* ------------------------------------------------------------------ */

    /** the value of a boolean. Throws json_exception when this is not a boolean. */
    def as_bool() : bool {
        expect_kind(kind_bool);
        return number != 0;
    }

    /** the value of a number. Throws json_exception when this is not a number. */
    def as_number() : decimal {
        expect_kind(kind_number);
        return number;
    }

    /**
     * The value of a number that has to be whole (a count, an index, an
     * id). Throws json_exception when this is not a number or has a
     * fraction (2.5), is NaN or infinite.
     */
    def as_int() : decimal {
        expect_kind(kind_number);
        if(number - number != 0 || floor(number).value != number) {
            throw new json_exception("expected a whole number but the value is " + io_strings.number_to_string(number));
        }
        return number;
    }

    /** the text of a string. Throws json_exception when this is not a string. */
    def as_string() : string {
        expect_kind(kind_string);
        return text!!;
    }

    /* ------------------------------------------------------------------ */
    /* arrays and objects                                                  */
    /* ------------------------------------------------------------------ */

    /**
     * The number of elements of an array or of members of an object.
     * Throws json_exception for the other kinds.
     */
    def size() : _int64 {
        if(value_kind != kind_array && value_kind != kind_object) {
            throw new json_exception("expected a JSON array or object but this value is a " + name_of_kind(value_kind));
        }
        return count;
    }

    /** true for an array without elements or an object without members. Throws json_exception for the other kinds. */
    def is_empty() : bool {
        return size() == 0;
    }

    /**
     * Remove all elements of an array or all members of an object.
     * Throws json_exception for the other kinds.
     */
    def clear() {
        size();
        items = null;
        names = null;
        slots = null;
        count = 0;
    }

    /* ---- arrays ---- */

    /**
     * Add `value` at the end of this array (null adds a JSON null).
     * Returns this array so calls can be chained.
     * Throws json_exception when this is not an array.
     */
    def add(value: json_value?) : json_value {
        expect_kind(kind_array);
        make_room();
        if(value == null) {
            items[count] = of_null();
        } else {
            items[count] = value!!;
        }
        count++;
        return self;
    }

    /** add a string at the end of this array; returns this array. Throws json_exception when this is not an array. */
    def add_string(value: string) : json_value {
        return add(of_string(value));
    }

    /** add a number at the end of this array; returns this array. Throws json_exception when this is not an array. */
    def add_number(value: decimal) : json_value {
        return add(of_number(value));
    }

    /** add a boolean at the end of this array; returns this array. Throws json_exception when this is not an array. */
    def add_bool(value: bool) : json_value {
        return add(of_bool(value));
    }

    /** add a null at the end of this array; returns this array. Throws json_exception when this is not an array. */
    def add_null() : json_value {
        return add(of_null());
    }

    /**
     * The element at `index` of this array (0 is the first).
     * Throws json_exception when this is not an array or the index is not
     * in 0 .. size() - 1.
     */
    def at(index: decimal) : json_value {
        expect_kind(kind_array);
        check_index(index);
        return items[index];
    }

    /**
     * Replace the element at `index` of this array (null stores a JSON
     * null). Returns the element that was there.
     * Throws json_exception when this is not an array or the index is not
     * in 0 .. size() - 1.
     */
    def put_at(index: decimal, value: json_value?) : json_value {
        expect_kind(kind_array);
        check_index(index);
        old := items[index];
        if(value == null) {
            items[index] = of_null();
        } else {
            items[index] = value!!;
        }
        return old;
    }

    /**
     * Insert `value` in front of the element at `index` of this array
     * (index == size() adds at the end). Returns this array.
     * Throws json_exception when this is not an array or the index is not
     * in 0 .. size().
     */
    def insert_at(index: decimal, value: json_value) : json_value {
        expect_kind(kind_array);
        if(index < 0 || index > count || floor(index).value != index) {
            throw new json_exception("index " + io_strings.number_to_string(index) + " is outside an array of "
                + io_strings.int_to_string(count) + " elements");
        }
        make_room();
        for(i : _int64 = count; i > index; i--) {
            items[i] = items[i - 1];
        }
        items[index] = value;
        count++;
        return self;
    }

    /**
     * Remove the element at `index` of this array and return it; the
     * elements behind it move up.
     * Throws json_exception when this is not an array or the index is not
     * in 0 .. size() - 1.
     */
    def remove_at(index: decimal) : json_value {
        expect_kind(kind_array);
        check_index(index);
        removed := items[index];
        close_gap(index);
        return removed;
    }

    /** make sure one more element fits (and one more name, for an object) */
    private def make_room() {
        capacity : _int64 = sizeof(items);
        if(count < capacity) {
            return;
        }

        bigger : _int64 = first_capacity;
        if(capacity > 0) {
            bigger = capacity * 2;
        }
        grown := new json_value[bigger];
        for(i : _int64 = 0; i < count; i++) {
            grown[i] = items[i];
        }
        items = grown;
        if(value_kind == kind_object) {
            grown_names := new string[bigger];
            for(k : _int64 = 0; k < count; k++) {
                grown_names[k] = names[k];
            }
            names = grown_names;
        }
    }

    /** take the element at `position` out: those behind it move up (the names too, for an object) */
    private def close_gap(position: _int64) {
        count--;
        for(i : _int64 = position; i < count; i++) {
            items[i] = items[i + 1];
        }
        excuse no_value : json_value;
        items[count] = no_value;
        if(value_kind == kind_object) {
            for(k : _int64 = position; k < count; k++) {
                names[k] = names[k + 1];
            }
            excuse no_name : string;
            names[count] = no_name;
        }
    }

    private def check_index(index: decimal) {
        if(index < 0 || index >= count || floor(index).value != index) {
            throw new json_exception("index " + io_strings.number_to_string(index) + " is outside an array of "
                + io_strings.int_to_string(count) + " elements");
        }
    }

    /* ---- objects ---- */

    /** a hash of the characters of `name`, between 0 and 2^31 */
    private static def hash_name(name: string) : _int64 {
        h : _int64 = 7;
        n : _int64 = sizeof(name.data);
        for(i : _int64 = 0; i < n; i++) {
            h = (h * 31 + (name.data[i] & 0xff)) % 2147483647;
        }
        return h;
    }

    /** (re)build the hash table over all members */
    private def build_index() {
        capacity : _int64 = 32;
        while(capacity < count * 2 + 2) {
            capacity = capacity * 2;
        }
        table := new _int32[capacity];
        for(i : _int64 = 0; i < count; i++) {
            slot : _int64 = hash_name(names[i]) % capacity;
            while(table[slot] != 0) {
                slot++;
                if(slot >= capacity) {
                    slot = 0;
                }
            }
            table[slot] = i + 1;
        }
        slots = table;
    }

    /** the position of the member `name`, or -1 when this object has no such member */
    private def index_of_name(name: string) : _int64 {
        if(count < index_threshold) {
            for(i : _int64 = 0; i < count; i++) {
                if(io_strings.equals(names[i], name)) {
                    return i;
                }
            }
            return 0 - 1;
        }

        if(slots == null) {
            build_index();
        }
        capacity : _int64 = sizeof(slots);
        slot : _int64 = hash_name(name) % capacity;
        while(slots[slot] != 0) {
            position : _int64 = slots[slot] - 1;
            if(io_strings.equals(names[position], name)) {
                return position;
            }
            slot++;
            if(slot >= capacity) {
                slot = 0;
            }
        }
        return 0 - 1;
    }

    /**
     * Set the member `name` of this object to `value` (null stores a JSON
     * null). A member with that name is replaced and keeps its place; a new
     * one is added at the end. Returns this object so calls can be chained.
     * Throws json_exception when this is not an object.
     */
    def put(name: string, value: json_value?) : json_value {
        expect_kind(kind_object);
        position : _int64 = index_of_name(name);
        added : bool = position < 0;
        if(added) {
            make_room();
            position = count;
            names[position] = name;
            count++;
        }
        if(value == null) {
            items[position] = of_null();
        } else {
            items[position] = value!!;
        }

        if(added && slots != null) {
            // keep the hash table in step, or start over when it gets full
            capacity : _int64 = sizeof(slots);
            if(count * 2 + 2 > capacity) {
                slots = null;
            } else {
                slot : _int64 = hash_name(name) % capacity;
                while(slots[slot] != 0) {
                    slot++;
                    if(slot >= capacity) {
                        slot = 0;
                    }
                }
                slots[slot] = count;
            }
        }
        return self;
    }

    /** set the member `name` to a string; returns this object. Throws json_exception when this is not an object. */
    def put_string(name: string, value: string) : json_value {
        return put(name, of_string(value));
    }

    /** set the member `name` to a number; returns this object. Throws json_exception when this is not an object. */
    def put_number(name: string, value: decimal) : json_value {
        return put(name, of_number(value));
    }

    /** set the member `name` to a boolean; returns this object. Throws json_exception when this is not an object. */
    def put_bool(name: string, value: bool) : json_value {
        return put(name, of_bool(value));
    }

    /** set the member `name` to null; returns this object. Throws json_exception when this is not an object. */
    def put_null(name: string) : json_value {
        return put(name, of_null());
    }

    /** true when this object has a member `name` (also when its value is null). Throws json_exception when this is not an object. */
    def has(name: string) : bool {
        expect_kind(kind_object);
        return index_of_name(name) >= 0;
    }

    /**
     * The value of the member `name`, or null (no object at all) when this
     * object has no such member. A member whose value is a JSON null gives
     * a json_value for which is_null() is true.
     * Throws json_exception when this is not an object.
     */
    def find(name: string) : json_value? {
        expect_kind(kind_object);
        position : _int64 = index_of_name(name);
        if(position < 0) {
            return null;
        }
        return items[position];
    }

    /**
     * The value of the member `name`, which has to exist.
     * Throws json_exception when this is not an object or has no such
     * member.
     */
    def member(name: string) : json_value {
        expect_kind(kind_object);
        position : _int64 = index_of_name(name);
        if(position < 0) {
            throw new json_exception("the object has no member \"" + name + "\"");
        }
        return items[position];
    }

    /**
     * The text of the string member `name`, or `fallback` when there is no
     * such member or it is not a string.
     * Throws json_exception when this is not an object.
     */
    def string_or(name: string, fallback: string) : string {
        found := find(name);
        if(found == null || found!!.value_kind != kind_string) {
            return fallback;
        }
        return found!!.text!!;
    }

    /**
     * The value of the number member `name`, or `fallback` when there is no
     * such member or it is not a number.
     * Throws json_exception when this is not an object.
     */
    def number_or(name: string, fallback: decimal) : decimal {
        found := find(name);
        if(found == null || found!!.value_kind != kind_number) {
            return fallback;
        }
        return found!!.number;
    }

    /**
     * The value of the boolean member `name`, or `fallback` when there is
     * no such member or it is not a boolean.
     * Throws json_exception when this is not an object.
     */
    def bool_or(name: string, fallback: bool) : bool {
        found := find(name);
        if(found == null || found!!.value_kind != kind_bool) {
            return fallback;
        }
        return found!!.number != 0;
    }

    /**
     * Remove the member `name`. Returns true when there was one.
     * Throws json_exception when this is not an object.
     */
    def remove(name: string) : bool {
        expect_kind(kind_object);
        position : _int64 = index_of_name(name);
        if(position < 0) {
            return false;
        }
        close_gap(position);
        slots = null; // the positions behind the removed member changed
        return true;
    }

    /**
     * The member names of this object in the order the members were added
     * (a new list; changing it does not change the object).
     * Throws json_exception when this is not an object.
     */
    def keys() : list<string> {
        expect_kind(kind_object);
        result := new list<string>();
        for(i : _int64 = 0; i < count; i++) {
            result.add(new string(names[i]));
        }
        return result;
    }

    /**
     * The name of the member at position `index` (0 is the first that was
     * added). Together with value_at() this walks an object without making
     * a list. The name is a copy: changing it does not change the object.
     * Throws json_exception when this is not an object or the index is not
     * in 0 .. size() - 1.
     */
    def key_at(index: decimal) : string {
        expect_kind(kind_object);
        check_index(index);
        return new string(names[index]);
    }

    /**
     * The name of the member at position `index` WITHOUT a copy, for code
     * that only reads it (json_writer). The string is the stored one and
     * may be shared with other objects: never change it.
     * Throws json_exception when this is not an object or the index is not
     * in 0 .. size() - 1.
     */
    def shared_key_at(index: decimal) : string {
        expect_kind(kind_object);
        check_index(index);
        return names[index];
    }

    /**
     * The element at position `index` of an array, or the value of the
     * member at that position of an object.
     * Throws json_exception for the other kinds and when the index is not
     * in 0 .. size() - 1.
     */
    def value_at(index: decimal) : json_value {
        size();
        check_index(index);
        return items[index];
    }

    /**
     * Follow a path of member names and array indexes down from this
     * value: "server.ports[0]" is member "server", then its member "ports",
     * then element 0. Names are separated by periods, indexes are written
     * in square brackets; a path may start with an index ("[2].name"). An
     * empty path gives this value.
     *
     * Returns null when the path leads nowhere: a member is missing, an
     * index is outside its array, or a step is tried on a value of the
     * wrong kind. (Member names that contain '.' or '[' cannot be reached
     * this way; use member().)
     *
     * Throws json_exception when the path itself is malformed ("a..b",
     * "a[x]", "a[1").
     */
    def at_path(steps: string) : json_value? {
        current : json_value? = self;
        n : _int64 = sizeof(steps.data);
        i : _int64 = 0;
        while(i < n) {
            ch : _int64 = steps.data[i];
            if(ch == '[') {
                close : _int64 = io_strings.index_of(steps, ']', i);
                digits := io_strings.slice(steps, i + 1, close);
                if(close < 0 || !io_strings.is_int(digits) || steps.data[i + 1] == '-' || steps.data[i + 1] == '+') {
                    throw new json_exception("malformed path \"" + steps + "\": expected [number] at character "
                        + io_strings.int_to_string(i));
                }
                index : _int64 = io_strings.parse_int(digits);
                i = close + 1;
                if(current != null) {
                    if(current!!.value_kind != kind_array || index >= current!!.count) {
                        current = null;
                    } else {
                        current = current!!.items[index];
                    }
                }
            } else {
                if(ch == '.') {
                    i++;
                    if(i == 1) {
                        throw new json_exception("malformed path \"" + steps + "\": it starts with a period");
                    }
                }
                start : _int64 = i;
                while(i < n && steps.data[i] != '.' && steps.data[i] != '[') {
                    i++;
                }
                if(i == start) {
                    throw new json_exception("malformed path \"" + steps + "\": a name is missing at character "
                        + io_strings.int_to_string(start));
                }
                name := io_strings.slice(steps, start, i);
                if(current != null) {
                    if(current!!.value_kind != kind_object) {
                        current = null;
                    } else {
                        current = current!!.find(name);
                    }
                }
            }
        }
        return current;
    }

    /* ------------------------------------------------------------------ */
    /* whole trees                                                         */
    /* ------------------------------------------------------------------ */

    /**
     * True when `other` is the same JSON: the same kind and value, arrays
     * with equal elements in the same order, objects with the same names
     * and equal values - the order of the members does not matter.
     * Numbers compare by value (1 equals 1.0). null is equal to nothing.
     *
     * Works without recursion, so deeply nested values are fine.
     */
    def equals_value(other: json_value?) : bool {
        if(other == null) {
            return false;
        }

        // pairs of values that still have to be compared
        left := new list<json_value>();
        right := new list<json_value>();
        left.add(self);
        right.add(other!!);

        while(left.size() > 0) {
            a := left.pop_last();
            b := right.pop_last();
            if(a.value_kind != b.value_kind) {
                return false;
            }

            if(a.value_kind == kind_bool || a.value_kind == kind_number) {
                if(a.number != b.number) {
                    return false;
                }
            } else if(a.value_kind == kind_string) {
                if(!io_strings.equals(a.text!!, b.text!!)) {
                    return false;
                }
            } else if(a.value_kind == kind_array) {
