mod std;

/**
 * Extra methods for the `bool` class, added with a `mutate` declaration;
 * std/primatives.sharp itself is unchanged.
 *
 *     ready : bool = true;
 *     ready.negate().value                // false
 *     ready.xor(false).value              // true
 *     ready.to_var()                      // 1
 *     bool.from_string("false").value     // false
 *     bool.from_string_or_null("maybe")   // null
 *
 * The methods return new bool objects; the object they are called on is
 * not changed.
 */
mutate bool {

    /** the opposite value: true becomes false and false becomes true */
    def negate(): bool {
        return value == 0;
    }

    /** true when exactly ONE of this value and `other` is true ("exclusive or") */
    def xor(other: bool): bool {
        return (value != 0) != (other.value != 0);
    }

    /** true when this value and `other` are both true or both false */
    def same_as(other: bool): bool {
        return (value != 0) == (other.value != 0);
    }

    /** 1 for true and 0 for false, as a native number */
    def to_var(): decimal {
        if(value != 0) return 1;
        return 0;
    }

    /**
     * Read "true" or "false" (in any mix of capital and small letters).
     * Throws illegal_argument_exception for any other text.
     */
    static def from_string(text: string): bool {
        result := from_string_or_null(text);
        if((result as object) == null)
            throw new illegal_argument_exception("not a boolean (expected true or false): " + text);
        return result!!;
    }

    /**
     * Read "true" or "false" (in any mix of capital and small letters), or
     * return null when the text is neither.
     */
    static def from_string_or_null(text: string): bool? {
        if(matches(text, "true").value) return new bool(1);
        if(matches(text, "false").value) return new bool(0);
        return null;
    }

    /** true when `text` equals the small-letter `word`, ignoring the case of the letters in `text` */
    private static def matches(text: string, word: string): bool {
        length : decimal = word.size().value;
        if(text.size() != length) return false;

        for(i : decimal = 0; i < length; i++) {
            ch : decimal = text.at(i).value;
            if(ch >= 'A' && ch <= 'Z') ch = ch + 32;
            if(ch != word.at(i).value) return false;
        }
        return true;
    }
}
