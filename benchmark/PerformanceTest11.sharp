mod app;


import std;


/**
 * Created by BraxtonN on 7/17/2018.
 *
 * This program was created to illustrate the speed of n exponential loop
 * done n times
 *
 */
def main(string[] args) : decimal {
    decimal out;
    for(decimal i =0; i <= 100000; i++)
        for(decimal j = 0; j <= 10000; j++)
            out+=i+j;


    println("" + out);
}
