mod app;


import std;


/**
 * Created by BraxtonN on 7/17/2018.
 *
 * This program was created to illustrate the speed of using the native system
 * copy methods vs doing it in sharp
 *
 */
def main(string[] args) : decimal {
    decimal[] lst1 = new decimal[10000000];
    decimal[] lst2 = new decimal[10000000];

    decimal past = getUtcTimeInMills(), now;
    for(decimal i = 0; i < sizeof(lst1); i++) {
        lst2[i] = lst1[i];
    }

    now = getUtcTimeInMills();
    println("for loop (" + (now-past) + ") ms");

    past = getUtcTimeInMills();
    lst2 = (decimal[])memcpy(lst1, 0, sizeof(lst1));

    now = getUtcTimeInMills();
    println("memcpy (" + (now-past) + ") ms");
}
