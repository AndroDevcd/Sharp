mod app;


import std;

/**
 * Created by BraxtonN on 7/17/2018.
 *
 * This program was created to illustrate the speed of iterating through an array
 * via for loop or foreach
 *
 * for (438.549) ms
 * foreach (338.869) ms
 *
 * Program finished with exit code 0
 * Compiled in 809779us & 809ms
 *
 */
def main(string[] args) : decimal {
    decimal[] arry = new decimal[10000000];
    decimal past = getUtcTimeInMills(), now;
    decimal val;
    for(decimal i = 0; i < sizeof(arry); i++) {
        val = arry[i];
    }
    now = getUtcTimeInMills();
    println("for (" + (now-past) + ") ms");

    past = getUtcTimeInMills();
    foreach(decimal n : arry) {
        val = n;
    }
    now = getUtcTimeInMills();
    println("foreach (" + (now-past) + ") ms");
}
