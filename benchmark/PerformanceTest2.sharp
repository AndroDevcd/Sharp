mod app;

import std;

private static def addUpTo(decimal dest) : decimal {
  decimal sum = 0;
  for (decimal i = 1; i <= dest; i++) {
    sum += i;
  }
  return sum;
    //return (_uint64)(((_int64)dest * (_int64)(dest + 1)) >> 1);
}

private static def rollAverage(decimal dest) : decimal {
    decimal avg = 0;
    for(decimal i = 0; i < dest; i++) {
        avg = (avg + addUpTo(i)) / 2;
    }

    return avg;
}

/**
*
*/
public static def main(string[] args) : decimal {
    decimal n = string.parseInt(args[0]);
    decimal end = string.parseInt(args[1]);

    for(decimal i = n; i < end; i++) {
        println("rollAvg(" + i + ") = " + rollAverage(i));
    }
    return 1;
}