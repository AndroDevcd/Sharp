def test_calls(decimal loops) {

    for (decimal i = 0; i < loops; i++) {
        // 20 calls
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
        foo(1, 2, 3, 4);
    }
}

/**
 * Created by BraxtonN on 7/17/2018.
 *
 * This program was created to illustrate the speed of calling functions in sharp
 *
 */
def main(string[] args) : decimal {
    decimal past = getUtcTimeInMills(), now;
    test_calls(100);

    label:
    now = getUtcTimeInMills();
    println("calls (" + (now-past) + ") ms");
}
