mod main;

import ( std.io, std.math, std.text )

/**
 * Writes the input of the json test, like generate_json.rb of
 * github.com/kostya/benchmarks:
 *
 *      sharp generate_json <file> [entries]       (the original: 524288 entries)
 *
 *      {
 *        "coordinates": [
 *          {
 *            "x": <a tiny negative number>,
 *            "y": <a huge number>,
 *            "z": <a number between 0 and 1>,
 *            "name": "<six letters> <a number below 10000>",
 *            "opts": { "1": [ 1, true ] }
 *          },
 *          ...
 *        ],
 *        "info": "some info"
 *      }
 *
 * The numbers come from a small generator with a fixed start value, so the
 * file - and the averages the test prints - are the same on every run.
 *
 * The text is written in pieces so the whole file is never in memory: each
 * piece goes to "<file>.part" and the shell appends it (`cat part >> file`).
 * The library's append_text() cannot be used for a file this large - the
 * runtime has no "append" call, so it reads the whole file and writes it back.
 */

seed : decimal = 42;

/** the next pseudo random whole number, 1 .. 2147483646 (Lehmer / "minstd") */
def next() : decimal {
    seed = (seed * 48271) % 2147483647;
    return seed;
}

/** a pseudo random number in [0, 1) */
def unit() : decimal {
    return next() / 2147483647;
}

def main(args: string[]) {
    if(sizeof(args) < 1) {
        println("usage: sharp generate_json <file> [entries]");
        exit(2);
    }

    entries : decimal = 524288;
    if(sizeof(args) > 1) { entries = args[1].to_int(); }

    out := new file(args[0]);
    out.write_text("{\n  \"coordinates\": [\n");

    part := new file(args[0] + ".part");
    append_command := "cat '" + args[0] + ".part' >> '" + args[0] + "'";

    chunk := new string_builder();
    for(i : decimal = 0; i < entries; i++) {
        chunk += "    {\n      \"x\": -";
        chunk += number_to_fixed(unit() * 9 + 1, 15);
        chunk += "e-30,\n      \"y\": ";
        chunk += number_to_fixed(unit() * 9 + 1, 15);
        chunk += "e+30,\n      \"z\": ";
        chunk += number_to_fixed(unit(), 16);
        chunk += ",\n      \"name\": \"";
        for(letter : decimal = 0; letter < 6; letter++) {
            chunk.append_char('a' + next() % 26);
        }
        chunk += " ";
        chunk += number_to_fixed(next() % 10000, 0);
        chunk += "\",\n      \"opts\": {\n        \"1\": [\n          1,\n          true\n        ]\n      }\n    }";
        if(i + 1 < entries) { chunk += ","; }
        chunk += "\n";

        if(i % 512 == 511) {
            part.write_text(chunk.to_string()!!);
            sys(append_command);
            chunk = new string_builder();
        }
    }

    chunk += "  ],\n  \"info\": \"some info\"\n}\n";
    part.write_text(chunk.to_string()!!);
    sys(append_command);
    sys("rm -f '" + args[0] + ".part'");

    println("wrote " + number_to_fixed(entries, 0) + " entries to " + args[0]);
}
