mod main;

import ( std.io, std.math, std.collections )

/**
 * Brainfuck interpreter - the "brainfuck" test of github.com/kostya/benchmarks.
 *
 *      sharp bf <program.b>
 *
 * The program text is parsed once into a tree of operations (a loop holds its
 * body as a nested list), then run on a tape that doubles when the pointer
 * runs off its end. Output is not printed: it goes into a Fletcher-16 style
 * checksum (the "QUIET" mode of the original), printed at the end.
 *
 * Measured: running the program. Not measured: the self test, reading the
 * file. The last line is `time: <seconds>`.
 */

/** one operation: 1 = add `val` to the cell, 2 = move by `val`, 3 = loop over `body`, 4 = print the cell */
class op {
    kind : var;
    val : var;
    body : op[]?;

    op(k: var, v: var) {
        kind = k;
        val = v;
    }

    op(loop_body: op[]) {
        kind = 3;
        val = 0;
        body = loop_body;
    }
}

/** the program text and how far it has been read */
class source {
    text : _int8[];
    pos : var = 0;

    source(t: _int8[]) {
        text = t;
    }
}

class tape {
    cells : var[] = new var[1];
    pos : var = 0;

    def cell() : var {
        return cells[pos];
    }

    def inc(x: var) {
        cells[pos] = cells[pos] + x;
    }

    def move(x: var) {
        pos += x;
        while(pos >= sizeof(cells)) {
            bigger := new var[sizeof(cells) * 2];
            for(i : var = 0; i < sizeof(cells); i++) {
                bigger[i] = cells[i];
            }
            cells = bigger;
        }
    }
}

class printer {
    sum1 : var = 0;
    sum2 : var = 0;

    def put(n: var) {
        sum1 = (sum1 + n) % 255;
        sum2 = (sum2 + sum1) % 255;
    }

    def checksum() : var {
        return (sum2 << 8) | sum1;
    }
}

def parse(src: source) : op[] {
    ops := new list<op>();
    length : var = sizeof(src.text);

    while(src.pos < length) {
        c : var = src.text[src.pos];
        src.pos++;

        if(c == '+') { ops.add(new op(1, 1)); }
        else if(c == '-') { ops.add(new op(1, 0 - 1)); }
        else if(c == '>') { ops.add(new op(2, 1)); }
        else if(c == '<') { ops.add(new op(2, 0 - 1)); }
        else if(c == '.') { ops.add(new op(4, 0)); }
        else if(c == '[') { ops.add(new op(parse(src))); }
        else if(c == ']') { break; }
    }

    return ops.to_array();
}

def run(program: op[], t: tape, p: printer) {
    count : var = sizeof(program);
    for(i : var = 0; i < count; i++) {
        o := program[i];
        k : var = o.kind;

        if(k == 1) { t.inc(o.val); }
        else if(k == 2) { t.move(o.val); }
        else if(k == 3) {
            body := o.body!!;
            while(t.cell() > 0) {
                run(body, t, p);
            }
        }
        else { p.put(t.cell()); }
    }
}

def run_text(text: string, p: printer) {
    program := parse(new source(text.to_bytes()));
    run(program, new tape(), p);
}

/** the interpreter must print "Hello World!\n" for the classic program */
def verify() {
    hello := "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.";
    left := new printer();
    run_text(hello, left);

    right := new printer();
    hello_text := "Hello World!\n";
    expected := hello_text.to_bytes();
    for(i : var = 0; i < sizeof(expected); i++) {
        right.put(expected[i]);
    }

    if(left.checksum() != right.checksum()) {
        println("self test failed: " + left.checksum() + " != " + right.checksum());
        exit(1);
    }
}

def main(args: string[]) {
    if(sizeof(args) < 1) {
        println("usage: sharp bf <program.b>");
        exit(2);
    }

    verify();
    text := new file(args[0]).read_text();
    p := new printer();

    start : var = nano_time().value;
    run_text(text, p);
    seconds : var = (nano_time().value - start) / 1000000000;

    println("Output checksum: " + number_to_fixed(p.checksum(), 0));
    println("time: " + number_to_fixed(seconds, 3));
}
