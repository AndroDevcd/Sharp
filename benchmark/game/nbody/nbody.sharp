mod main;

import ( std.math, std.text )

/**
 * n-body - the Benchmarks Game.  The sun and the four big planets, moved
 * `steps` times by a simple symplectic integrator; prints the energy of the
 * system before and after.
 *
 *      sharp nbody <steps>
 */

pi : decimal = 3.141592653589793;
solar_mass : decimal = 4 * pi * pi;
days_per_year : decimal = 365.24;
bodies : _int64 = 5;

class planets {
    x : decimal[] = new decimal[5];
    y : decimal[] = new decimal[5];
    z : decimal[] = new decimal[5];
    vx : decimal[] = new decimal[5];
    vy : decimal[] = new decimal[5];
    vz : decimal[] = new decimal[5];
    mass : decimal[] = new decimal[5];

    def put(i: _int64, px: decimal, py: decimal, pz: decimal, pvx: decimal, pvy: decimal, pvz: decimal, pmass: decimal) {
        x[i] = px;
        y[i] = py;
        z[i] = pz;
        vx[i] = pvx * days_per_year;
        vy[i] = pvy * days_per_year;
        vz[i] = pvz * days_per_year;
        mass[i] = pmass * solar_mass;
    }

    planets() {
        put(0, 0, 0, 0, 0, 0, 0, 1);
        put(1, 4.84143144246472090e+00, 0 - 1.16032004402742839e+00, 0 - 1.03622044471123109e-01,
               1.66007664274403694e-03, 7.69901118419740425e-03, 0 - 6.90460016972063023e-05, 9.54791938424326609e-04);
        put(2, 8.34336671824457987e+00, 4.12479856412430479e+00, 0 - 4.03523417114321381e-01,
               0 - 2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05, 2.85885980666130812e-04);
        put(3, 1.28943695621391310e+01, 0 - 1.51111514016986312e+01, 0 - 2.23307578892655734e-01,
               2.96460137564761618e-03, 2.37847173959480950e-03, 0 - 2.96589568540237556e-05, 4.36624404335156298e-05);
        put(4, 1.53796971148509165e+01, 0 - 2.59193146099879641e+01, 1.79258772950371181e-01,
               2.68067772490389322e-03, 1.62824170038242295e-03, 0 - 9.51592254519715870e-05, 5.15138902046611451e-05);
    }

    def offset_momentum() {
        px : decimal = 0;
        py : decimal = 0;
        pz : decimal = 0;
        for(i : _int64 = 0; i < bodies; i++) {
            px += vx[i] * mass[i];
            py += vy[i] * mass[i];
            pz += vz[i] * mass[i];
        }
        vx[0] = 0 - px / solar_mass;
        vy[0] = 0 - py / solar_mass;
        vz[0] = 0 - pz / solar_mass;
    }

    def energy() : decimal {
        e : decimal = 0;
        for(i : _int64 = 0; i < bodies; i++) {
            e += 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
            for(j : _int64 = i + 1; j < bodies; j++) {
                dx : decimal = x[i] - x[j];
                dy : decimal = y[i] - y[j];
                dz : decimal = z[i] - z[j];
                e -= (mass[i] * mass[j]) / sqrt(dx * dx + dy * dy + dz * dz);
            }
        }
        return e;
    }

    def advance(dt: decimal) {
        for(i : _int64 = 0; i < bodies; i++) {
            for(j : _int64 = i + 1; j < bodies; j++) {
                dx : decimal = x[i] - x[j];
                dy : decimal = y[i] - y[j];
                dz : decimal = z[i] - z[j];
                distance2 : decimal = dx * dx + dy * dy + dz * dz;
                mag : decimal = dt / (distance2 * sqrt(distance2));
                vx[i] -= dx * mass[j] * mag;
                vy[i] -= dy * mass[j] * mag;
                vz[i] -= dz * mass[j] * mag;
                vx[j] += dx * mass[i] * mag;
                vy[j] += dy * mass[i] * mag;
                vz[j] += dz * mass[i] * mag;
            }
        }
        for(i : _int64 = 0; i < bodies; i++) {
            x[i] += dt * vx[i];
            y[i] += dt * vy[i];
            z[i] += dt * vz[i];
        }
    }
}

def main(args: string[]) {
    steps : _int64 = 1000;
    if(sizeof(args) > 0) { steps = args[0].to_int(); }

    system := new planets();
    system.offset_momentum();
    println(number_to_fixed(system.energy(), 9));
    for(i : _int64 = 0; i < steps; i++) {
        system.advance(0.01);
    }
    println(number_to_fixed(system.energy(), 9));
}
