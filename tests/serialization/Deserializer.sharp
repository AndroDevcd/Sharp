mod serialization;

import (
    std,
    std.io,
    std.reflect
)

/**
 * Main deserializer class for reconstructing objects from serialized data
 */
class Deserializer {
    // Buffer for reading data
    private buffer: ReadBuffer;
    
    // Tracking objects during deserialization
    private references: object[];
    
    // Tracking class information
    private classTracker: ClassTracker;
    
    Deserializer() {
        classTracker = new ClassTracker();
    }
    
    /**
     * Reset the deserializer state
     */
    def reset() {
        buffer = null;
        references = null;
        classTracker.reset();
    }
    
    /**
     * Main method to deserialize a byte array back to an object
     */
    def deserialize(data: _int8[]) : object? {
        if (data == null || data.size == 0)
            return null;
            
        // Reset state
        reset();
        buffer = new ReadBuffer(data);
        
        // Check if data starts with the serialization marker
        if (buffer.read_byte() != SerializeConstants.SERIALIZE_START) {
            throw new exception("Invalid serialization format: missing start marker");
        }
        
        // Read object count
        object_count := buffer.read_int32();
        references = new object[object_count];
        
        // Read class section
        deserialize_class_section();
        
        // Deserialize main object
        result := deserialize_object();
        
        // Check if data ends with the serialization marker
        if (buffer.read_byte() != SerializeConstants.SERIALIZE_END) {
            throw new exception("Invalid serialization format: missing end marker");
        }
        
        return result;
    }
    
    /**
     * Read the class section to populate class tracker
     */
    private def deserialize_class_section() {
        if (buffer.read_byte() != SerializeConstants.CLASS_SECTION_BEGIN) {
            throw new exception("Invalid serialization format: missing class section start");
        }
        
        class_count := buffer.read_int32();
        
        for (i := 0; i < class_count; i++) {
            hash := buffer.read_int32();
            field_count := buffer.read_int32();
            name_length := buffer.read_byte();
            
            // Read the class name
            name_builder := new std.string_builder();
            for (j := 0; j < name_length; j++) {
                name_builder.append(buffer.read_byte());
            }
            class_name := name_builder.to_string();
            
            // Look up the class by name via reflection
            cls := std.reflect.reflection.get_class(class_name);
            
            if (cls == null) {
                throw new exception("Could not find class: " + class_name);
            }
            
            // Verify hash
            if (cls.hash() != hash) {
                throw new exception("Hash mismatch for class: " + class_name);
            }
            
            // Verify field count
            if (cls.get_fields().size() != field_count) {
                throw new exception("Field count mismatch for class: " + class_name);
            }
            
            // Add to tracker
            classTracker.add_class(cls);
        }
        
        if (buffer.read_byte() != SerializeConstants.CLASS_SECTION_END) {
            throw new exception("Invalid serialization format: missing class section end");
        }
    }
    
    /**
     * Recursively deserialize an object
     */
    private def deserialize_object() : object? {
        // Read object type marker
        type_marker := buffer.read_byte();
        
        if (type_marker == SerializeConstants.NULL_OBJECT) {
            return null;
        }
        else if (type_marker == SerializeConstants.REFERENCE_OBJECT) {
            // Reference to a previously deserialized object
            id := buffer.read_int32();
            
            if (id < 0 || id >= references.size) {
                throw new exception("Invalid object reference: " + id);
            }
            
            return references[id];
        }
        else if (type_marker == SerializeConstants.CLASS_OBJECT || 
                 type_marker == SerializeConstants.CLASS_ARRAY_OBJECT) {
            // Class object or array
            id := buffer.read_int32();
            size := 0;
            
            if (type_marker == SerializeConstants.CLASS_ARRAY_OBJECT) {
                size = buffer.read_int32();
            }
            
            // Read class hash
            hash := buffer.read_int32();
            
            // Get class info
            class_info := classTracker.get_class(hash);
            if (class_info == null) {
                throw new exception("Unknown class hash: " + hash);
            }
            
            object result;
            
            if (type_marker == SerializeConstants.CLASS_ARRAY_OBJECT) {
                // Create array object
                result = std.reflect.reflection.create_array(class_info.class_type, size);
            } else {
                // Create class instance
                result = std.reflect.reflection.create_instance(class_info.class_type);
            }
            
            // Store reference before recursing
            references[id] = result;
            
            if (type_marker == SerializeConstants.CLASS_ARRAY_OBJECT) {
                // Fill array elements
                for (i := 0; i < size; i++) {
                    element := deserialize_object();
                    std.reflect.reflection.set_array_element(result, i, element);
                }
            } else {
                // Set fields in class
                fields := class_info.class_type.get_fields();
                for (i := 0; i < fields.size(); i++) {
                    field := fields.get(i);
                    value := deserialize_object();
                    field.set_value(result, value);
                }
            }
            
            return result;
        }
        else if (type_marker == SerializeConstants.NUMERIC_OBJECT) {
            // Primitive numeric type
            id := buffer.read_int32();
            size := buffer.read_int32();
            type_code := buffer.read_byte();
            
            // For now, handle only single values
            if (size != 1) {
                throw new exception("Arrays of primitive types not yet supported");
            }
            
            object result;
            
            // Create the appropriate value based on type code
            if (type_code == 0) { // double
                value := buffer.read_double();
                result = value;
            }
            else if (type_code == 1) { // long
                value := buffer.read_int64();
                result = value;
            }
            else if (type_code == 2) { // int
                value := buffer.read_int32();
                result = value;
            }
            else if (type_code == 3) { // short
                value := buffer.read_int32();
                result = value as short;
            }
            else if (type_code == 4) { // byte
                value := buffer.read_byte();
                result = value;
            }
            else if (type_code == 5) { // string
                builder := new std.string_builder();
                for (i := 0; i < size; i++) {
                    builder.append(buffer.read_byte());
                }
                result = builder.to_string();
            }
            else {
                throw new exception("Unknown primitive type code: " + type_code);
            }
            
            references[id] = result;
            return result;
        }
        else if (type_marker == SerializeConstants.STANDARD_OBJECT) {
            // Standard object
            id := buffer.read_int32();
            field_count := buffer.read_int32();
            
            // Create a standard object with the specified number of fields
            result := new object();
            
            // Store reference before recursing
            references[id] = result;
            
            // Read fields - not applicable for standard objects yet
            
            return result;
        }
        else {
            throw new exception("Unknown object type marker: " + type_marker);
        }
    }
}