mod app;

import (
    std.guikit.*,
    std.math,
    std.text
)

/**
 * A BUSY SCENE: how well does a machine animate a lot of moving things at a set frame rate?
 *
 *      sharpc tests/animation/busy_scene.sharp -o busy_scene
 *      sharp busy_scene [frame rate] [crowd] [full]
 *
 *      frame rate   the most frames a second (gui.frame_rate), 0 for no limit; 30 when left out
 *      crowd        1 .. 6: how many trees, cars, people and birds; 2 when left out
 *      full         fullscreen instead of a 960 x 540 window
 *
 *      sharp busy_scene 30 2           the scene at 30 fps
 *      sharp busy_scene 0 6 full       everything there is, as fast as it goes
 *
 * Everything moves every frame: three layers of mountains scrolling at their own
 * speeds, two layers of city whose buildings never repeat (each one is made from
 * its place in the street: its height, width, colour, roof, and windows that go
 * on and off), clouds, a windmill turning, trees swaying, cars with turning wheels both
 * ways down a two-lane road, people running with jointed arms and legs, birds
 * flapping. Each thing is moved by its speed times the time since the last frame,
 * so at a low frame rate it moves just as far - in bigger jumps.
 *
 * The box in the top right corner shows the frames a second; when the window
 * closes the program prints the average over the whole run.
 */

// ------------------------------------------------------------ the things that move

class car {
    x : decimal = 0;
    speed : decimal = 0;        // pixels a second; below 0 it drives to the left
    lane : decimal = 0;         // 0 the far lane, 1 the near one
    size : decimal = 1;
    paint : color;

    car(start: decimal, pixels_a_second: decimal, which_lane: decimal, scale: decimal, c: color) {
        x = start;
        speed = pixels_a_second;
        lane = which_lane;
        size = scale;
        paint = c;
    }
}

class runner {
    x : decimal = 0;
    speed : decimal = 0;        // pixels a second
    stride : decimal = 0;       // steps a second
    size : decimal = 1;
    shirt : color;

    runner(start: decimal, pixels_a_second: decimal, scale: decimal, c: color) {
        x = start;
        speed = pixels_a_second;
        stride = pixels_a_second / (28 * scale);
        size = scale;
        shirt = c;
    }
}

frames : decimal = 0;           // for the average printed at the end
first_frame : decimal = 0;
last_frame : decimal = 0;

def main(args: string[]) {
    rate : _int64 = 30;
    crowd : decimal = 2;
    full := false;
    numbers := 0;
    for(i : _int64 = 0; i < sizeof(args); i++) {
        if(args[i] == "full") { full = true; }
        else if(numbers == 0) { rate = args[i].to_int(); numbers++; }
        else { crowd = args[i].to_int(); numbers++; }
    }
    if(crowd < 1) { crowd = 1; }
    if(crowd > 6) { crowd = 6; }

    car_colors := new color[6];
    car_colors[0] = gui.rgb(214, 48, 49);
    car_colors[1] = gui.rgb(9, 132, 227);
    car_colors[2] = gui.rgb(253, 203, 110);
    car_colors[3] = gui.rgb(0, 184, 148);
    car_colors[4] = gui.rgb(232, 67, 147);
    car_colors[5] = gui.rgb(236, 240, 241);

    car_count : _int64 = crowd * 4;
    cars := new car[car_count];
    for(i : _int64 = 0; i < sizeof(cars); i++) {
        lane : decimal = i % 2;
        speed : decimal = 140 + (i * 37) % 120;
        if(lane == 0) { speed = 0 - speed; }                    // the far lane drives the other way
        cars[i] = new car(i * 260, speed, lane, 0.8 + (i % 3) * 0.15, car_colors[i % 6]);
    }

    people_count : _int64 = crowd * 3;
    people := new runner[people_count];
    for(i : _int64 = 0; i < sizeof(people); i++) {
        people[i] = new runner(i * 170, 70 + (i * 29) % 60, 0.8 + (i % 4) * 0.12, car_colors[(i + 2) % 6]);
    }

    trees : decimal = crowd * 8;
    birds : decimal = crowd * 5;

    gui.frame_rate(rate);
    gui.show_fps(true);

    mode := window_mode.windowed;
    if(full) { mode = window_mode.fullscreen; }

    gui.run("Busy scene", 960, 540, mode, { ->
        return canvas(modifier().fill()) { p: painter, f: frame ->
            if(frames == 0) { first_frame = f.time; }
            frames = frames + 1;
            last_frame = f.time;

            t : decimal = f.time;
            w : decimal = f.width;
            h : decimal = f.height;
            ground : decimal = h * 0.62;                       // where the grass starts
            road : decimal = h * 0.74;                         // the top of the road

            sky(p, w, ground);
            sun_and_clouds(p, t, w, h);
            mountains(p, t, w, ground - h * 0.18, 0.004, 70, 12, gui.rgb(126, 144, 186));
            mountains(p, t, w, ground - h * 0.08, 0.007, 50, 30, gui.rgb(88, 110, 150));
            city(p, t, w, ground + 12, 20, 0.6, 0);            // far: plain shapes, slow
            city(p, t, w, ground + 12, 38, 1.0, 1);            // near: windows, roofs, lights
            hills(p, t, w, h, ground);
            windmill(p, t, w, ground);
            flock(p, t, w, h, birds);

            for(i : decimal = 0; i < trees; i++) {             // the far row of trees, smaller and slower
                tree(p, t, i, wrap(i * 97 - t * 40, w + 120) - 60, ground + 6, 0.6);
            }
            p.rect(0, road, w, h * 0.16, gui.rgb(60, 63, 70));                     // the road
            p.rect(0, road - 4, w, 4, gui.rgb(150, 150, 150));
            p.rect(0, road + h * 0.16, w, 4, gui.rgb(150, 150, 150));
            for(i : decimal = 0; i < w / 60 + 2; i++) {                            // the lane marks
                p.rect(wrap(i * 60 - t * 90, w + 60) - 60, road + h * 0.08 - 2, 30, 4, gui.rgb(240, 220, 120));
            }

            for(i : _int64 = 0; i < sizeof(cars); i++) {
                c := cars[i];
                c.x = wrap(c.x + c.speed * f.step, w + 300);
                lane_y : decimal = road + h * 0.055;
                if(c.lane == 1) { lane_y = road + h * 0.135; }
                vehicle(p, t, c, c.x - 150, lane_y);
            }

            p.rect(0, road + h * 0.16 + 4, w, h, gui.rgb(178, 170, 150));          // the pavement
            for(i : _int64 = 0; i < sizeof(people); i++) {
                r := people[i];
                r.x = wrap(r.x + r.speed * f.step, w + 100);
                person(p, t, r, r.x - 50, h - 8);
            }
            for(i : decimal = 0; i < trees / 2; i++) {         // the near row: big, in front of everything
                tree(p, t, i + 50, wrap(i * 230 - t * 160, w + 300) - 150, h + 10, 1.5);
            }
        };
    });

    if(frames > 1 && last_frame > first_frame) {
        println("rate " + rate + ", crowd " + crowd + ": " + number_to_fixed((frames - 1) / (last_frame - first_frame), 1)
            + " frames a second on average over " + number_to_fixed(last_frame - first_frame, 1) + " seconds");
    }
}

// ------------------------------------------------------------ drawing

/** v moved into 0 .. span: things that leave one side come back on the other */
def wrap(v: decimal, span: decimal) : decimal {
    return v - floor_of(v / span) * span;
}

/** a number from 0 to 1 that looks random but is always the same for the same n */
def chance(n: decimal) : decimal {
    v : decimal = sin_of(n * 12.9898) * 43758.5453;
    return v - floor_of(v);
}

/**
 * A street of buildings scrolling left. The street is cut into slots, and the
 * building in slot k is made from k alone - so the street goes on for ever,
 * every building coming into view is a new one, and one that comes back into
 * view (it never does) would be the same.
 */
def city(p: painter, t: decimal, w: decimal, foot: decimal, speed: decimal, s: decimal, near: decimal) {
    slot : decimal = 74 * s;
    shift : decimal = t * speed;
    for(k : decimal = floor_of(shift / slot) - 1; k * slot - shift < w + slot; k++) {
        building(p, t, k + near * 5000, k * slot - shift, foot, slot, s, near);
    }
}

def building(p: painter, t: decimal, k: decimal, x: decimal, foot: decimal, slot: decimal, s: decimal, near: decimal) {
    wide : decimal = slot * (0.6 + 0.38 * chance(k + 0.1));
    tall : decimal = (50 + 170 * chance(k + 0.2)) * s;
    left : decimal = x + (slot - wide) * chance(k + 0.3);
    top : decimal = foot - tall;
    shade : decimal = chance(k + 0.4);

    if(near == 0) {                                            // far away: a flat shape in the haze
        p.rect(left, top, wide, tall, gui.rgb(98 + shade * 24, 112 + shade * 24, 150 + shade * 20));
        if(chance(k + 0.5) > 0.6) { p.rect(left + wide * 0.3, top - 14 * s, wide * 0.4, 14 * s, gui.rgb(98 + shade * 24, 112 + shade * 24, 150 + shade * 20)); }
        return;
    }

    kind : decimal = floor_of(shade * 4);                      // brick, concrete, glass, sandstone
    body := gui.rgb(150, 82, 64);
    if(kind == 1) { body = gui.rgb(150, 154, 160); }
    else if(kind == 2) { body = gui.rgb(70, 110, 140); }
    else if(kind == 3) { body = gui.rgb(196, 170, 120); }
    p.rect(left, top, wide, tall, body);
    p.rect(left + wide - 6, top, 6, tall, gui.rgba(0, 0, 0, 50));                     // the shaded side

    roof : decimal = floor_of(chance(k + 0.5) * 4);
    if(roof == 0) {                                            // a ledge
        p.rect(left - 3, top - 5, wide + 6, 6, gui.rgb(80, 80, 88));
    } else if(roof == 1) {                                     // an antenna, its light blinking
        mast_x : decimal = left + wide * 0.5;
        p.line(mast_x, top, mast_x, top - 34 * s, 2, gui.rgb(60, 60, 66));
        if(wrap(t * 1.4 + chance(k + 0.6), 1) < 0.5) { p.circle(mast_x, top - 34 * s, 3, gui.rgb(255, 60, 60)); }
    } else if(roof == 2) {                                     // a water tower on legs
        tank_x : decimal = left + wide * 0.25;
        p.line(tank_x + 3, top, tank_x + 3, top - 10, 2, gui.rgb(70, 50, 40));
        p.line(tank_x + 15, top, tank_x + 15, top - 10, 2, gui.rgb(70, 50, 40));
        p.rect(tank_x, top - 26, 18, 16, 4, gui.rgb(120, 84, 60));
        triangle(p, tank_x - 2, top - 26, tank_x + 20, top - 26, tank_x + 9, top - 34, gui.rgb(90, 60, 44));
    } else {                                                   // a stepped top
        p.rect(left + wide * 0.15, top - 16 * s, wide * 0.7, 16 * s, body);
        p.rect(left + wide * 0.3, top - 28 * s, wide * 0.4, 12 * s, body);
    }

    // the windows: each goes on or off now and then, at its own moment
    lit := gui.rgb(255, 222, 130);
    unlit := gui.rgb(40, 48, 66);
    if(kind == 2) { unlit = gui.rgb(110, 160, 190); }        // glass: the sky in it
    cols : decimal = floor_of((wide - 10) / 12);
    rows : decimal = floor_of((tall - 14) / 16);
    for(r : decimal = 0; r < rows; r++) {
        for(c : decimal = 0; c < cols; c++) {
            n : decimal = k * 31 + r * 7.3 + c * 1.9;
            moment : decimal = floor_of(t * 0.4 + chance(n) * 20);
            ink := unlit;
            if(chance(n + moment * 3.7) > 0.55) { ink = lit; }
            p.rect(left + 6 + c * 12, top + 10 + r * 16, 7, 9, ink);
        }
    }
}

tri_x := new decimal[3];        // one triangle's corners, filled again for each triangle
tri_y := new decimal[3];

def triangle(p: painter, x1: decimal, y1: decimal, x2: decimal, y2: decimal, x3: decimal, y3: decimal, c: color) {
    tri_x[0] = x1; tri_y[0] = y1;
    tri_x[1] = x2; tri_y[1] = y2;
    tri_x[2] = x3; tri_y[2] = y3;
    p.polygon(tri_x, tri_y, c);
}

/** the sky in bands, dark blue at the top to pale at the horizon */
def sky(p: painter, w: decimal, ground: decimal) {
    bands : decimal = 12;
    for(i : decimal = 0; i < bands; i++) {
        k : decimal = i / bands;
        p.rect(0, ground * k, w, ground / bands + 1, gui.rgb(40 + k * 130, 90 + k * 110, 170 + k * 70));
    }
}

def sun_and_clouds(p: painter, t: decimal, w: decimal, h: decimal) {
    sx : decimal = w * 0.8;
    sy : decimal = h * 0.16;
    p.circle(sx, sy, 46 + sin_of(t * 2) * 3, gui.rgba(255, 230, 120, 70));
    p.circle(sx, sy, 32, gui.rgb(255, 214, 90));
    for(i : decimal = 0; i < 6; i++) {
        cx : decimal = wrap(i * 210 + t * (12 + i * 3), w + 240) - 120;
        cy : decimal = h * (0.08 + (i % 3) * 0.06);
        white := gui.rgba(255, 255, 255, 220);
        p.circle(cx, cy, 22, white);
        p.circle(cx + 24, cy - 8, 28, white);
        p.circle(cx + 52, cy, 20, white);
        p.rect(cx, cy, 52, 20, 10, white);
    }
}

/** a ridge of mountains: one polygon along a sum of two waves, scrolling */
def mountains(p: painter, t: decimal, w: decimal, foot: decimal, wave: decimal, tall: decimal, speed: decimal, c: color) {
    shift : decimal = t * speed;
    steps : _int64 = floor_of((w + 24) / 24) + 1;
    xs := new decimal[steps + 2];                              // the ridge, with a corner under each end
    ys := new decimal[steps + 2];
    xs[0] = 0;
    ys[0] = foot + 200;
    for(i : _int64 = 0; i < steps; i++) {
        x : decimal = i * 24;
        u : decimal = x + shift;
        xs[i + 1] = x;
        ys[i + 1] = foot - tall * (0.6 + 0.4 * sin_of(u * wave)) - tall * 0.35 * sin_of(u * wave * 3.1);
    }
    xs[steps + 1] = w + 24;
    ys[steps + 1] = foot + 200;
    p.polygon(xs, ys, c);
}

def hills(p: painter, t: decimal, w: decimal, h: decimal, ground: decimal) {
    mountains(p, t, w, ground + 10, 0.012, 22, 55, gui.rgb(96, 168, 82));
    p.rect(0, ground + 8, w, h, gui.rgb(84, 156, 72));
}

/** a windmill on the hills, its four blades turning */
def windmill(p: painter, t: decimal, w: decimal, ground: decimal) {
    x : decimal = wrap(w * 0.3 - t * 55, w + 200) - 100;
    top : decimal = ground - 70;
    triangle(p, x - 14, ground + 10, x + 14, ground + 10, x, top, gui.rgb(230, 225, 215));
    turn : decimal = t * 2.2;
    for(b : decimal = 0; b < 4; b++) {
        a : decimal = turn + b * HALF_PI;
        tip_x : decimal = x + cos_of(a) * 48;
        tip_y : decimal = top + sin_of(a) * 48;
        side_x : decimal = x + cos_of(a + 0.25) * 44;
        side_y : decimal = top + sin_of(a + 0.25) * 44;
        triangle(p, x, top, tip_x, tip_y, side_x, side_y, gui.rgb(245, 245, 240));
        p.line(x, top, tip_x, tip_y, 2, gui.rgb(120, 100, 80));
    }
    p.circle(x, top, 5, gui.rgb(90, 70, 60));
}

/** a tree: a pine or a round one by number, the top swaying in the wind */
def tree(p: painter, t: decimal, n: decimal, x: decimal, foot: decimal, s: decimal) {
    sway : decimal = sin_of(t * 1.7 + n * 0.9) * 5 * s;
    p.rect(x - 4 * s, foot - 30 * s, 8 * s, 30 * s, gui.rgb(110, 76, 52));
    if(n % 2 == 0) {
        for(k : decimal = 0; k < 3; k++) {
            low : decimal = foot - 24 * s - k * 22 * s;
            half : decimal = (30 - k * 7) * s;
            triangle(p, x - half, low, x + half, low, x + sway * (k + 1) / 3, low - 34 * s, gui.rgb(34, 110 + k * 15, 64));
        }
    } else {
        p.circle(x + sway * 0.5, foot - 46 * s, 22 * s, gui.rgb(52, 140, 60));
        p.circle(x - 14 * s + sway * 0.7, foot - 58 * s, 18 * s, gui.rgb(62, 156, 70));
        p.circle(x + 12 * s + sway, foot - 66 * s, 16 * s, gui.rgb(78, 172, 84));
    }
}

/** a car: body, cabin, windows, lights, and two wheels turning as far as it has rolled */
def vehicle(p: painter, t: decimal, c: car, x: decimal, y: decimal) {
    s : decimal = c.size;
    if(c.lane == 0) { s = s * 0.85; }                         // the far lane is a little smaller
    long : decimal = 110 * s;
    bounce : decimal = sin_of(t * 14 + c.x * 0.05) * 1.2;
    body_y : decimal = y - 26 * s + bounce;

    p.rect(x + 6, y - 2, long - 12, 6, 3, gui.rgba(0, 0, 0, 70));                      // the shadow
    p.rect(x, body_y, long, 22 * s, 8 * s, c.paint);
    p.rect(x + long * 0.22, body_y - 18 * s, long * 0.5, 20 * s, 8 * s, c.paint);
    glass := gui.rgb(170, 210, 235);
    p.rect(x + long * 0.27, body_y - 14 * s, long * 0.18, 13 * s, 3, glass);
    p.rect(x + long * 0.49, body_y - 14 * s, long * 0.18, 13 * s, 3, glass);

    front : decimal = x + long - 4;                            // the lights at the end it drives towards
    back : decimal = x + 4;
    if(c.speed < 0) { front = x + 4; back = x + long - 4; }
    p.circle(front, body_y + 8 * s, 4 * s, gui.rgb(255, 245, 190));
    p.circle(back, body_y + 8 * s, 3 * s, gui.rgb(230, 40, 40));

    radius : decimal = 11 * s;
    turned : decimal = c.x / radius;                           // rolled this far: turned this much
    wheel(p, x + long * 0.22, y - 4, radius, turned);
    wheel(p, x + long * 0.78, y - 4, radius, turned);
}

def wheel(p: painter, x: decimal, y: decimal, radius: decimal, turned: decimal) {
    p.circle(x, y, radius, gui.rgb(30, 30, 34));
    p.circle(x, y, radius * 0.55, gui.rgb(170, 170, 178));
    for(k : decimal = 0; k < 3; k++) {
        a : decimal = turned + k * PI_VALUE / 3;
        p.line(x - cos_of(a) * radius * 0.5, y - sin_of(a) * radius * 0.5,
               x + cos_of(a) * radius * 0.5, y + sin_of(a) * radius * 0.5, 2, gui.rgb(80, 80, 88));
    }
}

/** a person running: hips, knees, feet, shoulders, elbows and hands worked out from the stride */
def person(p: painter, t: decimal, r: runner, x: decimal, foot: decimal) {
    s : decimal = r.size;
    step : decimal = t * r.stride * PI_VALUE * 2 + r.x * 0.01;
    leg : decimal = 17 * s;
    hip_x : decimal = x;
    hip_y : decimal = foot - leg * 1.9 - (0.5 + 0.5 * cos_of(step * 2)) * 3 * s;      // up and down with each step
    neck_x : decimal = hip_x + 5 * s;                          // leaning into the run
    neck_y : decimal = hip_y - 28 * s;
    skin := gui.rgb(240, 200, 160);
    dark := gui.rgb(40, 44, 60);

    p.circle(x, foot, 9 * s, gui.rgba(0, 0, 0, 50));          // the shadow
    for(side : decimal = 0; side < 2; side++) {
        a : decimal = step + side * PI_VALUE;
        // angles from straight down; more is further forward
        thigh : decimal = 0.65 * sin_of(a);
        shin : decimal = thigh - 1.1 * (0.5 + 0.5 * sin_of(a + 1.7));
        knee_x : decimal = hip_x + sin_of(thigh) * leg;
        knee_y : decimal = hip_y + cos_of(thigh) * leg;
        foot_x : decimal = knee_x + sin_of(shin) * leg;
        foot_y : decimal = knee_y + cos_of(shin) * leg;
        upper : decimal = 0 - 0.7 * sin_of(a);                 // the arm on this side swings against the leg
        lower : decimal = upper + 1.4;
        elbow_x : decimal = neck_x + sin_of(upper) * 13 * s;
        elbow_y : decimal = neck_y + 3 * s + cos_of(upper) * 13 * s;
        hand_x : decimal = elbow_x + sin_of(lower) * 12 * s;
        hand_y : decimal = elbow_y + cos_of(lower) * 12 * s;

        limb := dark;
        if(side == 1) { limb = gui.rgb(70, 76, 96); }        // the far side, a shade lighter
        p.line(hip_x, hip_y, knee_x, knee_y, 5 * s, limb);
        p.line(knee_x, knee_y, foot_x, foot_y, 4 * s, limb);
        p.line(foot_x, foot_y, foot_x + 6 * s, foot_y, 4 * s, gui.rgb(230, 230, 230));
        p.line(neck_x, neck_y + 3 * s, elbow_x, elbow_y, 4 * s, r.shirt);
        p.line(elbow_x, elbow_y, hand_x, hand_y, 3 * s, skin);
    }
    p.line(hip_x, hip_y, neck_x, neck_y, 9 * s, r.shirt);     // the body
    p.circle(neck_x + 2 * s, neck_y - 9 * s, 7 * s, skin);    // the head
}

/** birds: each a V whose wings beat, drifting across the sky */
def flock(p: painter, t: decimal, w: decimal, h: decimal, count: decimal) {
    ink := gui.rgb(40, 40, 50);
    for(i : decimal = 0; i < count; i++) {
        x : decimal = wrap(i * 83 + t * (60 + (i % 4) * 12), w + 80) - 40;
        y : decimal = h * 0.12 + (i % 5) * 18 + sin_of(t * 1.3 + i) * 8;
        beat : decimal = sin_of(t * 9 + i * 1.7) * 6;
        p.line(x - 9, y - beat, x, y, 2, ink);
        p.line(x, y, x + 9, y - beat, 2, ink);
    }
}
