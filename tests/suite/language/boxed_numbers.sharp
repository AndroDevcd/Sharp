mod suite.language.boxed_numbers;

import ( std.testing )

/**
 * The number classes of the standard library: int, double, char, uchar,
 * short, ushort, uint, long, byte and bool.
 *
 * They are OBJECTS ("boxes") that hold one native number in `.value`.
 * `z := 1;` makes an int box; `x : decimal = 1;` makes a native number.
 *
 * Three things to keep in mind when reading the checks:
 *   - an operator between two boxes makes a NEW box of the type on the left
 *   - `=` with a number and the in-place operators (+=, ++ ...) change the
 *     box itself, so every variable that refers to that box sees the change
 *   - the sized classes wrap around like the C types they are named after
 */

/** changes the caller's box */
def add_ten(n: int) { n += 10; }

/** `=` with a number writes into the caller's box */
def store_99(n: int) { n = 99; }

/** `=` with another box only re-points the local name; the caller's box is untouched */
def point_elsewhere(n: int) { n = new int(1000); }

def boxed_numbers_tests() {
    tests("boxed_numbers") {
        // ---- construction and .value
        test("int from a literal") {
            a : int = 5;
            expect(a.value).should_be(5);
        };
        test("new int(7)") {
            b := new int(7);
            expect(b.value).should_be(7);
        };
        test("z := 1 is an int box") {
            z := 1;
            expect(z.value).should_be(1);
        };
        test("zc := 'c' is a char box") {
            zc := 'c';
            expect(zc.value).should_be(99);
        };
        test("zb := true is a bool box") {
            zb := true;
            expect(zb).should_be(1);
        };
        test("zd := 1.5 keeps the fraction") {
            zd := 1.5;
            expect(zd.value).should_be(1.5);
        };
        test("a copy of .value is separate from the box: the copy changes, the box does not") {
            b := new int(7);
            plain : decimal = b.value;
            plain++;
            expect(b.value).named("the box").should_be(7);
            expect(plain).named("the copy").should_be(8);
        };

        // ---- a fraction given to an integer box is cut off (towards zero)
        test("new int(2.9)") {
            cut := new int(2.9);
            expect(cut.value).should_be(2);
        };
        test("new int(-2.9)") {
            cut_negative := new int(0 - 2.9);
            expect(cut_negative.value).should_be(0 - 2);
        };
        test("int = 7.8") {
            assigned : int = 7.8;
            expect(assigned.value).should_be(7);
        };

        // a is 5 and b is 7, two new boxes for every test
        tests("five_and_seven") {
            a : int;
            b : int;
            before_each {
                a = new int(5);
                b = new int(7);
            };

            // ---- arithmetic between boxes gives a new box
            test("int + int") {
                sum := a + b;
                expect(sum.value).should_be(12);
            };
            test("int - int") { expect((a - b).value).should_be(0 - 2); };
            test("int * native") { expect((a * 2).value).should_be(10); };
            test("int / int is cut to a whole number") { expect((b / a).value).should_be(1); };
            test("int % int") { expect((b % a).value).should_be(2); };
            test("5 / 2 in an int") { expect((a / 2).value).should_be(2); };
            test("5 % 2 in an int") { expect((a % 2).value).should_be(1); };
            test("unary minus") {
                negated := -a;
                expect(negated.value).should_be(0 - 5);
            };
            test("the operands are unchanged") {
                sum := a + b;
                difference := a - b;
                product := a * 2;
                quotient := b / a;
                remainder := b % a;
                negated := -a;
                expect(a.value + b.value).should_be(12);
            };

            // ---- a box and a native number
            test("native - box is a native number") {
                ten : decimal = 10;
                expect(ten - a).should_be(5);
            };
            test("box + native is a box") {
                ten : decimal = 10;
                expect((a + ten).value).should_be(15);
            };
            test(".value in native arithmetic") { expect(a.value + 1).should_be(6); };

            // ---- comparisons give a bool box
            test("5 < 7") { expect_true((a < b)); };
            test("5 > 7") { expect_false((a > b)); };
            test("5 <= 5") { expect_true((a <= 5)); };
            test("5 >= 7") { expect_false((a >= b)); };
            test("5 == 5") { expect_true((a == 5)); };
            test("5 != 7") { expect_true((a != b)); };
            test("two different boxes with the same value are ==") {
                same_value := new int(5);
                expect_true((a == same_value));
            };

            // ...and can be used directly as a condition
            test("if(box < box)") {
                taken : decimal = 0;
                if(a < b) { taken = 1; }
                expect(taken).should_be(1);
            };
            test("if(... && ...)") {
                taken : decimal = 0;
                if(a == 5 && b > 6) { taken = 1; }
                expect(taken).should_be(1);
            };
            test("if(... || ...)") {
                taken : decimal = 0;
                if(a == 6 || b > 6) { taken = 1; }
                expect(taken).should_be(1);
            };

            // ---- an int hashes to its own value
            test("hash") { expect(b.hash().value).should_be(7); };
        };

        // ---- in-place operators
        test("+=") {
            c : int = 5;
            c += 3;
            expect(c.value).should_be(8);
        };
        test("-=") {
            c : int = 8;
            c -= 1;
            expect(c.value).should_be(7);
        };
        test("*=") {
            c : int = 7;
            c *= 4;
            expect(c.value).should_be(28);
        };
        test("/=") {
            c : int = 28;
            c /= 2;
            expect(c.value).should_be(14);
        };
        test("%=") {
            c : int = 14;
            c %= 5;
            expect(c.value).should_be(4);
        };
        test("++ after") {
            c : int = 4;
            c++;
            expect(c.value).should_be(5);
        };
        test("-- twice") {
            c : int = 5;
            c--;
            c--;
            expect(c.value).should_be(3);
        };
        test("++ before") {
            c : int = 3;
            ++c;
            expect(c.value).should_be(4);
        };

        // ---- a loop counter that is a box
        test("0 + 1 + 2 + 3 + 4") {
            total := new int(0);
            for(k := 0; k < 5; k++) {
                total += k;
            }
            expect(total.value).should_be(10);
        };

        // ---- two variables, one box
        test("+= through the other name") {
            p := new int(1);
            q := p;
            q += 5;
            expect(p.value).should_be(6);
        };
        test("= with a number writes into the shared box") {
            p := new int(6);
            q := p;
            q = 40;
            expect(p.value).should_be(40);
        };
        test("= with a new box re-points q only: p keeps its box, q is the new box") {
            p := new int(1);
            q := p;
            q = 40;
            q = new int(50);
            expect(p.value).named("p").should_be(40);
            expect(q.value).named("q").should_be(50);
        };
        test("p + 0 is a new box, changing it leaves p alone") {
            p := new int(40);
            r := p + 0;
            r += 1;
            expect(p.value).named("p").should_be(40);
            expect(r.value).named("the new box").should_be(41);
        };
        test("new int(p) copies the value, and p is unchanged") {
            p := new int(40);
            copied := new int(p);
            copied += 1;
            expect(copied.value).named("the copy").should_be(41);
            expect(p.value).named("p").should_be(40);
        };

        // ---- boxes as parameters
        test("+= inside a function is seen by the caller") {
            arg := new int(1);
            add_ten(arg);
            expect(arg.value).should_be(11);
        };
        test("= with a number inside a function is seen by the caller") {
            arg := new int(11);
            store_99(arg);
            expect(arg.value).should_be(99);
        };
        test("= with another box inside a function is not") {
            arg := new int(1);
            store_99(arg);
            point_elsewhere(arg);
            expect(arg.value).should_be(99);
        };

        // ---- char: -128 .. 127
        test("char 127 + 1") {
            ch : char = 127;
            ch += 1;
            expect(ch.value).should_be(0 - 128);
        };
        test("char 127 ++") {
            ch : char = 127;
            ch++;
            expect(ch.value).should_be(0 - 128);
        };
        test("char -128 - 1") {
            ch : char = 0 - 128;
            ch -= 1;
            expect(ch.value).should_be(127);
        };
        test("new char(300)") {
            big_char := new char(300);
            expect(big_char.value).should_be(44);
        };
        test("char from a character") {
            letter : char = 'z';
            expect(letter.value).should_be(122);
        };
        test("char == character") {
            letter : char = 'z';
            expect_true((letter == 'z'));
        };

        // ---- uchar and byte: 0 .. 255
        test("uchar 255 + 1") {
            uc : uchar = 255;
            uc += 1;
            expect(uc.value).should_be(0);
        };
        test("uchar 0 - 1") {
            uc : uchar = 0;
            uc -= 1;
            expect(uc.value).should_be(255);
        };
        test("byte 250 + 10") {
            by : byte = 250;
            by += 10;
            expect(by.value).should_be(4);
        };

        // ---- short: -32768 .. 32767
        test("short 32767 ++") {
            sh : short = 32767;
            sh++;
            expect(sh.value).should_be(0 - 32768);
        };
        test("short 32767 + 2") {
            sh : short = 32767;
            sh += 2;
            expect(sh.value).should_be(0 - 32767);
        };

        // ---- ushort: 0 .. 65535
        test("ushort 65535 ++") {
            us : ushort = 65535;
            us++;
            expect(us.value).should_be(0);
        };

        // ---- int: -2147483648 .. 2147483647
        test("int 2^31 - 1 + 1") {
            i : int = 2147483647;
            i += 1;
            expect(i.value).should_be(0 - 2147483648);
        };
        test("int -2^31 - 1") {
            i : int = 0 - 2147483648;
            i -= 1;
            expect(i.value).should_be(2147483647);
        };
        test("int 2^16 * 2^16") {
            i : int = 65536;
            i *= 65536;
            expect(i.value).should_be(0);
        };

        // ---- uint: 0 .. 4294967295
        test("uint 2^32 - 1 + 1") {
            ui : uint = 4294967295;
            ui += 1;
            expect(ui.value).should_be(0);
        };

        // ---- long and ulong hold what an int cannot
        test("long 2^32 * 2") {
            lg : long = 4294967296;
            lg *= 2;
            expect(lg.value).should_be(8589934592);
        };
        test("ulong 5 * 3") {
            ul : ulong = 5;
            ul *= 3;
            expect(ul.value).should_be(15);
        };

        // ---- double keeps fractions
        test("double * native") {
            d : double = 2.5;
            expect((d * 2).value).should_be(5);
        };
        test("double /= 2") {
            d : double = 2.5;
            d /= 2;
            expect(d.value).should_be(1.25);
        };

        // ---- mixed classes: the result has the class of the LEFT operand
        test("double + int is a double") {
            five := new int(5);
            half := new double(2.5);
            expect((half + five).value).should_be(7.5);
        };
        test("int + double is an int") {
            five := new int(5);
            half := new double(2.5);
            expect((five + half).value).should_be(7);
        };
        test("long + int is a long") {
            five := new int(5);
            two_33 := new long(8589934592);
            expect((two_33 + five).value).should_be(8589934597);
        };
        test("int + long wraps to an int") {
            five := new int(5);
            two_33 := new long(8589934592);
            expect((five + two_33).value).should_be(5);
        };
        test("int == long") {
            five := new int(5);
            expect_true((five == new long(5)));
        };
        test("int 5 < double 2.5") {
            five := new int(5);
            half := new double(2.5);
            expect_false((five < half));
        };

        // ---- bool
        test("true is 1") {
            t : bool = true;
            expect(t).should_be(1);
        };
        test("false is 0") {
            f : bool = false;
            expect(f).should_be(0);
        };
        test("!true") {
            t : bool = true;
            expect_false((!t));
        };
        test("true == true") {
            t : bool = true;
            expect_true((t == true));
        };
        test("true != false") {
            t : bool = true;
            f : bool = false;
            expect_true((t != f));
        };
        test("if(bool box)") {
            t : bool = true;
            taken : decimal = 0;
            if(t) { taken = 1; }
            expect(taken).should_be(1);
        };
        test("if(!bool box)") {
            f : bool = false;
            taken : decimal = 0;
            if(!f) { taken = 1; }
            expect(taken).should_be(1);
        };

        // ---- conversions between the classes
        test("double 3.7 to_int") {
            pi_ish := new double(3.7);
            expect(pi_ish.to_int().value).should_be(3);
        };
        test("int 321 to_char wraps") {
            three_21 := new int(321);
            expect(three_21.to_char().value).should_be(65);
        };
        test("int 5 to_double / 2") {
            five := new int(5);
            expect(five.to_double().value / 2).should_be(2.5);
        };
        test("to_long") {
            five := new int(5);
            expect(five.to_long().value).should_be(5);
        };
        test("to_short") {
            five := new int(5);
            expect(five.to_short().value).should_be(5);
        };
        test("to_bool") {
            five := new int(5);
            expect(five.to_bool()).should_be(1);
        };

        // ---- to_string and string interpolation
        test("int to_string") {
            five := new int(5);
            expect(five.to_string()!!).should_be("5");
        };
        test("negative short to_string") {
            minus_twelve := new short(0 - 12);
            expect(minus_twelve.to_string()!!).should_be("-12");
        };
        test("long to_string") {
            two_33 := new long(8589934592);
            expect(two_33.to_string()!!).should_be("8589934592");
        };
        // a decimal is written with the fewest digits that read back as the same number
        // (until VM r19 it was sixteen places after the point: "2.5000000000000000")
        test("double to_string is the short form") {
            half := new double(2.5);
            expect(half.to_string()!!).should_be("2.5");
        };
        test("a whole double has no fraction") { expect(new double(3).to_string()!!).should_be("3"); };
        test("a tenth is a tenth") { expect(new double(0.1).to_string()!!).should_be("0.1"); };
        test("bool in text") {
            t : bool = true;
            expect("" + t).should_be("true");
        };
        test("false in text") {
            f : bool = false;
            expect("" + f).should_be("false");
        };
        test("char to_string is the character") {
            letter : char = 'z';
            expect(letter.to_string()!!).should_be("z");
        };
        test("uchar to_string is the character") {
            upper_a := new uchar(65);
            expect(upper_a.to_string()!!).should_be("A");
        };
        test("boxes inside a string") {
            five := new int(5);
            t : bool = true;
            two_33 := new long(8589934592);
            expect("$five and $t and $two_33").should_be("5 and true and 8589934592");
        };

        // ---- parsing text
        test("int.parse") { expect(int.parse("-123").value).should_be(0 - 123); };
        test("double.parse") { expect(double.parse("2.5").value).should_be(2.5); };

        // ---- helpers of char
        test("is_digit('5')") { expect_true(character.is_digit('5')); };
        test("is_digit('x')") { expect_false(character.is_digit('x')); };
        test("is_letter('x')") { expect_true(character.is_letter('x')); };
        test("to_upper('b') is 'B'") { expect(character.to_upper('b')).should_be(66); };
        test("to_lower('Q') is 'q'") { expect(character.to_lower('Q')).should_be(113); };

        // ---- an array of boxes starts out as nulls
        test("element before it is set") {
            boxes := new int[3];
            expect_null(boxes[0]);
        };
        test("+= on an element") {
            boxes := new int[3];
            boxes[1] = new int(4);
            boxes[1] += 1;
            expect(boxes[1].value).should_be(5);
        };
    };
}
