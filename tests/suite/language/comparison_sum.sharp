mod suite.language.comparison_sum;

import ( std.testing )

/**
 * THE BUG THIS GUARDS (fixed): adding two comparison results directly gave a
 * wrong number when the operands were variables or calls:
 *      two : decimal = 2;
 *      (two < 3) + (4 > two)        was 3 (or printed as "21"), expected 2
 * With literals, or with each comparison stored in a variable first, the
 * result was right. The same in all four configurations. The checks below
 * write each comparison as `(... as _int32)`.
 */
def plain(a: decimal) : decimal { return a + 1; }

def comparison_sum_tests() {
    tests("comparison_sum") {
        test("(two < 3) + (4 > two)") {
            two : decimal = 2;
            expect(((two < 3) as _int32) + ((4 > two) as _int32)).should_be(2);
        };
        test("with calls") { expect(((plain(1) < 3) as _int32) + ((4 > plain(1)) as _int32)).should_be(2); };
    };
}
