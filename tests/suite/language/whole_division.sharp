mod suite.language.whole_division;

import ( std.testing )

/**
 * `/` on two whole numbers gives a whole number, toward zero, as Java and
 * Kotlin have it; with a decimal on either side it keeps the fraction. A
 * whole number divided by zero raises invalid_operation_exception instead of
 * ending the VM; a decimal divided by zero is infinity, as before.
 */

def div(a: _int64, b: _int64) : _int64 { return a / b; }
def div32(a: _int32, b: _int32) : _int32 { return a / b; }
def half(a: decimal) : decimal { return a / 2; }

class counter {
    total : _int64 = 100;
    def split(parts: _int64) : _int64 { return total / parts; }
}

def whole_division_tests() {
    tests("whole_division") {
        // ---- written as numbers: worked out by the compiler
        test("7 / 2") { expect(7 / 2).should_be(3); };
        test("-7 / 2 goes toward zero") { expect(-7 / 2).should_be(-3); };
        test("7 / -2 goes toward zero") { expect(7 / -2).should_be(-3); };
        test("-7 / -2") { expect(-7 / -2).should_be(3); };
        test("20 / 4") { expect(20 / 4).should_be(5); };
        test("1 / 3") { expect(1 / 3).should_be(0); };
        test("7 / 2.0 keeps the fraction") { expect(7 / 2.0).should_be(3.5); };
        test("7.0 / 2 keeps the fraction") { expect(7.0 / 2).should_be(3.5); };
        test("(7 / 2) * 2") { expect((7 / 2) * 2).should_be(6); };

        // ---- in variables: worked out by the VM
        tests("in_variables") {
            a : _int64;
            b : _int64;
            before_each {
                a = 7;
                b = 2;
            };

            test("a / b") { expect(a / b).should_be(3); };
            test("-a / b") { expect(-a / b).should_be(-3); };
            test("a / -b") { expect(a / -b).should_be(-3); };
            test("through a function") { expect(div(-9, 4)).should_be(-2); };
            test("32 bits") { expect(div32(-9, 4)).should_be(-2); };
            test("a field") { expect(new counter().split(7)).should_be(14); };
            test("a / b * b + a % b is a") { expect(a / b * b + a % b).should_be(a); };

            // ---- a decimal on either side keeps the fraction
            test("decimal / whole") {
                d : decimal = 7;
                expect(d / b).should_be(3.5);
            };
            test("whole / decimal") { expect(a / 2.0).should_be(3.5); };
            test("whole as decimal / whole") { expect(a as decimal / b).should_be(3.5); };
            test("half(7)") { expect(half(7)).should_be(3.5); };
        };

        // ---- /=
        test("n /= 5") {
            n : _int64 = 17;
            n /= 5;
            expect(n).should_be(3);
        };
        test("a decimal /= 5") {
            f : decimal = 17;
            f /= 5;
            expect(f).should_be(3.4);
        };

        // ---- numbers past what a decimal holds exactly stay exact
        test("2^53 + 1 divided by 1 is itself") {
            big : _int64 = 9007199254740993;
            expect_true(big / 1 == big);
        };
        test("2^53 + 1 divided by itself is 1") {
            big : _int64 = 9007199254740993;
            expect_true(big / big == 1);
        };

        // ---- the smallest number divided by -1 does not fit: it wraps round to itself, as in Java
        test("the smallest number / -1") {
            lowest : _int64 = -9223372036854775807 - 1;
            minus_one : _int64 = -1;
            expect_true(lowest / minus_one == lowest);
        };

        // ---- by zero: an exception, not the end of the VM
        test("a whole number divided by zero raises") {
            zero : _int64 = 0;
            expect_throws<invalid_operation_exception>() { div(5, zero); };
        };

        // (n and zero are locals of the block: /= on a plain local, as in a function)
        test("/= zero raises") {
            expect_throws<invalid_operation_exception>() {
                n : _int64 = 3;
                zero : _int64 = 0;
                n /= zero;
            };
        };

        // (a loop that runs long enough to be turned into machine code; the
        //  catching is part of what is checked: every division by zero is caught)
        test("a hot loop: the divisions, and the divisions by zero") {
            total : _int64 = 0;
            caught : _int64 = 0;
            for(i : _int64 = 0; i < 20000; i++) {
                try { total += 1000 / (i % 7); } catch(e: invalid_operation_exception) { caught++; }
            }
            expect(total).named("the divisions").should_be(2857 * (1000 + 500 + 333 + 250 + 200 + 166));
            expect(caught).named("the divisions by zero").should_be(2858);
        };

        // ---- a decimal divided by zero is still infinity
        test("1.0 / 0 is infinity") {
            nothing : decimal = 0;
            expect_true(1.0 / nothing > 1000000);
        };
    };
}
