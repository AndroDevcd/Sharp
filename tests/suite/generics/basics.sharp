mod suite.generics.basics;

import ( std.testing )

/**
 * Generics: a class written once with a type left open (`box<T>`) and used
 * with the type filled in (`box<decimal>`, `box<string>`, `box<point>`). The
 * open type can be used for fields, parameters, return values, arrays and
 * for other generic classes.
 *
 * (Two closing brackets in a row used to have to be written `> >`; `>>` is
 * read correctly now, see isolated_and_nested.sharp.)
 */

class point {
    x : decimal = 0;
    y : decimal = 0;

    point(px: decimal, py: decimal) {
        x = px;
        y = py;
    }

    def sum(): decimal {
        return x + y;
    }
}

class named_point base point {
    name : string = "";

    named_point(name: string, px: decimal, py: decimal) -> base(px, py) {
        self->name = name;
    }
}

/* one type parameter */
class box<T> {
    item : T;
    puts : decimal = 0;

    box(first: T) {
        item = first;
    }

    def take(): T {
        return item;
    }

    def put(next: T) {
        item = next;
        puts++;
    }

    /* gives back what was there before */
    def swap(next: T): T {
        before : T = item;
        item = next;
        return before;
    }

    def copy_from(other: box<T>) {
        item = other.item;
    }
}

/* two type parameters */
class pair_of<A, B> {
    first : A;
    second : B;

    pair_of(a: A, b: B) {
        first = a;
        second = b;
    }

    def get_first(): A {
        return first;
    }

    def get_second(): B {
        return second;
    }

    def set_both(a: A, b: B) {
        first = a;
        second = b;
    }

    /* a method whose result is the same generic class with the types the other way round */
    def flipped(): pair_of<B, A> {
        return new pair_of<B, A>(second, first);
    }
}

/* three type parameters */
class triple_of<A, B, C> {
    one : A;
    two : B;
    three : C;

    triple_of(a: A, b: B, c: C) {
        one = a;
        two = b;
        three = c;
    }
}

/* an array of the open type */
class stack_of<T> {
    items : T[];
    count : decimal = 0;

    stack_of(capacity: decimal) {
        items = new T[capacity];
    }

    def push(item: T) {
        items[count] = item;
        count++;
    }

    def pop(): T {
        count--;
        return items[count];
    }

    def peek(): T {
        return items[count - 1];
    }

    def at(index: decimal): T {
        return items[index];
    }

    def is_empty(): decimal {
        return count == 0;
    }
}

/* a generic class that uses another generic class with its own type */
class history_of<T> {
    current : box<T>;
    older : stack_of<T>;

    history_of(first: T) {
        current = new box<T>(first);
        older = new stack_of<T>(8);
    }

    def change(next: T) {
        older.push(current.take());
        current.put(next);
    }

    def undo() {
        current.put(older.pop());
    }

    def now(): T {
        return current.take();
    }
}

/* the open type must be point or a class below it, so its members can be used */
class point_holder<T base point> {
    held : T;

    point_holder(p: T) {
        held = p;
    }

    def held_sum(): decimal {
        return held.x + held.y;
    }

    def give(): T {
        return held;
    }
}

def unbox(b: box<decimal>): decimal {
    return b.take();
}

def boxed_point(x: decimal, y: decimal): box<point> {
    return new box<point>(new point(x, y));
}

def basics_tests() {
    tests("basics") {
        // ---- a native number as the type
        test("box<var>: the first item") {
            numbers := new box<decimal>(7);
            expect(numbers.take()).should_be(7);
        };
        tests("box_of_numbers") {
            numbers : box<decimal>;
            before_each {
                numbers = new box<decimal>(7);
                numbers.put(8.5);
            };

            test("box<var>: after put") { expect(numbers.take()).should_be(8.5); };
            test("box<var>: the field itself") { expect(numbers.item).should_be(8.5); };
            test("box<var>: swap gives the old item, and stores the new one") {
                expect(numbers.swap(100)).named("swap gives").should_be(8.5);
                expect(numbers.take()).named("stored").should_be(100);
            };
            test("box<var>: a method that only counts") {
                numbers.swap(100);
                expect(numbers.puts).should_be(1);
            };
            test("box<var>: the result in arithmetic") {
                numbers.swap(100);
                expect(numbers.take() * 2 + 1).should_be(201);
            };
        };

        // ---- sized numbers keep their size inside the generic class
        test("box<_int8>: holds 100") {
            bytes := new box<_int8>(100);
            expect(bytes.take()).should_be(100);
        };
        test("box<_int8>: 200 wraps to -56") {
            bytes := new box<_int8>(100);
            bytes.put(200);
            expect(bytes.take()).should_be(0 - 56);
        };
        test("box<_int16>: holds 32767") {
            words := new box<_int16>(32767);
            expect(words.take()).should_be(32767);
        };
        test("box<_int16>: 32768 wraps to -32768") {
            words := new box<_int16>(32767);
            words.put(32768);
            expect(words.take()).should_be(0 - 32768);
        };
        test("box<_int32>: holds 2147483647") {
            ints := new box<_int32>(2147483647);
            expect(ints.take()).should_be(2147483647);
        };
        test("box<_int32>: 2147483648 wraps to -2147483648") {
            ints := new box<_int32>(2147483647);
            ints.put(2147483648);
            expect(ints.take()).should_be(0 - 2147483648);
        };
        test("box<_uint8>: 256 wraps to 0") {
            unsigned := new box<_uint8>(255);
            unsigned.put(256);
            expect(unsigned.take()).should_be(0);
        };
        test("box<var> next to them still holds a fraction") {
            bytes := new box<_int8>(100);
            bytes.put(200);
            unsigned := new box<_uint8>(255);
            unsigned.put(256);
            numbers := new box<decimal>(7);
            numbers.put(0.25);
            expect(numbers.take()).should_be(0.25);
        };

        // ---- a class as the type
        tests("box_of_points") {
            points : box<point>;
            before_each { points = new box<point>(new point(3, 4)); };

            test("box<point>: a field of the item") { expect(points.take().x).should_be(3); };
            test("box<point>: a method of the item") { expect(points.take().sum()).should_be(7); };
            test("box<point>: swap gives the old object, and stores the new one") {
                replaced := points.swap(new point(10, 20));
                expect(replaced.sum()).named("swap gives").should_be(7);
                expect(points.item.y).named("stored").should_be(20);
            };
            test("box<point>: the object itself is stored, not a copy, so a change to it is seen through the box") {
                same_point := new point(1, 1);
                points.put(same_point);
                expect(points.take() == same_point).named("the same object").should_be(1);
                same_point.x = 50;
                expect(points.take().x).named("the change seen through the box").should_be(50);
            };
        };

        // ---- a string and a boxed number as the type
        tests("box_of_strings") {
            texts : box<string>;
            before_each { texts = new box<string>("first"); };

            test("box<string>: the first item") { expect(texts.take()).should_be("first"); };
            test("box<string>: after put") {
                texts.put("second");
                expect(texts.take()).should_be("second");
            };
            test("box<string>: swap") {
                texts.put("second");
                expect(texts.swap("third")).should_be("second");
            };
            test("box<string>: a method of the item") {
                texts.put("second");
                texts.swap("third");
                expect(texts.take().size()).should_be(5);
            };
        };
        test("box<int>: the number inside the int object") {
            wrapped := new box<int>(new int(41));
            expect(wrapped.take().value).should_be(41);
        };

        // ---- each use of the class is separate
        tests("two_boxes") {
            box_one : box<decimal>;
            box_two : box<decimal>;
            before_each {
                box_one = new box<decimal>(1);
                box_two = new box<decimal>(2);
                box_one.put(11);
            };

            test("two boxes of the same type are separate") {
                expect(box_one.take()).named("first").should_be(11);
                expect(box_two.take()).named("second").should_be(2);
            };
            test("a parameter of the class's own generic type") {
                box_two.copy_from(box_one);
                expect(box_two.take()).should_be(11);
            };
            test("a generic object as a function parameter") { expect(unbox(box_one)).should_be(11); };
            test("stack_of<box<var> >: the same objects come back") {
                stack_of_boxes := new stack_of<box<decimal> >(3);
                stack_of_boxes.push(box_one);
                stack_of_boxes.push(box_two);
                expect(stack_of_boxes.count).named("count").should_be(2);
                expect(stack_of_boxes.at(0) == box_one).named("the same object").should_be(1);
            };
        };
        test("a generic object as a function result") { expect(boxed_point(5, 6).take().sum()).should_be(11); };

        // ---- two type parameters
        tests("pair") {
            p : pair_of<decimal, string>;
            before_each { p = new pair_of<decimal, string>(1, "one"); };

            test("pair_of<var, string>: first") { expect(p.first).should_be(1); };
            test("pair_of<var, string>: second") { expect(p.second).should_be("one"); };
            test("pair_of: method returning the first type") { expect(p.get_first()).should_be(1); };
            test("pair_of: method returning the second type") { expect(p.get_second()).should_be("one"); };
            test("pair_of: method taking both types") {
                p.set_both(2, "two");
                expect(p.first).named("first").should_be(2);
                expect(p.second).named("second").should_be("two");
            };
            test("flipped: the types and the values change places") {
                p.set_both(2, "two");
                f := p.flipped();
                expect(f.first).named("the string is now first").should_be("two");
                expect(f.second).named("the number is now second").should_be(2);
                expect(f.flipped().get_first()).named("flipped twice is the original order").should_be(2);
            };
        };
        test("pair_of<point, point>") {
            q := new pair_of<point, point>(new point(1, 2), new point(3, 4));
            expect(q.first.sum()).named("first").should_be(3);
            expect(q.second.sum()).named("second").should_be(7);
        };
        test("pair_of<var, var>") {
            same_types := new pair_of<decimal, decimal>(8, 9);
            expect(same_types.first).named("first").should_be(8);
            expect(same_types.flipped().first).named("second").should_be(9);
        };
        test("pair_of<string, point>") {
            mixed := new pair_of<string, point>("origin", new point(0, 0));
            expect(mixed.first).named("first").should_be("origin");
            expect(mixed.second.sum()).named("second").should_be(0);
        };

        // ---- three type parameters
        test("triple_of keeps three types") {
            t := new triple_of<decimal, string, point>(1, "two", new point(3, 3));
            expect(t.one).named("first").should_be(1);
            expect(t.two).named("second").should_be("two");
            expect(t.three.sum()).named("third").should_be(6);
        };

        // ---- an array of the open type
        test("stack_of<var>: empty at first") {
            stack := new stack_of<decimal>(10);
            expect(stack.is_empty()).should_be(1);
        };
        tests("stack_of_numbers") {
            stack : stack_of<decimal>;
            before_each {
                stack = new stack_of<decimal>(10);
                stack.push(3);
                stack.push(6);
                stack.push(9);
            };

            test("stack_of<var>: count") { expect(stack.count).should_be(3); };
            test("stack_of<var>: peek") { expect(stack.peek()).should_be(9); };
            test("stack_of<var>: at(0)") { expect(stack.at(0)).should_be(3); };
            test("stack_of<var>: pop gives them back in reverse") {
                expect(stack.pop()).named("pop").should_be(9);
                expect(stack.pop()).named("pop again").should_be(6);
                expect(stack.count).named("one left").should_be(1);
                expect(stack.is_empty()).named("not empty").should_be(0);
            };
            test("stack_of<var>: filled in a loop") {
                stack.pop();
                stack.pop();
                for(i : decimal = 0; i < 9; i++) {
                    stack.push(i * i);
                }
                expect(stack.count).named("count").should_be(10);
                expect(stack.peek()).named("the last one pushed").should_be(64);
            };
        };
        test("stack_of<point>: pop gives them back in reverse") {
            object_stack := new stack_of<point>(4);
            object_stack.push(new point(1, 1));
            object_stack.push(new point(2, 2));
            expect(object_stack.pop().sum()).named("pop").should_be(4);
            expect(object_stack.pop().sum()).named("pop again").should_be(2);
            expect(object_stack.is_empty()).named("empty").should_be(1);
        };
        test("stack_of<string>: pop, then peek") {
            string_stack := new stack_of<string>(4);
            string_stack.push("bottom");
            string_stack.push("top");
            expect(string_stack.pop()).named("pop").should_be("top");
            expect(string_stack.peek()).named("peek").should_be("bottom");
        };

        // ---- a generic class as the type of another
        test("box<box<var> >: the inner item, changed through the outer box") {
            nested := new box<box<decimal> >(new box<decimal>(3));
            expect(nested.take().take()).named("the inner item").should_be(3);
            nested.take().put(4);
            expect(nested.take().take()).named("changed through the outer box").should_be(4);
        };
        test("box<pair_of<var, string> >") {
            pair_box := new box<pair_of<decimal, string> >(new pair_of<decimal, string>(5, "five"));
            expect(pair_box.take().first).named("first").should_be(5);
            expect(pair_box.take().second).named("second").should_be("five");
        };

        // ---- a generic class built from other generic classes
        test("history_of<var>: now, and after one and two undos") {
            h := new history_of<decimal>(1);
            h.change(2);
            h.change(3);
            expect(h.now()).named("now").should_be(3);
            h.undo();
            expect(h.now()).named("after one undo").should_be(2);
            h.undo();
            expect(h.now()).named("after two undos").should_be(1);
        };
        test("history_of<string>: now, and after undo") {
            names := new history_of<string>("draft");
            names.change("final");
            expect(names.now()).named("now").should_be("final");
            names.undo();
            expect(names.now()).named("after undo").should_be("draft");
        };

        // ---- an open type that must be a certain class
        test("point_holder<point>: uses the point's fields") {
            holder := new point_holder<point>(new point(2, 3));
            expect(holder.held_sum()).should_be(5);
        };
        tests("named_point_holder") {
            named : point_holder<named_point>;
            before_each { named = new point_holder<named_point>(new named_point("corner", 7, 8)); };

            test("point_holder<named_point>: uses the inherited fields") { expect(named.held_sum()).should_be(15); };
            test("point_holder<named_point>: gives back the full type") { expect(named.give().name).should_be("corner"); };
        };
    };
}
