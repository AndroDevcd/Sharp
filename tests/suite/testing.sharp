mod testing;

/**
 * Sharp test suite - the checks every test file uses.
 *
 * A test file is an ordinary Sharp program:
 *
 *     mod main;
 *     import ( testing )
 *
 *     def main(args: string[]) {
 *         expect("1 + 2", 1 + 2, 3);
 *         expect_str("greeting", "he" + "llo", "hello");
 *         finish("arithmetic");
 *     }
 *
 * Each expect_* call is one CHECK. A check that fails prints a line starting
 * with "FAIL" that says what was expected and what the program produced; a
 * check that passes prints nothing. finish() prints the one line the runner
 * (run.sharp) looks for:
 *
 *     RESULT PASS arithmetic (2 checks)
 *     RESULT FAIL arithmetic (1 of 2 checks failed)
 *
 * A test that crashes or never reaches finish() prints no RESULT line at all,
 * which the runner reports as a failure too.
 */

passed : var = 0;
failed : var = 0;

/** two numbers must be exactly equal */
def expect(name: string, actual: var, expected: var) {
    if(actual == expected) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected $expected but got $actual");
    }
}

/** two numbers must be equal within `tolerance` (for results that are not exact, like 0.1 + 0.2) */
def expect_near(name: string, actual: var, expected: var, tolerance: var) {
    difference : var = actual - expected;
    if(difference < 0) {
        difference = 0 - difference;
    }

    if(difference <= tolerance) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected $expected (+- $tolerance) but got $actual");
    }
}

/** the condition must be true (anything that is not 0) */
def expect_true(name: string, condition: var) {
    if(condition != 0) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected true but got false");
    }
}

/** the condition must be false (0) */
def expect_false(name: string, condition: var) {
    if(condition == 0) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected false but got true");
    }
}

/** two strings must have the same characters */
def expect_str(name: string, actual: string, expected: string) {
    if(actual == expected) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected \"$expected\" but got \"$actual\"");
    }
}

/** the object must be null */
def expect_null(name: string, value: object) {
    if(value == null) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected null but got an object");
    }
}

/** the object must not be null */
def expect_not_null(name: string, value: object) {
    if(value != null) {
        passed++;
    } else {
        failed++;
        println("FAIL $name: expected an object but got null");
    }
}

/** record a failure outright, e.g. when code is reached that should never run */
def fail(name: string, why: string) {
    failed++;
    println("FAIL $name: $why");
}

/** record a pass outright, e.g. when the right catch block was reached */
def pass(name: string) {
    passed++;
}

/** print the result line for this test file. Call it last in main(). */
def finish(suite: string) {
    // (int objects, so the counts print as "44" and not "44.0000000000000000")
    total : int = passed + failed;
    bad : int = failed;
    if(failed == 0) {
        println("RESULT PASS $suite ($total checks)");
    } else {
        println("RESULT FAIL $suite ($bad of $total checks failed)");
    }
}
