mod suite.concurrency.fiber_recursive_suspend;

import (
    std.testing,
    std.io.fiber
)

/**
 * THE BUG THIS GUARDS (runtime, fixed): a fiber that was switched out while
 * one function was on its call stack more than once never continued. The
 * program hung with one thread at 100% cpu (interpreter) or crashed (JIT).
 *
 * WHERE
 *   virtual_machine.cpp, main_vm_loop(): every time a thread picks a fiber up
 *   again it walked the fiber's call stack from the bottom with
 *       while(frame != task->current) frame = get_next_frame(frame);
 *   and get_next_frame() looked a frame up BY FUNCTION: it returned the callee
 *   of the FIRST frame that belonged to that function. With the same function
 *   on the stack twice the walk came back to the first occurrence and went
 *   round for ever. (The JIT used the same lookup to rebuild compiled frames,
 *   and then continued in the wrong frame.) The fix walks the frames by
 *   index (0 .. callFramePtr) instead of searching for the function.
 *
 * WHAT IT MEANT
 *   Any recursion, direct or through other functions, was unsafe as soon as
 *   the fiber could be switched out inside it: delay(), a lock that is taken,
 *   fiber.suspend(), or simply the end of its time slice while another fiber
 *   is ready.
 *
 * WHAT std.io.coroutines DOES ABOUT IT
 *   - the library itself never calls a function of its own recursively (job
 *     trees are cancelled and finished with a work list, not by recursion)
 *   - the scope functions that call a block in-line (coroutine_scope { },
 *     supervisor_scope { }, run_blocking { }, with_timeout { }) each have
 *     their own code path, so different ones can be nested in each other
 *   - nesting one of them directly in ITSELF on the same fiber is refused
 *     with an illegal_state_exception instead of hanging
 *
 * EXPECTED: the test passes. Before the fix it hung after "going to sleep 3
 * calls deep".
 */

depth_reached : decimal = 0;

def descend(levels: decimal) {
    if(levels == 0) {
        println("going to sleep 3 calls deep");
        delay(5);                   // the fiber is switched out here, with descend() on the stack three times
        depth_reached = 1;
        return;
    }

    descend(levels - 1);
}

def fiber_recursive_suspend_tests() {
    tests("fiber_recursive_suspend") {
        test("the fiber continued after sleeping inside a recursive call") {
            depth_reached = 0;
            descend(2);
            expect(depth_reached).should_be(1);
        };
    };
}
