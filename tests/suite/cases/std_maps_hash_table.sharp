mod main;

import ( std.testing )

/**
 * std hash_table<k, v>: the key/value container whose every operation runs
 * inside lock(self) - put, at, contains_key, remove, size, clear, keys, values.
 *
 * (It used to not compile at all: the constructors were spelled `hashtable`.)
 * hash_map, the container without the lock, is in std_maps.sharp.
 */

class city {
    name : string = "";
    population : decimal = 0;

    city(city_name: string, people: decimal) {
        name = city_name;
        population = people;
    }
}

def main(args: string[]) {
    show_only_failures();
    tests("std_maps_hash_table") {
        // ================= string keys, number values
        ages := new hash_table<string, int>();
        test("a new table has size 0") { expect(ages.size).should_be(0); };
        test("a new table contains no key") { expect_false(ages.contains_key("ann").value); };

        // ---- put says whether the key is new
        test("put of a new key returns true") { expect_true(ages.put("ann", 31).value); };
        test("put of a second key returns true") { expect_true(ages.put("bob", 45).value); };
        test("put of a third key returns true") { expect_true(ages.put("cy", 8).value); };
        test("size after three puts") { expect(ages.size).should_be(3); };

        // ---- at and contains_key
        test("at(ann)") { expect(ages.at("ann")!!.value).should_be(31); };
        test("at(bob)") { expect(ages.at("bob")!!.value).should_be(45); };
        test("at(cy)") { expect(ages.at("cy")!!.value).should_be(8); };
        test("contains_key of a key that was put") { expect_true(ages.contains_key("bob").value); };
        test("contains_key of another key") { expect_false(ages.contains_key("dora").value); };
        built := "a" + "nn";
        test("a key built at run time finds the entry") { expect(ages.at(built)!!.value).should_be(31); };

        // ---- overwrite
        test("put of an existing key returns false") { expect_false(ages.put("bob", 46).value); };
        test("the value was replaced") { expect(ages.at("bob")!!.value).should_be(46); };
        test("overwriting does not change the size") { expect(ages.size).should_be(3); };
        test("the other entries are untouched") { expect(ages.at("ann")!!.value + ages.at("cy")!!.value).should_be(39); };

        // ---- remove
        test("remove of an existing key returns true") { expect_true(ages.remove("bob").value); };
        test("remove makes the table smaller") { expect(ages.size).should_be(2); };
        test("a removed key is not contained") { expect_false(ages.contains_key("bob").value); };
        test("at() of a removed key is null") { expect_null(ages.at("bob")); };
        test("remove of a key that is not there returns false") { expect_false(ages.remove("bob").value); };
        test("...and changes nothing") { expect(ages.size).should_be(2); };
        test("the other keys survive a remove") { expect(ages.at("ann")!!.value).should_be(31); };
        test("a removed key can be put again as a new key") { expect_true(ages.put("bob", 50).value); };
        test("...with its new value") { expect(ages.at("bob")!!.value).should_be(50); };

        // ---- clear
        ages.clear();
        test("clear: size 0") { expect(ages.size).should_be(0); };
        test("clear: the keys are gone") { expect_false(ages.contains_key("ann").value); };
        test("after clear a key is new again") { expect_true(ages.put("ann", 1).value); };
        test("value put after clear") { expect(ages.at("ann")!!.value).should_be(1); };

        // ================= object values
        cities := new hash_table<string, city>();
        paris := new city("paris", 2100000);
        cities.put("fr", paris);
        cities.put("it", new city("rome", 2800000));
        test("object values: field of at(fr)") { expect(cities.at("fr")!!.name).should_be("paris"); };
        test("object values: field of at(it)") { expect(cities.at("it")!!.population).should_be(2800000); };
        test("at gives the object that was put, not a copy") { expect_true(cities.at("fr") == paris); };
        test("a missing key gives null") { expect_null(cities.at("de")); };
        test("looking up a missing key adds nothing") { expect(cities.size).should_be(2); };

        // ================= int keys, also ones that share a bucket (1, 129, 257)
        names := new hash_table<int, string>();
        names.put(1, "one");
        names.put(129, "one hundred twenty nine");
        names.put(257, "two hundred fifty seven");
        names.put(0, "zero");
        names.put(0 - 7, "minus seven");
        test("int keys: size") { expect(names.size).should_be(5); };
        test("first key of the bucket") { expect(names.at(1)!!).should_be("one"); };
        test("second key of the bucket") { expect(names.at(129)!!).should_be("one hundred twenty nine"); };
        test("third key of the bucket") { expect(names.at(257)!!).should_be("two hundred fifty seven"); };
        test("key 0") { expect(names.at(0)!!).should_be("zero"); };
        test("key -7") { expect(names.at(0 - 7)!!).should_be("minus seven"); };
        test("a missing key of the same bucket is not contained") { expect_false(names.contains_key(385).value); };
        test("remove of the middle key of a bucket") { expect_true(names.remove(129).value); };
        test("...keeps the one before it") { expect(names.at(1)!!).should_be("one"); };
        test("...and the one after it") { expect(names.at(257)!!).should_be("two hundred fifty seven"); };
        test("...and the removed one is gone") { expect_false(names.contains_key(129).value); };

        // ================= many entries
        squares := new hash_table<int, int>();
        new_keys : decimal = 0;
        for(i : decimal = 0; i < 500; i++) {
            if(squares.put(i, i * i).value) new_keys++;
        }
        test("500 puts: every key was new") { expect(new_keys).should_be(500); };
        test("500 puts: size") { expect(squares.size).should_be(500); };
        test("500 puts: at(0)") { expect(squares.at(0)!!.value).should_be(0); };
        test("500 puts: at(321)") { expect(squares.at(321)!!.value).should_be(103041); };
        test("500 puts: at(499)") { expect(squares.at(499)!!.value).should_be(249001); };
        sum : decimal = 0;
        for(i : decimal = 0; i < 500; i++) {
            sum += squares.at(i)!!.value;
        }
        test("500 puts: the sum of all values") { expect(sum).should_be(41541750); };

        // remove every second key
        removed : decimal = 0;
        for(i : decimal = 0; i < 500; i += 2) {
            if(squares.remove(i).value) removed++;
        }
        test("250 removes all found their key") { expect(removed).should_be(250); };
        test("250 entries left") { expect(squares.size).should_be(250); };
        test("a removed key") { expect_false(squares.contains_key(200).value); };
        test("a key that was kept") { expect(squares.at(201)!!.value).should_be(40401); };

        // ================= keys() and values()
        small := new hash_table<string, int>();
        small.put("a", 1);
        small.put("b", 2);
        small.put("c", 3);
        test("keys(): one per entry") { expect(small.keys().size().value).should_be(3); };
        test("values(): one per entry") { expect(small.values().size().value).should_be(3); };
        total : decimal = 0;
        foreach(v in small.values()) {
            total += v.value;
        }
        test("values(): 1 + 2 + 3") { expect(total).should_be(6); };
        found : decimal = 0;
        foreach(k in small.keys()) {
            if(k == "a" || k == "b" || k == "c") found++;
        }
        test("keys(): every key is one that was put") { expect(found).should_be(3); };

        // ================= two tables are independent
        first := new hash_table<string, int>();
        second := new hash_table<string, int>();
        first.put("k", 1);
        second.put("k", 2);
        test("same key in two tables (first)") { expect(first.at("k")!!.value).should_be(1); };
        test("same key in two tables (second)") { expect(second.at("k")!!.value).should_be(2); };
    };
    finish_tests();
}
