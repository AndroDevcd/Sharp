mod main;

import ( testing )

/**
 * The number classes of the standard library: int, double, char, uchar,
 * short, ushort, uint, long, byte and bool.
 *
 * They are OBJECTS ("boxes") that hold one native number in `.value`.
 * `z := 1;` makes an int box; `x : decimal = 1;` makes a native number.
 *
 * Three things to keep in mind when reading the checks:
 *   - an operator between two boxes makes a NEW box of the type on the left
 *   - `=` with a number and the in-place operators (+=, ++ ...) change the
 *     box itself, so every variable that refers to that box sees the change
 *   - the sized classes wrap around like the C types they are named after
 */

/** changes the caller's box */
def add_ten(n: int) { n += 10; }

/** `=` with a number writes into the caller's box */
def store_99(n: int) { n = 99; }

/** `=` with another box only re-points the local name; the caller's box is untouched */
def point_elsewhere(n: int) { n = new int(1000); }

def main(args: string[]) {
    // ---- construction and .value
    a : int = 5;
    b := new int(7);
    expect("int from a literal", a.value, 5);
    expect("new int(7)", b.value, 7);
    z := 1;
    expect("z := 1 is an int box", z.value, 1);
    zc := 'c';
    expect("zc := 'c' is a char box", zc.value, 99);
    zb := true;
    expect("zb := true is a bool box", zb.value, 1);
    zd := 1.5;
    expect("zd := 1.5 keeps the fraction", zd.value, 1.5);
    plain : decimal = b.value;
    plain++;
    expect("a copy of .value is separate from the box", b.value, 7);
    expect("...the copy changed", plain, 8);

    // ---- a fraction given to an integer box is cut off (towards zero)
    cut := new int(2.9);
    expect("new int(2.9)", cut.value, 2);
    cut_negative := new int(0 - 2.9);
    expect("new int(-2.9)", cut_negative.value, 0 - 2);
    assigned : int = 7.8;
    expect("int = 7.8", assigned.value, 7);

    // ---- arithmetic between boxes gives a new box
    sum := a + b;
    expect("int + int", sum.value, 12);
    expect("int - int", (a - b).value, 0 - 2);
    expect("int * native", (a * 2).value, 10);
    expect("int / int is cut to a whole number", (b / a).value, 1);
    expect("int % int", (b % a).value, 2);
    expect("5 / 2 in an int", (a / 2).value, 2);
    expect("5 % 2 in an int", (a % 2).value, 1);
    negated := -a;
    expect("unary minus", negated.value, 0 - 5);
    expect("the operands are unchanged", a.value + b.value, 12);

    // ---- a box and a native number
    ten : decimal = 10;
    expect("native - box is a native number", ten - a, 5);
    expect("box + native is a box", (a + ten).value, 15);
    expect(".value in native arithmetic", a.value + 1, 6);

    // ---- comparisons give a bool box
    expect_true("5 < 7", (a < b).value);
    expect_false("5 > 7", (a > b).value);
    expect_true("5 <= 5", (a <= 5).value);
    expect_false("5 >= 7", (a >= b).value);
    expect_true("5 == 5", (a == 5).value);
    expect_true("5 != 7", (a != b).value);
    same_value := new int(5);
    expect_true("two different boxes with the same value are ==", (a == same_value).value);

    // ...and can be used directly as a condition
    taken : decimal = 0;
    if(a < b) { taken = 1; }
    expect("if(box < box)", taken, 1);
    taken = 0;
    if(a == 5 && b > 6) { taken = 1; }
    expect("if(... && ...)", taken, 1);
    taken = 0;
    if(a == 6 || b > 6) { taken = 1; }
    expect("if(... || ...)", taken, 1);

    // ---- in-place operators
    c : int = 5;
    c += 3;
    expect("+=", c.value, 8);
    c -= 1;
    expect("-=", c.value, 7);
    c *= 4;
    expect("*=", c.value, 28);
    c /= 2;
    expect("/=", c.value, 14);
    c %= 5;
    expect("%=", c.value, 4);
    c++;
    expect("++ after", c.value, 5);
    c--;
    c--;
    expect("-- twice", c.value, 3);
    ++c;
    expect("++ before", c.value, 4);

    // ---- a loop counter that is a box
    total := new int(0);
    for(k := 0; k < 5; k++) {
        total += k;
    }
    expect("0 + 1 + 2 + 3 + 4", total.value, 10);

    // ---- two variables, one box
    p := new int(1);
    q := p;
    q += 5;
    expect("+= through the other name", p.value, 6);
    q = 40;
    expect("= with a number writes into the shared box", p.value, 40);
    q = new int(50);
    expect("= with a new box re-points q only", p.value, 40);
    expect("...q is the new box", q.value, 50);

    r := p + 0;
    r += 1;
    expect("p + 0 is a new box, changing it leaves p alone", p.value, 40);
    expect("...the new box", r.value, 41);

    copied := new int(p);
    copied += 1;
    expect("new int(p) copies the value", copied.value, 41);
    expect("...and p is unchanged", p.value, 40);

    // ---- boxes as parameters
    arg := new int(1);
    add_ten(arg);
    expect("+= inside a function is seen by the caller", arg.value, 11);
    store_99(arg);
    expect("= with a number inside a function is seen by the caller", arg.value, 99);
    point_elsewhere(arg);
    expect("= with another box inside a function is not", arg.value, 99);

    // ---- char: -128 .. 127
    ch : char = 127;
    ch += 1;
    expect("char 127 + 1", ch.value, 0 - 128);
    ch = 127;
    ch++;
    expect("char 127 ++", ch.value, 0 - 128);
    ch = 0 - 128;
    ch -= 1;
    expect("char -128 - 1", ch.value, 127);
    big_char := new char(300);
    expect("new char(300)", big_char.value, 44);
    letter : char = 'z';
    expect("char from a character", letter.value, 122);
    expect_true("char == character", (letter == 'z').value);

    // ---- uchar and byte: 0 .. 255
    uc : uchar = 255;
    uc += 1;
    expect("uchar 255 + 1", uc.value, 0);
    uc = 0;
    uc -= 1;
    expect("uchar 0 - 1", uc.value, 255);
    by : byte = 250;
    by += 10;
    expect("byte 250 + 10", by.value, 4);

    // ---- short: -32768 .. 32767
    sh : short = 32767;
    sh++;
    expect("short 32767 ++", sh.value, 0 - 32768);
    sh = 32767;
    sh += 2;
    expect("short 32767 + 2", sh.value, 0 - 32767);

    // ---- ushort: 0 .. 65535
    us : ushort = 65535;
    us++;
    expect("ushort 65535 ++", us.value, 0);

    // ---- int: -2147483648 .. 2147483647
    i : int = 2147483647;
    i += 1;
    expect("int 2^31 - 1 + 1", i.value, 0 - 2147483648);
    i = 0 - 2147483648;
    i -= 1;
    expect("int -2^31 - 1", i.value, 2147483647);
    i = 65536;
    i *= 65536;
    expect("int 2^16 * 2^16", i.value, 0);

    // ---- uint: 0 .. 4294967295
    ui : uint = 4294967295;
    ui += 1;
    expect("uint 2^32 - 1 + 1", ui.value, 0);

    // ---- long and ulong hold what an int cannot
    lg : long = 4294967296;
    lg *= 2;
    expect("long 2^32 * 2", lg.value, 8589934592);
    ul : ulong = 5;
    ul *= 3;
    expect("ulong 5 * 3", ul.value, 15);

    // ---- double keeps fractions
    d : double = 2.5;
    expect("double * native", (d * 2).value, 5);
    d /= 2;
    expect("double /= 2", d.value, 1.25);

    // ---- mixed classes: the result has the class of the LEFT operand
    five := new int(5);
    half := new double(2.5);
    two_33 := new long(8589934592);
    expect("double + int is a double", (half + five).value, 7.5);
    expect("int + double is an int", (five + half).value, 7);
    expect("long + int is a long", (two_33 + five).value, 8589934597);
    expect("int + long wraps to an int", (five + two_33).value, 5);
    expect_true("int == long", (five == new long(5)).value);
    expect_false("int 5 < double 2.5", (five < half).value);

    // ---- bool
    t : bool = true;
    f : bool = false;
    expect("true is 1", t.value, 1);
    expect("false is 0", f.value, 0);
    expect_false("!true", (!t).value);
    expect_true("true == true", (t == true).value);
    expect_true("true != false", (t != f).value);
    taken = 0;
    if(t) { taken = 1; }
    expect("if(bool box)", taken, 1);
    taken = 0;
    if(!f) { taken = 1; }
    expect("if(!bool box)", taken, 1);
    from_five := new bool(5);
    expect("new bool(5) is true", from_five.value, 1);
    from_half := new bool(0.5);
    expect("new bool(0.5) is false (true means >= 1)", from_half.value, 0);

    // ---- conversions between the classes
    pi_ish := new double(3.7);
    expect("double 3.7 to_int", pi_ish.to_int().value, 3);
    three_21 := new int(321);
    expect("int 321 to_char wraps", three_21.to_char().value, 65);
    expect("int 5 to_double / 2", five.to_double().value / 2, 2.5);
    expect("to_long", five.to_long().value, 5);
    expect("to_short", five.to_short().value, 5);
    expect("to_bool", five.to_bool().value, 1);

    // ---- to_string and string interpolation
    expect_str("int to_string", five.to_string()!!, "5");
    minus_twelve := new short(0 - 12);
    expect_str("negative short to_string", minus_twelve.to_string()!!, "-12");
    expect_str("long to_string", two_33.to_string()!!, "8589934592");
    // a decimal is written with the fewest digits that read back as the same number
    // (until VM r19 it was sixteen places after the point: "2.5000000000000000")
    expect_str("double to_string is the short form", half.to_string()!!, "2.5");
    expect_str("a whole double has no fraction", new double(3).to_string()!!, "3");
    expect_str("a tenth is a tenth", new double(0.1).to_string()!!, "0.1");
    expect_str("bool to_string", t.to_string(), "true");
    expect_str("false to_string", f.to_string(), "false");
    expect_str("char to_string is the character", letter.to_string()!!, "z");
    upper_a := new uchar(65);
    expect_str("uchar to_string is the character", upper_a.to_string()!!, "A");
    expect_str("boxes inside a string", "$five and $t and $two_33", "5 and true and 8589934592");

    // ---- parsing text
    expect("int.parse", int.parse("-123").value, 0 - 123);
    expect("double.parse", double.parse("2.5").value, 2.5);

    // ---- an int hashes to its own value
    expect("hash", b.hash().value, 7);

    // ---- helpers of char
    expect_true("is_digit('5')", char.is_digit('5').value);
    expect_false("is_digit('x')", char.is_digit('x').value);
    expect_true("is_alpha('x')", char.is_alpha('x').value);
    expect("to_upper('b') is 'B'", char.to_upper('b').value, 66);
    expect("to_lower('Q') is 'q'", char.to_lower('Q').value, 113);

    // ---- an array of boxes starts out as nulls
    boxes := new int[3];
    expect_null("element before it is set", boxes[0]);
    boxes[1] = new int(4);
    boxes[1] += 1;
    expect("+= on an element", boxes[1].value, 5);

    finish("boxed_numbers");
}
