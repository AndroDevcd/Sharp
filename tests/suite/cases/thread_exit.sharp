mod main;

import ( std.io, testing )

/**
 * thread.exit(code) ends the thread that calls it, there and then, with that code - and the
 * program still ends when `main` does. (The thread used to spin on the instruction for ever: the
 * join came back, but the program never finished.)
 */

reached : decimal = 0;

def worker(args: object[]) : int {
    reached = 1;
    thread.exit(7);
    reached = 2;            // never
    return 1;
}

def main(args: string[]) {
    first := new thread("worker", worker);
    first.start();
    first.join();
    expect("the thread ran up to exit", reached, 1);
    expect_true("its exit code", first.get_exit_code() == 7);
    expect_true("it has exited", first.is_exited());

    // and again: a second thread that exits does not find the first one in its way
    reached = 0;
    second := new thread("worker again", worker);
    second.start();
    second.join();
    expect("a second thread ran up to exit", reached, 1);
    expect_true("its exit code", second.get_exit_code() == 7);
    finish("thread_exit");
}
