mod main;

import ( std.testing, std.math )

/**
 * std.math - the number classes complex and fraction
 * (lib/support/0.4.0/std/math/numbers/). big_integer has its own file.
 */

def check_complex() {
    a := new complex(3, 4);
    b := new complex(1, 0 - 2);

    test("default constructor") { expect(new complex().re + new complex().im).should_be(0); };
    test("copy constructor") { expect(new complex(a).im).should_be(4); };
    test("zero") { expect(complex.zero().re).should_be(0); };
    test("one") { expect(complex.one().re).should_be(1); };
    test("i") { expect(complex.i().im).should_be(1); };
    test("of_real") { expect(complex.of_real(7).re).should_be(7); };
    test("of_real has no imaginary part") { expect(complex.of_real(7).im).should_be(0); };

    sum := a + b;
    test("a + b: re") { expect(sum.re).should_be(4); };
    test("a + b: im") { expect(sum.im).should_be(2); };
    difference := a - b;
    test("a - b: re") { expect(difference.re).should_be(2); };
    test("a - b: im") { expect(difference.im).should_be(6); };
    product := a * b;                                   // 3 - 6i + 4i - 8i^2 = 11 - 2i
    test("a * b: re") { expect(product.re).should_be(11); };
    test("a * b: im") { expect(product.im).should_be(0 - 2); };
    quotient := a / b;                                  // (3 + 4i)(1 + 2i) / 5 = (-5 + 10i) / 5
    test("a / b: re") { expect(quotient.re).should_be(0 - 1); };
    test("a / b: im") { expect(quotient.im).should_be(2); };
    negated := -a;
    test("-a: re") { expect(negated.re).should_be(0 - 3); };
    test("-a: im") { expect(negated.im).should_be(0 - 4); };
    test("a + 2") { expect((a + 2).re).should_be(5); };
    test("a + 2 keeps im") { expect((a + 2).im).should_be(4); };
    test("a - 2") { expect((a - 2).re).should_be(1); };
    test("a * 2: re") { expect((a * 2).re).should_be(6); };
    test("a * 2: im") { expect((a * 2).im).should_be(8); };
    test("a / 2: re") { expect((a / 2).re).should_be(1.5); };
    test("a / 2: im") { expect((a / 2).im).should_be(2); };
    i_squared := complex.i() * complex.i();
    test("i * i: re") { expect(i_squared.re).should_be(0 - 1); };
    test("i * i: im") { expect(i_squared.im).should_be(0); };
    test("==") { expect_true((a == new complex(3, 4)).value); };
    test("== different") { expect_false((a == b).value); };
    test("!=") { expect_true((a != b).value); };
    test("approx_equals") { expect_true(a.approx_equals(new complex(3.0000001, 4), 0.000001).value); };

    caught : decimal = 0;
    try { a / complex.zero(); } catch(e: division_by_zero_exception) { caught++; }
    try { a / 0; } catch(e: division_by_zero_exception) { caught++; }
    try { complex.zero().reciprocal(); } catch(e: division_by_zero_exception) { caught++; }
    test("division by zero throws") { expect(caught).should_be(3); };

    test("magnitude") { expect(a.magnitude()).should_be(5); };
    test("magnitude_squared") { expect(a.magnitude_squared()).should_be(25); };
    test("phase of i") { expect(complex.i().phase()).should_be_near(HALF_PI, 0.000000000001); };
    test("phase of -1") { expect(new complex(0 - 1, 0).phase()).should_be_near(PI_VALUE, 0.000000000001); };
    test("conjugate re") { expect(a.conjugate().re).should_be(3); };
    test("conjugate im") { expect(a.conjugate().im).should_be(0 - 4); };
    test("a * conjugate is |a|^2") { expect((a * a.conjugate()).re).should_be(25); };
    r := a.reciprocal();                                // (3 - 4i) / 25
    test("reciprocal re") { expect(r.re).should_be_near(0.12, 0.000000000001); };
    test("reciprocal im") { expect(r.im).should_be_near(0 - 0.16, 0.000000000001); };
    test("is_real") { expect_true(complex.of_real(2).is_real().value); };
    test("is_real of a") { expect_false(a.is_real().value); };
    test("is_zero") { expect_true(complex.zero().is_zero().value); };
    test("is_zero of a") { expect_false(a.is_zero().value); };

    polar := complex.from_polar(2, HALF_PI);
    test("from_polar re") { expect(polar.re).should_be_near(0, 0.000000000001); };
    test("from_polar im") { expect(polar.im).should_be_near(2, 0.000000000001); };

    euler := new complex(0, PI_VALUE).exp();            // e^(i pi) = -1
    test("e^(i pi): re") { expect(euler.re).should_be_near(0 - 1, 0.000000000001); };
    test("e^(i pi): im") { expect(euler.im).should_be_near(0, 0.000000000001); };
    log := new complex(0 - 1, 0).log();                 // ln(-1) = i pi
    test("ln(-1): re") { expect(log.re).should_be_near(0, 0.000000000001); };
    test("ln(-1): im") { expect(log.im).should_be_near(PI_VALUE, 0.000000000001); };
    try {
        complex.zero().log();
        test("ln(0)") { fail_test("no exception"); };
    } catch(e: arithmetic_exception) {
        test("ln(0) throws") { };
    }

    squared := a.pow(2);                                // 9 - 16 + 24i
    test("(3 + 4i)^2: re") { expect(squared.re).should_be_near(0 - 7, 0.00000000001); };
    test("(3 + 4i)^2: im") { expect(squared.im).should_be_near(24, 0.00000000001); };
    test("0^0") { expect(complex.zero().pow(0).re).should_be(1); };
    test("0^3") { expect(complex.zero().pow(3).re).should_be(0); };
    root := a.sqrt();                                   // 2 + i
    test("sqrt(3 + 4i): re") { expect(root.re).should_be_near(2, 0.000000000001); };
    test("sqrt(3 + 4i): im") { expect(root.im).should_be_near(1, 0.000000000001); };
    imaginary_root := new complex(0 - 4, 0).sqrt();     // 2i
    test("sqrt(-4): re") { expect(imaginary_root.re).should_be_near(0, 0.000000000001); };
    test("sqrt(-4): im") { expect(imaginary_root.im).should_be_near(2, 0.000000000001); };
    low_root := new complex(3, 0 - 4).sqrt();           // 2 - i
    test("sqrt(3 - 4i): im") { expect(low_root.im).should_be_near(0 - 1, 0.000000000001); };

    test("to_string") { expect(a.to_string()!!).should_be("3 + 4i"); };
    test("to_string negative im") { expect(b.to_string()!!).should_be("1 - 2i"); };
    test("to_string fractions") { expect(new complex(0.5, 0 - 1.25).to_string()!!).should_be("0.5 - 1.25i"); };
    test("equal numbers have equal hashes") { expect_true((a.hash() == new complex(3, 4).hash()).value); };
}

def check_fraction() {
    half := new fraction(1, 2);
    third := new fraction(1, 3);

    // ---- normalisation
    f := new fraction(6, 8);
    test("6/8 numerator") { expect(f.numerator).should_be(3); };
    test("6/8 denominator") { expect(f.denominator).should_be(4); };
    g := new fraction(1, 0 - 2);
    test("1/-2 numerator") { expect(g.numerator).should_be(0 - 1); };
    test("1/-2 denominator") { expect(g.denominator).should_be(2); };
    h := new fraction(0 - 4, 0 - 6);
    test("-4/-6 numerator") { expect(h.numerator).should_be(2); };
    test("-4/-6 denominator") { expect(h.denominator).should_be(3); };
    z := new fraction(0, 5);
    test("0/5 numerator") { expect(z.numerator).should_be(0); };
    test("0/5 denominator") { expect(z.denominator).should_be(1); };
    whole := fraction.of(7);
    test("whole numerator") { expect(whole.numerator).should_be(7); };
    test("whole denominator") { expect(whole.denominator).should_be(1); };
    test("copy") { expect(new fraction(f).denominator).should_be(4); };
    test("zero") { expect(fraction.zero().numerator).should_be(0); };
    test("one") { expect(fraction.one().numerator).should_be(1); };

    caught : decimal = 0;
    try { new fraction(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { new fraction(1.5, 2); } catch(e: illegal_argument_exception) { caught++; }
    try { fraction.of(2.5); } catch(e: illegal_argument_exception) { caught++; }
    try { half / fraction.zero(); } catch(e: division_by_zero_exception) { caught++; }
    try { fraction.zero().reciprocal(); } catch(e: division_by_zero_exception) { caught++; }
    try { fraction.zero().pow(0 - 1); } catch(e: division_by_zero_exception) { caught++; }
    try { half.pow(0.5); } catch(e: illegal_argument_exception) { caught++; }
    test("misuse throws") { expect(caught).should_be(7); };

    // ---- arithmetic
    sum := half + third;
    test("1/2 + 1/3 numerator") { expect(sum.numerator).should_be(5); };
    test("1/2 + 1/3 denominator") { expect(sum.denominator).should_be(6); };
    exact := third + new fraction(1, 6);
    test("1/3 + 1/6 == 1/2") { expect_true((exact == half).value); };
    difference := half - third;
    test("1/2 - 1/3 numerator") { expect(difference.numerator).should_be(1); };
    test("1/2 - 1/3 denominator") { expect(difference.denominator).should_be(6); };
    two_thirds := new fraction(2, 3);
    product := two_thirds * new fraction(3, 4);
    test("2/3 * 3/4 numerator") { expect(product.numerator).should_be(1); };
    test("2/3 * 3/4 denominator") { expect(product.denominator).should_be(2); };
    quotient := half / third;
    test("1/2 / 1/3 numerator") { expect(quotient.numerator).should_be(3); };
    test("1/2 / 1/3 denominator") { expect(quotient.denominator).should_be(2); };
    negated := -half;
    test("-(1/2)") { expect(negated.numerator).should_be(0 - 1); };
    plus_one := half + 1;
    test("1/2 + 1") { expect(plus_one.numerator).should_be(3); };
    times_four := half * 4;
    test("1/2 * 4 numerator") { expect(times_four.numerator).should_be(2); };
    test("1/2 * 4 is whole") { expect_true(times_four.is_whole().value); };

    // ten times one tenth is exactly one (it is not in floating point)
    total := fraction.zero();
    tenth := new fraction(1, 10);
    for(i : decimal = 0; i < 10; i++) {
        total = total + tenth;
    }
    test("ten tenths are exactly one") { expect_true((total == fraction.one()).value); };

    // ---- comparison
    test("compare_to smaller") { expect(third.compare_to(half)).should_be(0 - 1); };
    test("compare_to larger") { expect(half.compare_to(third)).should_be(1); };
    test("compare_to equal") { expect(half.compare_to(new fraction(2, 4))).should_be(0); };
    test("==") { expect_true((half == new fraction(2, 4)).value); };
    test("!=") { expect_true((half != third).value); };
    test("<") { expect_true((third < half).value); };
    test("< reversed") { expect_false((half < third).value); };
    test(">") { expect_true((half > third).value); };
    test("<=") { expect_true((half <= new fraction(1, 2)).value); };
    test(">=") { expect_true((half >= third).value); };
    minus_half := new fraction(0 - 1, 2);
    test("negative < positive") { expect_true((minus_half < third).value); };

    // ---- other operations
    test("reciprocal") { expect(new fraction(3, 4).reciprocal().numerator).should_be(4); };
    test("reciprocal of a negative keeps the sign on top") { expect(new fraction(0 - 3, 4).reciprocal().numerator).should_be(0 - 4); };
    test("abs") { expect(new fraction(0 - 3, 4).abs().numerator).should_be(3); };
    squared := new fraction(2, 3).pow(2);
    test("(2/3)^2 numerator") { expect(squared.numerator).should_be(4); };
    test("(2/3)^2 denominator") { expect(squared.denominator).should_be(9); };
    inverted := new fraction(2, 3).pow(0 - 2);
    test("(2/3)^-2 numerator") { expect(inverted.numerator).should_be(9); };
    test("(2/3)^-2 denominator") { expect(inverted.denominator).should_be(4); };
    test("anything^0") { expect(new fraction(5, 7).pow(0).numerator).should_be(1); };
    test("sign negative") { expect(new fraction(0 - 1, 2).sign()).should_be(0 - 1); };
    test("sign zero") { expect(fraction.zero().sign()).should_be(0); };
    test("sign positive") { expect(half.sign()).should_be(1); };
    test("is_zero") { expect_true(fraction.zero().is_zero().value); };
    test("is_whole of 1/2") { expect_false(half.is_whole().value); };
    test("to_var") { expect(new fraction(3, 8).to_var()).should_be(0.375); };
    test("floor(7/2)") { expect(new fraction(7, 2).floor()).should_be(3); };
    test("floor(-7/2)") { expect(new fraction(0 - 7, 2).floor()).should_be(0 - 4); };
    test("ceil(7/2)") { expect(new fraction(7, 2).ceil()).should_be(4); };
    test("ceil(-7/2)") { expect(new fraction(0 - 7, 2).ceil()).should_be(0 - 3); };
    test("round(5/2)") { expect(new fraction(5, 2).round()).should_be(3); };
    test("round(-5/2)") { expect(new fraction(0 - 5, 2).round()).should_be(0 - 3); };
    test("round(7/3)") { expect(new fraction(7, 3).round()).should_be(2); };
    test("whole_part(7/4)") { expect(new fraction(7, 4).whole_part()).should_be(1); };
    test("whole_part(-7/4)") { expect(new fraction(0 - 7, 4).whole_part()).should_be(0 - 1); };

    // ---- text
    test("to_string") { expect(new fraction(3, 4).to_string()!!).should_be("3/4"); };
    test("to_string negative") { expect(new fraction(3, 0 - 4).to_string()!!).should_be("-3/4"); };
    test("to_string whole") { expect(new fraction(10, 2).to_string()!!).should_be("5"); };
    test("to_mixed_string") { expect(new fraction(7, 4).to_mixed_string()).should_be("1 3/4"); };
    test("to_mixed_string negative") { expect(new fraction(0 - 7, 4).to_mixed_string()).should_be("-1 3/4"); };
    test("to_mixed_string proper") { expect(new fraction(3, 4).to_mixed_string()).should_be("3/4"); };
    test("to_mixed_string whole") { expect(new fraction(8, 4).to_mixed_string()).should_be("2"); };

    p := fraction.parse("3/4");
    test("parse 3/4") { expect(p.numerator * 10 + p.denominator).should_be(34); };
    q := fraction.parse("-6/8");
    test("parse -6/8 numerator") { expect(q.numerator).should_be(0 - 3); };
    test("parse -6/8 denominator") { expect(q.denominator).should_be(4); };
    test("parse whole") { expect(fraction.parse("5").numerator).should_be(5); };
    test("parse +12/-4") { expect(fraction.parse("+12/-4").numerator).should_be(0 - 3); };
    caught = 0;
    try { fraction.parse("abc"); } catch(e: number_format_exception) { caught++; }
    try { fraction.parse("1/"); } catch(e: number_format_exception) { caught++; }
    try { fraction.parse("/2"); } catch(e: number_format_exception) { caught++; }
    try { fraction.parse("1.5/2"); } catch(e: number_format_exception) { caught++; }
    try { fraction.parse("1/0"); } catch(e: division_by_zero_exception) { caught++; }
    test("bad text throws") { expect(caught).should_be(5); };

    d := fraction.from_decimal(0.75, 100);
    test("from_decimal(0.75)") { expect(d.numerator * 10 + d.denominator).should_be(34); };
    pi := fraction.from_decimal(3.14159265358979, 1000);
    test("pi is about 355/113: numerator") { expect(pi.numerator).should_be(355); };
    test("pi is about 355/113: denominator") { expect(pi.denominator).should_be(113); };
    coarse := fraction.from_decimal(3.14159265358979, 10);
    test("pi with denominator <= 10 is 22/7") { expect(coarse.numerator * 10 + coarse.denominator).should_be(227); };
    minus := fraction.from_decimal(0 - 0.125, 1000);
    test("from_decimal(-0.125) numerator") { expect(minus.numerator).should_be(0 - 1); };
    test("from_decimal(-0.125) denominator") { expect(minus.denominator).should_be(8); };
    test("from_decimal of a whole number") { expect(fraction.from_decimal(4, 10).numerator).should_be(4); };
    try {
        fraction.from_decimal(NaN.value, 10);
        test("from_decimal(NaN)") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("from_decimal(NaN) throws") { };
    }
    test("equal fractions have equal hashes") { expect_true((half.hash() == new fraction(2, 4).hash()).value); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_math_numbers") {
        check_complex();
        check_fraction();
    };
    finish_tests("lib_math_numbers");
}
