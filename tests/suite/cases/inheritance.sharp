mod main;

import ( testing )

/**
 * Inheritance: `class dog base animal`, calling the base constructor with
 * `-> base(...)`, inherited fields and methods, `base->` calls, and a chain
 * three classes deep.
 *
 * HOW METHODS BIND (the language's current design)
 *   A class may declare a method its base class already has. That does NOT
 *   replace the base method, it stands in front of it:
 *     - a call binds to the DECLARED type of the variable it is made through,
 *       so a dog held in an `animal` variable runs animal's method;
 *     - a method inherited from the base class keeps calling the base
 *       class's own methods.
 *   `override` is only for methods that come from an interface. Behaviour
 *   that must follow the object (and not the variable) is therefore declared
 *   in an interface and called through the interface type: see the shapes.
 */

class animal {
    name : string = "";
    legs : decimal = 4;
    order : string = "";            // every constructor adds a letter: shows the order they ran in

    animal(name: string) {
        self->name = name;
        order = order + "A";
    }

    def speak(): string {
        return "...";
    }

    def kind(): decimal {
        return 1;
    }

    /* not overridden anywhere: every animal inherits it as it is */
    def leg_count(): decimal {
        return legs;
    }

    /* calls animal's speak(), whatever the classes below declare */
    def describe(): string {
        return name + " says " + speak();
    }

    def kind_times_100(): decimal {
        return kind() * 100;
    }
}

class dog base animal {
    tricks : decimal = 0;

    dog(name: string) -> base(name) {
        order = order + "D";
    }

    /* the same name as in animal: used for calls made through a dog */
    def speak(): string {
        return "woof";
    }

    def kind(): decimal {
        return 2;
    }

    def learn() {
        tricks++;
    }

    /* uses a field and a method that are declared in animal */
    def legs_and_tricks(): decimal {
        return leg_count() * 10 + tricks;
    }
}

/* third level: a puppy is a dog is an animal */
class puppy base dog {
    age_in_weeks : decimal = 8;

    puppy(name: string) -> base(name) {
        order = order + "P";
        tricks = 1;
    }

    def speak(): string {
        return "yip";
    }

    /* base-> runs the version of the class above */
    def kind(): decimal {
        return base->kind() * 10 + 3;
    }

    def speak_like_a_dog(): string {
        return base->speak();
    }
}

class bird base animal {
    bird(name: string) -> base(name) {
        legs = 2;
    }

    def speak(): string {
        return "tweet";
    }

    /* builds on what the base class does */
    def describe(): string {
        return base->describe() + " and flies";
    }
}

/* a class that inherits everything and adds nothing but a constructor */
class cat base animal {
    cat(name: string) -> base(name) {
    }
}

// ---- behaviour that follows the object: declared in an interface, written with `override`
interface has_area {
    def area(): decimal;
}

class shape : has_area {
    sides : decimal = 0;

    shape(sides: decimal) {
        self->sides = sides;
    }

    override def area(): decimal {
        return 0;
    }
}

class rectangle base shape {
    width : decimal = 0;
    height : decimal = 0;

    /* the base constructor gets an argument worked out here */
    rectangle(w: decimal, h: decimal) -> base(4) {
        width = w;
        height = h;
    }

    override def area(): decimal {
        return width * height;
    }

    def perimeter(): decimal {
        return 2 * (width + height);
    }
}

/* two base constructors in a row; area() is inherited from rectangle */
class square base rectangle {
    square(side: decimal) -> base(side, side) {
    }
}

class triangle base shape {
    base_length : decimal = 0;
    height : decimal = 0;

    triangle(b: decimal, h: decimal) -> base(3) {
        base_length = b;
        height = h;
    }

    override def area(): decimal {
        return base_length * height / 2;
    }
}

// ---- a base class with two constructors: the class below picks one
class labelled {
    label : string = "none";
    number : decimal = 0;

    labelled() {
        number = 1;
    }

    labelled(label: string) {
        self->label = label;
        number = 2;
    }
}

class picks_first base labelled {
    picks_first() -> base() {
    }
}

class picks_second base labelled {
    picks_second(text: string) -> base(text) {
    }
}

def speak_for(a: animal): string {
    return a.speak();
}

def area_of(s: has_area): decimal {
    return s.area();
}

def legs_of(a: animal): decimal {
    return a.leg_count();
}

def make_animal(which: decimal): animal {
    if(which == 1) {
        return new dog("made dog");
    }
    if(which == 2) {
        return new bird("made bird");
    }
    return new animal("made animal");
}

def main(args: string[]) {
    // ---- the base class on its own
    a := new animal("generic");
    expect_str("base class: field set by its constructor", a.name, "generic");
    expect_str("base class: its own method", a.speak(), "...");
    expect("base class: kind", a.kind(), 1);
    expect_str("base class: a method calling another", a.describe(), "generic says ...");

    // ---- inherited fields and methods
    d := new dog("rex");
    expect_str("the base constructor ran with the argument passed up", d.name, "rex");
    expect("an inherited field keeps its initial value", d.legs, 4);
    expect("an inherited method", d.leg_count(), 4);
    expect("a field of the class itself", d.tricks, 0);
    d.learn();
    d.learn();
    expect("a method of the class itself", d.tricks, 2);
    expect("a method using inherited members", d.legs_and_tricks(), 42);
    d.legs = 3;
    expect("an inherited field can be written", d.leg_count(), 3);
    c := new cat("tom");
    expect_str("a class that adds nothing: inherited field", c.name, "tom");
    expect_str("a class that adds nothing: inherited method", c.speak(), "...");
    expect_str("a class that adds nothing: inherited method calling another", c.describe(), "tom says ...");
    expect("a class that adds nothing: kind", c.kind(), 1);

    // ---- a method declared again in the class below
    expect_str("called through a dog: the dog's method", d.speak(), "woof");
    expect("called through a dog: the dog's method (number)", d.kind(), 2);
    expect_str("the base class is not changed by it", a.speak(), "...");
    expect_str("an inherited method keeps calling the base class's method", d.describe(), "rex says ...");
    expect("an inherited method keeps calling the base class's method (number)", d.kind_times_100(), 100);
    b := new bird("tweety");
    expect_str("a second class declaring the same method", b.speak(), "tweet");
    expect("a base field changed by the constructor below", b.legs, 2);
    expect("a method that is not declared again gives the base answer", b.kind(), 1);

    // ---- constructors run from the base class down
    expect_str("one constructor", a.order, "A");
    expect_str("base constructor, then the class's own", d.order, "AD");
    p := new puppy("bit");
    expect_str("three constructors, base first", p.order, "ADP");

    // ---- a chain of three
    expect_str("field from two levels up", p.name, "bit");
    expect("field from one level up, set by the lowest constructor", p.tricks, 1);
    expect("field of the lowest class", p.age_in_weeks, 8);
    expect("method from two levels up", p.leg_count(), 4);
    p.learn();
    expect("method from one level up", p.tricks, 2);
    expect("method from one level up using one from two levels up", p.legs_and_tricks(), 42);
    expect_str("called through a puppy: the puppy's method", p.speak(), "yip");
    expect_str("a method from two levels up still calls the top class's method", p.describe(), "bit says ...");
    expect("...also for numbers", p.kind_times_100(), 100);

    // ---- base->
    expect("base->method() inside the method of the same name", p.kind(), 23);
    expect_str("base->method() from another method", p.speak_like_a_dog(), "woof");
    expect_str("a method that builds on the base version", b.describe(), "tweety says ... and flies");

    // ---- through a variable of the base type: the declared type decides
    as_animal : animal = d;
    expect_str("a dog in an animal variable runs animal's method", as_animal.speak(), "...");
    expect("...for numbers too", as_animal.kind(), 1);
    expect_str("...but it has the dog's fields", as_animal.name, "rex");
    expect("...its inherited methods work", as_animal.leg_count(), 3);
    expect("...and it is the same object", as_animal == d, 1);
    as_animal = b;
    expect_str("the variable pointed at a bird: field", as_animal.name, "tweety");
    expect("the variable pointed at a bird: inherited method", as_animal.leg_count(), 2);
    as_animal = p;
    expect_str("the variable pointed at a puppy: field", as_animal.name, "bit");
    expect_str("the variable pointed at a puppy: animal's method", as_animal.speak(), "...");
    as_dog : dog = p;
    expect_str("a puppy in a dog variable runs dog's method", as_dog.speak(), "woof");
    expect("...for numbers too", as_dog.kind(), 2);
    expect("...and shares the puppy's fields", as_dog.tricks, 2);
    as_dog.learn();
    expect("a change made through the dog variable is a change to the puppy", p.tricks, 3);

    // ---- as a parameter and a return value of the base type
    expect_str("pass a dog where an animal is expected", speak_for(d), "...");
    expect("...its fields come along: dog", legs_of(d), 3);
    expect("...its fields come along: bird", legs_of(b), 2);
    expect("...its fields come along: puppy", legs_of(p), 4);
    expect("pass a new object", legs_of(new cat("kit")), 4);
    expect_str("a function returning the base type: dog", make_animal(1).name, "made dog");
    expect_str("a function returning the base type: bird", make_animal(2).name, "made bird");
    expect("...the bird's constructor ran", make_animal(2).legs, 2);
    expect_str("a function returning the base type: animal", make_animal(3).name, "made animal");

    // ---- several classes in one array of the base type
    zoo : animal[] = new animal[4];
    zoo[0] = d;
    zoo[1] = b;
    zoo[2] = p;
    zoo[3] = a;
    expect_str("array element 0", zoo[0].name, "rex");
    expect_str("array element 1", zoo[1].name, "tweety");
    expect_str("array element 2", zoo[2].name, "bit");
    expect_str("array element 3", zoo[3].name, "generic");
    legs : decimal = 0;
    for(i : decimal = 0; i < sizeof(zoo); i++) {
        legs += zoo[i].leg_count();
    }
    expect("sum of leg_count() over the array: 3 + 2 + 4 + 4", legs, 13);

    // ---- shapes: area() comes from an interface, so it can be overridden
    r := new rectangle(3, 4);
    expect("base constructor given a fixed argument", r.sides, 4);
    expect("override using the class's own fields", r.area(), 12);
    expect("the class's own method", r.perimeter(), 14);
    s := new square(5);
    expect("two base constructors in a row: top field", s.sides, 4);
    expect("two base constructors in a row: middle fields", s.width, 5);
    expect("an override inherited from the middle class", s.area(), 25);
    expect("a method inherited from the middle class", s.perimeter(), 20);
    t := new triangle(6, 5);
    expect("another class under the same base", t.area(), 15);
    expect("...with its own base constructor argument", t.sides, 3);
    expect("the base class's own version", new shape(0).area(), 0);

    // ---- called through the interface type, the object's own override runs
    expect("interface parameter: rectangle", area_of(r), 12);
    expect("interface parameter: square", area_of(s), 25);
    expect("interface parameter: triangle", area_of(t), 15);
    expect("interface parameter: the base class", area_of(new shape(0)), 0);
    one_shape : has_area = r;
    expect("interface variable: rectangle", one_shape.area(), 12);
    one_shape = t;
    expect("interface variable: triangle", one_shape.area(), 15);
    shapes : has_area[] = new has_area[3];
    shapes[0] = r;
    shapes[1] = s;
    shapes[2] = t;
    total_area : decimal = 0;
    for(i : decimal = 0; i < 3; i++) {
        total_area += shapes[i].area();
    }
    expect("total area of three different shapes", total_area, 52);

    // ---- choosing between base constructors
    first := new picks_first();
    expect("-> base() runs the constructor without parameters", first.number, 1);
    expect_str("...which leaves the initial value", first.label, "none");
    second := new picks_second("chosen");
    expect("-> base(text) runs the constructor with a string", second.number, 2);
    expect_str("...which stores it", second.label, "chosen");

    // ---- objects of one class stay independent
    d2 := new dog("fido");
    d2.learn();
    expect("another dog has its own fields", d2.tricks, 1);
    expect("...and the first keeps its own", d.tricks, 2);
    expect_str("...and its own inherited fields", d2.name, "fido");
    expect("...including the one changed earlier on the first dog only", d2.legs, 4);

    finish("inheritance");
}
