mod main;

import ( testing )

/**
 * try / finally: the finally block runs exactly once however the try block is
 * left - by reaching its end, by an exception (caught here or in a caller), by
 * return, by break or by continue.
 *
 * Every function below writes one letter per block it goes through into `trail`,
 * so a check like "tfa" reads: try block, finally block, code after.
 *      t = try     c = catch     f = finally     a = after the statement
 */

trail : string = "";

def mark(letter: string) {
    trail = trail + letter;
}

/** gives back the trail collected so far and empties it for the next check */
def take_trail(): string {
    result := "" + trail;                       // a new string: `trail = ""` below changes the string in place
    trail = "";
    return result;
}

// ---- no exception at all
def no_exception() {
    try {
        mark("t");
    } finally {
        mark("f");
    }
    mark("a");
}

def no_exception_with_catch() {
    try {
        mark("t");
    } catch(e: exception) {
        mark("c");
    } finally {
        mark("f");
    }
    mark("a");
}

// ---- exception caught in the same function
def caught_here() {
    try {
        mark("t");
        throw new exception("here");
    } catch(e: exception) {
        mark("c");
    } finally {
        mark("f");
    }
    mark("a");
}

// ---- exception that is NOT caught here: the finally runs, then the caller's catch
def not_caught_here() {
    try {
        mark("t");
        throw new illegal_state_exception("for the caller");
    } finally {
        mark("f");
    }
    mark("a");                                  // skipped: the exception is still on its way
}

/** the catch clause is for another class, so the exception passes through */
def wrong_catch_here() {
    try {
        mark("t");
        throw new illegal_state_exception("for the caller");
    } catch(e: illegal_argument_exception) {
        mark("c");
    } finally {
        mark("f");
    }
    mark("a");
}

/** the exception comes from a function called inside the try block */
def thrower() {
    mark("x");
    throw new illegal_state_exception("from thrower");
}

def calls_thrower() {
    try {
        mark("t");
        thrower();
        mark("n");                              // never
    } finally {
        mark("f");
    }
}

/** two functions with a finally each between the throw and the catch */
def outer_calls_thrower() {
    try {
        mark("T");
        calls_thrower();
    } finally {
        mark("F");
    }
}

// ---- return inside try
def return_in_try(): decimal {
    try {
        mark("t");
        return 10;
    } finally {
        mark("f");
    }
}

/** the returned value is computed BEFORE the finally block runs */
def return_value_is_computed_first(): decimal {
    x : decimal = 1;
    try {
        return x;                               // 1 ...
    } finally {
        x = 50;                                 // ... whatever happens to x afterwards
        mark("f");
    }
}

counter : decimal = 0;

def return_reads_global_first(): decimal {
    try {
        return counter;                         // the value at this moment
    } finally {
        counter += 100;
    }
}

def return_expression_in_try(a: decimal, b: decimal): decimal {
    try {
        return a * b + 1;
    } finally {
        mark("f");
    }
}

class tag {
    number : decimal = 0;

    tag(n: decimal) { number = n; }
}

/** the same for an object: the one that was in the variable at the return is returned */
def return_object_in_try(): tag {
    current := new tag(1);
    try {
        return current;
    } finally {
        current = new tag(2);                   // another object; the first one is already on its way out
        mark("f");
    }
}

/** return or fall through, depending on the argument; the finally runs either way */
def maybe_return(early: decimal): decimal {
    try {
        mark("t");
        if(early == 1) return 1;
        mark("m");
    } finally {
        mark("f");
    }
    mark("a");
    return 2;
}

// ---- return from a catch block that has a finally
def return_in_catch(): decimal {
    try {
        mark("t");
        throw new exception("e");
    } catch(e: exception) {
        mark("c");
        return 7;
    } finally {
        mark("f");
    }
    return 0;
}

// ---- throw from a catch block that has a finally
def throw_in_catch() {
    try {
        mark("t");
        throw new exception("first");
    } catch(e: exception) {
        mark("c");
        throw new illegal_state_exception("second");
    } finally {
        mark("f");
    }
}

// ---- loops
def break_in_try(): decimal {
    count : decimal = 0;
    for(i : decimal = 0; i < 10; i++) {
        try {
            if(i == 3) break;
            mark("t");
        } finally {
            mark("f");
            count++;
        }
    }
    return count;                               // i = 0, 1, 2 and the one that broke out
}

def continue_in_try(): decimal {
    sum : decimal = 0;
    for(i : decimal = 0; i < 5; i++) {
        try {
            if(i % 2 == 1) continue;            // i = 1, 3
            mark("t");
            sum += i;                           // 0 + 2 + 4
        } finally {
            mark("f");
            sum += 100;                         // five times
        }
    }
    return sum;
}

def while_with_break(): decimal {
    i : decimal = 0;
    finals : decimal = 0;
    while(i < 100) {
        try {
            i++;
            if(i == 4) break;
        } finally {
            finals++;
        }
    }
    return i * 10 + finals;                     // i = 4, finals = 4
}

def return_from_loop(): decimal {
    for(i : decimal = 0; i < 10; i++) {
        try {
            mark("t");
            if(i == 2) return i;
        } finally {
            mark("f");
        }
    }
    return 0 - 1;
}

/** a loop around a whole try/catch/finally: every second trip throws */
def loop_around(trips: decimal): decimal {
    total : decimal = 0;
    for(i : decimal = 1; i <= trips; i++) {
        try {
            if(i % 2 == 0) throw new exception("even");
            total += 1;
        } catch(e: exception) {
            total += 10;
        } finally {
            total += 100;
        }
    }
    return total;
}

/** try/finally around a whole loop */
def loop_inside(): decimal {
    sum : decimal = 0;
    try {
        for(i : decimal = 1; i <= 4; i++) {
            sum += i;
        }
        mark("t");
    } finally {
        mark("f");
        sum += 1000;
    }
    return sum;
}

// ---- nested try/finally, two levels
def nested_no_exception() {
    try {
        mark("1");
        try {
            mark("2");
        } finally {
            mark("3");
        }
        mark("4");
    } finally {
        mark("5");
    }
    mark("6");
}

def nested_exception_caught_outside() {
    try {
        try {
            mark("1");
            throw new exception("e");
        } finally {
            mark("2");
        }
        mark("n");                              // never
    } catch(e: exception) {
        mark("3");
    } finally {
        mark("4");
    }
    mark("5");
}

def nested_exception_caught_inside() {
    try {
        try {
            mark("1");
            throw new exception("e");
        } catch(e: exception) {
            mark("2");
        } finally {
            mark("3");
        }
        mark("4");
    } catch(e: exception) {
        mark("n");                              // never: already handled
    } finally {
        mark("5");
    }
    mark("6");
}

def nested_return(): decimal {
    try {
        try {
            mark("1");
            return 5;
        } finally {
            mark("2");
        }
    } finally {
        mark("3");
    }
}

/** both finally blocks run while the exception travels to the caller */
def nested_exception_for_caller() {
    try {
        try {
            mark("1");
            throw new illegal_state_exception("for the caller");
        } finally {
            mark("2");
        }
    } finally {
        mark("3");
    }
    mark("n");                                  // never
}

// ---- a try/finally inside a catch block
def try_inside_catch() {
    try {
        mark("1");
        throw new exception("outer");
    } catch(e: exception) {
        mark("2");
        try {
            mark("3");
        } finally {
            mark("4");
        }
        mark("5");
    } finally {
        mark("6");
    }
}

// ---- two try/finally statements one after the other
def one_after_the_other() {
    try {
        mark("1");
    } finally {
        mark("2");
    }
    try {
        mark("3");
        throw new exception("e");
    } catch(e: exception) {
        mark("4");
    } finally {
        mark("5");
    }
}

/** the finally block can see what the try block did */
def finally_sees_try_work(): decimal {
    x : decimal = 0;
    try {
        x = 5;
    } finally {
        x = x * 2;
    }
    return x;
}

/** ...also when the try block was cut short by an exception */
def finally_sees_partial_work(): decimal {
    x : decimal = 0;
    try {
        x = 5;
        throw new exception("e");
    } catch(e: exception) {
        x += 1;
    } finally {
        x = x * 2;
    }
    return x;
}

/** a finally that itself uses a try/catch (a try/FINALLY in a finally is in known_bugs) */
def catch_inside_finally() {
    try {
        mark("1");
    } finally {
        try {
            mark("2");
            throw new exception("in finally");
        } catch(e: exception) {
            mark("3");
        }
        mark("4");
    }
    mark("5");
}

def main(args: string[]) {
    // ---- no exception
    no_exception();
    expect_str("no exception: try, finally, after", take_trail(), "tfa");
    no_exception_with_catch();
    expect_str("no exception, with a catch clause: the catch is skipped", take_trail(), "tfa");

    // ---- caught in the same function
    caught_here();
    expect_str("caught here: try, catch, finally, after", take_trail(), "tcfa");

    // ---- caught in the caller
    caught : decimal = 0;
    try {
        not_caught_here();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
        expect_str("the exception arrives unchanged", e.get_message(), "for the caller");
    }
    expect("the caller caught it", caught, 1);
    expect_str("finally runs before the caller's catch", take_trail(), "tfC");

    caught = 0;
    try {
        wrong_catch_here();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
    }
    expect("a catch for another class does not stop it", caught, 1);
    expect_str("...but the finally still runs", take_trail(), "tfC");

    caught = 0;
    try {
        calls_thrower();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
        expect_str("message from the function called in the try block", e.get_message(), "from thrower");
    }
    expect("exception from a call inside try", caught, 1);
    expect_str("exception from a call inside try: order", take_trail(), "txfC");

    caught = 0;
    try {
        outer_calls_thrower();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
    }
    expect("exception through two functions", caught, 1);
    expect_str("the inner function's finally runs before the outer one's", take_trail(), "TtxfFC");

    // ---- return inside try
    expect("return in try: the value", return_in_try(), 10);
    expect_str("return in try: finally ran once", take_trail(), "tf");

    expect("return value is fixed before the finally changes the variable", return_value_is_computed_first(), 1);
    expect_str("...and the finally did run", take_trail(), "f");

    counter = 5;
    expect("return of a global reads it before the finally", return_reads_global_first(), 5);
    expect("the finally then changed the global", counter, 105);
    expect("second call sees the changed global", return_reads_global_first(), 105);
    expect("and changes it again", counter, 205);

    expect("return of an expression in try", return_expression_in_try(6, 7), 43);
    expect_str("finally after returning an expression", take_trail(), "f");

    expect("return of an object in try", return_object_in_try().number, 1);
    expect_str("finally after returning an object", take_trail(), "f");

    expect("early return", maybe_return(1), 1);
    expect_str("early return: finally runs, the rest does not", take_trail(), "tf");
    expect("no early return", maybe_return(0), 2);
    expect_str("no early return: everything runs", take_trail(), "tmfa");

    // ---- return from a catch with a finally
    expect("return in catch: the value", return_in_catch(), 7);
    expect_str("return in catch: finally runs after the catch", take_trail(), "tcf");

    // ---- throw from a catch with a finally
    caught = 0;
    try {
        throw_in_catch();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
        expect_str("the exception thrown by the catch block arrives", e.get_message(), "second");
    }
    expect("throw in catch reaches the caller", caught, 1);
    expect_str("throw in catch: finally runs before the caller's catch", take_trail(), "tcfC");

    // ---- break and continue
    expect("break in try: finally ran on all four trips", break_in_try(), 4);
    expect_str("break in try: order", take_trail(), "tftftff");

    expect("continue in try: 0 + 2 + 4 + 5 * 100", continue_in_try(), 506);
    expect_str("continue in try: order", take_trail(), "tfftfftf");

    expect("while with break in try", while_with_break(), 44);

    expect("return from a loop inside try", return_from_loop(), 2);
    expect_str("return from a loop: three trips, three finally", take_trail(), "tftftf");

    // ---- loop around try/catch/finally
    expect("loop around, 1 trip", loop_around(1), 101);
    expect("loop around, 2 trips", loop_around(2), 211);
    expect("loop around, 10 trips: 5 * 1 + 5 * 10 + 10 * 100", loop_around(10), 1055);
    expect("loop around, 1000 trips", loop_around(1000), 105500);

    // ---- loop inside try/finally
    expect("loop inside try: 10 + 1000", loop_inside(), 1010);
    expect_str("loop inside try: finally once", take_trail(), "tf");

    // ---- nested, two levels
    nested_no_exception();
    expect_str("nested, no exception: inner finally, then outer", take_trail(), "123456");

    nested_exception_caught_outside();
    expect_str("nested, caught by the outer try: inner finally first", take_trail(), "12345");

    nested_exception_caught_inside();
    expect_str("nested, caught by the inner try: the outer catch is skipped", take_trail(), "123456");

    expect("nested return: the value", nested_return(), 5);
    expect_str("nested return: both finally blocks, inner first", take_trail(), "123");

    caught = 0;
    try {
        nested_exception_for_caller();
    } catch(e: illegal_state_exception) {
        mark("C");
        caught = 1;
    }
    expect("nested, exception for the caller", caught, 1);
    expect_str("nested, exception for the caller: both finally blocks, once each", take_trail(), "123C");

    // ---- other shapes
    try_inside_catch();
    expect_str("try/finally inside a catch block", take_trail(), "123456");

    one_after_the_other();
    expect_str("two statements one after the other", take_trail(), "12345");

    expect("finally sees what try did: 5 * 2", finally_sees_try_work(), 10);
    expect("finally after catch: (5 + 1) * 2", finally_sees_partial_work(), 12);

    catch_inside_finally();
    expect_str("try/catch inside a finally block", take_trail(), "12345");

    // ---- the same function many times: nothing is left behind by a finally
    total : decimal = 0;
    for(i : decimal = 0; i < 500; i++) {
        total += return_in_try();               // 10 each
        total += return_in_catch();             // 7 each
    }
    expect("500 calls of two functions with finally", total, 8500);
    trail = "";

    // ---- finally directly in main, with an exception from three shapes in a row
    order : decimal = 0;
    try {
        order = order * 10 + 1;
        try {
            order = order * 10 + 2;
            throw new exception("e");
        } finally {
            order = order * 10 + 3;
        }
    } catch(e: exception) {
        order = order * 10 + 4;
    } finally {
        order = order * 10 + 5;
    }
    expect("order written as digits", order, 12345);

    finish("finally");
}
