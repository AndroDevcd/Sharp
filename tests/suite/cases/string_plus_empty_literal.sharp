mod main;

import ( testing )

/**
 * Known bug found while writing cases/recursion.sharp. This file is
 * EXPECTED to fail.
 *
 * string + "" appends the text "null".
 *   An empty string literal on the right of + is treated as a null array:
 *       t : string = "abc";
 *       t + ""              gives "abcnull", expected "abc"
 *   An empty string that comes out of a function (`return "";`) is added
 *   correctly; only the literal written directly after + goes wrong.
 *   Same result in all four configurations ({no -O, -O} x {JIT, -nojit}).
 */

def empty_literal(): string { return ""; }

def main(args: string[]) {
    t : string = "abc";
    expect_str("string + function returning an empty literal", t + empty_literal(), "abc");     // passes
    expect_str("string + empty literal", t + "", "abc");                                        // "abcnull"

    finish("recursion");
}
