mod main;

import (
    std.testing,
    std.io.coroutines,
    std.io.coroutines.sync,
    std.io
)

/**
 * std.io.coroutines.sync (mutex, semaphore) and std.io.atomic_counter.
 *
 * Asserted are only things that hold for every schedule: totals after a join,
 * that a counter protected by a mutex loses no update, that never more
 * coroutines are inside a semaphore than it has permits, the order in which
 * waiters on ONE thread are served.
 *
 * Coroutine blocks cannot see locals of the function that created them (the
 * closure rule), so the shared objects are globals.
 */

class plain {
    value : decimal = 0;
    peak : decimal = 0;
    inside : decimal = 0;
    order : string = "";
}

guard := new mutex();
gate := new semaphore(3);
signal := new semaphore(0);
shared := new plain();
tracker := new plain();
tracker_lock := new mutex();
never_reached := new atomic_counter();
finished := new atomic_counter();

/** read, give others a turn, write back: loses updates unless the mutex really excludes */
def slow_increment() {
    guard.acquire();
    seen : decimal = shared.value;
    yield();
    shared.value = seen + 1;
    guard.release();
}

/**
 * The same with a sleep instead of a yield, for the worker threads.
 * (A coroutine that yields on the pool and continues on another thread crashes
 * the JIT now and then, see known_bugs/lib_coroutines_jit_fiber_frames.sharp;
 * a sleep goes through the timer and does not.)
 */
def sleepy_increment() {
    guard.acquire();
    seen : decimal = shared.value;
    delay(1);
    shared.value = seen + 1;
    guard.release();
}

def quick_increment() {
    guard.with_lock({ -> shared.value = shared.value + 1; });
}

def through_the_gate() {
    gate.acquire();

    tracker_lock.acquire();
    tracker.inside = tracker.inside + 1;
    if(tracker.inside > tracker.peak) { tracker.peak = tracker.inside; }
    tracker_lock.release();

    delay(1);

    tracker_lock.acquire();
    tracker.inside = tracker.inside - 1;
    tracker_lock.release();

    gate.release();
    finished.increment();
}

def queue_up(tag: string) {
    guard.acquire();
    shared.order = shared.order + tag;
    guard.release();
}

/**
 * One thread only, before any worker thread exists: see
 * lib_coroutines_core.sharp warm_up(). It checks nothing itself.
 */
def warm_up() {
    run_blocking({ ->
        for(i : decimal = 0; i < 30; i++) {
            w := async<int>.start({ -> (int) delay(1); return 10; });
            w.await();
            k := launch({ -> yield(); delay(1); });
            k.join();
            c := launch({ -> delay(1000000); });
            yield();
            c.cancel_and_join();
            coroutine_scope({ -> launch({ -> yield(); }); });
        }
    });

    m := new mutex();
    s := new semaphore(1);
    for(i : decimal = 0; i < 30; i++) {
        m.acquire();
        m.release();
        m.try_acquire();
        m.release();
        s.acquire();
        s.release();
        s.try_acquire();
        s.release();
    }
}

def test_atomic_counter() {
    c := new atomic_counter();
    test("starts at 0") { expect(c.read()).should_be(0); };
    test("increment returns the new value") { expect(c.increment()).should_be(1); };
    test("add returns the new value") { expect(c.add(9)).should_be(10); };
    test("decrement") { expect(c.decrement()).should_be(9); };
    test("fetch_add returns the old value") { expect(c.fetch_add(5)).should_be(9); };
    test("...and adds") { expect(c.read()).should_be(14); };
    test("exchange returns the old value") { expect(c.exchange(3)).should_be(14); };
    test("compare_and_set with the right value") { expect_true(c.compare_and_set(3, 30).value); };
    test("compare_and_set with the wrong value") { expect_false(c.compare_and_set(3, 99).value); };
    test("compare_and_set result") { expect(c.read()).should_be(30); };
    test("raise_to a bigger value") { expect(c.raise_to(40)).should_be(40); };
    test("raise_to a smaller value changes nothing") { expect(c.raise_to(7)).should_be(40); };
    c.write(5);
    test("write") { expect(c.read()).should_be(5); };
    test("to_string") { expect(c.to_string()!!).should_be("5"); };
    d := new atomic_counter(100);
    test("initial value") { expect(d.read()).should_be(100); };

    never_reached.write(0);
    coroutine_scope({ ->
        for(i : decimal = 0; i < 10000; i++) {
            launch_on(dispatchers.default_pool(), { -> never_reached.increment(); });
        }
    });
    test("10,000 coroutines on the pool each incremented once") { expect(never_reached.read()).should_be(10000); };
    never_reached.write(0);
}

def test_mutex_basics() {
    m := new mutex();
    test("new mutex is free") { expect_false(m.is_locked().value); };
    test("nobody holds it") { expect_false(m.holds_lock().value); };
    m.acquire();
    test("locked after acquire") { expect_true(m.is_locked().value); };
    test("held by this fiber") { expect_true(m.holds_lock().value); };
    test("try_acquire on a held mutex") { expect_false(m.try_acquire().value); };
    m.release();
    test("free after release") { expect_false(m.is_locked().value); };
    test("try_acquire on a free mutex") { expect_true(m.try_acquire().value); };
    m.release();

    try {
        m.release();
        test("release of a free mutex") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("release of a free mutex throws") { };
    }

    captured := new plain();
    m.with_lock({ -> captured.value = 5; if(m.is_locked()) { captured.peak = 1; } });
    test("with_lock ran the block") { expect(captured.value).should_be(5); };
    test("with_lock held the mutex meanwhile") { expect(captured.peak).should_be(1); };
    test("with_lock released") { expect_false(m.is_locked().value); };

    try {
        m.with_lock({ -> throw new illegal_state_exception("inside"); });
        test("with_lock whose block throws") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("with_lock passed the exception on") { expect(e.get_message()).should_be("inside"); };
    }
    test("with_lock released after an exception") { expect_false(m.is_locked().value); };

    other := new mutex();
    refused := new plain();
    m.with_lock({ ->
        try {
            other.with_lock({ -> never_reached.increment(); });
        } catch(e: illegal_state_exception) {
            refused.value = 1;
        }
        // the way to hold two: acquire / release
        other.acquire();
        refused.peak = 1;
        other.release();
    });
    test("with_lock inside with_lock is refused") { expect(refused.value).should_be(1); };
    test("acquire inside with_lock works") { expect(refused.peak).should_be(1); };
    test("outer mutex released after the refusal") { expect_false(m.is_locked().value); };
}

def test_mutex_exclusion() {
    // held across a suspension point, on one thread
    shared.value = 0;
    run_blocking({ ->
        for(i : decimal = 0; i < 500; i++) {
            launch({ -> slow_increment(); });
        }
    });
    test("500 read-yield-write increments under a mutex (one thread)") { expect(shared.value).should_be(500); };

    // the same on the worker threads
    shared.value = 0;
    coroutine_scope({ ->
        for(i : decimal = 0; i < 300; i++) {
            launch_on(dispatchers.default_pool(), { -> sleepy_increment(); });
        }
    });
    test("300 read-sleep-write increments under a mutex (pool)") { expect(shared.value).should_be(300); };

    // 10,000 coroutines, with_lock, an unsynchronised counter
    shared.value = 0;
    coroutine_scope({ ->
        for(i : decimal = 0; i < 10000; i++) {
            launch_on(dispatchers.default_pool(), { -> quick_increment(); });
        }
    });
    test("10,000 coroutines each added 1 under with_lock") { expect(shared.value).should_be(10000); };
    test("mutex free at the end") { expect_false(guard.is_locked().value); };
    test("nobody waiting at the end") { expect(guard.waiting_count()).should_be(0); };

    // first come first served: on one thread the order of arrival is the order of launching
    shared.order = "";
    run_blocking({ ->
        guard.acquire();
        launch({ -> queue_up("a"); });
        launch({ -> queue_up("b"); });
        launch({ -> queue_up("c"); });
        launch({ -> queue_up("d"); });
        yield();
        yield();
        test("four coroutines are waiting") { expect(guard.waiting_count()).should_be(4); };
        guard.release();
    });
    test("waiters got the mutex in the order they arrived") { expect(shared.order).should_be("abcd"); };
}

def test_mutex_cancellation() {
    never_reached.write(0);
    guard.acquire();
    waiting := launch({ -> guard.acquire(); never_reached.increment(); guard.release(); });
    delay(5);
    test("one coroutine waits for the mutex") { expect(guard.waiting_count()).should_be(1); };
    waiting.cancel_and_join();
    test("the waiting coroutine was cancelled") { expect_true(waiting.is_cancelled().value); };
    test("it left the queue") { expect(guard.waiting_count()).should_be(0); };
    guard.release();
    test("the mutex was not handed to the cancelled waiter") { expect_false(guard.is_locked().value); };
    test("the cancelled waiter never got the mutex") { expect(never_reached.read()).should_be(0); };

    // a time limit on acquire
    guard.acquire();
    r := with_timeout_or_null(20, { -> (object) guard.acquire(); return guard; });
    test("acquire under a time limit") { expect_null(r); };
    test("no stale waiter left") { expect(guard.waiting_count()).should_be(0); };
    guard.release();
    test("still usable") { expect_true(guard.try_acquire().value); };
    guard.release();
}

def test_semaphore() {
    s := new semaphore(2);
    test("available permits") { expect(s.available_permits()).should_be(2); };
    test("try_acquire 1") { expect_true(s.try_acquire().value); };
    s.acquire();
    test("no permits left") { expect(s.available_permits()).should_be(0); };
    test("try_acquire without permits") { expect_false(s.try_acquire().value); };
    test("acquire_for times out without permits") { expect_false(s.acquire_for(15).value); };
    test("the timed out waiter left the queue") { expect(s.waiting_count()).should_be(0); };
    s.release();
    test("acquire_for with a permit") { expect_true(s.acquire_for(15).value); };
    s.release();
    s.release();
    test("all permits back") { expect(s.available_permits()).should_be(2); };

    try {
        bad := new semaphore(0 - 1);
        test("negative permits") { fail_test("accepted"); };
    } catch(e: illegal_argument_exception) {
        test("negative permits refused") { };
    }

    captured := new plain();
    s.with_permit({ -> captured.value = s.available_permits(); });
    test("with_permit held one permit") { expect(captured.value).should_be(1); };
    test("with_permit gave it back") { expect(s.available_permits()).should_be(2); };
    try {
        s.with_permit({ -> throw new illegal_state_exception("inside"); });
        test("with_permit whose block throws") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("with_permit passed the exception on") { };
    }
    test("with_permit gave the permit back after an exception") { expect(s.available_permits()).should_be(2); };

    // never more inside than permits
    tracker.inside = 0;
    tracker.peak = 0;
    finished.write(0);
    coroutine_scope({ ->
        for(i : decimal = 0; i < 600; i++) {
            launch_on(dispatchers.default_pool(), { -> through_the_gate(); });
        }
    });
    test("600 coroutines went through the gate") { expect(finished.read()).should_be(600); };
    test("never more than 3 inside a semaphore of 3") { expect_true(tracker.peak <= 3); };
    test("at least one was inside") { expect_true(tracker.peak >= 1); };
    test("nobody inside at the end") { expect(tracker.inside).should_be(0); };
    test("all permits returned") { expect(gate.available_permits()).should_be(3); };

    // zero permits: a signal
    finished.write(0);
    run_blocking({ ->
        launch({ -> signal.acquire(); finished.increment(); });
        launch({ -> signal.acquire(); finished.increment(); });
        yield();
        yield();
        test("two coroutines wait for the signal") { expect(signal.waiting_count()).should_be(2); };
        test("nothing happened yet") { expect(finished.read()).should_be(0); };
        signal.release();
        signal.release();
    });
    test("both were woken by release") { expect(finished.read()).should_be(2); };
    test("a release that woke a waiter adds no permit") { expect(signal.available_permits()).should_be(0); };

    // cancelling a waiter
    never_reached.write(0);
    waiting := launch({ -> signal.acquire(); never_reached.increment(); });
    delay(5);
    waiting.cancel_and_join();
    test("a coroutine waiting for a permit was cancelled") { expect_true(waiting.is_cancelled().value); };
    test("it left the queue") { expect(signal.waiting_count()).should_be(0); };
    signal.release();
    test("the permit was not given to the cancelled waiter") { expect(signal.available_permits()).should_be(1); };
    test("the cancelled waiter never continued") { expect(never_reached.read()).should_be(0); };
    signal.acquire();
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_coroutines_sync") {
        warm_up();

        test_atomic_counter();
        test_mutex_basics();
        test_mutex_exclusion();
        test_mutex_cancellation();
        test_semaphore();
    };
    finish_tests("lib_coroutines_sync");
}
