mod main;

import ( testing )

/**
 * `object[index] = value` stores the value, as in every other language.
 *
 *      names := new list<string>();
 *      names[0] = other;           // the element at 0 IS `other` afterwards
 *
 * An object is indexed through its `operator[]` function, which only reads.
 * An assignment through it is compiled as a call of the class's
 * `put(index, value)` function (list has one):
 *
 *      names.put(0, other);
 *
 * A class with `operator[]` and no fitting `put` keeps the old meaning: `=`
 * is applied to the object `operator[]` returned.
 *
 * (Decided 2026-11-12. Before, a variable or a call result on the right
 *  stopped the compiler with "attempting to assign stack data!", and a
 *  literal was written INTO the object the list held.)
 */

class holder { def text() : string { return "b"; } }

def main(args: string[]) {
    names := new list<string>();
    names.add("a");

    s : string = "c";
    names[0] = s;
    expect_str("a variable assigned through list[i]", names.at(0), "c");

    h := new holder();
    names[0] = h.text();
    expect_str("a call result assigned through list[i]", names.at(0), "b");

    // the object that was in the list is not touched: the list got another one
    first := new string("first");
    words := new list<string>();
    words.add(first);
    words[0] = "second";
    expect_str("the list holds the new value", words.at(0), "second");
    expect_str("the old object is unchanged", first, "first");

    finish("list_index_assignment");
}
