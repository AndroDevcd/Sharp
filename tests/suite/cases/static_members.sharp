mod main;

import ( testing )

/**
 * Static members and globals: a static field exists once for the class (not
 * once per object), a static method is called on the class and has no `self`,
 * and a variable or function written outside every class is global to the
 * module.
 */

/* every ticket takes the next number from the one counter the class has */
class ticket {
    static next_number : var = 1;
    static issued : var = 0;

    number : var = 0;

    ticket() {
        number = next_number;
        next_number++;
        issued++;
    }

    static def start_again() {
        next_number = 1;
        issued = 0;
    }

    static def upcoming(): var {
        return next_number;
    }

    /* an ordinary method reading a static field */
    def is_newest(): var {
        return number == next_number - 1;
    }

    /* an ordinary method writing a static field */
    def skip_ahead(by: var) {
        next_number += by;
    }
}

/* a class used only as a place to keep functions */
class calc {
    static def square(x: var): var {
        return x * x;
    }

    static def largest(a: var, b: var): var {
        if(a > b) {
            return a;
        }
        return b;
    }

    static def total(numbers: var[]): var {
        sum : var = 0;
        for(i : var = 0; i < sizeof(numbers); i++) {
            sum += numbers[i];
        }
        return sum;
    }

    /* a static method calling other static methods of its class */
    static def largest_square(a: var, b: var): var {
        return largest(square(a), square(b));
    }

    /* overloads */
    static def describe(a: var): var { return 1; }
    static def describe(a: var, b: var): var { return 2; }
    static def describe(s: string): var { return 3; }

    /* recursion */
    static def factorial(n: var): var {
        if(n <= 1) {
            return 1;
        }
        return n * factorial(n - 1);
    }
}

/* static fields of several types, each with an initial value */
class settings {
    static level : var = 3;
    static ratio : var = 0.75;
    static negative : var = 0 - 40;
    static from_expression : var = 6 * 7;
    static title : string = "untitled";
    static sizes : var[] = new var[] { 10, 20, 30 };
    static not_set : var;
    static no_object : settings?;
}

class point {
    x : var = 0;
    y : var = 0;

    /* static fields holding objects of the class itself */
    static made : var = 0;
    static last_made : point?;

    point(px: var, py: var) {
        x = px;
        y = py;
        made++;
        last_made = self;
    }

    /* static methods that build objects */
    static def origin(): point {
        return new point(0, 0);
    }

    static def diagonal(n: var): point {
        return new point(n, n);
    }

    /* a static method working on objects it is given */
    static def distance_squared(a: point, b: point): var {
        dx : var = a.x - b.x;
        dy : var = a.y - b.y;
        return dx * dx + dy * dy;
    }
}

/* one shared object, made the first time it is asked for */
class shared_log {
    static instance : shared_log?;
    static times_created : var = 0;

    lines : var = 0;

    shared_log() {
        times_created++;
    }

    static def the_one(): shared_log {
        if(instance == null) {
            instance = new shared_log();
        }
        return instance!!;
    }
}

/* two classes with a static field of the same name do not share it */
class left_side {
    static count : var = 100;
    static def bump(): var {
        count++;
        return count;
    }
}

class right_side {
    static count : var = 200;
    static def bump(): var {
        count += 10;
        return count;
    }
}

// ---- globals: variables and functions outside every class
global_number : var = 5;
global_fraction : var = 1.5;
global_from_expression : var = 3 * 4 + 1;
global_text : string = "global";
global_numbers : var[] = new var[] { 7, 8, 9 };
global_object : point = new point(11, 22);
global_not_set : var;
global_nothing : point?;
global_boxed := 9;                  // an int object, like a local declared with :=

def add_to_global(amount: var) {
    global_number += amount;
}

def read_global(): var {
    return global_number;
}

def append_to_global_text(more: string) {
    global_text = global_text + more;
}

def set_global_number_at(index: var, value: var) {
    global_numbers[index] = value;
}

def next_id(): var {
    id_counter++;
    return id_counter;
}

id_counter : var = 1000;            // declared after the function that uses it

def main(args: string[]) {
    // ---- static fields have their initial value before any object exists
    expect("static number", settings.level, 3);
    expect("static fraction", settings.ratio, 0.75);
    expect("static negative number", settings.negative, 0 - 40);
    expect("static set from an expression", settings.from_expression, 42);
    expect_str("static string", settings.title, "untitled");
    expect("static array: its length", sizeof(settings.sizes), 3);
    expect("static array: an element", settings.sizes[1], 20);
    expect("static without a value starts at 0", settings.not_set, 0);
    expect_null("static object without a value starts as null", settings.no_object);

    // ---- static fields can be written through the class name
    settings.level = 9;
    settings.ratio += 0.25;
    settings.title = "named";
    settings.sizes[1] = 25;
    settings.not_set++;
    expect("write a static number", settings.level, 9);
    expect("+= on a static", settings.ratio, 1);
    expect_str("write a static string", settings.title, "named");
    expect("write an element of a static array", settings.sizes[1], 25);
    expect("...the other elements stay", settings.sizes[2], 30);
    expect("++ on a static", settings.not_set, 1);
    settings.no_object = new settings();
    expect_not_null("write a static object", settings.no_object);

    // ---- static methods
    expect("a static method", calc.square(9), 81);
    expect("a static method with two parameters", calc.largest(3, 8), 8);
    expect("...the other way round", calc.largest(8, 3), 8);
    expect("a static method taking an array", calc.total(new var[] { 1, 2, 3, 4, 5 }), 15);
    expect("a static method calling static methods", calc.largest_square(0 - 5, 4), 25);
    one : var = 1;
    expect("static overload with one number", calc.describe(one), 1);
    expect("static overload with two numbers", calc.describe(one, one), 2);
    expect("static overload with a string", calc.describe("text"), 3);
    expect("a recursive static method", calc.factorial(6), 720);
    expect("static calls inside an expression", calc.square(3) + calc.square(4), 25);
    expect("a static call as an argument of another", calc.square(calc.largest(2, 3)), 9);

    // ---- one static field shared by every object
    expect("before any ticket", ticket.issued, 0);
    expect("the first number waiting", ticket.upcoming(), 1);
    t1 := new ticket();
    t2 := new ticket();
    t3 := new ticket();
    expect("first ticket", t1.number, 1);
    expect("second ticket", t2.number, 2);
    expect("third ticket", t3.number, 3);
    expect("the class counted all three", ticket.issued, 3);
    expect("the next number", ticket.next_number, 4);
    expect("a method comparing its field with the static: newest", t3.is_newest(), 1);
    expect("a method comparing its field with the static: older", t1.is_newest(), 0);
    t1.skip_ahead(10);
    expect("an object changed the static field", ticket.upcoming(), 14);
    t4 := new ticket();
    expect("...and the next object sees it", t4.number, 14);
    expect("...while existing objects keep their own fields", t2.number, 2);
    ticket.start_again();
    expect("a static method reset the static fields: issued", ticket.issued, 0);
    expect("a static method reset the static fields: next", ticket.next_number, 1);
    t5 := new ticket();
    expect("numbering starts again", t5.number, 1);
    expect("...old objects are untouched", t4.number, 14);
    ticket.next_number = 500;
    expect("a static written from outside is used by the next object", new ticket().number, 500);

    // ---- statics and objects of the same class
    expect("one point exists already: the global made before main started", point.made, 1);
    o := point.origin();
    expect("a static method that builds an object: x", o.x, 0);
    expect("...it counted itself", point.made, 2);
    g := point.diagonal(7);
    expect("a static method with a parameter that builds an object", g.x + g.y, 14);
    expect("a static field holding the newest object", point.last_made == g, 1);
    expect("...and not the one before", point.last_made == o, 0);
    expect("a static method taking two objects", point.distance_squared(o, new point(3, 4)), 25);
    expect("...which made one more", point.made, 4);

    // ---- one shared object
    expect("nothing made before it is asked for", shared_log.times_created, 0);
    log_a := shared_log.the_one();
    log_b := shared_log.the_one();
    expect("asked twice, made once", shared_log.times_created, 1);
    expect("both variables are the same object", log_a == log_b, 1);
    log_a.lines = 12;
    expect("a change through one is seen through the other", log_b.lines, 12);
    expect("...and through the class", shared_log.the_one().lines, 12);

    // ---- static fields with the same name in two classes
    expect("left starts at its own value", left_side.count, 100);
    expect("right starts at its own value", right_side.count, 200);
    expect("left bump", left_side.bump(), 101);
    expect("right bump", right_side.bump(), 210);
    expect("left bump again", left_side.bump(), 102);
    expect("right is not changed by left", right_side.count, 210);

    // ---- globals
    expect("global number", global_number, 5);
    expect("global fraction", global_fraction, 1.5);
    expect("global set from an expression", global_from_expression, 13);
    expect_str("global string", global_text, "global");
    expect("global array", global_numbers[2], 9);
    expect("global object", global_object.x + global_object.y, 33);
    expect("global without a value starts at 0", global_not_set, 0);
    expect_null("global object without a value starts as null", global_nothing);
    expect("global declared with := is an int object", global_boxed.value, 9);

    // ---- globals written here and in functions
    global_number = 6;
    expect("write a global", global_number, 6);
    add_to_global(10);
    expect("a function changed the global", global_number, 16);
    expect("a function reading the global", read_global(), 16);
    global_number++;
    expect("++ on a global", read_global(), 17);
    append_to_global_text(" text");
    expect_str("a function changed the global string", global_text, "global text");
    set_global_number_at(0, 70);
    expect("a function changed the global array", global_numbers[0], 70);
    expect("...the other elements stay", global_numbers[1], 8);
    global_object.x = 1;
    expect("a field of a global object", global_object.x, 1);
    global_nothing = global_object;
    expect("a global pointed at an object", global_nothing == global_object, 1);
    expect("a global declared below the function using it: first call", next_id(), 1001);
    expect("...second call", next_id(), 1002);
    expect("...the global itself", id_counter, 1002);

    // ---- a local variable does not disturb a global of another name
    local_number : var = global_number * 2;
    local_number++;
    expect("a local computed from a global", local_number, 35);
    expect("...the global is unchanged", global_number, 17);

    finish("static_members");
}
