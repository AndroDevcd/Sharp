mod main;

import ( testing )

/**
 * Does not COMPILE today: a method call on a `new` expression inside a
 * condition stops the code generator with
 * "fatal error: attempting to consume empty machine data!" (or
 * "incorrect operation_step").
 * Workaround used in the I/O library: put the object in a local variable
 * first.
 */

class probe_box {
    def is_ok(): bool { return true; }
}

def main(args: string[]) {
    if(!new probe_box().is_ok()) {
        fail("new in condition", "wrong branch");
    } else {
        pass("new in condition");
    }
    finish("lib_io_new_in_condition");
}
