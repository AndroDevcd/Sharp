mod main;

import ( std.testing, std.io )

/**
 * std.io readers and writers: string_text_reader, file_reader,
 * buffered_reader (all text_reader) and string_writer, file_writer,
 * buffered_writer, console_writer (all text_writer).
 *
 * Works only inside /tmp/sharp_suite_io_streams and removes it at the end.
 */

base_dir : string = "/tmp/sharp_suite_io_streams";

/** counts the characters of a reader through the interface only */
def count_chars(input: text_reader): decimal {
    count : decimal = 0;
    while(input.read_char() >= 0) {
        count++;
    }
    return count;
}

/** writes the same report to any writer */
def write_report(out: text_writer) {
    out.write("total");
    out.write_char(':');
    out.write_line(" 42");
    out.write_line("");
    out.write("end");
    out.flush();
}

def test_string_reader() {
    r := new string_text_reader("ab\ncd\r\nef\rgh");
    test("length") { expect(r.length()).should_be(12); };
    test("position at start") { expect(r.position()).should_be(0); };
    test("line at start") { expect(r.line()).should_be(1); };
    test("column at start") { expect(r.column()).should_be(1); };
    test("has_more") { expect_true(r.has_more()); };
    test("peek_char") { expect(r.peek_char()).should_be('a'); };
    test("peek does not consume") { expect(r.read_char()).should_be('a'); };
    test("peek_char_at") { expect(r.peek_char_at(1)).should_be('\n'); };
    test("peek_char_at past end") { expect(r.peek_char_at(100)).should_be(0 - 1); };
    test("column after one char") { expect(r.column()).should_be(2); };
    test("read_line rest of line") { expect(r.read_line()!!).should_be("b"); };
    test("line 2") { expect(r.line()).should_be(2); };
    test("read_line lf") { expect(r.read_line()!!).should_be("cd"); };
    test("line 3 after crlf") { expect(r.line()).should_be(3); };
    test("read_line cr") { expect(r.read_line()!!).should_be("ef"); };
    test("line 4 after cr") { expect(r.line()).should_be(4); };
    test("remaining") { expect(r.remaining()).should_be(2); };
    test("last line without end") { expect(r.read_line()!!).should_be("gh"); };
    test("read_line at end is null") { expect_true(io_strings.is_null(r.read_line())); };
    test("read_char at end") { expect(r.read_char()).should_be(0 - 1); };
    test("peek_char at end") { expect(r.peek_char()).should_be(0 - 1); };
    test("has_more at end") { expect_false(r.has_more()); };
    test("read_all at end") { expect(r.read_all()).should_be(""); };

    r.seek(3);
    test("seek then read_all") { expect(r.read_all()).should_be("cd\r\nef\rgh"); };
    r.seek(0);
    test("read(n)") { expect(r.read(2)).should_be("ab"); };
    test("skip") { expect(r.skip(1)).should_be(1); };
    test("read(n) past end is clipped") { expect(r.read(100)).should_be("cd\r\nef\rgh"); };
    test("read(n) at end") { expect(r.read(5)).should_be(""); };
    test("skip at end") { expect(r.skip(5)).should_be(0); };
    test("unread") { expect_true(r.unread()); };
    test("unread gives the char again") { expect(r.read_char()).should_be('h'); };
    r.seek(0);
    test("unread at start") { expect_false(r.unread()); };
    try { r.seek(13); test("seek outside") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("seek outside") { }; }
    try { r.read(0 - 1); test("negative read") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("negative read") { }; }

    lines := new string_text_reader("one\n\nthree\n").read_lines();
    test("read_lines count") { expect(lines.size()).should_be(3); };
    test("read_lines empty line") { expect(lines.at(1)).should_be(""); };
    test("read_lines last") { expect(lines.at(2)).should_be("three"); };

    joined := new char_buffer();
    src1 := new string_text_reader("x\ny\nz");
    foreach(line in src1) {
        joined.append(line).append_char('|');
    }
    test("foreach over lines") { expect(joined.build()).should_be("x|y|z|"); };

    empty := new string_text_reader("");
    test("empty has_more") { expect_false(empty.has_more()); };
    test("empty read_char") { expect(empty.read_char()).should_be(0 - 1); };
    test("empty read_line") { expect_true(io_strings.is_null(empty.read_line())); };
    test("empty read_lines") { expect(empty.read_lines().size()).should_be(0); };

    high := new _int8[2];
    high[0] = 200; high[1] = 255;
    bytes := new string_text_reader(new string(high));
    test("chars are 0..255") { expect(bytes.read_char()).should_be(200); };
    test("char 255 is not the end") { expect(bytes.read_char()).should_be(255); };
    test("then the end") { expect(bytes.read_char()).should_be(0 - 1); };

    test("through the interface") { expect(count_chars(new string_text_reader("12345"))).should_be(5); };

    r.close();
    test("is_closed") { expect_true(r.is_closed()); };
    r.close();
    try { r.read_char(); test("read after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("read after close") { }; }
    try { r.read_line(); test("read_line after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("read_line after close") { }; }
    try { r.has_more(); test("has_more after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("has_more after close") { }; }
}

def test_buffered_reader() {
    r := new buffered_reader(new string_text_reader("  alpha beta\n\tgamma=1;delta\r\nlast"));
    test("line at start") { expect(r.line()).should_be(1); };
    test("read_word skips space") { expect(r.read_word()).should_be("alpha"); };
    test("column after word") { expect(r.column()).should_be(8); };
    test("second word") { expect(r.read_word()).should_be("beta"); };
    test("word on next line") { expect(r.read_until('=')).should_be("\n\tgamma"); };
    test("line 2") { expect(r.line()).should_be(2); };
    test("read_until") { expect(r.read_until(';')).should_be("1"); };
    test("peek_char") { expect(r.peek_char()).should_be('d'); };
    r.unread('X');
    r.unread('Y');
    test("unread: last given back comes first") { expect(r.read_char()).should_be('Y'); };
    test("unread: then the other") { expect(r.read_char()).should_be('X'); };
    test("read_line after unread") { expect(r.read_line()!!).should_be("delta"); };
    test("line 3 after crlf") { expect(r.line()).should_be(3); };
    test("column reset") { expect(r.column()).should_be(1); };
    test("read(n)") { expect(r.read(2)).should_be("la"); };
    test("read_all") { expect(r.read_all()).should_be("st"); };
    test("has_more at end") { expect_false(r.has_more()); };
    test("read_char at end") { expect(r.read_char()).should_be(0 - 1); };
    test("read_line at end") { expect_true(io_strings.is_null(r.read_line())); };
    test("read_word at end") { expect(r.read_word()).should_be(""); };
    test("read_until at end") { expect(r.read_until(',')).should_be(""); };
    test("skip_whitespace returns true") { expect_true(r.skip_whitespace()); };

    lines := new buffered_reader(new string_text_reader("a\n\nb\r\n")).read_lines();
    test("read_lines") { expect(lines.size()).should_be(3); };
    test("read_lines blank") { expect(lines.at(1)).should_be(""); };
    joined := new char_buffer();
    src2 := new buffered_reader(new string_text_reader("p\nq"));
    foreach(line in src2) {
        joined.append(line).append_char('|');
    }
    test("foreach") { expect(joined.build()).should_be("p|q|"); };

    // numbers separated by any white space
    numbers := new buffered_reader(new string_text_reader("1 2\n3\t4   5\n"));
    total : decimal = 0;
    words : decimal = 0;
    while(numbers.skip_whitespace() && numbers.has_more()) {
        total += io_strings.parse_int(numbers.read_word());
        words++;
    }
    test("words read") { expect(words).should_be(5); };
    test("sum of words") { expect(total).should_be(15); };

    // many pushed back characters
    many := new buffered_reader(new string_text_reader(""));
    for(i : decimal = 0; i < 100; i++) {
        many.unread('a' + (i % 26));
    }
    test("first of 100 unread") { expect(many.read_char()).should_be('a' + (99 % 26)); };
    test("the rest") { expect(count_chars(many)).should_be(99); };

    inner := new string_text_reader("x");
    outer := new buffered_reader(inner);
    outer.close();
    outer.close();
    test("close closes the source") { expect_true(inner.is_closed()); };
    try { outer.read_char(); test("read after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("read after close") { }; }
    try { outer.unread('a'); test("unread after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("unread after close") { }; }
}

def test_string_writer() {
    w := new string_writer();
    write_report(w);
    test("through the interface") { expect(w.to_string()!!).should_be("total: 42\n\nend"); };
    test("length") { expect(w.length()).should_be(14); };
    w.new_line();
    w.write_int(0 - 7);
    w.write_char(' ');
    w.write_number(0.5);
    test("numbers") { expect(w.to_string()!!).should_be("total: 42\n\nend\n-7 0.5"); };
    w.clear();
    test("clear") { expect(w.length()).should_be(0); };
    w.write("");
    test("write of nothing") { expect(w.to_string()!!).should_be(""); };
    w.close();
    test("is_closed") { expect_true(w.is_closed()); };
    try { w.write("x"); test("write after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("write after close") { }; }
    try { w.write_line("x"); test("write_line after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("write_line after close") { }; }
    test("text stays after close") { expect(w.to_string()!!).should_be(""); };
    sized := new string_writer(4);
    sized.write("longer than four");
    test("sized writer grows") { expect(sized.length()).should_be(16); };
}

def test_file_streams() {
    target := new file(base_dir + "/out.txt");
    w := new file_writer(target);
    write_report(w);
    test("flush wrote the file") { expect(target.read_text()).should_be("total: 42\n\nend"); };
    w.new_line();
    w.write_int(12);
    w.write_number(1.5);
    test("not on disk before the next flush") { expect(target.read_text()).should_be("total: 42\n\nend"); };
    test("length counts everything") { expect(w.length()).should_be(20); };
    w.close();
    test("is_closed") { expect_true(w.is_closed()); };
    test("close wrote the rest") { expect(target.read_text()).should_be("total: 42\n\nend\n121.5"); };
    w.close();
    try { w.write("x"); test("write after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("write after close") { }; }
    try { w.flush(); test("flush after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("flush after close") { }; }
    test("get_file") { expect(w.get_file().name()).should_be("out.txt"); };

    // append keeps what is there, replace does not
    a := new file_writer(target, true);
    a.write_line("");
    a.write("appended");
    a.close();
    test("append mode") { expect(target.read_text()).should_be("total: 42\n\nend\n121.5\nappended"); };
    r := new file_writer(target, false);
    r.close();
    test("replace mode with nothing written empties the file") { expect(target.size()).should_be(0); };
    fresh := new file_writer(new file(base_dir + "/fresh.txt"), true);
    fresh.write("new");
    fresh.close();
    test("append to a missing file creates it") { expect(new file(base_dir + "/fresh.txt").read_text()).should_be("new"); };
    by_path := new file_writer(new file(base_dir + "/by_path.txt"));
    by_path.write_line("p");
    by_path.close();
    test("writer by path") { expect(new file(base_dir + "/by_path.txt").read_text()).should_be("p\n"); };

    try { new file_writer(new file(base_dir)); test("writer on a directory") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("writer on a directory") { }; }
    nowhere := new file_writer(new file(base_dir + "/no/such/dir/x.txt"));
    nowhere.write("x");
    try { nowhere.flush(); test("flush without directory") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("flush without directory") { }; }
    try { nowhere.close(); test("close without directory") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("close without directory") { }; }
    test("closed all the same") { expect_true(nowhere.is_closed()); };

    // file_reader
    target.write_text("first\nsecond\nthird\n");
    fr := new file_reader(target);
    test("file_reader read_line") { expect(fr.read_line()!!).should_be("first"); };
    test("file_reader line") { expect(fr.line()).should_be(2); };
    test("file_reader peek") { expect(fr.peek_char()).should_be('s'); };
    test("file_reader read_all") { expect(fr.read_all()).should_be("second\nthird\n"); };
    test("file_reader get_file") { expect(fr.get_file().name()).should_be("out.txt"); };
    fr.close();
    try { fr.read_char(); test("file_reader after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("file_reader after close") { }; }
    by_name := new file_reader(base_dir + "/out.txt");
    test("file_reader by path, through the interface") { expect(count_chars(by_name)).should_be(19); };
    lines : decimal = 0;
    src3 := new file_reader(target);
    foreach(line in src3) {
        lines++;
    }
    test("foreach over a file") { expect(lines).should_be(3); };
    target.write_text("");
    test("reader of an empty file") { expect_false(new file_reader(target).has_more()); };
    try { new file_reader(base_dir + "/missing.txt"); test("reader of a missing file") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("reader of a missing file") { }; }
    try { new file_reader(new file(base_dir)); test("reader of a directory") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("reader of a directory") { }; }

    // a reader stacked on a file
    target.write_text("k1 = v1\nk2 = v2\n");
    stacked := new buffered_reader(new file_reader(target));
    test("stacked key") { expect(stacked.read_word()).should_be("k1"); };
    test("stacked until") { expect(io_strings.trim(stacked.read_until('\n'))).should_be("= v1"); };
    test("stacked line") { expect(stacked.line()).should_be(2); };
    stacked.close();
}

def test_buffered_writer() {
    sink := new string_writer();
    w := new buffered_writer(sink, 8);
    w.write("abc");
    test("held back") { expect(sink.length()).should_be(0); };
    test("buffered") { expect(w.buffered()).should_be(3); };
    w.write("defgh");
    test("handed on when full") { expect(sink.length()).should_be(8); };
    test("buffer empty again") { expect(w.buffered()).should_be(0); };
    w.write_char('i');
    w.flush();
    test("flush") { expect(sink.to_string()!!).should_be("abcdefghi"); };
    w.write_line("");
    w.write_int(5);
    w.write_number(0.25);
    w.new_line();
    test("chars written") { expect(w.get_chars_written()).should_be(16); };
    test("lines written") { expect(w.get_lines_written()).should_be(2); };
    w.close();
    test("close flushes") { expect(sink.to_string()!!).should_be("abcdefghi\n50.25\n"); };
    test("close closes the target") { expect_true(sink.is_closed()); };
    w.close();
    try { w.write("x"); test("write after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("write after close") { }; }

    crlf_sink := new string_writer();
    crlf := new buffered_writer(crlf_sink);
    crlf.set_line_separator("\r\n");
    crlf.set_auto_flush(true);
    crlf.write_line("a");
    test("auto flush at line end, custom separator") { expect(crlf_sink.to_string()!!).should_be("a\r\n"); };
    crlf.write("b");
    test("no flush without line end") { expect(crlf_sink.length()).should_be(3); };
    write_report(crlf);
    test("through the interface") { expect(crlf_sink.to_string()!!).should_be("a\r\nbtotal: 42\r\n\r\nend"); };

    try { new buffered_writer(sink, 0); test("zero capacity") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("zero capacity") { }; }

    // buffered writer in front of a file
    target := new file(base_dir + "/buffered.txt");
    fw := new buffered_writer(new file_writer(target), 64);
    for(i : decimal = 0; i < 100; i++) {
        fw.write_int(i);
        fw.new_line();
    }
    fw.close();
    back := target.read_lines();
    test("100 lines through two writers") { expect(back.size()).should_be(100); };
    test("line 99") { expect(back.at(99)).should_be("99"); };

    // console_writer: only that it can be used and closed (its output is not captured here)
    con := new console_writer();
    con.write("");
    con.flush();
    con.close();
    con.close();
    try { con.write_line("x"); test("console write after close") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("console write after close") { }; }
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_io_streams") {
        start := new file(base_dir);
        start.delete_recursively();
        test("test directory created") { expect_true(start.mkdirs()); };

        test_string_reader();
        test_buffered_reader();
        test_string_writer();
        test_file_streams();
        test_buffered_writer();

        test("cleanup") { expect_true(start.delete_recursively()); };
    };
    finish_tests("lib_io_streams");
}
