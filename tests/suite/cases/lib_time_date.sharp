mod main;

import ( testing, std.time )

/**
 * std.time.date: creating and validating dates, the leap year rule, the
 * epoch day conversion (Howard Hinnant's algorithms), day of week, day of
 * year, ISO week numbers, text and parsing.
 *
 * Expected values are calendar facts (2000-01-01 was a Saturday and is epoch
 * day 10957 ...), cross-checked with an independent implementation, never
 * computed with the code under test. Date ARITHMETIC has its own file,
 * lib_time_date_arithmetic.sharp.
 */

def text(d: date): string {
    return d.to_string()!!;
}

/** 1 when date.of(y, m, d) throws a date_time_exception */
def rejects(y: var, m: var, d: var): var {
    try {
        date.of(y, m, d);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

/** 1 when date.parse(s) throws a date_time_exception */
def rejects_text(s: string): var {
    try {
        date.parse(s);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def epoch_day_of(y: var, m: var, d: var): var {
    return date.of(y, m, d).to_epoch_day();
}

def weekday_of(y: var, m: var, d: var): var {
    return date.of(y, m, d).day_of_week().value();
}

def main(args: string[]) {
    // ---- fields
    d := date.of(2024, 2, 29);
    expect("year", d.year(), 2024);
    expect("month_value", d.month_value(), 2);
    expect("day", d.day(), 29);
    expect_str("month_of_year name", d.month_of_year().name(), "February");
    expect("quarter of February", d.quarter(), 1);
    expect("quarter of October", date.of(2024, 10, 1).quarter(), 4);
    expect_str("of_month", text(date.of_month(2024, month.march, 5)), "2024-03-05");

    // ---- leap years: divisible by 4, except centuries, unless divisible by 400
    expect_true("2024 is a leap year", date.is_leap_year(2024));
    expect_true("2000 is a leap year", date.is_leap_year(2000));
    expect_true("1600 is a leap year", date.is_leap_year(1600));
    expect_true("2400 is a leap year", date.is_leap_year(2400));
    expect_true("year 0 is a leap year", date.is_leap_year(0));
    expect_true("year -4 is a leap year", date.is_leap_year(0 - 4));
    expect_false("1900 is not a leap year", date.is_leap_year(1900));
    expect_false("2100 is not a leap year", date.is_leap_year(2100));
    expect_false("1700 is not a leap year", date.is_leap_year(1700));
    expect_false("2023 is not a leap year", date.is_leap_year(2023));
    expect_false("year 1 is not a leap year", date.is_leap_year(1));
    expect_false("year -1 is not a leap year", date.is_leap_year(0 - 1));
    expect_true("is_leap_year() on a date", d.is_leap_year());
    expect_false("is_leap_year() on a 1900 date", date.of(1900, 6, 1).is_leap_year());

    // ---- lengths
    expect("days in February 2024", date.days_in_month(2024, 2), 29);
    expect("days in February 2023", date.days_in_month(2023, 2), 28);
    expect("days in February 1900", date.days_in_month(1900, 2), 28);
    expect("days in February 2000", date.days_in_month(2000, 2), 29);
    expect("days in January", date.days_in_month(2023, 1), 31);
    expect("days in April", date.days_in_month(2023, 4), 30);
    expect("days in June", date.days_in_month(2023, 6), 30);
    expect("days in September", date.days_in_month(2023, 9), 30);
    expect("days in November", date.days_in_month(2023, 11), 30);
    expect("days in December", date.days_in_month(2023, 12), 31);
    expect("length_of_month", d.length_of_month(), 29);
    expect("days in 2024", date.days_in_year(2024), 366);
    expect("days in 2023", date.days_in_year(2023), 365);
    expect("length_of_year", d.length_of_year(), 366);

    // ---- epoch day: 1970-01-01 is day 0
    expect("1970-01-01", epoch_day_of(1970, 1, 1), 0);
    expect("1970-01-02", epoch_day_of(1970, 1, 2), 1);
    expect("1969-12-31", epoch_day_of(1969, 12, 31), 0 - 1);
    expect("2000-01-01", epoch_day_of(2000, 1, 1), 10957);
    expect("1999-12-31", epoch_day_of(1999, 12, 31), 10956);
    expect("2024-02-29", epoch_day_of(2024, 2, 29), 19782);
    expect("2026-11-12", epoch_day_of(2026, 11, 12), 20769);
    expect("2038-01-19 (32-bit time_t ends)", epoch_day_of(2038, 1, 19), 24855);
    expect("2100-03-01", epoch_day_of(2100, 3, 1), 47541);
    expect("2400-02-29", epoch_day_of(2400, 2, 29), 157113);
    expect("9999-12-31", epoch_day_of(9999, 12, 31), 2932896);
    expect("1969-07-20 (moon landing)", epoch_day_of(1969, 7, 20), 0 - 165);
    expect("1945-05-08", epoch_day_of(1945, 5, 8), 0 - 9004);
    expect("1900-01-01", epoch_day_of(1900, 1, 1), 0 - 25567);
    expect("1600-01-01", epoch_day_of(1600, 1, 1), 0 - 135140);
    expect("1582-10-15 (first Gregorian day)", epoch_day_of(1582, 10, 15), 0 - 141427);
    expect("0001-01-01", epoch_day_of(1, 1, 1), 0 - 719162);
    expect("0000-03-01 (the algorithm's day zero)", epoch_day_of(0, 3, 1), 0 - 719468);
    expect("the epoch constant", date.epoch.to_epoch_day(), 0);

    // ---- and back
    expect_str("of_epoch_day(0)", text(date.of_epoch_day(0)), "1970-01-01");
    expect_str("of_epoch_day(-1)", text(date.of_epoch_day(0 - 1)), "1969-12-31");
    expect_str("of_epoch_day(10957)", text(date.of_epoch_day(10957)), "2000-01-01");
    expect_str("of_epoch_day(19782)", text(date.of_epoch_day(19782)), "2024-02-29");
    expect_str("of_epoch_day(19783)", text(date.of_epoch_day(19783)), "2024-03-01");
    expect_str("of_epoch_day(24855)", text(date.of_epoch_day(24855)), "2038-01-19");
    expect_str("of_epoch_day(47541)", text(date.of_epoch_day(47541)), "2100-03-01");
    expect_str("of_epoch_day(2932896)", text(date.of_epoch_day(2932896)), "9999-12-31");
    expect_str("of_epoch_day(-25567)", text(date.of_epoch_day(0 - 25567)), "1900-01-01");
    expect_str("of_epoch_day(-141427)", text(date.of_epoch_day(0 - 141427)), "1582-10-15");
    expect_str("of_epoch_day(-719162)", text(date.of_epoch_day(0 - 719162)), "0001-01-01");
    expect_str("of_epoch_day(-719163)", text(date.of_epoch_day(0 - 719163)), "0000-12-31");
    expect_str("of_epoch_day(-719468)", text(date.of_epoch_day(0 - 719468)), "0000-03-01");
    expect_str("of_epoch_day(-719469)", text(date.of_epoch_day(0 - 719469)), "0000-02-29");

    // round trip over every day of four centuries around the epoch would be slow in the
    // interpreter; every 97th day from 1583 to 2400 covers all months and weekdays
    mismatches : var = 0;
    previous : var = 0 - 141800;
    for(day : var = 0 - 141700; day < 157200; day += 97) {
        back : date = date.of_epoch_day(day);
        if(back.to_epoch_day() != day) {
            mismatches++;
        }
        if(date.of(back.year(), back.month_value(), back.day()).to_epoch_day() != day) {
            mismatches++;
        }
        previous = day;
    }
    expect("epoch day round trip 1583-2400", mismatches, 0);

    // consecutive days never skip or repeat: walk across 1900 (not leap) and 2000 (leap)
    walk : date = date.of(1900, 2, 27);
    expect_str("1900-02-27 + 1", text(walk.plus_days(1)), "1900-02-28");
    expect_str("1900-02-27 + 2 (no leap day in 1900)", text(walk.plus_days(2)), "1900-03-01");
    walk = date.of(2000, 2, 27);
    expect_str("2000-02-27 + 2 (leap day in 2000)", text(walk.plus_days(2)), "2000-02-29");
    expect_str("2000-02-27 + 3", text(walk.plus_days(3)), "2000-03-01");

    // ---- day of week (1 = Monday .. 7 = Sunday)
    expect("1970-01-01 was a Thursday", weekday_of(1970, 1, 1), 4);
    expect("2000-01-01 was a Saturday", weekday_of(2000, 1, 1), 6);
    expect("2024-02-29 was a Thursday", weekday_of(2024, 2, 29), 4);
    expect("1969-12-31 was a Wednesday", weekday_of(1969, 12, 31), 3);
    expect("1969-07-20 was a Sunday", weekday_of(1969, 7, 20), 7);
    expect("2001-09-11 was a Tuesday", weekday_of(2001, 9, 11), 2);
    expect("1945-05-08 was a Tuesday", weekday_of(1945, 5, 8), 2);
    expect("1900-01-01 was a Monday", weekday_of(1900, 1, 1), 1);
    expect("1600-01-01 was a Saturday", weekday_of(1600, 1, 1), 6);
    expect("1582-10-15 was a Friday", weekday_of(1582, 10, 15), 5);
    expect("0001-01-01 is a Monday (proleptic)", weekday_of(1, 1, 1), 1);
    expect("2038-01-19 is a Tuesday", weekday_of(2038, 1, 19), 2);
    expect("2100-03-01 is a Monday", weekday_of(2100, 3, 1), 1);
    expect("9999-12-31 is a Friday", weekday_of(9999, 12, 31), 5);
    expect_true("day_of_week() gives the shared object", d.day_of_week() == day_of_week.thursday);
    expect_str("day_of_week().name()", d.day_of_week().name(), "Thursday");

    // ---- day of year
    expect("1 January", date.of(2023, 1, 1).day_of_year(), 1);
    expect("1 February", date.of(2023, 2, 1).day_of_year(), 32);
    expect("1 March 2023", date.of(2023, 3, 1).day_of_year(), 60);
    expect("1 March 2024", date.of(2024, 3, 1).day_of_year(), 61);
    expect("29 February 2024", d.day_of_year(), 60);
    expect("31 December 2023", date.of(2023, 12, 31).day_of_year(), 365);
    expect("31 December 2024", date.of(2024, 12, 31).day_of_year(), 366);
    expect("2026-11-12", date.of(2026, 11, 12).day_of_year(), 316);
    expect_str("of_year_day(2024, 60)", text(date.of_year_day(2024, 60)), "2024-02-29");
    expect_str("of_year_day(2023, 60)", text(date.of_year_day(2023, 60)), "2023-03-01");
    expect_str("of_year_day(2024, 366)", text(date.of_year_day(2024, 366)), "2024-12-31");
    expect_str("of_year_day(2023, 1)", text(date.of_year_day(2023, 1)), "2023-01-01");

    // ---- ISO week numbers
    expect("2024-02-29 week", d.iso_week(), 9);
    expect("2026-11-12 week", date.of(2026, 11, 12).iso_week(), 46);
    expect("2021-01-03 is in week 53", date.of(2021, 1, 3).iso_week(), 53);
    expect("...of 2020", date.of(2021, 1, 3).iso_week_year(), 2020);
    expect("2021-01-04 is in week 1", date.of(2021, 1, 4).iso_week(), 1);
    expect("...of 2021", date.of(2021, 1, 4).iso_week_year(), 2021);
    expect("2024-12-30 is in week 1", date.of(2024, 12, 30).iso_week(), 1);
    expect("...of 2025", date.of(2024, 12, 30).iso_week_year(), 2025);
    expect("2020-12-31 is in week 53", date.of(2020, 12, 31).iso_week(), 53);
    expect("2016-01-01 is in week 53", date.of(2016, 1, 1).iso_week(), 53);
    expect("...of 2015", date.of(2016, 1, 1).iso_week_year(), 2015);
    expect("2018-12-31 is in week 1", date.of(2018, 12, 31).iso_week(), 1);
    expect("...of 2019", date.of(2018, 12, 31).iso_week_year(), 2019);
    expect("2010-01-03 is in week 53", date.of(2010, 1, 3).iso_week(), 53);
    expect("2008-12-29 is in week 1", date.of(2008, 12, 29).iso_week(), 1);
    expect("2005-01-01 is in week 53", date.of(2005, 1, 1).iso_week(), 53);
    expect("...of 2004", date.of(2005, 1, 1).iso_week_year(), 2004);
    expect("2005-12-31 is in week 52", date.of(2005, 12, 31).iso_week(), 52);
    expect("2007-01-01 is in week 1", date.of(2007, 1, 1).iso_week(), 1);
    expect("2000-01-01 is in week 52", date.of(2000, 1, 1).iso_week(), 52);
    expect("...of 1999", date.of(2000, 1, 1).iso_week_year(), 1999);
    expect("1969-12-31 is in week 1 of 1970", date.of(1969, 12, 31).iso_week_year(), 1970);
    expect("2020 has 53 weeks", date.iso_weeks_in_year(2020), 53);
    expect("2015 has 53 weeks", date.iso_weeks_in_year(2015), 53);
    expect("2004 has 53 weeks", date.iso_weeks_in_year(2004), 53);
    expect("2026 has 53 weeks", date.iso_weeks_in_year(2026), 53);
    expect("2024 has 52 weeks", date.iso_weeks_in_year(2024), 52);
    expect("2021 has 52 weeks", date.iso_weeks_in_year(2021), 52);

    // ---- text
    expect_str("to_string", text(d), "2024-02-29");
    expect_str("padding", text(date.of(33, 4, 3)), "0033-04-03");
    expect_str("year 0", text(date.of(0, 1, 1)), "0000-01-01");
    expect_str("negative year", text(date.of(0 - 44, 3, 15)), "-0044-03-15");
    expect_str("five digit year", text(date.of(12345, 1, 1)), "+12345-01-01");
    expect_str("largest date", text(date.of(999999, 12, 31)), "+999999-12-31");
    expect_str("smallest date", text(date.of(0 - 999999, 1, 1)), "-999999-01-01");
    expect_str("interpolation", "on $d", "on 2024-02-29");

    // ---- parsing
    expect_str("parse", text(date.parse("2024-02-29")), "2024-02-29");
    expect("parse year", date.parse("1999-12-31").year(), 1999);
    expect("parse month", date.parse("1999-12-31").month_value(), 12);
    expect("parse day", date.parse("1999-12-31").day(), 31);
    expect("parse negative year", date.parse("-0044-03-15").year(), 0 - 44);
    expect("parse signed long year", date.parse("+12345-01-01").year(), 12345);
    expect_str("format -> parse round trip", text(date.parse(text(date.of(1582, 10, 15)))), "1582-10-15");
    expect_true("parse rejects 29 February 2023", rejects_text("2023-02-29"));
    expect_true("parse rejects month 13", rejects_text("2024-13-01"));
    expect_true("parse rejects day 0", rejects_text("2024-01-00"));
    expect_true("parse rejects one digit month", rejects_text("2024-1-01"));
    expect_true("parse rejects slashes", rejects_text("2024/01/01"));
    expect_true("parse rejects trailing text", rejects_text("2024-01-01x"));
    expect_true("parse rejects the empty string", rejects_text(""));
    expect_true("parse rejects words", rejects_text("yesterday"));
    expect_true("parse rejects a 5 digit year without sign", rejects_text("12345-01-01"));

    // ---- validation
    expect_true("29 February 2023", rejects(2023, 2, 29));
    expect_true("29 February 1900", rejects(1900, 2, 29));
    expect_false("29 February 2000 exists", rejects(2000, 2, 29));
    expect_true("30 February 2024", rejects(2024, 2, 30));
    expect_true("31 April", rejects(2024, 4, 31));
    expect_true("31 June", rejects(2024, 6, 31));
    expect_true("32 January", rejects(2024, 1, 32));
    expect_true("day 0", rejects(2024, 1, 0));
    expect_true("negative day", rejects(2024, 1, 0 - 1));
    expect_true("month 0", rejects(2024, 0, 1));
    expect_true("month 13", rejects(2024, 13, 1));
    expect_true("year one million", rejects(1000000, 1, 1));
    expect_true("year minus one million", rejects(0 - 1000000, 1, 1));
    expect_true("a fractional day", rejects(2024, 1, 1.5));
    expect_true("a fractional month", rejects(2024, 1.5, 1));
    try {
        date.of(2023, 2, 29);
        fail("message", "no exception");
    } catch(e: date_time_exception) {
        expect_str("message names the month and its length", e.get_message(), "day 29 is not valid for 2023-02 (1 to 28)");
    }
    try {
        date.of(2024, 13, 1);
        fail("message", "no exception");
    } catch(e: date_time_exception) {
        expect_str("message for the month", e.get_message(), "month must be 1 to 12 but was 13");
    }
    try {
        date.of_year_day(2023, 366);
        fail("of_year_day(2023, 366)", "no exception");
    } catch(e: date_time_exception) {
        pass("of_year_day(2023, 366) throws");
    }
    caught_as_exception : var = 0;
    try {
        date.of(2024, 0, 1);
    } catch(e: exception) {
        caught_as_exception = 1;
    }
    expect("date_time_exception is an exception", caught_as_exception, 1);

    // ---- comparing
    a := date.of(2024, 2, 29);
    b := date.of(2024, 3, 1);
    expect_true("== with equal fields", a == d);
    expect_false("== with different fields", a == b);
    expect_true("!=", a != b);
    expect_false("!= with equal fields", a != d);
    expect_true("<", a < b);
    expect_false("< the other way", b < a);
    expect_true("<= equal", a <= d);
    expect_true(">", b > a);
    expect_true(">= equal", a >= d);
    expect_false(">= smaller", a >= b);
    expect("compare_to less", a.compare_to(b), 0 - 1);
    expect("compare_to equal", a.compare_to(d), 0);
    expect("compare_to greater", b.compare_to(a), 1);
    expect_true("is_before", a.is_before(b));
    expect_true("is_after", b.is_after(a));
    expect_true("year decides before month", date.of(2023, 12, 31) < date.of(2024, 1, 1));
    expect_true("negative years order correctly", date.of(0 - 100, 1, 1) < date.of(0 - 99, 1, 1));
    expect_true("equal dates have equal hashes", a.hash().value == d.hash().value);

    finish("lib_time_date");
}
