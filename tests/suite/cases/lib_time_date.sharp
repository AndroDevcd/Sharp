mod main;

import ( std.testing, std.time )

/**
 * std.time.date: creating and validating dates, the leap year rule, the
 * epoch day conversion (Howard Hinnant's algorithms), day of week, day of
 * year, ISO week numbers, text and parsing.
 *
 * Expected values are calendar facts (2000-01-01 was a Saturday and is epoch
 * day 10957 ...), cross-checked with an independent implementation, never
 * computed with the code under test. Date ARITHMETIC has its own file,
 * lib_time_date_arithmetic.sharp.
 */

def text(d: date): string {
    return d.to_string()!!;
}

/** 1 when date.of(y, m, d) throws a date_time_exception */
def rejects(y: decimal, m: decimal, d: decimal): decimal {
    try {
        date.of(y, m, d);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

/** 1 when date.parse(s) throws a date_time_exception */
def rejects_text(s: string): decimal {
    try {
        date.parse(s);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def epoch_day_of(y: decimal, m: decimal, d: decimal): decimal {
    return date.of(y, m, d).to_epoch_day();
}

def weekday_of(y: decimal, m: decimal, d: decimal): decimal {
    return date.of(y, m, d).day_of_week().value();
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_time_date") {
        // ---- fields
        d := date.of(2024, 2, 29);
        test("year") { expect(d.year()).should_be(2024); };
        test("month_value") { expect(d.month_value()).should_be(2); };
        test("day") { expect(d.day()).should_be(29); };
        test("month_of_year name") { expect(d.month_of_year().name()).should_be("February"); };
        test("quarter of February") { expect(d.quarter()).should_be(1); };
        test("quarter of October") { expect(date.of(2024, 10, 1).quarter()).should_be(4); };
        test("of_month") { expect(text(date.of_month(2024, month.march, 5))).should_be("2024-03-05"); };

        // ---- leap years: divisible by 4, except centuries, unless divisible by 400
        test("2024 is a leap year") { expect_true(date.is_leap_year(2024)); };
        test("2000 is a leap year") { expect_true(date.is_leap_year(2000)); };
        test("1600 is a leap year") { expect_true(date.is_leap_year(1600)); };
        test("2400 is a leap year") { expect_true(date.is_leap_year(2400)); };
        test("year 0 is a leap year") { expect_true(date.is_leap_year(0)); };
        test("year -4 is a leap year") { expect_true(date.is_leap_year(0 - 4)); };
        test("1900 is not a leap year") { expect_false(date.is_leap_year(1900)); };
        test("2100 is not a leap year") { expect_false(date.is_leap_year(2100)); };
        test("1700 is not a leap year") { expect_false(date.is_leap_year(1700)); };
        test("2023 is not a leap year") { expect_false(date.is_leap_year(2023)); };
        test("year 1 is not a leap year") { expect_false(date.is_leap_year(1)); };
        test("year -1 is not a leap year") { expect_false(date.is_leap_year(0 - 1)); };
        test("is_leap_year() on a date") { expect_true(d.is_leap_year()); };
        test("is_leap_year() on a 1900 date") { expect_false(date.of(1900, 6, 1).is_leap_year()); };

        // ---- lengths
        test("days in February 2024") { expect(date.days_in_month(2024, 2)).should_be(29); };
        test("days in February 2023") { expect(date.days_in_month(2023, 2)).should_be(28); };
        test("days in February 1900") { expect(date.days_in_month(1900, 2)).should_be(28); };
        test("days in February 2000") { expect(date.days_in_month(2000, 2)).should_be(29); };
        test("days in January") { expect(date.days_in_month(2023, 1)).should_be(31); };
        test("days in April") { expect(date.days_in_month(2023, 4)).should_be(30); };
        test("days in June") { expect(date.days_in_month(2023, 6)).should_be(30); };
        test("days in September") { expect(date.days_in_month(2023, 9)).should_be(30); };
        test("days in November") { expect(date.days_in_month(2023, 11)).should_be(30); };
        test("days in December") { expect(date.days_in_month(2023, 12)).should_be(31); };
        test("length_of_month") { expect(d.length_of_month()).should_be(29); };
        test("days in 2024") { expect(date.days_in_year(2024)).should_be(366); };
        test("days in 2023") { expect(date.days_in_year(2023)).should_be(365); };
        test("length_of_year") { expect(d.length_of_year()).should_be(366); };

        // ---- epoch day: 1970-01-01 is day 0
        test("1970-01-01") { expect(epoch_day_of(1970, 1, 1)).should_be(0); };
        test("1970-01-02") { expect(epoch_day_of(1970, 1, 2)).should_be(1); };
        test("1969-12-31") { expect(epoch_day_of(1969, 12, 31)).should_be(0 - 1); };
        test("2000-01-01") { expect(epoch_day_of(2000, 1, 1)).should_be(10957); };
        test("1999-12-31") { expect(epoch_day_of(1999, 12, 31)).should_be(10956); };
        test("2024-02-29") { expect(epoch_day_of(2024, 2, 29)).should_be(19782); };
        test("2026-11-12") { expect(epoch_day_of(2026, 11, 12)).should_be(20769); };
        test("2038-01-19 (32-bit time_t ends)") { expect(epoch_day_of(2038, 1, 19)).should_be(24855); };
        test("2100-03-01") { expect(epoch_day_of(2100, 3, 1)).should_be(47541); };
        test("2400-02-29") { expect(epoch_day_of(2400, 2, 29)).should_be(157113); };
        test("9999-12-31") { expect(epoch_day_of(9999, 12, 31)).should_be(2932896); };
        test("1969-07-20 (moon landing)") { expect(epoch_day_of(1969, 7, 20)).should_be(0 - 165); };
        test("1945-05-08") { expect(epoch_day_of(1945, 5, 8)).should_be(0 - 9004); };
        test("1900-01-01") { expect(epoch_day_of(1900, 1, 1)).should_be(0 - 25567); };
        test("1600-01-01") { expect(epoch_day_of(1600, 1, 1)).should_be(0 - 135140); };
        test("1582-10-15 (first Gregorian day)") { expect(epoch_day_of(1582, 10, 15)).should_be(0 - 141427); };
        test("0001-01-01") { expect(epoch_day_of(1, 1, 1)).should_be(0 - 719162); };
        test("0000-03-01 (the algorithm's day zero)") { expect(epoch_day_of(0, 3, 1)).should_be(0 - 719468); };
        test("the epoch constant") { expect(date.epoch.to_epoch_day()).should_be(0); };

        // ---- and back
        test("of_epoch_day(0)") { expect(text(date.of_epoch_day(0))).should_be("1970-01-01"); };
        test("of_epoch_day(-1)") { expect(text(date.of_epoch_day(0 - 1))).should_be("1969-12-31"); };
        test("of_epoch_day(10957)") { expect(text(date.of_epoch_day(10957))).should_be("2000-01-01"); };
        test("of_epoch_day(19782)") { expect(text(date.of_epoch_day(19782))).should_be("2024-02-29"); };
        test("of_epoch_day(19783)") { expect(text(date.of_epoch_day(19783))).should_be("2024-03-01"); };
        test("of_epoch_day(24855)") { expect(text(date.of_epoch_day(24855))).should_be("2038-01-19"); };
        test("of_epoch_day(47541)") { expect(text(date.of_epoch_day(47541))).should_be("2100-03-01"); };
        test("of_epoch_day(2932896)") { expect(text(date.of_epoch_day(2932896))).should_be("9999-12-31"); };
        test("of_epoch_day(-25567)") { expect(text(date.of_epoch_day(0 - 25567))).should_be("1900-01-01"); };
        test("of_epoch_day(-141427)") { expect(text(date.of_epoch_day(0 - 141427))).should_be("1582-10-15"); };
        test("of_epoch_day(-719162)") { expect(text(date.of_epoch_day(0 - 719162))).should_be("0001-01-01"); };
        test("of_epoch_day(-719163)") { expect(text(date.of_epoch_day(0 - 719163))).should_be("0000-12-31"); };
        test("of_epoch_day(-719468)") { expect(text(date.of_epoch_day(0 - 719468))).should_be("0000-03-01"); };
        test("of_epoch_day(-719469)") { expect(text(date.of_epoch_day(0 - 719469))).should_be("0000-02-29"); };

        // round trip over every day of four centuries around the epoch would be slow in the
        // interpreter; every 97th day from 1583 to 2400 covers all months and weekdays
        mismatches : decimal = 0;
        previous : decimal = 0 - 141800;
        for(day : decimal = 0 - 141700; day < 157200; day += 97) {
            back : date = date.of_epoch_day(day);
            if(back.to_epoch_day() != day) {
                mismatches++;
            }
            if(date.of(back.year(), back.month_value(), back.day()).to_epoch_day() != day) {
                mismatches++;
            }
            previous = day;
        }
        test("epoch day round trip 1583-2400") { expect(mismatches).should_be(0); };

        // consecutive days never skip or repeat: walk across 1900 (not leap) and 2000 (leap)
        walk : date = date.of(1900, 2, 27);
        test("1900-02-27 + 1") { expect(text(walk.plus_days(1))).should_be("1900-02-28"); };
        test("1900-02-27 + 2 (no leap day in 1900)") { expect(text(walk.plus_days(2))).should_be("1900-03-01"); };
        walk = date.of(2000, 2, 27);
        test("2000-02-27 + 2 (leap day in 2000)") { expect(text(walk.plus_days(2))).should_be("2000-02-29"); };
        test("2000-02-27 + 3") { expect(text(walk.plus_days(3))).should_be("2000-03-01"); };

        // ---- day of week (1 = Monday .. 7 = Sunday)
        test("1970-01-01 was a Thursday") { expect(weekday_of(1970, 1, 1)).should_be(4); };
        test("2000-01-01 was a Saturday") { expect(weekday_of(2000, 1, 1)).should_be(6); };
        test("2024-02-29 was a Thursday") { expect(weekday_of(2024, 2, 29)).should_be(4); };
        test("1969-12-31 was a Wednesday") { expect(weekday_of(1969, 12, 31)).should_be(3); };
        test("1969-07-20 was a Sunday") { expect(weekday_of(1969, 7, 20)).should_be(7); };
        test("2001-09-11 was a Tuesday") { expect(weekday_of(2001, 9, 11)).should_be(2); };
        test("1945-05-08 was a Tuesday") { expect(weekday_of(1945, 5, 8)).should_be(2); };
        test("1900-01-01 was a Monday") { expect(weekday_of(1900, 1, 1)).should_be(1); };
        test("1600-01-01 was a Saturday") { expect(weekday_of(1600, 1, 1)).should_be(6); };
        test("1582-10-15 was a Friday") { expect(weekday_of(1582, 10, 15)).should_be(5); };
        test("0001-01-01 is a Monday (proleptic)") { expect(weekday_of(1, 1, 1)).should_be(1); };
        test("2038-01-19 is a Tuesday") { expect(weekday_of(2038, 1, 19)).should_be(2); };
        test("2100-03-01 is a Monday") { expect(weekday_of(2100, 3, 1)).should_be(1); };
        test("9999-12-31 is a Friday") { expect(weekday_of(9999, 12, 31)).should_be(5); };
        test("day_of_week() gives the shared object") { expect_true(d.day_of_week() == day_of_week.thursday); };
        test("day_of_week().name()") { expect(d.day_of_week().name()).should_be("Thursday"); };

        // ---- day of year
        test("1 January") { expect(date.of(2023, 1, 1).day_of_year()).should_be(1); };
        test("1 February") { expect(date.of(2023, 2, 1).day_of_year()).should_be(32); };
        test("1 March 2023") { expect(date.of(2023, 3, 1).day_of_year()).should_be(60); };
        test("1 March 2024") { expect(date.of(2024, 3, 1).day_of_year()).should_be(61); };
        test("29 February 2024") { expect(d.day_of_year()).should_be(60); };
        test("31 December 2023") { expect(date.of(2023, 12, 31).day_of_year()).should_be(365); };
        test("31 December 2024") { expect(date.of(2024, 12, 31).day_of_year()).should_be(366); };
        test("2026-11-12") { expect(date.of(2026, 11, 12).day_of_year()).should_be(316); };
        test("of_year_day(2024, 60)") { expect(text(date.of_year_day(2024, 60))).should_be("2024-02-29"); };
        test("of_year_day(2023, 60)") { expect(text(date.of_year_day(2023, 60))).should_be("2023-03-01"); };
        test("of_year_day(2024, 366)") { expect(text(date.of_year_day(2024, 366))).should_be("2024-12-31"); };
        test("of_year_day(2023, 1)") { expect(text(date.of_year_day(2023, 1))).should_be("2023-01-01"); };

        // ---- ISO week numbers
        test("2024-02-29 week") { expect(d.iso_week()).should_be(9); };
        test("2026-11-12 week") { expect(date.of(2026, 11, 12).iso_week()).should_be(46); };
        test("2021-01-03 is in week 53") { expect(date.of(2021, 1, 3).iso_week()).should_be(53); };
        test("...of 2020") { expect(date.of(2021, 1, 3).iso_week_year()).should_be(2020); };
        test("2021-01-04 is in week 1") { expect(date.of(2021, 1, 4).iso_week()).should_be(1); };
        test("...of 2021") { expect(date.of(2021, 1, 4).iso_week_year()).should_be(2021); };
        test("2024-12-30 is in week 1") { expect(date.of(2024, 12, 30).iso_week()).should_be(1); };
        test("...of 2025") { expect(date.of(2024, 12, 30).iso_week_year()).should_be(2025); };
        test("2020-12-31 is in week 53") { expect(date.of(2020, 12, 31).iso_week()).should_be(53); };
        test("2016-01-01 is in week 53") { expect(date.of(2016, 1, 1).iso_week()).should_be(53); };
        test("...of 2015") { expect(date.of(2016, 1, 1).iso_week_year()).should_be(2015); };
        test("2018-12-31 is in week 1") { expect(date.of(2018, 12, 31).iso_week()).should_be(1); };
        test("...of 2019") { expect(date.of(2018, 12, 31).iso_week_year()).should_be(2019); };
        test("2010-01-03 is in week 53") { expect(date.of(2010, 1, 3).iso_week()).should_be(53); };
        test("2008-12-29 is in week 1") { expect(date.of(2008, 12, 29).iso_week()).should_be(1); };
        test("2005-01-01 is in week 53") { expect(date.of(2005, 1, 1).iso_week()).should_be(53); };
        test("...of 2004") { expect(date.of(2005, 1, 1).iso_week_year()).should_be(2004); };
        test("2005-12-31 is in week 52") { expect(date.of(2005, 12, 31).iso_week()).should_be(52); };
        test("2007-01-01 is in week 1") { expect(date.of(2007, 1, 1).iso_week()).should_be(1); };
        test("2000-01-01 is in week 52") { expect(date.of(2000, 1, 1).iso_week()).should_be(52); };
        test("...of 1999") { expect(date.of(2000, 1, 1).iso_week_year()).should_be(1999); };
        test("1969-12-31 is in week 1 of 1970") { expect(date.of(1969, 12, 31).iso_week_year()).should_be(1970); };
        test("2020 has 53 weeks") { expect(date.iso_weeks_in_year(2020)).should_be(53); };
        test("2015 has 53 weeks") { expect(date.iso_weeks_in_year(2015)).should_be(53); };
        test("2004 has 53 weeks") { expect(date.iso_weeks_in_year(2004)).should_be(53); };
        test("2026 has 53 weeks") { expect(date.iso_weeks_in_year(2026)).should_be(53); };
        test("2024 has 52 weeks") { expect(date.iso_weeks_in_year(2024)).should_be(52); };
        test("2021 has 52 weeks") { expect(date.iso_weeks_in_year(2021)).should_be(52); };

        // ---- text
        test("to_string") { expect(text(d)).should_be("2024-02-29"); };
        test("padding") { expect(text(date.of(33, 4, 3))).should_be("0033-04-03"); };
        test("year 0") { expect(text(date.of(0, 1, 1))).should_be("0000-01-01"); };
        test("negative year") { expect(text(date.of(0 - 44, 3, 15))).should_be("-0044-03-15"); };
        test("five digit year") { expect(text(date.of(12345, 1, 1))).should_be("+12345-01-01"); };
        test("largest date") { expect(text(date.of(999999, 12, 31))).should_be("+999999-12-31"); };
        test("smallest date") { expect(text(date.of(0 - 999999, 1, 1))).should_be("-999999-01-01"); };
        test("interpolation") { expect("on $d").should_be("on 2024-02-29"); };

        // ---- parsing
        test("parse") { expect(text(date.parse("2024-02-29"))).should_be("2024-02-29"); };
        test("parse year") { expect(date.parse("1999-12-31").year()).should_be(1999); };
        test("parse month") { expect(date.parse("1999-12-31").month_value()).should_be(12); };
        test("parse day") { expect(date.parse("1999-12-31").day()).should_be(31); };
        test("parse negative year") { expect(date.parse("-0044-03-15").year()).should_be(0 - 44); };
        test("parse signed long year") { expect(date.parse("+12345-01-01").year()).should_be(12345); };
        test("format -> parse round trip") { expect(text(date.parse(text(date.of(1582, 10, 15))))).should_be("1582-10-15"); };
        test("parse rejects 29 February 2023") { expect_true(rejects_text("2023-02-29")); };
        test("parse rejects month 13") { expect_true(rejects_text("2024-13-01")); };
        test("parse rejects day 0") { expect_true(rejects_text("2024-01-00")); };
        test("parse rejects one digit month") { expect_true(rejects_text("2024-1-01")); };
        test("parse rejects slashes") { expect_true(rejects_text("2024/01/01")); };
        test("parse rejects trailing text") { expect_true(rejects_text("2024-01-01x")); };
        test("parse rejects the empty string") { expect_true(rejects_text("")); };
        test("parse rejects words") { expect_true(rejects_text("yesterday")); };
        test("parse rejects a 5 digit year without sign") { expect_true(rejects_text("12345-01-01")); };

        // ---- validation
        test("29 February 2023") { expect_true(rejects(2023, 2, 29)); };
        test("29 February 1900") { expect_true(rejects(1900, 2, 29)); };
        test("29 February 2000 exists") { expect_false(rejects(2000, 2, 29)); };
        test("30 February 2024") { expect_true(rejects(2024, 2, 30)); };
        test("31 April") { expect_true(rejects(2024, 4, 31)); };
        test("31 June") { expect_true(rejects(2024, 6, 31)); };
        test("32 January") { expect_true(rejects(2024, 1, 32)); };
        test("day 0") { expect_true(rejects(2024, 1, 0)); };
        test("negative day") { expect_true(rejects(2024, 1, 0 - 1)); };
        test("month 0") { expect_true(rejects(2024, 0, 1)); };
        test("month 13") { expect_true(rejects(2024, 13, 1)); };
        test("year one million") { expect_true(rejects(1000000, 1, 1)); };
        test("year minus one million") { expect_true(rejects(0 - 1000000, 1, 1)); };
        test("a fractional day") { expect_true(rejects(2024, 1, 1.5)); };
        test("a fractional month") { expect_true(rejects(2024, 1.5, 1)); };
        try {
            date.of(2023, 2, 29);
            test("message") { fail_test("no exception"); };
        } catch(e: date_time_exception) {
            test("message names the month and its length") { expect(e.get_message()).should_be("day 29 is not valid for 2023-02 (1 to 28)"); };
        }
        try {
            date.of(2024, 13, 1);
            test("message") { fail_test("no exception"); };
        } catch(e: date_time_exception) {
            test("message for the month") { expect(e.get_message()).should_be("month must be 1 to 12 but was 13"); };
        }
        try {
            date.of_year_day(2023, 366);
            test("of_year_day(2023, 366)") { fail_test("no exception"); };
        } catch(e: date_time_exception) {
            test("of_year_day(2023, 366) throws") { };
        }
        caught_as_exception : decimal = 0;
        try {
            date.of(2024, 0, 1);
        } catch(e: exception) {
            caught_as_exception = 1;
        }
        test("date_time_exception is an exception") { expect(caught_as_exception).should_be(1); };

        // ---- comparing
        a := date.of(2024, 2, 29);
        b := date.of(2024, 3, 1);
        test("== with equal fields") { expect_true(a == d); };
        test("== with different fields") { expect_false(a == b); };
        test("!=") { expect_true(a != b); };
        test("!= with equal fields") { expect_false(a != d); };
        test("<") { expect_true(a < b); };
        test("< the other way") { expect_false(b < a); };
        test("<= equal") { expect_true(a <= d); };
        test(">") { expect_true(b > a); };
        test(">= equal") { expect_true(a >= d); };
        test(">= smaller") { expect_false(a >= b); };
        test("compare_to less") { expect(a.compare_to(b)).should_be(0 - 1); };
        test("compare_to equal") { expect(a.compare_to(d)).should_be(0); };
        test("compare_to greater") { expect(b.compare_to(a)).should_be(1); };
        test("is_before") { expect_true(a.is_before(b)); };
        test("is_after") { expect_true(b.is_after(a)); };
        test("year decides before month") { expect_true(date.of(2023, 12, 31) < date.of(2024, 1, 1)); };
        test("negative years order correctly") { expect_true(date.of(0 - 100, 1, 1) < date.of(0 - 99, 1, 1)); };
        test("equal dates have equal hashes") { expect_true(a.hash().value == d.hash().value); };
    };
    finish_tests("lib_time_date");
}
