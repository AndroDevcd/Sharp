mod main;

import ( testing )

/**
 * `bool`: the built-in type of true and false, stored in one byte, and
 * `boolean`, the same value as an object (for list<boolean>, `boolean?` and
 * `object`).
 *
 *     ready : bool = true;
 *     if(ready) { ... }
 *     done : bool = count == 0;
 *
 * A comparison, `!`, `&&`, `||` and `is` all give a bool. A bool may be used
 * as the number 1 or 0; a number never becomes a bool by itself (write the
 * test: `n != 0`).
 */

class switchboard {
    on : bool;
    armed : bool = true;
    flags : bool[];

    switchboard() { flags = new bool[3]; }

    def flip() : bool {
        on = !on;
        return on;
    }
}

def negate(value: bool) : bool { return !value; }
def is_even(n: decimal) : bool { return n % 2 == 0; }
def kind_of(value: bool) : decimal { return 1; }
def kind_of(value: _int64) : decimal { return 2; }
def kind_of(value: decimal) : decimal { return 3; }
def inferred(a: decimal) := a > 1;
def count_true(items: bool[]) : decimal {
    total : decimal = 0;
    foreach(item in items) {
        if(item) { total++; }
    }
    return total;
}
def apply(value: decimal, test: (decimal)(bool)) : bool { return test(value); }

def main(args: string[]) {
    // ---- values
    yes : bool = true;
    no : bool = false;
    expect_true("true is true", yes);
    expect_false("false is false", no);
    expect_true("!false", !no);
    expect_false("!true", !yes);

    // ---- what gives a bool
    five : decimal = 5;
    from_comparison : bool = five > 3;
    expect_true("a comparison", from_comparison);
    from_logic : bool = yes && !no;
    expect_true("&&", from_logic);
    expect_true("||", no || yes);
    expect_true("a function", is_even(4));
    expect_false("a function, false", is_even(5));
    expect_true("a parameter", negate(false));

    // ---- := keeps it a plain bool
    guess := true;
    guess = five < 3;
    expect_false(":= true is a bool", guess);
    other := five == 5;
    expect_true(":= a comparison", other);
    expect("a function without a written result", kind_of(inferred(2)), 1);

    // ---- between bools
    expect_true("==", yes == true);
    expect_true("!=", yes != no);
    expect_false("& both needed", yes & no);
    expect_true("|", yes | no);
    expect_true("^", yes ^ no);
    flag : bool = true;
    flag &= false;
    expect_false("&=", flag);
    flag |= true;
    expect_true("|=", flag);

    // ---- conditions
    taken : decimal = 0;
    if(yes) { taken = 1; }
    expect("if", taken, 1);
    runs : decimal = 0;
    running : bool = true;
    while(running) {
        runs++;
        running = runs < 3;
    }
    expect("while", runs, 3);
    expect("? :", yes ? 10 : 20, 10);
    when(yes) {
        true -> { taken = 2; }
        false -> { taken = 3; }
    }
    expect("when", taken, 2);

    // ---- fields start false, and arrays hold one bool per item
    board := new switchboard();
    expect_false("a field starts false", board.on);
    expect_true("a field with a value", board.armed);
    expect_true("a method", board.flip());
    expect_false("a method again", board.flip());
    expect_false("an item starts false", board.flags[1]);
    board.flags[1] = true;
    board.flags[2] = five == 5;
    expect("items of an array", count_true(board.flags), 2);
    expect("an array of literals", count_true(new bool[] { true, false, true, true }), 3);

    // ---- as a number: 1 or 0
    number : _int64 = yes;
    expect("true as a number", number, 1);
    number = no;
    expect("false as a number", number, 0);
    expect("a cast to a number", (yes as _int32), 1);

    // ---- overloads: a bool chooses the bool function
    expect("overload: bool", kind_of(yes), 1);
    expect("overload: a comparison", kind_of(five == 5), 1);
    expect("overload: a number", kind_of(number), 2);
    expect("overload: a decimal", kind_of(five), 3);

    // ---- text
    expect_str("in text: true", "" + yes, "true");
    expect_str("in text: false", "" + no, "false");
    expect_str("in a text with values", "ready=$yes", "ready=true");

    // ---- function values
    expect_true("a lambda", apply(4) { it > 3 });

    // ---- the object form
    wrapped : boolean = true;
    taken = 0;
    if(wrapped) { taken = 1; }
    expect("boolean in a condition", taken, 1);
    expect_true("boolean.value", wrapped.value);
    expect_str("boolean as text", wrapped.to_string(), "true");
    expect_true("boolean == bool", wrapped == true);
    expect_false("!boolean", !wrapped);
    maybe : boolean? = null;
    expect_null("boolean? may be null", maybe);
    maybe = new boolean(false);
    expect_false("boolean? with a value", maybe!!.value);
    kept := new list<boolean>();
    kept.add(new boolean(true));
    kept.add(new boolean(false));
    expect_true("list<boolean>", kept.at(0).value);
    expect_false("list<boolean>, second", kept.at(1).value);
    expect_true("boolean.from_string", boolean.from_string("TRUE"));
    expect_null("boolean.from_string_or_null", boolean.from_string_or_null("maybe"));

    // ---- the library answers with bools
    expect_true("string ==", new string("a") == "a");
    expect_true("number objects compare to a bool", new int(3) > 2);

    finish("native_bool");
}
