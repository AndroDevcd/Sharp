mod main;

import ( std.testing, std.io, std.system, platform )

/**
 * std.system subprocess: a program started and talked to while it runs -
 * its output read line by line, input written to it, its error output apart
 * or merged, asked whether it runs, waited for, stopped.
 *
 * The commands are the shell's own on each system (sh on Linux, cmd.exe on
 * Windows): what differs is said where it does.
 */

def on_windows() : bool {
    return platform_info.is_windows();
}

/** a command that waits for input and copies it to its output when the input ends */
def echo_back() : string {
    if(on_windows()) { return "findstr x*"; }       // (every line has zero or more x in it)
    return "cat";
}

/**
 * This program started as `sharp lib_system_subprocess child`: it answers
 * every line it reads at once, and ends with exit code 7 when its input does.
 */
def be_the_child() {
    println("child ready");
    std.io.console#flush();
    while(true) {
        line := console.read_line_or_null();
        if(line == null) { break; }
        println("child got: " + line!!);
        std.io.console#flush();         // (output into a pipe is collected: say "now")
    }
    exit(7);
}

/** two commands in a row */
def both(first: string, second: string) : string {
    if(on_windows()) { return first + "& " + second; }
    return first + "; " + second;
}

def main(args: string[]) {
    if(sizeof(args) > 0 && args[0] == "child") {
        be_the_child();
        return;
    }
    if(sizeof(args) > 0 && args[0] == "id") {
        // (started to say the number the system knows it by)
        println("" + process.id());
        return;
    }
    show_only_failures();
    tests("lib_system_subprocess") {
        // ---- output, line by line
        child := subprocess.start(both("echo one", "echo two"));
        test("an id") { expect_true(child.id() > 0); };
        test("command") { expect(child.command()).should_be(both("echo one", "echo two")); };
        test("the first line") { expect(io_strings.trim(child.read_line()!!)).should_be("one"); };
        test("the second line") { expect(io_strings.trim(child.read_line()!!)).should_be("two"); };
        test("then the output is closed: null") { expect_null(child.read_line()); };
        test("wait: the exit code") { expect(child.wait()).should_be(0); };
        test("not running") { expect_false(child.is_running()); };
        test("exit_code") { expect(child.exit_code()).should_be(0); };
        test("wait again gives the same") { expect(child.wait()).should_be(0); };
        child.close();
        child.close();

        // ---- an exit code
        failing := subprocess.start("exit 3");
        test("exit 3") { expect(failing.wait()).should_be(3); };
        failing.close();

        // ---- a program started by its file: its id is its own, not a shell's
        numbered := subprocess.run(program_path(), new string[] { "id" });
        its_id : _int64 = numbered.id();
        said_id := io_strings.trim(numbered.read_all_text());
        test("the id of a started program is the one the program itself has") { expect(said_id).should_be("" + its_id); };
        test("... and not this program's") { expect_true(its_id != process.id()); };
        numbered.wait();
        numbered.close();

        // ---- a conversation with another Sharp program: this one, started again
        talker := subprocess.run(program_path(), new string[] { "child" });
        test("a Sharp program started: its first line") { expect(io_strings.trim(talker.read_line()!!)).should_be("child ready"); };
        test("running while it waits for input") { expect_true(talker.is_running()); };
        still_running : decimal = 0;
        try { talker.exit_code(); } catch(early: illegal_state_exception) { still_running = 1; }
        test("exit_code of a running program is refused") { expect_true(still_running); };
        test("wait_for gives up on a program that waits for input") { expect_false(talker.wait_for(100)); };
        talker.write_text("first\n");
        test("a line written is answered at once") { expect(io_strings.trim(talker.read_line()!!)).should_be("child got: first"); };
        talker.write_text("second\nthird\n");
        test("... and the next") { expect(io_strings.trim(talker.read_line()!!)).should_be("child got: second"); };
        talker.close_input();
        test("the rest, up to the end") { expect(io_strings.trim(talker.read_all_text())).should_be("child got: third"); };
        test("it ended when its input did, with the code it chose") { expect(talker.wait()).should_be(7); };
        closed_input : decimal = 0;
        try { talker.write_text("more\n"); } catch(closed: io_exception) { closed_input = 1; }
        test("a closed input refuses a write") { expect_true(closed_input); };
        talker.close();

        // ---- a system program fed its input, read to its end
        copier := subprocess.start(echo_back());
        copier.write_text("copied\n");
        copier.close_input();
        test("input in, output out") { expect(io_strings.trim(copier.read_all_text())).should_be("copied"); };
        test("... and it ended") { expect(copier.wait()).should_be(0); };
        copier.close();

        // ---- a program by its file and arguments: each argument arrives as one
        spaced := subprocess.run(program_path(), new string[] { "child" });
        spaced.read_line();
        spaced.write_text("an argument with spaces & signs\n");
        test("text with spaces and signs") { expect(io_strings.trim(spaced.read_line()!!)).should_be("child got: an argument with spaces & signs"); };
        spaced.close_input();
        spaced.wait();
        spaced.close();

        // ---- the error output: apart, and merged
        apart := subprocess.start(both("echo out", "echo err 1>&2"));
        test("output apart") { expect(io_strings.trim(apart.read_all_text())).should_be("out"); };
        test("errors apart") { expect(io_strings.trim(apart.read_all_error_text())).should_be("err"); };
        apart.wait();
        apart.close();
        merged := subprocess.start(both("echo out", "echo err 1>&2"), true);
        all : string = merged.read_all_text();
        test("merged: both in the output") { expect_true(io_strings.contains(all, "out") && io_strings.contains(all, "err")); };
        test("merged: nothing in the error output") { expect(merged.read_all_error_text()).should_be(""); };
        merged.wait();
        merged.close();

        // ---- a lot of output, read to the end
        many : string = "seq 1 5000";
        if(on_windows()) { many = "for /L %i in (1,1,5000) do @echo %i"; }
        counter := subprocess.start(many);
        lines : decimal = 0;
        last : string = "";
        while(true) {
            line := counter.read_line();
            if(line == null) { break; }
            lines++;
            last = io_strings.trim(line!!);
        }
        test("5000 lines read while the program runs") { expect(lines).should_be(5000); };
        test("... the last one") { expect(last).should_be("5000"); };
        counter.wait();
        counter.close();

        // ---- a program that is stopped from here
        waiting := subprocess.start(echo_back());
        test("it runs") { expect_true(waiting.is_running()); };
        waiting.kill();
        test("after kill it ends") { expect_true(waiting.wait_for(5000)); };
        test("... not with 0") { expect_true(waiting.exit_code() != 0); };
        waiting.kill();
        waiting.close();

        // ---- a command the shell does not know: the shell starts, says so, and ends with its own code
        unknown := subprocess.start("this_command_does_not_exist_12345");
        said : string = unknown.read_all_error_text();
        test("an unknown command: the shell's message") { expect_true(sizeof(said.data) > 0); };
        test("... and not exit code 0") { expect_true(unknown.wait() != 0); };
        unknown.close();

        // ---- the environment reaches it
        environment.put("SHARP_SUITE_SUBPROCESS", "handed on");
        shown : string = "echo $$SHARP_SUITE_SUBPROCESS";
        if(on_windows()) { shown = "echo %SHARP_SUITE_SUBPROCESS%"; }
        heir := subprocess.start(shown);
        test("the program sees this program's environment") { expect(io_strings.trim(heir.read_all_text())).should_be("handed on"); };
        heir.wait();
        heir.close();
        environment.remove("SHARP_SUITE_SUBPROCESS");
    };
    finish_tests("lib_system_subprocess");
}
