mod main;

import ( testing )

/**
 * Comparing numbers: == != < > <= >=
 * A comparison gives 1 (true) or 0 (false). The result can be used in an
 * if, stored in a variable, returned from a function and used in arithmetic.
 */

def less(a: decimal, b: decimal): decimal { return a < b; }
def same(a: decimal, b: decimal): decimal { return a == b; }
def at_least(a: decimal, b: decimal): decimal { return a >= b; }

/** the larger of two numbers */
def max(a: decimal, b: decimal): decimal {
    if(a > b) {
        return a;
    }
    return b;
}

def main(args: string[]) {
    // ---- literals
    expect_true("3 == 3", 3 == 3);
    expect_false("3 == 4", 3 == 4);
    expect_true("3 != 4", 3 != 4);
    expect_false("3 != 3", 3 != 3);
    expect_true("3 < 4", 3 < 4);
    expect_false("4 < 3", 4 < 3);
    expect_false("3 < 3", 3 < 3);
    expect_true("4 > 3", 4 > 3);
    expect_false("3 > 4", 3 > 4);
    expect_false("3 > 3", 3 > 3);
    expect_true("3 <= 4", 3 <= 4);
    expect_true("3 <= 3", 3 <= 3);
    expect_false("4 <= 3", 4 <= 3);
    expect_true("4 >= 3", 4 >= 3);
    expect_true("3 >= 3", 3 >= 3);
    expect_false("3 >= 4", 3 >= 4);

    // ---- variables
    a : decimal = 10;
    b : decimal = 20;
    c : decimal = 10;
    expect_true("a == c", a == c);
    expect_false("a == b", a == b);
    expect_true("a != b", a != b);
    expect_false("a != c", a != c);
    expect_true("a < b", a < b);
    expect_false("b < a", b < a);
    expect_false("a < c", a < c);
    expect_true("b > a", b > a);
    expect_false("a > b", a > b);
    expect_false("a > c", a > c);
    expect_true("a <= b", a <= b);
    expect_true("a <= c", a <= c);
    expect_false("b <= a", b <= a);
    expect_true("b >= a", b >= a);
    expect_true("a >= c", a >= c);
    expect_false("a >= b", a >= b);

    // ---- a variable against itself, and against a literal
    expect_true("a == a", a == a);
    expect_false("a != a", a != a);
    expect_false("a < a", a < a);
    expect_true("a <= a", a <= a);
    expect_true("a == 10", a == 10);
    expect_true("10 == a", 10 == a);
    expect_true("a < 11", a < 11);
    expect_true("9 < a", 9 < a);

    // ---- negative numbers
    n : decimal = 0 - 5;
    m : decimal = 0 - 2;
    expect_true("-5 < -2", n < m);
    expect_false("-5 > -2", n > m);
    expect_true("-5 < 0", n < 0);
    expect_true("-2 <= -2", m <= 0 - 2);
    expect_true("-5 != 5", n != 5);
    expect_true("-5 == -5", n == -5);
    expect_true("-1 < 1", -1 < 1);
    expect_true("-1 > -2", -1 > -2);
    expect_true("0 > -1", 0 > -1);
    expect_true("-0 == 0", -0 == 0);

    // ---- fractions
    half : decimal = 0.5;
    third : decimal = 1.0 / 3;
    expect_true("0.5 == 1.0 / 2", half == 1.0 / 2);
    expect_true("0.5 > 1 / 3", half > third);
    expect_true("1 / 3 < 0.34", third < 0.34);
    expect_true("1 / 3 > 0.33", third > 0.33);
    expect_true("0.1 < 0.2", 0.1 < 0.2);
    expect_true("2.5 >= 2.5", 2.5 >= 2.5);
    expect_true("2.4999 < 2.5", 2.4999 < 2.5);
    expect_false("2.5001 <= 2.5", 2.5001 <= 2.5);
    expect_true("1.0 == 1", 1.0 == 1);
    expect_true("-0.5 < -0.25", 0 - half < 0 - 0.25);
    expect_true("0.001 != 0.0011", 0.001 != 0.0011);

    // ---- large numbers
    big : decimal = 1000000000000;
    expect_true("a trillion < a trillion and one", big < big + 1);
    expect_true("a trillion == 1e12", big == 1e12);
    expect_false("a trillion > 1e12", big > 1e12);

    // ---- the result is a number: 1 or 0
    expect("3 < 4 is 1", 3 < 4, 1);
    expect("4 < 3 is 0", 4 < 3, 0);
    expect("a == c is 1", a == c, 1);
    expect("a == b is 0", a == b, 0);
    expect("counting true comparisons", ((a < b) as _int32) + ((b < a) as _int32) + ((a == c) as _int32) + ((a != c) as _int32), 2);
    expect("multiplying by a comparison", 7 * ((a < b) as _int32), 7);

    // ---- stored in a variable
    smaller : decimal = a < b;
    equal : decimal = a == b;
    expect("smaller", smaller, 1);
    expect("equal", equal, 0);
    smaller = b < a;
    expect("smaller, assigned again", smaller, 0);
    answer : bool = a < b;
    expect("in a bool object", answer, 1);

    // ---- used in an if
    if(a < b) {
        pass("if(a < b)");
    } else {
        fail("if(a < b)", "the else branch ran");
    }
    if(a > b) {
        fail("if(a > b)", "the if branch ran");
    } else {
        pass("if(a > b)");
    }
    if(a == c) {
        pass("if(a == c)");
    } else {
        fail("if(a == c)", "the else branch ran");
    }
    if(a != c) {
        fail("if(a != c)", "the if branch ran");
    }
    if(smaller) {
        fail("if(smaller)", "a stored false ran the if branch");
    }
    if(n >= m) {
        fail("if(-5 >= -2)", "the if branch ran");
    } else {
        pass("if(-5 >= -2)");
    }

    // ---- arithmetic happens before the comparison
    expect_true("1 + 2 < 4", 1 + 2 < 4);
    expect_true("2 * 3 == 6", 2 * 3 == 6);
    expect_true("a + 10 == b", a + 10 == b);
    expect_true("b - a >= a", b - a >= a);
    expect_true("a * 2 <= b", a * 2 <= b);
    expect_false("a + 1 < c", a + 1 < c);
    expect_true("b / 4 > a / 4", b / 4 > a / 4);
    expect_true("17 % 5 == 2", 17 % 5 == 2);

    // ---- < and > happen before == and !=
    expect_true("1 < 2 == true", 1 < 2 == true);
    expect_true("a < b != b < a", a < b != b < a);
    expect_true("(a < b) == (n < m)", (a < b) == (n < m));

    // ---- through functions
    expect("less(1, 2)", less(1, 2), 1);
    expect("less(2, 1)", less(2, 1), 0);
    expect("less(2, 2)", less(2, 2), 0);
    expect("same(7, 7)", same(7, 7), 1);
    expect("same(7, 7.5)", same(7, 7.5), 0);
    expect("at_least(3, 3)", at_least(3, 3), 1);
    expect("at_least(2, 3)", at_least(2, 3), 0);
    expect("max(3, 9)", max(3, 9), 9);
    expect("max(9, 3)", max(9, 3), 9);
    expect("max(-3, -9)", max(0 - 3, 0 - 9), 0 - 3);
    expect("max(2.5, 2.25)", max(2.5, 2.25), 2.5);

    // ---- characters compare as numbers
    expect_true("'a' < 'b'", 'a' < 'b');
    expect_true("'a' == 97", 'a' == 97);
    expect_true("'A' != 'a'", 'A' != 'a');

    // ---- number objects (int) compare too; the answer is a bool object
    i : int = 3;
    j : int = 5;
    expect("int < int", (i < j), 1);
    expect("int > int", (i > j), 0);
    expect("int == int", (i == j), 0);
    expect("int != int", (i != j), 1);
    expect("int <= int", (i <= j), 1);
    expect("int >= int", (i >= j), 0);
    if(i < j) {
        pass("if(int < int)");
    } else {
        fail("if(int < int)", "the else branch ran");
    }

    finish("comparison");
}
