mod main;
import ( testing )
def main(args: string[]) {
    price := "cost: $5";
    expect("dollar in a literal", price.size(), 8);
    name := "x";
    expect_str("interpolation still works", "a $name b", "a x b");
    expect_str("dollar at the end", "5$", "5" + "$$");
    finish("strings_dollar_sign");
}
