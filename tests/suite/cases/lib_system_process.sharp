mod main;

import ( std.testing, std.io, std.system )

/**
 * std.system process (running shell commands, exit codes, captured
 * output, input, environment) and platform_info, and std ansi / console
 * (the parts that do not need a person at the keyboard).
 *
 * The commands are those of the system's shell: plain POSIX shell (echo,
 * printf, cat, exit, test) in test_process, cmd.exe's in test_process_windows.
 * Works only inside /tmp/sharp_suite_io_process (on windows:
 * sharp_suite_io_process in the directory for temporary files) and removes it
 * at the end.
 */

/** is this windows? (its paths are written with back slashes) */
def on_windows(): bool {
    return file.separator_char() != '/';
}

/** `path`, written with slashes here, the way this system writes it */
def os(path: string): string {
    return io_strings.replace_char(path, '/', file.separator_char());
}

/** the folder this test works in: below /tmp, or on windows below the directory for temporary files */
def suite_dir(name: string): string {
    return on_windows() ? os(temp_files.directory() + "/" + name) : "/tmp/" + name;
}

base_dir : string = suite_dir("sharp_suite_io_process");

/** a dollar sign (it cannot be written inside a string literal, where it starts an interpolation) */
def dollar(): string {
    return io_strings.from_char(36);
}

def esc(): string {
    return io_strings.from_char(27);
}

def test_process() {
    r := process.run("echo hello");
    test("exit code 0") { expect(r.exit_code()).should_be(0); };
    test("succeeded") { expect_true(r.succeeded()); };
    test("output") { expect(r.output()).should_be("hello\n"); };
    test("output_trimmed") { expect(r.output_trimmed()).should_be("hello"); };
    test("no error output") { expect(r.error_output()).should_be(""); };
    test("command") { expect(r.command()).should_be("echo hello"); };
    test("check returns the result") { expect_true(r.check().succeeded()); };

    r = process.run("exit 3");
    test("exit code 3") { expect(r.exit_code()).should_be(3); };
    test("not succeeded") { expect_false(r.succeeded()); };
    test("no output") { expect(r.output()).should_be(""); };
    test("no output lines") { expect(r.output_lines().size().value).should_be(0); };
    try { r.check(); test("check on failure") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("check message names the code") { expect_true(io_strings.contains(e.get_message(), "exit code 3")); }; }
    test("exit code 255") { expect(process.run("exit 255").exit_code()).should_be(255); };
    test("false is 1") { expect(process.run("false").exit_code()).should_be(1); };

    r = process.run("echo out; echo err 1>&2; exit 2");
    test("stdout apart") { expect(r.output()).should_be("out\n"); };
    test("stderr apart") { expect(r.error_output()).should_be("err\n"); };
    test("code with both") { expect(r.exit_code()).should_be(2); };
    r = process.run_merged("echo out; echo err 1>&2");
    test("merged output") { expect(r.output()).should_be("out\nerr\n"); };
    test("merged: no separate error output") { expect(r.error_output()).should_be(""); };

    r = process.run("printf 'a\\nb\\n\\nc'");
    lines := r.output_lines();
    test("output_lines") { expect(lines.size().value).should_be(4); };
    test("line 0") { expect(lines.at(0)).should_be("a"); };
    test("empty line") { expect(lines.at(2)).should_be(""); };
    test("last line without newline") { expect(lines.at(3)).should_be("c"); };

    r = process.run("this_command_does_not_exist_12345");
    test("command not found") { expect(r.exit_code()).should_be(127); };
    test("...with a message on stderr") { expect_true(io_strings.length(r.error_output()) > 0); };
    test("killed by a signal") { expect(process.run("kill -9 " + dollar() + dollar()).exit_code()).should_be(137); };
    r = process.run("echo one && echo two | tr a-z A-Z; test -d /");
    test("pipes and &&") { expect(r.output()).should_be("one\nTWO\n"); };
    test("status of the last command") { expect(r.exit_code()).should_be(0); };

    // input
    r = process.run_with_input("cat", "fed in\nline 2\n");
    test("input passed through") { expect(r.output()).should_be("fed in\nline 2\n"); };
    r = process.run_with_input("wc -c", "12345");
    test("input length") { expect(r.output_trimmed()).should_be("5"); };
    r = process.run_with_input("cat", "");
    test("empty input") { expect(r.output()).should_be(""); };

    // quoting
    odd : string = "it's a \"test\" & more; `x` \\ end";
    r = process.run("printf '%s' " + process.quote(odd));
    test("quoted argument arrives unchanged") { expect(r.output()).should_be(odd); };
    test("quote plain") { expect(process.quote("plain")).should_be("'plain'"); };
    test("quote empty") { expect(process.quote("")).should_be("''"); };
    spaced := new file(base_dir + "/dir with space/file name.txt");
    spaced.parent()!!.mkdirs();
    spaced.write_text("content\n");
    r = process.run("cat " + process.quote(spaced.get_path()));
    test("path with spaces") { expect(r.output()).should_be("content\n"); };

    // a command that writes a file, and larger output
    r = process.run("echo written > " + process.quote(base_dir + "/made.txt"));
    test("file made by a command") { expect(new file(base_dir + "/made.txt").read_text()).should_be("written\n"); };
    r = process.run("seq 0 1999 | sed s/^/line./");
    test("2000 lines captured") { expect(r.output_lines().size().value).should_be(2000); };
    test("last captured line") { expect(r.output_lines().at(1999)).should_be("line.1999"); };

    test("execute") { expect(process.execute("exit 4")).should_be(4); };
    test("execute success") { expect(process.execute("true")).should_be(0); };

    // environment
    test("PATH is set") { expect_true(!io_strings.is_null(process.environment("PATH"))); };
    test("unset variable is null") { expect_true(io_strings.is_null(process.environment("SHARP_SUITE_NO_SUCH_VARIABLE"))); };
    try { process.environment("BAD NAME"); test("bad variable name") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("bad variable name") { }; }
    try { process.environment(""); test("empty variable name") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("empty variable name") { }; }
    r = process.run("SHARP_SUITE_VAR='some value' sh -c 'printf %s " + io_strings.from_char(34) + dollar() + "SHARP_SUITE_VAR" + io_strings.from_char(34) + "'");
    test("variables reach child commands") { expect(r.output()).should_be("some value"); };
    test("command_exists sh") { expect_true(process.command_exists("sh")); };
    test("command_exists nonsense") { expect_false(process.command_exists("this_command_does_not_exist_12345")); };

    // nothing is left behind in the temporary directory
    left : decimal = 0;
    temp_dir := new file(temp_files.directory());
    temp_names := temp_dir.list_names();
    foreach(name in temp_names) {
        if(io_strings.starts_with(name, "sharp_proc_")) {
            left++;
        }
    }
    test("capture files are deleted") { expect(left).should_be(0); };
}

/**
 * The same as test_process, with the commands of cmd.exe. What differs from a unix shell: lines
 * end with "\r\n", echo prints the blank that stands before a redirection or an &, a command that
 * is not found is exit code 1, and an argument is quoted with double quotes.
 */
def test_process_windows() {
    r := process.run("echo hello");
    test("exit code 0") { expect(r.exit_code()).should_be(0); };
    test("succeeded") { expect_true(r.succeeded()); };
    test("output") { expect(r.output()).should_be("hello\r\n"); };
    test("output_trimmed") { expect(r.output_trimmed()).should_be("hello"); };
    test("no error output") { expect(r.error_output()).should_be(""); };
    test("command") { expect(r.command()).should_be("echo hello"); };
    test("check returns the result") { expect_true(r.check().succeeded()); };

    r = process.run("exit 3");
    test("exit code 3") { expect(r.exit_code()).should_be(3); };
    test("not succeeded") { expect_false(r.succeeded()); };
    test("no output") { expect(r.output()).should_be(""); };
    test("no output lines") { expect(r.output_lines().size().value).should_be(0); };
    try { r.check(); test("check on failure") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("check message names the code") { expect_true(io_strings.contains(e.get_message(), "exit code 3")); }; }
    test("exit code 255") { expect(process.run("exit 255").exit_code()).should_be(255); };

    r = process.run("echo out& echo err 1>&2& exit 2");
    test("stdout apart") { expect(r.output()).should_be("out\r\n"); };
    test("stderr apart") { expect(io_strings.trim(r.error_output())).should_be("err"); };
    test("code with both") { expect(r.exit_code()).should_be(2); };
    r = process.run_merged("echo out& echo err 1>&2");
    merged := r.output_lines();
    test("merged output") { expect(merged.size().value).should_be(2); };
    test("merged: first line") { expect(merged.at(0)).should_be("out"); };
    test("merged: second line") { expect(io_strings.trim(merged.at(1))).should_be("err"); };
    test("merged: no separate error output") { expect(r.error_output()).should_be(""); };

    r = process.run("echo a& echo b& echo.& echo c");
    lines := r.output_lines();
    test("output_lines") { expect(lines.size().value).should_be(4); };
    test("line 0") { expect(lines.at(0)).should_be("a"); };
    test("empty line") { expect(lines.at(2)).should_be(""); };
    test("last line") { expect(lines.at(3)).should_be("c"); };

    r = process.run("this_command_does_not_exist_12345");
    test("command not found") { expect(r.exit_code()).should_be(1); };
    test("...with a message on stderr") { expect_true(io_strings.length(r.error_output()) > 0); };
    r = process.run("echo one&& echo abc | findstr b");
    test("pipes and &&") { expect(r.output()).should_be("one\r\nabc \r\n"); };
    test("status of the last command") { expect(r.exit_code()).should_be(0); };
    // (a variable with a bracket in it: once the reason every command with one failed)
    test("a bracket in the command") { expect(process.run("echo (x86) done").output_trimmed()).should_be("(x86) done"); };

    // input
    r = process.run_with_input("findstr x", "x1\ny\nx2\n");
    fed := r.output_lines();
    test("input passed through") { expect(fed.size().value).should_be(2); };
    test("input: the lines asked for") { expect(fed.at(0) + " " + fed.at(1)).should_be("x1 x2"); };
    r = process.run_with_input("findstr e", "one\ntwo\nthree\n");
    test("input: two of three lines") { expect(r.output_lines().size().value).should_be(2); };

    // quoting
    test("quote plain") { expect(process.quote("plain")).should_be(io_strings.from_char(34) + "plain" + io_strings.from_char(34)); };
    test("quote empty") { expect(process.quote("")).should_be(io_strings.from_char(34) + io_strings.from_char(34)); };
    spaced := new file(base_dir + "/dir with space/file name.txt");
    spaced.parent()!!.mkdirs();
    spaced.write_text("content\n");
    r = process.run("type " + process.quote(spaced.get_path()));
    test("path with spaces") { expect(r.output()).should_be("content\n"); };

    // a command that writes a file, and larger output
    r = process.run("echo written> " + process.quote(base_dir + "/made.txt"));
    test("file made by a command") { expect(new file(base_dir + "/made.txt").read_text()).should_be("written\r\n"); };
    r = process.run("for /L %i in (0,1,1999) do @echo line.%i");
    test("2000 lines captured") { expect(r.output_lines().size().value).should_be(2000); };
    test("last captured line") { expect(r.output_lines().at(1999)).should_be("line.1999"); };

    test("execute") { expect(process.execute("exit 4")).should_be(4); };
    test("execute success") { expect(process.execute("exit 0")).should_be(0); };

    // environment
    test("PATH is set") { expect_true(!io_strings.is_null(process.environment("PATH"))); };
    test("unset variable is null") { expect_true(io_strings.is_null(process.environment("SHARP_SUITE_NO_SUCH_VARIABLE"))); };
    try { process.environment("BAD NAME"); test("bad variable name") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("bad variable name") { }; }
    try { process.environment(""); test("empty variable name") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("empty variable name") { }; }
    test("command_exists cmd") { expect_true(process.command_exists("cmd")); };
    test("command_exists nonsense") { expect_false(process.command_exists("this_command_does_not_exist_12345")); };

    // nothing is left behind in the temporary directory
    left : decimal = 0;
    temp_dir := new file(temp_files.directory());
    temp_names := temp_dir.list_names();
    foreach(name in temp_names) {
        if(io_strings.starts_with(name, "sharp_proc_")) {
            left++;
        }
    }
    test("capture files are deleted") { expect(left).should_be(0); };
}

def test_platform() {
    windows : bool = on_windows();
    test("is_windows") { expect(platform_info.is_windows()).should_be(windows); };
    test("is_unix") { expect(platform_info.is_unix()).should_be(!windows); };
    test("os_name") { expect(platform_info.os_name()).should_be(windows ? "windows" : "unix"); };
    test("os_id") { expect(platform_info.os_id()).should_be(windows ? "win" : "posix"); };
    test("processor_count") { expect_true(platform_info.processor_count() >= 1); };
    test("path_separator") { expect(platform_info.path_separator()).should_be(windows ? '\\' : '/'); };
    test("path_list_separator") { expect(platform_info.path_list_separator()).should_be(windows ? ';' : ':'); };
    test("line_separator") { expect(platform_info.line_separator()).should_be(windows ? "\r\n" : "\n"); };
    test("current_directory is absolute") { expect_true(new file(platform_info.current_directory()).is_absolute()); };
    test("temp_directory exists") { expect_true(new file(platform_info.temp_directory()).is_directory()); };
    test("app_name") { expect_true(io_strings.length(platform_info.app_name()) > 0); };
    test("app_version") { expect_true(io_strings.length(platform_info.app_version()) > 0); };
    test("platform_version") { expect_true(io_strings.length(platform_info.platform_version()) > 0); };
    test("environment_or fallback") { expect(platform_info.environment_or("SHARP_SUITE_NO_SUCH_VARIABLE", "dflt")).should_be("dflt"); };
    test("environment_or set") { expect_true(io_strings.length(platform_info.environment_or("PATH", "")) > 0); };
    home := platform_info.home_directory();
    test("home_directory is HOME") { expect(home).should_be(platform_info.environment_or(windows ? "USERPROFILE" : "HOME", "")); };
    test("home_directory is remembered") { expect(platform_info.home_directory()).should_be(home); };
    test("host_name is what hostname prints") { expect(platform_info.host_name()).should_be(process.run("hostname").output_trimmed()); };
    if(windows) {
        test("user_name is USERNAME") { expect(platform_info.user_name()).should_be(platform_info.environment_or("USERNAME", "")); };
    } else {
        test("user_name is USER or LOGNAME") { expect(platform_info.user_name()).should_be(platform_info.environment_or("USER", platform_info.environment_or("LOGNAME", ""))); };
    }
    test("free_disk_space") { expect_true(platform_info.free_disk_space() > 0); };
    test("total_disk_space is at least the free space") { expect_true(platform_info.total_disk_space() >= platform_info.free_disk_space()); };
    test("summary") { expect_true(io_strings.starts_with(platform_info.summary(), windows ? "windows, " : "unix, ")); };
}

def test_ansi_console() {
    e := esc();
    test("enabled by default") { expect_true(ansi.is_enabled()); };
    test("foreground") { expect(ansi.foreground(ansi.red)).should_be(e + "[31m"); };
    test("foreground bright") { expect(ansi.foreground(ansi.bright_blue)).should_be(e + "[94m"); };
    test("foreground black") { expect(ansi.foreground(ansi.black)).should_be(e + "[30m"); };
    test("background") { expect(ansi.background(ansi.green)).should_be(e + "[42m"); };
    test("background bright") { expect(ansi.background(ansi.bright_white)).should_be(e + "[107m"); };
    test("style") { expect(ansi.style(ansi.bold)).should_be(e + "[1m"); };
    test("reset") { expect(ansi.reset()).should_be(e + "[0m"); };
    test("colored") { expect(ansi.colored("hi", ansi.yellow)).should_be(e + "[33mhi" + e + "[0m"); };
    test("colored on background") { expect(ansi.colored("hi", ansi.white, ansi.blue)).should_be(e + "[37m" + e + "[44mhi" + e + "[0m"); };
    test("styled") { expect(ansi.styled("hi", ansi.underline)).should_be(e + "[4mhi" + e + "[0m"); };
    test("clear_screen") { expect(ansi.clear_screen()).should_be(e + "[2J" + e + "[H"); };
    test("clear_line") { expect(ansi.clear_line()).should_be(e + "[2K\r"); };
    test("move_to") { expect(ansi.move_to(3, 14)).should_be(e + "[3;14H"); };
    test("cursor hidden") { expect(ansi.cursor_visible(false)).should_be(e + "[?25l"); };
    test("cursor shown") { expect(ansi.cursor_visible(true)).should_be(e + "[?25h"); };
    test("strip") { expect(ansi.strip(ansi.colored("plain", ansi.red) + " and " + ansi.styled("bold", ansi.bold))).should_be("plain and bold"); };
    test("strip without codes") { expect(ansi.strip("nothing here [31m")).should_be("nothing here [31m"); };
    test("strip cursor codes") { expect(ansi.strip("a" + ansi.move_to(1, 1) + "b" + ansi.clear_screen() + "c")).should_be("abc"); };
    try { ansi.foreground(16); test("colour 16") { fail_test("no exception"); }; }
    catch(e1: illegal_argument_exception) { test("colour 16") { }; }
    try { ansi.background(0 - 1); test("negative colour") { fail_test("no exception"); }; }
    catch(e2: illegal_argument_exception) { test("negative colour") { }; }
    try { ansi.colored("x", 2.5); test("fractional colour") { fail_test("no exception"); }; }
    catch(e3: illegal_argument_exception) { test("fractional colour") { }; }
    try { ansi.move_to(0, 1); test("row 0") { fail_test("no exception"); }; }
    catch(e4: illegal_argument_exception) { test("row 0") { }; }

    ansi.set_enabled(false);
    test("disabled") { expect_false(ansi.is_enabled()); };
    test("colored when disabled") { expect(ansi.colored("hi", ansi.red)).should_be("hi"); };
    test("colored on background when disabled") { expect(ansi.colored("hi", ansi.red, ansi.blue)).should_be("hi"); };
    test("styled when disabled") { expect(ansi.styled("hi", ansi.bold)).should_be("hi"); };
    test("foreground when disabled") { expect(ansi.foreground(ansi.red)).should_be(""); };
    test("reset when disabled") { expect(ansi.reset()).should_be(""); };
    test("clear_screen when disabled") { expect(ansi.clear_screen()).should_be(""); };
    test("clear_line when disabled") { expect(ansi.clear_line()).should_be(""); };
    test("move_to when disabled") { expect(ansi.move_to(1, 1)).should_be(""); };

    // console output helpers: with codes switched off they print plain text or nothing
    console.print_text("");
    console.clear();
    console.clear_line();
    console.move_cursor(1, 1);
    console.new_lines(0);
    console.print_colored("", ansi.red);
    test("console helpers print nothing visible when there is nothing to print") { };
    ansi.set_enabled(true);
    test("enabled again") { expect_true(ansi.is_enabled()); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_system_process") {
        start := new file(base_dir);
        start.delete_recursively();
        test("test directory created") { expect_true(start.mkdirs()); };

        if(on_windows()) {
            test_process_windows();
        } else {
            test_process();
        }
        test_platform();
        test_ansi_console();

        test("cleanup") { expect_true(start.delete_recursively()); };
    };
    finish_tests("lib_system_process");
}
