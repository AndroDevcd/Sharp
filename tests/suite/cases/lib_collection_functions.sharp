mod main;

import ( std.testing, std.io, std.collections, std.text )

/**
 * std collection_functions.sharp: filter, map, sorted_by, group_by and the
 * rest, called on a list with the block behind the call.
 */

class person {
    name : string = "";
    age : _int64 = 0;
    city : string = "";
    person(name: string, age: _int64, city: string) { self->name = name; self->age = age; self->city = city; }
}

def numbers(from: _int64, to: _int64) : list<int> {
    made := new list<int>();
    for(i : _int64 = from; i <= to; i++) { made.add(i); }
    return made;
}

def shown(items: list<int>) : string { return items.join_to_string(" "); }
def names(people: list<person>) : string { return people.join_to_string(" ") { it.name }; }

def main(args: string[]) {
    show_only_failures();
    tests("lib_collection_functions") {
        people := new list<person>();
        people.add(new person("ann", 31, "oslo"));
        people.add(new person("bob", 17, "rome"));
        people.add(new person("cy", 45, "oslo"));
        people.add(new person("dee", 17, "bern"));
        six := numbers(1, 6);
        nobody := new list<person>();

        // keeping some
        test("filter") { expect(names(people.filter { it.age >= 18 })).should_be("ann cy"); };
        test("filter_not") { expect(names(people.filter_not { it.age >= 18 })).should_be("bob dee"); };
        test("filter_indexed") { expect(shown(six.filter_indexed { at, n -> at % 2 == 0 })).should_be("1 3 5"); };
        test("filter of nothing") { expect(nobody.filter { it.age > 1 }.size()).should_be(0); };
        halves := six.partition { it.value > 4 };
        test("partition") { expect(shown(halves.first) + " | " + shown(halves.second)).should_be("5 6 | 1 2 3 4"); };
        twice := numbers(1, 3).plus(numbers(2, 4));
        test("distinct") { expect(shown(twice.distinct())).should_be("1 2 3 4"); };
        test("distinct_by") { expect(names(people.distinct_by<string>() { it.city })).should_be("ann bob dee"); };

        // parts
        test("take") { expect(shown(six.take(2))).should_be("1 2"); };
        test("take more than there is") { expect(shown(six.take(20))).should_be("1 2 3 4 5 6"); };
        test("take_last") { expect(shown(six.take_last(2))).should_be("5 6"); };
        test("drop") { expect(shown(six.drop(4))).should_be("5 6"); };
        test("drop_last") { expect(shown(six.drop_last(4))).should_be("1 2"); };
        test("drop_last of a negative count drops nothing") { expect(shown(six.drop_last(0 - 1))).should_be(shown(six)); };
        test("take_while") { expect(shown(six.take_while { it.value < 3 })).should_be("1 2"); };
        test("take_last_while") { expect(shown(six.take_last_while { it.value > 4 })).should_be("5 6"); };
        test("drop_while") { expect(shown(six.drop_while { it.value < 5 })).should_be("5 6"); };
        test("drop_last_while") { expect(shown(six.drop_last_while { it.value > 2 })).should_be("1 2"); };
        test("slice") { expect(shown(six.slice(1, 3))).should_be("2 3"); };

        // one element
        test("first with a block") { expect(people.first { it.age < 18 }.name).should_be("bob"); };
        test("last with a block") { expect(people.last { it.age < 18 }.name).should_be("dee"); };
        test("first without one is the list's own") { expect(people.first().name).should_be("ann"); };
        test("first_or_null") { expect_true(nobody.first_or_null() == null && people.first_or_null()!!.name == "ann"); };
        test("last_or_null") { expect_true(nobody.last_or_null() == null && people.last_or_null()!!.name == "dee"); };
        test("find") { expect_true(people.find { it.age > 40 }!!.name == "cy" && people.find { it.age > 90 } == null); };
        test("find_last") { expect(people.find_last { it.city == "oslo" }!!.name).should_be("cy"); };
        none_found : decimal = 0;
        try { people.first { it.age > 90 }; } catch(missing: no_such_element_exception) { none_found = 1; }
        test("first: none is an exception") { expect_true(none_found); };
        test("only") { expect(numbers(7, 7).only().value).should_be(7); };
        test("only_or_null") { expect_true(six.only_or_null() == null && people.only_or_null { it.age == 45 }!!.name == "cy" && people.only_or_null { it.age == 17 } == null); };
        test("at_or_null") { expect_true(six.at_or_null(9) == null && six.at_or_null(1)!!.value == 2); };
        test("at_or") { expect(six.at_or(9, 0).value).should_be(0); };
        test("random") { expect_true(six.contains(six.random()) && nobody.random_or_null() == null); };
        test("index_of_first, index_of_last") { expect_true(people.index_of_first { it.age == 17 } == 1 && people.index_of_last { it.age == 17 } == 3 && people.index_of_first { it.age == 1 } == 0 - 1); };

        // questions
        test("any, all, none") { expect_true(people.any { it.age < 18 } && !people.all { it.age < 18 } && people.none { it.age > 90 }); };
        test("without a block") { expect_true(people.any() && nobody.none() && people.is_not_empty() && !nobody.is_not_empty()); };
        test("all of nothing") { expect_true(nobody.all { it.age > 90 }); };
        test("contains_all") { expect_true(six.contains_all(numbers(2, 4)) && !six.contains_all(numbers(5, 8))); };

        // numbers
        test("count") { expect_true(people.count() == 4 && people.count { it.city == "oslo" } == 2); };
        test("sum_of") { expect_true(people.sum_of { it.age } == 110); };
        test("average_of") { expect_true(people.average_of { it.age } == 27.5 && nobody.average_of { it.age } == 0); };
        test("min_of, max_of") { expect_true(people.min_of { it.age } == 17 && people.max_of { it.age } == 45); };
        test("min_by, max_by") { expect(people.min_by { it.age }.name + people.max_by { it.age }.name).should_be("bobcy"); };
        test("max_by_or_null") { expect_true(nobody.max_by_or_null { it.age } == null && nobody.min_by_or_null { it.age } == null); };
        test("min_with, max_with") {
            expect(people.min_with_or_null { a, b -> a.name.size() - b.name.size() }!!.name
                + people.max_with_or_null { a, b -> a.age - b.age }!!.name).should_be("cycy");
        };
        test("sum, average, min, max of numbers") { expect_true(six.sum() == 21 && six.average() == 3.5 && six.min() == 1 && six.max() == 6); };

        // order
        test("sorted_by") { expect(names(people.sorted_by { it.age })).should_be("bob dee ann cy"); };
        test("sorted_by_descending") { expect(names(people.sorted_by_descending { it.age })).should_be("cy ann bob dee"); };
        test("sorted_by_text") { expect(names(people.sorted_by_text { it.city })).should_be("dee ann cy bob"); };
        test("sorted_by_text_descending") { expect(names(people.sorted_by_text_descending { it.city })).should_be("bob ann cy dee"); };
        test("sorted_with") { expect(names(people.sorted_with { a, b -> b.age - a.age })).should_be("cy ann bob dee"); };
        test("the list itself keeps its order") { expect(names(people)).should_be("ann bob cy dee"); };
        test("reversed") { expect(shown(six.reversed())).should_be("6 5 4 3 2 1"); };
        test("sorted numbers") { expect(shown(six.reversed().sorted()) + " " + shown(numbers(1, 3).sorted_descending())).should_be("1 2 3 4 5 6 3 2 1"); };
        words := new list<string>();
        words.add("pear"); words.add("apple"); words.add("fig");
        test("sorted texts") { expect(words.sorted().join_to_string(" ") + " " + words.sorted_descending().join_to_string(" ")).should_be("apple fig pear pear fig apple"); };
        test("is_sorted_by") { expect_true(six.is_sorted_by { it.value } && !people.is_sorted_by { it.age }); };
        mixed := numbers(1, 40).shuffled();
        test("shuffled: the same elements") { expect_true(mixed.size() == 40 && mixed.sum() == 820 && shown(mixed.sorted()) == shown(numbers(1, 40))); };
        hundred := numbers(1, 300).reversed();
        test("a long list sorted") { expect_true(hundred.sorted().is_sorted_by { it.value } && hundred.sorted().first().value == 1); };

        // with other collections
        test("plus") { expect(shown(numbers(1, 2).plus(numbers(5, 6)))).should_be("1 2 5 6"); };
        test("plus_one, minus_one") { expect(shown(numbers(1, 3).plus_one(9).minus_one(2))).should_be("1 3 9"); };
        test("minus") { expect(shown(six.minus(numbers(2, 5)))).should_be("1 6"); };
        test("intersect") { expect(shown(six.intersect(numbers(5, 9)))).should_be("5 6"); };
        test("union") { expect(shown(numbers(1, 3).union(numbers(2, 5)))).should_be("1 2 3 4 5"); };
        test("zip") { expect(words.zip<int>(six).join_to_string(" ") { it.first + it.second }).should_be("pear1 apple2 fig3"); };
        test("to_list is a list of its own") {
            copy := six.to_list();
            copy.add(7);
            expect_true(copy.size() == 7 && six.size() == 6);
        };

        // other things made of the elements
        test("map") { expect(people.map<string>() { it.name + it.age }.join_to_string(" ")).should_be("ann31 bob17 cy45 dee17"); };
        test("map to numbers") { expect(people.map<int>() { new int(it.age) }.sum()).should_be(110); };
        test("map_indexed") { expect(words.map_indexed<string>() { at, word -> "" + at + word }.join_to_string(" ")).should_be("0pear 1apple 2fig"); };
        test("map_not_null") {
            found := people.map_not_null<string>() { grown: person -> (string?) if(grown.age < 18) { return null; } return grown.name; };
            expect(found.join_to_string(" ")).should_be("ann cy");
        };
        test("flat_map") { expect(shown(numbers(1, 3).flat_map<int>() { numbers(1, it.value) })).should_be("1 1 2 1 2 3"); };
        test("first_not_null_of") {
            found := people.first_not_null_of<string>() { grown: person -> (string?) if(grown.age < 40) { return null; } return grown.city; };
            expect(found!!).should_be("oslo");
        };
        test("fold") { expect(people.fold<string>("") { so_far, next -> so_far + next.name.at(0) }).should_be("abcd"); };
        test("fold_right") { expect(people.fold_right<string>("") { next, so_far -> so_far + next.name.at(0) }).should_be("dcba"); };
        test("running_fold") { expect(numbers(1, 3).running_fold<string>("") { so_far, next -> so_far + next }.join_to_string("|")).should_be("|1|12|123"); };
        test("reduce") { expect(six.reduce { a, b -> new int(a.value + b.value) }.value).should_be(21); };
        test("reduce_or_null") { expect_true(nobody.reduce_or_null { a, b -> a } == null); };
        test("running_reduce") { expect(shown(numbers(1, 4).running_reduce { a, b -> new int(a.value + b.value) })).should_be("1 3 6 10"); };
        groups := people.group_by<string>() { it.city };
        test("group_by") { expect(names(groups.at("oslo")!!) + "|" + names(groups.at("rome")!!) + "|" + groups.keys().join_to_string(" ")).should_be("ann cy|bob|oslo rome bern"); };
        test("count_by") { expect_true(people.count_by<string>() { it.city }.at("oslo")!!.value == 2); };
        test("associate_by") { expect(people.associate_by<string>() { it.name }.at("cy")!!.age).should_be(45); };
        test("associate_with") { expect(words.associate_with<int>() { it.size() }.at("apple")!!.value).should_be(5); };
        test("join_to_string") { expect(six.take(3).join_to_string(", ", "[", "]")).should_be("[1, 2, 3]"); };
        test("join_to_string of an empty list") { expect(six.take(0).join_to_string(", ", "[", "]")).should_be("[]"); };

        // each
        seen := new string_builder();
        people.for_each { seen.append(it.name); };
        words.for_each_indexed { at, word -> seen.append("" + at); };
        test("for_each, for_each_indexed") { expect(seen.to_string()!!).should_be("annbobcydee012"); };

        // from an array, and the block functions of a string
        test("list_of an array") { expect(list_of<string>(" b , a ,c ".split(",")).map<string>() { it.trim() }.sorted().join_to_string("")).should_be("abc"); };
        test("list_of null") { expect(list_of<string>(null).size()).should_be(0); };
        blank : string = "  ";
        test("if_empty, if_blank") { expect(new string("").if_empty("none") + "x".if_empty("none") + blank.if_blank("blank") + "y".if_blank("blank")).should_be("nonexblanky"); };
        test("filter_chars") { expect("a1b22c".filter_chars { it >= '0' && it <= '9' }).should_be("122"); };
        test("count_chars, any_char, all_chars") { expect_true("a1b22c".count_chars { it >= '0' && it <= '9' } == 3 && "abc".any_char { it == 'b' } && !"abc".all_chars { it == 'b' }); };

        // a chain
        test("a chain") {
            expect(people.filter { it.age >= 18 }.sorted_by_descending { it.age }.map<string>() { it.name }.join_to_string(", ")).should_be("cy, ann");
        };

        // other collections have them too
        some := new hash_set<int>();
        some.add(3); some.add(4); some.add(5);
        test("a hash_set, as a list") { expect_true(some.to_list().filter { it.value > 3 }.size() == 2 && some.to_list().sum() == 12); };
        test("minus, intersect, contains_all take a set") { expect_true(shown(six.minus(some)) == "1 2 6" && shown(six.intersect(some)) == "3 4 5" && six.contains_all(some)); };
        linked := new linked_list<string>();
        linked.add("x"); linked.add("yy");
        gathered := new list<string>();
        gathered.add_every(linked);
        test("add_every from a linked_list") { expect(gathered.map<int>() { it.size() }.sum()).should_be(3); };

        // changing a list
        changed := numbers(1, 6);
        test("remove_all") { expect_true(changed.remove_all { it.value % 2 == 0 } == 3 && shown(changed) == "1 3 5"); };
        test("retain_all") { expect_true(changed.retain_all { it.value > 1 } == 1 && shown(changed) == "3 5"); };
        folk := people.to_list();
        folk.sort_by { it.age };
        test("sort_by") { expect(names(folk)).should_be("bob dee ann cy"); };
        folk.sort_by_descending { it.age };
        test("sort_by_descending") { expect(names(folk)).should_be("cy ann bob dee"); };
        folk.sort_by_text { it.name };
        test("sort_by_text") { expect(names(folk)).should_be("ann bob cy dee"); };
        deck := numbers(1, 30);
        deck.shuffle();
        test("shuffle") { expect_true(deck.sum() == 465 && deck.size() == 30); };
        deck.fill(2);
        test("fill") { expect(deck.sum()).should_be(60); };
    };
    finish_tests("lib_collection_functions");
}
