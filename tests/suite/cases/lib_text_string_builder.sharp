mod main;

import ( std.testing )

/**
 * string_builder and char_array - the rewritten core and the added operations:
 *   - std/string_builder.sharp                   append, size, to_string / build, ==, at,
 *                                                starts_with / ends_with / find, substring
 *   - std/text/builder/string_builder_edit.sharp   insert, delete, replace_range, reverse, clear,
 *                                                set_length, append_line / _int / _number / _repeat
 *   - std/text/builder/string_builder_query.sharp  length, capacity, char_at, index_of, contains, slice
 *   - std/char_array.sharp                       at, put, fill, reverse, sort, slice ...
 *
 * NEEDS the corrected std/string_builder.sharp and std/char_array.sharp (the
 * old builder counted one character too many: "abc" had size 4 and its
 * to_string() ended in a NUL character).
 */

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_string_builder") {
        // ---- the core: size and text are exact
        sb := new string_builder();
        test("a new builder is empty") { expect(sb.size().value).should_be(0); };
        test("a new builder builds \"\"") { expect(sb.build()).should_be(""); };
        test("is_empty") { expect_true(sb.is_empty()); };
        sb.append("abc");
        sb.append("def");
        test("size after two appends") { expect(sb.size().value).should_be(6); };
        test("length") { expect(sb.length()).should_be(6); };
        test("build") { expect(sb.build()).should_be("abcdef"); };
        test("to_string") { expect(sb.to_string()!!).should_be("abcdef"); };
        test("the built string has no extra character") { expect(sb.build().size().value).should_be(6); };
        test("is_empty with text") { expect_false(sb.is_empty()); };
        test("is_not_empty") { expect_true(sb.is_not_empty()); };
        sb.append('g');
        test("append of a character") { expect(sb.build()).should_be("abcdefg"); };
        text : string = "hi";
        sb.append(text).append_char('!');
        test("append of a string and append_char") { expect(sb.build()).should_be("abcdefghi!"); };
        empty : string = "";
        sb.append(empty);
        test("appending \"\" changes nothing") { expect(sb.length()).should_be(10); };
        test("== with a literal") { expect_true((sb == "abcdefghi!").value); };
        test("== with other text") { expect_false((sb == "abcdefghi").value); };
        test("!= with other text") { expect_true((sb != "abc").value); };
        test("at") { expect(sb.at(0).value).should_be('a'); };
        test("[] ") { expect(sb[9].value).should_be('!'); };
        test("char_at") { expect(sb.char_at(1)).should_be('b'); };
        test("first") { expect(sb.first()).should_be('a'); };
        test("last") { expect(sb.last()).should_be('!'); };
        try {
            sb.at(10);
            test("at(length)") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("at(length)") { };
        }
        try {
            sb.char_at(0 - 1);
            test("char_at(-1)") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("char_at(-1)") { };
        }

        // ---- growing far beyond the first buffer
        big := new string_builder();
        for(i : decimal = 0; i < 5000; i++) {
            big.append("0123456789");
        }
        test("50000 characters appended") { expect(big.length()).should_be(50000); };
        test("the last one is right") { expect(big.char_at(49999)).should_be('9'); };
        test("one in the middle is right") { expect(big.char_at(25003)).should_be('3'); };
        test("capacity covers the text") { expect_true(big.capacity() >= 50000); };
        big.trim_to_size();
        test("trim_to_size") { expect(big.capacity()).should_be(50000); };
        test("trim_to_size keeps the text") { expect(big.char_at(49999)).should_be('9'); };
        big.ensure_capacity(60000);
        test("ensure_capacity") { expect_true(big.capacity() >= 60000); };
        test("ensure_capacity keeps the length") { expect(big.length()).should_be(50000); };

        // ---- searching
        words := new string_builder("one two one");
        test("starts_with") { expect_true(words.starts_with("one").value); };
        test("starts_with other text") { expect_false(words.starts_with("two").value); };
        test("ends_with") { expect_true(words.ends_with("one").value); };
        test("ends_with the whole text") { expect_true(words.ends_with("one two one").value); };
        test("ends_with other text") { expect_false(words.ends_with("two").value); };
        // (find(...) with a literal is ambiguous between find(string) and find(string_builder))
        two : string = "two";
        three : string = "three";
        test("find") { expect_true(words.find(two).value); };
        test("find, not there") { expect_false(words.find(three).value); };
        test("index_of") { expect(words.index_of("one")).should_be(0); };
        test("index_of with a start") { expect(words.index_of("one", 1)).should_be(8); };
        test("index_of, not found") { expect(words.index_of("x")).should_be(0 - 1); };
        test("last_index_of") { expect(words.last_index_of("one")).should_be(8); };
        test("last_index_of, not found") { expect(words.last_index_of("x")).should_be(0 - 1); };
        test("contains") { expect_true(words.contains(" two ")); };
        test("contains, not there") { expect_false(words.contains("twoo")); };
        test("equals_text") { expect_true(words.equals_text("one two one")); };
        test("equals_text of a prefix") { expect_false(words.equals_text("one two")); };
        test("slice") { expect(words.slice(4, 7)).should_be("two"); };
        test("slice of nothing") { expect(words.slice(3, 3)).should_be(""); };
        test("substring gives a builder") { expect(words.substring(4, 7).build()).should_be("two"); };
        try {
            words.slice(4, 99);
            test("slice beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("slice beyond the end") { };
        }

        // ---- editing
        ed := new string_builder("held");
        ed.insert(3, "lo wor");
        test("insert") { expect(ed.build()).should_be("hello word"); };
        ed.insert(0, ">> ");
        test("insert at the start") { expect(ed.build()).should_be(">> hello word"); };
        ed.insert(ed.length(), "!");
        test("insert at the end") { expect(ed.build()).should_be(">> hello word!"); };
        ed.insert_char(3, '[');
        test("insert_char") { expect(ed.build()).should_be(">> [hello word!"); };
        ed.delete(0, 4);
        test("delete") { expect(ed.build()).should_be("hello word!"); };
        ed.delete(5, 5);
        test("delete of nothing") { expect(ed.build()).should_be("hello word!"); };
        ed.delete_char_at(10);
        test("delete_char_at") { expect(ed.build()).should_be("hello word"); };
        ed.replace_range(6, 10, "there");
        test("replace_range with longer text") { expect(ed.build()).should_be("hello there"); };
        ed.replace_range(0, 5, "hi");
        test("replace_range with shorter text") { expect(ed.build()).should_be("hi there"); };
        ed.replace_range(2, 3, "_");
        test("replace_range with the same length") { expect(ed.build()).should_be("hi_there"); };
        ed.set_char_at(0, 'H');
        test("set_char_at") { expect(ed.build()).should_be("Hi_there"); };
        ed.reverse();
        test("reverse") { expect(ed.build()).should_be("ereht_iH"); };
        ed.set_length(5);
        test("set_length cuts") { expect(ed.build()).should_be("ereht"); };
        ed.set_length(8, '.');
        test("set_length fills") { expect(ed.build()).should_be("ereht..."); };
        ed.clear();
        test("clear") { expect(ed.length()).should_be(0); };
        test("clear builds \"\"") { expect(ed.build()).should_be(""); };
        ed.append("again");
        test("a cleared builder can be reused") { expect(ed.build()).should_be("again"); };
        try {
            ed.insert(6, "x");
            test("insert beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("insert beyond the end") { };
        }
        try {
            ed.delete(3, 2);
            test("delete with end before start") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("delete with end before start") { };
        }
        try {
            ed.delete_char_at(5);
            test("delete_char_at(length)") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("delete_char_at(length)") { };
        }

        // ---- the extra appends, chained
        report := new string_builder();
        report.append("n=").append_int(42).append_line().append_number(3.14159, 2).append_line("!").append_bool(1);
        test("append_int, append_line, append_number, append_bool") { expect(report.build()).should_be("n=42\n3.14!\ntrue"); };
        rule := new string_builder();
        rule.append_repeat("-=", 3).append_repeat("x", 0);
        test("append_repeat") { expect(rule.build()).should_be("-=-=-="); };
        listing := new string_builder();
        listing.append_all(new string[] { "a", "b", "c" }, ", ");
        test("append_all") { expect(listing.build()).should_be("a, b, c"); };
        copy_of := new string_builder(listing);
        copy_of.append("!");
        test("a copy is independent") { expect(listing.build()).should_be("a, b, c"); };
        test("the copy has the new text") { expect(copy_of.build()).should_be("a, b, c!"); };
        sum := listing + "?";
        test("+ makes a new builder") { expect(sum.build()).should_be("a, b, c?"); };
        test("+ leaves the original alone") { expect(listing.build()).should_be("a, b, c"); };
        listing += " d";
        test("+=") { expect(listing.build()).should_be("a, b, c d"); };

        // ---- char_array
        chars := new char_array("hello");
        test("char_array length") { expect(chars.length()).should_be(5); };
        test("char_array at") { expect(chars.at(1)).should_be('e'); };
        test("char_array index_of") { expect(chars.index_of('l')).should_be(2); };
        test("char_array last_index_of") { expect(chars.last_index_of('l')).should_be(3); };
        test("char_array index_of, not found") { expect(chars.index_of('z')).should_be(0 - 1); };
        test("char_array contains") { expect_true(chars.contains('o')); };
        test("char_array count") { expect(chars.count('l')).should_be(2); };
        own := chars.duplicate();
        own.put(0, 'j');
        test("char_array put") { expect(own.to_string()).should_be("jello"); };
        test("duplicate is independent") { expect(chars.to_string()).should_be("hello"); };
        own.reverse();
        test("char_array reverse") { expect(own.to_string()).should_be("ollej"); };
        own.sort();
        test("char_array sort") { expect(own.to_string()).should_be("ejllo"); };
        own.to_upper();
        test("char_array to_upper") { expect(own.to_string()).should_be("EJLLO"); };
        own.to_lower().swap(0, 4);
        test("char_array to_lower and swap") { expect(own.to_string()).should_be("ojlle"); };
        test("char_array slice") { expect(own.slice(1, 3).to_string()).should_be("jl"); };
        test("char_array slice of nothing") { expect(own.slice(2, 2).length()).should_be(0); };
        test("char_array content_equals") { expect_true(chars.content_equals(new char_array("hello"))); };
        test("char_array content_equals, different") { expect_false(chars.content_equals(own)); };
        own.fill('z');
        test("char_array fill") { expect(own.to_string()).should_be("zzzzz"); };
        test("char_array to_chars") { expect(sizeof(chars.to_chars())).should_be(5); };
        unsorted := new char_array("the quick brown fox jumps over the lazy dog");
        unsorted.sort();
        test("char_array sort of a longer text") { expect(unsorted.to_string()).should_be("        abcdeeefghhijklmnoooopqrrsttuuvwxyz"); };
        nothing := new char_array(new string());
        test("empty char_array length") { expect(nothing.length()).should_be(0); };
        test("empty char_array is_empty") { expect_true(nothing.is_empty()); };
        nothing.reverse().sort();
        test("empty char_array survives reverse and sort") { expect(nothing.length()).should_be(0); };
        try {
            chars.at(5);
            test("char_array at(length)") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("char_array at(length)") { };
        }
        try {
            chars.slice(2, 9);
            test("char_array slice beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("char_array slice beyond the end") { };
        }
    };
    finish_tests();
}
