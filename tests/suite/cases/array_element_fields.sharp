mod main;

import ( testing )

/**
 * Assigning through an array element: items[0].weight = 6 sets the field of the
 * element (it used to overwrite the element), nested elements of fields, and a
 * null element raises nullptr_exception.
 */

class item {
    weight : var = 1;
    name : string = "a";
}

def main(args: string[]) {
    items : item[] = new item[3];
    items[0] = new item();
    items[0].weight = 6;
    expect("field store through an array element", items[0].weight, 6);
    items[0].weight += 2;
    expect("field += through an array element", items[0].weight, 8);

    hit : var = 0;
    try { items[1].weight = 5; } catch(e: nullptr_exception) { hit = 1; }
    expect("field store through a null element throws", hit, 1);

    a : var[] = new var[4];
    a[1] = 3;
    expect("a[1] = 3", a[1], 3);
    expect("nested element stores", more(), 13);
    finish("array_element_fields");
}

class holder {
    list : var[] = new var[3];
    things : item[] = new item[2];
}

def more() : var {
    hs : holder[] = new holder[2];
    hs[1] = new holder();
    hs[1].list[2] = 9;
    hs[1].things[0] = new item();
    hs[1].things[0].weight = 4;
    hs[1].things[0].name = "zed";
    names : string[] = new string[2];
    names[1] = new string("one");
    if(names[1] != "one") { return 0 - 1; }
    if(hs[1].things[0].name != "zed") { return 0 - 2; }
    if(hs[1].things[1] != null) { return 0 - 3; }
    return hs[1].list[2] + hs[1].things[0].weight;
}
