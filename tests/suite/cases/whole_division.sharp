mod main;

import ( testing )

/**
 * `/` on two whole numbers gives a whole number, toward zero, as Java and
 * Kotlin have it; with a decimal on either side it keeps the fraction. A
 * whole number divided by zero raises invalid_operation_exception instead of
 * ending the VM; a decimal divided by zero is infinity, as before.
 */

def div(a: _int64, b: _int64) : _int64 { return a / b; }
def div32(a: _int32, b: _int32) : _int32 { return a / b; }
def half(a: decimal) : decimal { return a / 2; }

class counter {
    total : _int64 = 100;
    def split(parts: _int64) : _int64 { return total / parts; }
}

def main(args: string[]) {
    // ---- written as numbers: worked out by the compiler
    expect("7 / 2", 7 / 2, 3);
    expect("-7 / 2 goes toward zero", -7 / 2, -3);
    expect("7 / -2 goes toward zero", 7 / -2, -3);
    expect("-7 / -2", -7 / -2, 3);
    expect("20 / 4", 20 / 4, 5);
    expect("1 / 3", 1 / 3, 0);
    expect("7 / 2.0 keeps the fraction", 7 / 2.0, 3.5);
    expect("7.0 / 2 keeps the fraction", 7.0 / 2, 3.5);
    expect("(7 / 2) * 2", (7 / 2) * 2, 6);

    // ---- in variables: worked out by the VM
    a : _int64 = 7;
    b : _int64 = 2;
    expect("a / b", a / b, 3);
    expect("-a / b", -a / b, -3);
    expect("a / -b", a / -b, -3);
    expect("through a function", div(-9, 4), -2);
    expect("32 bits", div32(-9, 4), -2);
    expect("a field", new counter().split(7), 14);
    expect("a / b * b + a % b is a", a / b * b + a % b, a);

    // ---- a decimal on either side keeps the fraction
    d : decimal = 7;
    expect("decimal / whole", d / b, 3.5);
    expect("whole / decimal", a / 2.0, 3.5);
    expect("whole as decimal / whole", a as decimal / b, 3.5);
    expect("half(7)", half(7), 3.5);

    // ---- /=
    n : _int64 = 17;
    n /= 5;
    expect("n /= 5", n, 3);
    f : decimal = 17;
    f /= 5;
    expect("a decimal /= 5", f, 3.4);

    // ---- numbers past what a decimal holds exactly stay exact
    big : _int64 = 9007199254740993;
    expect_true("2^53 + 1 divided by 1 is itself", big / 1 == big);
    expect_true("...and by itself is 1", big / big == 1);

    // ---- the smallest number divided by -1 does not fit: it wraps round to itself, as in Java
    lowest : _int64 = -9223372036854775807 - 1;
    minus_one : _int64 = -1;
    expect_true("the smallest number / -1", lowest / minus_one == lowest);

    // ---- by zero: an exception, not the end of the VM
    zero : _int64 = 0;
    hit : _int64 = 0;
    try { div(5, zero); } catch(e: invalid_operation_exception) { hit = 1; }
    expect("a whole number divided by zero raises", hit, 1);

    hit = 0;
    try { n /= zero; } catch(e: invalid_operation_exception) { hit = 2; }
    expect("/= zero raises", hit, 2);

    // (a loop that runs long enough to be turned into machine code)
    total : _int64 = 0;
    caught : _int64 = 0;
    for(i : _int64 = 0; i < 20000; i++) {
        try { total += 1000 / (i % 7); } catch(e: invalid_operation_exception) { caught++; }
    }
    expect("a hot loop: the divisions", total, 2857 * (1000 + 500 + 333 + 250 + 200 + 166));
    expect("a hot loop: the divisions by zero", caught, 2858);

    // ---- a decimal divided by zero is still infinity
    nothing : decimal = 0;
    expect_true("1.0 / 0 is infinity", 1.0 / nothing > 1000000);

    finish("whole_division");
}
