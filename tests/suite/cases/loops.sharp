mod main;

import ( testing )

/**
 * Loops: for, while, do-while and foreach; nesting; break and continue in
 * every kind of loop; loops that never run; the loop variable afterwards.
 */

/** 1 * 2 * ... * n */
def factorial(n: var): var {
    result : var = 1;
    for(i : var = 2; i <= n; i++) {
        result *= i;
    }
    return result;
}

/** how many numbers from 2 to limit are prime */
def count_primes(limit: var): var {
    count : var = 0;
    for(n : var = 2; n <= limit; n++) {
        prime : var = 1;
        for(d : var = 2; d * d <= n; d++) {
            if(n % d == 0) {
                prime = 0;
                break;
            }
        }
        count += prime;
    }
    return count;
}

/** return from the middle of a loop: the position of `wanted`, or -1 */
def index_of(numbers: var[], wanted: var): var {
    for(i : var = 0; i < sizeof(numbers); i++) {
        if(numbers[i] == wanted) {
            return i;
        }
    }
    return 0 - 1;
}

/** how many steps the "halve it or triple it and add one" game takes to reach 1 */
def collatz_steps(n: var): var {
    steps : var = 0;
    while(n != 1) {
        if(n % 2 == 0) {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps++;
    }
    return steps;
}

def main(args: string[]) {
    sum : var = 0;
    count : var = 0;

    // ---- for
    for(i : var = 0; i < 5; i++) {
        sum += i;
    }
    expect("for 0 to 4", sum, 10);

    sum = 0;
    for(i : var = 1; i <= 100; i++) {
        sum += i;
    }
    expect("for 1 to 100", sum, 5050);

    sum = 0;
    for(i : var = 10; i > 0; i--) {
        sum = sum * 2 + i;
        count++;
    }
    expect("counting down runs 10 times", count, 10);
    expect("counting down", sum, 9217);

    count = 0;
    for(i : var = 0; i < 20; i += 5) {
        count++;
    }
    expect("for in steps of 5", count, 4);

    count = 0;
    for(x : var = 1; x < 1000; x *= 2) {
        count++;
    }
    expect("for, doubling up to 1000", count, 10);

    count = 0;
    for(x : var = 0; x < 1; x += 0.25) {
        count++;
    }
    expect("for in steps of 0.25", count, 4);

    // ---- the variable of a for is its own: the next loop can use the name again
    sum = 0;
    for(i : var = 0; i < 3; i++) { sum += 1; }
    for(i : var = 0; i < 3; i++) { sum += 10; }
    expect("two loops with the same variable name", sum, 33);

    // ---- a variable declared before the loop keeps its value after it
    k : var = 0;
    for(; k < 5; k++) {
    }
    expect("k after for(; k < 5; k++)", k, 5);
    k = 10;
    for(; k < 13; k++) {
    }
    expect("k after starting again at 10", k, 13);
    k = 0;
    for(; k < 100; k++) {
        if(k == 42) {
            break;
        }
    }
    expect("k after a break", k, 42);

    // ---- for with empty parts
    count = 0;
    for(;;) {
        count++;
        if(count == 7) {
            break;
        }
    }
    expect("for(;;) with a break", count, 7);
    count = 0;
    for(i : var = 0; i < 4;) {
        i++;
        count++;
    }
    expect("for without a step", count, 4);

    // ---- while
    n : var = 0;
    while(n < 5) {
        n++;
    }
    expect("while counts to 5", n, 5);

    n = 1;
    count = 0;
    while(n < 1000) {
        n *= 2;
        count++;
    }
    expect("while doubling: steps", count, 10);
    expect("while doubling: value after the loop", n, 1024);

    n = 100;
    while(n > 0) {
        n -= 7;
    }
    expect("while counting down past zero", n, 0 - 5);

    count = 0;
    while(true) {
        count++;
        if(count >= 3) {
            break;
        }
    }
    expect("while(true) with a break", count, 3);

    // ---- do-while: the body runs before the condition is checked
    n = 0;
    do {
        n++;
    } while(n < 5);
    expect("do-while counts to 5", n, 5);

    n = 100;
    count = 0;
    do {
        count++;
    } while(n < 5);
    expect("do-while runs once even when the condition is false", count, 1);

    n = 1234;
    count = 0;
    do {
        n = (n - n % 10) / 10;
        count++;
    } while(n > 0);
    expect("do-while counts the digits of 1234", count, 4);

    // ---- foreach
    numbers : var[] = new var[5];
    numbers[0] = 3;
    numbers[1] = 1;
    numbers[2] = 4;
    numbers[3] = 1;
    numbers[4] = 5;

    sum = 0;
    count = 0;
    foreach(item in numbers) {
        sum += item;
        count++;
    }
    expect("foreach visits every item", count, 5);
    expect("foreach sum", sum, 14);

    n = 0;
    foreach(item in numbers) {
        n = n * 10 + item;
    }
    expect("foreach goes in order", n, 31415);

    largest : var = 0;
    foreach(item in numbers) {
        if(item > largest) {
            largest = item;
        }
    }
    expect("foreach finds the largest", largest, 5);

    foreach(item in numbers) {
        item = 0;
    }
    expect("assigning to the item does not change the array", numbers[2], 4);

    listed := { 10, 20, 30 };
    sum = 0;
    foreach(item in listed) {
        sum += item;
    }
    expect("foreach over a listed array", sum, 60);

    word := "abc";
    sum = 0;
    foreach(ch in word) {
        sum += ch;
    }
    expect("foreach over the characters of a string", sum, 294);

    // ---- loops that run zero times
    count = 0;
    for(i : var = 0; i < 0; i++) {
        count++;
    }
    expect("for with a false condition", count, 0);
    for(i : var = 5; i < 5; i++) {
        count++;
    }
    expect("for starting at its limit", count, 0);
    n = 10;
    while(n < 5) {
        count++;
    }
    expect("while with a false condition", count, 0);
    while(false) {
        count++;
    }
    expect("while(false)", count, 0);
    nothing : var[] = new var[0];
    foreach(item in nothing) {
        count++;
    }
    expect("foreach over an empty array", count, 0);
    empty := "";
    foreach(ch in empty) {
        count++;
    }
    expect("foreach over an empty string", count, 0);

    // ---- break
    sum = 0;
    for(i : var = 0; i < 10; i++) {
        if(i == 4) {
            break;
        }
        sum += i;
    }
    expect("break in a for", sum, 6);

    n = 0;
    while(n < 10) {
        if(n == 6) {
            break;
        }
        n++;
    }
    expect("break in a while", n, 6);

    n = 0;
    do {
        n++;
        if(n == 3) {
            break;
        }
    } while(n < 10);
    expect("break in a do-while", n, 3);

    sum = 0;
    foreach(item in numbers) {
        if(item == 4) {
            break;
        }
        sum += item;
    }
    expect("break in a foreach", sum, 4);

    count = 0;
    for(i : var = 0; i < 10; i++) {
        break;
        count++;
    }
    expect("break as the first statement", count, 0);

    // ---- continue
    sum = 0;
    for(i : var = 0; i < 10; i++) {
        if(i % 2 == 0) {
            continue;
        }
        sum += i;
    }
    expect("continue in a for (the step still runs)", sum, 25);

    n = 0;
    sum = 0;
    while(n < 10) {
        n++;
        if(n % 3 == 0) {
            continue;
        }
        sum += n;
    }
    expect("continue in a while", sum, 37);

    n = 0;
    sum = 0;
    do {
        n++;
        if(n == 2) {
            continue;
        }
        sum += n;
    } while(n < 4);
    expect("continue in a do-while (the condition is still checked)", sum, 8);

    sum = 0;
    foreach(item in numbers) {
        if(item == 1) {
            continue;
        }
        sum += item;
    }
    expect("continue in a foreach", sum, 12);

    // ---- break and continue together
    sum = 0;
    for(i : var = 0; i < 100; i++) {
        if(i % 2 == 1) {
            continue;
        }
        if(i > 10) {
            break;
        }
        sum += i;
    }
    expect("even numbers up to 10", sum, 30);

    // ---- nested loops
    count = 0;
    for(i : var = 0; i < 4; i++) {
        for(j : var = 0; j < 3; j++) {
            count++;
        }
    }
    expect("4 x 3", count, 12);

    sum = 0;
    for(i : var = 1; i <= 3; i++) {
        for(j : var = 1; j <= 3; j++) {
            sum += i * j;
        }
    }
    expect("the 3 x 3 multiplication table", sum, 36);

    count = 0;
    for(i : var = 0; i < 4; i++) {
        for(j : var = 0; j < i; j++) {
            count++;
        }
    }
    expect("the inner limit depends on the outer variable", count, 6);

    count = 0;
    for(i : var = 0; i < 3; i++) {
        for(j : var = 0; j < 3; j++) {
            for(l : var = 0; l < 3; l++) {
                count++;
            }
        }
    }
    expect("three deep", count, 27);

    count = 0;
    for(i : var = 0; i < 3; i++) {
        n = 0;
        while(n < 2) {
            do {
                count++;
            } while(false);
            n++;
        }
    }
    expect("a do-while in a while in a for", count, 6);

    sum = 0;
    for(i : var = 0; i < 2; i++) {
        foreach(item in numbers) {
            sum += item;
        }
    }
    expect("a foreach in a for", sum, 28);

    // ---- break leaves only the inner loop
    count = 0;
    outer : var = 0;
    for(i : var = 0; i < 3; i++) {
        outer++;
        for(j : var = 0; j < 10; j++) {
            if(j == 2) {
                break;
            }
            count++;
        }
    }
    expect("inner break: the outer loop still ran 3 times", outer, 3);
    expect("inner break: 2 inner steps each time", count, 6);

    // ---- break in the outer loop, after the inner loop
    count = 0;
    for(i : var = 0; i < 10; i++) {
        for(j : var = 0; j < 2; j++) {
            count++;
        }
        if(i == 1) {
            break;
        }
    }
    expect("outer break", count, 4);

    // ---- continue skips only the rest of the inner step
    count = 0;
    for(i : var = 0; i < 3; i++) {
        for(j : var = 0; j < 4; j++) {
            if(j == 1) {
                continue;
            }
            count++;
        }
    }
    expect("inner continue", count, 9);

    // ---- continue in the outer loop skips the inner loop
    count = 0;
    for(i : var = 0; i < 4; i++) {
        if(i == 2) {
            continue;
        }
        for(j : var = 0; j < 5; j++) {
            count++;
        }
    }
    expect("outer continue", count, 15);

    // ---- leaving two loops with a flag
    found_i : var = 0 - 1;
    found_j : var = 0 - 1;
    done : var = false;
    for(i : var = 0; i < 5 && !done; i++) {
        for(j : var = 0; j < 5; j++) {
            if(i * j == 6) {
                found_i = i;
                found_j = j;
                done = true;
                break;
            }
        }
    }
    expect("first i with i * j == 6", found_i, 2);
    expect("first j with i * j == 6", found_j, 3);

    // ---- writing an array in one loop and reading it in another
    squares : var[] = new var[10];
    for(i : var = 0; i < sizeof(squares); i++) {
        squares[i] = i * i;
    }
    sum = 0;
    foreach(square in squares) {
        sum += square;
    }
    expect("sum of the squares 0 to 9", sum, 285);

    // ---- loops in functions
    expect("factorial(0)", factorial(0), 1);
    expect("factorial(1)", factorial(1), 1);
    expect("factorial(5)", factorial(5), 120);
    expect("factorial(10)", factorial(10), 3628800);
    expect("primes up to 30", count_primes(30), 10);
    expect("primes up to 100", count_primes(100), 25);
    expect("index_of 4", index_of(numbers, 4), 2);
    expect("index_of 1 is the first one", index_of(numbers, 1), 1);
    expect("index_of something missing", index_of(numbers, 9), 0 - 1);
    expect("collatz_steps(1)", collatz_steps(1), 0);
    expect("collatz_steps(6)", collatz_steps(6), 8);
    expect("collatz_steps(27)", collatz_steps(27), 111);

    // ---- a long loop
    sum = 0;
    for(i : var = 0; i < 100000; i++) {
        sum += i % 7;
    }
    expect("100000 steps", sum, 299995);

    finish("loops");
}
