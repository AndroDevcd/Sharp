mod main;
import ( testing )
class holder {
    enum inner { off = 0, on = 1 }
    class part { static count : decimal = 7; }
    state : inner = inner.off;
}
def main(args: string[]) {
    expect("static field of an inner class", holder.part.count, 7);
    x : holder.inner = holder.inner.on;
    expect_true("inner enum as a type and value", (x == holder.inner.on).value);
    finish("classes_nested_names");
}
