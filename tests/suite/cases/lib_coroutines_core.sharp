mod main;

import (
    std.testing,
    std.io,
    std.io.coroutines
)

/**
 * std.io.coroutines core: launch / job / async / deferred / run_blocking /
 * coroutine_scope / supervisor_scope / coroutine_scope objects / cancellation /
 * with_timeout / dispatchers / exception handling.
 *
 * Everything asserted here holds for every schedule: totals after a join,
 * states after a join, that the body of a cancelled coroutine never reaches
 * its end, that a time limit fires for a wait that would never end.
 *
 * The blocks of launch/async run on other fibers and cannot see locals of the
 * function that created them (the closure rule), so the tests keep their
 * shared state in globals or hand it over as the state argument.
 */

class flag {
    value : decimal = 0;
    name : string = "";
}

class quiet_handler : coroutine_exception_handler {
    seen : atomic_counter = new atomic_counter();
    last_message : string = "";
    override def handle_exception(failed: job, error: throwable) {
        last_message = error.get_message();
        seen.increment();
    }
}

hits := new atomic_counter();
finished_bodies := new atomic_counter();
never_reached := new atomic_counter();
handler_calls := new atomic_counter();
handler := new quiet_handler();
shared := new flag();
plain_total := new flag();
thread_names := new flag();

class adder : coroutine_body {
    amount : decimal = 0;
    adder(amount: decimal) { self->amount = amount; }
    override def run_body() { hits.add(amount); }
}

def sleeper() {
    delay(1000000);
    never_reached.increment();
}

def spinner() {
    for( ;; ) {
        yield();
    }
    never_reached.increment();
}

def checker() {
    for( ;; ) {
        ensure_active();
    }
    never_reached.increment();
}

def test_launch_and_join() {
    hits.write(0);
    j := launch({ -> hits.increment(); });
    j.join();
    test("launch ran the block") { expect(hits.read()).should_be(1); };
    test("joined job is completed") { expect_true(j.is_completed().value); };
    test("joined job is not active") { expect_false(j.is_active().value); };
    test("joined job is not cancelled") { expect_false(j.is_cancelled().value); };
    test("joined job has not failed") { expect_false(j.is_failed().value); };
    test("final state is COMPLETED") { expect(j.get_state()).should_be(job.COMPLETED); };
    test("no failure on a normal job") { expect_null(j.get_failure()); };
    j.join();
    test("join on a finished job returns at once") { };

    // a state object travels with the coroutine
    box := new flag();
    k := launch(box, { s: object -> f := s as flag; f.value = 7; });
    k.join();
    test("state argument reached the coroutine") { expect(box.value).should_be(7); };

    // a coroutine_body object
    hits.write(0);
    b := launch(new adder(5));
    b.join();
    test("coroutine_body object ran") { expect(hits.read()).should_be(5); };

    test("no current job outside a coroutine") { expect_null(current_job()); };
    test("is_active() outside a coroutine") { expect_true(is_active().value); };
}

def test_run_blocking() {
    hits.write(0);
    local_total := new flag();
    run_blocking({ ->
        // in-line block: capturing a local is fine
        local_total.value = 3;
        for(i : decimal = 0; i < 1000; i++) {
            launch({ -> hits.increment(); });
        }
        if(current_job() != null) { local_total.value = local_total.value + 1; }
    });
    test("run_blocking waited for 1000 children") { expect(hits.read()).should_be(1000); };
    test("in-line block captured a local and saw its job") { expect(local_total.value).should_be(4); };
    test("current job restored after run_blocking") { expect_null(current_job()); };

    // children of run_blocking stay on the calling thread: unsynchronised state is safe
    plain_total.value = 0;
    run_blocking({ ->
        for(i : decimal = 0; i < 500; i++) {
            launch({ -> plain_total.value = plain_total.value + 1; });
        }
    });
    test("children of run_blocking never ran in parallel") { expect(plain_total.value).should_be(500); };

    // nested
    hits.write(0);
    run_blocking({ ->
        launch({ ->
            launch({ -> delay(5); hits.add(10); });
            hits.add(1);
        });
    });
    test("run_blocking waited for grandchildren") { expect(hits.read()).should_be(11); };
}

def test_scale() {
    hits.write(0);
    coroutine_scope({ ->
        for(i : decimal = 0; i < 10000; i++) {
            launch_on(dispatchers.default_pool(), { -> hits.increment(); });
        }
    });
    test("10,000 coroutines on the pool each added 1") { expect(hits.read()).should_be(10000); };

    hits.write(0);
    run_blocking({ ->
        for(i : decimal = 0; i < 10000; i++) {
            launch({ -> yield(); hits.increment(); });
        }
    });
    test("10,000 yielding coroutines on one thread each added 1") { expect(hits.read()).should_be(10000); };

    hits.write(0);
    coroutine_scope({ ->
        for(i : decimal = 0; i < 2000; i++) {
            launch_on(dispatchers.default_pool(), { -> delay(2); hits.increment(); });
        }
    });
    test("2,000 sleeping coroutines all came back") { expect(hits.read()).should_be(2000); };
    test("the default pool was started") { expect_true(dispatchers.shared_pool().is_started().value); };
    test("the pool has at least one worker") { expect_true(dispatchers.shared_pool().get_parallelism() >= 1); };
}

def test_async() {
    run_blocking({ ->
        a := async<int>.start({ -> (int) return 6 * 7; });
        b := async<int>.start({ -> (int) delay(5); return 58; });
        test("await of a quick async") { expect(a.await().value).should_be(42); };
        test("await of a sleeping async") { expect(b.await().value).should_be(58); };
        test("await twice gives the same value") { expect(b.await().value).should_be(58); };
        test("awaited deferred is completed") { expect_true(b.is_completed().value); };
        test("get_completed after completion") { expect(b.get_completed()!!.value).should_be(58); };

        box := new flag();
        box.value = 20;
        c := async<int>.start(box, { s: object -> (int) f := s as flag; return f.value + 1; });
        test("async with a state object") { expect(c.await().value).should_be(21); };

        s := async<string>.start({ -> (string) return "text"; });
        test("async of a string") { expect(s.await()).should_be("text"); };

        items := new deferred<int>[5];
        for(i : decimal = 0; i < 5; i++) {
            items[i] = async<int>.start_on(dispatchers.default_pool(), { -> (int) delay(3); return 10; });
        }
        results := deferred<int>.await_all(items);
        sum : decimal = 0;
        for(i : decimal = 0; i < results.size().value; i++) { sum += results.at(i).value; }
        test("await_all returned every result") { expect(results.size().value).should_be(5); };
        test("await_all sum") { expect(sum).should_be(50); };
    });

    // a failing async: await throws, and (not in a supervisor) the scope fails too
    caught := new flag();
    try {
        coroutine_scope({ ->
            d := async<int>.start({ -> (int) throw new illegal_state_exception("async failed"); });
            try {
                d.await();
                test("await of a failed async") { fail_test("returned normally"); };
            } catch(e: illegal_state_exception) {
                caught.value = 1;
            }
        });
        test("scope with a failed async") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("scope rethrew the async failure") { expect(e.get_message()).should_be("async failed"); };
    }
    test("await threw the failure") { expect(caught.value).should_be(1); };

    // in a supervisor the failure stays in the deferred
    before : decimal = handler.seen.read();
    supervisor_scope({ ->
        d := async<int>.start({ -> (int) throw new illegal_state_exception("kept"); });
        try {
            d.await();
            test("await of a failed async in a supervisor") { fail_test("returned normally"); };
        } catch(e: illegal_state_exception) {
            test("supervisor: await threw") { expect(e.get_message()).should_be("kept"); };
        }
        test("failed deferred is cancelled") { expect_true(d.is_cancelled().value); };
        test("failed deferred has failed") { expect_true(d.is_failed().value); };
        test("no result from a failed deferred") { expect_null(d.get_completed()); };
    });
    test("a failed async is never reported as uncaught") { expect(handler.seen.read()).should_be(before); };

    // a cancelled deferred
    run_blocking({ ->
        d := async<int>.start({ -> (int) delay(1000000); return 1; });
        yield();
        d.cancel();
        try {
            d.await();
            test("await of a cancelled async") { fail_test("returned normally"); };
        } catch(e: cancellation_exception) {
            test("await of a cancelled async throws cancellation_exception") { };
        }
    });
}

def test_cancellation() {
    never_reached.write(0);

    // delay is a cancellation point
    j := launch({ -> sleeper(); });
    delay(10);
    test("sleeping job is active") { expect_true(j.is_active().value); };
    j.cancel();
    test("is_cancelled right after cancel") { expect_true(j.is_cancelled().value); };
    j.join();
    test("cancelled job is completed after join") { expect_true(j.is_completed().value); };
    test("cancelled job ended in CANCELLED") { expect(j.get_state()).should_be(job.CANCELLED); };
    test("cancellation is not a failure") { expect_false(j.is_failed().value); };
    test("cancelled job has a cause") { expect_not_null(j.get_failure()); };
    j.cancel();
    test("cancel twice is harmless") { };

    // yield is a cancellation point
    y := launch({ -> spinner(); });
    delay(5);
    y.cancel_and_join();
    test("yielding job was cancelled") { expect_true(y.is_cancelled().value); };

    // ensure_active is a cancellation point
    c := launch({ -> checker(); });
    delay(5);
    c.cancel_and_join();
    test("checking job was cancelled") { expect_true(c.is_cancelled().value); };

    // join is a cancellation point for the caller
    target := launch({ -> sleeper(); });
    joiner := launch(target, { s: object -> t := s as job; t.join(); never_reached.increment(); });
    delay(5);
    joiner.cancel_and_join();
    test("a coroutine blocked in join was cancelled") { expect_true(joiner.is_cancelled().value); };
    test("the job it waited for is untouched") { expect_true(target.is_active().value); };
    target.cancel_and_join();

    // cancelling a parent cancels its children
    parent_job := launch({ ->
        launch({ -> sleeper(); });
        launch({ -> sleeper(); });
        sleeper();
    });
    delay(10);
    test("parent has two children") { expect(parent_job.child_count()).should_be(2); };
    kids := parent_job.children();
    test("children() lists both") { expect(sizeof(kids)).should_be(2); };
    parent_job.cancel_and_join();
    test("child 0 cancelled with its parent") { expect_true(kids[0].is_cancelled().value); };
    test("child 1 cancelled with its parent") { expect_true(kids[1].is_cancelled().value); };
    test("child 0 finished before the parent's join returned") { expect_true(kids[0].is_completed().value); };
    test("no children left") { expect(parent_job.child_count()).should_be(0); };

    // a coroutine that catches the cancellation can clean up
    shared.value = 0;
    cleaner := launch({ ->
        try {
            delay(1000000);
        } catch(e: cancellation_exception) {
            shared.value = 99;
            throw e;
        }
    });
    delay(5);
    cleaner.cancel_and_join();
    test("cancellation_exception was catchable for clean up") { expect(shared.value).should_be(99); };
    test("...and the job still ended cancelled") { expect_true(cleaner.is_cancelled().value); };

    // cancel with a reason
    r := launch({ -> sleeper(); });
    r.cancel("because");
    r.join();
    test("cancel(reason) keeps the reason") { expect(r.get_failure()!!.get_message()).should_be("because"); };

    test("no cancelled body ever reached its end") { expect(never_reached.read()).should_be(0); };
}

def test_scopes() {
    never_reached.write(0);

    // coroutine_scope waits
    hits.write(0);
    coroutine_scope({ ->
        launch({ -> delay(10); hits.add(1); });
        launch({ -> delay(5); hits.add(2); });
    });
    test("coroutine_scope waited for both children") { expect(hits.read()).should_be(3); };

    // a failing child cancels its sibling and the scope rethrows
    sibling := new flag();
    try {
        coroutine_scope({ ->
            launch({ -> sleeper(); });
            launch({ -> delay(5); throw new illegal_state_exception("child failed"); });
            sibling.value = 1;
        });
        test("scope with a failing child") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("scope rethrew the child's exception") { expect(e.get_message()).should_be("child failed"); };
    }
    test("the block itself had finished") { expect(sibling.value).should_be(1); };
    test("the sibling never reached its end") { expect(never_reached.read()).should_be(0); };

    // an exception of the block cancels the children
    try {
        coroutine_scope({ ->
            launch({ -> sleeper(); });
            throw new illegal_argument_exception("block failed");
        });
        test("scope whose block throws") { fail_test("returned normally"); };
    } catch(e: illegal_argument_exception) {
        test("scope rethrew the block's exception") { expect(e.get_message()).should_be("block failed"); };
    }
    test("the child of the failed block never reached its end") { expect(never_reached.read()).should_be(0); };

    // supervisor_scope: children fail on their own
    before : decimal = handler.seen.read();
    hits.write(0);
    supervisor_scope({ ->
        launch({ -> throw new illegal_state_exception("lonely failure"); });
        launch({ -> delay(10); hits.add(5); });
    });
    test("the sibling of a failed child completed in a supervisor") { expect(hits.read()).should_be(5); };
    test("the failure went to the exception handler") { expect(handler.seen.read()).should_be(before + 1); };
    test("the handler saw the exception") { expect(handler.last_message).should_be("lonely failure"); };

    // nested scopes (of different kinds, see THE NESTING RULE)
    hits.write(0);
    coroutine_scope({ ->
        supervisor_scope({ ->
            launch({ -> delay(5); hits.add(1); });
        });
        test("inner scope finished before the outer block continued") { expect(hits.read()).should_be(1); };
        launch({ -> hits.add(10); });
    });
    test("nested scopes") { expect(hits.read()).should_be(11); };

    hits.write(0);
    run_blocking({ ->
        coroutine_scope({ ->
            supervisor_scope({ ->
                with_timeout(60000, { ->
                    launch({ -> delay(5); hits.add(1); });
                    delay(2);
                });
                hits.add(10);
            });
            hits.add(100);
        });
        hits.add(1000);
    });
    test("four different scope functions nested") { expect(hits.read()).should_be(1111); };

    // a failure caught around an inner scope does not cancel the outer one
    hits.write(0);
    run_blocking({ ->
        try {
            coroutine_scope({ ->
                launch({ -> throw new illegal_state_exception("inner"); });
            });
        } catch(e: illegal_state_exception) {
            hits.add(1);
        }
        test("outer scope still active after catching the inner failure") { expect_true(is_active().value); };
        launch({ -> hits.add(10); });
    });
    test("outer scope went on") { expect(hits.read()).should_be(11); };

    // the same scope function directly inside itself is refused (it would hang, see the known bug)
    refused := new flag();
    coroutine_scope({ ->
        try {
            coroutine_scope({ -> never_reached.increment(); });
        } catch(e: illegal_state_exception) {
            refused.value = refused.value + 1;
        }
    });
    supervisor_scope({ ->
        try {
            supervisor_scope({ -> never_reached.increment(); });
        } catch(e: illegal_state_exception) {
            refused.value = refused.value + 1;
        }
    });
    run_blocking({ ->
        try {
            run_blocking({ -> never_reached.increment(); });
        } catch(e: illegal_state_exception) {
            refused.value = refused.value + 1;
        }
    });
    with_timeout(60000, { ->
        try {
            with_timeout(60000, { -> never_reached.increment(); });
        } catch(e: illegal_state_exception) {
            refused.value = refused.value + 1;
        }
    });
    test("a scope function nested in itself is refused") { expect(refused.value).should_be(4); };

    // ...but through a coroutine of its own it works
    hits.write(0);
    coroutine_scope({ ->
        inner := launch({ -> coroutine_scope({ -> launch({ -> hits.add(1); }); }); hits.add(10); });
        inner.join();
        hits.add(100);
    });
    test("the same scope function inside a launched coroutine") { expect(hits.read()).should_be(111); };

    // and the refusal leaves the fiber usable
    hits.write(0);
    coroutine_scope({ -> launch({ -> hits.add(1); }); });
    test("coroutine_scope still works after a refused nesting") { expect(hits.read()).should_be(1); };

    // scope objects
    scope := new coroutine_scope();
    a := scope.launch({ -> sleeper(); });
    b := scope.launch({ -> sleeper(); });
    d := async<int>.start_in(scope, { -> (int) delay(1000000); return 1; });
    test("scope object is active") { expect_true(scope.is_active().value); };
    test("scope object has three coroutines") { expect(scope.active_count()).should_be(3); };
    scope.cancel_and_join();
    test("scope cancel reached coroutine a") { expect_true(a.is_cancelled().value); };
    test("scope cancel reached coroutine b") { expect_true(b.is_completed().value); };
    test("scope cancel reached the async") { expect_true(d.is_cancelled().value); };
    test("cancelled scope is not active") { expect_false(scope.is_active().value); };
    late := scope.launch({ -> never_reached.increment(); });
    test("launch in a cancelled scope gives a cancelled job") { expect_true(late.is_cancelled().value); };
    test("...that is already finished") { expect_true(late.is_completed().value); };

    hits.write(0);
    open := new coroutine_scope();
    for(i : decimal = 0; i < 50; i++) {
        open.launch({ -> delay(3); hits.increment(); });
    }
    open.join_children();
    test("join_children waited for all") { expect(hits.read()).should_be(50); };
    test("the scope is still open") { expect_true(open.is_active().value); };
    open.launch({ -> hits.increment(); });
    open.complete_and_join();
    test("complete_and_join waited for the last one") { expect(hits.read()).should_be(51); };
    test("completed scope job") { expect_true(open.get_job().is_completed().value); };
    test("completed scope was not cancelled") { expect_false(open.get_job().is_cancelled().value); };

    // a failing coroutine cancels a normal scope object, not a supervisor one
    failing := new coroutine_scope();
    survivor := failing.launch({ -> sleeper(); });
    failing.launch({ -> throw new illegal_state_exception("scope object failure"); });
    survivor.join();
    test("a failure cancelled the other coroutine of the scope") { expect_true(survivor.is_cancelled().value); };
    test("the scope job has failed") { expect_true(failing.get_job().is_failed().value); };

    before = handler.seen.read();
    careful := coroutine_scope.supervisor();
    steady := careful.launch({ -> delay(20); hits.add(100); });
    broken := careful.launch({ -> throw new illegal_state_exception("supervised failure"); });
    broken.join();
    steady.join();
    test("supervisor scope: the other coroutine was not cancelled") { expect_false(steady.is_cancelled().value); };
    test("supervisor scope is still active") { expect_true(careful.is_active().value); };
    test("supervisor scope reported the failure") { expect(handler.seen.read()).should_be(before + 1); };
    careful.cancel();

    test("no cancelled body ever reached its end (scopes)") { expect(never_reached.read()).should_be(0); };
}

def on_done(done: job) {
    handler_calls.increment();
}

def test_completion_handlers() {
    handler_calls.write(0);
    j := launch({ -> delay(10); });
    j.invoke_on_completion(on_done);
    j.invoke_on_completion({ done: job -> handler_calls.add(10); });
    j.join();
    // handlers run on a fiber of their own, shortly after the job finished
    for(i : decimal = 0; i < 1000 && handler_calls.read() < 11; i++) { delay(1); }
    test("both completion handlers ran once") { expect(handler_calls.read()).should_be(11); };

    j.invoke_on_completion(on_done);
    for(i : decimal = 0; i < 1000 && handler_calls.read() < 12; i++) { delay(1); }
    test("handler registered on a finished job still runs") { expect(handler_calls.read()).should_be(12); };

    c := launch({ -> sleeper(); });
    c.invoke_on_completion({ done: job -> if(done.is_cancelled()) { handler_calls.add(100); } });
    c.cancel_and_join();
    for(i : decimal = 0; i < 1000 && handler_calls.read() < 112; i++) { delay(1); }
    test("handler of a cancelled job saw is_cancelled") { expect(handler_calls.read()).should_be(112); };
}

def test_timeouts() {
    never_reached.write(0);

    try {
        with_timeout(20, { -> delay(1000000); never_reached.increment(); });
        test("with_timeout around an endless wait") { fail_test("returned normally"); };
    } catch(e: timeout_cancellation_exception) {
        test("with_timeout fired") { };
    }

    done := new flag();
    with_timeout(60000, { -> delay(2); done.value = 1; });
    test("with_timeout lets a quick block finish") { expect(done.value).should_be(1); };

    r := with_timeout_or_null(20, { -> (object) delay(1000000); return new flag(); });
    test("with_timeout_or_null gives null on time out") { expect_null(r); };

    v := with_timeout_or_null(60000, { -> (object) f := new flag(); f.value = 5; return f; });
    test("with_timeout_or_null gives the result") { expect_not_null(v); };
    test("...the right result") { expect((v as flag).value).should_be(5); };

    // the children of the block are cancelled by the time out as well
    try {
        with_timeout(20, { ->
            launch({ -> sleeper(); });
            delay(1000000);
        });
        test("with_timeout with children") { fail_test("returned normally"); };
    } catch(e: timeout_cancellation_exception) {
        test("with_timeout with children fired") { };
    }

    // an exception of the block is not turned into a time out
    try {
        with_timeout(60000, { -> throw new illegal_state_exception("not a timeout"); });
        test("with_timeout whose block throws") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("with_timeout rethrew the block's exception") { expect(e.get_message()).should_be("not a timeout"); };
    }

    // nested: the inner limit fires, the outer block carries on
    outer_done := new flag();
    with_timeout(60000, { ->
        inner := with_timeout_or_null(20, { -> (object) delay(1000000); return new flag(); });
        if(inner == null) { outer_done.value = 1; }
        delay(2);
        outer_done.value = outer_done.value + 1;
    });
    test("inner time out did not cancel the outer block") { expect(outer_done.value).should_be(2); };

    // nested the other way round: the outer limit fires through the inner one
    try {
        with_timeout(20, { ->
            with_timeout_or_null(60000, { -> (object) delay(1000000); never_reached.increment(); return new flag(); });
            never_reached.increment();
        });
        test("outer time out through an inner with_timeout") { fail_test("returned normally"); };
    } catch(e: timeout_cancellation_exception) {
        test("outer time out passed through the inner with_timeout_or_null") { };
    }

    // inside a coroutine, and cancelling the coroutine wins over the limit
    waiting := launch({ -> with_timeout(1000000, { -> delay(1000000); }); never_reached.increment(); });
    delay(10);
    waiting.cancel_and_join();
    test("a coroutine inside with_timeout can be cancelled") { expect_true(waiting.is_cancelled().value); };

    hits.write(0);
    run_blocking({ ->
        for(i : decimal = 0; i < 200; i++) {
            launch({ ->
                got := with_timeout_or_null(5, { -> (object) delay(1000000); return new flag(); });
                if(got == null) { hits.increment(); }
            });
        }
    });
    test("200 coroutines each timed out") { expect(hits.read()).should_be(200); };

    test("no timed out body ever reached its end") { expect(never_reached.read()).should_be(0); };
}

def remember_thread() {
    // a copy: assigning to a string field writes INTO the string object it holds,
    // so keeping the thread's own name object here would let the test overwrite it
    thread_names.name = "" + thread.current().get_name();
}

def test_dispatchers() {
    solo_thread := dispatchers.single_thread("solo");
    test("single_thread created its thread") { expect(solo_thread.get_thread().get_name()).should_be("solo"); };

    thread_names.name = "";
    j := launch_on(solo_thread, { -> remember_thread(); });
    j.join();
    test("coroutine ran on the dispatcher's thread") { expect(thread_names.name).should_be("solo"); };

    // all coroutines of a solo_thread thread dispatcher share one thread: no lock needed
    plain_total.value = 0;
    coroutine_scope({ ->
        for(i : decimal = 0; i < 2000; i++) {
            launch_on(solo_thread, { -> plain_total.value = plain_total.value + 1; });
        }
    });
    test("2,000 coroutines on one thread, unsynchronised counter") { expect(plain_total.value).should_be(2000); };

    // children inherit the dispatcher
    thread_names.name = "";
    outer := launch_on(solo_thread, { -> launch({ -> remember_thread(); }); });
    outer.join();
    test("a child inherits its parent's dispatcher") { expect(thread_names.name).should_be("solo"); };

    // with_context
    thread_names.name = "";
    with_context(solo_thread, { -> remember_thread(); });
    test("with_context ran the block on the dispatcher") { expect(thread_names.name).should_be("solo"); };

    box := new flag();
    with_context(dispatchers.default_pool(), box, { s: object -> f := s as flag; f.value = 31; });
    test("with_context with a state object") { expect(box.value).should_be(31); };

    try {
        with_context(solo_thread, { -> throw new illegal_state_exception("context failed"); });
        test("with_context whose block throws") { fail_test("returned normally"); };
    } catch(e: illegal_state_exception) {
        test("with_context rethrew") { expect(e.get_message()).should_be("context failed"); };
    }

    solo_thread.close();
    test("dispatcher closed") { expect_true(solo_thread.is_closed().value); };

    // current thread
    thread_names.name = "";
    mine := "" + thread.current().get_name();
    run_blocking({ ->
        launch({ -> remember_thread(); });
    });
    test("children of run_blocking run on the calling thread") { expect(thread_names.name).should_be(mine); };

    hits.write(0);
    u := launch_on(dispatchers.unconfined(), { -> hits.increment(); });
    u.join();
    test("unconfined coroutine ran") { expect(hits.read()).should_be(1); };

    all := new job[20];
    hits.write(0);
    for(i : decimal = 0; i < 20; i++) {
        all[i] = launch({ -> delay(2); hits.increment(); });
    }
    join_all(all);
    test("join_all waited for 20 jobs") { expect(hits.read()).should_be(20); };
}

def test_uncaught() {
    before : decimal = handler.seen.read();
    j := launch({ -> throw new illegal_state_exception("top level failure"); });
    j.join();
    test("a failed top level job is cancelled") { expect_true(j.is_cancelled().value); };
    test("...and failed") { expect_true(j.is_failed().value); };
    test("its failure is kept") { expect(j.get_failure()!!.get_message()).should_be("top level failure"); };
    for(i : decimal = 0; i < 1000 && handler.seen.read() == before; i++) { delay(1); }
    test("the handler was called once") { expect(handler.seen.read()).should_be(before + 1); };
    test("with the exception") { expect(handler.last_message).should_be("top level failure"); };
    test("coroutine_exceptions counted it") { expect_true(coroutine_exceptions.count() >= 1); };

    // a failure does not disturb other top level coroutines
    hits.write(0);
    ok := launch({ -> delay(5); hits.increment(); });
    ok.join();
    test("global_scope is a supervisor") { expect(hits.read()).should_be(1); };

    g := global_scope.launch({ -> hits.increment(); });
    g.join();
    test("global_scope.launch") { expect(hits.read()).should_be(2); };
}

/**
 * Runs the coroutine machinery on ONE thread before any worker thread exists.
 *
 * Why: the JIT compiles a function when it has been called ten times, and the
 * runtime crashes now and then when that moment comes while several threads
 * are inside the same function (see known_bugs/lib_coroutines_jit_fiber_frames).
 * After this warm up the library functions are compiled already when the
 * multi threaded tests start. It checks nothing itself.
 */
def warm_up() {
    run_blocking({ ->
        for(i : decimal = 0; i < 30; i++) {
            w := async<int>.start({ -> (int) delay(1); return 10; });
            w.await();
            k := launch({ -> yield(); delay(1); });
            k.join();
            c := launch({ -> delay(1000000); });
            yield();
            c.cancel_and_join();
            coroutine_scope({ -> launch({ -> yield(); }); });
            supervisor_scope({ -> launch({ -> yield(); }); });
        }
    });
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_coroutines_core") {
        coroutine_exceptions.set_handler(handler);
        warm_up();

        test_launch_and_join();
        test_run_blocking();
        test_async();
        test_cancellation();
        test_scopes();
        test_completion_handlers();
        test_timeouts();
        test_dispatchers();
        test_uncaught();
        test_scale();
    };
    finish_tests("lib_coroutines_core");
}
