mod main;

import ( std.testing, std.io, std.data )

/**
 * std.data sqlite (sql/sqlite.sharp): a database in memory - tables, values
 * in and out, rows as objects, transactions, mistakes.
 *
 * It needs the SQLite library of the system (every Linux has libsqlite3.so.0,
 * Windows has winsqlite3.dll). On a machine without it the case says so and
 * passes: there is nothing to test.
 */

class user {
    id : _int64 = 0;
    name : string = "";
    age : _int64 = 0;
    admin : bool = false;
    score : decimal = 0;
    email : string?;
    created_at : string = "";
}

class counted {
    n : _int64 = 0;
}

def main(args: string[]) {
    show_only_failures();
    there : bool = true;
    try { sqlite.version(); } catch(none: throwable) { there = false; }
    tests("lib_data_sqlite") {
        if(!there) {
            test("(this machine has no SQLite library: nothing to test)") { expect_true(1); };
        } else {
            test("the library says its version") { expect_true(io_strings.starts_with(sqlite.version(), "3.")); };
            db := sqlite.memory();
            test("open") { expect_true(db.is_open()); };
            db.run("create table users (id integer primary key, name text not null, age integer, admin integer, score real, email text, created_at text)");
            test("a new table is there") { expect_true(db.has_table("users")); };
            test("another is not") { expect_false(db.has_table("nothing")); };

            // ---------------------------------------------------------------- values in
            changed : _int64 = db.sql("insert into users (name, age, admin, score, email, created_at) values (?, ?, ?, ?, ?, ?)")
                .with("ann").with(31).with(true).with(9.5).with_null().with("2026-01-02").run();
            test("insert: one row changed") { expect(changed).should_be(1); };
            test("insert: the id it got") { expect(db.last_id()).should_be(1); };
            db.sql("insert into users (name, age, admin, score, email, created_at) values (?, ?, ?, ?, ?, ?)")
                .with("bob").with(17).with(false).with(4.25).with("bob@example.com").with("2026-02-03").run();
            db.sql("insert into users (name, age, admin, score, email, created_at) values (?, ?, ?, ?, ?, ?)")
                .with("Robert'); drop table users; --").with(40).with(false).with(0).with("").with("").run();
            test("a value is a value, whatever is in it") { expect(db.sql("select count(*) from users").number()).should_be(3); };
            test("... and comes back as it went in") { expect(db.sql("select name from users where id = ?").with(3).text()).should_be("Robert'); drop table users; --"); };

            // ---------------------------------------------------------------- rows out
            rows := db.sql("select * from users order by id").rows();
            test("rows: how many") { expect(rows.size()).should_be(3); };
            first := rows.at(0);
            test("rows: columns") { expect(first.size()).should_be(7); };
            test("rows: a column's name") { expect(first.name_at(1)).should_be("name"); };
            test("rows: text") { expect(first.text("name")).should_be("ann"); };
            test("rows: number") { expect(first.number("age")).should_be(31); };
            test("rows: a decimal") { expect(first.number("score")).should_be(9.5); };
            test("rows: flag") { expect_true(first.flag("admin")); };
            test("rows: null") { expect_true(first.is_null("email")); };
            test("rows: not null") { expect_false(rows.at(1).is_null("email")); };
            test("rows: text of null is empty") { expect(first.text("email")).should_be(""); };
            test("rows: by position") { expect(first.text_at(1) + first.number_at(2)).should_be("ann31"); };
            test("rows: a number as text") { expect(first.text("age")).should_be("31"); };
            test("rows: the name whatever its capitals") { expect(first.text("NAME")).should_be("ann"); };
            test("rows: has") { expect_true(first.has("score") && !first.has("nothing")); };
            no_column : decimal = 0;
            try { first.text("nothing"); } catch(wrong: sql_exception) { no_column = 1; }
            test("rows: a column that is not there") { expect_true(no_column); };
            test("rows: as json") { expect(rows.at(1).to_json().string_or("email", "")).should_be("bob@example.com"); };

            adults := db.sql("select * from users where age >= ? order by age").with(18).all<user>();
            test("objects: how many") { expect(adults.size()).should_be(2); };
            test("objects: a text") { expect(adults.at(0).name).should_be("ann"); };
            test("objects: a number") { expect(adults.at(0).age).should_be(31); };
            test("objects: a bool") { expect_true(adults.at(0).admin); };
            test("objects: a decimal") { expect(adults.at(0).score).should_be(9.5); };
            test("objects: null leaves the field") { expect_true(adults.at(0).email == null); };
            test("objects: created_at") { expect(adults.at(0).created_at).should_be("2026-01-02"); };
            test("objects: the id") { expect(adults.at(1).id).should_be(3); };
            bob := db.sql("select * from users where name = ?").with("bob").first<user>();
            test("first: there") { expect(bob!!.email!!).should_be("bob@example.com"); };
            test("first: not there") { expect_true(db.sql("select * from users where name = ?").with("nobody").first<user>() == null); };
            test("first_row: not there") { expect_true(db.sql("select * from users where id = 99").first_row() == null); };
            test("number of no row") { expect(db.sql("select age from users where id = 99").number()).should_be(0); };
            test("text of no row") { expect(db.sql("select name from users where id = 99").text()).should_be(""); };
            total := db.sql("select count(*) as n from users").first<counted>();
            test("a computed column fills a field") { expect(total!!.n).should_be(3); };
            ages : decimal = 0;
            db.sql("select age from users").each { ages = ages + it.number_at(0); };
            test("each") { expect(ages).should_be(88); };

            // ---------------------------------------------------------------- bytes
            db.run("create table files (name text, data blob)");
            raw := new _int8[5];
            raw[0] = 0; raw[1] = 255; raw[2] = 10; raw[3] = 0; raw[4] = 65;
            db.sql("insert into files values (?, ?)").with("f").with_bytes(raw).run();
            stored := db.sql("select data from files").first_row()!!.bytes("data");
            test("bytes: the length") { expect(sizeof(stored)).should_be(5); };
            test("bytes: with zeros inside") { expect_true(stored!![0] == 0 && (stored!![1] & 0xFF) == 255 && stored!![2] == 10 && stored!![3] == 0 && stored!![4] == 65); };

            // ---------------------------------------------------------------- changes and transactions
            test("update: rows changed") { expect(db.sql("update users set age = age + 1 where age < ?").with(100).run()).should_be(3); };
            test("changed()") { expect(db.changed()).should_be(3); };
            db.transaction {
                db.sql("insert into users (name) values (?)").with("in a transaction").run();
                db.sql("insert into users (name) values (?)").with("and another").run();
            };
            test("a transaction that ends is kept") { expect(db.sql("select count(*) from users").number()).should_be(5); };
            thrown : decimal = 0;
            try {
                db.transaction {
                    db.sql("insert into users (name) values (?)").with("never kept").run();
                    db.sql("insert into users (name) values (?)").with_null().run();       // name is `not null`: throws
                };
            } catch(failed: sql_exception) { thrown = 1; }
            test("a transaction that throws ...") { expect_true(thrown); };
            test("... is undone as a whole") { expect(db.sql("select count(*) from users").number()).should_be(5); };
            db.transaction {
                db.sql("delete from users where name = ?").with("and another").run();
                db.transaction { db.sql("delete from users where name = ?").with("in a transaction").run(); };
            };
            test("a transaction inside a transaction") { expect(db.sql("select count(*) from users").number()).should_be(3); };
            test("several statements in one run") { expect(db.run("create table a (x); insert into a values (1); insert into a values ('semi;colon'); insert into a values (3)")).should_be(1); };
            test("... all ran") { expect(db.sql("select count(*) from a").number()).should_be(3); };
            test("... a ; in quotes is not the end") { expect(db.sql("select x from a where rowid = 2").text()).should_be("semi;colon"); };

            // ---------------------------------------------------------------- mistakes
            said : string = "";
            try { db.run("selec * from users"); } catch(wrong: sql_exception) { said = wrong.get_message(); }
            test("SQL that is not SQL: SQLite's words") { expect_true(io_strings.contains(said, "syntax error")); };
            test("... and the statement") { expect_true(io_strings.contains(said, "selec * from users")); };
            said = "";
            try { db.sql("select * from missing_table").rows(); } catch(wrong: sql_exception) { said = wrong.get_message(); }
            test("a table that is not there") { expect_true(io_strings.contains(said, "no such table")); };
            said = "";
            try { db.sql("select * from users where id = ? and age = ?").with(1).rows(); } catch(wrong: sql_exception) { said = wrong.get_message(); }
            test("too few values") { expect_true(io_strings.contains(said, "2 `?` and was given 1")); };
            said = "";
            try { db.sql("select * from users").with(1).rows(); } catch(wrong: sql_exception) { said = wrong.get_message(); }
            test("too many values") { expect_true(io_strings.contains(said, "0 `?` and was given 1")); };
            test("the database works after mistakes") { expect(db.sql("select count(*) from users").number()).should_be(3); };

            db.close();
            test("closed") { expect_false(db.is_open()); };
            db.close();
            said = "";
            try { db.run("select 1"); } catch(wrong: sql_exception) { said = wrong.get_message(); }
            test("a closed database refuses") { expect_true(io_strings.contains(said, "closed")); };

            // ---------------------------------------------------------------- a file
            place : string = "sqlite_case_test.db";
            new file(place).remove();
            on_disk := sqlite.open(place);
            on_disk.run("create table notes (text)");
            on_disk.sql("insert into notes values (?)").with("kept").run();
            on_disk.close();
            again := sqlite.open(place);
            test("a file keeps what was written") { expect(again.sql("select text from notes").text()).should_be("kept"); };
            again.close();
            new file(place).remove();
        }
    };
    finish_tests("lib_data_sqlite");
}
