mod main;

import ( std.testing, std.io )

/**
 * AN ARRAY'S LENGTH CHANGES WHEN `realloc` MAKES THE ARRAY LONGER.
 *
 * With -O the optimizer once took a length for something that never changes:
 * `expand()` below is small enough to be put inline, and then the length read
 * before the `realloc` was used again after it - the bag grew once, to 8, then
 * asked for 8 again and wrote past its end.
 */
class bag {
    private count : _int64;
    private data : _int64[]?;

    bag() { data = new _int64[4]; }

    private def expand() {
        realloc(data!!, sizeof(data) + (sizeof(data) >> 4) + 4);
    }

    def add(element: _int64) {
        if(count >= sizeof(data))
            expand();
        data[count++] = element;
    }

    def size() : _int64 { return count; }
    def room() : _int64 { return sizeof(data); }
    def at(index: _int64) : _int64 { return data[index]; }
}

/** the sum of an array that a call inside the loop makes shorter: the loop must see the new length */
def sum_while_shrinking(numbers: _int64[]) : _int64 {
    total : _int64 = 0;
    for(i : _int64 = 0; i < sizeof(numbers); i++) {
        if(i == 2) { realloc(numbers, 4); }
        total += numbers[i];
    }
    return total;
}

def main(args: string[]) {
    show_only_failures();
    tests("arrays_grown_inline") {
        b := new bag();
        rooms := "";
        for(i : _int64 = 0; i < 40; i++) {
            b.add(i);
            if(i % 8 == 7) { rooms = rooms + b.room() + " "; }
        }
        test("forty were added") { expect(b.size()).should_be(40); };
        test("the room grew each time it ran out") { expect(rooms).should_be("8 16 26 36 42 "); };
        total : _int64 = 0;
        for(i : _int64 = 0; i < b.size(); i++) { total += b.at(i); }
        test("every element is there") { expect(total).should_be(780); };

        numbers := new _int64[10];
        for(i : _int64 = 0; i < 10; i++) { numbers[i] = i + 1; }
        test("a loop over an array that gets shorter stops at its new end") { expect(sum_while_shrinking(numbers)).should_be(10); };
        test("...and the array is the shorter one") { expect(sizeof(numbers)).should_be(4); };
    };
    finish_tests("arrays_grown_inline");
}
