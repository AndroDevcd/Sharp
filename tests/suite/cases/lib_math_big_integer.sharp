mod main;

import ( std.testing, std.math )

/**
 * std.math - big_integer (lib/support/0.4.0/std/math/numbers/big_integer.sharp):
 * arbitrary precision whole numbers. Values are compared as decimal text.
 */

def text_of(n: big_integer): string {
    return n.to_string()!!;
}

def big(text: string): big_integer {
    return new big_integer(text);
}

def check_construction() {
    test("of(0)") { expect(text_of(big_integer.of(0))).should_be("0"); };
    test("of(42)") { expect(text_of(big_integer.of(42))).should_be("42"); };
    test("of(-42)") { expect(text_of(big_integer.of(0 - 42))).should_be("-42"); };
    test("of(one limb limit)") { expect(text_of(big_integer.of(9999999))).should_be("9999999"); };
    test("of(two limbs)") { expect(text_of(big_integer.of(10000000))).should_be("10000000"); };
    test("of(inner zeros are padded)") { expect(text_of(big_integer.of(50000003))).should_be("50000003"); };
    test("of(2^53)") { expect(text_of(big_integer.of(9007199254740992))).should_be("9007199254740992"); };
    safe : decimal = 9007199254740991;          // (a large literal cannot follow a minus sign: known bug)
    test("of(-(2^53 - 1))") { expect(text_of(big_integer.of(0 - safe))).should_be("-9007199254740991"); };
    test("zero()") { expect(text_of(big_integer.zero())).should_be("0"); };
    test("one()") { expect(text_of(big_integer.one())).should_be("1"); };
    test("ten()") { expect(text_of(big_integer.ten())).should_be("10"); };

    test("text") { expect(text_of(big("123456789012345678901234567890"))).should_be("123456789012345678901234567890"); };
    test("negative text") { expect(text_of(big("-5"))).should_be("-5"); };
    test("plus sign") { expect(text_of(big("+77"))).should_be("77"); };
    test("leading zeros") { expect(text_of(big("000123"))).should_be("123"); };
    test("-0 is 0") { expect(text_of(big("-0"))).should_be("0"); };
    test("zeros inside") { expect(text_of(big("1000000000000000000000"))).should_be("1000000000000000000000"); };
    test("parse") { expect(text_of(big_integer.parse("98765432109876543210"))).should_be("98765432109876543210"); };
    test("copy") { expect(text_of(new big_integer(big("-31415926535897932384626")))).should_be("-31415926535897932384626"); };

    caught : decimal = 0;
    try { big(""); } catch(e: number_format_exception) { caught++; }
    try { big("-"); } catch(e: number_format_exception) { caught++; }
    try { big("12a4"); } catch(e: number_format_exception) { caught++; }
    try { big("1.5"); } catch(e: number_format_exception) { caught++; }
    try { big(" 12"); } catch(e: number_format_exception) { caught++; }
    test("bad text throws number_format_exception") { expect(caught).should_be(5); };
    caught = 0;
    try { big_integer.of(1.5); } catch(e: illegal_argument_exception) { caught++; }
    try { big_integer.of(9007199254740994); } catch(e: illegal_argument_exception) { caught++; }
    test("of() rejects fractions and inexact numbers") { expect(caught).should_be(2); };
}

def check_add_subtract() {
    a := big("123456789012345678901234567890");
    b := big("987654321");

    test("a + b") { expect(text_of(a + b)).should_be("123456789012345678902222222211"); };
    test("a - b") { expect(text_of(a - b)).should_be("123456789012345678900246913569"); };
    test("b - a") { expect(text_of(b - a)).should_be("-123456789012345678900246913569"); };
    test("a - a") { expect(text_of(a - a)).should_be("0"); };
    test("carry through every limb") { expect(text_of(big("99999999999999999999999999999") + big_integer.one())).should_be("100000000000000000000000000000"); };
    test("borrow through every limb") { expect(text_of(big("100000000000000000000000000000") - big_integer.one())).should_be("99999999999999999999999999999"); };
    test("negative + positive") { expect(text_of(big("-100") + big("30"))).should_be("-70"); };
    test("positive + negative") { expect(text_of(big("30") + big("-100"))).should_be("-70"); };
    test("negative + negative") { expect(text_of(big("-100") + big("-30"))).should_be("-130"); };
    test("negative - negative") { expect(text_of(big("-100") - big("-130"))).should_be("30"); };
    test("a + 1 (number)") { expect(text_of(a + 1)).should_be("123456789012345678901234567891"); };
    test("a - 1 (number)") { expect(text_of(a - 1)).should_be("123456789012345678901234567889"); };
    test("0 - 5 (number)") { expect(text_of(big_integer.zero() - 5)).should_be("-5"); };
    test("-a") { expect(text_of(-a)).should_be("-123456789012345678901234567890"); };
    test("negate twice") { expect(text_of(a.negate().negate())).should_be("123456789012345678901234567890"); };
    test("negate zero") { expect(text_of(big_integer.zero().negate())).should_be("0"); };
    test("abs") { expect(text_of(big("-12345678901234567890").abs())).should_be("12345678901234567890"); };
    test("operands are unchanged") { expect(text_of(a)).should_be("123456789012345678901234567890"); };
}

def check_multiply() {
    a := big("123456789012345678901234567890");
    b := big("987654321");

    test("a * b + 1") { expect(text_of(a * b + 1)).should_be("121932631124828532112482853211126352691"); };
    test("a * a") { expect(text_of(a * a)).should_be("15241578753238836750495351562536198787501905199875019052100"); };
    test("a * 0") { expect(text_of(a * big_integer.zero())).should_be("0"); };
    test("a * 1") { expect(text_of(a * big_integer.one())).should_be("123456789012345678901234567890"); };
    test("a * -1") { expect(text_of(a * (0 - 1))).should_be("-123456789012345678901234567890"); };
    test("negative * negative") { expect(text_of(big("-12") * big("-12"))).should_be("144"); };
    test("negative * positive") { expect(text_of(big("-12") * big("12"))).should_be("-144"); };
    test("(10^14 - 1)^2") { expect(text_of(big("99999999999999") * big("99999999999999"))).should_be("9999999999999800000000000001"); };
    test("largest limb cubed") { expect(text_of(big("9999999") * big("9999999") * big("9999999"))).should_be("999999700000029999999"); };
    test("a * 2 (number)") { expect(text_of(a * 2)).should_be("246913578024691357802469135780"); };

    test("2^200") { expect(text_of(big_integer.of(2).pow(200))).should_be("1606938044258990275541962092341162602522202993782792835301376"); };
    test("3^100") { expect(text_of(big_integer.of(3).pow(100))).should_be("515377520732011331036461129765621272702107522001"); };
    test("x^0") { expect(text_of(a.pow(0))).should_be("1"); };
    test("x^1") { expect(text_of(a.pow(1))).should_be("123456789012345678901234567890"); };
    test("(-2)^3") { expect(text_of(big_integer.of(0 - 2).pow(3))).should_be("-8"); };
    test("(-2)^4") { expect(text_of(big_integer.of(0 - 2).pow(4))).should_be("16"); };
    test("10^30") { expect(text_of(big_integer.ten().pow(30))).should_be("1000000000000000000000000000000"); };
    try {
        a.pow(0 - 1);
        test("pow(-1)") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("pow(-1) throws") { };
    }

    test("factorial(0)") { expect(text_of(big_integer.factorial(0))).should_be("1"); };
    test("factorial(10)") { expect(text_of(big_integer.factorial(10))).should_be("3628800"); };
    test("factorial(25)") { expect(text_of(big_integer.factorial(25))).should_be("15511210043330985984000000"); };
    test("factorial(30)") { expect(text_of(big_integer.factorial(30))).should_be("265252859812191058636308480000000"); };
    test("fibonacci(0)") { expect(text_of(big_integer.fibonacci(0))).should_be("0"); };
    test("fibonacci(1)") { expect(text_of(big_integer.fibonacci(1))).should_be("1"); };
    test("fibonacci(100)") { expect(text_of(big_integer.fibonacci(100))).should_be("354224848179261915075"); };
    test("fibonacci(200)") { expect(text_of(big_integer.fibonacci(200))).should_be("280571172992510140037611932413038677189525"); };
    try {
        big_integer.factorial(0 - 1);
        test("factorial(-1)") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("factorial(-1) throws") { };
    }
}

def check_divide() {
    a := big("123456789012345678901234567890");
    b := big("987654321");

    test("a / b") { expect(text_of(a / b)).should_be("124999998873437499901"); };
    test("a % b") { expect(text_of(a % b)).should_be("574845669"); };
    test("small / large") { expect(text_of(b / a)).should_be("0"); };
    test("small % large") { expect(text_of(b % a)).should_be("987654321"); };
    test("a / a") { expect(text_of(a / a)).should_be("1"); };
    test("a % a") { expect(text_of(a % a)).should_be("0"); };
    test("a / 10^7") { expect(text_of(a / big("10000000"))).should_be("12345678901234567890123"); };
    test("a % 10^7") { expect(text_of(a % big("10000000"))).should_be("4567890"); };
    test("a / 20 digit divisor") { expect(text_of(a / big("12345678901234567890"))).should_be("10000000000"); };
    test("a % 20 digit divisor") { expect(text_of(a % big("12345678901234567890"))).should_be("1234567890"); };
    test("(10^30 + 7) / (10^15 + 3)") { expect(text_of(big("1000000000000000000000000000007") / big("1000000000000003"))).should_be("999999999999997"); };
    test("(10^30 + 7) % (10^15 + 3)") { expect(text_of(big("1000000000000000000000000000007") % big("1000000000000003"))).should_be("16"); };
    test("10^21 / (10^7 - 1)") { expect(text_of(big("1000000000000000000000") / big("9999999"))).should_be("100000010000001"); };
    test("10^21 % (10^7 - 1)") { expect(text_of(big("1000000000000000000000") % big("9999999"))).should_be("1"); };
    test("(10^28 - 1) / (10^14 + 1)") { expect(text_of(big("9999999999999999999999999999") / big("100000000000001"))).should_be("99999999999999"); };
    test("(10^28 - 1) % (10^14 + 1)") { expect(text_of(big("9999999999999999999999999999") % big("100000000000001"))).should_be("0"); };
    test("a / 2 (number)") { expect(text_of(a / 2)).should_be("61728394506172839450617283945"); };
    test("a % 1000 (number)") { expect(text_of(a % 1000)).should_be("890"); };

    // rounding toward zero; the remainder has the sign of the dividend
    test("7 / 2") { expect(text_of(big("7") / big("2"))).should_be("3"); };
    test("-7 / 2") { expect(text_of(big("-7") / big("2"))).should_be("-3"); };
    test("7 / -2") { expect(text_of(big("7") / big("-2"))).should_be("-3"); };
    test("-7 / -2") { expect(text_of(big("-7") / big("-2"))).should_be("3"); };
    test("7 % 2") { expect(text_of(big("7") % big("2"))).should_be("1"); };
    test("-7 % 2") { expect(text_of(big("-7") % big("2"))).should_be("-1"); };
    test("7 % -2") { expect(text_of(big("7") % big("-2"))).should_be("1"); };
    test("-7 % -2") { expect(text_of(big("-7") % big("-2"))).should_be("-1"); };
    test("modulo of a negative number") { expect(text_of(big("-7").modulo(big("3")))).should_be("2"); };
    test("modulo of a positive number") { expect(text_of(big("7").modulo(big("3")))).should_be("1"); };

    both := a.divide_and_remainder(b);
    test("divide_and_remainder [0]") { expect(text_of(both[0])).should_be("124999998873437499901"); };
    test("divide_and_remainder [1]") { expect(text_of(both[1])).should_be("574845669"); };
    // quotient * divisor + remainder gives the dividend back
    test("q * b + r == a") { expect(text_of(both[0] * b + both[1])).should_be("123456789012345678901234567890"); };

    caught : decimal = 0;
    try { a / big_integer.zero(); } catch(e: division_by_zero_exception) { caught++; }
    try { a % big_integer.zero(); } catch(e: division_by_zero_exception) { caught++; }
    try { a.divide_and_remainder(big_integer.zero()); } catch(e: division_by_zero_exception) { caught++; }
    try { a / 0; } catch(e: division_by_zero_exception) { caught++; }
    test("division by zero throws") { expect(caught).should_be(4); };
    try {
        a.modulo(big("-3"));
        test("modulo(-3)") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("modulo(-3) throws") { };
    }

    test("gcd") { expect(text_of(a.gcd(big("9876543210")))).should_be("90"); };
    test("gcd(2^100, 6^50) is 2^50") { expect(text_of(big_integer.of(2).pow(100).gcd(big_integer.of(6).pow(50)))).should_be("1125899906842624"); };
    test("gcd with zero") { expect(text_of(big("-42").gcd(big_integer.zero()))).should_be("42"); };
    test("sqrt") { expect(text_of(a.sqrt())).should_be("351364182882014"); };
    test("sqrt(10^40)") { expect(text_of(big_integer.ten().pow(40).sqrt())).should_be("100000000000000000000"); };
    test("sqrt(0)") { expect(text_of(big_integer.zero().sqrt())).should_be("0"); };
    test("sqrt(15)") { expect(text_of(big("15").sqrt())).should_be("3"); };
    test("sqrt(16)") { expect(text_of(big("16").sqrt())).should_be("4"); };
    try {
        big("-4").sqrt();
        test("sqrt(-4)") { fail_test("no exception"); };
    } catch(e: arithmetic_exception) {
        test("sqrt(-4) throws") { };
    }
}

def check_compare() {
    a := big("123456789012345678901234567890");
    b := big("987654321");
    same := big("123456789012345678901234567890");
    minus := big("-123456789012345678901234567890");

    test("compare_to larger") { expect(a.compare_to(b)).should_be(1); };
    test("compare_to smaller") { expect(b.compare_to(a)).should_be(0 - 1); };
    test("compare_to equal") { expect(a.compare_to(same)).should_be(0); };
    test("negative < positive") { expect(minus.compare_to(b)).should_be(0 - 1); };
    test("positive > negative") { expect(b.compare_to(minus)).should_be(1); };
    test("among negatives the larger magnitude is smaller") { expect(minus.compare_to(big("-5"))).should_be(0 - 1); };
    test("same length, different top limb") { expect(big("20000000000000").compare_to(big("10000000000001"))).should_be(1); };
    test("==") { expect_true((a == same)); };
    test("== different") { expect_false((a == b)); };
    test("!=") { expect_true((a != b)); };
    test("<") { expect_true((b < a)); };
    test("< reversed") { expect_false((a < b)); };
    test(">") { expect_true((a > b)); };
    test("<=") { expect_true((a <= same)); };
    test(">=") { expect_true((a >= b)); };
    test("equals_var") { expect_true(b.equals_var(987654321)); };
    test("equals_var different") { expect_false(b.equals_var(5)); };

    test("sign positive") { expect(a.sign()).should_be(1); };
    test("sign negative") { expect(minus.sign()).should_be(0 - 1); };
    test("sign zero") { expect(big_integer.zero().sign()).should_be(0); };
    test("is_zero") { expect_true(big_integer.zero().is_zero()); };
    test("is_zero of a") { expect_false(a.is_zero()); };
    test("is_negative") { expect_true(minus.is_negative()); };
    test("is_negative of a") { expect_false(a.is_negative()); };
    test("is_even") { expect_true(a.is_even()); };
    test("is_odd") { expect_true(b.is_odd()); };
    test("is_odd of an even number") { expect_false(a.is_odd()); };
    test("digit_count") { expect(a.digit_count()).should_be(30); };
    test("digit_count of 0") { expect(big_integer.zero().digit_count()).should_be(1); };
    test("digit_count ignores the sign") { expect(big("-1000").digit_count()).should_be(4); };
    test("digit_count 10^7") { expect(big("10000000").digit_count()).should_be(8); };

    test("to_var") { expect(b.to_var()).should_be(987654321); };
    safe : decimal = 9007199254740991;
    test("to_var negative") { expect(big("-9007199254740991").to_var()).should_be(0 - safe); };
    // 1.2345678901234568 * 10^29, checked after scaling down by 10^15 twice
    test("to_var of a large number") { expect(a.to_var() / 1000000000000000 / 1000000000000000).should_be_near(0.12345678901234568, 0.000000000000001); };
    test("fits_in_var") { expect_true(b.fits_in_var()); };
    test("2^53 fits") { expect_true(big("9007199254740992").fits_in_var()); };
    test("2^53 + 1 does not fit") { expect_false(big("9007199254740993").fits_in_var()); };
    test("30 digits do not fit") { expect_false(a.fits_in_var()); };
    test("to_var_exact") { expect(b.to_var_exact()).should_be(987654321); };
    try {
        a.to_var_exact();
        test("to_var_exact of a large number") { fail_test("no exception"); };
    } catch(e: overflow_exception) {
        test("to_var_exact of a large number throws") { };
    }
    test("equal numbers have equal hashes") { expect_true((a.hash() == same.hash())); };
    test("the sign changes the hash") { expect_false((a.hash() == minus.hash())); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_math_big_integer") {
        check_construction();
        check_add_subtract();
        check_multiply();
        check_divide();
        check_compare();
    };
    finish_tests("lib_math_big_integer");
}
