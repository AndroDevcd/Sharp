mod main;

import ( testing, std.math )

/**
 * std.math - the free functions on native numbers:
 * constants.sharp, native_math.sharp, comparison.sharp, rounding.sharp,
 * powers.sharp, trigonometry.sharp, interpolation.sharp, number_text.sharp,
 * and the functions that were already in math.sharp.
 */

def check_constants() {
    expect_near("PI_VALUE", PI_VALUE, 3.14159265358979, 0.00000000000001);
    expect("PI_VALUE == PI", PI_VALUE, PI.value);
    expect("E_VALUE == E", E_VALUE, E.value);
    expect_near("TAU", TAU, 6.28318530717958, 0.00000000000001);
    expect_near("HALF_PI", HALF_PI * 2, PI_VALUE, 0.000000000000001);
    expect_near("QUARTER_PI", QUARTER_PI * 4, PI_VALUE, 0.000000000000001);
    expect_near("SQRT2 squared", SQRT2 * SQRT2, 2, 0.000000000000001);
    expect_near("SQRT1_2 squared", SQRT1_2 * SQRT1_2, 0.5, 0.000000000000001);
    expect_near("SQRT3 squared", SQRT3 * SQRT3, 3, 0.000000000000001);
    expect_near("LN2", LN2, 0.693147180559945, 0.000000000000001);
    expect_near("LN10", LN10, 2.30258509299404, 0.00000000000001);
    expect_near("LOG2E * LN2", LOG2E * LN2, 1, 0.000000000000001);
    expect_near("LOG10E * LN10", LOG10E * LN10, 1, 0.000000000000001);
    expect_near("GOLDEN_RATIO", GOLDEN_RATIO * GOLDEN_RATIO, GOLDEN_RATIO + 1, 0.000000000000001);
    expect_near("RADIANS_PER_DEGREE", RADIANS_PER_DEGREE * 180, PI_VALUE, 0.000000000000001);
    expect_near("DEGREES_PER_RADIAN", DEGREES_PER_RADIAN * PI_VALUE, 180, 0.0000000000001);
    expect_true("1 + EPSILON is above 1", 1 + EPSILON > 1);
    half_gap : decimal = EPSILON / 2;
    expect("1 + EPSILON / 2 is 1", 1 + half_gap, 1);
    expect("MAX_SAFE_INTEGER", MAX_SAFE_INTEGER, 9007199254740991);
    expect("MIN_SAFE_INTEGER", MIN_SAFE_INTEGER + MAX_SAFE_INTEGER, 0);
    expect_true("MIN_SAFE_INTEGER is far below zero", MIN_SAFE_INTEGER < 0 - 9000000000000000);
}

/* a fractional literal on the LEFT of a variable (it used to lose its fraction) */
def half_minus(v: decimal): decimal { return 0.5 - v; }
def half_times(v: decimal): decimal { return 0.5 * v; }
def one_and_half_plus(v: decimal): decimal { return 1.5 + v; }

def check_native() {
    expect("0.5 - v", half_minus(0.25), 0.25);
    expect("0.5 * v", half_times(3), 1.5);
    expect("1.5 + v", one_and_half_plus(2.25), 3.75);

    expect_near("sin_of(pi / 2)", sin_of(HALF_PI), 1, 0.000000000001);
    expect_near("cos_of(pi)", cos_of(PI_VALUE), 0 - 1, 0.000000000001);
    expect_near("tan_of(pi / 4)", tan_of(QUARTER_PI), 1, 0.000000000001);
    expect_near("exp_of(1)", exp_of(1), 2.718281828459045, 0.000000000001);
    expect_near("ln(e)", ln(E_VALUE), 1, 0.000000000001);
    expect("ln(1)", ln(1), 0);
    expect("power(2, 10)", power(2, 10), 1024);
    expect_near("power(2, 0.5)", power(2, 0.5), 1.4142135623730951, 0.000000000001);
    expect("square_root(144)", square_root(144), 12);
    expect("floor_of(2.7)", floor_of(2.7), 2);
    expect("floor_of(-2.5)", floor_of(0 - 2.5), 0 - 3);
    expect("ceil_of(2.1)", ceil_of(2.1), 3);
    expect("ceil_of(-2.5)", ceil_of(0 - 2.5), 0 - 2);
    expect("absolute(-3)", absolute(0 - 3), 3);
    expect("absolute(3)", absolute(3), 3);
    expect("math_call fmod", math_call(7.5, 2, 0x13), 1.5);

    // the functions that were already in math.sharp (double objects)
    expect_near("sin(0)", sin(0).value, 0, 0.000000000001);
    expect("sqrt(81)", sqrt(81).value, 9);
    expect("pow(3, 4)", pow(3, 4).value, 81);
    expect("floor(4.9)", floor(4.9).value, 4);
    expect("ceil(4.1)", ceil(4.1).value, 5);
    expect("fmod(7.5, 2)", fmod(7.5, 2).value, 1.5);
    expect("round(2.5)", round(2.5).value, 3);
    expect("round(2.4)", round(2.4).value, 2);
    expect("round(-2.7)", round(0 - 2.7).value, 0 - 3);
    expect_true("is_nan(NaN)", is_nan(NaN).value);
    expect_false("is_nan(1)", is_nan(1).value);
    expect_true("is_infinite(1 / 0)", is_infinite(POSITIVE_INFINITY).value);
    expect_false("is_infinite(5)", is_infinite(5).value);
}

def check_comparison() {
    expect("sign(-4.2)", sign(0 - 4.2), 0 - 1);
    expect("sign(0)", sign(0), 0);
    expect("sign(17)", sign(17), 1);
    expect("min(3, 7)", min(3, 7), 3);
    expect("min(7, 3)", min(7, 3), 3);
    expect("min(-1, -2)", min(0 - 1, 0 - 2), 0 - 2);
    expect("max(3, 7)", max(3, 7), 7);
    expect("max(-1, -2)", max(0 - 1, 0 - 2), 0 - 1);
    expect("min of three", min(5, 2, 9), 2);
    expect("max of three", max(5, 2, 9), 9);
    expect_true("min with NaN is NaN", is_nan(min(1, NaN.value)).value);

    values := new decimal[5];
    values[0] = 4; values[1] = 0 - 7; values[2] = 12; values[3] = 0; values[4] = 3.5;
    expect("min_of", min_of(values), 0 - 7);
    expect("max_of", max_of(values), 12);
    try {
        min_of(new decimal[0]);
        fail("min_of(empty)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("min_of(empty) throws");
    }
    try {
        max_of(new decimal[0]);
        fail("max_of(empty)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("max_of(empty) throws");
    }

    expect("clamp above", clamp(15, 0, 10), 10);
    expect("clamp below", clamp(0 - 3, 0, 10), 0);
    expect("clamp inside", clamp(4, 0, 10), 4);
    try {
        clamp(1, 10, 0);
        fail("clamp(low > high)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("clamp(low > high) throws");
    }

    expect_true("is_finite(1.5)", is_finite(1.5).value);
    expect_false("is_finite(infinity)", is_finite(POSITIVE_INFINITY.value).value);
    expect_false("is_finite(NaN)", is_finite(NaN.value).value);
    expect_true("is_whole(-7)", is_whole(0 - 7).value);
    expect_false("is_whole(7.25)", is_whole(7.25).value);
    expect_false("is_whole(infinity)", is_whole(POSITIVE_INFINITY.value).value);
    expect_true("approx_equals(0.1 + 0.2, 0.3)", approx_equals(0.1 + 0.2, 0.3, 0.000000001).value);
    expect_false("approx_equals(1, 1.1)", approx_equals(1, 1.1, 0.01).value);
    expect("copy_sign(3, -0.5)", copy_sign(3, 0 - 0.5), 0 - 3);
    expect("copy_sign(-3, 2)", copy_sign(0 - 3, 2), 3);
    expect("compare(1, 2)", compare(1, 2), 0 - 1);
    expect("compare(2, 1)", compare(2, 1), 1);
    expect("compare(2, 2)", compare(2, 2), 0);
}

def check_rounding() {
    expect("trunc(2.9)", trunc(2.9), 2);
    expect("trunc(-2.9)", trunc(0 - 2.9), 0 - 2);
    expect("fract(2.75)", fract(2.75), 0.75);
    expect("fract(-2.75)", fract(0 - 2.75), 0 - 0.75);
    expect("round_half_away(2.5)", round_half_away(2.5), 3);
    expect("round_half_away(-2.5)", round_half_away(0 - 2.5), 0 - 3);
    expect("round_half_away(2.4)", round_half_away(2.4), 2);
    expect("round_half_away(-2.4)", round_half_away(0 - 2.4), 0 - 2);
    expect("round_half_even(2.5)", round_half_even(2.5), 2);
    expect("round_half_even(3.5)", round_half_even(3.5), 4);
    expect("round_half_even(-2.5)", round_half_even(0 - 2.5), 0 - 2);
    expect("round_half_even(-3.5)", round_half_even(0 - 3.5), 0 - 4);
    expect("round_half_even(2.6)", round_half_even(2.6), 3);
    expect("round_half_even(2.4)", round_half_even(2.4), 2);
    expect_near("round_to(3.14159, 2)", round_to(3.14159, 2), 3.14, 0.000000000001);
    expect_near("round_to(-3.14159, 3)", round_to(0 - 3.14159, 3), 0 - 3.142, 0.000000000001);
    expect("round_to(2.5, 0)", round_to(2.5, 0), 3);
    expect("round_to(1234, -2)", round_to(1234, 0 - 2), 1200);
    expect("round_to(1250, -2)", round_to(1250, 0 - 2), 1300);
    expect_near("floor_to(3.149, 2)", floor_to(3.149, 2), 3.14, 0.000000000001);
    expect_near("ceil_to(3.141, 2)", ceil_to(3.141, 2), 3.15, 0.000000000001);
    expect("round_to_multiple(17, 5)", round_to_multiple(17, 5), 15);
    expect("round_to_multiple(18, 5)", round_to_multiple(18, 5), 20);
    expect("round_to_multiple(0.3, 0.25)", round_to_multiple(0.3, 0.25), 0.25);

    expect("int_div(7, 2)", int_div(7, 2), 3);
    expect("int_div(-7, 2)", int_div(0 - 7, 2), 0 - 3);
    expect("int_rem(7, 3)", int_rem(7, 3), 1);
    expect("int_rem(-7, 3)", int_rem(0 - 7, 3), 0 - 1);
    expect("floor_div(7, 2)", floor_div(7, 2), 3);
    expect("floor_div(-7, 2)", floor_div(0 - 7, 2), 0 - 4);
    expect("floor_div(7, -2)", floor_div(7, 0 - 2), 0 - 4);
    expect("floor_div(-7, -2)", floor_div(0 - 7, 0 - 2), 3);
    expect("floor_mod(7, 3)", floor_mod(7, 3), 1);
    expect("floor_mod(-7, 3)", floor_mod(0 - 7, 3), 2);
    expect("floor_mod(7, -3)", floor_mod(7, 0 - 3), 0 - 2);
    expect("floor_mod(-7, -3)", floor_mod(0 - 7, 0 - 3), 0 - 1);
    expect("floor_mod(6, 3)", floor_mod(6, 3), 0);
    expect("ceil_div(7, 2)", ceil_div(7, 2), 4);
    expect("ceil_div(-7, 2)", ceil_div(0 - 7, 2), 0 - 3);
    expect("ceil_div(8, 2)", ceil_div(8, 2), 4);

    caught : decimal = 0;
    try { int_div(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { int_rem(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { floor_div(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { floor_mod(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { ceil_div(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    try { round_to_multiple(1, 0); } catch(e: division_by_zero_exception) { caught++; }
    expect("the six divisions by zero throw", caught, 6);
}

def check_powers() {
    expect("square(-7)", square(0 - 7), 49);
    expect("cube(-3)", cube(0 - 3), 0 - 27);
    expect("cbrt(27)", cbrt(27), 3);
    expect("cbrt(-8)", cbrt(0 - 8), 0 - 2);
    expect("cbrt(0)", cbrt(0), 0);
    expect_near("cbrt(2)", cbrt(2), 1.2599210498948732, 0.000000000001);
    expect("cbrt(1000000)", cbrt(1000000), 100);
    expect_near("nth_root(32, 5)", nth_root(32, 5), 2, 0.000000000001);
    expect_near("nth_root(-27, 3)", nth_root(0 - 27, 3), 0 - 3, 0.000000000001);
    expect_near("nth_root(81, 4)", nth_root(81, 4), 3, 0.000000000001);
    try {
        nth_root(5, 0);
        fail("nth_root(5, 0)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("nth_root(5, 0) throws");
    }
    expect("hypot(3, 4)", hypot(3, 4), 5);
    expect("hypot(-5, 12)", hypot(0 - 5, 12), 13);
    expect("hypot(0, 0)", hypot(0, 0), 0);
    expect_near("hypot(1, 1)", hypot(1, 1), 1.4142135623730951, 0.000000000001);
    expect_near("hypot(2, 3, 6)", hypot(2, 3, 6), 7, 0.000000000001);
    expect("log2(8)", log2(8), 3);
    expect("log2(1)", log2(1), 0);
    expect("log2(1024)", log2(1024), 10);
    expect("log2(0.25)", log2(0.25), 0 - 2);
    expect_near("log2(10)", log2(10), 3.321928094887362, 0.000000000001);
    expect_near("log_base(81, 3)", log_base(81, 3), 4, 0.000000000001);
    expect_near("log_base(0.001, 10)", log_base(0.001, 10), 0 - 3, 0.000000000001);
    try {
        log_base(8, 1);
        fail("log_base(8, 1)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("log_base(8, 1) throws");
    }
    expect("exp2(10)", exp2(10), 1024);
    expect("int_pow(3, 20)", int_pow(3, 20), 3486784401);
    expect("int_pow(2, 52)", int_pow(2, 52), 4503599627370496);
    expect("int_pow(-2, 3)", int_pow(0 - 2, 3), 0 - 8);
    expect("int_pow(7, 0)", int_pow(7, 0), 1);
    expect("int_pow(0, 0)", int_pow(0, 0), 1);
    expect("int_pow(1.5, 2)", int_pow(1.5, 2), 2.25);
    try {
        int_pow(2, 0 - 1);
        fail("int_pow(2, -1)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("int_pow(2, -1) throws");
    }
    expect("isqrt(17)", isqrt(17), 4);
    expect("isqrt(16)", isqrt(16), 4);
    expect("isqrt(15)", isqrt(15), 3);
    expect("isqrt(0)", isqrt(0), 0);
    expect("isqrt(10^12 - 1)", isqrt(999999999999), 999999);
    try {
        isqrt(0 - 1);
        fail("isqrt(-1)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("isqrt(-1) throws");
    }
    expect_true("is_perfect_square(144)", is_perfect_square(144).value);
    expect_false("is_perfect_square(145)", is_perfect_square(145).value);
    expect_false("is_perfect_square(-4)", is_perfect_square(0 - 4).value);
    expect_true("is_perfect_square(0)", is_perfect_square(0).value);
}

def check_trigonometry() {
    expect_near("to_radians(180)", to_radians(180), 3.141592653589793, 0.000000000001);
    expect_near("to_degrees(pi / 2)", to_degrees(HALF_PI), 90, 0.000000000001);
    expect_near("asin_of(1)", asin_of(1), HALF_PI, 0.000000000001);
    expect_near("acos_of(1)", acos_of(1), 0, 0.000000000001);
    expect_near("acos_of(-1)", acos_of(0 - 1), PI_VALUE, 0.000000000001);
    expect_near("atan_of(1)", atan_of(1), QUARTER_PI, 0.000000000001);
    expect_near("atan2(1, 1)", atan2(1, 1), QUARTER_PI, 0.000000000001);
    expect_near("atan2(1, -1)", atan2(1, 0 - 1), 2.356194490192345, 0.000000000001);
    expect_near("atan2(-1, 0)", atan2(0 - 1, 0), 0 - HALF_PI, 0.000000000001);
    expect_near("atan2(0, -1)", atan2(0, 0 - 1), PI_VALUE, 0.000000000001);
    expect_near("sinh_of(1)", sinh_of(1), 1.1752011936438014, 0.000000000001);
    expect_near("cosh_of(1)", cosh_of(1), 1.5430806348152437, 0.000000000001);
    expect_near("tanh_of(1)", tanh_of(1), 0.7615941559557649, 0.000000000001);
    expect_near("sec(0)", sec(0), 1, 0.000000000001);
    expect_near("sec(pi / 3)", sec(PI_VALUE / 3), 2, 0.000000000001);
    expect_near("csc(pi / 6)", csc(PI_VALUE / 6), 2, 0.000000000001);
    expect_near("cot(pi / 4)", cot(QUARTER_PI), 1, 0.000000000001);
    expect_near("asinh(sinh(1))", asinh(1.1752011936438014), 1, 0.000000000001);
    expect_near("asinh(-sinh(1))", asinh(0 - 1.1752011936438014), 0 - 1, 0.000000000001);
    expect("asinh(0)", asinh(0), 0);
    expect_near("acosh(cosh(1))", acosh(1.5430806348152437), 1, 0.000000000001);
    expect("acosh(1)", acosh(1), 0);
    expect_true("acosh(0.5) is NaN", is_nan(acosh(0.5)).value);
    expect_near("atanh(tanh(1))", atanh(0.7615941559557649), 1, 0.000000000001);
    expect("atanh(0)", atanh(0), 0);
    expect_near("normalize_radians(-pi / 2)", normalize_radians(0 - HALF_PI), 4.71238898038469, 0.000000000001);
    expect_near("normalize_radians(5 pi)", normalize_radians(5 * PI_VALUE), PI_VALUE, 0.000000000001);
    expect("normalize_degrees(-90)", normalize_degrees(0 - 90), 270);
    expect("normalize_degrees(725)", normalize_degrees(725), 5);
    expect("normalize_degrees(360)", normalize_degrees(360), 0);
    expect("angle_difference_degrees(350, 10)", angle_difference_degrees(350, 10), 20);
    expect("angle_difference_degrees(10, 350)", angle_difference_degrees(10, 350), 0 - 20);
    expect("angle_difference_degrees(0, 180)", angle_difference_degrees(0, 180), 180);
}

def check_interpolation() {
    expect("lerp at 0", lerp(10, 20, 0), 10);
    expect("lerp at 1", lerp(10, 20, 1), 20);
    expect("lerp at 0.25", lerp(10, 20, 0.25), 12.5);
    expect("lerp beyond", lerp(10, 20, 1.5), 25);
    expect("lerp downward", lerp(20, 10, 0.5), 15);
    expect("inverse_lerp", inverse_lerp(10, 20, 12.5), 0.25);
    expect("map_range", map_range(5, 0, 10, 100, 200), 150);
    expect("map_range reversed", map_range(2, 0, 10, 10, 0), 8);
    expect("map_range celsius to fahrenheit", map_range(37, 0, 100, 32, 212), 98.6);
    expect("smoothstep below", smoothstep(0, 10, 0 - 5), 0);
    expect("smoothstep above", smoothstep(0, 10, 50), 1);
    expect("smoothstep middle", smoothstep(0, 10, 5), 0.5);
    expect("smoothstep quarter", smoothstep(0, 1, 0.25), 0.15625);
    expect("wrap(370, 0, 360)", wrap(370, 0, 360), 10);
    expect("wrap(-1, 0, 5)", wrap(0 - 1, 0, 5), 4);
    expect("wrap(7, 2, 5)", wrap(7, 2, 5), 4);
    expect("wrap(5, 0, 5)", wrap(5, 0, 5), 0);

    caught : decimal = 0;
    try { inverse_lerp(3, 3, 1); } catch(e: arithmetic_exception) { caught++; }
    try { map_range(1, 2, 2, 0, 1); } catch(e: arithmetic_exception) { caught++; }
    try { smoothstep(1, 1, 1); } catch(e: arithmetic_exception) { caught++; }
    try { wrap(1, 5, 5); } catch(e: illegal_argument_exception) { caught++; }
    expect("empty ranges throw", caught, 4);
}

def check_text() {
    expect_str("whole", number_to_string(3), "3");
    expect_str("negative whole", number_to_string(0 - 42), "-42");
    expect_str("zero", number_to_string(0), "0");
    expect_str("2.5", number_to_string(2.5), "2.5");
    expect_str("-0.5", number_to_string(0 - 0.5), "-0.5");
    expect_str("0.1", number_to_string(0.1), "0.1");
    expect_str("3.14159", number_to_string(3.14159), "3.14159");
    expect_str("0.001", number_to_string(0.001), "0.001");
    expect_str("large whole", number_to_string(9007199254740991), "9007199254740991");
    expect_str("NaN", number_to_string(NaN.value), "NaN");
    expect_str("Infinity", number_to_string(POSITIVE_INFINITY.value), "Infinity");
    expect_str("-Infinity", number_to_string(NEGATIVE_INFINITY.value), "-Infinity");
    expect_str("fixed 2", number_to_fixed(3.14159, 2), "3.14");
    expect_str("fixed pads", number_to_fixed(2, 3), "2.000");
    expect_str("fixed 0", number_to_fixed(2.5, 0), "3");
    expect_str("fixed negative", number_to_fixed(0 - 1.005, 1), "-1.0");
    try {
        number_to_fixed(1, 0 - 1);
        fail("number_to_fixed(1, -1)", "no exception");
    } catch(e: illegal_argument_exception) {
        pass("number_to_fixed(1, -1) throws");
    }
}

def main(args: string[]) {
    check_constants();
    check_native();
    check_comparison();
    check_rounding();
    check_powers();
    check_trigonometry();
    check_interpolation();
    check_text();
    finish("lib_math_functions");
}
