mod main;
import ( std.testing, std.math )
def main(args: string[]) {
    show_only_failures();
    tests("lib_math_abs_plain_number") {
        test("abs(3.5)") { expect(abs(3.5)).should_be(3.5); };
        test("abs(0 - 4)") { expect(abs(0 - 4)).should_be(4); };
        test("abs(0 - 2.5)") { expect(abs(0 - 2.5)).should_be(2.5); };
    };
    finish_tests("lib_math_abs_plain_number");
}
