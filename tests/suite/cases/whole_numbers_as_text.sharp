mod main;

import ( testing )

/**
 * A whole number becomes text digit for digit, however large it is.
 * (Until VM 4.0.14 the way to text went through a decimal, which holds a
 * whole number exactly only up to 2^53 = 9007199254740992: a larger one lost
 * its low digits - 9007199254740993 came out as 9007199254740992 - with
 * `"" + n`, with "$n" and with to_string(). The number itself was right.)
 */
def main(args: string[]) {
    // built at run time, so that nothing is worked out by the compiler
    n : _int64 = 9007199254740990;
    n = n + 3;

    expect_str("text + number", "" + n, "9007199254740993");
    expect_str("number in text", "$n", "9007199254740993");
    expect_str("to_string of a long", new long(n).to_string()!!, "9007199254740993");
    s := "n=";
    s += n;
    expect_str("text += number", s, "n=9007199254740993");

    negative : _int64 = 0 - n;
    expect_str("a negative one", "" + negative, "-9007199254740993");

    // the largest and the smallest 64-bit numbers
    most : _int64 = 9223372036854775800;
    most = most + 7;
    expect_str("the largest _int64", "" + most, "9223372036854775807");
    least : _int64 = 0 - most;
    least = least - 1;
    expect_str("the smallest _int64", "" + least, "-9223372036854775808");

    // an unsigned number above the largest signed one
    wide : _uint64 = most;
    wide = wide + 10;
    expect_str("an _uint64 above 2^63", "" + wide, "9223372036854775817");
    expect_str("to_string of a ulong", new ulong(wide).to_string()!!, "9223372036854775817");

    // the small ones are what they were
    small : _int32 = 0 - 42;
    expect_str("an _int32", "" + small, "-42");
    short_one : _int16 = 1234;
    expect_str("an _int16", "" + short_one, "1234");
    zero : _int64 = 0;
    expect_str("zero", "" + zero, "0");
    expect_str("to_string of an int", new int(7).to_string()!!, "7");
    expect_str("a decimal is still a decimal", "" + 2.5, "2.5");

    finish("whole_numbers_as_text");
}
