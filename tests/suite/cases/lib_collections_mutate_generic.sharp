mod main;

import ( testing )

/**
 * KNOWN BUG: `mutate` on a GENERIC class. This file is EXPECTED TO FAIL (it
 * does not compile).
 *
 * `mutate list { ... }` adds members to std list<T>. They are there on the
 * instantiations the library itself also makes (list<string>, list<int>),
 * but missing on an instantiation that only this program makes (list<card>):
 *
 *     error S8017: could not resolve symbol `is_blank(): unknown`
 *
 * It makes no difference whether the mutate block is in the program, in a
 * library file, in module std or in another module.
 *
 * Because of this std.collections offers the extra list operations as static
 * helpers (lists<T>) instead of adding them to list with mutate.
 */

class card { rank : decimal; }

class shelf { label : string = "empty"; }

mutate list {
    // a field the class did not have, private to it like any of its own
    private touched : decimal = 0;

    def is_blank() : decimal { return size().value == 0; }
    def touch() { touched = touched + 1; }
    def touches() : decimal { return touched; }
}

// the same on a class that is not generic
mutate shelf {
    private opened : decimal = 0;

    def open() : decimal { opened = opened + 1; return opened; }
}

def main(args: string[]) {
    a := new list<string>();
    expect("list<string> (also instantiated inside the library)", a.is_blank(), 1);
    b := new list<card>();
    expect("list<card> (only instantiated here)", b.is_blank(), 1);
    // a field added by mutate: each list has its own
    b.touch();
    b.touch();
    expect("a mutated field on list<card>", b.touches(), 2);
    expect("...is separate for every list", a.touches(), 0);
    c := new list<shelf>();
    c.touch();
    expect("a third kind of list, made last", c.touches(), 1);

    s := new shelf();
    s.open();
    expect("a mutated field on a plain class", s.open(), 2);

    finish("lib_collections_mutate_generic");
}
