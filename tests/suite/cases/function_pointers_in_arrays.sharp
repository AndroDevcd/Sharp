mod main;
import ( testing )
def twice(x: decimal): decimal { return x * 2; }
def thrice(x: decimal): decimal { return x * 3; }
def main(args: string[]) {
    fns : (decimal)(decimal)[] = new (decimal)(decimal)[2];
    fns[0] = twice;
    fns[1] = thrice;
    expect("called straight out of an array", fns[0](4), 8);
    expect("second", fns[1](4), 12);
    finish("function_pointers_in_arrays");
}
