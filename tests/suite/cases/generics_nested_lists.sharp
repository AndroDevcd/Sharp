mod main;
import ( testing )
def main(args: string[]) {
    rows := new list<list<string> >();
    row := new list<string>();
    row.add("x");
    rows.add(row);
    expect("list of lists", rows.at(0).size().value, 1);
    tight := new list<list<string>>();
    expect("without the space", tight.size().value, 0);
    finish("generics_nested_lists");
}
