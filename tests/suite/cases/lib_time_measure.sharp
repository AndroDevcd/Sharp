mod main;

import ( testing )

/**
 * std/time.sharp: time.measure and the unit conversions.
 *
 * time.measure used to convert the two absolute clock readings to the wanted
 * unit and subtract afterwards, which is wrong by up to one whole unit. It
 * now subtracts first and converts the difference with time.nano_to_unit.
 *
 * The real clock is only checked for properties that always hold.
 */

def nothing() {
}

def main(args: string[]) {
    took : var = 0;
    took = time.measure(milliseconds, { -> nothing(); }).value;
    expect_true("measure(milliseconds) of nothing is not negative", took >= 0);
    expect_true("...and far below a minute", took < 60000);
    took = time.measure(nanoseconds, { -> nothing(); }).value;
    expect_true("measure(nanoseconds) is not negative", took >= 0);
    expect_true("measure(nanoseconds) is below a minute", took < 60000000000);
    took = time.measureMills({ -> nothing(); }).value;
    expect_true("measureMills", took >= 0 && took < 60000);
    took = time.measure(seconds, { -> nothing(); }).value;
    expect("measure(seconds) of nothing is 0", took, 0);

    // the conversion measure() uses: the difference is converted, with the fraction dropped
    expect("1,999,999 ns is 1 ms", time.nano_to_unit(1999999, milliseconds).value, 1);
    expect("999,999 ns is 0 ms", time.nano_to_unit(999999, milliseconds).value, 0);
    expect("2,500,000,000 ns is 2 s", time.nano_to_unit(2500000000, seconds).value, 2);
    expect("1,999 ns is 1 microsecond", time.nano_to_unit(1999, microseconds).value, 1);
    expect("nanoseconds are left alone", time.nano_to_unit(1234567, nanoseconds).value, 1234567);

    // the functions that were there before still work
    expect("nano_to_micro", time.nano_to_micro(5000).value, 5);
    expect("nano_to_mills", time.nano_to_mills(5000000).value, 5);
    expect("nano_to_secs", time.nano_to_secs(5000000000).value, 5);
    expect_true("nano_time is after 2020", time.nano_time().value > 1577836800000000000);
    expect_true("mills_time is after 2020", time.mills_time().value > 1577836800000);
    expect_true("micro_time is after 2020", time.micro_time().value > 1577836800000000);

    finish("lib_time_measure");
}
