mod main;

import ( testing, std.text )

/**
 * std.text - laying text out and reshaping it:
 *   - text_align         left / right / center / justify / fit / rule
 *   - text_wrap          wrap, wrap_paragraphs, fill, indent, dedent
 *   - text_table         columns with headers, alignment, with and without a frame
 *   - case_format        snake_case, camelCase, PascalCase, kebab-case ...
 *   - string_similarity  levenshtein, hamming, common prefix / suffix, jaro ...
 *   - template           {name} placeholders
 */

def show(parts: string[]): string {
    joined := string.join("|", parts);
    if(joined.is_empty()) return string.of_int(sizeof(parts)) + ":";
    return string.of_int(sizeof(parts)) + ":" + joined;
}

def main(args: string[]) {
    // ---- text_align
    expect_str("left", text_align.left("abc", 7), "abc    ");
    expect_str("left with a fill character", text_align.left("abc", 6, '.'), "abc...");
    expect_str("right", text_align.right("abc", 7), "    abc");
    expect_str("right with a fill character", text_align.right("42", 6, '0'), "000042");
    expect_str("center", text_align.center("abc", 7), "  abc  ");
    expect_str("center, the odd space goes right", text_align.center("ab", 5), " ab  ");
    expect_str("center with a fill character", text_align.center(" title ", 15, '='), "==== title ====");
    expect_str("left never cuts", text_align.left("abcdef", 3), "abcdef");
    expect_str("right to the exact width", text_align.right("abc", 3), "abc");
    expect_str("left of \"\"", text_align.left("", 3), "   ");
    expect_str("center with width 0", text_align.center("", 0), "");
    expect_str("justify", text_align.justify("a b c", 9), "a   b   c");
    expect_str("justify, uneven gaps", text_align.justify("a b c", 8), "a   b  c");
    expect_str("justify of one word", text_align.justify("word", 10), "word");
    expect_str("justify when it is already too wide", text_align.justify("aaa bbb", 5), "aaa bbb");
    expect_str("justify collapses existing gaps", text_align.justify("a    b", 4), "a  b");
    expect_str("justify of \"\"", text_align.justify("", 5), "");
    expect_str("fit pads", text_align.fit("ab", 5), "ab   ");
    expect_str("fit cuts", text_align.fit("abcdefgh", 5), "ab...");
    expect_str("fit to the exact width", text_align.fit("abcde", 5), "abcde");
    expect_str("fit below three", text_align.fit("abcdefgh", 2), "ab");
    expect_str("rule", text_align.rule('-', 5), "-----");
    expect_str("rule of nothing", text_align.rule('-', 0), "");
    try {
        text_align.left("a", 0 - 1);
        fail("negative width", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("negative width");
    }

    // ---- text_wrap
    fox : string = "the quick brown fox jumps";
    expect_str("wrap", show(text_wrap.wrap(fox, 10)), "3:the quick|brown fox|jumps");
    expect_str("wrap, everything fits", show(text_wrap.wrap(fox, 80)), "1:the quick brown fox jumps");
    expect_str("wrap to the exact width", show(text_wrap.wrap("ab cd", 5)), "1:ab cd");
    expect_str("wrap one short of the width", show(text_wrap.wrap("ab cd", 4)), "2:ab|cd");
    expect_str("wrap of \"\"", show(text_wrap.wrap("", 10)), "0:");
    expect_str("wrap of blanks", show(text_wrap.wrap("   \n ", 10)), "0:");
    expect_str("wrap cuts a long word", show(text_wrap.wrap("abcdefghij", 4)), "3:abcd|efgh|ij");
    expect_str("wrap with a long word in the middle", show(text_wrap.wrap("a abcdefg b", 3)), "4:a|abc|def|g b");
    expect_str("wrap treats line ends as spaces", show(text_wrap.wrap("ab\ncd\tef", 20)), "1:ab cd ef");
    expect_str("wrap with width 1", show(text_wrap.wrap("ab c", 1)), "3:a|b|c");
    expect_str("fill", text_wrap.fill(fox, 10), "the quick\nbrown fox\njumps");
    expect_str("fill of \"\"", text_wrap.fill("", 10), "");
    paragraphs : string = "one two\nthree\n\n\nfour five";
    expect_str("wrap_paragraphs", show(text_wrap.wrap_paragraphs(paragraphs, 9)), "4:one two|three||four five");
    expect_str("fill keeps paragraphs", text_wrap.fill(paragraphs, 20), "one two three\n\nfour five");
    expect_str("fill with prefixes", text_wrap.fill("aa bb cc dd", 7, "- ", "  "), "- aa bb\n  cc dd");
    expect_str("indent", text_wrap.indent("a\nb", "  "), "  a\n  b");
    expect_str("indent leaves empty lines empty", text_wrap.indent("a\n\nb", "> "), "> a\n\n> b");
    expect_str("indent by a number of spaces", text_wrap.indent_by("a\nb", 3), "   a\n   b");
    expect_str("dedent", text_wrap.dedent("    a\n      b\n    c"), "a\n  b\nc");
    expect_str("dedent ignores blank lines", text_wrap.dedent("  a\n\n    b"), "a\n\n  b");
    expect_str("dedent with nothing to remove", text_wrap.dedent("a\n  b"), "a\n  b");
    expect("max_line_length", text_wrap.max_line_length("ab\nabcd\nabc"), 4);
    expect("max_line_length of \"\"", text_wrap.max_line_length(""), 0);
    try {
        text_wrap.wrap(fox, 0);
        fail("wrap with width 0", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("wrap with width 0");
    }
    long_words := fox.repeat(200);
    expect_true("wrap of a long text: no line is too long", text_wrap.max_line_length(text_wrap.fill(long_words, 30)) <= 30);

    // ---- text_table
    table := new text_table(new string[] { "item", "qty", "price" });
    table.align(1, text_table.right).align(2, text_table.right);
    table.add_row(new string[] { "pear", "3", "1.20" });
    table.add_row(new string[] { "melon", "12", "24.00" });
    expect("row_count", table.row_count(), 2);
    expect("column_count", table.column_count(), 3);
    expect_str("cell", table.cell(1, 0), "melon");
    expect_str("render with a frame", table.render(),
        "+-------+-----+-------+\n| item  | qty | price |\n+-------+-----+-------+\n| pear  |   3 |  1.20 |\n| melon |  12 | 24.00 |\n+-------+-----+-------+\n");
    table.set_border(false);
    expect_str("render without a frame", table.render(),
        "item   qty  price\n-----  ---  -----\npear     3   1.20\nmelon   12  24.00\n");
    expect("render_lines", sizeof(table.render_lines()), 4);
    centered := new text_table(new string[] { "a", "name" });
    centered.align(1, text_table.center).add_row(new string[] { "1" }).add_row(new string[] { "22", "x" });
    expect_str("a short row is filled up, and center", centered.render(),
        "+----+------+\n| a  | name |\n+----+------+\n| 1  |      |\n| 22 |  x   |\n+----+------+\n");
    centered.clear();
    expect("clear", centered.row_count(), 0);
    expect_str("a table with no rows", centered.render(), "+---+------+\n| a | name |\n+---+------+\n+---+------+\n");
    try {
        centered.add_row(new string[] { "1", "2", "3" });
        fail("a row that is too long", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("a row that is too long");
    }
    try {
        centered.align(2, text_table.left);
        fail("align of a missing column", "did not throw");
    } catch(e: out_of_bounds_exception) {
        pass("align of a missing column");
    }
    try {
        new text_table(new string[0]);
        fail("a table without columns", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("a table without columns");
    }

    // ---- case_format
    expect_str("split_words camel", show(case_format.split_words("parseHttpRequest")), "3:parse|http|request");
    expect_str("split_words with an abbreviation", show(case_format.split_words("parseHTTPRequest_v2")), "4:parse|http|request|v2");
    expect_str("split_words of mixed separators", show(case_format.split_words("some_mixedInput-here now")), "5:some|mixed|input|here|now");
    expect_str("split_words keeps digits with their word", show(case_format.split_words("utf8Text")), "2:utf8|text");
    expect_str("split_words of \"\"", show(case_format.split_words("")), "0:");
    expect_str("split_words of separators only", show(case_format.split_words("__--")), "0:");
    expect_str("to_snake", case_format.to_snake("parseHttpRequest"), "parse_http_request");
    expect_str("to_snake of PascalCase", case_format.to_snake("ParseHTTPRequest"), "parse_http_request");
    expect_str("to_snake of snake_case", case_format.to_snake("already_snake"), "already_snake");
    expect_str("to_camel", case_format.to_camel("parse_http_request"), "parseHttpRequest");
    expect_str("to_camel of kebab-case", case_format.to_camel("max-size-limit"), "maxSizeLimit");
    expect_str("to_pascal", case_format.to_pascal("parse-http-request"), "ParseHttpRequest");
    expect_str("to_kebab", case_format.to_kebab("ParseHTTPRequest"), "parse-http-request");
    expect_str("to_screaming_snake", case_format.to_screaming_snake("max size"), "MAX_SIZE");
    expect_str("to_title", case_format.to_title("max_size"), "Max Size");
    expect_str("to_sentence", case_format.to_sentence("maxSizeLimit"), "Max size limit");
    expect_str("to_dot", case_format.to_dot("maxSize"), "max.size");
    expect_str("to_snake of one word", case_format.to_snake("word"), "word");
    expect_str("to_camel of \"\"", case_format.to_camel(""), "");
    expect_str("to_snake with leading separators", case_format.to_snake("__private_name"), "private_name");
    expect("word_count", case_format.word_count("parseHTTPRequest"), 3);
    expect_str("snake to camel and back", case_format.to_snake(case_format.to_camel("one_two_three")), "one_two_three");

    // ---- string_similarity
    expect("levenshtein", string_similarity.levenshtein("kitten", "sitting"), 3);
    expect("levenshtein of equal strings", string_similarity.levenshtein("same", "same"), 0);
    expect("levenshtein to \"\"", string_similarity.levenshtein("abc", ""), 3);
    expect("levenshtein from \"\"", string_similarity.levenshtein("", "abcd"), 4);
    expect("levenshtein of two \"\"", string_similarity.levenshtein("", ""), 0);
    expect("levenshtein, one insertion", string_similarity.levenshtein("cat", "cart"), 1);
    expect("levenshtein, all different", string_similarity.levenshtein("abc", "xyz"), 3);
    expect("levenshtein is symmetric", string_similarity.levenshtein("sitting", "kitten"), 3);
    expect("levenshtein counts a swap as two", string_similarity.levenshtein("form", "from"), 2);
    expect("damerau_levenshtein counts a swap as one", string_similarity.damerau_levenshtein("form", "from"), 1);
    expect("damerau_levenshtein without swaps", string_similarity.damerau_levenshtein("kitten", "sitting"), 3);
    expect("hamming", string_similarity.hamming("karolin", "kathrin"), 3);
    expect("hamming of equal strings", string_similarity.hamming("abc", "abc"), 0);
    try {
        string_similarity.hamming("abc", "ab");
        fail("hamming of different lengths", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("hamming of different lengths");
    }
    expect_near("similarity", string_similarity.similarity("kitten", "sitting"), 0.571428, 0.00001);
    expect("similarity of equal strings", string_similarity.similarity("abc", "abc"), 1);
    expect("similarity of two \"\"", string_similarity.similarity("", ""), 1);
    expect("similarity with nothing in common", string_similarity.similarity("abc", "xyz"), 0);
    expect("common_prefix_length", string_similarity.common_prefix_length("interstellar", "internet"), 5);
    expect_str("common_prefix", string_similarity.common_prefix("interstellar", "internet"), "inter");
    expect_str("common_prefix, none", string_similarity.common_prefix("abc", "xbc"), "");
    expect_str("common_prefix when one is a prefix", string_similarity.common_prefix("abc", "abcdef"), "abc");
    expect("common_suffix_length", string_similarity.common_suffix_length("walking", "talking"), 6);
    expect_str("common_suffix", string_similarity.common_suffix("walking", "talking"), "alking");
    expect_str("common_suffix, none", string_similarity.common_suffix("abc", "abd"), "");
    expect_str("common_prefix_of", string_similarity.common_prefix_of(new string[] { "flower", "flow", "flight" }), "fl");
    expect_str("common_prefix_of one string", string_similarity.common_prefix_of(new string[] { "alone" }), "alone");
    expect_str("longest_common_substring", string_similarity.longest_common_substring("xabcdy", "zabcdw"), "abcd");
    expect_str("longest_common_substring, none", string_similarity.longest_common_substring("abc", "xyz"), "");
    expect_str("longest_common_substring with \"\"", string_similarity.longest_common_substring("abc", ""), "");
    expect("lcs_length", string_similarity.lcs_length("AGGTAB", "GXTXAYB"), 4);
    expect("lcs_length, none", string_similarity.lcs_length("abc", "xyz"), 0);
    expect_near("jaro", string_similarity.jaro("MARTHA", "MARHTA"), 0.944444, 0.00001);
    expect("jaro of equal strings", string_similarity.jaro("abc", "abc"), 1);
    expect("jaro with nothing in common", string_similarity.jaro("abc", "xyz"), 0);
    expect("jaro with \"\"", string_similarity.jaro("abc", ""), 0);
    expect_near("jaro_winkler", string_similarity.jaro_winkler("MARTHA", "MARHTA"), 0.961111, 0.00001);
    long_a := fox.repeat(8);
    long_b := long_a.replace_all("quick", "slow");
    expect("levenshtein of long strings", string_similarity.levenshtein(long_a, long_b), 40);

    // ---- template
    letter := new template("Dear {name}, your order {id} ships on {day}.");
    letter.put("name", "Ada").put_int("id", 1042).put("day", "Monday");
    expect_str("render", letter.render(), "Dear Ada, your order 1042 ships on Monday.");
    letter.put("day", "Friday");
    expect_str("put replaces a value", letter.render(), "Dear Ada, your order 1042 ships on Friday.");
    expect_true("has", letter.has("name"));
    expect_false("has of an unknown name", letter.has("nobody"));
    expect_str("value_of", letter.value_of("name", "?"), "Ada");
    expect_str("value_of with a fallback", letter.value_of("nobody", "?"), "?");
    expect_str("placeholders", show(letter.placeholders()), "3:name|id|day");
    letter.remove("day");
    expect_str("a missing value leaves the placeholder", letter.render(), "Dear Ada, your order 1042 ships on {day}.");
    letter.set_missing_value("(unknown)");
    expect_str("set_missing_value", letter.render(), "Dear Ada, your order 1042 ships on (unknown).");
    letter.set_strict(true);
    try {
        letter.render();
        fail("strict rendering with a missing value", "did not throw");
    } catch(e: not_found_exception) {
        expect_true("the message names the placeholder", e.get_message().contains("{day}"));
    }
    expect_str("doubled braces", new template("{{x}} is {x}").put("x", "1").render(), "{x} is 1");
    expect_str("spaces inside the braces", new template("{ x } and {x}").put("x", "1").render(), "1 and 1");
    expect_str("what is not a placeholder stays", new template("{} {a b} {x:y} {open").put("x", "1").render(), "{} {a b} {x:y} {open");
    expect_str("a placeholder used twice", new template("{a}{a}").put("a", "ha").render(), "haha");
    expect_str("values are not filled in again", new template("{a}").put("a", "{b}").put("b", "x").render(), "{b}");
    expect_str("a text without placeholders", new template("plain").render(), "plain");
    expect_str("an empty text", new template("").render(), "");
    expect_str("placeholders of plain text", show(new template("plain").placeholders()), "0:");
    expect_str("placeholders lists each name once", show(new template("{a} {b} {a}").placeholders()), "2:a|b");
    expect_str("put_number", new template("{price} EUR").put_number("price", 9.5, 2).render(), "9.50 EUR");
    expect_str("the static render", template.render("{a}+{b}", new string[] { "a", "b" }, new string[] { "1", "2" }), "1+2");
    expect_str("clear", letter.clear().set_strict(false).render(), "Dear (unknown), your order (unknown) ships on (unknown).");
    expect_str("source", new template("{a}").source(), "{a}");
    try {
        letter.put("", "x");
        fail("put with an empty name", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("put with an empty name");
    }
    try {
        letter.put_all(new string[] { "a" }, new string[0]);
        fail("put_all with different lengths", "did not throw");
    } catch(e: illegal_argument_exception) {
        pass("put_all with different lengths");
    }

    finish("lib_text_layout");
}
