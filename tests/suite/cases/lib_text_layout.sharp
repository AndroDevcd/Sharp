mod main;

import ( std.testing, std.text )

/**
 * std.text - laying text out and reshaping it:
 *   - text_align         left / right / center / justify / fit / rule
 *   - text_wrap          wrap, wrap_paragraphs, fill, indent, dedent
 *   - text_table         columns with headers, alignment, with and without a frame
 *   - case_format        snake_case, camelCase, PascalCase, kebab-case ...
 *   - string_similarity  levenshtein, hamming, common prefix / suffix, jaro ...
 *   - template           {name} placeholders
 */

def show(parts: string[]): string {
    joined := string.join("|", parts);
    if(joined.is_empty()) return string.of_int(sizeof(parts)) + ":";
    return string.of_int(sizeof(parts)) + ":" + joined;
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_layout") {
        // ---- text_align
        test("left") { expect(text_align.left("abc", 7)).should_be("abc    "); };
        test("left with a fill character") { expect(text_align.left("abc", 6, '.')).should_be("abc..."); };
        test("right") { expect(text_align.right("abc", 7)).should_be("    abc"); };
        test("right with a fill character") { expect(text_align.right("42", 6, '0')).should_be("000042"); };
        test("center") { expect(text_align.center("abc", 7)).should_be("  abc  "); };
        test("center, the odd space goes right") { expect(text_align.center("ab", 5)).should_be(" ab  "); };
        test("center with a fill character") { expect(text_align.center(" title ", 15, '=')).should_be("==== title ===="); };
        test("left never cuts") { expect(text_align.left("abcdef", 3)).should_be("abcdef"); };
        test("right to the exact width") { expect(text_align.right("abc", 3)).should_be("abc"); };
        test("left of \"\"") { expect(text_align.left("", 3)).should_be("   "); };
        test("center with width 0") { expect(text_align.center("", 0)).should_be(""); };
        test("justify") { expect(text_align.justify("a b c", 9)).should_be("a   b   c"); };
        test("justify, uneven gaps") { expect(text_align.justify("a b c", 8)).should_be("a   b  c"); };
        test("justify of one word") { expect(text_align.justify("word", 10)).should_be("word"); };
        test("justify when it is already too wide") { expect(text_align.justify("aaa bbb", 5)).should_be("aaa bbb"); };
        test("justify collapses existing gaps") { expect(text_align.justify("a    b", 4)).should_be("a  b"); };
        test("justify of \"\"") { expect(text_align.justify("", 5)).should_be(""); };
        test("fit pads") { expect(text_align.fit("ab", 5)).should_be("ab   "); };
        test("fit cuts") { expect(text_align.fit("abcdefgh", 5)).should_be("ab..."); };
        test("fit to the exact width") { expect(text_align.fit("abcde", 5)).should_be("abcde"); };
        test("fit below three") { expect(text_align.fit("abcdefgh", 2)).should_be("ab"); };
        test("rule") { expect(text_align.rule('-', 5)).should_be("-----"); };
        test("rule of nothing") { expect(text_align.rule('-', 0)).should_be(""); };
        try {
            text_align.left("a", 0 - 1);
            test("negative width") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("negative width") { };
        }

        // ---- text_wrap
        fox : string = "the quick brown fox jumps";
        test("wrap") { expect(show(text_wrap.wrap(fox, 10))).should_be("3:the quick|brown fox|jumps"); };
        test("wrap, everything fits") { expect(show(text_wrap.wrap(fox, 80))).should_be("1:the quick brown fox jumps"); };
        test("wrap to the exact width") { expect(show(text_wrap.wrap("ab cd", 5))).should_be("1:ab cd"); };
        test("wrap one short of the width") { expect(show(text_wrap.wrap("ab cd", 4))).should_be("2:ab|cd"); };
        test("wrap of \"\"") { expect(show(text_wrap.wrap("", 10))).should_be("0:"); };
        test("wrap of blanks") { expect(show(text_wrap.wrap("   \n ", 10))).should_be("0:"); };
        test("wrap cuts a long word") { expect(show(text_wrap.wrap("abcdefghij", 4))).should_be("3:abcd|efgh|ij"); };
        test("wrap with a long word in the middle") { expect(show(text_wrap.wrap("a abcdefg b", 3))).should_be("4:a|abc|def|g b"); };
        test("wrap treats line ends as spaces") { expect(show(text_wrap.wrap("ab\ncd\tef", 20))).should_be("1:ab cd ef"); };
        test("wrap with width 1") { expect(show(text_wrap.wrap("ab c", 1))).should_be("3:a|b|c"); };
        test("fill") { expect(text_wrap.fill(fox, 10)).should_be("the quick\nbrown fox\njumps"); };
        test("fill of \"\"") { expect(text_wrap.fill("", 10)).should_be(""); };
        paragraphs : string = "one two\nthree\n\n\nfour five";
        test("wrap_paragraphs") { expect(show(text_wrap.wrap_paragraphs(paragraphs, 9))).should_be("4:one two|three||four five"); };
        test("fill keeps paragraphs") { expect(text_wrap.fill(paragraphs, 20)).should_be("one two three\n\nfour five"); };
        test("fill with prefixes") { expect(text_wrap.fill("aa bb cc dd", 7, "- ", "  ")).should_be("- aa bb\n  cc dd"); };
        test("indent") { expect(text_wrap.indent("a\nb", "  ")).should_be("  a\n  b"); };
        test("indent leaves empty lines empty") { expect(text_wrap.indent("a\n\nb", "> ")).should_be("> a\n\n> b"); };
        test("indent by a number of spaces") { expect(text_wrap.indent_by("a\nb", 3)).should_be("   a\n   b"); };
        test("dedent") { expect(text_wrap.dedent("    a\n      b\n    c")).should_be("a\n  b\nc"); };
        test("dedent ignores blank lines") { expect(text_wrap.dedent("  a\n\n    b")).should_be("a\n\n  b"); };
        test("dedent with nothing to remove") { expect(text_wrap.dedent("a\n  b")).should_be("a\n  b"); };
        test("max_line_length") { expect(text_wrap.max_line_length("ab\nabcd\nabc")).should_be(4); };
        test("max_line_length of \"\"") { expect(text_wrap.max_line_length("")).should_be(0); };
        try {
            text_wrap.wrap(fox, 0);
            test("wrap with width 0") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("wrap with width 0") { };
        }
        long_words := fox.repeat(200);
        test("wrap of a long text: no line is too long") { expect_true(text_wrap.max_line_length(text_wrap.fill(long_words, 30)) <= 30); };

        // ---- text_table
        table := new text_table(new string[] { "item", "qty", "price" });
        table.align(1, text_table.right).align(2, text_table.right);
        table.add_row(new string[] { "pear", "3", "1.20" });
        table.add_row(new string[] { "melon", "12", "24.00" });
        test("row_count") { expect(table.row_count()).should_be(2); };
        test("column_count") { expect(table.column_count()).should_be(3); };
        test("cell") { expect(table.cell(1, 0)).should_be("melon"); };
        test("render with a frame") { expect(table.render()).should_be("+-------+-----+-------+\n| item  | qty | price |\n+-------+-----+-------+\n| pear  |   3 |  1.20 |\n| melon |  12 | 24.00 |\n+-------+-----+-------+\n"); };
        table.set_border(false);
        test("render without a frame") { expect(table.render()).should_be("item   qty  price\n-----  ---  -----\npear     3   1.20\nmelon   12  24.00\n"); };
        test("render_lines") { expect(sizeof(table.render_lines())).should_be(4); };
        centered := new text_table(new string[] { "a", "name" });
        centered.align(1, text_table.center).add_row(new string[] { "1" }).add_row(new string[] { "22", "x" });
        test("a short row is filled up, and center") { expect(centered.render()).should_be("+----+------+\n| a  | name |\n+----+------+\n| 1  |      |\n| 22 |  x   |\n+----+------+\n"); };
        centered.clear();
        test("clear") { expect(centered.row_count()).should_be(0); };
        test("a table with no rows") { expect(centered.render()).should_be("+---+------+\n| a | name |\n+---+------+\n+---+------+\n"); };
        try {
            centered.add_row(new string[] { "1", "2", "3" });
            test("a row that is too long") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("a row that is too long") { };
        }
        try {
            centered.align(2, text_table.left);
            test("align of a missing column") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("align of a missing column") { };
        }
        try {
            new text_table(new string[0]);
            test("a table without columns") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("a table without columns") { };
        }

        // ---- case_format
        test("split_words camel") { expect(show(case_format.split_words("parseHttpRequest"))).should_be("3:parse|http|request"); };
        test("split_words with an abbreviation") { expect(show(case_format.split_words("parseHTTPRequest_v2"))).should_be("4:parse|http|request|v2"); };
        test("split_words of mixed separators") { expect(show(case_format.split_words("some_mixedInput-here now"))).should_be("5:some|mixed|input|here|now"); };
        test("split_words keeps digits with their word") { expect(show(case_format.split_words("utf8Text"))).should_be("2:utf8|text"); };
        test("split_words of \"\"") { expect(show(case_format.split_words(""))).should_be("0:"); };
        test("split_words of separators only") { expect(show(case_format.split_words("__--"))).should_be("0:"); };
        test("to_snake") { expect(case_format.to_snake("parseHttpRequest")).should_be("parse_http_request"); };
        test("to_snake of PascalCase") { expect(case_format.to_snake("ParseHTTPRequest")).should_be("parse_http_request"); };
        test("to_snake of snake_case") { expect(case_format.to_snake("already_snake")).should_be("already_snake"); };
        test("to_camel") { expect(case_format.to_camel("parse_http_request")).should_be("parseHttpRequest"); };
        test("to_camel of kebab-case") { expect(case_format.to_camel("max-size-limit")).should_be("maxSizeLimit"); };
        test("to_pascal") { expect(case_format.to_pascal("parse-http-request")).should_be("ParseHttpRequest"); };
        test("to_kebab") { expect(case_format.to_kebab("ParseHTTPRequest")).should_be("parse-http-request"); };
        test("to_screaming_snake") { expect(case_format.to_screaming_snake("max size")).should_be("MAX_SIZE"); };
        test("to_title") { expect(case_format.to_title("max_size")).should_be("Max Size"); };
        test("to_sentence") { expect(case_format.to_sentence("maxSizeLimit")).should_be("Max size limit"); };
        test("to_dot") { expect(case_format.to_dot("maxSize")).should_be("max.size"); };
        test("to_snake of one word") { expect(case_format.to_snake("word")).should_be("word"); };
        test("to_camel of \"\"") { expect(case_format.to_camel("")).should_be(""); };
        test("to_snake with leading separators") { expect(case_format.to_snake("__private_name")).should_be("private_name"); };
        test("word_count") { expect(case_format.word_count("parseHTTPRequest")).should_be(3); };
        test("snake to camel and back") { expect(case_format.to_snake(case_format.to_camel("one_two_three"))).should_be("one_two_three"); };

        // ---- string_similarity
        test("levenshtein") { expect(string_similarity.levenshtein("kitten", "sitting")).should_be(3); };
        test("levenshtein of equal strings") { expect(string_similarity.levenshtein("same", "same")).should_be(0); };
        test("levenshtein to \"\"") { expect(string_similarity.levenshtein("abc", "")).should_be(3); };
        test("levenshtein from \"\"") { expect(string_similarity.levenshtein("", "abcd")).should_be(4); };
        test("levenshtein of two \"\"") { expect(string_similarity.levenshtein("", "")).should_be(0); };
        test("levenshtein, one insertion") { expect(string_similarity.levenshtein("cat", "cart")).should_be(1); };
        test("levenshtein, all different") { expect(string_similarity.levenshtein("abc", "xyz")).should_be(3); };
        test("levenshtein is symmetric") { expect(string_similarity.levenshtein("sitting", "kitten")).should_be(3); };
        test("levenshtein counts a swap as two") { expect(string_similarity.levenshtein("form", "from")).should_be(2); };
        test("damerau_levenshtein counts a swap as one") { expect(string_similarity.damerau_levenshtein("form", "from")).should_be(1); };
        test("damerau_levenshtein without swaps") { expect(string_similarity.damerau_levenshtein("kitten", "sitting")).should_be(3); };
        test("hamming") { expect(string_similarity.hamming("karolin", "kathrin")).should_be(3); };
        test("hamming of equal strings") { expect(string_similarity.hamming("abc", "abc")).should_be(0); };
        try {
            string_similarity.hamming("abc", "ab");
            test("hamming of different lengths") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("hamming of different lengths") { };
        }
        test("similarity") { expect(string_similarity.similarity("kitten", "sitting")).should_be_near(0.571428, 0.00001); };
        test("similarity of equal strings") { expect(string_similarity.similarity("abc", "abc")).should_be(1); };
        test("similarity of two \"\"") { expect(string_similarity.similarity("", "")).should_be(1); };
        test("similarity with nothing in common") { expect(string_similarity.similarity("abc", "xyz")).should_be(0); };
        test("common_prefix_length") { expect(string_similarity.common_prefix_length("interstellar", "internet")).should_be(5); };
        test("common_prefix") { expect(string_similarity.common_prefix("interstellar", "internet")).should_be("inter"); };
        test("common_prefix, none") { expect(string_similarity.common_prefix("abc", "xbc")).should_be(""); };
        test("common_prefix when one is a prefix") { expect(string_similarity.common_prefix("abc", "abcdef")).should_be("abc"); };
        test("common_suffix_length") { expect(string_similarity.common_suffix_length("walking", "talking")).should_be(6); };
        test("common_suffix") { expect(string_similarity.common_suffix("walking", "talking")).should_be("alking"); };
        test("common_suffix, none") { expect(string_similarity.common_suffix("abc", "abd")).should_be(""); };
        test("common_prefix_of") { expect(string_similarity.common_prefix_of(new string[] { "flower", "flow", "flight" })).should_be("fl"); };
        test("common_prefix_of one string") { expect(string_similarity.common_prefix_of(new string[] { "alone" })).should_be("alone"); };
        test("longest_common_substring") { expect(string_similarity.longest_common_substring("xabcdy", "zabcdw")).should_be("abcd"); };
        test("longest_common_substring, none") { expect(string_similarity.longest_common_substring("abc", "xyz")).should_be(""); };
        test("longest_common_substring with \"\"") { expect(string_similarity.longest_common_substring("abc", "")).should_be(""); };
        test("lcs_length") { expect(string_similarity.lcs_length("AGGTAB", "GXTXAYB")).should_be(4); };
        test("lcs_length, none") { expect(string_similarity.lcs_length("abc", "xyz")).should_be(0); };
        test("jaro") { expect(string_similarity.jaro("MARTHA", "MARHTA")).should_be_near(0.944444, 0.00001); };
        test("jaro of equal strings") { expect(string_similarity.jaro("abc", "abc")).should_be(1); };
        test("jaro with nothing in common") { expect(string_similarity.jaro("abc", "xyz")).should_be(0); };
        test("jaro with \"\"") { expect(string_similarity.jaro("abc", "")).should_be(0); };
        test("jaro_winkler") { expect(string_similarity.jaro_winkler("MARTHA", "MARHTA")).should_be_near(0.961111, 0.00001); };
        long_a := fox.repeat(8);
        long_b := long_a.replace_all("quick", "slow");
        test("levenshtein of long strings") { expect(string_similarity.levenshtein(long_a, long_b)).should_be(40); };

        // ---- template
        letter := new template("Dear {name}, your order {id} ships on {day}.");
        letter.put("name", "Ada").put_int("id", 1042).put("day", "Monday");
        test("render") { expect(letter.render()).should_be("Dear Ada, your order 1042 ships on Monday."); };
        letter.put("day", "Friday");
        test("put replaces a value") { expect(letter.render()).should_be("Dear Ada, your order 1042 ships on Friday."); };
        test("has") { expect_true(letter.has("name")); };
        test("has of an unknown name") { expect_false(letter.has("nobody")); };
        test("value_of") { expect(letter.value_of("name", "?")).should_be("Ada"); };
        test("value_of with a fallback") { expect(letter.value_of("nobody", "?")).should_be("?"); };
        test("placeholders") { expect(show(letter.placeholders())).should_be("3:name|id|day"); };
        letter.remove("day");
        test("a missing value leaves the placeholder") { expect(letter.render()).should_be("Dear Ada, your order 1042 ships on {day}."); };
        letter.set_missing_value("(unknown)");
        test("set_missing_value") { expect(letter.render()).should_be("Dear Ada, your order 1042 ships on (unknown)."); };
        letter.set_strict(true);
        try {
            letter.render();
            test("strict rendering with a missing value") { fail_test("did not throw"); };
        } catch(e: not_found_exception) {
            test("the message names the placeholder") { expect_true(e.get_message().contains("{day}")); };
        }
        test("doubled braces") { expect(new template("{{x}} is {x}").put("x", "1").render()).should_be("{x} is 1"); };
        test("spaces inside the braces") { expect(new template("{ x } and {x}").put("x", "1").render()).should_be("1 and 1"); };
        test("what is not a placeholder stays") { expect(new template("{} {a b} {x:y} {open").put("x", "1").render()).should_be("{} {a b} {x:y} {open"); };
        test("a placeholder used twice") { expect(new template("{a}{a}").put("a", "ha").render()).should_be("haha"); };
        test("values are not filled in again") { expect(new template("{a}").put("a", "{b}").put("b", "x").render()).should_be("{b}"); };
        test("a text without placeholders") { expect(new template("plain").render()).should_be("plain"); };
        test("an empty text") { expect(new template("").render()).should_be(""); };
        test("placeholders of plain text") { expect(show(new template("plain").placeholders())).should_be("0:"); };
        test("placeholders lists each name once") { expect(show(new template("{a} {b} {a}").placeholders())).should_be("2:a|b"); };
        test("put_number") { expect(new template("{price} EUR").put_number("price", 9.5, 2).render()).should_be("9.50 EUR"); };
        test("the static render") { expect(template.render("{a}+{b}", new string[] { "a", "b" }, new string[] { "1", "2" })).should_be("1+2"); };
        test("clear") { expect(letter.clear().set_strict(false).render()).should_be("Dear (unknown), your order (unknown) ships on (unknown)."); };
        test("source") { expect(new template("{a}").source()).should_be("{a}"); };
        try {
            letter.put("", "x");
            test("put with an empty name") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("put with an empty name") { };
        }
        try {
            letter.put_all(new string[] { "a" }, new string[0]);
            test("put_all with different lengths") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("put_all with different lengths") { };
        }
    };
    finish_tests("lib_text_layout");
}
