mod main;

import ( testing )

/**
 * Does not COMPILE today: `foreach` over an object whose BASE class
 * implements loopable is rejected with
 * "could not locate support function `get_elements()` inherited from
 * expression ... via the `loopable<>` interface".
 * Workaround used in std.io (file_reader): the derived class names
 * loopable again and repeats get_elements().
 */

class numbers_base : loopable<decimal> {
    override def get_elements() : decimal[]? {
        numbers := new decimal[2];
        numbers[0] = 4; numbers[1] = 5;
        return numbers;
    }
}

class numbers_derived base numbers_base {
}

def main(args: string[]) {
    total : decimal = 0;
    source := new numbers_derived();
    foreach(n in source) {
        total += n;
    }
    expect("foreach over a class whose base is loopable", total, 9);
    finish("lib_io_foreach_inherited");
}
