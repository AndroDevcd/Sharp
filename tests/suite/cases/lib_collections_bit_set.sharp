mod main;

import ( std.testing, std.collections )

/**
 * std.collections - bit_set: single bits, ranges, counting, scanning and
 * the bitwise combinations of two sets. Bits are stored 30 to a word, so
 * the indexes 29, 30, 59, 60 are the interesting borders.
 */

def test_single_bits() {
    b := new bit_set();
    test("new: is_empty") { expect(b.is_empty()).should_be(1); };
    test("new: cardinality") { expect(b.cardinality()).should_be(0); };
    test("new: length") { expect(b.length()).should_be(0); };
    test("new: test") { expect(b.test(0)).should_be(0); };
    test("new: test far away") { expect(b.test(100000)).should_be(0); };
    test("new: to_string") { expect(b.to_string()).should_be("{}"); };
    test("new: next_set_bit") { expect(b.next_set_bit(0)).should_be(0 - 1); };
    test("new: next_clear_bit") { expect(b.next_clear_bit(0)).should_be(0); };

    b.set_bit(0);
    b.set_bit(5);
    b.set_bit(29);
    b.set_bit(30);
    b.set_bit(64);
    test("test 0") { expect(b.test(0)).should_be(1); };
    test("test 1") { expect(b.test(1)).should_be(0); };
    test("test 5") { expect(b.test(5)).should_be(1); };
    test("test 29 (last bit of word 0)") { expect(b.test(29)).should_be(1); };
    test("test 30 (first bit of word 1)") { expect(b.test(30)).should_be(1); };
    test("test 31") { expect(b.test(31)).should_be(0); };
    test("test 64") { expect(b.test(64)).should_be(1); };
    test("cardinality") { expect(b.cardinality()).should_be(5); };
    test("length") { expect(b.length()).should_be(65); };
    test("is_empty") { expect(b.is_empty()).should_be(0); };
    test("to_string") { expect(b.to_string()).should_be("{0, 5, 29, 30, 64}"); };

    b.set_bit(5);
    test("setting twice changes nothing") { expect(b.cardinality()).should_be(5); };
    b.clear_bit(5);
    test("clear_bit") { expect(b.test(5)).should_be(0); };
    test("clear_bit keeps the neighbours") { expect(b.test(0) + b.test(29)).should_be(2); };
    b.clear_bit(5);
    test("clearing twice changes nothing") { expect(b.cardinality()).should_be(4); };
    b.clear_bit(5000);
    test("clearing beyond the end does not grow") { expect(b.length()).should_be(65); };

    b.flip(5);
    test("flip off -> on") { expect(b.test(5)).should_be(1); };
    b.flip(5);
    test("flip on -> off") { expect(b.test(5)).should_be(0); };
    b.flip(200);
    test("flip grows") { expect(b.test(200)).should_be(1); };
    b.assign(7, 1);
    test("assign 1") { expect(b.test(7)).should_be(1); };
    b.assign(7, 0);
    test("assign 0") { expect(b.test(7)).should_be(0); };

    // growth: far beyond the first words, earlier bits survive
    b.set_bit(3000);
    test("grown: new bit") { expect(b.test(3000)).should_be(1); };
    test("grown: old bits survive") { expect(b.test(0) + b.test(29) + b.test(30) + b.test(64) + b.test(200)).should_be(5); };
    test("grown: length") { expect(b.length()).should_be(3001); };
    test("grown: cardinality") { expect(b.cardinality()).should_be(6); };

    b.clear();
    test("clear: is_empty") { expect(b.is_empty()).should_be(1); };
    test("clear: length") { expect(b.length()).should_be(0); };
    test("clear: test") { expect(b.test(3000)).should_be(0); };

    try { b.set_bit(0 - 1); test("set_bit(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("set_bit(-1)") { }; }
    try { b.clear_bit(0 - 1); test("clear_bit(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("clear_bit(-1)") { }; }
    try { b.test(0 - 1); test("test(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("test(-1)") { }; }
    try { b.flip(0 - 3); test("flip(-3)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("flip(-3)") { }; }
    try { b.next_set_bit(0 - 1); test("next_set_bit(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("next_set_bit(-1)") { }; }
    try { bad := new bit_set(0 - 1); test("bit_set(-1)") { fail_test("did not throw"); }; } catch(e: illegal_argument_exception) { test("bit_set(-1)") { }; }

    sized := new bit_set(1000);
    test("sized: starts empty") { expect(sized.cardinality()).should_be(0); };
    sized.set_bit(999);
    test("sized: last bit") { expect(sized.test(999)).should_be(1); };
    sized.set_bit(1000);
    test("sized: one past the size still works") { expect(sized.test(1000)).should_be(1); };
}

def test_ranges_and_scans() {
    b := new bit_set();
    b.set_range(25, 65);            // crosses two word borders (30 and 60)
    test("set_range cardinality") { expect(b.cardinality()).should_be(40); };
    test("set_range before") { expect(b.test(24)).should_be(0); };
    test("set_range first") { expect(b.test(25)).should_be(1); };
    test("set_range last") { expect(b.test(64)).should_be(1); };
    test("set_range after") { expect(b.test(65)).should_be(0); };
    test("set_range length") { expect(b.length()).should_be(65); };

    b.clear_range(30, 60);          // exactly word 1
    test("clear_range cardinality") { expect(b.cardinality()).should_be(10); };
    test("clear_range kept 29") { expect(b.test(29)).should_be(1); };
    test("clear_range cleared 30") { expect(b.test(30)).should_be(0); };
    test("clear_range cleared 59") { expect(b.test(59)).should_be(0); };
    test("clear_range kept 60") { expect(b.test(60)).should_be(1); };
    test("clear_range to_string") { expect(b.to_string()).should_be("{25, 26, 27, 28, 29, 60, 61, 62, 63, 64}"); };

    b.set_range(10, 10);
    test("empty range sets nothing") { expect(b.cardinality()).should_be(10); };
    try { b.set_range(5, 4); test("set_range from > to") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("set_range from > to") { }; }
    try { b.clear_range(0 - 1, 4); test("clear_range negative") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("clear_range negative") { }; }

    // scanning: bits 25..29 and 60..64 are on
    test("next_set_bit from 0") { expect(b.next_set_bit(0)).should_be(25); };
    test("next_set_bit on a set bit") { expect(b.next_set_bit(27)).should_be(27); };
    test("next_set_bit skips the empty word") { expect(b.next_set_bit(30)).should_be(60); };
    test("next_set_bit after the last") { expect(b.next_set_bit(65)).should_be(0 - 1); };
    test("next_set_bit far beyond") { expect(b.next_set_bit(100000)).should_be(0 - 1); };
    test("next_clear_bit from 0") { expect(b.next_clear_bit(0)).should_be(0); };
    test("next_clear_bit inside a run") { expect(b.next_clear_bit(25)).should_be(30); };
    test("next_clear_bit at the end of the last run") { expect(b.next_clear_bit(60)).should_be(65); };
    test("next_clear_bit beyond the stored words") { expect(b.next_clear_bit(100000)).should_be(100000); };

    full := new bit_set();
    full.set_range(0, 60);          // two completely full words
    test("next_clear_bit skips full words") { expect(full.next_clear_bit(0)).should_be(60); };
    test("full words cardinality") { expect(full.cardinality()).should_be(60); };

    // the documented loop over all set bits
    visited : decimal = 0;
    sum : decimal = 0;
    for(i : decimal = b.next_set_bit(0); i >= 0; i = b.next_set_bit(i + 1)) {
        visited++;
        sum += i;
    }
    test("loop over set bits: count") { expect(visited).should_be(10); };
    test("loop over set bits: sum (25..29 + 60..64)") { expect(sum).should_be(445); };

    indexes := b.to_list();
    test("to_list size") { expect(indexes.size().value).should_be(10); };
    test("to_list first") { expect(indexes.at(0).value).should_be(25); };
    test("to_list last") { expect(indexes.at(9).value).should_be(64); };
}

def test_combining() {
    // a = {1, 2, 3, 40, 100}, b = {2, 3, 4, 40, 70}
    a := new bit_set();
    a.set_bit(1); a.set_bit(2); a.set_bit(3); a.set_bit(40); a.set_bit(100);
    b := new bit_set();
    b.set_bit(2); b.set_bit(3); b.set_bit(4); b.set_bit(40); b.set_bit(70);

    both := a.copy_of();
    both.and_with(b);
    test("and_with") { expect(both.to_string()).should_be("{2, 3, 40}"); };

    either := a.copy_of();
    either.or_with(b);
    test("or_with") { expect(either.to_string()).should_be("{1, 2, 3, 4, 40, 70, 100}"); };

    one_side := a.copy_of();
    one_side.xor_with(b);
    test("xor_with") { expect(one_side.to_string()).should_be("{1, 4, 70, 100}"); };

    only_a := a.copy_of();
    only_a.and_not(b);
    test("and_not") { expect(only_a.to_string()).should_be("{1, 100}"); };

    test("the operands are not changed: a") { expect(a.to_string()).should_be("{1, 2, 3, 40, 100}"); };
    test("the operands are not changed: b") { expect(b.to_string()).should_be("{2, 3, 4, 40, 70}"); };

    test("intersects") { expect(a.intersects(b)).should_be(1); };
    test("intersects nothing in common") { expect(only_a.intersects(b)).should_be(0); };
    test("intersects with empty") { expect(a.intersects(new bit_set())).should_be(0); };

    // different capacities: a small set combined with a big one and the other way round
    small := new bit_set();
    small.set_bit(3);
    large := new bit_set();
    large.set_bit(3); large.set_bit(900);
    grown := small.copy_of();
    grown.or_with(large);
    test("or_with a longer set grows") { expect(grown.to_string()).should_be("{3, 900}"); };
    cut := large.copy_of();
    cut.and_with(small);
    test("and_with a shorter set clears the rest") { expect(cut.to_string()).should_be("{3}"); };
    flipped := small.copy_of();
    flipped.xor_with(large);
    test("xor_with a longer set") { expect(flipped.to_string()).should_be("{900}"); };
    kept := large.copy_of();
    kept.and_not(small);
    test("and_not with a shorter set") { expect(kept.to_string()).should_be("{900}"); };

    // same_bits ignores the capacity
    test("same_bits with itself") { expect(a.same_bits(a)).should_be(1); };
    test("same_bits with a copy") { expect(a.same_bits(a.copy_of())).should_be(1); };
    test("same_bits different") { expect(a.same_bits(b)).should_be(0); };
    roomy := new bit_set(5000);
    roomy.set_bit(3);
    test("same_bits with different capacity") { expect(small.same_bits(roomy)).should_be(1); };
    test("same_bits with different capacity, other way") { expect(roomy.same_bits(small)).should_be(1); };
    roomy.set_bit(4000);
    test("same_bits: a bit beyond the shorter one") { expect(small.same_bits(roomy)).should_be(0); };

    copy := a.copy_of();
    copy.set_bit(7);
    test("copy_of is independent") { expect(a.test(7)).should_be(0); };
}

/** the sieve of Eratosthenes: a classic use, and a larger scale check */
def test_sieve() {
    limit : decimal = 10000;
    composite := new bit_set(limit + 1);
    for(i : decimal = 2; i * i <= limit; i++) {
        if(!composite.test(i)) {
            for(multiple : decimal = i * i; multiple <= limit; multiple += i)
                composite.set_bit(multiple);
        }
    }

    primes : decimal = 0;
    last_prime : decimal = 0;
    for(i : decimal = 2; i <= limit; i++) {
        if(!composite.test(i)) { primes++; last_prime = i; }
    }
    test("sieve: primes below 10000") { expect(primes).should_be(1229); };
    test("sieve: the largest of them") { expect(last_prime).should_be(9973); };
    test("sieve: composites (2..10000 without the primes)") { expect(composite.cardinality()).should_be(9999 - 1229); };
    test("sieve: first composite") { expect(composite.next_set_bit(0)).should_be(4); };
    test("sieve: 7919 is prime") { expect(composite.test(7919)).should_be(0); };
    test("sieve: 7917 is not") { expect(composite.test(7917)).should_be(1); };

    // every third bit of 6000, counted three ways
    thirds := new bit_set();
    for(i : decimal = 0; i < 6000; i += 3) thirds.set_bit(i);
    test("thirds: cardinality") { expect(thirds.cardinality()).should_be(2000); };
    test("thirds: length") { expect(thirds.length()).should_be(5998); };
    test("thirds: to_list") { expect(thirds.to_list().size().value).should_be(2000); };
    wrong : decimal = 0;
    for(i : decimal = 0; i < 6000; i++) {
        if(thirds.test(i) != (i % 3 == 0)) wrong++;
    }
    test("thirds: every bit is as expected") { expect(wrong).should_be(0); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_bit_set") {
        test_single_bits();
        test_ranges_and_scans();
        test_combining();
        test_sieve();
    };
    finish_tests("lib_collections_bit_set");
}
