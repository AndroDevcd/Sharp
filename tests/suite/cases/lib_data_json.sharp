mod main;

import ( std.testing, std.io, std.data )

/**
 * std.data JSON: json_value (building and reading), json_parser (the whole
 * of JSON, escapes, nesting, malformed input with positions) and
 * json_writer (compact, pretty, sorted keys, ASCII only), and round trips
 * parse -> write -> parse.
 *
 * Works only inside /tmp/sharp_suite_io_json and removes it at the end.
 */

base_dir : string = "/tmp/sharp_suite_io_json";

/** a double quote, to keep the JSON texts below readable: q + "a" + q */
q : string = "\"";

/** the text must be rejected, with the error at the given line and column */
def expect_error(name: string, text: string, line: decimal, column: decimal) {
    try {
        json_parser.parse(text);
        test(name) { fail_test("no exception"); };
    } catch(e: json_exception) {
        test(name + " (line)") { expect(e.line).should_be(line); };
        test(name + " (column)") { expect(e.column).should_be(column); };
    }
}

/**
 * The parser works most numbers out itself and hands the rest to the
 * runtime's strtod: either way the number must be exactly the one strtod
 * reads from the same text.
 */
def expect_as_strtod(text: string) {
    test("number as strtod reads it: " + text) { expect(json_parser.parse(text).as_number()).should_be(strtod(text).value); };
}

/** the text must be rejected (position not checked) */
def expect_invalid(name: string, text: string) {
    test(name) { expect_false(json_parser.is_valid(text)); };
}

/** parse, write compact, compare with the expected text */
def expect_compact(name: string, text: string, expected: string) {
    test(name) { expect(json_parser.parse(text).to_string()!!).should_be(expected); };
}

/** parse -> write -> parse must give an equal value, compact and pretty */
def expect_round_trip(name: string, text: string) {
    first := json_parser.parse(text);
    compact := json_parser.parse(json_writer.to_compact(first));
    pretty := json_parser.parse(json_writer.to_pretty(first));
    test(name + " (compact)") { expect_true(first.equals_value(compact)); };
    test(name + " (pretty)") { expect_true(first.equals_value(pretty)); };
}

def test_values() {
    n := json_value.of_null();
    test("null is_null") { expect_true(n.is_null()); };
    test("null kind_name") { expect(n.kind_name()).should_be("null"); };
    test("null kind") { expect(n.kind()).should_be(json_value.kind_null); };
    b := json_value.of_bool(true);
    test("bool is_bool") { expect_true(b.is_bool()); };
    test("as_bool") { expect_true(b.as_bool()); };
    test("as_bool false") { expect_false(json_value.of_bool(false).as_bool()); };
    num := json_value.of_number(2.5);
    test("is_number") { expect_true(num.is_number()); };
    test("as_number") { expect(num.as_number()).should_be(2.5); };
    test("as_int") { expect(json_value.of_number(42).as_int()).should_be(42); };
    s := json_value.of_string("text");
    test("is_string") { expect_true(s.is_string()); };
    test("as_string") { expect(s.as_string()).should_be("text"); };
    test("kind_name string") { expect(s.kind_name()).should_be("string"); };
    test("string is not a number") { expect_false(s.is_number()); };

    try { s.as_number(); test("as_number on string") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("as_number on string") { }; }
    try { num.as_string(); test("as_string on number") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("as_string on number") { }; }
    try { num.as_int(); test("as_int on 2.5") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("as_int on 2.5") { }; }
    try { n.as_bool(); test("as_bool on null") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("as_bool on null") { }; }
    try { s.size(); test("size of string") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("size of string") { }; }

    // arrays
    arr := json_value.new_array();
    test("is_array") { expect_true(arr.is_array()); };
    test("new array is empty") { expect_true(arr.is_empty()); };
    arr.add_string("a").add_number(1).add_bool(false).add_null().add(json_value.new_array()).add(null);
    test("array size") { expect(arr.size()).should_be(6); };
    test("array to_string") { expect(arr.to_string()!!).should_be("[" + q + "a" + q + ",1,false,null,[],null]"); };
    test("at") { expect(arr.at(0).as_string()).should_be("a"); };
    test("add(null) stores a JSON null") { expect_true(arr.at(5).is_null()); };
    old := arr.put_at(1, json_value.of_number(2));
    test("put_at returns the old value") { expect(old.as_number()).should_be(1); };
    test("put_at stored") { expect(arr.at(1).as_number()).should_be(2); };
    arr.insert_at(0, json_value.of_string("first"));
    arr.insert_at(7, json_value.of_string("last"));
    test("insert_at front") { expect(arr.at(0).as_string()).should_be("first"); };
    test("insert_at end") { expect(arr.at(7).as_string()).should_be("last"); };
    removed := arr.remove_at(0);
    test("remove_at returns") { expect(removed.as_string()).should_be("first"); };
    test("size after remove") { expect(arr.size()).should_be(7); };
    test("value_at on array") { expect(arr.value_at(0).as_string()).should_be("a"); };
    try { arr.at(7); test("at outside") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("at outside") { }; }
    try { arr.at(0 - 1); test("at negative") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("at negative") { }; }
    try { arr.at(0.5); test("at fraction") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("at fraction") { }; }
    try { arr.put("k", n); test("put on array") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("put on array") { }; }
    try { arr.insert_at(9, n); test("insert_at outside") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("insert_at outside") { }; }
    arr.clear();
    test("clear") { expect(arr.size()).should_be(0); };

    // objects
    obj := json_value.new_object();
    test("is_object") { expect_true(obj.is_object()); };
    obj.put_string("name", "Ada").put_number("age", 36).put_bool("admin", true).put_null("email").put("tags", json_value.new_array());
    test("object size") { expect(obj.size()).should_be(5); };
    test("object to_string") { expect(obj.to_string()!!).should_be("{" + q + "name" + q + ":" + q + "Ada" + q + "," + q + "age" + q + ":36," + q + "admin" + q + ":true," + q + "email" + q + ":null," + q + "tags" + q + ":[]}"); };
    test("has") { expect_true(obj.has("age")); };
    test("has member with null value") { expect_true(obj.has("email")); };
    test("has not") { expect_false(obj.has("Age")); };
    test("member") { expect(obj.member("name").as_string()).should_be("Ada"); };
    test("find") { expect_not_null(obj.find("age")); };
    test("find missing") { expect_null(obj.find("nope")); };
    test("find null member gives a JSON null") { expect_true(obj.find("email")!!.is_null()); };
    test("string_or") { expect(obj.string_or("name", "?")).should_be("Ada"); };
    test("string_or missing") { expect(obj.string_or("city", "?")).should_be("?"); };
    test("string_or wrong kind") { expect(obj.string_or("age", "?")).should_be("?"); };
    test("number_or") { expect(obj.number_or("age", 0)).should_be(36); };
    test("number_or missing") { expect(obj.number_or("height", 0 - 1)).should_be(0 - 1); };
    test("bool_or") { expect_true(obj.bool_or("admin", false)); };
    test("bool_or missing") { expect_true(obj.bool_or("guest", true)); };
    test("keys") { expect(io_strings.join(obj.keys(), ",")).should_be("name,age,admin,email,tags"); };
    test("key_at") { expect(obj.key_at(1)).should_be("age"); };
    test("value_at on object") { expect(obj.value_at(1).as_number()).should_be(36); };
    obj.put_number("age", 37);
    test("put again replaces") { expect(obj.member("age").as_number()).should_be(37); };
    test("...without adding") { expect(obj.size()).should_be(5); };
    test("...and keeps its place") { expect(obj.key_at(1)).should_be("age"); };
    test("remove") { expect_true(obj.remove("admin")); };
    test("remove missing") { expect_false(obj.remove("admin")); };
    test("keys after remove") { expect(io_strings.join(obj.keys(), ",")).should_be("name,age,email,tags"); };
    try { obj.member("nope"); test("member missing") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("member missing") { }; }
    try { obj.at(0); test("at on object") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("at on object") { }; }
    try { s.find("x"); test("find on string") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("find on string") { }; }
    try { obj.key_at(4); test("key_at outside") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("key_at outside") { }; }

    // an object large enough to use its hash index
    large := json_value.new_object();
    for(i : decimal = 0; i < 500; i++) {
        large.put_number("key" + io_strings.int_to_string(i), i);
    }
    test("large object size") { expect(large.size()).should_be(500); };
    found_all : decimal = 1;
    for(i : decimal = 0; i < 500; i++) {
        if(large.number_or("key" + io_strings.int_to_string(i), 0 - 1) != i) {
            found_all = 0;
        }
    }
    test("all 500 members found") { expect_true(found_all); };
    test("missing in large object") { expect_false(large.has("key500")); };
    large.put_number("key250", 0 - 250);
    test("replace in large object") { expect(large.member("key250").as_number()).should_be(0 - 250); };
    test("size unchanged by replace") { expect(large.size()).should_be(500); };
    test("remove from large object") { expect_true(large.remove("key0")); };
    test("lookup after remove") { expect(large.member("key499").as_number()).should_be(499); };
    test("first key after remove") { expect(large.key_at(0)).should_be("key1"); };
    test("removed key gone") { expect_false(large.has("key0")); };
    large.put_number("key0", 1000);
    test("re-added key goes to the end") { expect(large.key_at(499)).should_be("key0"); };
}

def test_paths_copy_equals() {
    doc := json_parser.parse("{" + q + "server" + q + ": {" + q + "ports" + q + ": [80, 443], " + q + "name" + q + ": " + q + "main" + q + "}, "
        + q + "list" + q + ": [{" + q + "id" + q + ": 1}, {" + q + "id" + q + ": 2}]}");
    test("at_path member.index") { expect(doc.at_path("server.ports[1]")!!.as_number()).should_be(443); };
    test("at_path member.member") { expect(doc.at_path("server.name")!!.as_string()).should_be("main"); };
    test("at_path index.member") { expect(doc.at_path("list[1].id")!!.as_number()).should_be(2); };
    test("at_path empty is the value itself") { expect_true(doc.at_path("")!!.is_object()); };
    test("at_path missing member") { expect_null(doc.at_path("server.host")); };
    test("at_path index outside") { expect_null(doc.at_path("server.ports[2]")); };
    test("at_path through a number") { expect_null(doc.at_path("server.ports[0].x")); };
    test("at_path index on object") { expect_null(doc.at_path("server[0]")); };
    test("at_path continues after missing") { expect_null(doc.at_path("nope.deeper[3].x")); };
    arr := json_parser.parse("[[1, 2], [3, 4]]");
    test("at_path starting with index") { expect(arr.at_path("[1][0]")!!.as_number()).should_be(3); };
    try { doc.at_path("server..name"); test("path with empty name") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("path with empty name") { }; }
    try { doc.at_path("list[x]"); test("path with bad index") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("path with bad index") { }; }
    try { doc.at_path("list[1"); test("path with open bracket") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("path with open bracket") { }; }
    try { doc.at_path(".server"); test("path starting with a period") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("path starting with a period") { }; }

    copy_doc := doc.deep_copy();
    test("deep_copy equals") { expect_true(doc.equals_value(copy_doc)); };
    copy_doc.member("server").member("ports").add_number(8080);
    test("copy changed") { expect(copy_doc.at_path("server.ports")!!.size()).should_be(3); };
    test("original untouched") { expect(doc.at_path("server.ports")!!.size()).should_be(2); };
    test("no longer equal") { expect_false(doc.equals_value(copy_doc)); };
    test("deep_copy of a string") { expect(json_value.of_string("s").deep_copy().as_string()).should_be("s"); };

    a := json_parser.parse("{" + q + "x" + q + ": 1, " + q + "y" + q + ": [true, null]}");
    b := json_parser.parse("{" + q + "y" + q + ": [true, null], " + q + "x" + q + ": 1.0}");
    test("member order does not matter") { expect_true(a.equals_value(b)); };
    c := json_parser.parse("{" + q + "x" + q + ": 1, " + q + "y" + q + ": [null, true]}");
    test("element order matters") { expect_false(a.equals_value(c)); };
    test("equals null") { expect_false(a.equals_value(null)); };
    test("number vs string") { expect_false(json_value.of_number(1).equals_value(json_value.of_string("1"))); };
    test("different member names") { expect_false(a.equals_value(json_parser.parse("{" + q + "x" + q + ": 1, " + q + "z" + q + ": [true, null]}"))); };
    test("different sizes") { expect_false(a.equals_value(json_parser.parse("{" + q + "x" + q + ": 1}"))); };
    test("null equals null") { expect_true(json_value.of_null().equals_value(json_value.of_null())); };
    test("false vs zero") { expect_false(json_value.of_bool(false).equals_value(json_value.of_number(0))); };
}

def test_parser_good() {
    test("true") { expect_true(json_parser.parse("true").as_bool()); };
    test("false") { expect_false(json_parser.parse("false").as_bool()); };
    test("null") { expect_true(json_parser.parse("null").is_null()); };
    test("zero") { expect(json_parser.parse("0").as_number()).should_be(0); };
    test("integer") { expect(json_parser.parse("12345").as_number()).should_be(12345); };
    test("negative") { expect(json_parser.parse("-17").as_number()).should_be(0 - 17); };
    test("fraction") { expect(json_parser.parse("3.25").as_number()).should_be(3.25); };
    test("exponent") { expect(json_parser.parse("1e3").as_number()).should_be(1000); };
    test("exponent with sign") { expect(json_parser.parse("25E-2").as_number()).should_be(0.25); };
    test("exponent with plus") { expect(json_parser.parse("-1.5e+2").as_number()).should_be(0 - 150); };
    test("negative zero") { expect(json_parser.parse("-0").as_number()).should_be(0); };
    expect_as_strtod("0.1");
    expect_as_strtod("0.3");
    expect_as_strtod("0.0");
    expect_as_strtod("0e5");
    expect_as_strtod("-0.0");
    expect_as_strtod("0.000001");
    expect_as_strtod("1e22");
    expect_as_strtod("1e23");
    expect_as_strtod("1.5e-22");
    expect_as_strtod("123e-25");
    expect_as_strtod("25e-23");
    expect_as_strtod("9007199254740991");
    expect_as_strtod("9007199254740993");
    expect_as_strtod("900719925474099.1");
    expect_as_strtod("123456789.123456789");
    expect_as_strtod("0.8545932140076324");
    expect_as_strtod("0.24073952877406524");
    expect_as_strtod("-8.722880357844552e-30");
    expect_as_strtod("9.345700658094924e+30");
    expect_as_strtod("5e-324");
    expect_as_strtod("1.7976931348623157e308");
    expect_as_strtod("4.35");
    expect_as_strtod("-1234.5678e10");
    expect_as_strtod("100000000000000000000");

    // ---- member names: the parser makes a name once and the objects share it; what is handed out is a copy
    records := json_parser.parse("[{" + q + "id" + q + ":1," + q + "name" + q + ":" + q + "a" + q + "},{"
        + q + "id" + q + ":2," + q + "name" + q + ":" + q + "b" + q + "}]");
    records.at(0).key_at(0).append("_changed");
    test("key_at gives a copy") { expect(records.at(0).key_at(0)).should_be("id"); };
    test("the other object keeps its name") { expect(records.at(1).member("id").as_number()).should_be(2); };
    handed_out := records.at(0).keys();
    handed_out.at(1).append("_changed");
    test("keys gives copies") { expect_true(records.at(0).has("name") && records.at(1).has("name")); };
    test("written with the names as they were") { expect(records.to_string()!!).should_be("[{" + q + "id" + q + ":1," + q + "name" + q + ":"
        + q + "a" + q + "},{" + q + "id" + q + ":2," + q + "name" + q + ":" + q + "b" + q + "}]"); };

    // more names than the parser keeps, a name longer than it keeps, a name with an escape - each twice
    record_text : string = "{" + q + "a_name_that_is_longer_than_the_parser_keeps_for_sharing" + q + ":-1," + q + "tab\\there" + q + ":-2";
    for(i : _int64 = 0; i < 300; i++) {
        record_text = record_text + "," + q + "member_" + io_strings.int_to_string(i) + q + ":" + io_strings.int_to_string(i);
    }
    record_text = record_text + "}";
    twice := json_parser.parse("[" + record_text + "," + record_text + "]");
    wrong_members : _int64 = 0;
    for(i : _int64 = 0; i < 300; i++) {
        if(twice.at(0).member("member_" + io_strings.int_to_string(i)).as_number() != i
           || twice.at(1).member("member_" + io_strings.int_to_string(i)).as_number() != i) {
            wrong_members++;
        }
    }
    test("300 names, twice") { expect(wrong_members).should_be(0); };
    test("302 members each") { expect(twice.at(1).size()).should_be(302); };
    test("a long name, twice") { expect(twice.at(1).member("a_name_that_is_longer_than_the_parser_keeps_for_sharing").as_number()).should_be(0 - 1); };
    test("a name with an escape, twice") { expect(twice.at(1).member("tab\there").as_number()).should_be(0 - 2); };
    test("zero point") { expect(json_parser.parse("0.5").as_number()).should_be(0.5); };
    test("large") { expect(json_parser.parse("9007199254740992").as_number()).should_be(9007199254740992); };
    test("white space around") { expect(json_parser.parse(" \t\r\n 7 \n").as_number()).should_be(7); };
    test("string") { expect(json_parser.parse(q + "hello" + q).as_string()).should_be("hello"); };
    test("empty string") { expect(json_parser.parse(q + q).as_string()).should_be(""); };
    test("empty array") { expect(json_parser.parse("[]").size()).should_be(0); };
    test("empty array with space") { expect(json_parser.parse("[ \n ]").size()).should_be(0); };
    test("empty object") { expect(json_parser.parse("{}").size()).should_be(0); };
    test("empty object with space") { expect(json_parser.parse("{ }").size()).should_be(0); };

    // escapes
    test("escaped quote") { expect(json_parser.parse(q + "a\\" + q + "b" + q).as_string()).should_be("a" + q + "b"); };
    test("escaped back slash") { expect(json_parser.parse(q + "a\\\\b" + q).as_string()).should_be("a\\b"); };
    test("escaped slash") { expect(json_parser.parse(q + "a\\/b" + q).as_string()).should_be("a/b"); };
    test("newline and tab") { expect(json_parser.parse(q + "a\\nb\\tc" + q).as_string()).should_be("a\nb\tc"); };
    controls := json_parser.parse(q + "\\b\\f\\r" + q).as_string();
    test("b f r length") { expect(io_strings.length(controls)).should_be(3); };
    test("backspace") { expect(controls.data[0]).should_be(8); };
    test("form feed") { expect(controls.data[1]).should_be(12); };
    test("carriage return") { expect(controls.data[2]).should_be(13); };
    test("unicode escape ascii") { expect(json_parser.parse(q + "\\u0041\\u00e9" + q).as_string().substring(0, 1)).should_be("A"); };
    two := json_parser.parse(q + "\\u00e9" + q).as_string();
    test("u00e9 is two UTF-8 bytes") { expect(io_strings.length(two)).should_be(2); };
    test("first byte") { expect(two.data[0] & 0xff).should_be(0xC3); };
    test("second byte") { expect(two.data[1] & 0xff).should_be(0xA9); };
    three := json_parser.parse(q + "\\u20AC" + q).as_string();
    test("u20AC is three bytes") { expect(io_strings.length(three)).should_be(3); };
    test("euro byte 0") { expect(three.data[0] & 0xff).should_be(0xE2); };
    test("euro byte 1") { expect(three.data[1] & 0xff).should_be(0x82); };
    test("euro byte 2") { expect(three.data[2] & 0xff).should_be(0xAC); };
    four := json_parser.parse(q + "\\ud83d\\ude00" + q).as_string();
    test("surrogate pair is four bytes") { expect(io_strings.length(four)).should_be(4); };
    test("pair byte 0") { expect(four.data[0] & 0xff).should_be(0xF0); };
    test("pair byte 1") { expect(four.data[1] & 0xff).should_be(0x9F); };
    test("pair byte 2") { expect(four.data[2] & 0xff).should_be(0x98); };
    test("pair byte 3") { expect(four.data[3] & 0xff).should_be(0x80); };
    zero := json_parser.parse(q + "a\\u0000b" + q).as_string();
    test("u0000 keeps the string going") { expect(io_strings.length(zero)).should_be(3); };
    test("u0000 is a zero byte") { expect(zero.data[1]).should_be(0); };
    test("escape at the very end") { expect(json_parser.parse(q + "x\\n" + q).as_string()).should_be("x\n"); };
    test("escape at the very start") { expect(json_parser.parse(q + "\\tx" + q).as_string()).should_be("\tx"); };

    // structures
    doc := json_parser.parse("{\n  " + q + "a" + q + " : [1, 2, {" + q + "b" + q + ": null}],\n  " + q + "c" + q + " : {" + q + "d" + q + ": [[], {}]},\n  " + q + q + ": " + q + "empty name" + q + "\n}");
    test("document members") { expect(doc.size()).should_be(3); };
    test("nested array") { expect(doc.member("a").size()).should_be(3); };
    test("null in nested object") { expect_true(doc.at_path("a[2].b")!!.is_null()); };
    test("empty array inside") { expect(doc.at_path("c.d[0]")!!.size()).should_be(0); };
    test("empty object inside") { expect_true(doc.at_path("c.d[1]")!!.is_object()); };
    test("empty member name") { expect(doc.member("").as_string()).should_be("empty name"); };
    dup := json_parser.parse("{" + q + "k" + q + ": 1, " + q + "k" + q + ": 2}");
    test("duplicate name: one member") { expect(dup.size()).should_be(1); };
    test("duplicate name: last value") { expect(dup.member("k").as_number()).should_be(2); };
    expect_compact("compact", " [ 1 , " + q + "x" + q + " , { " + q + "k" + q + " : [ ] } ] ", "[1," + q + "x" + q + ",{" + q + "k" + q + ":[]}]");

    // deep nesting: no recursion in parser, writer, equals or copy
    deep := new char_buffer();
    for(i : decimal = 0; i < 900; i++) {
        deep.append_char('[');
    }
    deep.append("1");
    for(i : decimal = 0; i < 900; i++) {
        deep.append_char(']');
    }
    deep_text := deep.build();
    nested := json_parser.parse(deep_text);
    depth : decimal = 0;
    walk := nested;
    while(walk.is_array()) {
        walk = walk.at(0);
        depth++;
    }
    test("900 levels parsed") { expect(depth).should_be(900); };
    test("900 levels written") { expect(nested.to_string()!!).should_be(deep_text); };
    test("900 levels compared") { expect_true(nested.equals_value(nested.deep_copy())); };
    test("900 levels pretty and back") { expect_true(nested.equals_value(json_parser.parse(nested.to_pretty_string()))); };

    limited := new json_parser().set_max_depth(3);
    test("max depth getter") { expect(limited.get_max_depth()).should_be(3); };
    test("depth 3 allowed") { expect(limited.parse_text("[[[1]]]").size()).should_be(1); };
    try { limited.parse_text("[[[[1]]]]"); test("depth 4 rejected") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("depth error column") { expect(e.column).should_be(4); }; }
    test("parser can be reused") { expect(limited.parse_text("[1, 2]").size()).should_be(2); };
    try { json_parser.parse(io_strings.repeat("[", 1001)); test("default depth limit") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("default depth error position") { expect(e.position).should_be(1000); }; }
    try { limited.set_max_depth(0 - 1); test("negative max depth") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("negative max depth") { }; }

    // a larger document
    big := new char_buffer();
    big.append_char('[');
    for(i : decimal = 0; i < 2000; i++) {
        if(i > 0) {
            big.append_char(',');
        }
        big.append("{" + q + "id" + q + ":").append_int(i).append("," + q + "name" + q + ":" + q + "item ").append_int(i).append(q + "," + q + "ok" + q + ":true}");
    }
    big.append_char(']');
    items := json_parser.parse(big.build());
    test("2000 objects") { expect(items.size()).should_be(2000); };
    test("object 1999 id") { expect(items.at(1999).member("id").as_number()).should_be(1999); };
    test("object 1234 name") { expect(items.at(1234).member("name").as_string()).should_be("item 1234"); };
    test("large document written back the same") { expect(items.to_string()!!).should_be(big.build()); };
}

def test_parser_bad() {
    expect_error("empty text", "", 1, 1);
    expect_error("only space", "  \n ", 2, 2);
    expect_error("open array", "[1, 2", 1, 6);
    expect_error("open object", "{" + q + "a" + q + ": 1", 1, 8);
    expect_error("trailing comma in array", "[1, 2,]", 1, 7);
    expect_error("trailing comma in object", "{" + q + "a" + q + ": 1,}", 1, 9);
    expect_error("missing comma", "[1 2]", 1, 4);
    expect_error("missing colon", "{" + q + "a" + q + " 1}", 1, 6);
    expect_error("missing value", "{" + q + "a" + q + ":}", 1, 6);
    expect_error("name without quotes", "{a: 1}", 1, 2);
    expect_error("number as name", "{1: 2}", 1, 2);
    expect_error("single quotes", "['a']", 1, 2);
    expect_error("wrong close", "[1}", 1, 3);
    expect_error("close object with bracket", "{" + q + "a" + q + ": 1]", 1, 8);
    expect_error("text after value", "1 2", 1, 3);
    expect_error("two values", "{} {}", 1, 4);
    expect_error("lone close", "]", 1, 1);
    expect_error("comma first", "[,1]", 1, 2);
    expect_error("leading zero", "01", 1, 2);
    expect_error("negative leading zero", "-01", 1, 3);
    expect_error("plus sign", "+1", 1, 1);
    expect_error("lone minus", "-", 1, 2);
    expect_error("dot without digits", "1.", 1, 3);
    expect_error("leading dot", ".5", 1, 1);
    expect_error("open exponent", "1e", 1, 3);
    expect_error("exponent sign only", "1e+", 1, 4);
    expect_error("hex number", "0x10", 1, 2);
    expect_error("NaN", "NaN", 1, 1);
    expect_error("Infinity", "-Infinity", 1, 2);
    expect_error("misspelled true", "tru", 1, 1);
    expect_error("capital True", "True", 1, 1);
    expect_error("null with tail", "nullx", 1, 1);
    expect_error("unclosed string", q + "abc", 1, 1);
    expect_error("unclosed string in array", "[1, " + q + "abc]", 1, 5);
    expect_error("raw newline in string", q + "a\nb" + q, 1, 3);
    expect_error("raw tab in string", q + "a\tb" + q, 1, 3);
    expect_error("unknown escape", q + "a\\qb" + q, 1, 4);
    expect_error("short unicode escape", q + "\\u12" + q, 1, 2);
    expect_error("bad unicode digit", q + "\\u12G4" + q, 1, 6);
    expect_error("lone high surrogate", q + "\\ud83d" + q, 1, 2);
    expect_error("lone low surrogate", q + "\\ude00" + q, 1, 2);
    expect_error("high surrogate with wrong partner", q + "\\ud83d\\u0041" + q, 1, 2);
    expect_error("escape at the end of the text", q + "abc\\", 1, 5);
    expect_error("error on line 3", "{\n  " + q + "a" + q + ": 1,\n  " + q + "b" + q + ": ?\n}", 3, 8);
    expect_error("error after crlf lines", "[\r\n1,\r\n}", 3, 1);
    expect_error("comment", "[1] // no", 1, 5);
    expect_invalid("is_valid: garbage", "hello");
    expect_invalid("is_valid: open brace", "{");
    test("is_valid: good") { expect_true(json_parser.is_valid("{" + q + "a" + q + ": [1, 2, 3]}")); };

    try {
        json_parser.parse("[1, 2,\n 3 4]");
        test("message") { fail_test("no exception"); };
    } catch(e: json_exception) {
        test("message says what and where") { expect(e.get_message()).should_be("expected ',' or ']' but found '4' at line 2, column 4"); };
        test("position") { expect(e.position).should_be(10); };
    }
    try {
        json_value.of_string("x").as_number();
        test("non-parse error") { fail_test("no exception"); };
    } catch(e: json_exception) {
        test("no position for other errors") { expect(e.position).should_be(0 - 1); };
        test("message of a kind error") { expect(e.get_message()).should_be("expected a JSON number but this value is a string"); };
    }
}

def test_writer() {
    doc := json_value.new_object();
    doc.put_string("name", "Ada").put_number("age", 36);
    tags := json_value.new_array();
    tags.add_string("a").add_string("b");
    doc.put("tags", tags).put("empty", json_value.new_array()).put("none", json_value.new_object());
    inner := json_value.new_object();
    inner.put_bool("ok", true).put_null("x");
    doc.put("inner", inner);

    test("compact") { expect(json_writer.to_compact(doc)).should_be("{" + q + "name" + q + ":" + q + "Ada" + q + "," + q + "age" + q + ":36," + q + "tags" + q + ":[" + q + "a" + q + "," + q + "b" + q + "]," + q + "empty" + q + ":[]," + q + "none" + q + ":{}," + q + "inner" + q + ":{" + q + "ok" + q + ":true," + q + "x" + q + ":null}}"); };
    test("pretty") { expect(json_writer.to_pretty(doc)).should_be("{\n  " + q + "name" + q + ": " + q + "Ada" + q + ",\n  " + q + "age" + q + ": 36,\n  " + q + "tags" + q + ": [\n    " + q + "a" + q + ",\n    " + q + "b" + q + "\n  ],\n  " + q + "empty" + q + ": [],\n  " + q + "none" + q + ": {},\n  " + q + "inner" + q + ": {\n    " + q + "ok" + q + ": true,\n    " + q + "x" + q + ": null\n  }\n}"); };
    test("to_pretty_string") { expect(doc.to_pretty_string()).should_be(json_writer.to_pretty(doc)); };
    four := new json_writer().set_indent(4).write(tags);
    test("indent 4") { expect(four).should_be("[\n    " + q + "a" + q + ",\n    " + q + "b" + q + "\n]"); };
    test("pretty scalar") { expect(json_writer.to_pretty(json_value.of_number(1))).should_be("1"); };
    test("pretty empty array") { expect(json_writer.to_pretty(json_value.new_array())).should_be("[]"); };

    sorted := new json_writer().set_sort_keys(true).write(doc);
    test("sorted keys") { expect(sorted).should_be("{" + q + "age" + q + ":36," + q + "empty" + q + ":[]," + q + "inner" + q + ":{" + q + "ok" + q + ":true," + q + "x" + q + ":null}," + q + "name" + q + ":" + q + "Ada" + q + "," + q + "none" + q + ":{}," + q + "tags" + q + ":[" + q + "a" + q + "," + q + "b" + q + "]}"); };
    test("keys order untouched by sorted write") { expect(doc.key_at(0)).should_be("name"); };

    // numbers
    nums := json_value.new_array();
    nums.add_number(0).add_number(0 - 1).add_number(2.5).add_number(1e21).add_number(1e-7).add_number(123456789012).add_number(0.1);
    test("numbers") { expect(nums.to_string()!!).should_be("[0,-1,2.5,1e+21,0.0000001,123456789012,0.1]"); };
    try { json_value.of_number(0.0 / 0.0).to_string(); test("NaN cannot be written") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("NaN cannot be written") { }; }
    inf := json_value.new_array();
    inf.add_number(1.0 / 0.0);
    try { json_writer.to_pretty(inf); test("infinity cannot be written") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("infinity cannot be written") { }; }

    // string escaping
    test("quote()") { expect(json_writer.quote("a" + q + "b")).should_be(q + "a\\" + q + "b" + q); };
    test("back slash") { expect(json_writer.quote("a\\b")).should_be(q + "a\\\\b" + q); };
    test("newline tab return") { expect(json_writer.quote("a\nb\tc\rd")).should_be(q + "a\\nb\\tc\\rd" + q); };
    ctl := new _int8[4];
    ctl[0] = 1; ctl[1] = 8; ctl[2] = 12; ctl[3] = 31;
    test("control characters") { expect(json_writer.quote(new string(ctl))).should_be(q + "\\u0001\\b\\f\\u001f" + q); };
    test("slash is not escaped") { expect(json_writer.quote("a/b")).should_be(q + "a/b" + q); };
    test("empty string") { expect(json_writer.quote("")).should_be(q + q); };

    euro := json_parser.parse(q + "caf\\u00e9 \\u20AC \\ud83d\\ude00" + q);
    plain := json_writer.to_compact(euro);
    test("non-ASCII written as bytes by default") { expect(io_strings.length(plain)).should_be(16); };
    ascii := new json_writer().set_ascii_only(true).write(euro);
    test("ascii only") { expect(ascii).should_be(q + "caf\\u00e9 \\u20ac \\ud83d\\ude00" + q); };
    test("ascii only reads back the same") { expect_true(json_parser.parse(ascii).equals_value(euro)); };
    broken := new _int8[2];
    broken[0] = 0xC3; broken[1] = 'x';
    test("invalid UTF-8 escaped byte by byte") { expect(new json_writer().set_ascii_only(true).write(json_value.of_string(new string(broken)))).should_be(q + "\\u00c3x" + q); };
    try { new json_writer().set_indent(0 - 1); test("negative indent") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("negative indent") { }; }
}

def test_round_trips() {
    expect_round_trip("scalars", "[null, true, false, 0, -1, 2.5, 1e300, 1e-300, 123456789.125, " + q + "text" + q + "]");
    expect_round_trip("nested", "{" + q + "a" + q + ": {" + q + "b" + q + ": {" + q + "c" + q + ": [1, [2, [3, {" + q + "d" + q + ": null}]]]}}, " + q + "e" + q + ": []}");
    expect_round_trip("escapes", "[" + q + "quote \\" + q + " back \\\\ slash \\/ nl \\n tab \\t cr \\r bs \\b ff \\f" + q + ", " + q + "\\u0000\\u001f\\u007f" + q + "]");
    expect_round_trip("unicode", "{" + q + "\\u00e9t\\u00e9" + q + ": " + q + "\\u4e2d\\u6587 \\ud83d\\ude00" + q + "}");
    expect_round_trip("empty containers", "[[], {}, [[]], [{}], {" + q + "x" + q + ": {}}]");
    expect_round_trip("odd names", "{" + q + q + ": 1, " + q + " " + q + ": 2, " + q + "a.b[0]" + q + ": 3, " + q + "\\n" + q + ": 4}");
    expect_round_trip("numbers", "[0.1, 0.2, 0.30000000000000004, 3.141592653589793, 2.718281828459045, 1.7976931348623157e308, 5e-324, 9007199254740993, -0.000001]");

    // through a file
    doc := json_parser.parse("{" + q + "title" + q + ": " + q + "config" + q + ", " + q + "values" + q + ": [1, 2, 3], " + q + "on" + q + ": true}");
    target := new file(base_dir + "/doc.json");
    new json_writer().set_indent(2).write_file(doc, target);
    text := target.read_text();
    test("indented file ends with a newline") { expect_true(io_strings.ends_with(text, "}\n")); };
    test("parse_file") { expect_true(json_parser.parse_file(target).equals_value(doc)); };
    new json_writer().write_file(doc, target);
    test("compact file") { expect(target.read_text()).should_be(doc.to_string()!!); };
    try { json_parser.parse_file(new file(base_dir + "/missing.json")); test("parse missing file") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("parse missing file") { }; }
    target.write_text("{oops");
    try { json_parser.parse_file(target); test("parse bad file") { fail_test("no exception"); }; }
    catch(e: json_exception) { test("parse bad file") { }; }

    // sorted, ascii-only, indented output still parses to the same value
    mixed := json_parser.parse("{" + q + "z" + q + ": [1, {" + q + "b" + q + ": " + q + "\\u00fc" + q + ", " + q + "a" + q + ": null}], " + q + "a" + q + ": " + q + "x" + q + "}");
    fancy := new json_writer().set_indent(3).set_sort_keys(true).set_ascii_only(true).write(mixed);
    test("all options together round trip") { expect_true(json_parser.parse(fancy).equals_value(mixed)); };
    test("sorted output starts with a") { expect_true(io_strings.starts_with(fancy, "{\n   " + q + "a" + q + ": ")); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_data_json") {
        start := new file(base_dir);
        start.delete_recursively();
        test("test directory created") { expect_true(start.mkdirs()); };

        test_values();
        test_paths_copy_equals();
        test_parser_good();
        test_parser_bad();
        test_writer();
        test_round_trips();

        test("cleanup") { expect_true(start.delete_recursively()); };
    };
    finish_tests("lib_data_json");
}
