mod main;

import ( testing, std.io, std.system )

/**
 * std.system args_parser (flags, options, positionals, defaults, help,
 * errors) and logger (levels, formats, injected clock, writer and file
 * targets).
 *
 * Works only inside /tmp/sharp_suite_io_logger and removes it at the end.
 */

base_dir : string = "/tmp/sharp_suite_io_logger";

/** a command line from one string: the arguments are separated by '|' */
def line(text: string): list<string> {
    if(io_strings.length(text) == 0) {
        return new list<string>();
    }
    return io_strings.split(text, '|');
}

def new_parser(): args_parser {
    parser := new args_parser("copytool", "Copies files with style.");
    parser.add_flag("verbose", 'v', "print what is being done");
    parser.add_flag("all", 'a', "include hidden files");
    parser.add_flag("dry-run", 0, "only show what would happen");
    parser.add_option("jobs", 'j', "N", "how many copies run at once", "4");
    parser.add_optional_option("include", 'I', "DIR", "an extra directory");
    parser.add_required_option("output", 'o', "DIR", "where the copies go");
    parser.add_positional("source", "the file to copy", true);
    parser.add_positional("target", "the name of the copy", false);
    return parser;
}

/** parsing must fail with exactly this message */
def expect_args_error(name: string, parser: args_parser, text: string, message: string) {
    try {
        parser.parse_list(line(text));
        fail(name, "no exception");
    } catch(e: args_exception) {
        expect_str(name, e.get_message(), message);
    }
}

def test_args() {
    p := new_parser();
    p.parse_list(line("-o|out|file.txt"));
    expect_false("flag off by default", p.flag("verbose").value);
    expect_str("default value", p.value("jobs"), "4");
    expect("default as number", p.number("jobs"), 4);
    expect_false("has is false for a default", p.has("jobs").value);
    expect_str("short option with separate value", p.value("output"), "out");
    expect_true("has", p.has("output").value);
    expect_str("positional", p.value("source"), "file.txt");
    expect_false("optional positional missing", p.has("target").value);
    expect_str("missing optional positional is empty", p.value("target"), "");
    expect_str("value_or", p.value_or("target", "same"), "same");
    expect_false("optional option missing", p.has("include").value);
    expect("values of a missing option", p.values("include").size().value, 0);
    expect("no extra arguments", p.rest().size().value, 0);
    expect_false("help not requested", p.help_requested().value);

    p.parse_list(line("--verbose|--jobs|8|--output=dir with space|src|dst|--dry-run"));
    expect_true("long flag", p.flag("verbose").value);
    expect_true("flag after positionals", p.flag("dry-run").value);
    expect_false("other flag still off", p.flag("all").value);
    expect("long option with separate value", p.whole_number("jobs"), 8);
    expect_str("long option with =", p.value("output"), "dir with space");
    expect_str("first positional", p.value("source"), "src");
    expect_str("second positional", p.value("target"), "dst");

    p.parse_list(line("-va|-j16|-oX|s"));
    expect_true("combined flags: v", p.flag("verbose").value);
    expect_true("combined flags: a", p.flag("all").value);
    expect("value attached to the letter", p.number("jobs"), 16);
    expect_str("value attached to -o", p.value("output"), "X");
    p.parse_list(line("-vao|out|s"));
    expect_str("flags then an option in one group", p.value("output"), "out");
    expect_true("...with its flags", p.flag("all").value);
    expect_false("a new parse starts fresh", p.flag("dry-run").value);

    p.parse_list(line("-vvv|-I|a|--include|b|-Ic|-o|1|-o|2|s"));
    expect("count of a repeated flag", p.count("verbose"), 3);
    expect_str("repeated option: all values", io_strings.join(p.values("include"), ","), "a,b,c");
    expect_str("repeated option: the last wins", p.value("output"), "2");
    expect("count of an option", p.count("output"), 2);

    p.parse_list(line("-o|out|--jobs|-5|--|-not-an-option|--verbose"));
    expect("an option takes the next argument whatever it is", p.number("jobs"), 0 - 5);
    expect_str("after --: positional starting with a dash", p.value("source"), "-not-an-option");
    expect_str("after --: even --verbose", p.value("target"), "--verbose");
    expect_false("...so the flag is off", p.flag("verbose").value);
    p.parse_list(line("-o|out|-"));
    expect_str("a single dash is a positional", p.value("source"), "-");
    p.parse_list(line("--output=|s"));
    expect_str("empty value with =", p.value("output"), "");
    expect_true("...still counts as given", p.has("output").value);
    p.parse_list(line("--output=a=b|s"));
    expect_str("value containing =", p.value("output"), "a=b");

    // errors made by the user
    expect_args_error("unknown long option", p, "--colour|-o|x|s", "unknown option --colour");
    expect_args_error("unknown short option", p, "-x|-o|x|s", "unknown option -x");
    expect_args_error("unknown letter in a group", p, "-vz|-o|x|s", "unknown option -z");
    expect_args_error("missing value (long)", p, "s|--output", "option --output needs a value");
    expect_args_error("missing value (short)", p, "s|-o", "option -o needs a value");
    expect_args_error("missing required option", p, "s", "missing required option --output");
    expect_args_error("missing required argument", p, "-o|x", "missing required argument <source>");
    expect_args_error("too many arguments", p, "-o|x|a|b|c", "unexpected argument c");
    expect_args_error("flag with a value", p, "--verbose=yes|-o|x|s", "option --verbose does not take a value");
    expect_args_error("empty command line", p, "", "missing required option --output");
    p.parse_list(line("-o|x|s|--jobs|many"));
    try { p.number("jobs"); fail("not a number", "no exception"); }
    catch(e: args_exception) { expect_str("not a number", e.get_message(), "option --jobs needs a number, not \"many\""); }
    p.parse_list(line("-o|x|s|--jobs|2.5"));
    expect("number with fraction", p.number("jobs"), 2.5);
    try { p.whole_number("jobs"); fail("not a whole number", "no exception"); }
    catch(e: args_exception) { expect_str("not a whole number", e.get_message(), "option --jobs needs a whole number, not \"2.5\""); }

    // help
    p.parse_list(line("--help"));
    expect_true("--help", p.help_requested().value);
    p.parse_list(line("-h"));
    expect_true("-h, and nothing is missing", p.help_requested().value);
    p.parse_list(line("-o|x|s"));
    expect_false("help flag is reset", p.help_requested().value);
    expect_str("usage", p.usage(), "usage: copytool [options] --output DIR <source> [target]");
    expect_str("help", p.help(),
        "usage: copytool [options] --output DIR <source> [target]\n"
        + "\n"
        + "Copies files with style.\n"
        + "\n"
        + "arguments:\n"
        + "  source             the file to copy\n"
        + "  target             the name of the copy (optional)\n"
        + "\n"
        + "options:\n"
        + "  -v, --verbose      print what is being done\n"
        + "  -a, --all          include hidden files\n"
        + "      --dry-run      only show what would happen\n"
        + "  -j, --jobs N       how many copies run at once (default: 4)\n"
        + "  -I, --include DIR  an extra directory\n"
        + "  -o, --output DIR   where the copies go (required)\n"
        + "  -h, --help         show this help\n");

    // extra arguments and a parser with its own -h
    more := new args_parser("list", "");
    more.add_flag("human", 'h', "sizes for people");
    more.add_positional("dir", "where to look", false);
    more.allow_extra("patterns", "names to look for");
    more.parse_list(line("-h|src|*.a|*.b|--|-c"));
    expect_true("own -h is a flag", more.flag("human").value);
    expect_false("...and not help", more.help_requested().value);
    expect_str("rest", io_strings.join(more.rest(), ","), "*.a,*.b,-c");
    expect_str("usage with extras", more.usage(), "usage: list [options] [dir] [patterns...]");
    expect_str("help with extras and own -h", more.help(),
        "usage: list [options] [dir] [patterns...]\n"
        + "\n"
        + "arguments:\n"
        + "  dir          where to look (optional)\n"
        + "  patterns...  names to look for\n"
        + "\n"
        + "options:\n"
        + "  -h, --human  sizes for people\n"
        + "      --help   show this help\n");
    more.parse_list(line("--help"));
    expect_true("--help still works", more.help_requested().value);
    more.parse_list(new list<string>());
    expect_false("nothing given", more.has("dir").value);
    bare := new args_parser("bare", "");
    expect_str("usage without options", bare.usage(), "usage: bare");
    bare.parse_list(new list<string>());
    pass("empty parser parses nothing");

    // parse() with an array, as main() gets it
    arr := new string[3];
    arr[0] = new string("-o"); arr[1] = new string("dir"); arr[2] = new string("file");
    p.parse(arr);
    expect_str("parse(string[])", p.value("source"), "file");

    // mistakes of the program
    try { p.flag("nope"); fail("undeclared name", "no exception"); }
    catch(e: illegal_argument_exception) { pass("undeclared name"); }
    try { p.add_flag("verbose", 0, "again"); fail("name declared twice", "no exception"); }
    catch(e: illegal_argument_exception) { pass("name declared twice"); }
    try { p.add_flag("other", 'v', "again"); fail("letter declared twice", "no exception"); }
    catch(e: illegal_argument_exception) { pass("letter declared twice"); }
    try { p.add_flag("has space", 0, "x"); fail("malformed name", "no exception"); }
    catch(e: illegal_argument_exception) { pass("malformed name"); }
    try { p.add_flag("-dash", 0, "x"); fail("name starting with a dash", "no exception"); }
    catch(e: illegal_argument_exception) { pass("name starting with a dash"); }
    try { p.add_flag("", 0, "x"); fail("empty name", "no exception"); }
    catch(e: illegal_argument_exception) { pass("empty name"); }
    try { p.add_flag("sym", '-', "x"); fail("symbol as letter", "no exception"); }
    catch(e: illegal_argument_exception) { pass("symbol as letter"); }
    try { p.add_positional("late", "x", true); fail("required after optional", "no exception"); }
    catch(e: illegal_argument_exception) { pass("required after optional"); }
    try { p.add_positional("source", "x", false); fail("positional declared twice", "no exception"); }
    catch(e: illegal_argument_exception) { pass("positional declared twice"); }
}

def test_logger() {
    sink := new string_writer();
    log := new logger("server");
    log.add_writer(sink);
    log.set_clock({ -> (decimal) return 1762939800123; });      // 2025-11-12 09:30:00.123 UTC
    expect_str("name", log.name(), "server");
    expect("default level is info", log.get_level(), logger.level_info);
    expect("one target", log.target_count(), 1);

    log.info("listening on port 8080");
    expect_str("default format", sink.to_string()!!, "2025-11-12 09:30:00.123 INFO  [server] listening on port 8080\n");
    sink.clear();
    log.debug("hidden");
    log.trace("hidden too");
    expect("below the level: nothing written", sink.length(), 0);
    expect("dropped count", log.get_dropped(), 2);
    log.warn("careful");
    log.error("broken");
    expect_str("warn and error", sink.to_string()!!,
        "2025-11-12 09:30:00.123 WARN  [server] careful\n2025-11-12 09:30:00.123 ERROR [server] broken\n");
    expect("written count", log.get_written(), 3);

    sink.clear();
    log.set_level(logger.level_trace);
    log.set_timestamps(false);
    log.trace("t");
    log.debug("d");
    expect_str("no time stamps, all levels", sink.to_string()!!, "TRACE [server] t\nDEBUG [server] d\n");
    expect_true("is_enabled", log.is_enabled(logger.level_trace).value);
    log.set_level(logger.level_error);
    expect_false("is_enabled below", log.is_enabled(logger.level_warn).value);
    expect_true("is_enabled at", log.is_enabled(logger.level_error).value);
    log.set_level(logger.level_off);
    sink.clear();
    log.error("even this");
    expect("off writes nothing", sink.length(), 0);
    expect_false("is_enabled when off", log.is_enabled(logger.level_error).value);

    sink.clear();
    log.set_level(logger.level_info).set_timestamps(true);
    log.set_format("[{level}] {message} ({name} at {time}) {unknown} {");
    log.info("custom");
    expect_str("custom format", sink.to_string()!!, "[INFO ] custom (server at 2025-11-12 09:30:00.123) {unknown} {\n");
    sink.clear();
    log.set_timestamps(false);
    log.info("custom");
    expect_str("custom format without time", sink.to_string()!!, "[INFO ] custom (server at ) {unknown} {\n");
    log.set_format("{message}");
    sink.clear();
    log.log(logger.level_warn, "by number");
    log.info("");
    log.info("with {name} inside");
    expect_str("message only; placeholders in the message are left alone", sink.to_string()!!, "by number\n\nwith {name} inside\n");
    expect_str("format_line", log.format_line(logger.level_error, "x"), "x");
    sink.clear();
    log.set_format("{level}: {message}");
    try { always_fails(); } catch(e: illegal_state_exception) { log.log_exception("could not start", e); }
    expect_str("log_exception", sink.to_string()!!, "ERROR: could not start: the reason\n");

    try { log.log(7, "x"); fail("bad message level", "no exception"); }
    catch(e: illegal_argument_exception) { pass("bad message level"); }
    try { log.log(logger.level_off, "x"); fail("off as message level", "no exception"); }
    catch(e: illegal_argument_exception) { pass("off as message level"); }
    try { log.set_level(9); fail("bad level", "no exception"); }
    catch(e: illegal_argument_exception) { pass("bad level"); }

    expect_str("level_name", logger.level_name(logger.level_warn), "WARN");
    expect_str("level_name off", logger.level_name(logger.level_off), "OFF");
    expect("level_of", logger.level_of("debug"), logger.level_debug);
    expect("level_of upper case", logger.level_of(" ERROR "), logger.level_error);
    expect("level_of warning", logger.level_of("Warning"), logger.level_warn);
    expect("level_of off", logger.level_of("off"), logger.level_off);
    try { logger.level_of("loud"); fail("level_of unknown", "no exception"); }
    catch(e: illegal_argument_exception) { pass("level_of unknown"); }

    // dates
    expect_str("epoch", logger.format_time(0), "1970-01-01 00:00:00.000");
    expect_str("one millisecond before a day ends", logger.format_time(86399999), "1970-01-01 23:59:59.999");
    expect_str("leap day 2000", logger.format_time(951782400000), "2000-02-29 00:00:00.000");
    expect_str("day after leap day", logger.format_time(951868800000), "2000-03-01 00:00:00.000");
    expect_str("end of 1999", logger.format_time(946684799000), "1999-12-31 23:59:59.000");
    expect_str("2024 leap day", logger.format_time(1709210096789), "2024-02-29 12:34:56.789");
    expect_str("2100 is not a leap year", logger.format_time(4107542400000), "2100-03-01 00:00:00.000");
    expect_str("2038", logger.format_time(2147483648000), "2038-01-19 03:14:08.000");
    expect_str("negative becomes the epoch", logger.format_time(0 - 5), "1970-01-01 00:00:00.000");

    // several targets, and closing
    second := new string_writer();
    log.add_writer(second);
    sink.clear();
    log.info("both");
    expect_str("first target", sink.to_string()!!, "INFO : both\n");
    expect_str("second target", second.to_string()!!, "INFO : both\n");
    log.close();
    log.close();
    expect_true("close closes the targets", sink.is_closed().value);
    try { log.info("late"); fail("log after close", "no exception"); }
    catch(e: illegal_state_exception) { pass("log after close"); }

    silent := new logger("nowhere");
    silent.info("no target, no problem");
    expect("a logger without targets still counts", silent.get_written(), 1);
    silent.add_console();
    silent.set_level(logger.level_off);
    silent.error("not printed");
    expect("console target added", silent.target_count(), 1);
    live := new logger("clock");
    live.add_writer(new string_writer());
    live.info("uses the real clock");
    pass("real clock");

    // file targets append
    target := new file(base_dir + "/app.log");
    target.write_text("earlier line\n");
    flog := new logger("app");
    flog.set_timestamps(false).add_file(target);
    flog.info("one");
    expect_str("auto flush: on disk at once", target.read_text(), "earlier line\nINFO  [app] one\n");
    flog.set_auto_flush(false);
    flog.info("two");
    expect_str("no auto flush: not yet on disk", target.read_text(), "earlier line\nINFO  [app] one\n");
    flog.flush();
    expect_str("flush", target.read_text(), "earlier line\nINFO  [app] one\nINFO  [app] two\n");
    flog.warn("three");
    flog.close();
    expect("close writes the rest", target.read_lines().size().value, 4);
    again := new logger("app");
    again.set_timestamps(false).add_file(target);
    again.error("four");
    again.close();
    expect_str("a new logger appends", target.read_lines().at(4), "ERROR [app] four");
    try { new logger("x").add_file(new file(base_dir)); fail("directory as log file", "no exception"); }
    catch(e: io_exception) { pass("directory as log file"); }
}

def always_fails() {
    throw new illegal_state_exception("the reason");
}

def main(args: string[]) {
    start := new file(base_dir);
    start.delete_recursively();
    expect_true("test directory created", start.mkdirs().value);

    test_args();
    test_logger();

    expect_true("cleanup", start.delete_recursively().value);
    finish("lib_system_args_logger");
}
