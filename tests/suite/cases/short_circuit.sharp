mod main;

import ( testing )

/**
 * && and || stop early (short-circuit) whatever the operands are: native
 * numbers, bool / int objects, or functions returning them.
 */

calls : decimal = 0;

def counted_true(): bool { calls++; return true; }
def counted_false(): bool { calls++; return false; }
def boxed(v: decimal): int { return v; }
def native_true(): decimal { calls++; return 1; }

def main(args: string[]) {
    calls = 0;
    if(boxed(0) > 0 && counted_true()) { fail("&& false left", "the body ran"); }
    expect("&& with an object on the left skips the right side", calls, 0);

    calls = 0;
    if(counted_true() || counted_true()) { } else { fail("|| true left", "the else ran"); }
    expect("|| with an object on the left skips the right side", calls, 1);

    calls = 0;
    if(counted_false() && counted_true()) { fail("false && true", "the body ran"); }
    expect("false() && true() calls one function", calls, 1);

    calls = 0;
    if(counted_false() || counted_true()) { } else { fail("false || true", "the else ran"); }
    expect("false() || true() calls both", calls, 2);

    calls = 0;
    if(counted_true() && counted_true() && counted_false() && counted_true()) { fail("chain", "the body ran"); }
    expect("a chain of && stops at the first false", calls, 3);

    calls = 0;
    yes : bool = true;
    no : bool = false;
    if(no && counted_true()) { fail("no && f()", "the body ran"); }
    if(yes || counted_true()) { } else { fail("yes || f()", "the else ran"); }
    expect("bool variables on the left", calls, 0);

    calls = 0;
    zero : decimal = 0;
    if(zero && native_true()) { fail("0 && f()", "the body ran"); }
    if(zero == 0 || native_true()) { } else { fail("1 || f()", "the else ran"); }
    expect("native numbers on the left", calls, 0);

    items : decimal[] = new decimal[3];
    i : decimal = 3;
    hit : decimal = 0;
    try { if(i < 3 && items[i] == 0) { hit = 1; } } catch(e: exception) { hit = 2; }
    expect("the usual bounds guard does not read past the end", hit, 0);

    both : bool = yes && no;
    either : bool = yes || no;
    expect_false("a bool variable from &&", both);
    expect_true("a bool variable from ||", either);
    expect("&& of two objects as a number", ((yes && yes) as _int32) + ((yes && no) as _int32), 1);
    expect("mixed object and native", ((yes && 1) as _int32) + ((0 || no) as _int32) + ((boxed(5) && yes) as _int32), 2);
    finish("short_circuit");
}
