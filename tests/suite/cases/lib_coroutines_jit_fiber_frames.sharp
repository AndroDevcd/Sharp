mod main;

import (
    testing,
    std.io.coroutines
)

/**
 * KNOWN BUG (runtime, JIT only): a program in which two sibling coroutines
 * take turns (each yields, one of them twice) crashes with a segmentation
 * fault once the functions involved have been compiled by the JIT. With
 * -nojit it runs correctly.
 *
 * WHAT IS KNOWN
 *   - the crash is in return_method() (virtual_machine.cpp), reached from
 *     main_vm_loop on the thread that runs the coroutines
 *   - it needs the second yield: with one yield per coroutine, or with one
 *     coroutine per round, the same program runs
 *   - it happens in round 4 of the loop below, i.e. when job.run() and its
 *     callees reach their tenth call (JIT_CALL_THRESHOLD) while another fiber
 *     is suspended in the middle of the same functions
 *   - related, seen on the worker threads: a coroutine that yields on the
 *     default pool and continues on another thread sometimes ends with a call
 *     stack that belongs to another function ("Unhandled exception" with
 *     frames of platform.srt_init under job.run)
 *   The exact fault in the JIT's frame rebuild was not isolated; this file is
 *   the smallest program found that shows it every time.
 *
 * ALSO SEEN, not reduced to a small program: when the JIT compiles a function
 * for the first time while several worker threads are inside it, the process
 * sometimes crashes in the same place. tests/suite/cases/lib_coroutines_core.sharp
 * without its warm_up() crashed in 7 of 12 runs compiled with -O (in
 * test_async, at the first coroutines on the worker threads) and in 0 of 15
 * runs with the warm up. The suite tests of std.io.coroutines therefore run the
 * library once on one thread before they use the worker threads.
 *
 * EXPECTED: prints "RESULT PASS".
 * ACTUAL:   JIT: segmentation fault, no output.  -nojit: passes.
 */

rounds_done : decimal = 0;

def main(args: string[]) {
    for(i : decimal = 0; i < 40; i++) {
        run_blocking({ ->
            launch({ -> yield(); });
            launch({ -> yield(); yield(); });
        });
        rounds_done++;
    }

    expect("all rounds ran", rounds_done, 40);
    finish("lib_coroutines_jit_fiber_frames");
}
