mod main;

import ( testing )

/**
 * Classes: fields, constructors, methods, `self`, objects that are
 * independent of each other, and objects passed to and returned from
 * functions.
 */

/* fields with and without an initial value, no constructor written */
class defaults {
    plain : decimal;                    // no initial value: starts at 0
    with_value : decimal = 7;
    fraction : decimal = 2.5;
    negative : decimal = 0 - 3;
    from_expression : decimal = 6 * 7;
    text : string = "start";
    other : defaults?;              // no initial value: starts as null (`?` = may be null,
                                    // and is then read with `!!.`)
    numbers : decimal[]?;               // no initial value: starts as null
}

/* several constructors, chosen by the arguments */
class point {
    x : decimal = 0;
    y : decimal = 0;

    point() {
        x = 1;
        y = 1;
    }

    point(both: decimal) {
        x = both;
        y = both;
    }

    point(px: decimal, py: decimal) {
        x = px;
        y = py;
    }

    point(other: point) {
        x = other.x;
        y = other.y;
    }

    def sum(): decimal {
        return x + y;
    }

    /* a method that changes the object it is called on */
    def move_by(dx: decimal, dy: decimal) {
        x += dx;
        y += dy;
    }

    def scale(factor: decimal) {
        x = x * factor;
        y = y * factor;
    }

    /* a method that calls other methods of the same object */
    def sum_after_move(dx: decimal, dy: decimal): decimal {
        move_by(dx, dy);
        return sum();
    }

    def equals_point(other: point): decimal {
        return x == other.x && y == other.y;
    }

    /* a method that returns a new object and leaves this one alone */
    def plus(other: point): point {
        return new point(x + other.x, y + other.y);
    }

    /* a method that returns the object it was called on, so calls can be chained */
    def moved(dx: decimal, dy: decimal): point {
        move_by(dx, dy);
        return self;
    }
}

/* `self` tells a field from a parameter with the same name */
class account {
    balance : decimal = 0;
    owner : string = "";
    deposits : decimal = 0;

    account(owner: string, balance: decimal) {
        self->owner = owner;
        self->balance = balance;
    }

    def deposit(amount: decimal) {
        self->balance = self->balance + amount;
        deposits++;
    }

    /* returns 1 and takes the money if there is enough, otherwise 0 */
    def withdraw(amount: decimal): decimal {
        if(amount > balance) {
            return 0;
        }
        balance -= amount;
        return 1;
    }

    def transfer_to(other: account, amount: decimal): decimal {
        if(withdraw(amount)) {
            other.deposit(amount);
            return 1;
        }
        return 0;
    }

    def describe(): string {
        return owner + " account";
    }
}

/* a constructor can do work, not only copy its arguments */
class range {
    low : decimal = 0;
    high : decimal = 0;
    length : decimal = 0;

    range(a: decimal, b: decimal) {
        if(a < b) {
            low = a;
            high = b;
        } else {
            low = b;
            high = a;
        }
        length = high - low;
    }

    def contains(n: decimal): decimal {
        return n >= low && n <= high;
    }
}

/* a class whose fields are other objects and an array */
class line {
    from : point;
    to : point;

    line(a: point, b: point) {
        from = a;
        to = b;
    }

    def width(): decimal {
        return to.x - from.x;
    }
}

class stack {
    items : decimal[];
    count : decimal = 0;

    stack(capacity: decimal) {
        items = new decimal[capacity];
    }

    def push(n: decimal) {
        items[count] = n;
        count++;
    }

    def pop(): decimal {
        count--;
        return items[count];
    }

    def top(): decimal {
        return items[count - 1];
    }
}

/* a class with nothing in it can still be created */
class empty_class {
}

class counter {
    count : decimal = 0;

    def next(): decimal {
        count++;
        return count;
    }
}

def sum_of(p: point): decimal {
    return p.x + p.y;
}

def reset(p: point) {
    p.x = 0;
    p.y = 0;
}

def make_point(n: decimal): point {
    return new point(n, n * 2);
}

def same_point_back(p: point): point {
    return p;
}

def nothing_to_give(): point? {
    return null;
}

def main(args: string[]) {
    // ---- fields start at their initial value, or at 0 / null
    d := new defaults();
    expect("a field without a value starts at 0", d.plain, 0);
    expect("a field with a value", d.with_value, 7);
    expect("a field with a fraction", d.fraction, 2.5);
    expect("a field with a negative value", d.negative, 0 - 3);
    expect("a field set from an expression", d.from_expression, 42);
    expect_str("a string field", d.text, "start");
    expect_null("an object field without a value starts as null", d.other);
    expect_null("an array field without a value starts as null", d.numbers);

    // ---- fields can be read and written from outside
    d.plain = 11;
    d.with_value = d.with_value + 1;
    d.text = "changed";
    d.other = new defaults();
    d.numbers = new decimal[] { 5, 6 };
    expect("write then read a field", d.plain, 11);
    expect("change a field using its old value", d.with_value, 8);
    expect_str("write a string field", d.text, "changed");
    expect_not_null("write an object field", d.other);
    expect("a field of a field", d.other!!.with_value, 7);
    expect("an array field", d.numbers[1], 6);
    d.fraction += 0.5;
    expect("+= on a field", d.fraction, 3);
    d.plain++;
    expect("++ on a field", d.plain, 12);
    d.other!!.plain = 500;
    expect("write a field of a field", d.other!!.plain, 500);
    expect("...the outer object keeps its own", d.plain, 12);

    // ---- constructors: the one that matches the arguments runs
    p0 := new point();
    expect("constructor with no arguments: x", p0.x, 1);
    expect("constructor with no arguments: y", p0.y, 1);
    five : decimal = 5;
    p1 := new point(five);
    expect("constructor with one number: x", p1.x, 5);
    expect("constructor with one number: y", p1.y, 5);
    p2 := new point(3, 4);
    expect("constructor with two numbers: x", p2.x, 3);
    expect("constructor with two numbers: y", p2.y, 4);
    p3 := new point(p2);
    expect("constructor taking another point: x", p3.x, 3);
    expect("constructor taking another point: y", p3.y, 4);
    r := new range(9, 2);
    expect("a constructor that orders its arguments: low", r.low, 2);
    expect("a constructor that orders its arguments: high", r.high, 9);
    expect("a constructor that computes a field", r.length, 7);
    expect_not_null("a class with no members", new empty_class());

    // ---- methods
    expect("a method reading fields", p2.sum(), 7);
    p2.move_by(10, 20);
    expect("a method changing fields: x", p2.x, 13);
    expect("a method changing fields: y", p2.y, 24);
    p2.scale(2);
    expect("a second change builds on the first: x", p2.x, 26);
    expect("a second change builds on the first: y", p2.y, 48);
    expect("a method calling other methods", p2.sum_after_move(1, 1), 76);
    expect("a method with a condition: inside", r.contains(5), 1);
    expect("a method with a condition: on the edge", r.contains(9), 1);
    expect("a method with a condition: outside", r.contains(10), 0);
    expect("a method called on a new object", new point(20, 22).sum(), 42);

    // ---- self
    a := new account("ann", 100);
    expect_str("self->field = parameter of the same name (string)", a.owner, "ann");
    expect("self->field = parameter of the same name (number)", a.balance, 100);
    a.deposit(50);
    expect("self->field on both sides of an assignment", a.balance, 150);
    expect_str("a method returning a string built from a field", a.describe(), "ann account");
    expect("a method returning self gives the same object", p1.moved(1, 2) == p1, 1);
    expect("...after doing its work: x", p1.x, 6);
    expect("...after doing its work: y", p1.y, 7);
    expect("chained calls through self", p1.moved(1, 1).moved(1, 1).moved(1, 1).sum(), 19);

    // ---- methods that return a result and change the object
    expect("withdraw less than the balance", a.withdraw(30), 1);
    expect("...takes the money", a.balance, 120);
    expect("withdraw more than the balance", a.withdraw(500), 0);
    expect("...leaves the money", a.balance, 120);

    // ---- every object has its own fields
    first := new counter();
    second := new counter();
    first.next();
    first.next();
    first.next();
    second.next();
    expect("first counter was stepped three times", first.count, 3);
    expect("second counter was stepped once", second.count, 1);
    expect("stepping one again", first.next(), 4);
    expect("...does not move the other", second.count, 1);
    b := new account("bob", 10);
    expect("one object changing another: allowed", a.transfer_to(b, 70), 1);
    expect("...the giver", a.balance, 50);
    expect("...the receiver", b.balance, 80);
    expect("...the receiver's own counter", b.deposits, 1);
    expect("...the giver's own counter", a.deposits, 1);
    expect("one object changing another: refused", a.transfer_to(b, 51), 0);
    expect("...nothing moved", b.balance, 80);
    expect_str("each object keeps its own string", b.owner, "bob");

    // ---- many objects in an array
    counters : counter[] = new counter[5];
    for(i : decimal = 0; i < 5; i++) {
        counters[i] = new counter();
        for(j : decimal = 0; j < i * 2; j++) {
            counters[i].next();
        }
    }
    expect("object 0 of 5", counters[0].count, 0);
    expect("object 1 of 5", counters[1].count, 2);
    expect("object 4 of 5", counters[4].count, 8);

    // ---- objects as fields
    l := new line(new point(1, 2), new point(8, 2));
    expect("a method using two object fields", l.width(), 7);
    expect("reading through two objects", l.to.x, 8);
    l.from.x = 4;
    expect("writing through two objects", l.width(), 4);
    s := new stack(8);
    s.push(10);
    s.push(20);
    s.push(30);
    expect("an array field filled by a method", s.count, 3);
    expect("top of the stack", s.top(), 30);
    expect("pop gives the last one pushed", s.pop(), 30);
    expect("...then the one before", s.pop(), 20);
    expect("...and one is left", s.count, 1);

    // ---- objects as parameters and return values
    q := new point(6, 9);
    expect("an object as a parameter", sum_of(q), 15);
    reset(q);
    expect("a function changing the object it was given: x", q.x, 0);
    expect("a function changing the object it was given: y", q.y, 0);
    made := make_point(21);
    expect("an object as a return value: x", made.x, 21);
    expect("an object as a return value: y", made.y, 42);
    expect("a method taking an object", made.equals_point(new point(21, 42)), 1);
    expect("a method taking an object, different values", made.equals_point(new point(21, 43)), 0);
    added := made.plus(new point(1, 1));
    expect("a method returning a new object: x", added.x, 22);
    expect("a method returning a new object: y", added.y, 43);
    expect("...the original is unchanged", made.x, 21);
    expect_null("a function returning null instead of an object", nothing_to_give());

    // ---- identity: two variables can name one object
    original := new point(1, 2);
    same := original;
    copy_of := new point(original);
    expect("a variable assigned from another is the same object", same == original, 1);
    expect("a copy with equal fields is a different object", copy_of == original, 0);
    expect("!= on the same object", same != original, 0);
    expect("!= on different objects", copy_of != original, 1);
    same.x = 50;
    expect("a change through one name is seen through the other", original.x, 50);
    expect("...and not in the copy", copy_of.x, 1);
    expect("a function returning its argument gives the same object", same_point_back(original) == original, 1);
    expect("two new objects are never the same", new point(1, 1) == new point(1, 1), 0);
    expect("an object is not null", original != null, 1);
    same = copy_of;
    expect("a variable can be pointed at another object", same.x, 1);
    expect("...which leaves the first object alone", original.x, 50);
    empty : point? = null;
    expect("a variable holding null", empty == null, 1);
    empty = original;
    expect("...then an object", empty!!.x, 50);

    finish("classes");
}
