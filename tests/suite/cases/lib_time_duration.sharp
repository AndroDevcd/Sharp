mod main;

import ( testing, std.time )

/**
 * std.time.duration: creating durations in every unit, the seconds + nanos
 * representation (also for negative values), arithmetic, comparison,
 * conversion to one unit, the readable and the ISO-8601 text forms, and
 * parsing both.
 */

def text(d: duration): string {
    return d.to_string()!!;
}

/** 1 when duration.parse(s) throws a date_time_exception */
def rejects(s: string): var {
    try {
        duration.parse(s);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def main(args: string[]) {
    // ---- creating: every unit lands in seconds + nanos
    expect("of_seconds: seconds", duration.of_seconds(90).seconds(), 90);
    expect("of_seconds: nanos", duration.of_seconds(90).nanos(), 0);
    expect("of_minutes", duration.of_minutes(2).seconds(), 120);
    expect("of_hours", duration.of_hours(2).seconds(), 7200);
    expect("of_days", duration.of_days(2).seconds(), 172800);
    expect("of_millis: seconds", duration.of_millis(1500).seconds(), 1);
    expect("of_millis: nanos", duration.of_millis(1500).nanos(), 500000000);
    expect("of_micros: seconds", duration.of_micros(2000001).seconds(), 2);
    expect("of_micros: nanos", duration.of_micros(2000001).nanos(), 1000);
    expect("of_nanos: seconds", duration.of_nanos(3000000007).seconds(), 3);
    expect("of_nanos: nanos", duration.of_nanos(3000000007).nanos(), 7);
    expect("of_seconds with adjustment: seconds", duration.of_seconds(3, 1500000000).seconds(), 4);
    expect("of_seconds with adjustment: nanos", duration.of_seconds(3, 1500000000).nanos(), 500000000);
    expect("of_seconds(1.5): seconds", duration.of_seconds(1.5).seconds(), 1);
    expect("of_seconds(1.5): nanos", duration.of_seconds(1.5).nanos(), 500000000);
    expect("of_seconds(0.25): nanos", duration.of_seconds(0.25).nanos(), 250000000);
    expect("zero: seconds", duration.zero.seconds(), 0);
    expect("zero: nanos", duration.zero.nanos(), 0);

    // ---- negative durations: seconds round down, nanos stay 0 .. 999,999,999
    expect("-1500 ms: seconds", duration.of_millis(0 - 1500).seconds(), 0 - 2);
    expect("-1500 ms: nanos", duration.of_millis(0 - 1500).nanos(), 500000000);
    expect("-1 ns: seconds", duration.of_nanos(0 - 1).seconds(), 0 - 1);
    expect("-1 ns: nanos", duration.of_nanos(0 - 1).nanos(), 999999999);
    expect("of_seconds(3, -1): seconds", duration.of_seconds(3, 0 - 1).seconds(), 2);
    expect("of_seconds(3, -1): nanos", duration.of_seconds(3, 0 - 1).nanos(), 999999999);
    expect("of_seconds(-0.5): seconds", duration.of_seconds(0 - 0.5).seconds(), 0 - 1);
    expect("of_seconds(-0.5): nanos", duration.of_seconds(0 - 0.5).nanos(), 500000000);
    expect("-1 micro: nanos", duration.of_micros(0 - 1).nanos(), 999999000);

    // ---- sign
    expect_true("zero is_zero", duration.zero.is_zero());
    expect_false("zero is not negative", duration.zero.is_negative());
    expect_false("zero is not positive", duration.zero.is_positive());
    expect_true("1 ns is positive", duration.of_nanos(1).is_positive());
    expect_true("-1 ns is negative", duration.of_nanos(0 - 1).is_negative());
    expect_false("-1 ns is not zero", duration.of_nanos(0 - 1).is_zero());

    // ---- arithmetic
    a := duration.of_millis(1500);
    b := duration.of_millis(700);
    expect("plus carries nanos into seconds", a.plus(b).to_millis(), 2200);
    expect("plus: seconds", a.plus(b).seconds(), 2);
    expect("plus: nanos", a.plus(b).nanos(), 200000000);
    expect("minus", a.minus(b).to_millis(), 800);
    expect("minus below zero", b.minus(a).to_millis(), 0 - 800);
    expect("minus borrows: seconds", duration.of_seconds(2).minus(duration.of_nanos(1)).seconds(), 1);
    expect("minus borrows: nanos", duration.of_seconds(2).minus(duration.of_nanos(1)).nanos(), 999999999);
    expect("operator +", (a + b).to_millis(), 2200);
    expect("operator -", (a - b).to_millis(), 800);
    expect("operator *", (a * 3).to_millis(), 4500);
    expect("operator /", (a / 3).to_millis(), 500);
    expect("multiplied_by a negative", a.multiplied_by(0 - 2).to_millis(), 0 - 3000);
    expect("multiplied_by 0", a.multiplied_by(0).to_millis(), 0);
    expect("multiplied_by carries: seconds", duration.of_nanos(999999999).multiplied_by(3).seconds(), 2);
    expect("multiplied_by carries: nanos", duration.of_nanos(999999999).multiplied_by(3).nanos(), 999999997);
    expect("divided_by 2", duration.of_seconds(3).divided_by(2).to_millis(), 1500);
    expect("divided_by 3: seconds", duration.of_seconds(10).divided_by(3).seconds(), 3);
    expect("divided_by 3: nanos (rounded down)", duration.of_seconds(10).divided_by(3).nanos(), 333333333);
    expect("divided_by a negative", duration.of_seconds(3).divided_by(0 - 2).to_millis(), 0 - 1500);
    expect("1 hour / 7: seconds", duration.of_hours(1).divided_by(7).seconds(), 514);
    expect("1 hour / 7: nanos", duration.of_hours(1).divided_by(7).nanos(), 285714285);
    expect("duration / duration", duration.of_minutes(90).divided_by(duration.of_hours(1)), 1.5);
    expect("negated", a.negated().to_millis(), 0 - 1500);
    expect_true("negated twice is the original", a.negated().negated() == a);
    expect("abs of a negative", duration.of_millis(0 - 1500).abs().to_millis(), 1500);
    expect("abs of a positive", a.abs().to_millis(), 1500);
    expect("plus_hours", a.plus_hours(1).to_millis(), 3601500);
    expect("plus_minutes", a.plus_minutes(1).to_millis(), 61500);
    expect("plus_seconds", a.plus_seconds(1).to_millis(), 2500);
    expect("plus_millis", a.plus_millis(0 - 500).to_millis(), 1000);
    expect("plus_nanos", a.plus_nanos(500000000).seconds(), 2);
    expect("plus_days", duration.zero.plus_days(1).seconds(), 86400);
    expect("with_seconds keeps nanos", a.with_seconds(10).to_millis(), 10500);
    expect("with_nanos keeps seconds", a.with_nanos(1).nanos(), 1);
    expect("the operands are unchanged", a.to_millis(), 1500);

    // ---- beyond what one number could hold: 300 years in nanoseconds is over 2^53
    long_time := duration.of_days(109575).plus(duration.of_nanos(1));
    expect("300 years + 1 ns: seconds", long_time.seconds(), 9467280000);
    expect("300 years + 1 ns: the nanosecond is kept", long_time.nanos(), 1);
    expect("...and comes back out", long_time.minus(duration.of_days(109575)).to_nanos(), 1);

    // ---- errors
    caught : var = 0;
    try { a.divided_by(0); } catch(e: date_time_exception) { caught = 1; }
    expect("divided_by(0) throws", caught, 1);
    caught = 0;
    try { a.divided_by(duration.zero); } catch(e: date_time_exception) { caught = 1; }
    expect("divided_by(zero duration) throws", caught, 1);
    caught = 0;
    try { a.multiplied_by(1.5); } catch(e: date_time_exception) { caught = 1; }
    expect("multiplied_by a fraction throws", caught, 1);
    caught = 0;
    try { duration.of_hours(0.5); } catch(e: date_time_exception) { caught = 1; }
    expect("of_hours(0.5) throws", caught, 1);
    caught = 0;
    try { a.with_nanos(1000000000); } catch(e: date_time_exception) { caught = 1; }
    expect("with_nanos out of range throws", caught, 1);

    // ---- comparing
    expect_true("==", duration.of_minutes(1) == duration.of_seconds(60));
    expect_true("== across units", duration.of_millis(1000) == duration.of_nanos(1000000000));
    expect_false("== different", a == b);
    expect_true("!=", a != b);
    expect_true("<", b < a);
    expect_false("< the other way", a < b);
    expect_true("<=", b <= a);
    expect_true("<= equal", a <= duration.of_millis(1500));
    expect_true(">", a > b);
    expect_true(">=", a >= b);
    expect_true("nanos decide when seconds are equal", duration.of_seconds(1, 1) > duration.of_seconds(1));
    expect_true("a negative is less than zero", duration.of_nanos(0 - 1) < duration.zero);
    expect_true("-2 s is less than -1.5 s", duration.of_seconds(0 - 2) < duration.of_millis(0 - 1500));
    expect("compare_to less", b.compare_to(a), 0 - 1);
    expect("compare_to equal", a.compare_to(duration.of_millis(1500)), 0);
    expect("compare_to greater", a.compare_to(b), 1);

    // ---- conversion to one unit drops the fraction (rounds towards zero)
    d := duration.of_seconds(93784, 500000000);            // 1 day 2 h 3 min 4.5 s
    expect("to_days", d.to_days(), 1);
    expect("to_hours", d.to_hours(), 26);
    expect("to_minutes", d.to_minutes(), 1563);
    expect("to_seconds", d.to_seconds(), 93784);
    expect("to_millis", d.to_millis(), 93784500);
    expect("to_micros", d.to_micros(), 93784500000);
    expect("to_nanos", d.to_nanos(), 93784500000000);
    expect("to_fractional_seconds", d.to_fractional_seconds(), 93784.5);
    expect("hours_part", d.hours_part(), 2);
    expect("minutes_part", d.minutes_part(), 3);
    expect("seconds_part", d.seconds_part(), 4);
    expect("millis_part", d.millis_part(), 500);
    expect("nanos_part", d.nanos_part(), 500000000);
    expect("90 s is 1 minute", duration.of_seconds(90).to_minutes(), 1);
    expect("-90 s is -1 minute", duration.of_seconds(0 - 90).to_minutes(), 0 - 1);
    expect("-0.5 s is 0 whole seconds", duration.of_millis(0 - 500).to_seconds(), 0);
    expect("-1500 ms to_seconds", duration.of_millis(0 - 1500).to_seconds(), 0 - 1);
    expect("-1500 ms to_millis", duration.of_millis(0 - 1500).to_millis(), 0 - 1500);
    expect("-1.5 ms to_micros", duration.of_micros(0 - 1500).to_micros(), 0 - 1500);
    expect("-36 h to_days", duration.of_hours(0 - 36).to_days(), 0 - 1);
    expect("parts ignore the sign", duration.of_seconds(0 - 3723).minutes_part(), 2);

    // ---- readable text
    expect_str("zero", text(duration.zero), "0s");
    expect_str("seconds", text(duration.of_seconds(45)), "45s");
    expect_str("minutes", text(duration.of_minutes(5)), "5m");
    expect_str("hours", text(duration.of_hours(3)), "3h");
    expect_str("days", text(duration.of_days(2)), "2d");
    expect_str("h m s with a fraction", text(duration.of_millis(3723500)), "1h 2m 3.5s");
    expect_str("days and hours", text(duration.of_hours(60)), "2d 12h");
    expect_str("all four units", text(d), "1d 2h 3m 4.5s");
    expect_str("a millisecond", text(duration.of_millis(1)), "0.001s");
    expect_str("a nanosecond", text(duration.of_nanos(1)), "0.000000001s");
    expect_str("no trailing zeros", text(duration.of_millis(1250)), "1.25s");
    expect_str("negative", text(duration.of_minutes(0 - 90)), "-1h 30m");
    expect_str("negative fraction", text(duration.of_millis(0 - 500)), "-0.5s");
    expect_str("interpolation", "took $a", "took 1.5s");

    // ---- ISO-8601 text
    expect_str("iso zero", duration.zero.to_iso_string(), "PT0S");
    expect_str("iso seconds", duration.of_seconds(45).to_iso_string(), "PT45S");
    expect_str("iso minutes", duration.of_minutes(5).to_iso_string(), "PT5M");
    expect_str("iso h m s", duration.of_millis(3723500).to_iso_string(), "PT1H2M3.5S");
    expect_str("iso has no days", duration.of_days(2).to_iso_string(), "PT48H");
    expect_str("iso millisecond", duration.of_millis(1).to_iso_string(), "PT0.001S");
    expect_str("iso negative", duration.of_minutes(0 - 90).to_iso_string(), "PT-1H-30M");
    expect_str("iso negative fraction", duration.of_millis(0 - 500).to_iso_string(), "PT-0.5S");
    expect_str("iso hours and seconds", duration.of_seconds(3601).to_iso_string(), "PT1H1S");

    // ---- parsing the ISO form
    expect("parse PT1H2M3.5S", duration.parse("PT1H2M3.5S").to_millis(), 3723500);
    expect("parse PT45S", duration.parse("PT45S").to_seconds(), 45);
    expect("parse PT0S", duration.parse("PT0S").to_nanos(), 0);
    expect("parse days", duration.parse("P2D").to_hours(), 48);
    expect("parse days and time", duration.parse("P2DT12H").to_hours(), 60);
    expect("parse PT48H", duration.parse("PT48H").to_days(), 2);
    expect("parse a fraction with 9 digits", duration.parse("PT0.000000001S").to_nanos(), 1);
    expect("parse a comma fraction", duration.parse("PT1,5S").to_millis(), 1500);
    expect("parse signed parts", duration.parse("PT-1H-30M").to_minutes(), 0 - 90);
    expect("parse a leading minus", duration.parse("-PT1H30M").to_minutes(), 0 - 90);
    expect("parse minus of a minus", duration.parse("-PT-10S").to_seconds(), 10);
    expect("parse mixed signs", duration.parse("PT1H-30M").to_minutes(), 30);
    expect("parse lower case", duration.parse("pt1h2m3s").to_seconds(), 3723);
    expect("parse PT-0.5S", duration.parse("PT-0.5S").to_millis(), 0 - 500);

    // ---- parsing the readable form
    expect("parse 1h 2m 3.5s", duration.parse("1h 2m 3.5s").to_millis(), 3723500);
    expect("parse 2d 12h", duration.parse("2d 12h").to_hours(), 60);
    expect("parse without spaces", duration.parse("1h30m").to_minutes(), 90);
    expect("parse -1h 30m", duration.parse("-1h 30m").to_minutes(), 0 - 90);
    expect("parse 250ms", duration.parse("250ms").to_millis(), 250);
    expect("parse 10us", duration.parse("10us").to_nanos(), 10000);
    expect("parse 5ns", duration.parse("5ns").to_nanos(), 5);
    expect("parse 0s", duration.parse("0s").to_nanos(), 0);
    expect("parse 1m 500ms", duration.parse("1m 500ms").to_millis(), 60500);

    // ---- round trips
    expect_true("to_string -> parse", duration.parse(text(d)) == d);
    expect_true("to_iso_string -> parse", duration.parse(d.to_iso_string()) == d);
    negative := duration.of_seconds(0 - 93784, 0 - 500000000);
    expect_true("negative to_string -> parse", duration.parse(text(negative)) == negative);
    expect_true("negative to_iso_string -> parse", duration.parse(negative.to_iso_string()) == negative);
    tiny := duration.of_nanos(123456789);
    expect_true("nanosecond precision survives to_string", duration.parse(text(tiny)) == tiny);
    expect_true("nanosecond precision survives to_iso_string", duration.parse(tiny.to_iso_string()) == tiny);

    // ---- text that is not a duration
    expect_true("rejects the empty string", rejects(""));
    expect_true("rejects P alone", rejects("P"));
    expect_true("rejects PT alone", rejects("PT"));
    expect_true("rejects a number without unit", rejects("15"));
    expect_true("rejects hours before the T", rejects("P1H"));
    expect_true("rejects days after the T", rejects("PT1D"));
    expect_true("rejects units out of order", rejects("PT1S1M"));
    expect_true("rejects a repeated unit", rejects("PT1H2H"));
    expect_true("rejects a fraction of an hour", rejects("PT1.5H"));
    expect_true("rejects years", rejects("P1Y"));
    expect_true("rejects an unknown readable unit", rejects("5 parsecs"));
    expect_true("rejects a fraction of a minute", rejects("1.5m"));
    expect_true("rejects trailing junk", rejects("PT1Sx"));
    expect_true("rejects words", rejects("soon"));

    finish("lib_time_duration");
}
