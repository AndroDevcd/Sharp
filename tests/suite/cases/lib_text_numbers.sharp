mod main;

import ( std.testing, std.text )

/**
 * std.text - numbers and text:
 *   - number_parser         parse_int / long / double / bool (+ _or_null, _or), radix, decode
 *   - string_convert.sharp  to_int / to_long / to_double / to_bool on string
 *   - number_format         integer, padded, hex / binary / octal / to_radix, fixed, trimmed,
 *                           grouped, percent, scientific, ordinal, bytes, roman
 *   - string_format.sharp   format, escape / unescape / quote, ellipsize, string.of_...
 *
 * (Large negative numbers are computed from a variable: a large literal with
 * a minus sign in front of it, and `0 - 12345678901`, are compiled as -2147483648.)
 */

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_numbers") {
        empty : string = "";
        big : decimal = 12345678901;        // (a variable: `0 - 12345678901` is folded to -2147483648 as well)

        // ---- number_parser: whole numbers
        test("parse_int") { expect(number_parser.parse_int("42")).should_be(42); };
        test("parse_int negative") { expect(number_parser.parse_int("-42")).should_be(0 - 42); };
        test("parse_int with a plus sign") { expect(number_parser.parse_int("+7")).should_be(7); };
        test("parse_int zero") { expect(number_parser.parse_int("0")).should_be(0); };
        test("parse_int with leading zeros") { expect(number_parser.parse_int("007")).should_be(7); };
        test("parse_int largest") { expect(number_parser.parse_int("2147483647")).should_be(2147483647); };
        test("parse_int smallest") { expect(number_parser.parse_int("-2147483648")).should_be(0 - 2147483648); };
        test("parse_int hexadecimal") { expect(number_parser.parse_int("ff", 16)).should_be(255); };
        test("parse_int hexadecimal capitals") { expect(number_parser.parse_int("FF", 16)).should_be(255); };
        test("parse_int binary") { expect(number_parser.parse_int("-101", 2)).should_be(0 - 5); };
        test("parse_int radix 36") { expect(number_parser.parse_int("z", 36)).should_be(35); };
        test("parse_int octal") { expect(number_parser.parse_int("17", 8)).should_be(15); };
        test("is_int") { expect_true(number_parser.is_int("123")); };
        test("is_int with a letter") { expect_false(number_parser.is_int("12a")); };
        test("is_int of \"\"") { expect_false(number_parser.is_int("")); };
        test("is_int of a sign only") { expect_false(number_parser.is_int("-")); };
        test("is_int with spaces") { expect_false(number_parser.is_int(" 1")); };
        test("is_int with a decimal point") { expect_false(number_parser.is_int("1.5")); };
        test("is_int too large") { expect_false(number_parser.is_int("2147483648")); };
        test("is_long of the same number") { expect_true(number_parser.is_long("2147483648")); };
        test("parse_long") { expect(number_parser.parse_long("9007199254740991")).should_be(9007199254740991); };
        test("parse_long negative") { expect(number_parser.parse_long("-12345678901")).should_be(0 - big); };
        test("is_long too large") { expect_false(number_parser.is_long("9007199254740992")); };
        test("parse_int_or_null of text") { expect_null(number_parser.parse_int_or_null("abc")); };
        test("parse_int_or_null of \"\"") { expect_null(number_parser.parse_int_or_null("")); };
        test("parse_int_or_null out of range") { expect_null(number_parser.parse_int_or_null("99999999999")); };
        maybe := number_parser.parse_int_or_null("123");
        test("parse_int_or_null of a number") { expect_not_null(maybe); };
        test("parse_int_or_null: the value") { expect(maybe!!.value).should_be(123); };
        test("parse_int_or_null with a radix") { expect_null(number_parser.parse_int_or_null("12", 2)); };
        test("parse_int_or: good text") { expect(number_parser.parse_int_or("5", 9)).should_be(5); };
        test("parse_int_or: bad text") { expect(number_parser.parse_int_or("five", 9)).should_be(9); };
        test("parse_long_or_null of text") { expect_null(number_parser.parse_long_or_null("1e3")); };
        test("parse_long_or: bad text") { expect(number_parser.parse_long_or("", 0 - 1)).should_be(0 - 1); };
        test("decode decimal") { expect(number_parser.decode("42")).should_be(42); };
        test("decode hexadecimal") { expect(number_parser.decode("0xFF")).should_be(255); };
        test("decode binary") { expect(number_parser.decode("-0b101")).should_be(0 - 5); };
        test("decode octal") { expect(number_parser.decode("0o17")).should_be(15); };

        // ---- number_parser: what is thrown
        try {
            number_parser.parse_int("12a4");
            test("parse_int of \"12a4\"") { fail_test("did not throw"); };
        } catch(e: number_format_exception) {
            test("the message names the character and position") { expect(e.get_message()).should_be("\"12a4\" is not a valid integer: unexpected character 'a' at position 2"); };
        }
        try {
            number_parser.parse_int("99999999999");
            test("parse_int out of range") { fail_test("did not throw"); };
        } catch(e: number_format_exception) {
            test("the message says out of range") { expect_true(e.get_message().contains("out of range")); };
        }
        try {
            number_parser.parse_int("");
            test("parse_int of \"\"") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("number_format_exception is an illegal_argument_exception") { };
        }
        try {
            number_parser.parse_int("10", 1);
            test("radix 1") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("radix 1") { };
        }
        try {
            number_parser.decode("0x");
            test("decode of a prefix only") { fail_test("did not throw"); };
        } catch(e: number_format_exception) {
            test("decode of a prefix only") { };
        }

        // ---- number_parser: decimals and bools
        test("parse_double") { expect(number_parser.parse_double("3.25")).should_be(3.25); };
        test("parse_double negative") { expect(number_parser.parse_double("-0.5")).should_be(0 - 0.5); };
        test("parse_double whole") { expect(number_parser.parse_double("7")).should_be(7); };
        test("parse_double with an exponent") { expect(number_parser.parse_double("1e3")).should_be(1000); };
        test("parse_double with a negative exponent") { expect(number_parser.parse_double("25E-2")).should_be(0.25); };
        test("parse_double without leading digits") { expect(number_parser.parse_double(".5")).should_be(0.5); };
        test("parse_double without trailing digits") { expect(number_parser.parse_double("5.")).should_be(5); };
        test("is_double") { expect_true(number_parser.is_double("-1.5e+3")); };
        test("is_double of a point only") { expect_false(number_parser.is_double(".")); };
        test("is_double with two points") { expect_false(number_parser.is_double("1.2.3")); };
        test("is_double with an empty exponent") { expect_false(number_parser.is_double("1e")); };
        test("is_double of text") { expect_false(number_parser.is_double("abc")); };
        test("is_double of \"\"") { expect_false(number_parser.is_double("")); };
        test("is_double with trailing text") { expect_false(number_parser.is_double("1.5x")); };
        test("parse_double_or_null of text") { expect_null(number_parser.parse_double_or_null("x")); };
        test("parse_double_or_null of a number") { expect(number_parser.parse_double_or_null("2.5")!!.value).should_be(2.5); };
        test("parse_double_or: bad text") { expect(number_parser.parse_double_or("?", 1.5)).should_be(1.5); };
        test("parse_bool true") { expect(number_parser.parse_bool("true")).should_be(1); };
        test("parse_bool false") { expect(number_parser.parse_bool("false")).should_be(0); };
        test("parse_bool ignores case") { expect(number_parser.parse_bool("TRUE")).should_be(1); };
        test("parse_bool_or_null of yes") { expect_null(number_parser.parse_bool_or_null("yes")); };
        test("parse_bool_or: bad text") { expect(number_parser.parse_bool_or("1", true)).should_be(1); };
        try {
            number_parser.parse_bool("yes");
            test("parse_bool of yes") { fail_test("did not throw"); };
        } catch(e: number_format_exception) {
            test("parse_bool of yes") { };
        }

        // ---- the same through string
        n123 : string = "123";
        bad : string = "12a";
        test("to_int") { expect(n123.to_int()).should_be(123); };
        test("to_int with a radix") { expect(n123.to_int(8)).should_be(83); };
        test("to_int_or") { expect(bad.to_int_or(7)).should_be(7); };
        test("to_int_or_null") { expect_null(bad.to_int_or_null()); };
        test("to_int_or_null of a number") { expect(n123.to_int_or_null()!!.value).should_be(123); };
        test("to_long") { expect(n123.to_long()).should_be(123); };
        test("to_long_or") { expect(bad.to_long_or(0 - 1)).should_be(0 - 1); };
        test("to_long_or_null") { expect_null(empty.to_long_or_null()); };
        test("to_double") { expect(n123.to_double()).should_be(123); };
        half : string = "0.5";
        test("to_double of a fraction") { expect(half.to_double()).should_be(0.5); };
        test("to_double_or") { expect(bad.to_double_or(2.5)).should_be(2.5); };
        test("to_double_or_null") { expect_null(bad.to_double_or_null()); };
        yes : string = "True";
        test("to_bool") { expect(yes.to_bool()).should_be(1); };
        test("to_bool_or") { expect(bad.to_bool_or(false)).should_be(0); };
        test("to_bool_or_null") { expect_null(bad.to_bool_or_null()); };
        test("is_number") { expect_true(half.is_number()); };
        test("is_number of text") { expect_false(bad.is_number()); };
        test("is_integer") { expect_true(n123.is_integer()); };
        test("is_integer of a fraction") { expect_false(half.is_integer()); };
        try {
            bad.to_int();
            test("to_int of \"12a\"") { fail_test("did not throw"); };
        } catch(e: number_format_exception) {
            test("to_int of \"12a\"") { };
        }

        // ---- number_format: whole numbers
        test("integer") { expect(number_format.integer(42)).should_be("42"); };
        test("integer zero") { expect(number_format.integer(0)).should_be("0"); };
        test("integer negative") { expect(number_format.integer(0 - 7)).should_be("-7"); };
        test("integer cuts the fraction off") { expect(number_format.integer(2.9)).should_be("2"); };
        test("integer cuts towards zero") { expect(number_format.integer(0 - 2.9)).should_be("-2"); };
        test("integer beyond 32 bit") { expect(number_format.integer(12345678901)).should_be("12345678901"); };
        test("integer negative beyond 32 bit") { expect(number_format.integer(0 - big)).should_be("-12345678901"); };
        test("integer, largest exact") { expect(number_format.integer(9007199254740991)).should_be("9007199254740991"); };
        test("padded") { expect(number_format.padded(7, 3)).should_be("007"); };
        test("padded, already wide") { expect(number_format.padded(1234, 3)).should_be("1234"); };
        test("padded negative") { expect(number_format.padded(0 - 7, 3)).should_be("-007"); };
        test("hex") { expect(number_format.hex(255)).should_be("ff"); };
        test("hex zero") { expect(number_format.hex(0)).should_be("0"); };
        test("hex with a width") { expect(number_format.hex(255, 4)).should_be("00ff"); };
        test("hex_upper") { expect(number_format.hex_upper(48879)).should_be("BEEF"); };
        test("hex_upper with a width") { expect(number_format.hex_upper(10, 2)).should_be("0A"); };
        test("hex negative") { expect(number_format.hex(0 - 255)).should_be("-ff"); };
        test("binary") { expect(number_format.binary(5)).should_be("101"); };
        test("binary with a width") { expect(number_format.binary(5, 8)).should_be("00000101"); };
        test("octal") { expect(number_format.octal(8)).should_be("10"); };
        test("to_radix 36") { expect(number_format.to_radix(35, 36)).should_be("z"); };
        test("to_radix with a width") { expect(number_format.to_radix(5, 3, 4)).should_be("0012"); };
        test("hex and parse_int agree") { expect(number_parser.parse_int(number_format.hex(123456), 16)).should_be(123456); };
        try {
            number_format.to_radix(5, 37);
            test("to_radix 37") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("to_radix 37") { };
        }

        // ---- number_format: decimals
        test("fixed") { expect(number_format.fixed(3.14159, 2)).should_be("3.14"); };
        test("fixed rounds up") { expect(number_format.fixed(3.146, 2)).should_be("3.15"); };
        test("fixed adds zeros") { expect(number_format.fixed(2, 2)).should_be("2.00"); };
        test("fixed with 0 decimals") { expect(number_format.fixed(2.5, 0)).should_be("3"); };
        test("fixed negative") { expect(number_format.fixed(0 - 2.5, 0)).should_be("-3"); };
        test("fixed of a small fraction") { expect(number_format.fixed(0.05, 1)).should_be("0.1"); };
        test("fixed never prints -0") { expect(number_format.fixed(0 - 0.001, 2)).should_be("0.00"); };
        test("fixed carries into the whole part") { expect(number_format.fixed(9.999, 2)).should_be("10.00"); };
        test("fixed with many decimals") { expect(number_format.fixed(0.125, 5)).should_be("0.12500"); };
        test("trimmed") { expect(number_format.trimmed(2.5, 4)).should_be("2.5"); };
        test("trimmed whole number") { expect(number_format.trimmed(2, 4)).should_be("2"); };
        test("trimmed rounds") { expect(number_format.trimmed(1.23456, 2)).should_be("1.23"); };
        test("trimmed keeps zeros before the point") { expect(number_format.trimmed(100, 2)).should_be("100"); };
        test("plain whole") { expect(number_format.plain(42)).should_be("42"); };
        test("plain fraction") { expect(number_format.plain(0.1)).should_be("0.1"); };
        test("grouped") { expect(number_format.grouped(1234567)).should_be("1,234,567"); };
        test("grouped small") { expect(number_format.grouped(999)).should_be("999"); };
        test("grouped exactly four digits") { expect(number_format.grouped(1000)).should_be("1,000"); };
        test("grouped negative, rounded") { expect(number_format.grouped(0 - 1234.5)).should_be("-1,235"); };
        test("grouped with decimals") { expect(number_format.grouped(1234567.891, 2)).should_be("1,234,567.89"); };
        test("grouped with other characters") { expect(number_format.grouped(1234567.891, 2, '.', ',')).should_be("1.234.567,89"); };
        test("grouped zero") { expect(number_format.grouped(0)).should_be("0"); };
        test("percent") { expect(number_format.percent(0.256, 1)).should_be("25.6%"); };
        test("percent whole") { expect(number_format.percent(1, 0)).should_be("100%"); };
        test("scientific") { expect(number_format.scientific(31415.9, 2)).should_be("3.14e+04"); };
        test("scientific small") { expect(number_format.scientific(0.00012, 1)).should_be("1.2e-04"); };
        test("scientific zero") { expect(number_format.scientific(0, 2)).should_be("0.00e+00"); };
        test("scientific negative") { expect(number_format.scientific(0 - 1500, 1)).should_be("-1.5e+03"); };
        test("scientific carries") { expect(number_format.scientific(9.99, 1)).should_be("1.0e+01"); };
        try {
            number_format.fixed(1, 16);
            test("fixed with 16 decimals") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("fixed with 16 decimals") { };
        }

        // ---- number_format: for people
        test("ordinal 1") { expect(number_format.ordinal(1)).should_be("1st"); };
        test("ordinal 2") { expect(number_format.ordinal(2)).should_be("2nd"); };
        test("ordinal 3") { expect(number_format.ordinal(3)).should_be("3rd"); };
        test("ordinal 4") { expect(number_format.ordinal(4)).should_be("4th"); };
        test("ordinal 11") { expect(number_format.ordinal(11)).should_be("11th"); };
        test("ordinal 12") { expect(number_format.ordinal(12)).should_be("12th"); };
        test("ordinal 13") { expect(number_format.ordinal(13)).should_be("13th"); };
        test("ordinal 22") { expect(number_format.ordinal(22)).should_be("22nd"); };
        test("ordinal 113") { expect(number_format.ordinal(113)).should_be("113th"); };
        test("bytes") { expect(number_format.bytes(512)).should_be("512 B"); };
        test("bytes KB") { expect(number_format.bytes(1536)).should_be("1.5 KB"); };
        test("bytes MB") { expect(number_format.bytes(1048576)).should_be("1.0 MB"); };
        test("bytes GB") { expect(number_format.bytes(3221225472)).should_be("3.0 GB"); };
        test("roman") { expect(number_format.roman(1994)).should_be("MCMXCIV"); };
        test("roman 4") { expect(number_format.roman(4)).should_be("IV"); };
        test("roman 3999") { expect(number_format.roman(3999)).should_be("MMMCMXCIX"); };
        try {
            number_format.roman(0);
            test("roman(0)") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("roman(0)") { };
        }

        // ---- string_format.sharp
        sentence : string = "{} has {} items";
        test("format") { expect(sentence.format(new string[] { "cart", "3" })).should_be("cart has 3 items"); };
        indexed : string = "{1} before {0}, {1} again";
        test("format with indexes") { expect(indexed.format(new string[] { "a", "b" })).should_be("b before a, b again"); };
        braces : string = "{{literal}} {}";
        test("format with doubled braces") { expect(braces.format_one("x")).should_be("{literal} x"); };
        named : string = "{name} stays, {} goes";
        test("format leaves other braces alone") { expect(named.format_one("this")).should_be("{name} stays, this goes"); };
        try {
            sentence.format_one("only one");
            test("format with too few arguments") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("format with too few arguments") { };
        }
        raw : string = "a\tb\n\"c\"\\";
        test("escape") { expect(raw.escape()).should_be("a\\tb\\n\\\"c\\\"\\\\"); };
        test("unescape undoes escape") { expect(raw.escape().unescape()).should_be(raw); };
        plain_text : string = "plain";
        test("escape with nothing to do") { expect(plain_text.escape()).should_be("plain"); };
        test("quote") { expect(plain_text.quote()).should_be("\"plain\""); };
        test("quote of \"\"") { expect(empty.quote()).should_be("\"\""); };
        fox : string = "The quick brown fox";
        test("ellipsize") { expect(fox.ellipsize(10)).should_be("The qui..."); };
        test("ellipsize, already short") { expect(plain_text.ellipsize(10)).should_be("plain"); };
        test("ellipsize to the exact length") { expect(plain_text.ellipsize(5)).should_be("plain"); };
        test("ellipsize with a marker") { expect(fox.ellipsize(5, "~")).should_be("The ~"); };
        test("of_int") { expect(string.of_int(42)).should_be("42"); };
        test("of_number") { expect(string.of_number(2.5)).should_be("2.5"); };
        test("of_char") { expect(string.of_char('x')).should_be("x"); };
        test("of_bool true") { expect(string.of_bool(1)).should_be("true"); };
        test("of_bool false") { expect(string.of_bool(0)).should_be("false"); };
        test("of_chars") { expect(string.of_chars(plain_text.chars())).should_be("plain"); };
    };
    finish_tests();
}
