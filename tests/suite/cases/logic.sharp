mod main;

import ( testing )

/**
 * Logic: && (and), || (or), ! (not).
 * The right side of && is only evaluated when the left side is true, and the
 * right side of || only when the left side is false ("short circuit").
 *
 * Every mix of && and || in this file is written with parentheses: without
 * them the grouping is wrong today (see known_bugs/logic.sharp).
 */

/** how many times touch() has been called */
calls : var = 0;

/** gives back `result`, and counts the call so a test can see that it happened */
def touch(result: var): var {
    calls++;
    return result;
}

def both(a: var, b: var): var { return a && b; }
def either(a: var, b: var): var { return a || b; }
def not(a: var): var { return !a; }

/** true when n is from low to high */
def between(n: var, low: var, high: var): var {
    return n >= low && n <= high;
}

def main(args: string[]) {
    t : var = true;
    f : var = false;

    // ---- and
    expect("true && true", true && true, 1);
    expect("true && false", true && false, 0);
    expect("false && true", false && true, 0);
    expect("false && false", false && false, 0);
    expect("t && t", t && t, 1);
    expect("t && f", t && f, 0);
    expect("f && t", f && t, 0);
    expect("f && f", f && f, 0);

    // ---- or
    expect("true || true", true || true, 1);
    expect("true || false", true || false, 1);
    expect("false || true", false || true, 1);
    expect("false || false", false || false, 0);
    expect("t || t", t || t, 1);
    expect("t || f", t || f, 1);
    expect("f || t", f || t, 1);
    expect("f || f", f || f, 0);

    // ---- not
    expect("!true", !true, 0);
    expect("!false", !false, 1);
    expect("!t", !t, 0);
    expect("!f", !f, 1);
    expect("!(!t)", !(!t), 1);
    expect("!(!f)", !(!f), 0);

    // ---- any number that is not 0 counts as true; the answer is always 1 or 0
    five : var = 5;
    zero : var = 0;
    expect("5 && 3", five && 3, 1);
    expect("5 && 0", five && zero, 0);
    expect_true("0 || 7", zero || 7);
    expect("0 || 0", zero || zero, 0);
    expect("!5", !five, 0);
    expect("!0", !zero, 1);
    expect("-1 && 1", (0 - 1) && 1, 1);
    expect_true("0.5 || 0", 0.5 || zero);
    expect("0.5 && 2", 0.5 && five, 1);

    // ---- chains
    expect("t && t && t", t && t && t, 1);
    expect("t && t && f", t && t && f, 0);
    expect("f && t && t", f && t && t, 0);
    expect("t && f && t", t && f && t, 0);
    expect("f || f || t", f || f || t, 1);
    expect("f || f || f", f || f || f, 0);
    expect("t || f || f", t || f || f, 1);
    expect("f || t || f", f || t || f, 1);

    // ---- mixed, with parentheses
    expect("(t && f) || t", (t && f) || t, 1);
    expect("t && (f || t)", t && (f || t), 1);
    expect("(f && f) || t", (f && f) || t, 1);
    expect("f && (f || t)", f && (f || t), 0);
    expect("(t || f) && f", (t || f) && f, 0);
    expect("t || (f && f)", t || (f && f), 1);
    expect("(f || t) && (t || f)", (f || t) && (t || f), 1);
    expect("(f && t) || (t && f)", (f && t) || (t && f), 0);
    expect("!(t && f)", !(t && f), 1);
    expect("!(t || f)", !(t || f), 0);
    expect("!t || !f", !t || !f, 1);
    expect("!t && !f", !t && !f, 0);
    expect("!f && t", !f && t, 1);

    // ---- De Morgan: !(a && b) is !a || !b, and !(a || b) is !a && !b
    expect("!(t && t) == (!t || !t)", !(t && t) == (!t || !t), 1);
    expect("!(t && f) == (!t || !f)", !(t && f) == (!t || !f), 1);
    expect("!(f || f) == (!f && !f)", !(f || f) == (!f && !f), 1);
    expect("!(f || t) == (!f && !t)", !(f || t) == (!f && !t), 1);

    // ---- short circuit: && stops at the first false
    calls = 0;
    expect("f && touch(1)", f && touch(1), 0);
    expect("...did not call touch", calls, 0);
    expect("t && touch(1)", t && touch(1), 1);
    expect("...called touch once", calls, 1);
    calls = 0;
    expect("touch(0) && touch(1)", touch(0) && touch(1), 0);
    expect("...called only the left touch", calls, 1);
    calls = 0;
    expect("touch(1) && touch(0)", touch(1) && touch(0), 0);
    expect("...called both", calls, 2);
    calls = 0;
    expect("touch(1) && touch(0) && touch(1)", touch(1) && touch(0) && touch(1), 0);
    expect("...stopped after the second", calls, 2);

    // ---- short circuit: || stops at the first true
    calls = 0;
    expect("t || touch(0)", t || touch(0), 1);
    expect("...did not call touch", calls, 0);
    expect("f || touch(0)", f || touch(0), 0);
    expect("...called touch once", calls, 1);
    calls = 0;
    expect("touch(1) || touch(1)", touch(1) || touch(1), 1);
    expect("...called only the left touch", calls, 1);
    calls = 0;
    expect("touch(0) || touch(1)", touch(0) || touch(1), 1);
    expect("...called both", calls, 2);
    calls = 0;
    expect("touch(0) || touch(1) || touch(1)", touch(0) || touch(1) || touch(1), 1);
    expect("...stopped after the second", calls, 2);

    // ---- short circuit inside an if
    calls = 0;
    if(f && touch(1)) {
        fail("if(f && touch(1))", "the if branch ran");
    }
    expect("if(f && ...) did not call touch", calls, 0);
    if(t || touch(1)) {
        pass("if(t || touch(1))");
    } else {
        fail("if(t || touch(1))", "the else branch ran");
    }
    expect("if(t || ...) did not call touch", calls, 0);
    if(t && touch(1)) {
        pass("if(t && touch(1))");
    } else {
        fail("if(t && touch(1))", "the else branch ran");
    }
    expect("if(t && ...) called touch", calls, 1);

    // ---- short circuit protects the right side (5 / 0 is never reached for)
    divisor : var = 0;
    safe : var = divisor != 0 && touch(10 / divisor) > 1;
    expect("guarded division", safe, 0);
    expect("...touch was not called", calls, 1);

    // ---- with comparisons
    x : var = 15;
    expect("x > 10 && x < 20", x > 10 && x < 20, 1);
    expect("x > 10 && x < 12", x > 10 && x < 12, 0);
    expect("x < 10 || x > 12", x < 10 || x > 12, 1);
    expect("x < 10 || x > 20", x < 10 || x > 20, 0);
    expect("x == 15 && x != 16", x == 15 && x != 16, 1);
    expect("!(x == 15)", !(x == 15), 0);
    expect("!(x < 10)", !(x < 10), 1);
    expect("x % 3 == 0 && x % 5 == 0", x % 3 == 0 && x % 5 == 0, 1);
    expect("x % 2 == 0 || x % 7 == 0", x % 2 == 0 || x % 7 == 0, 0);
    expect("(x < 0 || x > 10) && x != 13", (x < 0 || x > 10) && x != 13, 1);

    // ---- stored in variables
    in_range : var = x >= 0 && x <= 100;
    out_of_range : var = !in_range;
    expect("in_range", in_range, 1);
    expect("out_of_range", out_of_range, 0);
    expect("in_range && !out_of_range", in_range && !out_of_range, 1);
    answer : bool = t && !f;
    expect("in a bool object", answer.value, 1);

    // ---- through functions
    expect("both(1, 1)", both(1, 1), 1);
    expect("both(1, 0)", both(1, 0), 0);
    expect("either(0, 1)", either(0, 1), 1);
    expect("either(0, 0)", either(0, 0), 0);
    expect("not(1)", not(1), 0);
    expect("not(0)", not(0), 1);
    expect("between(5, 1, 10)", between(5, 1, 10), 1);
    expect("between(0, 1, 10)", between(0, 1, 10), 0);
    expect("between(11, 1, 10)", between(11, 1, 10), 0);
    expect("between(10, 1, 10)", between(10, 1, 10), 1);
    expect("both(either(0, 1), not(0))", both(either(0, 1), not(0)), 1);

    finish("logic");
}
