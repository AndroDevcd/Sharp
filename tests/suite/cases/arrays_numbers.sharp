mod main;

import ( testing )

/**
 * Arrays of native numbers: `decimal[]` and the sized kinds `_int8[]`,
 * `_uint8[]`, `_int16[]`, `_uint16[]`, `_int32[]`, `_uint32[]`, `_int64[]`.
 *
 * An array is an object. A variable holds a reference to it, so assigning
 * an array to another variable, passing it to a function or returning it
 * never copies the elements.
 */

class matrix {
    cells : decimal[];
    spare : decimal[]?;
}

/** an array kept in a global variable */
shared : decimal[] = new decimal[4];

def fill(a: decimal[], value: decimal) {
    for(i : decimal = 0; i < sizeof(a); i++) {
        a[i] = value;
    }
}

def total(a: decimal[]) : decimal {
    sum : decimal = 0;
    foreach(x in a) {
        sum += x;
    }
    return sum;
}

/** { 0, 1, 4, 9, ... } */
def squares(n: decimal) : decimal[] {
    a := new decimal[n];
    for(i : decimal = 0; i < n; i++) {
        a[i] = i * i;
    }
    return a;
}

def same_array(a: decimal[]) : decimal[] { return a; }

def swap(a: decimal[], i: decimal, j: decimal) {
    kept : decimal = a[i];
    a[i] = a[j];
    a[j] = kept;
}

/** pointing the parameter at a new array does not change the caller's variable */
def point_elsewhere(a: decimal[]) {
    a = new decimal[1];
    a[0] = 99;
}

def make_bytes(n: decimal) : _int8[] { return new _int8[n]; }

def total_bytes(a: _int8[]) : decimal {
    sum : decimal = 0;
    foreach(x in a) {
        sum += x;
    }
    return sum;
}

def main(args: string[]) {
    // ---- creating: every element starts at 0
    a := new decimal[5];
    expect("sizeof", sizeof(a), 5);
    expect("first element starts at 0", a[0], 0);
    expect("last element starts at 0", a[4], 0);

    // ---- writing and reading
    a[0] = 7;
    a[4] = 0 - 2.5;
    expect("a[0]", a[0], 7);
    expect("a[4] holds a negative fraction", a[4], 0 - 2.5);
    expect("the elements in between are untouched", a[1] + a[2] + a[3], 0);
    a[1] = a[0] * 2;
    expect("an element computed from another", a[1], 14);
    a[1] = a[1] * 4 + a[1];
    expect("an element computed from itself", a[1], 70);

    // ---- the index can be any number expression
    i : decimal = 2;
    a[i] = 5;
    a[i + 1] = 6;
    expect("variable index", a[2], 5);
    expect("expression index", a[3], 6);
    a[a[2] - 4] = 9;
    expect("an element as index: a[a[2] - 4] is a[1]", a[1], 9);
    box := new int(2);
    expect("the value of an int object as index", a[box.value], 5);

    // ---- the size can be computed, and can be 0
    n : decimal = 4;
    computed := new decimal[n * 2];
    expect("new var[n * 2]", sizeof(computed), 8);
    empty := new decimal[0];
    expect("new var[0]", sizeof(empty), 0);
    large := new decimal[10000];
    large[9999] = 1;
    expect("10000 elements", sizeof(large), 10000);
    expect("the last of 10000", large[9999] + large[0], 1);

    // ---- an array written as a list of values
    d := new decimal[] { 1, 2, 3 };
    expect("list: size", sizeof(d), 3);
    expect("list: elements", d[0] + d[1] * 10 + d[2] * 100, 321);
    fractions := new decimal[] { 1.5, 2.25 };
    expect("list of fractions", fractions[0] + fractions[1], 3.75);
    x : decimal = 3;
    from_expressions := new decimal[] { x, x * 2, x * x };
    expect("list of expressions", from_expressions[1] + from_expressions[2], 15);
    one_value := new decimal[] { 7 };
    expect("list with one value", sizeof(one_value), 1);
    bare : _int32[] = { 4, 5, 6 };
    expect("a bare { } list of whole numbers is an _int32[]: size", sizeof(bare), 3);
    expect("...element", bare[1], 5);

    // ---- sized arrays
    bytes := new _int8[4];
    expect("_int8[]: size", sizeof(bytes), 4);
    expect("_int8[]: starts at 0", bytes[3], 0);
    bytes[0] = 100;
    bytes[1] = 0 - 100;
    expect("_int8[]: 100", bytes[0], 100);
    expect("_int8[]: -100", bytes[1], 0 - 100);
    listed_bytes := new _int8[] { 1, 2, 3 };
    expect("_int8[] from a list", listed_bytes[0] + listed_bytes[1] + listed_bytes[2], 6);
    shorts := new _int16[2];
    shorts[1] = 30000;
    expect("_int16[]", shorts[1], 30000);
    unsigned_shorts := new _uint16[2];
    unsigned_shorts[1] = 60000;
    expect("_uint16[]", unsigned_shorts[1], 60000);
    ints := new _int32[2];
    ints[0] = 0 - 2000000000;
    expect("_int32[]", ints[0], 0 - 2000000000);
    unsigned_ints := new _uint32[2];
    unsigned_ints[0] = 4000000000;
    expect("_uint32[]", unsigned_ints[0], 4000000000);
    longs := new _int64[2];
    longs[1] = 1099511627776;
    expect("_int64[] holds 2^40", longs[1], 1099511627776);
    unsigned_bytes := new _uint8[2];
    unsigned_bytes[0] = 250;
    expect("_uint8[]", unsigned_bytes[0], 250);

    // a value that does not fit is cut to the element size with `as`
    x = 200;
    bytes[2] = x as _int8;
    expect("200 as _int8 stored in an _int8[]", bytes[2], 0 - 56);
    x = 70000;
    shorts[0] = x as _int16;
    expect("70000 as _int16 stored in an _int16[]", shorts[0], 4464);
    x = 300;
    unsigned_bytes[1] = x as _uint8;
    expect("300 as _uint8 stored in a _uint8[]", unsigned_bytes[1], 44);

    // a string literal is an _int8[] of character codes
    letters : _int8[] = "abc";
    expect("_int8[] from a literal: size", sizeof(letters), 3);
    expect("_int8[] from a literal: 'c'", letters[2], 99);

    // ---- arrays as parameters: the function works on the caller's array
    fill(a, 9);
    expect("filled by a function: first", a[0], 9);
    expect("filled by a function: last", a[4], 9);
    expect("total of five nines", total(a), 45);
    expect("total of a list", total(new decimal[] { 1, 2, 3, 4 }), 10);
    expect("total of an empty array", total(empty), 0);
    swap(d, 0, 2);
    expect("swapped by a function", d[0] * 10 + d[2], 31);
    point_elsewhere(d);
    expect("re-pointing the parameter leaves the caller's array", d[0], 3);
    expect("...and its size", sizeof(d), 3);
    small_bytes := make_bytes(3);
    small_bytes[0] = 5;
    small_bytes[1] = 6;
    expect("_int8[] as result and parameter", total_bytes(small_bytes), 11);

    // ---- arrays as return values
    sq := squares(4);
    expect("returned array: size", sizeof(sq), 4);
    expect("returned array: last element", sq[3], 9);
    expect("returned array: total 0 + 1 + 4 + 9", total(sq), 14);
    expect("index straight on the call", squares(5)[4], 16);
    expect("sizeof straight on the call", sizeof(squares(6)), 6);
    expect("result passed straight on", total(squares(3)), 5);

    // ---- two variables, one array
    other_name := a;
    other_name[2] = 42;
    expect("written through the other variable", a[2], 42);
    a[3] = 43;
    expect("written through the first, read through the other", other_name[3], 43);
    expect_true("other_name == a", other_name == a);
    through_call := same_array(a);
    through_call[1] = 13;
    expect("an array that went through a function is still the same one", a[1], 13);
    expect_true("...and compares equal", through_call == a);
    different := new decimal[5];
    expect_false("another array of the same size is not ==", different == a);

    // pointing a variable at a new array leaves the old one to the other variable
    a = new decimal[2];
    expect("a is the new array", sizeof(a), 2);
    expect("other_name still has the old one", sizeof(other_name), 5);
    expect("...with its elements", other_name[2], 42);

    // ---- global arrays and array fields
    shared[2] = 8;
    expect("global array element", shared[2], 8);
    expect("global array size", sizeof(shared), 4);
    m := new matrix();
    expect_null("an array field starts as null", m.cells);
    m.cells = new decimal[3];
    m.cells[1] = 4;
    expect("element of an array field", m.cells[1], 4);
    expect("size of an array field", sizeof(m.cells), 3);
    m.cells = other_name;
    other_name[0] = 31;
    expect("a field can refer to an existing array", m.cells[0], 31);
    expect_null("a nullable array field starts as null", m.spare);

    // ---- arrays of arrays: rows kept in an object[]
    rows := new object[3];
    rows[0] = new decimal[2];
    rows[1] = new decimal[4];
    first_row := rows[0] as decimal[];
    first_row[1] = 5;
    again := rows[0] as decimal[];
    expect("element of a row", again[1], 5);
    expect("rows can differ in size", sizeof(rows[1] as decimal[]), 4);
    expect_null("a row that was never set", rows[2]);
    // a 3 x 3 multiplication table
    table := new object[3];
    for(r : decimal = 0; r < 3; r++) {
        row := new decimal[3];
        for(c : decimal = 0; c < 3; c++) {
            row[c] = (r + 1) * (c + 1);
        }
        table[r] = row;
    }
    expect("table[2][2] is 3 * 3", (table[2] as decimal[])[2], 9);
    expect("table[1][2] is 2 * 3", (table[1] as decimal[])[2], 6);
    expect("total of the last row: 3 + 6 + 9", total(table[2] as decimal[]), 18);

    // ---- loops
    sum : decimal = 0;
    foreach(value in sq) {
        sum += value;
    }
    expect("foreach", sum, 14);
    sum = 0;
    for(k : decimal = 0; k < sizeof(sq); k++) {
        sum += sq[k] * (k + 1);
    }
    expect("for with an index: 0*1 + 1*2 + 4*3 + 9*4", sum, 50);
    foreach(value in sq) {
        value = 100;
    }
    expect("the foreach variable is a copy of the element", sq[3], 9);
    visits : decimal = 0;
    foreach(value in empty) {
        visits++;
    }
    expect("foreach over an empty array", visits, 0);

    // ---- outside the array: an exception that can be caught
    try {
        a[10] = 1;
        fail("write past the end", "no exception");
    } catch(e: out_of_bounds_exception) {
        pass("write past the end");
    }
    try {
        sum = a[2];
        fail("read at the size", "no exception");
    } catch(e: out_of_bounds_exception) {
        pass("read at the size");
    }
    try {
        i = 0 - 1;
        sum = a[i];
        fail("negative index", "no exception");
    } catch(e: out_of_bounds_exception) {
        pass("negative index");
    }
    try {
        a[10] = 1;
        fail("caught as its base class", "no exception");
    } catch(e: exception) {
        pass("caught as its base class");
    }

    // the statements after the failing one are skipped
    reached : decimal = 0;
    try {
        a[1] = 1;
        reached = 1;
        a[2] = 1;
        reached = 2;
    } catch(e: out_of_bounds_exception) {
        reached += 10;
    }
    expect("a[1] works, a[2] raises", reached, 11);

    // ...and the array is as usable as before
    a[0] = 3;
    expect("after the exceptions", a[0] + a[1], 4);
    expect("size after the exceptions", sizeof(a), 2);

    finish("arrays_numbers");
}
