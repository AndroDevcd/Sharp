mod main;

import ( std.testing, std.collections )

/**
 * the functions of a `list<T>` that search, order and change it by position
 * class (sorting, searching, ranges, bulk removal, conversions), and the
 * read-only immutable_list.
 */

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def descending(a: int, b: int) : decimal { return b.value - a.value; }
def is_even(n: int) : bool { return n.value % 2 == 0; }
def is_big(n: int) : bool { return n.value > 100; }

/** a list<int> from an array literal of numbers */
def list_of(items: int[]) : list<int> {
    result := new list<int>();
    for(i : decimal = 0; i < sizeof(items); i++) result.add(items[i]);
    return result;
}

/** "1,2,3" for a list of ints */
def join(items: list<int>) : string {
    text := "";
    for(i : decimal = 0; i < items.size(); i++) {
        if(i > 0) text = text + ",";
        text = text + items.at(i);
    }
    return text;
}

/** "1,2,3" for an array of ints */
def join_array(items: int[]) : string {
    text := "";
    for(i : decimal = 0; i < sizeof(items); i++) {
        if(i > 0) text = text + ",";
        text = text + items[i];
    }
    return text;
}

class card {
    rank : decimal;
    label : string;
    card(rank: decimal, label: string) { self->rank = rank; self->label = label; }
}

def by_rank(a: card, b: card) : decimal { return a.rank - b.rank; }

def test_search() {
    empty := new list<int>();
    l := list_of(new int[] { 4, 7, 4, 9, 2, 4 });

    test("is_empty yes") { expect(empty.is_empty()).should_be(1); };
    test("is_empty no") { expect(l.is_empty()).should_be(0); };
    test("contains") { expect(l.contains(9)).should_be(1); };
    test("contains missing") { expect(l.contains(5)).should_be(0); };
    test("contains in empty") { expect(empty.contains(5)).should_be(0); };
    test("index_of") { expect(l.index_of(4)).should_be(0); };
    test("index_of later element") { expect(l.index_of(2)).should_be(4); };
    test("index_of missing") { expect(l.index_of(5)).should_be(0 - 1); };
    test("last_index_of") { expect(l.last_index_of(4)).should_be(5); };
    test("last_index_of single") { expect(l.last_index_of(7)).should_be(1); };
    test("last_index_of missing") { expect(l.last_index_of(5)).should_be(0 - 1); };
    test("count_of") { expect(l.count_of(4)).should_be(3); };
    test("count_of missing") { expect(l.count_of(5)).should_be(0); };
    test("index_where") { expect(l.index_of_first({ x: int -> (bool) return x.value > 6; })).should_be(1); };
    test("index_where none") { expect(l.index_of_first(is_big)).should_be(0 - 1); };
    test("first_or_null") { expect(l.first_or_null()!!.value).should_be(4); };
    test("last_or_null") { expect(l.last_or_null()!!.value).should_be(4); };
    test("first_or_null of empty") { expect_null(empty.first_or_null()); };
    test("last_or_null of empty") { expect_null(empty.last_or_null()); };
    test("at_or_null") { expect(l.at_or_null(3)!!.value).should_be(9); };
    test("at_or_null past the end") { expect_null(l.at_or_null(6)); };
    test("at_or_null negative") { expect_null(l.at_or_null(0 - 1)); };

    words := new list<string>();
    words.add("a"); words.add("b");
    test("contains compares strings by value") { expect(words.contains("" + "b")).should_be(1); };
    test("index_of on strings") { expect(words.index_of("b")).should_be(1); };

    // the storage is longer than the list: slots beyond the end must not be looked at
    l.pop_back();
    test("last_index_of after pop_back") { expect(l.last_index_of(4)).should_be(2); };
    test("count_of after pop_back") { expect(l.count_of(4)).should_be(2); };
}

def test_ordering() {
    l := list_of(new int[] { 5, 3, 9, 1, 4 });
    l.sort(ascending);
    test("sort") { expect(join(l)).should_be("1,3,4,5,9"); };
    test("is_sorted") { expect(l.is_sorted_with(ascending)).should_be(1); };
    test("is_sorted the other way") { expect(l.is_sorted_with(descending)).should_be(0); };
    l.sort(descending);
    test("sort descending") { expect(join(l)).should_be("9,5,4,3,1"); };

    empty := new list<int>();
    empty.sort(ascending);
    test("sort of empty") { expect(empty.size()).should_be(0); };
    test("is_sorted of empty") { expect(empty.is_sorted_with(ascending)).should_be(1); };
    one := list_of(new int[] { 7 });
    one.sort(ascending);
    test("sort of one") { expect(join(one)).should_be("7"); };

    source := list_of(new int[] { 2, 3, 1 });
    copy := source.sorted_with(ascending);
    test("sorted copy") { expect(join(copy)).should_be("1,2,3"); };
    test("sorted leaves the list") { expect(join(source)).should_be("2,3,1"); };

    // stable, on objects
    cards := new list<card>();
    cards.add(new card(2, "a")); cards.add(new card(1, "b")); cards.add(new card(2, "c")); cards.add(new card(1, "d"));
    cards.sort(by_rank);
    order := "";
    for(i : decimal = 0; i < 4; i++) order = order + cards.at(i).label;
    test("sort is stable") { expect(order).should_be("bdac"); };

    sorted := list_of(new int[] { 10, 20, 30, 40 });
    test("binary_search found") { expect(sorted.binary_search(30, ascending)).should_be(2); };
    test("binary_search first") { expect(sorted.binary_search(10, ascending)).should_be(0); };
    test("binary_search missing: -(2) - 1") { expect(sorted.binary_search(25, ascending)).should_be(0 - 3); };
    test("binary_search above all: -(4) - 1") { expect(sorted.binary_search(50, ascending)).should_be(0 - 5); };
    test("binary_search in empty") { expect(empty.binary_search(1, ascending)).should_be(0 - 1); };

    sorted.reverse();
    test("reverse") { expect(join(sorted)).should_be("40,30,20,10"); };
    odd := list_of(new int[] { 1, 2, 3 });
    odd.reverse();
    test("reverse odd length") { expect(join(odd)).should_be("3,2,1"); };
    test("reversed copy") { expect(join(odd.reversed())).should_be("1,2,3"); };
    test("reversed leaves the list") { expect(join(odd)).should_be("3,2,1"); };
    odd.swap(0, 2);
    test("swap") { expect(join(odd)).should_be("1,2,3"); };
    try { odd.swap(0, 3); test("swap out of bounds") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("swap out of bounds") { }; }
    try { odd.swap(0 - 1, 0); test("swap negative") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("swap negative") { }; }

    // scale: 5000 pseudo random numbers
    big := new list<int>();
    seed : decimal = 8086;
    sum_before : decimal = 0;
    for(i : decimal = 0; i < 5000; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        big.add(new int(seed));
        sum_before += seed;
    }
    big.sort(ascending);
    in_order : decimal = 1;
    sum_after : decimal = big.at(0).value;
    for(i : decimal = 1; i < 5000; i++) {
        if(big.at(i - 1).value > big.at(i).value) in_order = 0;
        sum_after += big.at(i).value;
    }
    test("sort 5000: size") { expect(big.size()).should_be(5000); };
    test("sort 5000: ascending") { expect(in_order).should_be(1); };
    test("sort 5000: nothing lost") { expect(sum_after).should_be(sum_before); };
    test("sort 5000: binary_search finds an element") { expect_true(big.binary_search(big.at(4321), ascending) >= 0); };
}

def test_ranges() {
    l := list_of(new int[] { 0, 1, 2, 3, 4, 5 });
    empty := new list<int>();

    test("sub_list") { expect(join(l.sub_list(2, 5))).should_be("2,3,4"); };
    test("sub_list everything") { expect(join(l.sub_list(0, 6))).should_be("0,1,2,3,4,5"); };
    test("sub_list empty") { expect(l.sub_list(3, 3).size()).should_be(0); };
    part := l.sub_list(0, 2);
    part.add(99);
    test("sub_list is independent") { expect(l.size()).should_be(6); };
    try { l.sub_list(0, 7); test("sub_list past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list past the end") { }; }
    try { l.sub_list(4, 3); test("sub_list from > to") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list from > to") { }; }
    try { l.sub_list(0 - 1, 3); test("sub_list negative") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list negative") { }; }

    copy := l.to_list();
    copy.put(0, 50);
    test("copy_of") { expect(join(copy)).should_be("50,1,2,3,4,5"); };
    test("copy_of is independent") { expect(l.at(0).value).should_be(0); };

    test("to_array") { expect(join_array(l.to_array())).should_be("0,1,2,3,4,5"); };
    test("to_array has exactly size() slots") { expect(sizeof(l.to_array())).should_be(6); };
    test("to_array of empty is not null") { expect(sizeof(empty.to_array())).should_be(0); };

    grown := list_of(new int[] { 1 });
    grown.add_all(list_of(new int[] { 2, 3 }));
    test("add_array") { expect(join(grown)).should_be("1,2,3"); };
    grown.add_all(list_of(new int[0]));
    test("add_array empty") { expect(join(grown)).should_be("1,2,3"); };

    target := list_of(new int[] { 1, 2, 5 });
    target.insert_all(2, list_of(new int[] { 3, 4 }));
    test("insert_all in the middle") { expect(join(target)).should_be("1,2,3,4,5"); };
    target.insert_all(0, list_of(new int[] { 0 }));
    test("insert_all at the front") { expect(join(target)).should_be("0,1,2,3,4,5"); };
    target.insert_all(6, list_of(new int[] { 6, 7 }));
    test("insert_all at the end") { expect(join(target)).should_be("0,1,2,3,4,5,6,7"); };
    target.insert_all(3, empty);
    test("insert_all of an empty list") { expect(target.size()).should_be(8); };
    target.add(8);
    test("add after insert_all") { expect(join(target)).should_be("0,1,2,3,4,5,6,7,8"); };
    twice := list_of(new int[] { 1, 2 });
    twice.insert_all(1, twice);
    test("insert_all of the list itself") { expect(join(twice)).should_be("1,1,2,2"); };
    try { target.insert_all(10, twice); test("insert_all past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("insert_all past the end") { }; }

    target.remove_range(2, 5);
    test("remove_range") { expect(join(target)).should_be("0,1,5,6,7,8"); };
    target.remove_range(0, 1);
    test("remove_range at the front") { expect(join(target)).should_be("1,5,6,7,8"); };
    target.remove_range(3, 5);
    test("remove_range at the end") { expect(join(target)).should_be("1,5,6"); };
    target.remove_range(1, 1);
    test("remove_range empty") { expect(target.size()).should_be(3); };
    target.remove_range(0, 3);
    test("remove_range everything") { expect(target.size()).should_be(0); };
    target.add(1);
    test("usable after remove_range") { expect(join(target)).should_be("1"); };
    try { target.remove_range(0, 2); test("remove_range past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("remove_range past the end") { }; }

    r := list_of(new int[] { 4, 7, 4, 9, 4 });
    test("remove_all returns the count") { expect(r.remove_every(4)).should_be(3); };
    test("remove_all") { expect(join(r)).should_be("7,9"); };
    test("remove_all missing") { expect(r.remove_every(4)).should_be(0); };
    test("remove_all size") { expect(r.size()).should_be(2); };

    f := list_of(new int[] { 1, 2, 3, 4, 5, 6 });
    test("remove_if returns the count") { expect(f.remove_all(is_even)).should_be(3); };
    test("remove_if") { expect(join(f)).should_be("1,3,5"); };
    test("remove_if nothing") { expect(f.remove_all(is_even)).should_be(0); };
    g := list_of(new int[] { 1, 2, 3, 4, 5, 6 });
    test("retain_if returns the count") { expect(g.retain_all(is_even)).should_be(3); };
    test("retain_if") { expect(join(g)).should_be("2,4,6"); };
    test("retain_if nothing matches") { expect(g.retain_all(is_big)).should_be(3); };
    test("retain_if emptied the list") { expect(g.size()).should_be(0); };

    h := list_of(new int[] { 1, 2, 3 });
    h.fill(7);
    test("fill") { expect(join(h)).should_be("7,7,7"); };

    it := l.iterator();
    digits : decimal = 0;
    while(it.has_next()) digits = digits * 10 + it.next().value;
    test("iterator") { expect(digits).should_be(12345); };
    test("iterator of empty") { expect(empty.iterator().has_next()).should_be(0); };
    snapshot := l.iterator();
    l.clear();
    test("iterator walks a snapshot") { expect(snapshot.next().value).should_be(0); };

    // of / equals
    made := list_of(new int[] { 1, 2, 3 });
    test("of") { expect(join(made)).should_be("1,2,3"); };
    test("of an empty array") { expect(list_of(new int[0]).size()).should_be(0); };
    test("equals") { expect(made.equals(list_of(new int[] { 1, 2, 3 }))).should_be(1); };
    test("equals one difference") { expect(made.equals(list_of(new int[] { 1, 2, 4 }))).should_be(0); };
    test("equals different size") { expect(made.equals(list_of(new int[] { 1, 2 }))).should_be(0); };
    test("equals both empty") { expect(new list<int>().equals(new list<int>())).should_be(1); };
}

def test_immutable_list() {
    source := list_of(new int[] { 3, 1, 4, 1, 5 });
    frozen := new immutable_list<int>(source);
    test("size") { expect(frozen.size()).should_be(5); };
    test("is_empty") { expect(frozen.is_empty()).should_be(0); };
    test("at") { expect(frozen.at(2).value).should_be(4); };
    test("first") { expect(frozen.first().value).should_be(3); };
    test("last") { expect(frozen.last().value).should_be(5); };
    test("index_of") { expect(frozen.index_of(1)).should_be(1); };
    test("last_index_of") { expect(frozen.last_index_of(1)).should_be(3); };
    test("index_of missing") { expect(frozen.index_of(9)).should_be(0 - 1); };
    test("contains") { expect(frozen.contains(4)).should_be(1); };
    test("contains missing") { expect(frozen.contains(9)).should_be(0); };
    try { frozen.at(5); test("at(size)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("at(size)") { }; }
    try { frozen.at(0 - 1); test("at(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("at(-1)") { }; }

    // changes to the source, or to what the list hands out, do not show through
    source.put(0, 99);
    source.add(6);
    test("independent of its source: element") { expect(frozen.at(0).value).should_be(3); };
    test("independent of its source: size") { expect(frozen.size()).should_be(5); };
    handed_out := frozen.to_array();
    handed_out[0] = new int(77);
    test("to_array is a copy") { expect(frozen.at(0).value).should_be(3); };
    elements := frozen.get_elements()!!;
    elements[1] = new int(77);
    test("get_elements is a copy") { expect(frozen.at(1).value).should_be(1); };
    as_list := frozen.to_list();
    as_list.clear();
    test("to_list is a copy") { expect(frozen.size()).should_be(5); };

    // "changing" functions make new lists
    longer := frozen.plus(9);
    test("plus: new list") { expect(longer.size()).should_be(6); };
    test("plus: last") { expect(longer.last().value).should_be(9); };
    test("plus: original unchanged") { expect(frozen.size()).should_be(5); };
    test("sub_list") { expect(join(frozen.sub_list(1, 4).to_list())).should_be("1,4,1"); };
    test("sub_list empty") { expect(frozen.sub_list(2, 2).size()).should_be(0); };
    try { frozen.sub_list(2, 6); test("sub_list past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list past the end") { }; }
    test("reversed") { expect(join(frozen.reversed().to_list())).should_be("5,1,4,1,3"); };
    test("reversed leaves the original") { expect(join(frozen.to_list())).should_be("3,1,4,1,5"); };

    digits : decimal = 0;
    foreach(x in frozen) { digits = digits * 10 + x.value; }
    test("foreach") { expect(digits).should_be(31415); };
    it := frozen.iterator();
    digits = 0;
    while(it.has_next()) digits = digits * 10 + it.next().value;
    test("iterator") { expect(digits).should_be(31415); };

    // other ways to make one
    from_array := new immutable_list<int>(new int[] { 1, 2 });
    test("from an array") { expect(from_array.size()).should_be(2); };
    ring := new deque<int>();
    ring.add_last(8); ring.add_first(7);
    from_deque := new immutable_list<int>(ring);
    test("from any collection") { expect(join(from_deque.to_list())).should_be("7,8"); };
    from_empty := new immutable_list<int>(new list<int>());
    test("from an empty collection") { expect(from_empty.size()).should_be(0); };

    nothing := new immutable_list<int>();
    test("empty: size") { expect(nothing.size()).should_be(0); };
    test("empty: is_empty") { expect(nothing.is_empty()).should_be(1); };
    test("empty: get_elements") { expect_null(nothing.get_elements()); };
    test("empty: to_array") { expect(sizeof(nothing.to_array())).should_be(0); };
    test("empty: iterator") { expect(nothing.iterator().has_next()).should_be(0); };
    test("empty: contains") { expect(nothing.contains(1)).should_be(0); };
    test("empty: plus") { expect(nothing.plus(1).size()).should_be(1); };
    try { nothing.first(); test("first of empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("first of empty") { }; }
    try { nothing.last(); test("last of empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("last of empty") { }; }
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_list") {
        test_search();
        test_ordering();
        test_ranges();
        test_immutable_list();
    };
    finish_tests("lib_collections_list");
}
