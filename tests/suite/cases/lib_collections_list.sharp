mod main;

import ( std.testing, std.collections )

/**
 * std.collections - lists<T>, the static helpers for the std `list<T>`
 * class (sorting, searching, ranges, bulk removal, conversions), and the
 * read-only immutable_list.
 */

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def descending(a: int, b: int) : decimal { return b.value - a.value; }
def is_even(n: int) : bool { return n.value % 2 == 0; }
def is_big(n: int) : bool { return n.value > 100; }

/** a list<int> from an array literal of numbers */
def list_of(items: int[]) : list<int> {
    result := new list<int>();
    for(i : decimal = 0; i < sizeof(items); i++) result.add(items[i]);
    return result;
}

/** "1,2,3" for a list of ints */
def join(items: list<int>) : string {
    text := "";
    for(i : decimal = 0; i < items.size().value; i++) {
        if(i > 0) text = text + ",";
        text = text + items.at(i);
    }
    return text;
}

/** "1,2,3" for an array of ints */
def join_array(items: int[]) : string {
    text := "";
    for(i : decimal = 0; i < sizeof(items); i++) {
        if(i > 0) text = text + ",";
        text = text + items[i];
    }
    return text;
}

class card {
    rank : decimal;
    label : string;
    card(rank: decimal, label: string) { self->rank = rank; self->label = label; }
}

def by_rank(a: card, b: card) : decimal { return a.rank - b.rank; }

def test_search() {
    empty := new list<int>();
    l := list_of(new int[] { 4, 7, 4, 9, 2, 4 });

    test("is_empty yes") { expect(lists<int>.is_empty(empty)).should_be(1); };
    test("is_empty no") { expect(lists<int>.is_empty(l)).should_be(0); };
    test("contains") { expect(lists<int>.contains(l, 9)).should_be(1); };
    test("contains missing") { expect(lists<int>.contains(l, 5)).should_be(0); };
    test("contains in empty") { expect(lists<int>.contains(empty, 5)).should_be(0); };
    test("index_of") { expect(lists<int>.index_of(l, 4)).should_be(0); };
    test("index_of later element") { expect(lists<int>.index_of(l, 2)).should_be(4); };
    test("index_of missing") { expect(lists<int>.index_of(l, 5)).should_be(0 - 1); };
    test("last_index_of") { expect(lists<int>.last_index_of(l, 4)).should_be(5); };
    test("last_index_of single") { expect(lists<int>.last_index_of(l, 7)).should_be(1); };
    test("last_index_of missing") { expect(lists<int>.last_index_of(l, 5)).should_be(0 - 1); };
    test("count_of") { expect(lists<int>.count_of(l, 4)).should_be(3); };
    test("count_of missing") { expect(lists<int>.count_of(l, 5)).should_be(0); };
    test("index_where") { expect(lists<int>.index_where(l, { x: int -> (bool) return x.value > 6; })).should_be(1); };
    test("index_where none") { expect(lists<int>.index_where(l, is_big)).should_be(0 - 1); };
    test("first_or_null") { expect(lists<int>.first_or_null(l)!!.value).should_be(4); };
    test("last_or_null") { expect(lists<int>.last_or_null(l)!!.value).should_be(4); };
    test("first_or_null of empty") { expect_null(lists<int>.first_or_null(empty)); };
    test("last_or_null of empty") { expect_null(lists<int>.last_or_null(empty)); };
    test("at_or_null") { expect(lists<int>.at_or_null(l, 3)!!.value).should_be(9); };
    test("at_or_null past the end") { expect_null(lists<int>.at_or_null(l, 6)); };
    test("at_or_null negative") { expect_null(lists<int>.at_or_null(l, 0 - 1)); };

    words := new list<string>();
    words.add("a"); words.add("b");
    test("contains compares strings by value") { expect(lists<string>.contains(words, "" + "b")).should_be(1); };
    test("index_of on strings") { expect(lists<string>.index_of(words, "b")).should_be(1); };

    // the storage is longer than the list: slots beyond the end must not be looked at
    l.pop_back();
    test("last_index_of after pop_back") { expect(lists<int>.last_index_of(l, 4)).should_be(2); };
    test("count_of after pop_back") { expect(lists<int>.count_of(l, 4)).should_be(2); };
}

def test_ordering() {
    l := list_of(new int[] { 5, 3, 9, 1, 4 });
    lists<int>.sort(l, ascending);
    test("sort") { expect(join(l)).should_be("1,3,4,5,9"); };
    test("is_sorted") { expect(lists<int>.is_sorted(l, ascending)).should_be(1); };
    test("is_sorted the other way") { expect(lists<int>.is_sorted(l, descending)).should_be(0); };
    lists<int>.sort(l, descending);
    test("sort descending") { expect(join(l)).should_be("9,5,4,3,1"); };

    empty := new list<int>();
    lists<int>.sort(empty, ascending);
    test("sort of empty") { expect(empty.size().value).should_be(0); };
    test("is_sorted of empty") { expect(lists<int>.is_sorted(empty, ascending)).should_be(1); };
    one := list_of(new int[] { 7 });
    lists<int>.sort(one, ascending);
    test("sort of one") { expect(join(one)).should_be("7"); };

    source := list_of(new int[] { 2, 3, 1 });
    copy := lists<int>.sorted(source, ascending);
    test("sorted copy") { expect(join(copy)).should_be("1,2,3"); };
    test("sorted leaves the list") { expect(join(source)).should_be("2,3,1"); };

    // stable, on objects
    cards := new list<card>();
    cards.add(new card(2, "a")); cards.add(new card(1, "b")); cards.add(new card(2, "c")); cards.add(new card(1, "d"));
    lists<card>.sort(cards, by_rank);
    order := "";
    for(i : decimal = 0; i < 4; i++) order = order + cards.at(i).label;
    test("sort is stable") { expect(order).should_be("bdac"); };

    sorted := list_of(new int[] { 10, 20, 30, 40 });
    test("binary_search found") { expect(lists<int>.binary_search(sorted, 30, ascending)).should_be(2); };
    test("binary_search first") { expect(lists<int>.binary_search(sorted, 10, ascending)).should_be(0); };
    test("binary_search missing: -(2) - 1") { expect(lists<int>.binary_search(sorted, 25, ascending)).should_be(0 - 3); };
    test("binary_search above all: -(4) - 1") { expect(lists<int>.binary_search(sorted, 50, ascending)).should_be(0 - 5); };
    test("binary_search in empty") { expect(lists<int>.binary_search(empty, 1, ascending)).should_be(0 - 1); };

    lists<int>.reverse(sorted);
    test("reverse") { expect(join(sorted)).should_be("40,30,20,10"); };
    odd := list_of(new int[] { 1, 2, 3 });
    lists<int>.reverse(odd);
    test("reverse odd length") { expect(join(odd)).should_be("3,2,1"); };
    test("reversed copy") { expect(join(lists<int>.reversed(odd))).should_be("1,2,3"); };
    test("reversed leaves the list") { expect(join(odd)).should_be("3,2,1"); };
    lists<int>.swap(odd, 0, 2);
    test("swap") { expect(join(odd)).should_be("1,2,3"); };
    try { lists<int>.swap(odd, 0, 3); test("swap out of bounds") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("swap out of bounds") { }; }
    try { lists<int>.swap(odd, 0 - 1, 0); test("swap negative") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("swap negative") { }; }

    // scale: 5000 pseudo random numbers
    big := new list<int>();
    seed : decimal = 8086;
    sum_before : decimal = 0;
    for(i : decimal = 0; i < 5000; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        big.add(new int(seed));
        sum_before += seed;
    }
    lists<int>.sort(big, ascending);
    in_order : decimal = 1;
    sum_after : decimal = big.at(0).value;
    for(i : decimal = 1; i < 5000; i++) {
        if(big.at(i - 1).value > big.at(i).value) in_order = 0;
        sum_after += big.at(i).value;
    }
    test("sort 5000: size") { expect(big.size().value).should_be(5000); };
    test("sort 5000: ascending") { expect(in_order).should_be(1); };
    test("sort 5000: nothing lost") { expect(sum_after).should_be(sum_before); };
    test("sort 5000: binary_search finds an element") { expect_true(lists<int>.binary_search(big, big.at(4321), ascending) >= 0); };
}

def test_ranges() {
    l := list_of(new int[] { 0, 1, 2, 3, 4, 5 });
    empty := new list<int>();

    test("sub_list") { expect(join(lists<int>.sub_list(l, 2, 5))).should_be("2,3,4"); };
    test("sub_list everything") { expect(join(lists<int>.sub_list(l, 0, 6))).should_be("0,1,2,3,4,5"); };
    test("sub_list empty") { expect(lists<int>.sub_list(l, 3, 3).size().value).should_be(0); };
    part := lists<int>.sub_list(l, 0, 2);
    part.add(99);
    test("sub_list is independent") { expect(l.size().value).should_be(6); };
    try { lists<int>.sub_list(l, 0, 7); test("sub_list past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list past the end") { }; }
    try { lists<int>.sub_list(l, 4, 3); test("sub_list from > to") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list from > to") { }; }
    try { lists<int>.sub_list(l, 0 - 1, 3); test("sub_list negative") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list negative") { }; }

    copy := lists<int>.copy_of(l);
    copy.put(0, 50);
    test("copy_of") { expect(join(copy)).should_be("50,1,2,3,4,5"); };
    test("copy_of is independent") { expect(l.at(0).value).should_be(0); };

    test("to_array") { expect(join_array(lists<int>.to_array(l))).should_be("0,1,2,3,4,5"); };
    test("to_array has exactly size() slots") { expect(sizeof(lists<int>.to_array(l))).should_be(6); };
    test("to_array of empty is not null") { expect(sizeof(lists<int>.to_array(empty))).should_be(0); };

    grown := list_of(new int[] { 1 });
    lists<int>.add_array(grown, new int[] { 2, 3 });
    test("add_array") { expect(join(grown)).should_be("1,2,3"); };
    lists<int>.add_array(grown, new int[0]);
    test("add_array empty") { expect(join(grown)).should_be("1,2,3"); };

    target := list_of(new int[] { 1, 2, 5 });
    lists<int>.insert_all(target, 2, list_of(new int[] { 3, 4 }));
    test("insert_all in the middle") { expect(join(target)).should_be("1,2,3,4,5"); };
    lists<int>.insert_all(target, 0, list_of(new int[] { 0 }));
    test("insert_all at the front") { expect(join(target)).should_be("0,1,2,3,4,5"); };
    lists<int>.insert_all(target, 6, list_of(new int[] { 6, 7 }));
    test("insert_all at the end") { expect(join(target)).should_be("0,1,2,3,4,5,6,7"); };
    lists<int>.insert_all(target, 3, empty);
    test("insert_all of an empty list") { expect(target.size().value).should_be(8); };
    target.add(8);
    test("add after insert_all") { expect(join(target)).should_be("0,1,2,3,4,5,6,7,8"); };
    twice := list_of(new int[] { 1, 2 });
    lists<int>.insert_all(twice, 1, twice);
    test("insert_all of the list itself") { expect(join(twice)).should_be("1,1,2,2"); };
    try { lists<int>.insert_all(target, 10, twice); test("insert_all past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("insert_all past the end") { }; }

    lists<int>.remove_range(target, 2, 5);
    test("remove_range") { expect(join(target)).should_be("0,1,5,6,7,8"); };
    lists<int>.remove_range(target, 0, 1);
    test("remove_range at the front") { expect(join(target)).should_be("1,5,6,7,8"); };
    lists<int>.remove_range(target, 3, 5);
    test("remove_range at the end") { expect(join(target)).should_be("1,5,6"); };
    lists<int>.remove_range(target, 1, 1);
    test("remove_range empty") { expect(target.size().value).should_be(3); };
    lists<int>.remove_range(target, 0, 3);
    test("remove_range everything") { expect(target.size().value).should_be(0); };
    target.add(1);
    test("usable after remove_range") { expect(join(target)).should_be("1"); };
    try { lists<int>.remove_range(target, 0, 2); test("remove_range past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("remove_range past the end") { }; }

    r := list_of(new int[] { 4, 7, 4, 9, 4 });
    test("remove_all returns the count") { expect(lists<int>.remove_all(r, 4)).should_be(3); };
    test("remove_all") { expect(join(r)).should_be("7,9"); };
    test("remove_all missing") { expect(lists<int>.remove_all(r, 4)).should_be(0); };
    test("remove_all size") { expect(r.size().value).should_be(2); };

    f := list_of(new int[] { 1, 2, 3, 4, 5, 6 });
    test("remove_if returns the count") { expect(lists<int>.remove_if(f, is_even)).should_be(3); };
    test("remove_if") { expect(join(f)).should_be("1,3,5"); };
    test("remove_if nothing") { expect(lists<int>.remove_if(f, is_even)).should_be(0); };
    g := list_of(new int[] { 1, 2, 3, 4, 5, 6 });
    test("retain_if returns the count") { expect(lists<int>.retain_if(g, is_even)).should_be(3); };
    test("retain_if") { expect(join(g)).should_be("2,4,6"); };
    test("retain_if nothing matches") { expect(lists<int>.retain_if(g, is_big)).should_be(3); };
    test("retain_if emptied the list") { expect(g.size().value).should_be(0); };

    h := list_of(new int[] { 1, 2, 3 });
    lists<int>.fill(h, 7);
    test("fill") { expect(join(h)).should_be("7,7,7"); };

    it := lists<int>.iterator(l);
    digits : decimal = 0;
    while(it.has_next()) digits = digits * 10 + it.next().value;
    test("iterator") { expect(digits).should_be(12345); };
    test("iterator of empty") { expect(lists<int>.iterator(empty).has_next()).should_be(0); };
    snapshot := lists<int>.iterator(l);
    l.clear();
    test("iterator walks a snapshot") { expect(snapshot.next().value).should_be(0); };

    // of / equals
    made := lists<int>.of(new int[] { 1, 2, 3 });
    test("of") { expect(join(made)).should_be("1,2,3"); };
    test("of an empty array") { expect(lists<int>.of(new int[0]).size().value).should_be(0); };
    test("equals") { expect(lists<int>.equals(made, list_of(new int[] { 1, 2, 3 }))).should_be(1); };
    test("equals one difference") { expect(lists<int>.equals(made, list_of(new int[] { 1, 2, 4 }))).should_be(0); };
    test("equals different size") { expect(lists<int>.equals(made, list_of(new int[] { 1, 2 }))).should_be(0); };
    test("equals both empty") { expect(lists<int>.equals(new list<int>(), new list<int>())).should_be(1); };
}

def test_immutable_list() {
    source := list_of(new int[] { 3, 1, 4, 1, 5 });
    frozen := new immutable_list<int>(source);
    test("size") { expect(frozen.size()).should_be(5); };
    test("is_empty") { expect(frozen.is_empty()).should_be(0); };
    test("at") { expect(frozen.at(2).value).should_be(4); };
    test("first") { expect(frozen.first().value).should_be(3); };
    test("last") { expect(frozen.last().value).should_be(5); };
    test("index_of") { expect(frozen.index_of(1)).should_be(1); };
    test("last_index_of") { expect(frozen.last_index_of(1)).should_be(3); };
    test("index_of missing") { expect(frozen.index_of(9)).should_be(0 - 1); };
    test("contains") { expect(frozen.contains(4)).should_be(1); };
    test("contains missing") { expect(frozen.contains(9)).should_be(0); };
    try { frozen.at(5); test("at(size)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("at(size)") { }; }
    try { frozen.at(0 - 1); test("at(-1)") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("at(-1)") { }; }

    // changes to the source, or to what the list hands out, do not show through
    source.put(0, 99);
    source.add(6);
    test("independent of its source: element") { expect(frozen.at(0).value).should_be(3); };
    test("independent of its source: size") { expect(frozen.size()).should_be(5); };
    handed_out := frozen.to_array();
    handed_out[0] = new int(77);
    test("to_array is a copy") { expect(frozen.at(0).value).should_be(3); };
    elements := frozen.get_elements()!!;
    elements[1] = new int(77);
    test("get_elements is a copy") { expect(frozen.at(1).value).should_be(1); };
    as_list := frozen.to_list();
    as_list.clear();
    test("to_list is a copy") { expect(frozen.size()).should_be(5); };

    // "changing" functions make new lists
    longer := frozen.plus(9);
    test("plus: new list") { expect(longer.size()).should_be(6); };
    test("plus: last") { expect(longer.last().value).should_be(9); };
    test("plus: original unchanged") { expect(frozen.size()).should_be(5); };
    test("sub_list") { expect(join(frozen.sub_list(1, 4).to_list())).should_be("1,4,1"); };
    test("sub_list empty") { expect(frozen.sub_list(2, 2).size()).should_be(0); };
    try { frozen.sub_list(2, 6); test("sub_list past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("sub_list past the end") { }; }
    test("reversed") { expect(join(frozen.reversed().to_list())).should_be("5,1,4,1,3"); };
    test("reversed leaves the original") { expect(join(frozen.to_list())).should_be("3,1,4,1,5"); };

    digits : decimal = 0;
    foreach(x in frozen) { digits = digits * 10 + x.value; }
    test("foreach") { expect(digits).should_be(31415); };
    it := frozen.iterator();
    digits = 0;
    while(it.has_next()) digits = digits * 10 + it.next().value;
    test("iterator") { expect(digits).should_be(31415); };

    // other ways to make one
    from_array := new immutable_list<int>(new int[] { 1, 2 });
    test("from an array") { expect(from_array.size()).should_be(2); };
    ring := new deque<int>();
    ring.add_last(8); ring.add_first(7);
    from_deque := new immutable_list<int>(ring);
    test("from any collection") { expect(join(from_deque.to_list())).should_be("7,8"); };
    from_empty := new immutable_list<int>(new list<int>());
    test("from an empty collection") { expect(from_empty.size()).should_be(0); };

    nothing := new immutable_list<int>();
    test("empty: size") { expect(nothing.size()).should_be(0); };
    test("empty: is_empty") { expect(nothing.is_empty()).should_be(1); };
    test("empty: get_elements") { expect_null(nothing.get_elements()); };
    test("empty: to_array") { expect(sizeof(nothing.to_array())).should_be(0); };
    test("empty: iterator") { expect(nothing.iterator().has_next()).should_be(0); };
    test("empty: contains") { expect(nothing.contains(1)).should_be(0); };
    test("empty: plus") { expect(nothing.plus(1).size()).should_be(1); };
    try { nothing.first(); test("first of empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("first of empty") { }; }
    try { nothing.last(); test("last of empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("last of empty") { }; }
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_list") {
        test_search();
        test_ordering();
        test_ranges();
        test_immutable_list();
    };
    finish_tests();
}
