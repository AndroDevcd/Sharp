mod main;

import ( testing )

/**
 * `x = x + n` on a localized (fiber-local) number.
 *
 * It used to store a meaningless number (52, 1915, ...; it differed from
 * program to program): the value was loaded into ebx but the addition read the
 * register it had asked for, which never received it
 * (finalizer/generation/code/code_context.cpp, numeric_tls_field).
 * std.io.coroutines went through a local variable to avoid it
 * (mark_scope() / unmark_scope() in std/io/coroutines/scope/scopes.sharp);
 * both ways are checked here.
 */

localized direct : decimal;
localized through_local : decimal;

def add_direct(n: decimal) {
    direct = direct + n;
}

def add_through_local(n: decimal) {
    current : decimal = through_local;
    current = current + n;
    through_local = current;
}

def main(args: string[]) {
    add_direct(4);
    add_through_local(4);

    expect("through a local variable", through_local, 4);
    expect("direct", direct, 4);

    add_through_local(8);
    expect("through a local variable, again", through_local, 12);

    finish("lib_coroutines_localized_arithmetic");
}
