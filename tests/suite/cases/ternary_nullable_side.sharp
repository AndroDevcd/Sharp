mod main;

import ( testing )

/**
 * `?:` with a `T` on one side and a `T?` (or null) on the other, in either
 * order: the result is a `T?`.
 *
 *      def pick(first: decimal, a: node, b: node?) : node? { return first ? a : b; }
 *
 * (It was error S8028, "nullability mismatch".)
 */

class node { value : decimal; }

def pick(first: decimal, a: node, b: node?) : node? { return first ? a : b; }

def main(args: string[]) {
    n := new node();
    n.value = 4;

    expect("the non-null side", pick(1, n, null)!!.value, 4);
    expect_true("the nullable side", pick(0, n, null) == null);

    second : node? = n.value == 0 ? n : null;
    expect_true("null written on the second side", second == null);
    first : node? = n.value == 0 ? null : n;
    expect("null written on the first side", first!!.value, 4);

    finish("ternary_nullable_side");
}
