mod main;

import ( std.testing )

/**
 * The fixes and additions to the EXISTING std collection classes:
 * list, synced_list, hash_map, hash_table, dictionary.
 *
 * This file needs the changed std/list.sharp, std/synced_list.sharp,
 * std/hash_map.sharp, std/hash_table.sharp and std/dictionary.sharp.
 */

def ascending(a: int, b: int) : decimal { return a.value - b.value; }

/** "1,2,3" for a list of ints */
def join(items: list<int>) : string {
    text := "";
    for(i : decimal = 0; i < items.size(); i++) {
        if(i > 0) text = text + ",";
        text = text + items.at(i);
    }
    return text;
}

def list_of(a: decimal, b: decimal, c: decimal, d: decimal) : list<int> {
    result := new list<int>();
    result.add(new int(a)); result.add(new int(b)); result.add(new int(c)); result.add(new int(d));
    return result;
}

class card {
    rank : decimal;
    label : string;
    card(rank: decimal, label: string) { self->rank = rank; self->label = label; }
}

def by_rank(a: card, b: card) : decimal { return a.rank - b.rank; }

def test_list() {
    empty := new list<int>();
    l := list_of(4, 7, 4, 9);

    test("list is_empty yes") { expect(empty.is_empty()).should_be(1); };
    test("list is_empty no") { expect(l.is_empty()).should_be(0); };
    test("list contains") { expect(l.contains(9)).should_be(1); };
    test("list contains missing") { expect(l.contains(5)).should_be(0); };
    test("list contains in empty") { expect(empty.contains(5)).should_be(0); };
    test("list last_index_of") { expect(l.last_index_of(4)).should_be(2); };
    test("list last_index_of missing") { expect(l.last_index_of(5)).should_be(0 - 1); };
    test("list to_array") { expect(sizeof(l.to_array())).should_be(4); };
    test("list to_array[3]") { expect(l.to_array()[3].value).should_be(9); };
    test("list to_array of empty is not null") { expect(sizeof(empty.to_array())).should_be(0); };

    test("list sub_list") { expect(join(l.sub_list(1, 3))).should_be("7,4"); };
    test("list sub_list empty") { expect(l.sub_list(2, 2).size()).should_be(0); };
    part := l.sub_list(0, 4);
    part.add(1);
    test("list sub_list is independent") { expect(l.size()).should_be(4); };
    try { l.sub_list(0, 5); test("list sub_list past the end") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("list sub_list past the end") { }; }
    try { l.sub_list(3, 2); test("list sub_list from > to") { fail_test("did not throw"); }; } catch(e: out_of_bounds_exception) { test("list sub_list from > to") { }; }

    l.reverse();
    test("list reverse") { expect(join(l)).should_be("9,4,7,4"); };
    l.sort(ascending);
    test("list sort") { expect(join(l)).should_be("4,4,7,9"); };
    l.add(1);
    test("list add after sort") { expect(join(l)).should_be("4,4,7,9,1"); };
    l.sort(ascending);
    test("list sort again") { expect(join(l)).should_be("1,4,4,7,9"); };
    empty.sort(ascending);
    test("list sort of empty") { expect(empty.size()).should_be(0); };

    // works for a list of a user class too, and is stable
    cards := new list<card>();
    cards.add(new card(2, "a")); cards.add(new card(1, "b")); cards.add(new card(2, "c")); cards.add(new card(1, "d"));
    cards.sort(by_rank);
    order := "";
    for(i : decimal = 0; i < 4; i++) order = order + cards.at(i).label;
    test("list sort is stable") { expect(order).should_be("bdac"); };
    test("list<card> contains is by identity") { expect(cards.contains(new card(1, "b"))).should_be(0); };
    test("list<card> contains itself") { expect(cards.contains(cards.at(2))).should_be(1); };

    // 5000 pseudo random numbers
    big := new list<int>();
    seed : decimal = 4242;
    sum_before : decimal = 0;
    for(i : decimal = 0; i < 5000; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        big.add(new int(seed));
        sum_before += seed;
    }
    big.sort(ascending);
    in_order : decimal = 1;
    sum_after : decimal = big.at(0).value;
    for(i : decimal = 1; i < 5000; i++) {
        if(big.at(i - 1).value > big.at(i).value) in_order = 0;
        sum_after += big.at(i).value;
    }
    test("list sort 5000: size") { expect(big.size()).should_be(5000); };
    test("list sort 5000: ascending") { expect(in_order).should_be(1); };
    test("list sort 5000: nothing lost") { expect(sum_after).should_be(sum_before); };
    big.add(0);
    test("list sort 5000: add still works") { expect(big.last().value).should_be(0); };

    // add_all appends (it used to replace the contents, and threw for an empty source)
    target := list_of(1, 2, 3, 4);
    target.add_all(list_of(5, 6, 7, 8));
    test("list add_all appends") { expect(join(target)).should_be("1,2,3,4,5,6,7,8"); };
    target.add_all(new list<int>());
    test("list add_all of an empty list") { expect(target.size()).should_be(8); };
    target.add_all(target);
    test("list add_all of itself") { expect(target.size()).should_be(16); };
    try { target.at(99); test("list at out of bounds") { fail_test("did not throw"); }; }
    catch(e: out_of_bounds_exception) { test("list out of bounds message") { expect(e.get_message()).should_be("Index: 99, size: 16"); }; }
}

def test_synced_list() {
    s := new synced_list<int>();
    test("synced is_empty yes") { expect(s.is_empty()).should_be(1); };
    s.add(3); s.add(5);
    test("synced is_empty no") { expect(s.is_empty()).should_be(0); };
    test("synced first") { expect(s.first().value).should_be(3); };
    test("synced contains") { expect(s.contains(5)).should_be(1); };
    test("synced contains missing") { expect(s.contains(4)).should_be(0); };
    s.add_all(list_of(7, 8, 9, 10));
    test("synced add_all appends: size") { expect(s.size()).should_be(6); };
    test("synced add_all appends: first") { expect(s.first().value).should_be(3); };
    test("synced add_all appends: last") { expect(s.last().value).should_be(10); };
    s.add_all(new list<int>());
    test("synced add_all of an empty list") { expect(s.size()).should_be(6); };
    snapshot := s.to_list();
    test("synced to_list") { expect(join(snapshot)).should_be("3,5,7,8,9,10"); };
    snapshot.clear();
    test("synced to_list is a copy") { expect(s.size()).should_be(6); };
    // past the first storage array (10 slots)
    for(i : decimal = 0; i < 300; i++) s.add(i);
    test("synced grown size") { expect(s.size()).should_be(306); };
    test("synced grown last") { expect(s.last().value).should_be(299); };
}

def test_hash_map() {
    m := new hash_map<string, int>();
    test("map is_empty yes") { expect_true(m.is_empty()); };
    m.put("a", 1); m.put("b", 2); m.put("c", 3);
    test("map is_empty no") { expect_false(m.is_empty()); };
    test("map contains_key") { expect_true(m.contains_key("b")); };
    test("map contains_key missing") { expect_false(m.contains_key("z")); };
    test("map at missing is null, also for number values") { expect_null(m.at("z")); };

    test("map remove") { expect_true(m.remove("b")); };
    test("map remove again") { expect_false(m.remove("b")); };
    test("map size after remove") { expect(m.size()).should_be(2); };
    test("map removed key is gone") { expect_null(m.at("b")); };
    test("map other keys survive") { expect(m.at("a")!!.value + m.at("c")!!.value).should_be(4); };

    test("map keys") { expect(m.keys().size()).should_be(2); };
    test("map values") { expect(m.values().size()).should_be(2); };
    sum : decimal = 0;
    foreach(x in m.values()) { sum += x.value; }
    test("map values sum") { expect(sum).should_be(4); };
    entries := m.entries();
    test("map entries") { expect(entries.size()).should_be(2); };
    seen := "";
    sum = 0;
    foreach(e in entries) {
        if(e.key == "a") seen = seen + "a";
        if(e.key == "c") seen = seen + "c";
        sum += e.value.value;
    }
    test("map entries: both keys once") { expect(seen.size()).should_be(2); };
    test("map entries: values") { expect(sum).should_be(4); };

    // keys in one bucket (1, 129, 257 with 128 buckets): remove from the middle, the end, the front
    chain := new hash_map<int, string>();
    chain.put(1, "one"); chain.put(129, "two"); chain.put(257, "three");
    test("map missing key in a full bucket is null") { expect_null(chain.at(385)); };
    test("map remove from a chain") { expect_true(chain.remove(129)); };
    test("map chain: first survives") { expect(chain.at(1)!!).should_be("one"); };
    test("map chain: last survives") { expect(chain.at(257)!!).should_be("three"); };
    test("map chain: removed is gone") { expect_null(chain.at(129)); };
    test("map remove another of the chain") { expect_true(chain.remove(257)); };
    test("map remove the last of the chain") { expect_true(chain.remove(1)); };
    test("map chain: empty") { expect(chain.size()).should_be(0); };
    chain.put(1, "again");
    test("map chain: usable again") { expect(chain.at(1)!!).should_be("again"); };

    // growth: 4 buckets, 2000 entries; every key must still be found
    capacity : int = 4;
    big := new hash_map<int, int>(capacity);
    for(i : decimal = 0; i < 2000; i++) big.put(i * 3, i);
    test("map growth: size") { expect(big.size()).should_be(2000); };
    wrong : decimal = 0;
    for(i : decimal = 0; i < 2000; i++) {
        found := big.at(i * 3);
        if(found == null) wrong++;
        else if(found!!.value != i) wrong++;
    }
    test("map growth: every key found") { expect(wrong).should_be(0); };
    test("map growth: a key between") { expect_null(big.at(4)); };
    for(i : decimal = 0; i < 2000; i += 2) big.remove(i * 3);
    test("map growth: size after 1000 removes") { expect(big.size()).should_be(1000); };
    test("map growth: a removed key") { expect_null(big.at(6)); };
    test("map growth: a kept key") { expect(big.at(9)!!.value).should_be(3); };
    test("map growth: keys()") { expect(big.keys().size()).should_be(1000); };
    big.clear();
    test("map clear") { expect(big.size()).should_be(0); };
    test("map is_empty after clear") { expect_true(big.is_empty()); };
}

def test_hash_table() {
    t := new hash_table<string, int>();
    test("table put new") { expect_true(t.put("ann", 31)); };
    test("table put existing") { expect_false(t.put("ann", 32)); };
    test("table at") { expect(t.at("ann")!!.value).should_be(32); };
    test("table size") { expect(t.size()).should_be(1); };
    test("table at missing") { expect_null(t.at("bob")); };
    test("table contains_key") { expect_true(t.contains_key("ann")); };
    test("table contains_key missing") { expect_false(t.contains_key("bob")); };
    t.put("bob", 45);
    test("table keys") { expect(t.keys().size()).should_be(2); };
    sum : decimal = 0;
    foreach(x in t.values()) { sum += x.value; }
    test("table values") { expect(sum).should_be(77); };
    test("table remove") { expect_true(t.remove("ann")); };
    test("table remove again") { expect_false(t.remove("ann")); };
    test("table removed key") { expect_null(t.at("ann")); };
    test("table size after remove") { expect(t.size()).should_be(1); };

    numbers := new hash_table<int, int>();
    for(i : decimal = 0; i < 1000; i++) numbers.put(i, i * 2);
    test("table 1000: size") { expect(numbers.size()).should_be(1000); };
    wrong : decimal = 0;
    for(i : decimal = 0; i < 1000; i++) {
        if(numbers.at(i)!!.value != i * 2) wrong++;
    }
    test("table 1000: every key found") { expect(wrong).should_be(0); };
    numbers.clear();
    test("table clear") { expect(numbers.size()).should_be(0); };
}

def test_dictionary() {
    ages := { "ann" : 31, "bob" : 45, "cid" : 27 };
    test("dict size") { expect(ages.size()).should_be(3); };
    test("dict is_empty") { expect(ages.is_empty()).should_be(0); };

    names := "";
    total : decimal = 0;
    foreach(entry in ages) {
        names = names + entry.first + " ";
        total += entry.second;
    }
    test("dict foreach keys") { expect(names).should_be("ann bob cid "); };
    test("dict foreach values") { expect(total).should_be(103); };

    // an empty literal can be built (it used to throw in the constructor)
    none := { as <string, int> : };
    test("empty dict size") { expect(none.size()).should_be(0); };
    test("empty dict is_empty") { expect(none.is_empty()).should_be(1); };
    visited : decimal = 0;
    foreach(entry in none) { visited++; }
    test("empty dict foreach") { expect(visited).should_be(0); };
    // the old way to reach the pairs still works
    test("dict map field") { expect(ages.size()).should_be(3); };
    test("dict map pair") { expect(ages.values().at(1).value).should_be(45); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_std_fixes") {
        test_list();
        test_synced_list();
        test_hash_map();
        test_hash_table();
        test_dictionary();
    };
    finish_tests("lib_collections_std_fixes");
}
