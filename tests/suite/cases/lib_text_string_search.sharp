mod main;

import ( std.testing )

/**
 * std.text - the `string` class, part 2:
 *   - string_search.sharp   index_of / last_index_of (text, char, any of a set),
 *                           contains, count, starts_with_at, ignore-case forms
 *   - string_replace.sharp  replace_all / first / last, replace_char, replace_range,
 *                           insert, remove, remove_chars, retain_chars
 *
 * Positions are native numbers, -1 = not found.
 */

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_string_search") {
        banana : string = "banana";
        empty : string = "";
        one : string = "x";
        hello : string = "Hello World";

        // ---- index_of
        test("index_of") { expect(banana.index_of("an")).should_be(1); };
        test("index_of at the start") { expect(banana.index_of("ban")).should_be(0); };
        test("index_of at the end") { expect(banana.index_of("na")).should_be(2); };
        test("index_of the whole string") { expect(banana.index_of("banana")).should_be(0); };
        test("index_of, not found") { expect(banana.index_of("xyz")).should_be(0 - 1); };
        test("index_of something longer than the string") { expect(banana.index_of("bananas")).should_be(0 - 1); };
        test("index_of \"\"") { expect(banana.index_of("")).should_be(0); };
        test("index_of in \"\"") { expect(empty.index_of("a")).should_be(0 - 1); };
        test("index_of \"\" in \"\"") { expect(empty.index_of("")).should_be(0); };
        test("index_of with a char literal") { expect(banana.index_of('n')).should_be(2); };
        test("index_of with a start") { expect(banana.index_of("an", 2)).should_be(3); };
        test("index_of with a start on a match") { expect(banana.index_of("an", 1)).should_be(1); };
        test("index_of with a start after the last match") { expect(banana.index_of("an", 4)).should_be(0 - 1); };
        test("index_of with a negative start") { expect(banana.index_of("an", 0 - 5)).should_be(1); };
        test("index_of with a start beyond the end") { expect(banana.index_of("a", 99)).should_be(0 - 1); };
        test("index_of \"\" with a start") { expect(banana.index_of("", 3)).should_be(3); };
        test("index_of \"\" with a start beyond the end") { expect(banana.index_of("", 99)).should_be(6); };
        aaab : string = "aaab";
        test("index_of after partial matches") { expect(aaab.index_of("ab")).should_be(2); };

        // ---- last_index_of
        test("last_index_of") { expect(banana.last_index_of("an")).should_be(3); };
        test("last_index_of one character") { expect(banana.last_index_of("a")).should_be(5); };
        test("last_index_of, not found") { expect(banana.last_index_of("x")).should_be(0 - 1); };
        test("last_index_of \"\"") { expect(banana.last_index_of("")).should_be(6); };
        test("last_index_of with a start") { expect(banana.last_index_of("an", 2)).should_be(1); };
        test("last_index_of with a start on a match") { expect(banana.last_index_of("an", 3)).should_be(3); };
        test("last_index_of with a start before every match") { expect(banana.last_index_of("an", 0)).should_be(0 - 1); };
        test("last_index_of with a negative start") { expect(banana.last_index_of("b", 0 - 1)).should_be(0 - 1); };
        test("last_index_of the whole string") { expect(banana.last_index_of("banana")).should_be(0); };

        // ---- single characters
        test("index_of_char") { expect(banana.index_of_char('n')).should_be(2); };
        test("index_of_char, not found") { expect(banana.index_of_char('z')).should_be(0 - 1); };
        test("index_of_char with a start") { expect(banana.index_of_char('n', 3)).should_be(4); };
        test("index_of_char from a variable") { expect(banana.index_of_char(banana.char_at(1))).should_be(1); };
        test("last_index_of_char") { expect(banana.last_index_of_char('n')).should_be(4); };
        test("last_index_of_char with a start") { expect(banana.last_index_of_char('n', 3)).should_be(2); };
        test("last_index_of_char, not found") { expect(banana.last_index_of_char('z')).should_be(0 - 1); };
        test("index_of_char in \"\"") { expect(empty.index_of_char('a')).should_be(0 - 1); };
        test("last_index_of_char in \"\"") { expect(empty.last_index_of_char('a')).should_be(0 - 1); };

        // ---- any of a set
        setting : string = "a=b;c";
        test("index_of_any") { expect(setting.index_of_any(";=")).should_be(1); };
        test("index_of_any with a start") { expect(setting.index_of_any(";=", 2)).should_be(3); };
        test("index_of_any, none present") { expect(setting.index_of_any("#!")).should_be(0 - 1); };
        test("index_of_any with an empty set") { expect(setting.index_of_any("")).should_be(0 - 1); };
        test("last_index_of_any") { expect(setting.last_index_of_any(";=")).should_be(3); };
        test("last_index_of_any, none present") { expect(setting.last_index_of_any("#")).should_be(0 - 1); };
        indented : string = "   x  ";
        test("index_of_none") { expect(indented.index_of_none(" ")).should_be(3); };
        test("index_of_none when all are in the set") { expect(indented.index_of_none(" x")).should_be(0 - 1); };
        test("index_of_none in \"\"") { expect(empty.index_of_none(" ")).should_be(0 - 1); };

        // ---- contains, count
        test("contains") { expect_true(banana.contains("nan")); };
        test("contains, not there") { expect_false(banana.contains("nab")); };
        test("contains \"\"") { expect_true(banana.contains("")); };
        test("\"\" contains \"\"") { expect_true(empty.contains("")); };
        test("\"\" contains text") { expect_false(empty.contains("a")); };
        test("contains a char literal") { expect_true(banana.contains('b')); };
        test("contains_char") { expect_true(banana.contains_char('b')); };
        test("contains_char, not there") { expect_false(banana.contains_char('z')); };
        test("contains_any") { expect_true(banana.contains_any("xyzn")); };
        test("contains_any, none there") { expect_false(banana.contains_any("xyz")); };
        test("contains_ignore_case") { expect_true(hello.contains_ignore_case("WORLD")); };
        test("contains is case sensitive") { expect_false(hello.contains("WORLD")); };
        test("index_of_ignore_case") { expect(hello.index_of_ignore_case("WORLD")).should_be(6); };
        test("index_of_ignore_case, not found") { expect(hello.index_of_ignore_case("words")).should_be(0 - 1); };
        test("count") { expect(banana.count("an")).should_be(2); };
        test("count of single characters") { expect(banana.count("a")).should_be(3); };
        aaaa : string = "aaaa";
        test("count does not overlap") { expect(aaaa.count("aa")).should_be(2); };
        test("count, not there") { expect(banana.count("x")).should_be(0); };
        test("count \"\"") { expect(banana.count("")).should_be(0); };
        test("count the whole string") { expect(banana.count("banana")).should_be(1); };
        test("count_char") { expect(banana.count_char('a')).should_be(3); };
        test("count_char, not there") { expect(banana.count_char('z')).should_be(0); };

        // ---- starts / ends
        test("starts_with_at") { expect_true(banana.starts_with_at("nan", 2)); };
        test("starts_with_at, wrong position") { expect_false(banana.starts_with_at("nan", 1)); };
        test("starts_with_at, does not fit") { expect_false(banana.starts_with_at("nana", 4)); };
        test("starts_with_at a negative position") { expect_false(banana.starts_with_at("b", 0 - 1)); };
        test("starts_with_ignore_case") { expect_true(hello.starts_with_ignore_case("hELLO")); };
        test("starts_with_ignore_case, different text") { expect_false(hello.starts_with_ignore_case("help")); };
        test("ends_with_ignore_case") { expect_true(hello.ends_with_ignore_case("WORLD")); };
        test("ends_with_ignore_case, too long") { expect_false(hello.ends_with_ignore_case("xhello world")); };
        test("ends_with_ignore_case, the whole string") { expect_true(hello.ends_with_ignore_case("HELLO WORLD")); };

        // ---- replace_all / first / last
        dashed : string = "a-b-c";
        test("replace_all") { expect(dashed.replace_all("-", "+")).should_be("a+b+c"); };
        test("replace_all with something longer") { expect(dashed.replace_all("-", " and ")).should_be("a and b and c"); };
        test("replace_all with \"\"") { expect(dashed.replace_all("-", "")).should_be("abc"); };
        test("replace_all, not found") { expect(dashed.replace_all("#", "+")).should_be("a-b-c"); };
        test("replace_all leaves the original alone") { expect(dashed).should_be("a-b-c"); };
        test("replace_all does not overlap") { expect(aaaa.replace_all("aa", "b")).should_be("bb"); };
        aaa : string = "aaa";
        test("replace_all, left to right") { expect(aaa.replace_all("aa", "b")).should_be("ba"); };
        test("replace_all of the whole string") { expect(banana.replace_all("banana", "")).should_be(""); };
        test("replace_all at both ends") { expect(banana.replace_all("a", "o").replace_all("b", "B")).should_be("Bonono"); };
        test("replace_all does not rescan the replacement") { expect(aaa.replace_all("a", "aa")).should_be("aaaaaa"); };
        test("replace_all in \"\"") { expect(empty.replace_all("a", "b")).should_be(""); };
        test("replace_first") { expect(dashed.replace_first("-", "+")).should_be("a+b-c"); };
        test("replace_first, not found") { expect(dashed.replace_first("#", "+")).should_be("a-b-c"); };
        test("replace_last") { expect(dashed.replace_last("-", "+")).should_be("a-b+c"); };
        test("replace_last, not found") { expect(dashed.replace_last("#", "+")).should_be("a-b-c"); };
        test("replace_first with \"\"") { expect(banana.replace_first("an", "")).should_be("bana"); };
        try {
            dashed.replace_all("", "x");
            test("replace_all of \"\"") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("replace_all of \"\"") { };
        }
        long_text := one.repeat(2000);
        test("replace_all on a long string") { expect(long_text.replace_all("x", "yz").length()).should_be(4000); };

        // ---- characters and ranges
        dotted : string = "a.b.c";
        test("replace_char") { expect(dotted.replace_char('.', '/')).should_be("a/b/c"); };
        test("replace_char, not there") { expect(dotted.replace_char('#', '/')).should_be("a.b.c"); };
        test("replace_char in \"\"") { expect(empty.replace_char('a', 'b')).should_be(""); };
        abcdef : string = "abcdef";
        test("replace_range") { expect(abcdef.replace_range(1, 3, "XYZ")).should_be("aXYZdef"); };
        test("replace_range with \"\"") { expect(abcdef.replace_range(1, 3, "")).should_be("adef"); };
        test("replace_range of nothing inserts") { expect(abcdef.replace_range(2, 2, "-")).should_be("ab-cdef"); };
        test("replace_range of everything") { expect(abcdef.replace_range(0, 6, "z")).should_be("z"); };
        try {
            abcdef.replace_range(3, 2, "x");
            test("replace_range with end before start") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("replace_range with end before start") { };
        }
        held : string = "held";
        test("insert") { expect(held.insert(3, "lo wor")).should_be("hello word"); };
        test("insert at the start") { expect(held.insert(0, ">")).should_be(">held"); };
        test("insert at the end") { expect(held.insert(4, "!")).should_be("held!"); };
        try {
            held.insert(5, "x");
            test("insert beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("insert beyond the end") { };
        }

        // ---- remove
        list_text : string = "a, b, c";
        test("remove") { expect(list_text.remove(", ")).should_be("abc"); };
        test("remove, not there") { expect(list_text.remove("#")).should_be("a, b, c"); };
        phone : string = "(555) 123-4567";
        test("remove_chars") { expect(phone.remove_chars("() -")).should_be("5551234567"); };
        test("remove_chars with an empty set") { expect(phone.remove_chars("")).should_be("(555) 123-4567"); };
        test("retain_chars") { expect(phone.retain_chars("0123456789")).should_be("5551234567"); };
        test("retain_chars, nothing kept") { expect(phone.retain_chars("abc")).should_be(""); };
        test("remove_chars removing everything") { expect(one.remove_chars("x")).should_be(""); };
    };
    finish_tests();
}
