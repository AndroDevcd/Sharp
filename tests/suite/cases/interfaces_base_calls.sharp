mod main;
import ( testing )
interface named {
    def name(): string;
}
class rectangle : named {
    override def name(): string { return "rectangle"; }
    def describe(): string { return "a " + name(); }
}
class labelled_rectangle base rectangle {
    override def name(): string { return "label of " + base->name(); }
}
class deep_rectangle base labelled_rectangle {
    override def name(): string { return "deep " + base->name(); }
}
def main(args: string[]) {
    r : rectangle = new labelled_rectangle();
    expect_str("base call inside the override", r.name(), "label of rectangle");
    expect_str("inherited method sees the override", r.describe(), "a label of rectangle");
    d : rectangle = new deep_rectangle();
    expect_str("two levels", d.name(), "deep label of rectangle");
    l : labelled_rectangle = new deep_rectangle();
    expect_str("through the middle class", l.describe(), "a deep label of rectangle");
    plain := new rectangle();
    expect_str("the base object itself", plain.describe(), "a rectangle");
    finish("interfaces_base_calls");
}
