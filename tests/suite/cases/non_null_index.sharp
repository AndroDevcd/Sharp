mod main;

import ( testing )

/**
 * An index right after the non-null assertion: x!![i], also followed by a
 * member access and used as the target of an assignment.
 */
class item { weight : var = 3; name : string = "n"; }

class holder {
    numbers : var[]?;
    items : item[]?;
    def second() : var { return numbers!![1]; }
}

def maybe(a: var[]?) : var { return a!![0] + a!![1]; }

def main(args: string[]) {
    x := new holder();
    x.numbers = new var[] { 5, 6 };
    expect("index without !!", x.numbers[1], 6);
    expect("index after !!", x.numbers!![1], 6);
    expect("in an expression", x.numbers!![0] * 10 + x.numbers!![1], 56);
    expect("inside a method", x.second(), 6);
    expect("on a parameter", maybe(x.numbers), 11);

    x.items = new item[2];
    its : item[]? = x.items;
    its!![0] = new item();
    expect("member after the index", x.items!![0].weight, 3);
    expect_str("string member after the index", x.items!![0].name, "n");

    arr : var[]? = x.numbers;
    i : var = 1;
    expect("index is an expression", arr!![i - 1], 5);
    hit : var = 0;
    try { r : var = arr!![7]; } catch(e: exception) { hit = 1; }
    expect("out of bounds still throws", hit, 1);
    finish("non_null_index");
}
