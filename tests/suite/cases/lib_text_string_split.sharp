mod main;

import ( std.testing, std.text )

/**
 * std.text - the `string` class, part 3:
 *   - string_split.sharp    split, split_any, split_whitespace, lines, chunked, join
 *   - string_case.sharp     to_upper, capitalize, decapitalize, swap_case, title_case, is_upper / is_lower
 *   - string_compare.sharp  compare_to, equals_ignore_case, is_digits, is_letters, is_palindrome ...
 *
 * Arrays of strings are checked through show(): the number of parts, a colon,
 * and the parts with '|' between them, so empty parts and counts are visible.
 */

def show(parts: string[]): string {
    joined := string.join("|", parts);
    // (an empty string is not appended: the uncorrected std/string.sharp would add "null",
    //  see lib_text_string_fixes.sharp)
    if(joined.is_empty()) return string.of_int(sizeof(parts)) + ":";
    return string.of_int(sizeof(parts)) + ":" + joined;
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_string_split") {
        empty : string = "";
        hello : string = "hello";

        // ---- split
        csv : string = "a,b,c";
        test("split") { expect(show(csv.split(","))).should_be("3:a|b|c"); };
        test("split with a char literal") { expect(show(csv.split(','))).should_be("3:a|b|c"); };
        gaps : string = ",a,,b,";
        test("split keeps empty parts") { expect(show(gaps.split(","))).should_be("5:|a||b|"); };
        test("split, delimiter not found") { expect(show(csv.split(";"))).should_be("1:a,b,c"); };
        test("split of \"\"") { expect(show(empty.split(","))).should_be("1:"); };
        only : string = ",";
        test("split of just the delimiter") { expect(show(only.split(","))).should_be("2:|"); };
        arrows : string = "a->b->c";
        test("split by a longer delimiter") { expect(show(arrows.split("->"))).should_be("3:a|b|c"); };
        test("split by the whole string") { expect(show(csv.split("a,b,c"))).should_be("2:|"); };
        test("split with a limit") { expect(show(csv.split(",", 2))).should_be("2:a|b,c"); };
        test("split with limit 1") { expect(show(csv.split(",", 1))).should_be("1:a,b,c"); };
        test("split with limit 0 = no limit") { expect(show(csv.split(",", 0))).should_be("3:a|b|c"); };
        test("split with a limit larger than the parts") { expect(show(csv.split(",", 10))).should_be("3:a|b|c"); };
        test("split with a limit keeps empty parts") { expect(show(gaps.split(",", 3))).should_be("3:|a|,b,"); };
        try {
            csv.split("");
            test("split by \"\"") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("split by \"\"") { };
        }
        try {
            csv.split(",", 0 - 1);
            test("split with a negative limit") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("split with a negative limit") { };
        }
        many := hello.repeat(1000);
        test("split of a long string") { expect(sizeof(many.split("h"))).should_be(1001); };

        // ---- split_any, split_whitespace
        mixed : string = "a,b;c";
        test("split_any") { expect(show(mixed.split_any(",;"))).should_be("3:a|b|c"); };
        test("split_any with neighbours") { expect(show(gaps.split_any(","))).should_be("5:|a||b|"); };
        test("split_any, none found") { expect(show(mixed.split_any("#"))).should_be("1:a,b;c"); };
        test("split_any of \"\"") { expect(show(empty.split_any(","))).should_be("1:"); };
        words : string = "  to be\tor  not \n";
        test("split_whitespace") { expect(show(words.split_whitespace())).should_be("4:to|be|or|not"); };
        test("split_whitespace of one word") { expect(show(hello.split_whitespace())).should_be("1:hello"); };
        test("split_whitespace of \"\"") { expect(show(empty.split_whitespace())).should_be("0:"); };
        spaces : string = "   ";
        test("split_whitespace of spaces") { expect(show(spaces.split_whitespace())).should_be("0:"); };

        // ---- lines
        text : string = "a\nb\r\nc\rd";
        test("lines with all three line ends") { expect(show(text.lines())).should_be("4:a|b|c|d"); };
        trailing : string = "a\n";
        test("lines: a final line end gives a last empty line") { expect(show(trailing.lines())).should_be("2:a|"); };
        test("lines of \"\"") { expect(show(empty.lines())).should_be("1:"); };
        test("lines of a single line") { expect(show(hello.lines())).should_be("1:hello"); };
        blank_lines : string = "a\n\nb";
        test("lines keeps empty lines") { expect(show(blank_lines.lines())).should_be("3:a||b"); };
        crlf : string = "\r\n";
        test("lines: \\r\\n is one line end") { expect(show(crlf.lines())).should_be("2:|"); };

        // ---- chunked
        abcdefg : string = "abcdefg";
        test("chunked") { expect(show(abcdefg.chunked(3))).should_be("3:abc|def|g"); };
        test("chunked, exact fit") { expect(show(abcdefg.chunked(7))).should_be("1:abcdefg"); };
        test("chunked larger than the string") { expect(show(abcdefg.chunked(50))).should_be("1:abcdefg"); };
        test("chunked(1)") { expect(show(hello.chunked(1))).should_be("5:h|e|l|l|o"); };
        test("chunked of \"\"") { expect(show(empty.chunked(3))).should_be("0:"); };
        try {
            abcdefg.chunked(0);
            test("chunked(0)") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("chunked(0)") { };
        }

        // ---- join
        test("join") { expect(string.join(", ", new string[] { "a", "b", "c" })).should_be("a, b, c"); };
        test("join of one") { expect(string.join(", ", new string[] { "a" })).should_be("a"); };
        test("join of none") { expect(string.join(", ", new string[0])).should_be(""); };
        test("join with \"\"") { expect(string.join("", new string[] { "a", "b", "c" })).should_be("abc"); };
        test("join keeps empty parts") { expect(string.join("-", new string[] { "", "a", "", "" })).should_be("-a--"); };
        test("join undoes split") { expect(string.join(",", gaps.split(","))).should_be(",a,,b,"); };
        names := new list<string>();
        test("join_list of an empty list") { expect(string.join_list("+", names)).should_be(""); };
        names.add("x");
        names.add("y");
        test("join_list") { expect(string.join_list("+", names)).should_be("x+y"); };

        // ---- case
        mixed_case : string = "Hello World 42";
        test("to_upper") { expect(mixed_case.to_upper()).should_be("HELLO WORLD 42"); };
        test("to_lower") { expect(mixed_case.to_lower()).should_be("hello world 42"); };
        test("to_upper of \"\"") { expect(empty.to_upper()).should_be(""); };
        test("to_upper leaves the original alone") { expect(mixed_case).should_be("Hello World 42"); };
        symbols : string = "@[`{";
        test("to_upper leaves the neighbours of the letters alone") { expect(symbols.to_upper()).should_be("@[`{"); };
        test("capitalize") { expect(hello.capitalize()).should_be("Hello"); };
        test("capitalize of \"\"") { expect(empty.capitalize()).should_be(""); };
        digits_first : string = "1abc";
        test("capitalize of a non-letter") { expect(digits_first.capitalize()).should_be("1abc"); };
        test("decapitalize") { expect(mixed_case.decapitalize()).should_be("hello World 42"); };
        test("capitalize leaves the original alone") { expect(hello).should_be("hello"); };
        test("swap_case") { expect(mixed_case.swap_case()).should_be("hELLO wORLD 42"); };
        shouting : string = "the QUICK brown-fox";
        test("title_case") { expect(shouting.title_case()).should_be("The Quick Brown-Fox"); };
        test("title_case of \"\"") { expect(empty.title_case()).should_be(""); };
        upper : string = "ABC 12";
        test("is_upper") { expect_true(upper.is_upper()); };
        test("is_upper of mixed case") { expect_false(mixed_case.is_upper()); };
        test("is_upper of \"\"") { expect_false(empty.is_upper()); };
        numbers : string = "123";
        test("is_upper without letters") { expect_false(numbers.is_upper()); };
        test("is_lower") { expect_true(hello.is_lower()); };
        test("is_lower of capitals") { expect_false(upper.is_lower()); };
        test("is_lower without letters") { expect_false(numbers.is_lower()); };

        // ---- compare
        apple : string = "apple";
        apply : string = "apply";
        app : string = "app";
        zebra : string = "Zebra";
        test("compare_to, smaller") { expect(apple.compare_to(apply)).should_be(0 - 1); };
        test("compare_to, larger") { expect(apply.compare_to(apple)).should_be(1); };
        test("compare_to, equal") { expect(apple.compare_to("apple")).should_be(0); };
        test("compare_to: a prefix comes first") { expect(app.compare_to(apple)).should_be(0 - 1); };
        test("compare_to: the longer one comes last") { expect(apple.compare_to(app)).should_be(1); };
        test("compare_to with \"\"") { expect(empty.compare_to(apple)).should_be(0 - 1); };
        test("compare_to of two \"\"") { expect(empty.compare_to("")).should_be(0); };
        test("compare_to: capitals come first") { expect(zebra.compare_to(apple)).should_be(0 - 1); };
        test("compare_to_ignore_case") { expect(zebra.compare_to_ignore_case(apple)).should_be(1); };
        test("compare_to_ignore_case, equal") { expect(zebra.compare_to_ignore_case("zEBRA")).should_be(0); };
        test("equals_ignore_case") { expect_true(zebra.equals_ignore_case("ZEBRA")); };
        test("equals_ignore_case, different length") { expect_false(zebra.equals_ignore_case("zebras")); };
        test("equals_ignore_case, different text") { expect_false(zebra.equals_ignore_case("zebrx")); };
        test("equals_ignore_case of two \"\"") { expect_true(empty.equals_ignore_case("")); };

        // ---- what a string is made of
        test("is_digits") { expect_true(numbers.is_digits()); };
        signed : string = "-12";
        test("is_digits with a sign") { expect_false(signed.is_digits()); };
        test("is_digits of \"\"") { expect_false(empty.is_digits()); };
        test("is_letters") { expect_true(hello.is_letters()); };
        test("is_letters with a space") { expect_false(mixed_case.is_letters()); };
        test("is_letters of \"\"") { expect_false(empty.is_letters()); };
        abc1 : string = "abc1";
        test("is_letters_or_digits") { expect_true(abc1.is_letters_or_digits()); };
        test("is_letters_or_digits with punctuation") { expect_false(shouting.is_letters_or_digits()); };
        test("is_ascii") { expect_true(mixed_case.is_ascii()); };
        test("is_ascii of \"\"") { expect_true(empty.is_ascii()); };
        level : string = "level";
        test("is_palindrome") { expect_true(level.is_palindrome()); };
        test("is_palindrome, not one") { expect_false(hello.is_palindrome()); };
        test("is_palindrome of \"\"") { expect_true(empty.is_palindrome()); };
        abba : string = "Abba";
        test("is_palindrome is case sensitive") { expect_false(abba.is_palindrome()); };
    };
    finish_tests();
}
