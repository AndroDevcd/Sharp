mod main;

import ( std.testing, std.io, std.net, std.data, std.compress )

/**
 * std.net: the HTTP client (http, http_client, http_service, fake_http, url,
 * http_headers) against a small HTTP server inside this program - a thread
 * with a tcp_server on this machine's own address, any free port.
 *
 * Nothing leaves the machine. (https is the same client over a tls_socket;
 * it needs a server with a certificate, so it is checked by hand:
 * build/lib/http_try.sharp.)
 */

class shared {
    static server : tcp_server?;
    static connections : decimal = 0;
    static problem : string = "";
}

/** one request as the server read it */
class asked {
    method : string = "";
    target : string = "";
    headers : http_headers = new http_headers();
    body : string = "";
}

def read_request(guest: tcp_socket) : asked? {
    first := guest.read_line();
    if(first == null) { return null; }
    made := new asked();
    words := io_strings.split(first!!, ' ');
    if(words.size() < 2) { return null; }
    made.method = words.at(0);
    made.target = words.at(1);
    while(true) {
        line := guest.read_line();
        if(line == null || sizeof(line!!.data) == 0) { break; }
        colon : _int64 = io_strings.index_of(line!!, ':') as _int64;
        made.headers.add(io_strings.slice(line!!, 0, colon), io_strings.trim(io_strings.slice_from(line!!, colon + 1)));
    }
    length : _int64 = io_strings.parse_int(made.headers.find_or("Content-Length", "0")) as _int64;
    if(length > 0) {
        bytes := guest.read_exactly(length);
        made.body = new string(bytes, 0, length);
    }
    return made;
}

def answer(guest: tcp_socket, status: string, type: string, body: string) {
    guest.write_text("HTTP/1.1 " + status + "\r\nContent-Type: " + type + "\r\nContent-Length: " + sizeof(body.data) + "\r\n\r\n" + body);
}

/** the request back as json: what the client really sent */
def echo(request: asked) : string {
    made := json_value.new_object();
    made.put_string("method", request.method);
    made.put_string("target", request.target);
    made.put_string("body", request.body);
    headers := json_value.new_object();
    for(i : _int64 = 0; i < request.headers.size(); i++) {
        headers.put_string(io_strings.to_lower(request.headers.name_at(i)), request.headers.value_at(i));
    }
    made.put("headers", headers);
    return made.to_string()!!;
}

def serve(args: object[]) : decimal {
    try {
        stop : bool = false;
        while(!stop) {
            guest := shared.server!!.accept();
            shared.connections++;
            try {
                while(true) {
                    request := read_request(guest);
                    if(request == null) { break; }
                    target : string = request!!.target;
                    mark : _int64 = io_strings.index_of(target, '?') as _int64;
                    route : string = target;
                    if(mark >= 0) { route = io_strings.slice(target, 0, mark); }

                    if(request!!.method == "HEAD") { guest.write_text("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\n"); }
                    else if(route == "/hello") { answer(guest, "200 OK", "text/plain", "hello"); }
                    else if(route == "/echo") { answer(guest, "200 OK", "application/json", echo(request!!)); }
                    else if(route == "/chunked") {
                        guest.write_text("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n4;x=1\r\ndefg\r\n1\r\nh\r\n0\r\nTrailer: t\r\n\r\n");
                    }
                    else if(route == "/redirect") { guest.write_text("HTTP/1.1 302 Found\r\nLocation: /hello\r\nContent-Length: 0\r\n\r\n"); }
                    else if(route == "/see-other") { guest.write_text("HTTP/1.1 303 See Other\r\nLocation: /echo?after=303\r\nContent-Length: 0\r\n\r\n"); }
                    else if(route == "/keep-method") { guest.write_text("HTTP/1.1 307 Temporary Redirect\r\nLocation: /echo?after=307\r\nContent-Length: 0\r\n\r\n"); }
                    else if(route == "/loop") { guest.write_text("HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\n\r\n"); }
                    else if(route == "/continue") {
                        guest.write_text("HTTP/1.1 100 Continue\r\n\r\n");
                        answer(guest, "200 OK", "text/plain", "after 100");
                    }
                    else if(route == "/until-close") {
                        guest.write_text("HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nclosing");
                        break;
                    }
                    else if(route == "/stale") {
                        // says the connection stays, and closes it: the client's next request finds it dead
                        answer(guest, "200 OK", "text/plain", "stale");
                        break;
                    }
                    else if(route == "/slow") {
                        thread.sleep(700);
                        answer(guest, "200 OK", "text/plain", "late");
                    }
                    else if(route == "/packed") {
                        packed := gzip.compress_text("a body that travelled compressed, a body that travelled compressed");
                        guest.write_text("HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: " + sizeof(packed) + "\r\n\r\n");
                        guest.write(packed);
                    }
                    else if(route == "/packed-wrong") {
                        guest.write_text("HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 12\r\n\r\nnot gzip at ");
                    }
                    else if(route == "/empty") { guest.write_text("HTTP/1.1 204 No Content\r\n\r\n"); }
                    else if(route == "/busy") { answer(guest, "503 Service Unavailable", "text/plain", "busy"); }
                    else if(route == "/user/7") { answer(guest, "200 OK", "application/json", "{\"id\":7,\"name\":\"ann\",\"isAdmin\":true,\"tags\":[\"a\",\"b\"]}"); }
                    else if(route == "/users") { answer(guest, "200 OK", "application/json", "[{\"id\":1,\"name\":\"x\"},{\"id\":2,\"name\":\"y\"}]"); }
                    else if(route == "/garbage") { guest.write_text("this is not http\r\n\r\n"); break; }
                    else if(route == "/stop") { answer(guest, "200 OK", "text/plain", "bye"); stop = true; break; }
                    else { answer(guest, "404 Not Found", "application/json", "{\"error\":\"no such route\"}"); }
                }
            } catch(gone: socket_exception) {
                // (the client gave up on this connection: on to the next)
            }
            guest.close();
        }
    } catch(problem: throwable) {
        shared.problem = problem.get_message();
    }
    shared.server!!.close();
    return 0;
}

class person {
    id : _int64 = 0;
    name : string = "";
    is_admin : bool = false;
    tags : list<string> = new list<string>();
}

class echoed {
    method : string = "";
    target : string = "";
    body : string = "";
    headers : json_value?;
}

class people base http_service {
    token : string = "";
    seen : decimal = 0;

    people(port: _int64) {
        base_url("http://127.0.0.1:" + port + "/");
        header("X-App", "suite");
        before { if(sizeof(token.data) > 0) { it.bearer(token); } };
        after { seen++; };
    }

    def one(id: _int64) : person { return GET<person>("/user/{id}") { path("id", id); }; }
    def all() : list<person> { return GET<list<person> >("/users"); }
    def find(id: _int64) : person? { return GET_or_null<person>("/user/{id}") { path("id", id); }; }
    def save(who: person) : echoed { return POST<echoed>("/echo") { send(who); query("notify", true); }; }
    def hello() : string { return GET("/hello").text(); }
    def busy() { GET("/busy"); }
    def missing() { GET("/nothing-here"); }
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_net_http") {
        // ---------------------------------------------------------------- url
        where := url.parse("HTTPS://Api.Shop.Example:8443/v2/products?q=lamp#top");
        test("url: scheme") { expect(where.scheme).should_be("https"); };
        test("url: host") { expect(where.host).should_be("api.shop.example"); };
        test("url: port") { expect(where.port).should_be(8443); };
        test("url: path") { expect(where.path).should_be("/v2/products"); };
        test("url: query") { expect(where.query).should_be("q=lamp"); };
        test("url: target") { expect(where.target()).should_be("/v2/products?q=lamp"); };
        test("url: origin") { expect(where.origin()).should_be("https://api.shop.example:8443"); };
        plain := url.parse("http://example.com");
        test("url: the usual port of http") { expect(plain.port).should_be(80); };
        test("url: no path is /") { expect(plain.path).should_be("/"); };
        test("url: the usual port is not written") { expect(plain.to_string()!!).should_be("http://example.com/"); };
        test("url: the usual port of https") { expect(url.parse("https://example.com/x").port).should_be(443); };
        test("url: user and password are not the host") { expect(url.parse("http://me:pw@host.example/").host).should_be("host.example"); };
        test("url: resolve a path") { expect(where.resolve("/login").to_string()!!).should_be("https://api.shop.example:8443/login"); };
        test("url: resolve beside") { expect(where.resolve("next?page=2").to_string()!!).should_be("https://api.shop.example:8443/v2/next?page=2"); };
        test("url: resolve a link with an address in its query") {
            expect(where.resolve("next?to=http://other.example/x").to_string()!!).should_be("https://api.shop.example:8443/v2/next?to=http://other.example/x");
        };
        test("url: resolve a whole address") { expect(where.resolve("http://other.example/x").to_string()!!).should_be("http://other.example/x"); };
        test("url: resolve a query") { expect(where.resolve("?page=3").to_string()!!).should_be("https://api.shop.example:8443/v2/products?page=3"); };
        test("url: resolve a whole address") { expect(where.resolve("http://other.example/a").to_string()!!).should_be("http://other.example/a"); };
        test("url: resolve another host") { expect(where.resolve("//cdn.example/x.js").to_string()!!).should_be("https://cdn.example/x.js"); };
        refused : decimal = 0;
        try { url.parse("ftp://example.com/"); } catch(wrong: illegal_argument_exception) { refused++; }
        try { url.parse("example.com/x"); } catch(wrong: illegal_argument_exception) { refused++; }
        try { url.parse("http:///x"); } catch(wrong: illegal_argument_exception) { refused++; }
        try { url.parse("http://host:99999/"); } catch(wrong: illegal_argument_exception) { refused++; }
        test("url: what is not a web address") { expect(refused).should_be(4); };

        // ---------------------------------------------------------------- headers
        headers := new http_headers();
        headers.put("Accept", "a/b");
        headers.put("accept", "c/d");
        headers.add("Set-Cookie", "x=1");
        headers.add("Set-Cookie", "y=2");
        test("headers: put replaces, whatever the capitals") { expect(headers.find("ACCEPT")!!).should_be("c/d"); };
        test("headers: size") { expect(headers.size()).should_be(3); };
        test("headers: all") { expect(headers.all("set-cookie").size()).should_be(2); };
        test("headers: find gives the first") { expect(headers.find("Set-Cookie")!!).should_be("x=1"); };
        test("headers: missing") { expect_null(headers.find("Nope")); };
        headers.remove("SET-COOKIE");
        test("headers: remove") { expect(headers.size()).should_be(1); };

        // ---------------------------------------------------------------- a request put together
        built := new http_request("GET", "http://h.example/users/{name}/files/{file}?v=1");
        built.path("name", "ann b").path("file", "a/b.txt").query("q", "x&y").query("n", 5).query("skip", null).query("on", true);
        test("request: the address") { expect(built.resolved_address()).should_be("http://h.example/users/ann%20b/files/a%2Fb.txt?v=1&q=x%26y&n=5&on=true"); };
        unfilled : decimal = 0;
        try { new http_request("GET", "http://h.example/{id}").resolved_address(); } catch(wrong: illegal_argument_exception) { unfilled++; }
        try { new http_request("GET", "http://h.example/x").path("id", 1).resolved_address(); } catch(wrong: illegal_argument_exception) { unfilled++; }
        test("request: a {name} without a value, a value without a {name}") { expect(unfilled).should_be(2); };
        with_json := new http_request("POST", "http://h.example/");
        with_json.json("a", "text").json("b", 2).json("c", true);
        body := with_json.resolved_body();
        test("request: a json body") { expect(new string(body!!, 0, sizeof(body))).should_be("{\"a\":\"text\",\"b\":2,\"c\":true}"); };
        test("request: its Content-Type") { expect(with_json.headers.find("Content-Type")!!).should_be("application/json"); };
        with_form := new http_request("POST", "http://h.example/").form("email", "me@x.org").form("n", 5).form("t", "a b");
        body = with_form.resolved_body();
        test("request: a form body") { expect(new string(body!!, 0, sizeof(body))).should_be("email=me%40x.org&n=5&t=a+b"); };
        with_parts := new http_request("POST", "http://h.example/").part("caption", "front");
        body = with_parts.resolved_body();
        parts_text := new string(body!!, 0, sizeof(body));
        test("request: a form in parts") { expect_true(io_strings.contains(parts_text, "Content-Disposition: form-data; name=\"caption\"\r\n\r\nfront\r\n--sharp-")); };
        test("request: its boundary is in the Content-Type") { expect_true(io_strings.starts_with(with_parts.headers.find("Content-Type")!!, "multipart/form-data; boundary=sharp-")); };
        test("request: basic") { expect(new http_request("GET", "http://h/").basic("Aladdin", "open sesame").headers.find("Authorization")!!).should_be("Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="); };

        // ---------------------------------------------------------------- the server
        server := new tcp_server(0, true);
        shared.server = server;
        port : _int64 = server.port();
        root : string = "http://127.0.0.1:" + port;
        worker := new thread("http server", serve);
        worker.start();

        // ---------------------------------------------------------------- plain requests
        hello := http.GET(root + "/hello");
        test("GET: status") { expect(hello.status).should_be(200); };
        test("GET: reason") { expect(hello.reason).should_be("OK"); };
        test("GET: ok") { expect_true(hello.ok()); };
        test("GET: text") { expect(hello.text()).should_be("hello"); };
        test("GET: a header") { expect(hello.header("content-type")!!).should_be("text/plain"); };
        test("GET: the address that answered") { expect(hello.address).should_be(root + "/hello"); };
        again := http.GET(root + "/hello");
        test("the second request uses the connection of the first") { expect(shared.connections).should_be(1); };

        sent := http.POST(root + "/echo") {
            it.query("page", 2);
            it.header("X-Trace", "abc");
            it.json("hello", "world");
        }.json();
        test("POST: the method") { expect(sent.string_or("method", "")).should_be("POST"); };
        test("POST: the query") { expect(sent.string_or("target", "")).should_be("/echo?page=2"); };
        test("POST: the body") { expect(sent.string_or("body", "")).should_be("{\"hello\":\"world\"}"); };
        test("POST: a header of the request") { expect(sent.member("headers").string_or("x-trace", "")).should_be("abc"); };
        test("POST: Content-Type") { expect(sent.member("headers").string_or("content-type", "")).should_be("application/json"); };
        test("POST: Content-Length") { expect(sent.member("headers").string_or("content-length", "")).should_be("17"); };
        test("POST: Host") { expect(sent.member("headers").string_or("host", "")).should_be("127.0.0.1:" + port); };
        test("PUT") { expect(http.PUT(root + "/echo") { it.body("x"); }.json().string_or("method", "")).should_be("PUT"); };
        test("PATCH") { expect(http.PATCH(root + "/echo").json().string_or("method", "")).should_be("PATCH"); };
        test("DELETE") { expect(http.DELETE(root + "/echo").json().string_or("method", "")).should_be("DELETE"); };
        test("a POST without a body says its length is 0") { expect(http.POST(root + "/echo").json().member("headers").string_or("content-length", "?")).should_be("0"); };
        head := http.HEAD(root + "/hello");
        test("HEAD has no body") { expect(sizeof(head.bytes())).should_be(0); };
        test("HEAD has the headers (the length the body would have)") { expect(head.header("Content-Length")!!).should_be("5"); };

        test("a body in pieces") { expect(http.GET(root + "/chunked").text()).should_be("abcdefgh"); };
        packed := http.GET(root + "/packed");
        test("a compressed body is unpacked") { expect(packed.text()).should_be("a body that travelled compressed, a body that travelled compressed"); };
        test("... and no longer said to be compressed") { expect_null(packed.header("Content-Encoding")); };
        cannot_unpack : decimal = 0;
        try { http.GET(root + "/packed-wrong"); } catch(wrong: http_exception) { if(io_strings.contains(wrong.get_message(), "unpacked")) { cannot_unpack = 1; } }
        test("a body that is not what its header says") { expect_true(cannot_unpack); };
        test("the client says it reads gzip") { expect(http.GET(root + "/echo").json().member("headers").string_or("accept-encoding", "")).should_be("gzip"); };
        test("204 has no body") { expect(http.GET(root + "/empty").status).should_be(204); };
        test("100 Continue is passed over") { expect(http.GET(root + "/continue").text()).should_be("after 100"); };
        test("a body that ends when the server closes") { expect(http.GET(root + "/until-close").text()).should_be("closing"); };
        missing := http.GET(root + "/nothing-here");
        test("404 is an answer") { expect(missing.status).should_be(404); };
        test("404: not ok") { expect_false(missing.ok()); };
        test("404: its body") { expect(missing.json().string_or("error", "")).should_be("no such route"); };
        thrown : decimal = 0;
        try { missing.require_ok(); } catch(failed: http_status_exception) { if(failed.status == 404 && io_strings.contains(failed.body_text(), "no such route")) { thrown = 1; } }
        test("require_ok throws for 404") { expect_true(thrown); };

        // ---------------------------------------------------------------- redirects
        moved := http.GET(root + "/redirect");
        test("a redirect is followed") { expect(moved.text()).should_be("hello"); };
        test("... and the answer says where it came from") { expect(moved.address).should_be(root + "/hello"); };
        test("a redirect can be handed back") { expect(http.GET(root + "/redirect") { it.follow_redirects(false); }.status).should_be(302); };
        other := http.POST(root + "/see-other") { it.body("data"); }.json();
        test("303: goes on as a GET") { expect(other.string_or("method", "")).should_be("GET"); };
        test("303: without the body") { expect(other.string_or("body", "?")).should_be(""); };
        kept := http.POST(root + "/keep-method") { it.body("data"); }.json();
        test("307: the method stays") { expect(kept.string_or("method", "")).should_be("POST"); };
        test("307: the body stays") { expect(kept.string_or("body", "")).should_be("data"); };
        looped : decimal = 0;
        try { http.GET(root + "/loop"); } catch(lost: http_exception) { if(io_strings.contains(lost.get_message(), "redirects")) { looped = 1; } }
        test("redirects without end are given up") { expect_true(looped); };

        // ---------------------------------------------------------------- what goes wrong
        http.GET(root + "/stale");
        test("a kept connection the server closed: the request is sent anew") { expect(http.GET(root + "/hello").text()).should_be("hello"); };
        late : decimal = 0;
        try { http.GET(root + "/slow") { it.timeout(150); }; } catch(silent: http_timeout) { late = 1; }
        test("a server that is silent too long") { expect_true(late); };
        test("the client works after a timeout") { expect(http.GET(root + "/hello").text()).should_be("hello"); };
        not_http : decimal = 0;
        try { http.GET(root + "/garbage"); } catch(wrong: http_exception) { if(io_strings.contains(wrong.get_message(), "not HTTP")) { not_http = 1; } }
        test("an answer that is not HTTP") { expect_true(not_http); };
        nobody : decimal = 0;
        try {
            spare := new tcp_server(0, true);
            free_port : _int64 = spare.port();
            spare.close();
            http.GET("http://127.0.0.1:" + free_port + "/");
        } catch(refused_there: http_exception) { nobody = 1; }
        test("nobody listens there") { expect_true(nobody); };
        unknown : decimal = 0;
        try { http.GET("http://no-such-host.invalid/"); } catch(lost: http_exception) { unknown = 1; }
        test("a host nobody knows") { expect_true(unknown); };

        // ---------------------------------------------------------------- a service
        staff := new people(port);
        ann := staff.one(7);
        test("service: a typed answer") { expect(ann.name).should_be("ann"); };
        test("service: a number") { expect(ann.id).should_be(7); };
        test("service: isAdmin fills is_admin") { expect_true(ann.is_admin); };
        test("service: a list inside") { expect(ann.tags.size()).should_be(2); };
        everyone := staff.all();
        test("service: a list of objects") { expect(everyone.size()).should_be(2); };
        test("service: its second") { expect(everyone.at(1).name).should_be("y"); };
        test("service: or_null, there") { expect(staff.find(7)!!.name).should_be("ann"); };
        test("service: or_null, 404") { expect_null(staff.find(8)); };
        test("service: the response itself") { expect(staff.hello()).should_be("hello"); };
        staff.token = "t0ken";
        stored := staff.save(ann);
        test("service: send(object) is json") { expect(stored.body).should_be("{\"id\":7,\"name\":\"ann\",\"is_admin\":true,\"tags\":[\"a\",\"b\"]}"); };
        test("service: a query in the block") { expect(stored.target).should_be("/echo?notify=true"); };
        test("service: the service's header") { expect(stored.headers!!.string_or("x-app", "")).should_be("suite"); };
        test("service: the before hook") { expect(stored.headers!!.string_or("authorization", "")).should_be("Bearer t0ken"); };
        seen_before : decimal = staff.seen;
        failed_status : decimal = 0;
        try { staff.missing(); } catch(failed: http_status_exception) { failed_status = failed.status; }
        test("service: a status that is not 2xx throws") { expect(failed_status).should_be(404); };
        test("service: the after hook saw it") { expect(staff.seen).should_be(seen_before + 1); };
        staff.retry(2, 10);
        busy_status : decimal = 0;
        seen_before = staff.seen;
        try { staff.busy(); } catch(failed: http_status_exception) { busy_status = failed.status; }
        test("service: 503 after the retries") { expect(busy_status).should_be(503); };
        outside : decimal = 0;
        try { staff.path("id", 1); } catch(wrong: illegal_state_exception) { outside = 1; }
        test("service: a word of the block outside a block") { expect_true(outside); };

        // ---------------------------------------------------------------- a fake server
        fake := new fake_http();
        fake.answer("GET", "/user/7", 200, "{\"id\":70,\"name\":\"fake ann\"}");
        fake.answer("POST", "/echo", 500, "{\"error\":\"down\"}");
        staff.use(fake);
        test("fake: answers by its rules") { expect(staff.one(7).name).should_be("fake ann"); };
        test("fake: remembers what was asked") { expect(fake.last().resolved_address()).should_be(root + "/user/7"); };
        test("fake: ... and what it carried") { expect(fake.last().headers.find("Authorization")!!).should_be("Bearer t0ken"); };
        test("fake: no rule is 404") { expect_null(staff.find(9)); };
        fake_failed : decimal = 0;
        try { staff.save(ann); } catch(failed: http_status_exception) { fake_failed = failed.status; }
        test("fake: a failing answer") { expect(fake_failed).should_be(500); };
        test("fake: the count of requests") { expect(fake.asked.size()).should_be(3); };

        // ---------------------------------------------------------------- the server is told to end
        http.GET(root + "/stop");
        worker.join();
        test("the server had no problem") { expect(shared.problem).should_be(""); };
    };
    finish_tests("lib_net_http");
}
