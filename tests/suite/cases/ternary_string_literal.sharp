mod main;
import ( testing )
def main(args: string[]) {
    name : string = "bob";
    flag : decimal = 1;
    a : string = flag ? "literal" : name;
    b : string = flag ? name : "literal";
    expect_str("literal ? string", a, "literal");
    expect_str("string ? literal", b, "bob");
    finish("ternary_string_literal");
}
