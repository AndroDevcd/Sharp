mod main;

import ( std.testing, std.io )

/**
 * std.io file: create, write, read, the questions (exists, is_file,
 * is_directory, length ...), rename, delete, and listing a directory.
 *
 * Everything happens inside one folder made for this test,
 *     /tmp/sharp_suite_std_files
 * which is removed again at the end (and at the start, in case an earlier run
 * was stopped half way). On windows the folder is sharp_suite_std_files in
 * the directory for temporary files.
 *
 * mkdir, write, rename and delete return 0 when it worked; create returns
 * true when it made the file. list() gives the NAMES of the files and folders
 * in a directory, sorted by character code.
 */

/** is this windows? (its paths are written with back slashes) */
def on_windows(): bool {
    return file.separator_char() != '/';
}

/** `path`, written with slashes here, the way this system writes it */
def os(path: string): string {
    return io_strings.replace_char(path, '/', file.separator_char());
}

/** the folder this test works in: below /tmp, or on windows below the directory for temporary files */
def suite_dir(name: string): string {
    return on_windows() ? os(temp_files.directory() + "/" + name) : "/tmp/" + name;
}

FOLDER : string = suite_dir("sharp_suite_std_files");

/** how many entries of `names` are exactly `name` */
def count_named(names: list<string>, name: string): decimal {
    found : decimal = 0;
    foreach(entry in names) {
        if(entry == name) found++;
    }
    return found;
}

def main(args: string[]) {
    show_only_failures();
    tests("std_files") {
        new file(FOLDER).delete_recursively();

        // ================= a folder
        folder := new file(FOLDER);
        test("the folder does not exist yet") { expect_false(folder.exists()); };
        test("something that does not exist is not a directory") { expect_false(folder.is_directory()); };
        test("something that does not exist is not a file") { expect_false(folder.is_file()); };

        test("mkdir returns 0") { expect(folder.mkdir().value).should_be(0); };
        test("the folder exists after mkdir") { expect_true(folder.exists()); };
        test("it is a directory") { expect_true(folder.is_directory()); };
        test("it is not a file") { expect_false(folder.is_file()); };
        test("a new folder lists no entries") { expect(folder.list().size().value).should_be(0); };
        test("mkdir of a folder that exists does not return 0") { expect_true(folder.mkdir().value != 0); };

        // ================= a new file
        notes := new file(FOLDER + "/notes.txt");
        test("the file does not exist before create()") { expect_false(notes.exists()); };
        test("create() returns true when it made the file") { expect_true(notes.create()); };
        test("it exists after create()") { expect_true(notes.exists()); };
        test("it is a file") { expect_true(notes.is_file()); };
        test("it is not a directory") { expect_false(notes.is_directory()); };
        test("a new file has length 0") { expect(notes.length().value).should_be(0); };
        test("a new file is_empty()") { expect_true(notes.is_empty()); };
        test("a new file is readable") { expect_true(notes.is_readable()); };
        test("a new file is writeable") { expect_true(notes.is_writeable()); };
        test("a file whose name does not start with a dot is not hidden") { expect_false(notes.is_hidden()); };
        test("read() of an empty file gives null") { expect_null(notes.read()); };

        // ---- names and paths
        test("get_name(): the last part of the path") { expect(notes.get_name()!!).should_be("notes.txt"); };
        test("get_path(): the path it was made with") { expect(notes.get_path()).should_be(os(FOLDER + "/notes.txt")); };
        test("get_absolute_path()") { expect(notes.get_absolute_path()).should_be(os(FOLDER + "/notes.txt")); };
        test("to_string() is the path") { expect(notes.to_string()!!).should_be(os(FOLDER + "/notes.txt")); };
        test("get_parent_file(): the folder") { expect(notes.get_parent_file()!!.get_path()).should_be(os(FOLDER)); };
        test("get_name() of the folder") { expect(folder.get_name()!!).should_be("sharp_suite_std_files"); };

        // ================= write and read back
        test("write returns 0") { expect(notes.write("hello file").value).should_be(0); };
        test("length after writing 10 characters") { expect(notes.length().value).should_be(10); };
        test("not empty any more") { expect_false(notes.is_empty()); };
        test("read gives back what was written") { expect(notes.read()!!).should_be("hello file"); };
        test("reading twice gives the same") { expect(notes.read()!!).should_be("hello file"); };

        // ---- writing again replaces the content (it does not append)
        notes.write("second");
        test("a second write replaces the content") { expect(notes.read()!!).should_be("second"); };
        test("...and the length is the new length") { expect(notes.length().value).should_be(6); };

        // ---- several lines
        notes.write("line one\nline two\n");
        test("length of two lines with their line ends") { expect(notes.length().value).should_be(18); };
        test("two lines read back") { expect(notes.read()!!).should_be("line one\nline two\n"); };

        // ---- a longer text: 1000 times "0123456789"
        chunk : string = "0123456789";
        long_text : string = "";
        for(i : decimal = 0; i < 1000; i++) {
            long_text = long_text + chunk;
        }
        notes.write(long_text);
        test("length of a 10000 character file") { expect(notes.length().value).should_be(10000); };
        read_back := notes.read()!!;
        test("10000 characters read back") { expect(read_back.size().value).should_be(10000); };
        test("...and they are the same characters") { expect_true((read_back == long_text)); };
        test("character 9999 of what was read") { expect(read_back.at(9999).value).should_be('9'); };

        // ---- text built at run time, with punctuation
        amount : int = 42;
        notes.write("total = " + amount + "; done.");
        test("text built at run time") { expect(notes.read()!!).should_be("total = 42; done."); };

        // ---- a second file object for the same path sees the same file
        same_file := new file(FOLDER + "/notes.txt");
        test("another object for the same path: exists") { expect_true(same_file.exists()); };
        test("another object for the same path: content") { expect(same_file.read()!!).should_be("total = 42; done."); };
        same_file.write("written through the other object");
        test("written through one object, read through the other") { expect(notes.read()!!).should_be("written through the other object"); };

        // ---- create() on a file that exists leaves it alone
        test("create() returns false when the file is already there") { expect_false(notes.create()); };
        test("...and the content is kept") { expect(notes.read()!!).should_be("written through the other object"); };

        // ================= a file that does not exist
        ghost := new file(FOLDER + "/ghost.txt");
        test("exists() is false") { expect_false(ghost.exists()); };
        test("is_file() is false") { expect_false(ghost.is_file()); };
        test("is_hidden() is false") { expect_false(ghost.is_hidden()); };
        test("read() gives null") { expect_null(ghost.read()); };
        test("delete() does not return 0") { expect_true(ghost.delete().value != 0); };
        test("asking about it did not create it") { expect_false(ghost.exists()); };

        // ---- write() makes the file when it is not there
        test("write to a file that was never created returns 0") { expect(ghost.write("now I exist").value).should_be(0); };
        test("...and the file is there") { expect_true(ghost.exists()); };
        test("...with the text") { expect(ghost.read()!!).should_be("now I exist"); };
        test("delete of it") { expect(ghost.delete().value).should_be(0); };

        // ---- a file in a folder that does not exist cannot be made
        lost := new file(FOLDER + "/no_such_folder/lost.txt");
        test("create() in a missing folder returns false") { expect_false(lost.create()); };
        test("...and nothing exists") { expect_false(lost.exists()); };

        // ---- an empty path is refused
        threw : decimal = 0;
        try {
            nameless := new file("");
        } catch(e: nullptr_exception) {
            threw = 1;
        }
        test("new file(\"\") throws nullptr_exception") { expect(threw).should_be(1); };

        // ================= listing the folder
        data := new file(FOLDER + "/data.bin");
        data.create();
        data.write("abc");
        hidden := new file(FOLDER + "/.hidden");
        hidden.create();
        // (on windows a file is hidden when it is marked so, whatever its name)
        test("a name that starts with a dot is hidden") { expect(hidden.is_hidden()).should_be(!on_windows()); };

        names := folder.list();
        test("three entries in the folder") { expect(names.size().value).should_be(3); };
        test("list has notes.txt (the name, not the path)") { expect(count_named(names, "notes.txt")).should_be(1); };
        test("list has data.bin") { expect(count_named(names, "data.bin")).should_be(1); };
        test("list has .hidden") { expect(count_named(names, ".hidden")).should_be(1); };
        test("list does not have a file that was deleted") { expect(count_named(names, "ghost.txt")).should_be(0); };
        test("the list is sorted: first") { expect(names.at(0)).should_be(".hidden"); };
        test("the list is sorted: second") { expect(names.at(1)).should_be("data.bin"); };
        test("the list is sorted: third") { expect(names.at(2)).should_be("notes.txt"); };

        // ---- list() of something that is not a directory throws
        threw = 0;
        try {
            notes.list();
        } catch(e: io_exception) {
            threw = 1;
        }
        test("list() of a plain file throws io_exception") { expect(threw).should_be(1); };

        // ---- a folder inside the folder
        inner := new file(FOLDER + "/inner");
        test("mkdir of a folder in the folder") { expect(inner.mkdir().value).should_be(0); };
        test("the inner folder is a directory") { expect_true(inner.is_directory()); };
        deep := new file(FOLDER + "/inner/deep.txt");
        deep.create();
        deep.write("deep");
        test("a file in the inner folder") { expect(deep.read()!!).should_be("deep"); };
        test("its parent is the inner folder") { expect(deep.get_parent_file()!!.get_name()!!).should_be("inner"); };
        test("the inner folder lists one entry") { expect(inner.list().size().value).should_be(1); };
        test("...by its name") { expect(inner.list().at(0)).should_be("deep.txt"); };
        test("the outer folder now lists four entries") { expect(folder.list().size().value).should_be(4); };
        test("...one of them the inner folder") { expect(count_named(folder.list(), "inner")).should_be(1); };
        test("...and not the file inside it") { expect(count_named(folder.list(), "deep.txt")).should_be(0); };

        // ---- a folder that is not empty cannot be deleted
        test("delete of a folder with a file in it does not return 0") { expect_true(inner.delete().value != 0); };
        test("...the folder is still there") { expect_true(inner.exists()); };
        test("...and so is the file") { expect_true(deep.exists()); };

        // ================= rename
        renamed := new file(FOLDER + "/renamed.txt");
        test("rename returns 0") { expect(notes.rename(renamed).value).should_be(0); };
        test("the new name exists") { expect_true(renamed.exists()); };
        test("the old name is gone") { expect_false(new file(FOLDER + "/notes.txt").exists()); };
        test("the content moved with the file") { expect(renamed.read()!!).should_be("written through the other object"); };
        test("the file object that was renamed now has the new path") { expect(notes.get_path()).should_be(os(FOLDER + "/renamed.txt")); };
        test("...and reads the same file") { expect(notes.read()!!).should_be("written through the other object"); };
        test("still four entries after the rename") { expect(folder.list().size().value).should_be(4); };
        test("the list has the new name") { expect(count_named(folder.list(), "renamed.txt")).should_be(1); };
        test("the list does not have the old name") { expect(count_named(folder.list(), "notes.txt")).should_be(0); };

        // ---- rename into another folder moves the file
        moved := new file(FOLDER + "/inner/moved.bin");
        test("rename into the inner folder") { expect(data.rename(moved).value).should_be(0); };
        test("it is in the inner folder now") { expect_true(moved.exists()); };
        test("with its content") { expect(moved.read()!!).should_be("abc"); };
        test("the inner folder lists two entries") { expect(inner.list().size().value).should_be(2); };
        test("the outer folder lists three") { expect(folder.list().size().value).should_be(3); };

        // ================= delete
        test("delete of a file returns 0") { expect(hidden.delete().value).should_be(0); };
        test("a deleted file does not exist") { expect_false(hidden.exists()); };
        test("two entries left in the outer folder") { expect(folder.list().size().value).should_be(2); };
        test("delete of the renamed file") { expect(renamed.delete().value).should_be(0); };
        test("it is gone") { expect_false(renamed.exists()); };

        // a deleted file can be created again, empty
        test("created again after delete") { expect_true(renamed.create()); };
        test("...and empty") { expect(renamed.length().value).should_be(0); };
        renamed.delete();

        // ================= clean up: files first, then the folders
        test("delete deep.txt") { expect(deep.delete().value).should_be(0); };
        test("delete moved.bin") { expect(moved.delete().value).should_be(0); };
        test("the inner folder is empty") { expect(inner.list().size().value).should_be(0); };
        test("delete of the empty inner folder") { expect(inner.delete().value).should_be(0); };
        test("the inner folder is gone") { expect_false(inner.exists()); };
        test("the outer folder is empty") { expect(folder.list().size().value).should_be(0); };
        test("delete of the empty outer folder") { expect(folder.delete().value).should_be(0); };
        test("the outer folder is gone") { expect_false(folder.exists()); };
    };
    finish_tests("std_files");
}
