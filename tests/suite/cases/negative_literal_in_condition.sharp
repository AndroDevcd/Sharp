mod main;
import ( testing )
def main(args: string[]) {
    c : decimal = -1;
    x : decimal = 0;
    expect("c == -1 || x", c == -1 || x, 1);
    expect("x || c == -1", x || c == -1, 1);
    d : decimal = 5;
    expect("d == -1 || x", d == -1 || x, 0);
    expect("d - -1", d - -1, 6);
    finish("negative_literal_in_condition");
}
