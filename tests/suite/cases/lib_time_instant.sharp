mod main;

import ( testing, std.time )

/**
 * std.time.instant, zone_offset and offset_date_time: points on the UTC time
 * line stored as seconds + nanoseconds, fixed offsets from UTC, and the
 * conversions between them.
 *
 * Nothing here asserts on the real current time, except for properties that
 * always hold (the clock is after 2020, an offset is within 18 hours).
 */

def itext(i: instant): string {
    return i.to_string()!!;
}

def otext(o: zone_offset): string {
    return o.to_string()!!;
}

def odt(o: offset_date_time): string {
    return o.to_string()!!;
}

def rejects_offset(s: string): var {
    try {
        zone_offset.parse(s);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def rejects_instant(s: string): var {
    try {
        instant.parse(s);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def main(args: string[]) {
    // seconds from 1900-01-01 to 1970-01-01 (70 years with 17 leap days)
    seconds_1900_to_1970 : var = 2208988800;

    // ================= instant =================

    // ---- creating
    expect("of_epoch_second: seconds", instant.of_epoch_second(1709211600).epoch_second(), 1709211600);
    expect("of_epoch_second: nanos", instant.of_epoch_second(1709211600).nano(), 0);
    expect("of_epoch_milli: seconds", instant.of_epoch_milli(1709211600123).epoch_second(), 1709211600);
    expect("of_epoch_milli: nanos", instant.of_epoch_milli(1709211600123).nano(), 123000000);
    expect("adjustment carries: seconds", instant.of_epoch_second(10, 2500000000).epoch_second(), 12);
    expect("adjustment carries: nanos", instant.of_epoch_second(10, 2500000000).nano(), 500000000);
    expect("negative adjustment: seconds", instant.of_epoch_second(10, 0 - 1).epoch_second(), 9);
    expect("negative adjustment: nanos", instant.of_epoch_second(10, 0 - 1).nano(), 999999999);
    expect("the epoch constant", instant.epoch.epoch_second(), 0);

    // ---- before 1970: seconds round down, nanos stay positive
    expect("-1 ms: seconds", instant.of_epoch_milli(0 - 1).epoch_second(), 0 - 1);
    expect("-1 ms: nanos", instant.of_epoch_milli(0 - 1).nano(), 999000000);
    expect("-1500 ms: seconds", instant.of_epoch_milli(0 - 1500).epoch_second(), 0 - 2);
    expect("-1500 ms: nanos", instant.of_epoch_milli(0 - 1500).nano(), 500000000);
    expect("-1500 ms back to millis", instant.of_epoch_milli(0 - 1500).to_epoch_milli(), 0 - 1500);

    // ---- to_epoch_milli
    expect("to_epoch_milli", instant.of_epoch_second(1709211600, 123456789).to_epoch_milli(), 1709211600123);
    expect("to_epoch_milli of the epoch", instant.epoch.to_epoch_milli(), 0);
    expect("milli round trip", instant.of_epoch_milli(946684800999).to_epoch_milli(), 946684800999);

    // ---- text (known timestamps)
    expect_str("the epoch", itext(instant.epoch), "1970-01-01T00:00:00Z");
    expect_str("1709211600", itext(instant.of_epoch_second(1709211600)), "2024-02-29T13:00:00Z");
    expect_str("946684800", itext(instant.of_epoch_second(946684800)), "2000-01-01T00:00:00Z");
    expect_str("one billion seconds", itext(instant.of_epoch_second(1000000000)), "2001-09-09T01:46:40Z");
    expect_str("1234567890", itext(instant.of_epoch_second(1234567890)), "2009-02-13T23:31:30Z");
    expect_str("2^31 - 1", itext(instant.of_epoch_second(2147483647)), "2038-01-19T03:14:07Z");
    expect_str("-1", itext(instant.of_epoch_second(0 - 1)), "1969-12-31T23:59:59Z");
    expect_str("1900", itext(instant.of_epoch_second(0 - seconds_1900_to_1970)), "1900-01-01T00:00:00Z");
    expect_str("9999", itext(instant.of_epoch_second(253402300799)), "9999-12-31T23:59:59Z");
    expect_str("milliseconds", itext(instant.of_epoch_milli(1)), "1970-01-01T00:00:00.001Z");
    expect_str("nanoseconds", itext(instant.of_epoch_second(0, 1)), "1970-01-01T00:00:00.000000001Z");
    expect_str("half a second before the epoch", itext(instant.of_epoch_milli(0 - 500)), "1969-12-31T23:59:59.500Z");

    // ---- arithmetic
    t := instant.of_epoch_second(1709211600);
    expect_str("+ 11 hours", itext(t + duration.of_hours(11)), "2024-03-01T00:00:00Z");
    expect_str("- 1 day", itext(t - duration.of_days(1)), "2024-02-28T13:00:00Z");
    expect_str("plus(duration) with nanos", itext(t.plus(duration.of_millis(1500))), "2024-02-29T13:00:01.500Z");
    expect_str("minus(duration) borrows", itext(t.minus(duration.of_nanos(1))), "2024-02-29T12:59:59.999999999Z");
    expect_str("plus a negative duration", itext(t.plus(duration.of_seconds(0 - 3600))), "2024-02-29T12:00:00Z");
    expect("plus_seconds", t.plus_seconds(60).epoch_second(), 1709211660);
    expect("minus_seconds", t.minus_seconds(60).epoch_second(), 1709211540);
    expect("plus_millis", t.plus_millis(2500).to_epoch_milli(), 1709211602500);
    expect("minus_millis", t.minus_millis(1).to_epoch_milli(), 1709211599999);
    expect("plus_nanos carries", t.plus_nanos(1000000001).epoch_second(), 1709211601);
    expect("plus_nanos carries: nanos", t.plus_nanos(1000000001).nano(), 1);
    expect("minus_nanos borrows: nanos", t.minus_nanos(1).nano(), 999999999);
    expect_str("the original is unchanged", itext(t), "2024-02-29T13:00:00Z");
    expect_str("truncated_to_seconds", itext(instant.of_epoch_second(5, 999999999).truncated_to_seconds()), "1970-01-01T00:00:05Z");
    expect("truncated_to_millis", instant.of_epoch_second(5, 123456789).truncated_to_millis().nano(), 123000000);

    // ---- exact differences, also where one number of nanoseconds could not hold the value
    a := instant.of_epoch_second(1700000000, 123456789);
    b := instant.of_epoch_second(1700000000, 123456790);
    expect("two instants 1 ns apart", duration.between(a, b).to_nanos(), 1);
    expect("...and backwards", duration.between(b, a).to_nanos(), 0 - 1);
    expect("until", a.until(b).nanos(), 1);
    expect_true("they are different instants", a != b);
    expect_true("and ordered", a < b);
    expect("between: seconds", duration.between(instant.epoch, t).seconds(), 1709211600);
    expect("between over a second boundary", duration.between(instant.of_epoch_second(1, 900000000), instant.of_epoch_second(2, 100000000)).to_millis(), 200);
    expect("a day apart", duration.between(t, t + duration.of_days(1)).to_hours(), 24);

    // ---- comparing
    expect_true("==", t == instant.of_epoch_milli(1709211600000));
    expect_false("== different", t == instant.epoch);
    expect_true("<", instant.epoch < t);
    expect_true("<=", t <= t);
    expect_true(">", t > instant.epoch);
    expect_true(">=", t >= t);
    expect_true("before 1970 is less than the epoch", instant.of_epoch_milli(0 - 1) < instant.epoch);
    expect("compare_to", instant.epoch.compare_to(t), 0 - 1);
    expect("compare_to equal", t.compare_to(t), 0);
    expect_true("is_before", instant.epoch.is_before(t));
    expect_true("is_after", t.is_after(instant.epoch));

    // ---- parsing
    expect("parse Z", instant.parse("2024-02-29T13:00:00Z").epoch_second(), 1709211600);
    expect("parse +02:00 is the same moment", instant.parse("2024-02-29T15:00:00+02:00").epoch_second(), 1709211600);
    expect("parse -05:00 is the same moment", instant.parse("2024-02-29T08:00:00-05:00").epoch_second(), 1709211600);
    expect("parse a fraction", instant.parse("1970-01-01T00:00:01.5Z").to_epoch_milli(), 1500);
    expect("parse before the epoch", instant.parse("1969-12-31T23:59:59.5Z").to_epoch_milli(), 0 - 500);
    expect_true("format -> parse round trip", instant.parse(itext(a)) == a);
    expect_true("parse rejects a missing offset", rejects_instant("2024-02-29T13:00:00"));
    expect_true("parse rejects a date", rejects_instant("2024-02-29"));
    expect_true("parse rejects words", rejects_instant("now"));

    // ---- the real clock: only properties that always hold
    now1 := instant.now();
    now2 := instant.now();
    expect_true("the clock is after 2020-01-01", now1.epoch_second() > 1577836800);
    expect_true("nano is in range", now1.nano() >= 0 && now1.nano() <= 999999999);
    expect_true("two readings are less than a minute apart", time_math.abs(duration.between(now1, now2).seconds()) < 60);

    // ================= zone_offset =================

    expect("utc", zone_offset.utc.total_seconds(), 0);
    expect_true("utc is_utc", zone_offset.utc.is_utc());
    expect("of_hours(2)", zone_offset.of_hours(2).total_seconds(), 7200);
    expect("of_hours(-5)", zone_offset.of_hours(0 - 5).total_seconds(), 0 - 18000);
    expect("of_hours_minutes(5, 30)", zone_offset.of_hours_minutes(5, 30).total_seconds(), 19800);
    expect("of_hours_minutes(-5, -30)", zone_offset.of_hours_minutes(0 - 5, 0 - 30).total_seconds(), 0 - 19800);
    expect("of_hours_minutes(0, -30)", zone_offset.of_hours_minutes(0, 0 - 30).total_seconds(), 0 - 1800);
    expect("of_total_seconds", zone_offset.of_total_seconds(20700).total_seconds(), 20700);
    expect("hours", zone_offset.of_hours_minutes(0 - 5, 0 - 30).hours(), 0 - 5);
    expect("minutes", zone_offset.of_hours_minutes(0 - 5, 0 - 30).minutes(), 0 - 30);
    expect("seconds", zone_offset.of_total_seconds(3630).seconds(), 30);
    expect_false("+02:00 is not utc", zone_offset.of_hours(2).is_utc());
    expect_true("of_hours(0) is the utc object", zone_offset.of_hours(0) == zone_offset.utc);

    expect_str("utc text", otext(zone_offset.utc), "Z");
    expect_str("+02:00", otext(zone_offset.of_hours(2)), "+02:00");
    expect_str("-05:00", otext(zone_offset.of_hours(0 - 5)), "-05:00");
    expect_str("+05:30", otext(zone_offset.of_hours_minutes(5, 30)), "+05:30");
    expect_str("-00:30", otext(zone_offset.of_hours_minutes(0, 0 - 30)), "-00:30");
    expect_str("+05:45 (Nepal)", otext(zone_offset.of_total_seconds(20700)), "+05:45");
    expect_str("+14:00", otext(zone_offset.of_hours(14)), "+14:00");
    expect_str("-12:00", otext(zone_offset.of_hours(0 - 12)), "-12:00");
    expect_str("seconds are shown when not zero", otext(zone_offset.of_total_seconds(3630)), "+01:00:30");
    expect_str("the limits", otext(zone_offset.of_hours(18)), "+18:00");

    expect("parse Z", zone_offset.parse("Z").total_seconds(), 0);
    expect("parse z", zone_offset.parse("z").total_seconds(), 0);
    expect("parse +02:00", zone_offset.parse("+02:00").total_seconds(), 7200);
    expect("parse -05:30", zone_offset.parse("-05:30").total_seconds(), 0 - 19800);
    expect("parse +0530", zone_offset.parse("+0530").total_seconds(), 19800);
    expect("parse +02", zone_offset.parse("+02").total_seconds(), 7200);
    expect("parse +2", zone_offset.parse("+2").total_seconds(), 7200);
    expect("parse +01:00:30", zone_offset.parse("+01:00:30").total_seconds(), 3630);
    expect("parse +010030", zone_offset.parse("+010030").total_seconds(), 3630);
    expect("parse +00:00", zone_offset.parse("+00:00").total_seconds(), 0);
    expect("parse -00:00", zone_offset.parse("-00:00").total_seconds(), 0);
    expect_str("format -> parse round trip", otext(zone_offset.parse(otext(zone_offset.of_hours_minutes(0 - 9, 0 - 30)))), "-09:30");
    expect_true("parse rejects a missing sign", rejects_offset("02:00"));
    expect_true("parse rejects +19:00", rejects_offset("+19:00"));
    expect_true("parse rejects +18:01", rejects_offset("+18:01"));
    expect_true("parse rejects minute 60", rejects_offset("+02:60"));
    expect_true("parse rejects a name", rejects_offset("UTC"));
    expect_true("parse rejects the empty string", rejects_offset(""));
    expect_true("parse rejects trailing text", rejects_offset("+02:00x"));

    caught : var = 0;
    try { zone_offset.of_hours(19); } catch(e: date_time_exception) { caught = 1; }
    expect("of_hours(19) throws", caught, 1);
    caught = 0;
    try { zone_offset.of_hours_minutes(5, 0 - 30); } catch(e: date_time_exception) { caught = 1; }
    expect("mixed signs throw", caught, 1);
    caught = 0;
    try { zone_offset.of_hours_minutes(18, 1); } catch(e: date_time_exception) { caught = 1; }
    expect("beyond 18 hours throws", caught, 1);
    caught = 0;
    try { zone_offset.of_hours_minutes(1, 60); } catch(e: date_time_exception) { caught = 1; }
    expect("minute 60 throws", caught, 1);

    expect_true("== by value", zone_offset.of_hours(2) == zone_offset.of_total_seconds(7200));
    expect_true("!=", zone_offset.of_hours(2) != zone_offset.of_hours(3));
    expect("compare_to", zone_offset.of_hours(0 - 5).compare_to(zone_offset.of_hours(2)), 0 - 1);

    system := zone_offset.system_default();
    expect_true("the system offset is within 18 hours", system.total_seconds() >= (0 - 64800) && system.total_seconds() <= 64800);
    expect("the system offset is a whole number of minutes", system.total_seconds() % 60, 0);

    // ================= offset_date_time =================

    plus2 := zone_offset.of_hours(2);
    x := offset_date_time.parse("2024-02-29T15:00:00+02:00");
    expect("year", x.year(), 2024);
    expect("month_value", x.month_value(), 2);
    expect("day", x.day(), 29);
    expect("hour is the local hour", x.hour(), 15);
    expect("minute", x.minute(), 0);
    expect("offset", x.offset().total_seconds(), 7200);
    expect("to_epoch_second", x.to_epoch_second(), 1709211600);
    expect("to_instant", x.to_instant().epoch_second(), 1709211600);
    expect_str("to_string", odt(x), "2024-02-29T15:00:00+02:00");
    expect_str("to_date_time drops the offset", x.to_date_time().to_string()!!, "2024-02-29T15:00:00");
    expect_str("to_date", x.to_date().to_string()!!, "2024-02-29");
    expect_str("to_time", x.to_time().to_string()!!, "15:00:00");
    expect_true("day_of_week", x.day_of_week() == day_of_week.thursday);

    // ---- the same moment at other offsets
    expect_str("in UTC", odt(x.with_offset_same_instant(zone_offset.utc)), "2024-02-29T13:00:00Z");
    expect_str("in New York (-05:00)", odt(x.with_offset_same_instant(zone_offset.of_hours(0 - 5))), "2024-02-29T08:00:00-05:00");
    expect_str("in India (+05:30)", odt(x.with_offset_same_instant(zone_offset.of_hours_minutes(5, 30))), "2024-02-29T18:30:00+05:30");
    expect_str("in Tokyo (+09:00)", odt(x.with_offset_same_instant(zone_offset.of_hours(9))), "2024-02-29T22:00:00+09:00");
    expect_str("in Kiritimati (+14:00) it is already tomorrow", odt(x.with_offset_same_instant(zone_offset.of_hours(14))), "2024-03-01T03:00:00+14:00");
    expect_str("in Baker Island (-12:00)", odt(x.with_offset_same_instant(zone_offset.of_hours(0 - 12))), "2024-02-29T01:00:00-12:00");
    expect("the instant does not change", x.with_offset_same_instant(zone_offset.of_hours(9)).to_epoch_second(), 1709211600);
    expect_str("with_offset_same_local keeps the fields", odt(x.with_offset_same_local(zone_offset.utc)), "2024-02-29T15:00:00Z");
    expect("...and moves the instant", x.with_offset_same_local(zone_offset.utc).to_epoch_second(), 1709218800);
    expect_str("a year boundary", odt(offset_date_time.parse("2023-12-31T23:30:00-01:00").with_offset_same_instant(zone_offset.utc)), "2024-01-01T00:30:00Z");

    // ---- from an instant
    expect_str("of_instant", odt(offset_date_time.of_instant(t, plus2)), "2024-02-29T15:00:00+02:00");
    expect_str("instant.at_offset", odt(t.at_offset(zone_offset.utc)), "2024-02-29T13:00:00Z");
    expect_str("of_instant before 1970", odt(offset_date_time.of_instant(instant.of_epoch_second(0 - 1), plus2)), "1970-01-01T01:59:59+02:00");
    expect_str("of(date_time, offset)", odt(offset_date_time.of(date_time.of(2000, 1, 1, 0, 0), plus2)), "2000-01-01T00:00:00+02:00");
    expect_str("of(date, time, offset)", odt(offset_date_time.of(date.of(2000, 1, 1), time_of_day.noon, zone_offset.utc)), "2000-01-01T12:00:00Z");
    expect_str("of(fields)", odt(offset_date_time.of(2000, 1, 1, 1, 2, 3, 4000000, zone_offset.of_hours(0 - 3))), "2000-01-01T01:02:03.004-03:00");
    expect_str("date_time.at_offset", odt(date_time.of(2000, 1, 1, 0, 0).at_offset(plus2)), "2000-01-01T00:00:00+02:00");
    expect("date_time.to_instant", date_time.of(2024, 2, 29, 15, 0, 0).to_instant(plus2).epoch_second(), 1709211600);

    // ---- arithmetic keeps the offset
    expect_str("+ duration", odt(x + duration.of_hours(10)), "2024-03-01T01:00:00+02:00");
    expect_str("- duration", odt(x - duration.of_minutes(1)), "2024-02-29T14:59:00+02:00");
    expect_str("plus(period)", odt(x.plus(period.of_years(1))), "2025-02-28T15:00:00+02:00");
    expect_str("minus(period)", odt(x.minus(period.of_days(29))), "2024-01-31T15:00:00+02:00");
    expect_str("plus_days", odt(x.plus_days(1)), "2024-03-01T15:00:00+02:00");
    expect_str("plus_months", odt(x.plus_months(12)), "2025-02-28T15:00:00+02:00");
    expect_str("plus_hours", odt(x.plus_hours(9)), "2024-03-01T00:00:00+02:00");
    expect_str("plus_minutes", odt(x.plus_minutes(0 - 1)), "2024-02-29T14:59:00+02:00");
    expect_str("plus_seconds", odt(x.plus_seconds(1)), "2024-02-29T15:00:01+02:00");
    expect("until across offsets", x.until(offset_date_time.parse("2024-02-29T15:00:00Z")).to_hours(), 2);

    // ---- comparing is by the moment, not by the fields
    same_moment := offset_date_time.parse("2024-02-29T13:00:00Z");
    expect_true("15:00+02:00 == 13:00Z", x == same_moment);
    expect_false("...but the fields differ", x.same_fields(same_moment));
    expect_true("same_fields with itself", x.same_fields(offset_date_time.parse("2024-02-29T15:00:00+02:00")));
    expect_true("14:00+02:00 is before 13:00Z", offset_date_time.parse("2024-02-29T14:00:00+02:00") < same_moment);
    expect_true("15:00Z is after 15:00+02:00", offset_date_time.parse("2024-02-29T15:00:00Z") > x);
    expect_true("!=", x != x.plus_seconds(1));
    expect_true("<=", x <= same_moment);
    expect_true(">=", x >= same_moment);
    expect("compare_to", x.compare_to(same_moment), 0);
    expect_true("is_before", x.is_before(x.plus_seconds(1)));
    expect_true("is_after", x.plus_seconds(1).is_after(x));

    // ---- parsing
    expect_str("parse Z", odt(offset_date_time.parse("2024-02-29T13:00:00Z")), "2024-02-29T13:00:00Z");
    expect_str("parse a basic offset", odt(offset_date_time.parse("2024-02-29T13:00:00-0530")), "2024-02-29T13:00:00-05:30");
    expect_str("parse a fraction", odt(offset_date_time.parse("2024-02-29T13:00:00.25+01:00")), "2024-02-29T13:00:00.250+01:00");
    expect_true("format -> parse round trip", offset_date_time.parse(odt(x)).same_fields(x));
    caught = 0;
    try { offset_date_time.parse("2024-02-29T13:00:00"); } catch(e: date_time_exception) { caught = 1; }
    expect("parse without an offset throws", caught, 1);
    caught = 0;
    try { offset_date_time.parse("2024-02-29T13:00:00+25:00"); } catch(e: date_time_exception) { caught = 1; }
    expect("parse with a bad offset throws", caught, 1);

    finish("lib_time_instant");
}
