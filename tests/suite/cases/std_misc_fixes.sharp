mod main;

import ( std.testing )

/**
 * KNOWN BUGS in the small std classes. This file is EXPECTED TO FAIL.
 */

def make_name(): string {
    return "made";
}

def main(args: string[]) {
    show_only_failures();
    tests("std_misc_fixes") {
        // ---- BUG 1: deferred_init<string> throws nullptr_exception on the first read.
        // Its getter tests `value == null`; for a class with its own operator== (string)
        // that calls string.operator==(null), which reads the characters of null.
        // (deferred_init of a class without operator== works: cases/std_misc.sharp)
        outcome : decimal = 0;
        lazy := new deferred_init<string>(make_name);
        try {
            text := lazy.value;
            outcome = 1;
            test("the value made by the function") { expect(text).should_be("made"); };
        } catch(e: nullptr_exception) {
            outcome = 2;
        }
        test("deferred_init<string> can be read") { expect(outcome).should_be(1); };

        // ---- BUG 2: a result without an error cannot be written down directly.
        //     new result<string, exception>("data", null)
        // does not compile ("cannot find constructor result(_int8[], null)"): the
        // constructor takes `err: E`, not `E?`, although the field is `E?` and
        // is_success means "error == null". The way around it is a variable that was
        // never assigned (see checked_divide in cases/std_misc.sharp). Nothing to run.
    };
    finish_tests("std_misc_fixes");
}
