mod main;

import ( testing )

/**
 * Elements of sized number arrays hold values of their size: a store wraps
 * exactly as it does for a local or a field of that type.
 */
def main(args: string[]) {
    bytes := new _int8[4];
    v : decimal = 128;
    bytes[0] = v;
    bytes[1] = 129;
    bytes[2] = 200;
    bytes[3] = 0 - 129;
    expect("128 stored in _int8[]", bytes[0], 0 - 128);
    expect("129 stored in _int8[]", bytes[1], 0 - 127);
    expect("200 stored in _int8[]", bytes[2], 0 - 56);
    expect("-129 stored in _int8[]", bytes[3], 127);
    bytes[0] = 100;
    bytes[0] += 100;
    expect("_int8 element += past the range", bytes[0], 0 - 56);
    bytes[0] = 127;
    bytes[0]++;
    expect("_int8 element ++ past the range", bytes[0], 0 - 128);

    ub := new _uint8[2];
    ub[0] = 0 - 1;
    ub[1] = 300;
    expect("-1 stored in _uint8[]", ub[0], 255);
    expect("300 stored in _uint8[]", ub[1], 44);

    shorts := new _int16[1];
    shorts[0] = 70000;
    expect("70000 stored in _int16[]", shorts[0], 4464);

    ints := new _int32[1];
    ints[0] = 4294967297;
    expect("2^32 + 1 stored in _int32[]", ints[0], 1);

    longs := new _int64[1];
    longs[0] = 2.75;
    expect("2.75 stored in _int64[]", longs[0], 2);

    plain := new decimal[1];
    plain[0] = 200.5;
    expect("var[] keeps the value", plain[0], 200.5);
    finish("arrays_sized_elements");
}
