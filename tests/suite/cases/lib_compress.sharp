mod main;

import ( std.testing, std.io, std.data, std.compress , std.util )

/**
 * std.compress: deflate, gzip, zlib and zip archives - there and back, and
 * against data made by the tools everyone else uses (Python's zlib, gzip
 * and zipfile wrote the texts in quotes below; build/lib/make_vectors.py).
 */

def text_of(bytes: _int8[]) : string {
    if(sizeof(bytes) == 0) { return ""; }
    return new string(bytes, 0, sizeof(bytes));
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_compress") {
        original := new char_buffer();
        for(i : _int64 = 0; i < 6; i++) { original.append("The quick brown fox jumps over the lazy dog. "); }
        for(i : _int64 = 0; i < 5; i++) { original.append("Pack my box with five dozen liquor jugs! "); }
        text : string = original.build();
        test("the text") { expect(sizeof(text.data)).should_be(475); };

        // ---------------------------------------------------------------- data others made
        theirs := base64.decode_bytes("H4sIAAAAAAACA93LwQFAMBAF0Va+BtTioAFhxZJkCUlI9bYNzvOmXwhH4nGDiVICZrmxJr+fkEwRl2Y31AeT2Bb933E3qPMPjKLC14KZM2mqFOD4SBL1tWfzCfgCIL/UMtsBAAA=");
        test("gzip made by gzip") { expect(gzip.decompress_text(theirs)).should_be(text); };
        test("is_gzip") { expect_true(gzip.is_gzip(theirs)); };
        test("is_gzip: something else") { expect_false(gzip.is_gzip(text.data)); };
        test("zlib made by zlib") {
            expect(text_of(zlib.decompress(base64.decode_bytes("eNrdy8EBQDAQBdFWvgbU4qABYcWSZAlJSPW2Dc7zpl8IR+Jxg4lSAma5sSa/n5BMEZdmN9QHk9gW/d9xN6jzD4yiwteCmTNpqhTg+EgS9bVn8wn4Aqtxqj0=")))).should_be(text);
        };
        test("bare deflate made by zlib") {
            expect(text_of(deflate.decompress(base64.decode_bytes("3cvBAUAwEAXRVr4G1OKgAWHFkmQJSUj1tg3O86ZfCEficYOJUgJmubEmv5+QTBGXZjfUB5PYFv3fcTeo8w+MosLXgpkzaaoU4PhIEvW1Z/MJ+AI=")))).should_be(text);
        };
        test("a block that is stored, not compressed") {
            expect(text_of(deflate.decompress(base64.decode_bytes("AQwA8/9zdG9yZWQgYmxvY2s=")))).should_be("stored block");
        };
        test("the checksum of gzip") { expect(hashing.crc32(text.data)).should_be(852803360); };
        test("the checksum of zlib") { expect(hashing.adler32(text.data)).should_be(2876353085); };
        check : string = "123456789";
        test("crc32 of 123456789") { expect(hashing.crc32(check.data)).should_be(0xCBF43926); };

        // ---------------------------------------------------------------- there and back
        small := deflate.compress(text.data);
        test("compress makes it smaller") { expect_true(sizeof(small) < 150); };
        test("deflate: there and back") { expect(text_of(deflate.decompress(small))).should_be(text); };
        test("gzip: there and back") { expect(gzip.decompress_text(gzip.compress_text(text))).should_be(text); };
        test("zlib: there and back") { expect(text_of(zlib.decompress(zlib.compress(text.data)))).should_be(text); };
        test("nothing: there and back") { expect(sizeof(gzip.decompress(gzip.compress(null)))).should_be(0); };
        test("one byte") { expect(gzip.decompress_text(gzip.compress_text("a"))).should_be("a"); };
        test("two bytes") { expect(gzip.decompress_text(gzip.compress_text("ab"))).should_be("ab"); };
        test("the same byte 1000 times") {
            same := new _int8[1000];
            for(i : _int64 = 0; i < 1000; i++) { same[i] = 'z'; }
            packed := deflate.compress(same);
            expect_true(sizeof(packed) < 30 && text_of(deflate.decompress(packed)) == text_of(same));
        };
        // bytes that do not repeat (every value, shuffled by a fixed rule): nothing to gain, nothing lost
        noise := new _int8[5000];
        seed : _int64 = 12345;
        for(i : _int64 = 0; i < 5000; i++) {
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
            noise[i] = (seed >> 16) & 0xFF;
        }
        back := deflate.decompress(deflate.compress(noise));
        right : decimal = sizeof(back) == 5000;
        for(i : _int64 = 0; i < 5000 && right; i++) { if(back[i] != noise[i]) { right = 0; } }
        test("bytes without repeats come back the same") { expect_true(right); };
        // a long text with repeats far apart and near: 200000 bytes
        large := new char_buffer();
        for(i : _int64 = 0; i < 4000; i++) { large.append("row ").append_int(i * 7919 % 1000).append(": ").append_int(i).append(" some words that repeat\n"); }
        large_text : string = large.build();
        large_packed := gzip.compress_text(large_text);
        test("a large text gets much smaller") { expect_true(sizeof(large_packed) * 4 < sizeof(large_text.data)); };
        test("... and comes back the same") { expect_true(gzip.decompress_text(large_packed) == large_text); };
        two := new byte_buffer();
        two.put_bytes(gzip.compress_text("first, "));
        two.put_bytes(gzip.compress_text("second"));
        test("two gzip streams, one after the other") { expect(gzip.decompress_text(two.to_array())).should_be("first, second"); };

        // ---------------------------------------------------------------- damage is noticed
        damaged := gzip.compress_text(text);
        damaged[sizeof(damaged) - 6] = damaged[sizeof(damaged) - 6] ^ 1;
        said : string = "";
        try { gzip.decompress(damaged); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("gzip: a checksum that does not fit") { expect_true(io_strings.contains(said, "checksum")); };
        said = "";
        try { gzip.decompress(copy(theirs!!, 0, 40)); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("gzip: cut off") { expect_true(sizeof(said.data) > 0); };
        said = "";
        try { gzip.decompress(text.data); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("gzip: something else") { expect(said).should_be("this is not gzip data"); };
        said = "";
        try { zlib.decompress(text.data); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("zlib: something else") { expect(said).should_be("this is not zlib data"); };
        said = "";
        try { deflate.decompress(base64.decode_bytes("/////w==")); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("deflate: bytes that are no stream") { expect_true(sizeof(said.data) > 0); };

        // ---------------------------------------------------------------- an archive others made
        archive := zip_archive.of_bytes(base64.decode_bytes(""));
        test("zip: how many entries") { expect(archive.size()).should_be(3); };
        test("zip: the names") { expect(io_strings.join(archive.names(), "|")).should_be("readme.txt|docs/|docs/plain.txt"); };
        test("zip: a deflated file") { expect(archive.read_text("readme.txt")).should_be(text); };
        test("zip: a stored file") { expect(archive.read_text("docs/plain.txt")).should_be("kept as it is"); };
        test("zip: a folder") { expect_true(archive.find("docs/")!!.is_folder); };
        test("zip: a file's size") { expect(archive.find("readme.txt")!!.size).should_be(475); };
        test("zip: has") { expect_true(archive.has("readme.txt") && !archive.has("none.txt")); };
        none : decimal = 0;
        try { archive.read("none.txt"); } catch(missing: io_exception) { none = 1; }
        test("zip: a file that is not in it") { expect_true(none); };

        // ---------------------------------------------------------------- an archive made here
        made := new zip_builder();
        made.add("readme.txt", text).add("empty.txt", "").add_folder("data").add("data/a.txt", "the a file");
        raw := new _int8[300];
        for(i : _int64 = 0; i < 300; i++) { raw[i] = i; }
        made.add_bytes("data/bytes.bin", raw);
        made.add("data/a.txt", "the a file, again");            // replaces the first
        test("builder: how many") { expect(made.size()).should_be(5); };
        ours := zip_archive.of_bytes(made.bytes());
        test("ours: the names") { expect(io_strings.join(ours.names(), "|")).should_be("readme.txt|empty.txt|data/|data/bytes.bin|data/a.txt"); };
        test("ours: a text that packs is packed") { expect_true(ours.find("readme.txt")!!.packed_size < 150); };
        test("ours: it reads back") { expect(ours.read_text("readme.txt")).should_be(text); };
        test("ours: an empty file") { expect(ours.read_text("empty.txt")).should_be(""); };
        test("ours: the replaced file") { expect(ours.read_text("data/a.txt")).should_be("the a file, again"); };
        bytes_back := ours.read("data/bytes.bin");
        test("ours: bytes") { expect_true(sizeof(bytes_back) == 300 && (bytes_back[200] & 0xFF) == 200 && bytes_back[0] == 0); };

        // to a file, and unpacked into a folder
        place := new file("compress_case.zip");
        made.save(place);
        from_disk := zip_archive.open(place);
        test("from a file") { expect(from_disk.read_text("data/a.txt")).should_be("the a file, again"); };
        test("extract_all: the files written") { expect(from_disk.extract_all("compress_case_out")).should_be(4); };
        test("extract_all: a file") { expect(new file("compress_case_out/readme.txt").read_text()).should_be(text); };
        test("extract_all: a file in a folder") { expect(new file("compress_case_out/data/a.txt").read_text()).should_be("the a file, again"); };
        new file("compress_case_out/readme.txt").remove();
        new file("compress_case_out/empty.txt").remove();
        new file("compress_case_out/data/a.txt").remove();
        new file("compress_case_out/data/bytes.bin").remove();
        new file("compress_case_out/data").remove();
        new file("compress_case_out").remove();
        place.remove();

        climbing := new zip_builder();
        climbing.add("../outside.txt", "should never be written");
        said = "";
        try { zip_archive.of_bytes(climbing.bytes()).extract_all("compress_case_out"); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("extract_all: a name that would leave the folder") { expect_true(io_strings.contains(said, "outside the folder")); };
        new file("compress_case_out").remove();
        said = "";
        try { zip_archive.of_bytes(text.data); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("zip: something else") { expect_true(io_strings.contains(said, "not a zip archive")); };
        broken := made.bytes();
        broken[45] = broken[45] ^ 0x55;                         // inside the first file's packed bytes
        said = "";
        try { zip_archive.of_bytes(broken).read("readme.txt"); } catch(bad: compress_exception) { said = bad.get_message(); }
        test("zip: a damaged file is noticed") { expect_true(sizeof(said.data) > 0); };
    };
    finish_tests("lib_compress");
}
