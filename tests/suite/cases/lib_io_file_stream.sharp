mod main;

import ( std.testing, std.io )

/**
 * std.io file_stream: a file written and read piece by piece - appending,
 * lines, moving about in it, reading on from a position - and what is refused.
 *
 * Works only inside a folder of its own in the temporary directory and
 * removes it at the end.
 */

def main(args: string[]) {
    show_only_failures();
    tests("lib_io_file_stream") {
        folder := new file(temp_files.directory() + "/sharp_suite_io_stream");
        folder.delete_recursively();
        folder.mkdirs();
        path : string = folder.path + "/stream.txt";

        // ---- write, then read back piece by piece
        out := file_stream.open(path, "w");
        test("open for writing") { expect_true(out.is_open()); };
        test("path") { expect(out.path()).should_be(path); };
        out.write_text("first line\n").write_text("second line\r\n").write_text("third");
        test("position after writing") { expect(out.position()).should_be(11 + 13 + 5); };
        out.close();
        test("closed") { expect_false(out.is_open()); };
        out.close();
        test("the file is there") { expect(new file(path).size()).should_be(29); };

        reader := file_stream.open(path, "r");
        test("size") { expect(reader.size()).should_be(29); };
        test("size leaves the position alone") { expect(reader.position()).should_be(0); };
        test("read 5") { expect(reader.read_text(5)).should_be("first"); };
        test("position") { expect(reader.position()).should_be(5); };
        test("the rest of the line") { expect(reader.read_line()!!).should_be(" line"); };
        test("a line that ends \\r\\n") { expect(reader.read_line()!!).should_be("second line"); };
        test("the last line has no line end") { expect(reader.read_line()!!).should_be("third"); };
        test("then: null") { expect_null(reader.read_line()); };
        test("at_end") { expect_true(reader.at_end()); };
        test("a read at the end gives nothing") { expect(sizeof(reader.read(10))).should_be(0); };

        // ---- moving about
        reader.seek(11);
        test("seek, then read") { expect(reader.read_text(6)).should_be("second"); };
        reader.skip(0 - 6);
        test("skip back") { expect(reader.read_text(6)).should_be("second"); };
        reader.seek_end();
        test("seek_end") { expect(reader.position()).should_be(29); };
        reader.seek(0);
        test("a read that asks for more than there is") { expect(sizeof(reader.read(1000))).should_be(29); };
        reader.close();

        // ---- appending
        more := file_stream.open(path, "a");
        more.write_text("\nfourth\n");
        more.close();
        again := file_stream.open(path, "r");
        lines : decimal = 0;
        last : string = "";
        while(true) {
            line := again.read_line();
            if(line == null) { break; }
            lines++;
            last = line!!;
        }
        again.close();
        test("append: four lines now") { expect(lines).should_be(4); };
        test("... the last one") { expect(last).should_be("fourth"); };

        // ---- read and write in one stream: a part in the middle replaced
        both := file_stream.open(path, "r+");
        both.seek(0);
        both.write_text("FIRST");
        both.seek(0);
        test("r+: what was written is read") { expect(both.read_line()!!).should_be("FIRST line"); };
        both.close();

        // ---- bytes: every value, in blocks, and a line longer than the stream's own buffer
        binary : string = folder.path + "/bytes.bin";
        block := new _int8[256];
        for(i : decimal = 0; i < 256; i++) { block[i] = i; }
        bytes := file_stream.open(binary, "w");
        for(i : decimal = 0; i < 400; i++) { bytes.write(block); }
        bytes.write(block, 10);
        bytes.close();
        back := file_stream.open(binary, "r");
        test("102410 bytes written") { expect(back.size()).should_be(102410); };
        back.seek(256 * 398 + 200);
        part := back.read(100);
        test("a read across the end of a block") { expect(sizeof(part)).should_be(100); };
        test("... byte 200") { expect(part[0] & 0xFF).should_be(200); };
        test("... byte 255") { expect(part[55] & 0xFF).should_be(255); };
        test("... and 0 of the next") { expect(part[56] & 0xFF).should_be(0); };
        total : decimal = 0;
        back.seek(0);
        while(true) {
            piece := back.read(4096);
            if(sizeof(piece) == 0) { break; }
            total += sizeof(piece);
        }
        test("read to the end in pieces") { expect(total).should_be(102410); };
        back.close();

        long_path : string = folder.path + "/long.txt";
        long_out := file_stream.open(long_path, "w");
        for(i : decimal = 0; i < 1000; i++) { long_out.write_text("0123456789"); }
        long_out.write_text("\nshort\n");
        long_out.close();
        long_in := file_stream.open(long_path, "r");
        long_line := long_in.read_line()!!;
        test("a line of 10000 characters") { expect(sizeof(long_line.data)).should_be(10000); };
        test("... its end") { expect(long_line.data!![9999]).should_be('9'); };
        test("the line after it") { expect(long_in.read_line()!!).should_be("short"); };
        long_in.close();

        // ---- what is refused
        refused : decimal = 0;
        try { file_stream.open(folder.path + "/not_there.txt", "r"); } catch(gone: io_exception) { refused++; }
        try { file_stream.open(folder.path + "/no/such/folder/x.txt", "w"); } catch(gone: io_exception) { refused++; }
        test("a file that is not there, a folder that is not there") { expect(refused).should_be(2); };
        wrong_mode : decimal = 0;
        try { file_stream.open(path, "x"); } catch(wrong: illegal_argument_exception) { wrong_mode = 1; }
        test("a mode that is none") { expect_true(wrong_mode); };
        closed_use : decimal = 0;
        try { reader.read(1); } catch(closed: io_exception) { closed_use++; }
        try { reader.position(); } catch(closed: io_exception) { closed_use++; }
        try { out.write_text("x"); } catch(closed: io_exception) { closed_use++; }
        test("a closed stream refuses to be used") { expect(closed_use).should_be(3); };
        negative : decimal = 0;
        open_again := file_stream.open(path, "r");
        try { open_again.seek(0 - 1); } catch(wrong: illegal_argument_exception) { negative = 1; }
        open_again.close();
        test("a negative position") { expect_true(negative); };

        test("cleanup") { expect_true(folder.delete_recursively()); };
    };
    finish_tests("lib_io_file_stream");
}
