mod main;

import ( std.testing, std.io )

/**
 * std.io binary data: byte_buffer (bytes with a read position, numbers of
 * 8/16/32/64 bits in both byte orders, IEEE doubles, strings) and
 * binary_writer / binary_reader on top of it.
 *
 * Works only inside /tmp/sharp_suite_io_binary and removes it at the end.
 */

base_dir : string = "/tmp/sharp_suite_io_binary";

/** the bytes of a buffer as lower case hex, e.g. "00ff10" */
def hex_of(buf: byte_buffer): string {
    out := new char_buffer();
    for(i : decimal = 0; i < buf.size(); i++) {
        out.append(io_strings.int_to_hex(buf.byte_at(i), 2));
    }
    return out.build();
}

/** put a double and read it back */
def through_buffer(value: decimal, little: decimal): decimal {
    buf := new byte_buffer();
    if(little) {
        buf.little_endian();
    }
    buf.put_float64(value);
    return buf.get_float64();
}

def test_bytes() {
    buf := new byte_buffer();
    test("new buffer size") { expect(buf.size()).should_be(0); };
    test("is_empty") { expect_true(buf.is_empty()); };
    test("big endian by default") { expect_true(buf.is_big_endian()); };
    test("nothing remaining") { expect_false(buf.has_remaining()); };
    test("to_array of empty") { expect_null(buf.to_array()); };
    test("to_string of empty") { expect(buf.to_string()!!).should_be(""); };

    buf.put_int8(1).put_int8(255).put_int8(0 - 1).put_int8(300).put_int8(128);
    test("size") { expect(buf.size()).should_be(5); };
    test("bytes") { expect(hex_of(buf)).should_be("01ffff2c80"); };
    test("get_int8") { expect(buf.get_int8()).should_be(1); };
    test("get_uint8 of 255") { expect(buf.get_uint8()).should_be(255); };
    test("get_int8 of 255 is -1") { expect(buf.get_int8()).should_be(0 - 1); };
    test("position") { expect(buf.position()).should_be(3); };
    test("remaining") { expect(buf.remaining()).should_be(2); };
    test("peek_uint8") { expect(buf.peek_uint8()).should_be(44); };
    test("300 wrapped to 44") { expect(buf.get_uint8()).should_be(44); };
    test("128 as signed") { expect(buf.get_int8()).should_be(0 - 128); };
    test("at the end") { expect_false(buf.has_remaining()); };
    try { buf.get_int8(); test("read past end") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("read past end") { }; }
    try { buf.peek_uint8(); test("peek past end") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("peek past end") { }; }

    buf.rewind();
    test("rewind") { expect(buf.position()).should_be(0); };
    buf.skip(4);
    test("skip") { expect(buf.get_uint8()).should_be(128); };
    buf.set_position(1);
    test("set_position") { expect(buf.get_uint8()).should_be(255); };
    test("byte_at") { expect(buf.byte_at(3)).should_be(44); };
    buf.set_byte(3, 7);
    test("set_byte") { expect(buf.byte_at(3)).should_be(7); };
    try { buf.byte_at(5); test("byte_at outside") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("byte_at outside") { }; }
    try { buf.set_byte(0 - 1, 0); test("set_byte outside") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("set_byte outside") { }; }
    try { buf.set_position(6); test("set_position outside") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("set_position outside") { }; }
    try { buf.skip(100); test("skip too far") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("skip too far") { }; }
    buf.clear();
    test("clear") { expect(buf.size()).should_be(0); };
    test("clear resets position") { expect(buf.position()).should_be(0); };

    // growth
    for(i : decimal = 0; i < 5000; i++) {
        buf.put_int8(i);
    }
    test("5000 bytes") { expect(buf.size()).should_be(5000); };
    test("byte 4999") { expect(buf.byte_at(4999)).should_be(4999 % 256); };
    test("byte 300") { expect(buf.byte_at(300)).should_be(44); };
}

def test_numbers() {
    big := new byte_buffer();
    big.put_int16(0x1234).put_int32(0x12345678).put_int64(0x1122334455);
    test("big endian layout") { expect(hex_of(big)).should_be("1234123456780000001122334455"); };
    test("get_int16") { expect(big.get_int16()).should_be(0x1234); };
    test("get_int32") { expect(big.get_int32()).should_be(0x12345678); };
    test("get_int64") { expect(big.get_int64()).should_be(0x1122334455); };

    little := new byte_buffer().little_endian();
    test("is_big_endian after switch") { expect_false(little.is_big_endian()); };
    little.put_int16(0x1234).put_int32(0x12345678).put_int64(0x1122334455);
    test("little endian layout") { expect(hex_of(little)).should_be("3412785634125544332211000000"); };
    test("little get_int16") { expect(little.get_int16()).should_be(0x1234); };
    test("little get_int32") { expect(little.get_int32()).should_be(0x12345678); };
    test("little get_int64") { expect(little.get_int64()).should_be(0x1122334455); };

    // the order can change in the middle
    mixed := new byte_buffer();
    mixed.put_int16(1);
    mixed.little_endian().put_int16(1);
    mixed.big_endian();
    test("mixed orders") { expect(hex_of(mixed)).should_be("00010100"); };
    test("read big") { expect(mixed.get_uint16()).should_be(1); };
    test("read the little one as big") { expect(mixed.get_uint16()).should_be(256); };

    // signed and unsigned edges
    edge := new byte_buffer();
    edge.put_int16(0 - 1).put_int16(32767).put_int16(0 - 32768).put_int16(65535);
    test("int16 -1") { expect(edge.get_int16()).should_be(0 - 1); };
    test("int16 max") { expect(edge.get_int16()).should_be(32767); };
    test("int16 min") { expect(edge.get_int16()).should_be(0 - 32768); };
    test("uint16 max") { expect(edge.get_uint16()).should_be(65535); };
    edge.clear();
    edge.put_int32(0 - 1).put_int32(2147483647).put_int32(0 - 2147483648).put_int32(4294967295).put_int32(0 - 2);
    test("int32 layout") { expect(hex_of(edge)).should_be("ffffffff7fffffff80000000fffffffffffffffe"); };
    test("int32 -1") { expect(edge.get_int32()).should_be(0 - 1); };
    test("int32 max") { expect(edge.get_int32()).should_be(2147483647); };
    test("int32 min") { expect(edge.get_int32()).should_be(0 - 2147483648); };
    test("uint32 max") { expect(edge.get_uint32()).should_be(4294967295); };
    test("uint32 of -2") { expect(edge.get_uint32()).should_be(4294967294); };
    edge.clear();
    edge.put_int64(0 - 1).put_int64(9007199254740992).put_int64(0 - 9007199254740992).put_int64(0).put_int64(0 - 4294967296).put_int64(2.9);
    test("int64 -1 layout") { expect(io_strings.slice(hex_of(edge), 0, 16)).should_be("ffffffffffffffff"); };
    test("int64 2^53 layout") { expect(io_strings.slice(hex_of(edge), 16, 32)).should_be("0020000000000000"); };
    test("int64 -1") { expect(edge.get_int64()).should_be(0 - 1); };
    test("int64 2^53") { expect(edge.get_int64()).should_be(9007199254740992); };
    test("int64 -2^53") { expect(edge.get_int64()).should_be(0 - 9007199254740992); };
    test("int64 0") { expect(edge.get_int64()).should_be(0); };
    test("int64 -2^32") { expect(edge.get_int64()).should_be(0 - 4294967296); };
    test("int64 cuts a fraction") { expect(edge.get_int64()).should_be(2); };
    try { edge.get_int32(); test("int32 past end") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("int32 past end") { }; }

    short_buf := new byte_buffer();
    short_buf.put_int8(1).put_int8(2).put_int8(3);
    try { short_buf.get_int32(); test("int32 with 3 bytes") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("int32 with 3 bytes") { }; }
    test("a failed read takes nothing") { expect(short_buf.position()).should_be(0); };
    try { short_buf.get_int64(); test("int64 with 3 bytes") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("int64 with 3 bytes") { }; }
    test("still nothing taken") { expect(short_buf.remaining()).should_be(3); };
}

def test_floats() {
    buf := new byte_buffer();
    buf.put_float64(1).put_float64(0 - 2).put_float64(0.1).put_float64(0);
    test("1.0") { expect(io_strings.slice(hex_of(buf), 0, 16)).should_be("3ff0000000000000"); };
    test("-2.0") { expect(io_strings.slice(hex_of(buf), 16, 32)).should_be("c000000000000000"); };
    test("0.1") { expect(io_strings.slice(hex_of(buf), 32, 48)).should_be("3fb999999999999a"); };
    test("0.0") { expect(io_strings.slice(hex_of(buf), 48, 64)).should_be("0000000000000000"); };
    test("read 1.0") { expect(buf.get_float64()).should_be(1); };
    test("read -2.0") { expect(buf.get_float64()).should_be(0 - 2); };
    test("read 0.1") { expect(buf.get_float64()).should_be(0.1); };
    test("read 0.0") { expect(buf.get_float64()).should_be(0); };

    special := new byte_buffer();
    special.put_float64(1.0 / 0.0).put_float64(0 - 1.0 / 0.0).put_float64(0.0 / 0.0);
    test("infinity") { expect(io_strings.slice(hex_of(special), 0, 16)).should_be("7ff0000000000000"); };
    test("-infinity") { expect(io_strings.slice(hex_of(special), 16, 32)).should_be("fff0000000000000"); };
    test("NaN") { expect(io_strings.slice(hex_of(special), 32, 48)).should_be("7ff8000000000000"); };
    test("read infinity") { expect_true(special.get_float64() > 1e308); };
    test("read -infinity") { expect_true(special.get_float64() < 0 - 1e308); };
    nan : decimal = special.get_float64();
    test("read NaN") { expect_true(nan != nan); };

    little := new byte_buffer().little_endian();
    little.put_float64(1);
    test("little endian 1.0") { expect(hex_of(little)).should_be("000000000000f03f"); };

    test("pi") { expect(through_buffer(3.141592653589793, 0)).should_be(3.141592653589793); };
    test("pi little endian") { expect(through_buffer(3.141592653589793, 1)).should_be(3.141592653589793); };
    test("large") { expect(through_buffer(1.7976931348623157e308, 0)).should_be(1.7976931348623157e308); };
    test("tiny normal") { expect(through_buffer(2.2250738585072014e-308, 0)).should_be(2.2250738585072014e-308); };
    test("subnormal") { expect(through_buffer(5e-324, 0)).should_be(5e-324); };
    test("another subnormal") { expect(through_buffer(1e-310, 0)).should_be(1e-310); };
    test("negative fraction") { expect(through_buffer(0 - 123456.789, 0)).should_be(0 - 123456.789); };
    test("one third") { expect(through_buffer(1.0 / 3.0, 0)).should_be(1.0 / 3.0); };
    test("power of two") { expect(through_buffer(1024, 0)).should_be(1024); };
    test("2^53 + 2") { expect(through_buffer(9007199254740994, 0)).should_be(9007199254740994); };
    test("just below one") { expect(through_buffer(0.9999999999999999, 0)).should_be(0.9999999999999999); };
    same : decimal = 1;
    value : decimal = 0.000123;
    for(i : decimal = 0; i < 60; i++) {
        if(through_buffer(value, i % 2) != value) {
            same = 0;
        }
        value = value * 7.31;
    }
    test("60 doubles of growing size round trip") { expect_true(same); };
}

def test_strings() {
    buf := new byte_buffer();
    buf.put_string("abc").put_string_prefixed("hello").put_string_zero("zed").put_string_prefixed("").put_string_zero("");
    test("layout") { expect(hex_of(buf)).should_be("6162630000000568656c6c6f7a6564000000000000"); };
    test("get_string") { expect(buf.get_string(3)).should_be("abc"); };
    test("get_string_prefixed") { expect(buf.get_string_prefixed()).should_be("hello"); };
    test("get_string_zero") { expect(buf.get_string_zero()).should_be("zed"); };
    test("empty prefixed") { expect(buf.get_string_prefixed()).should_be(""); };
    test("empty zero terminated") { expect(buf.get_string_zero()).should_be(""); };
    test("all read") { expect(buf.remaining()).should_be(0); };
    test("get_string(0)") { expect(buf.get_string(0)).should_be(""); };
    test("get_bytes(0)") { expect_null(buf.get_bytes(0)); };
    try { buf.get_string(1); test("string past end") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("string past end") { }; }

    cut := new byte_buffer();
    cut.put_int32(10).put_string("abc");
    try { cut.get_string_prefixed(); test("prefixed string cut off") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("prefixed string cut off") { }; }
    test("nothing taken from a cut string") { expect(cut.position()).should_be(0); };
    cut.set_position(4);
    try { cut.get_string_zero(); test("no zero byte") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("no zero byte") { }; }

    little := new byte_buffer().little_endian();
    little.put_string_prefixed("hi");
    test("prefix follows byte order") { expect(hex_of(little)).should_be("020000006869"); };
    test("little prefixed") { expect(little.get_string_prefixed()).should_be("hi"); };

    raw := new _int8[3];
    raw[0] = 9; raw[1] = 0; raw[2] = 200;
    wrapped := byte_buffer.wrap(raw);
    test("wrap size") { expect(wrapped.size()).should_be(3); };
    test("wrap position") { expect(wrapped.position()).should_be(0); };
    raw[0] = 1;
    test("wrap copies") { expect(wrapped.get_uint8()).should_be(9); };
    part := wrapped.get_bytes(2);
    test("get_bytes size") { expect(sizeof(part)).should_be(2); };
    test("get_bytes content") { expect(part[1] & 0xff).should_be(200); };
    test("wrap(null)") { expect(byte_buffer.wrap(null).size()).should_be(0); };
    test("from_string") { expect(hex_of(byte_buffer.from_string("AB"))).should_be("4142"); };
    test("from empty string") { expect(byte_buffer.from_string("").size()).should_be(0); };

    a := byte_buffer.from_string("xyz");
    b := new byte_buffer();
    b.put_bytes(null).put_buffer(a).put_buffer(a);
    test("put_buffer") { expect(b.to_string()!!).should_be("xyzxyz"); };
    test("same_bytes") { expect_true(a.same_bytes(byte_buffer.from_string("xyz"))); };
    test("same_bytes different") { expect_false(a.same_bytes(b)); };
    test("to_array") { expect(sizeof(b.to_array())).should_be(6); };

    // to a file and back
    target := new file(base_dir + "/buffer.bin");
    all := new byte_buffer();
    for(i : decimal = 0; i < 256; i++) {
        all.put_int8(i);
    }
    all.put_float64(2.5).put_string_prefixed("tail");
    all.write_to(target);
    test("file length") { expect(target.size()).should_be(272); };
    loaded := byte_buffer.from_file(target);
    test("file round trip") { expect_true(loaded.same_bytes(all)); };
    loaded.skip(256);
    test("double from file") { expect(loaded.get_float64()).should_be(2.5); };
    test("string from file") { expect(loaded.get_string_prefixed()).should_be("tail"); };
    new byte_buffer().write_to(target);
    test("empty buffer writes an empty file") { expect(target.size()).should_be(0); };
    test("empty file loads an empty buffer") { expect(byte_buffer.from_file(target).size()).should_be(0); };
    try { byte_buffer.from_file(new file(base_dir + "/missing.bin")); test("load missing") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("load missing") { }; }
}

def test_writer_reader() {
    out := new binary_writer();
    out.write_bool(true).write_bool(false).write_byte(200).write_short(0 - 2).write_int(123456789)
        .write_long(0 - 5000000000).write_double(0.75).write_string("player one").write_string("");
    names := new list<string>();
    names.add("a"); names.add(""); names.add("ccc");
    out.write_string_list(names).write_string_list(new list<string>());
    raw := new _int8[2];
    raw[0] = 7; raw[1] = 8;
    out.write_bytes(raw).write_bytes(null);
    test("size") { expect(out.size()).should_be(50); };

    input := new binary_reader(out.to_array());
    test("has_more") { expect_true(input.has_more()); };
    test("bool true") { expect_true(input.read_bool()); };
    test("bool false") { expect_false(input.read_bool()); };
    test("unsigned byte") { expect(input.read_unsigned_byte()).should_be(200); };
    test("short") { expect(input.read_short()).should_be(0 - 2); };
    test("int") { expect(input.read_int()).should_be(123456789); };
    test("long") { expect(input.read_long()).should_be(0 - 5000000000); };
    test("double") { expect(input.read_double()).should_be(0.75); };
    test("string") { expect(input.read_string()).should_be("player one"); };
    test("empty string") { expect(input.read_string()).should_be(""); };
    back := input.read_string_list();
    test("list size") { expect(back.size()).should_be(3); };
    test("list 0") { expect(back.at(0)).should_be("a"); };
    test("list 1") { expect(back.at(1)).should_be(""); };
    test("list 2") { expect(back.at(2)).should_be("ccc"); };
    test("empty list") { expect(input.read_string_list().size()).should_be(0); };
    bytes := input.read_bytes();
    test("bytes size") { expect(sizeof(bytes)).should_be(2); };
    test("bytes content") { expect(bytes[1]).should_be(8); };
    test("null bytes") { expect_null(input.read_bytes()); };
    test("remaining") { expect(input.remaining()).should_be(0); };
    test("has_more at end") { expect_false(input.has_more()); };
    try { input.read_int(); test("read past end") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("read past end") { }; }

    // varints: sizes and values
    v := new binary_writer();
    v.write_varint(0);
    test("varint 0 is one byte") { expect(v.size()).should_be(1); };
    v.write_varint(127);
    test("varint 127 is one byte") { expect(v.size()).should_be(2); };
    v.write_varint(128);
    test("varint 128 is two bytes") { expect(v.size()).should_be(4); };
    v.write_varint(300);
    test("varint layout") { expect(hex_of(v.get_buffer())).should_be("007f8001ac02"); };
    v.write_varint(16384).write_varint(4294967296).write_varint(9007199254740992);
    v.write_signed_varint(0).write_signed_varint(0 - 1).write_signed_varint(1).write_signed_varint(0 - 64).write_signed_varint(1000000).write_signed_varint(0 - 4503599627370496);
    vr := new binary_reader(v.get_buffer());
    test("read varint 0") { expect(vr.read_varint()).should_be(0); };
    test("read varint 127") { expect(vr.read_varint()).should_be(127); };
    test("read varint 128") { expect(vr.read_varint()).should_be(128); };
    test("read varint 300") { expect(vr.read_varint()).should_be(300); };
    test("read varint 16384") { expect(vr.read_varint()).should_be(16384); };
    test("read varint 2^32") { expect(vr.read_varint()).should_be(4294967296); };
    test("read varint 2^53") { expect(vr.read_varint()).should_be(9007199254740992); };
    test("signed 0") { expect(vr.read_signed_varint()).should_be(0); };
    test("signed -1") { expect(vr.read_signed_varint()).should_be(0 - 1); };
    test("signed 1") { expect(vr.read_signed_varint()).should_be(1); };
    test("signed -64") { expect(vr.read_signed_varint()).should_be(0 - 64); };
    test("signed million") { expect(vr.read_signed_varint()).should_be(1000000); };
    test("signed -2^52") { expect(vr.read_signed_varint()).should_be(0 - 4503599627370496); };
    try { v.write_varint(0 - 1); test("negative varint") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("negative varint") { }; }
    try { v.write_varint(1.5); test("fractional varint") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("fractional varint") { }; }
    try { v.write_signed_varint(0.5); test("fractional signed varint") { fail_test("no exception"); }; }
    catch(e: illegal_argument_exception) { test("fractional signed varint") { }; }

    // damaged data
    bad := new byte_buffer();
    bad.put_int8(2);
    try { new binary_reader(bad).read_bool(); test("bad bool") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("bad bool") { }; }
    endless := new byte_buffer();
    for(i : decimal = 0; i < 12; i++) {
        endless.put_int8(255);
    }
    try { new binary_reader(endless).read_varint(); test("endless varint") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("endless varint") { }; }
    cut := new byte_buffer();
    cut.put_int8(0x85);
    try { new binary_reader(cut).read_varint(); test("varint cut off") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("varint cut off") { }; }
    liar := new byte_buffer();
    liar.put_int8(50).put_int8(1).put_int8('x');
    try { new binary_reader(liar).read_string_list(); test("list count too large") { fail_test("no exception"); }; }
    catch(e: io_exception) { test("list count too large") { }; }
    liar.rewind();
    try { new binary_reader(liar).read_string(); test("string cut off") { fail_test("no exception"); }; }
    catch(e: out_of_bounds_exception) { test("string cut off") { }; }

    // little endian through writer and reader, and a file
    le_buf := new byte_buffer().little_endian();
    le := new binary_writer(le_buf);
    le.write_int(1).write_string("le");
    test("writer uses the order of its buffer") { expect(hex_of(le_buf)).should_be("01000000026c65"); };
    target := new file(base_dir + "/save.dat");
    out.save(target);
    test("saved size") { expect(target.size()).should_be(50); };
    loaded := binary_reader.load(target);
    loaded.skip(3);
    test("loaded short") { expect(loaded.read_short()).should_be(0 - 2); };
    test("loaded int") { expect(loaded.read_int()).should_be(123456789); };
    test("unsigned reads") { expect(new binary_reader(byte_buffer.from_string("\n")).read_byte()).should_be(10); };
    u := new byte_buffer();
    u.put_int16(65535).put_int32(4294967295);
    ur := new binary_reader(u);
    test("read_unsigned_short") { expect(ur.read_unsigned_short()).should_be(65535); };
    test("read_unsigned_int") { expect(ur.read_unsigned_int()).should_be(4294967295); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_io_binary") {
        start := new file(base_dir);
        start.delete_recursively();
        test("test directory created") { expect_true(start.mkdirs()); };

        test_bytes();
        test_numbers();
        test_floats();
        test_strings();
        test_writer_reader();

        test("cleanup") { expect_true(start.delete_recursively()); };
    };
    finish_tests("lib_io_binary");
}
