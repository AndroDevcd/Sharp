mod main;

import ( testing )

/**
 * Generics: a class written once with a type left open (`box<T>`) and used
 * with the type filled in (`box<decimal>`, `box<string>`, `box<point>`). The
 * open type can be used for fields, parameters, return values, arrays and
 * for other generic classes.
 *
 * (Two closing brackets in a row are written `> >`, see
 * known_bugs/generics.sharp.)
 */

class point {
    x : decimal = 0;
    y : decimal = 0;

    point(px: decimal, py: decimal) {
        x = px;
        y = py;
    }

    def sum(): decimal {
        return x + y;
    }
}

class named_point base point {
    name : string = "";

    named_point(name: string, px: decimal, py: decimal) -> base(px, py) {
        self->name = name;
    }
}

/* one type parameter */
class box<T> {
    item : T;
    puts : decimal = 0;

    box(first: T) {
        item = first;
    }

    def take(): T {
        return item;
    }

    def put(next: T) {
        item = next;
        puts++;
    }

    /* gives back what was there before */
    def swap(next: T): T {
        before : T = item;
        item = next;
        return before;
    }

    def copy_from(other: box<T>) {
        item = other.item;
    }
}

/* two type parameters */
class pair_of<A, B> {
    first : A;
    second : B;

    pair_of(a: A, b: B) {
        first = a;
        second = b;
    }

    def get_first(): A {
        return first;
    }

    def get_second(): B {
        return second;
    }

    def set_both(a: A, b: B) {
        first = a;
        second = b;
    }

    /* a method whose result is the same generic class with the types the other way round */
    def flipped(): pair_of<B, A> {
        return new pair_of<B, A>(second, first);
    }
}

/* three type parameters */
class triple_of<A, B, C> {
    one : A;
    two : B;
    three : C;

    triple_of(a: A, b: B, c: C) {
        one = a;
        two = b;
        three = c;
    }
}

/* an array of the open type */
class stack_of<T> {
    items : T[];
    count : decimal = 0;

    stack_of(capacity: decimal) {
        items = new T[capacity];
    }

    def push(item: T) {
        items[count] = item;
        count++;
    }

    def pop(): T {
        count--;
        return items[count];
    }

    def peek(): T {
        return items[count - 1];
    }

    def at(index: decimal): T {
        return items[index];
    }

    def is_empty(): decimal {
        return count == 0;
    }
}

/* a generic class that uses another generic class with its own type */
class history_of<T> {
    current : box<T>;
    older : stack_of<T>;

    history_of(first: T) {
        current = new box<T>(first);
        older = new stack_of<T>(8);
    }

    def change(next: T) {
        older.push(current.take());
        current.put(next);
    }

    def undo() {
        current.put(older.pop());
    }

    def now(): T {
        return current.take();
    }
}

/* the open type must be point or a class below it, so its members can be used */
class point_holder<T base point> {
    held : T;

    point_holder(p: T) {
        held = p;
    }

    def held_sum(): decimal {
        return held.x + held.y;
    }

    def give(): T {
        return held;
    }
}

def unbox(b: box<decimal>): decimal {
    return b.take();
}

def boxed_point(x: decimal, y: decimal): box<point> {
    return new box<point>(new point(x, y));
}

def main(args: string[]) {
    // ---- a native number as the type
    numbers := new box<decimal>(7);
    expect("box<var>: the first item", numbers.take(), 7);
    numbers.put(8.5);
    expect("box<var>: after put", numbers.take(), 8.5);
    expect("box<var>: the field itself", numbers.item, 8.5);
    expect("box<var>: swap gives the old item", numbers.swap(100), 8.5);
    expect("box<var>: ...and stores the new one", numbers.take(), 100);
    expect("box<var>: a method that only counts", numbers.puts, 1);
    expect("box<var>: the result in arithmetic", numbers.take() * 2 + 1, 201);

    // ---- sized numbers keep their size inside the generic class
    bytes := new box<_int8>(100);
    expect("box<_int8>: holds 100", bytes.take(), 100);
    bytes.put(200);
    expect("box<_int8>: 200 wraps to -56", bytes.take(), 0 - 56);
    words := new box<_int16>(32767);
    expect("box<_int16>: holds 32767", words.take(), 32767);
    words.put(32768);
    expect("box<_int16>: 32768 wraps to -32768", words.take(), 0 - 32768);
    ints := new box<_int32>(2147483647);
    expect("box<_int32>: holds 2147483647", ints.take(), 2147483647);
    ints.put(2147483648);
    expect("box<_int32>: 2147483648 wraps to -2147483648", ints.take(), 0 - 2147483648);
    unsigned := new box<_uint8>(255);
    unsigned.put(256);
    expect("box<_uint8>: 256 wraps to 0", unsigned.take(), 0);
    numbers.put(0.25);
    expect("box<var> next to them still holds a fraction", numbers.take(), 0.25);

    // ---- a class as the type
    points := new box<point>(new point(3, 4));
    expect("box<point>: a field of the item", points.take().x, 3);
    expect("box<point>: a method of the item", points.take().sum(), 7);
    replaced := points.swap(new point(10, 20));
    expect("box<point>: swap gives the old object", replaced.sum(), 7);
    expect("box<point>: ...and stores the new one", points.item.y, 20);
    same_point := new point(1, 1);
    points.put(same_point);
    expect("box<point>: the object itself is stored, not a copy", points.take() == same_point, 1);
    same_point.x = 50;
    expect("...so a change to it is seen through the box", points.take().x, 50);

    // ---- a string and a boxed number as the type
    texts := new box<string>("first");
    expect_str("box<string>: the first item", texts.take(), "first");
    texts.put("second");
    expect_str("box<string>: after put", texts.take(), "second");
    expect_str("box<string>: swap", texts.swap("third"), "second");
    expect("box<string>: a method of the item", texts.take().size(), 5);
    wrapped := new box<int>(new int(41));
    expect("box<int>: the number inside the int object", wrapped.take().value, 41);

    // ---- each use of the class is separate
    box_one := new box<decimal>(1);
    box_two := new box<decimal>(2);
    box_one.put(11);
    expect("two boxes of the same type: first", box_one.take(), 11);
    expect("two boxes of the same type: second", box_two.take(), 2);
    box_two.copy_from(box_one);
    expect("a parameter of the class's own generic type", box_two.take(), 11);
    expect("a generic object as a function parameter", unbox(box_one), 11);
    expect("a generic object as a function result", boxed_point(5, 6).take().sum(), 11);

    // ---- two type parameters
    p := new pair_of<decimal, string>(1, "one");
    expect("pair_of<var, string>: first", p.first, 1);
    expect_str("pair_of<var, string>: second", p.second, "one");
    expect("pair_of: method returning the first type", p.get_first(), 1);
    expect_str("pair_of: method returning the second type", p.get_second(), "one");
    p.set_both(2, "two");
    expect("pair_of: method taking both types, first", p.first, 2);
    expect_str("pair_of: method taking both types, second", p.second, "two");
    f := p.flipped();
    expect_str("flipped: the string is now first", f.first, "two");
    expect("flipped: the number is now second", f.second, 2);
    expect("flipped twice is the original order", f.flipped().get_first(), 2);
    q := new pair_of<point, point>(new point(1, 2), new point(3, 4));
    expect("pair_of<point, point>: first", q.first.sum(), 3);
    expect("pair_of<point, point>: second", q.second.sum(), 7);
    same_types := new pair_of<decimal, decimal>(8, 9);
    expect("pair_of<var, var>: first", same_types.first, 8);
    expect("pair_of<var, var>: second", same_types.flipped().first, 9);
    mixed := new pair_of<string, point>("origin", new point(0, 0));
    expect_str("pair_of<string, point>: first", mixed.first, "origin");
    expect("pair_of<string, point>: second", mixed.second.sum(), 0);

    // ---- three type parameters
    t := new triple_of<decimal, string, point>(1, "two", new point(3, 3));
    expect("triple_of: first", t.one, 1);
    expect_str("triple_of: second", t.two, "two");
    expect("triple_of: third", t.three.sum(), 6);

    // ---- an array of the open type
    stack := new stack_of<decimal>(10);
    expect("stack_of<var>: empty at first", stack.is_empty(), 1);
    stack.push(3);
    stack.push(6);
    stack.push(9);
    expect("stack_of<var>: count", stack.count, 3);
    expect("stack_of<var>: peek", stack.peek(), 9);
    expect("stack_of<var>: at(0)", stack.at(0), 3);
    expect("stack_of<var>: pop", stack.pop(), 9);
    expect("stack_of<var>: pop again", stack.pop(), 6);
    expect("stack_of<var>: one left", stack.count, 1);
    expect("stack_of<var>: not empty", stack.is_empty(), 0);
    for(i : decimal = 0; i < 9; i++) {
        stack.push(i * i);
    }
    expect("stack_of<var>: filled in a loop", stack.count, 10);
    expect("stack_of<var>: the last one pushed", stack.peek(), 64);
    object_stack := new stack_of<point>(4);
    object_stack.push(new point(1, 1));
    object_stack.push(new point(2, 2));
    expect("stack_of<point>: pop", object_stack.pop().sum(), 4);
    expect("stack_of<point>: pop again", object_stack.pop().sum(), 2);
    expect("stack_of<point>: empty", object_stack.is_empty(), 1);
    string_stack := new stack_of<string>(4);
    string_stack.push("bottom");
    string_stack.push("top");
    expect_str("stack_of<string>: pop", string_stack.pop(), "top");
    expect_str("stack_of<string>: peek", string_stack.peek(), "bottom");

    // ---- a generic class as the type of another
    nested := new box<box<decimal> >(new box<decimal>(3));
    expect("box<box<var> >: the inner item", nested.take().take(), 3);
    nested.take().put(4);
    expect("box<box<var> >: changed through the outer box", nested.take().take(), 4);
    pair_box := new box<pair_of<decimal, string> >(new pair_of<decimal, string>(5, "five"));
    expect("box<pair_of<var, string> >: first", pair_box.take().first, 5);
    expect_str("box<pair_of<var, string> >: second", pair_box.take().second, "five");
    stack_of_boxes := new stack_of<box<decimal> >(3);
    stack_of_boxes.push(box_one);
    stack_of_boxes.push(box_two);
    expect("stack_of<box<var> >: count", stack_of_boxes.count, 2);
    expect("stack_of<box<var> >: the same object comes back", stack_of_boxes.at(0) == box_one, 1);

    // ---- a generic class built from other generic classes
    h := new history_of<decimal>(1);
    h.change(2);
    h.change(3);
    expect("history_of<var>: now", h.now(), 3);
    h.undo();
    expect("history_of<var>: after one undo", h.now(), 2);
    h.undo();
    expect("history_of<var>: after two undos", h.now(), 1);
    names := new history_of<string>("draft");
    names.change("final");
    expect_str("history_of<string>: now", names.now(), "final");
    names.undo();
    expect_str("history_of<string>: after undo", names.now(), "draft");

    // ---- an open type that must be a certain class
    holder := new point_holder<point>(new point(2, 3));
    expect("point_holder<point>: uses the point's fields", holder.held_sum(), 5);
    named := new point_holder<named_point>(new named_point("corner", 7, 8));
    expect("point_holder<named_point>: uses the inherited fields", named.held_sum(), 15);
    expect_str("point_holder<named_point>: gives back the full type", named.give().name, "corner");

    finish("generics");
}
