mod main;

import ( testing, std.collections )

/**
 * Generic functions declared in a library module (std/collection_functions.sharp:
 * `list_of<T>` and the functions of a list that name a second type, `map<R>`)
 * and used from another one: the instance is made in the library's module, and
 * its body goes through the lazy library compilation.
 */
def main(args: string[]) {
    words := list_of<string>(new string[] { "alpha", "beta" });
    expect("list_of<string> size", words.size(), 2);
    expect_str("list_of<string> first", words.at(0), "alpha");
    empty := list_of<string>(null);
    expect("list_of<string> of nothing", empty.size(), 0);

    lengths := words.map<int>({ s: string -> (int) return s.size(); });
    expect("map<int>", lengths.at(0).value + lengths.at(1).value, 9);
    shouted := words.map<string>() { it + "!" };
    expect_str("map with a trailing lambda", shouted.at(1), "beta!");

    numbers := list_of<int>(new int[] { 4, 5 });
    doubled := numbers.map<int>() { it * 2 };
    expect("map<int> of a list<int>", doubled.at(0).value + doubled.at(1).value, 18);
    expect("called through the module name", std#list_of<int>(new int[] { 4, 5 }).at(0).value, 4);
    finish("generic_functions_library");
}
