mod main;
import ( std.testing, std.math )

/**
 * sqrt() is one instruction of the runtime (`dsqrt`), and with -O a call of
 * it becomes that instruction where it is written. The same answers must
 * come out of the interpreter, the JIT, and the optimizer's version.
 */

/** many square roots in one loop: long enough for the JIT to take the loop over */
def sum_of_roots(count: _int64) : decimal {
    sum : decimal = 0;
    for(i : _int64 = 1; i <= count; i++) {
        sum += sqrt(i * i);
    }
    return sum;
}

/** the same root asked for in every round: the optimizer may take it once, before the loop */
def same_root(count: _int64, of: decimal) : decimal {
    sum : decimal = 0;
    for(i : _int64 = 0; i < count; i++) {
        sum += sqrt(of);
    }
    return sum;
}

def length_of(x: decimal, y: decimal, z: decimal) : decimal {
    return sqrt(x * x + y * y + z * z);
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_math_sqrt_instruction") {
        test("sqrt(16)") { expect(sqrt(16)).should_be(4); };
        test("sqrt(0)") { expect(sqrt(0)).should_be(0); };
        test("sqrt(1)") { expect(sqrt(1)).should_be(1); };
        test("sqrt(2)") { expect(sqrt(2)).should_be(1.4142135623730951); };
        test("sqrt(0.25)") { expect(sqrt(0.25)).should_be(0.5); };
        test("sqrt of ten thousand million") { expect(sqrt(10000000000)).should_be(100000); };
        test("sqrt of a negative number is NaN") { expect_true(is_nan(sqrt(0 - 1))); };
        test("sqrt of NaN is NaN") { expect_true(is_nan(sqrt(NaN))); };
        test("sqrt of a variable") {
            v : decimal = 81;
            expect(sqrt(v)).should_be(9);
        };
        test("sqrt of a whole number variable") {
            n : _int64 = 49;
            expect(sqrt(n)).should_be(7);
        };
        test("sqrt inside an expression") { expect(sqrt(9) * sqrt(4) + 1).should_be(7); };
        test("sqrt of sqrt") { expect(sqrt(sqrt(81))).should_be(3); };
        test("the length of (3, 4, 12)") { expect(length_of(3, 4, 12)).should_be(13); };
        test("a result nobody reads") {
            sqrt(4);
            expect_true(true);
        };
        test("a hundred thousand roots in a loop") { expect(sum_of_roots(100000)).should_be(5000050000); };
        test("the same root in every round") { expect(same_root(1000, 6.25)).should_be(2500); };
        test("the same root, no rounds") { expect(same_root(0, 0 - 1)).should_be(0); };
    };
    finish_tests("lib_math_sqrt_instruction");
}
