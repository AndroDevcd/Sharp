mod main;

import ( std.testing, std.math )

/**
 * std.math - linear algebra: vector2, vector3 and matrix
 * (lib/support/0.4.0/std/math/linear/).
 */

def check_vector2() {
    a := new vector2(3, 4);
    b := new vector2(1, 0 - 2);

    test("default constructor x") { expect(new vector2().x).should_be(0); };
    test("copy constructor") { expect(new vector2(a).y).should_be(4); };
    test("zero") { expect(vector2.zero().x + vector2.zero().y).should_be(0); };
    test("one") { expect(vector2.one().x + vector2.one().y).should_be(2); };
    test("unit_x") { expect(vector2.unit_x().x).should_be(1); };
    test("unit_y") { expect(vector2.unit_y().y).should_be(1); };

    sum := a + b;
    test("a + b: x") { expect(sum.x).should_be(4); };
    test("a + b: y") { expect(sum.y).should_be(2); };
    difference := a - b;
    test("a - b: x") { expect(difference.x).should_be(2); };
    test("a - b: y") { expect(difference.y).should_be(6); };
    negated := -a;
    test("-a: x") { expect(negated.x).should_be(0 - 3); };
    test("-a: y") { expect(negated.y).should_be(0 - 4); };
    scaled := a * 2;
    test("a * 2: x") { expect(scaled.x).should_be(6); };
    test("a * 2: y") { expect(scaled.y).should_be(8); };
    halved := a / 2;
    test("a / 2: x") { expect(halved.x).should_be(1.5); };
    test("a / 2: y") { expect(halved.y).should_be(2); };
    test("operands are unchanged") { expect(a.x * 10 + a.y).should_be(34); };
    test("==") { expect_true((a == new vector2(3, 4))); };
    test("== different") { expect_false((a == b)); };
    test("!=") { expect_true((a != b)); };
    test("a[0]") { expect(a[0]).should_be(3); };
    test("a[1]") { expect(a[1]).should_be(4); };
    try {
        a[2];
        test("a[2]") { fail_test("no exception"); };
    } catch(e: out_of_bounds_exception) {
        test("a[2] throws") { };
    }
    try {
        a / 0;
        test("a / 0") { fail_test("no exception"); };
    } catch(e: division_by_zero_exception) {
        test("a / 0 throws") { };
    }

    test("dot") { expect(a.dot(b)).should_be(0 - 5); };
    test("cross") { expect(a.cross(b)).should_be(0 - 10); };
    test("length") { expect(a.length()).should_be(5); };
    test("length_squared") { expect(a.length_squared()).should_be(25); };
    test("distance_to") { expect(a.distance_to(new vector2(0, 0))).should_be(5); };
    test("distance_squared_to") { expect(a.distance_squared_to(b)).should_be(40); };
    test("is_zero") { expect_true(vector2.zero().is_zero()); };
    test("is_zero of a") { expect_false(a.is_zero()); };

    unit := a.normalized();
    test("normalized x") { expect(unit.x).should_be_near(0.6, 0.000000000001); };
    test("normalized y") { expect(unit.y).should_be_near(0.8, 0.000000000001); };
    try {
        vector2.zero().normalized();
        test("normalize zero") { fail_test("no exception"); };
    } catch(e: arithmetic_exception) {
        test("normalize zero throws") { };
    }

    test("angle of (0, 1)") { expect(vector2.unit_y().angle()).should_be_near(HALF_PI, 0.000000000001); };
    test("angle of (-1, 0)") { expect(new vector2(0 - 1, 0).angle()).should_be_near(PI_VALUE, 0.000000000001); };
    test("angle_to") { expect(vector2.unit_x().angle_to(vector2.unit_y())).should_be_near(HALF_PI, 0.000000000001); };
    test("angle_to clockwise") { expect(vector2.unit_y().angle_to(vector2.unit_x())).should_be_near(0 - HALF_PI, 0.000000000001); };
    turned := vector2.unit_x().rotated(HALF_PI);
    test("rotated x") { expect(turned.x).should_be_near(0, 0.000000000001); };
    test("rotated y") { expect(turned.y).should_be_near(1, 0.000000000001); };
    polar := vector2.from_angle(PI_VALUE, 2);
    test("from_angle x") { expect(polar.x).should_be_near(0 - 2, 0.000000000001); };
    test("from_angle y") { expect(polar.y).should_be_near(0, 0.000000000001); };
    side := a.perpendicular();
    test("perpendicular x") { expect(side.x).should_be(0 - 4); };
    test("perpendicular y") { expect(side.y).should_be(3); };
    test("perpendicular dot is 0") { expect(a.dot(side)).should_be(0); };

    middle := a.lerp(b, 0.5);
    test("lerp x") { expect(middle.x).should_be(2); };
    test("lerp y") { expect(middle.y).should_be(1); };
    product := a.scaled_by(b);
    test("scaled_by x") { expect(product.x).should_be(3); };
    test("scaled_by y") { expect(product.y).should_be(0 - 8); };
    shadow := a.project_on(new vector2(2, 0));
    test("project_on x") { expect(shadow.x).should_be(3); };
    test("project_on y") { expect(shadow.y).should_be(0); };
    try {
        a.project_on(vector2.zero());
        test("project on zero") { fail_test("no exception"); };
    } catch(e: arithmetic_exception) {
        test("project on zero throws") { };
    }
    bounced := new vector2(1, 0 - 1).reflect(vector2.unit_y());
    test("reflect x") { expect(bounced.x).should_be(1); };
    test("reflect y") { expect(bounced.y).should_be(1); };
    test("abs") { expect(b.abs().y).should_be(2); };
    test("component_min x") { expect(a.component_min(b).x).should_be(1); };
    test("component_min y") { expect(a.component_min(b).y).should_be(0 - 2); };
    test("component_max x") { expect(a.component_max(b).x).should_be(3); };
    test("component_max y") { expect(a.component_max(b).y).should_be(4); };
    test("approx_equals") { expect_true(a.approx_equals(new vector2(3.0000001, 3.9999999), 0.000001)); };
    test("approx_equals too far") { expect_false(a.approx_equals(new vector2(3.1, 4), 0.000001)); };
    numbers := a.to_array();
    test("to_array size") { expect(sizeof(numbers)).should_be(2); };
    test("to_array content") { expect(numbers[0] * 10 + numbers[1]).should_be(34); };
    test("to_string") { expect(a.to_string()!!).should_be("(3, 4)"); };
    test("to_string with fraction") { expect(new vector2(0 - 0.5, 2.25).to_string()!!).should_be("(-0.5, 2.25)"); };
    test("equal vectors have equal hashes") { expect_true((a.hash() == new vector2(3, 4).hash())); };
}

def check_vector3() {
    a := new vector3(1, 2, 3);
    b := new vector3(4, 0 - 5, 6);

    test("default constructor") { expect(new vector3().z).should_be(0); };
    test("copy constructor") { expect(new vector3(a).z).should_be(3); };
    test("from vector2") { expect(new vector3(new vector2(7, 8), 9).y).should_be(8); };
    test("zero") { expect(vector3.zero().length()).should_be(0); };
    test("one") { expect(vector3.one().z).should_be(1); };
    test("unit_z") { expect(vector3.unit_z().z).should_be(1); };

    sum := a + b;
    test("a + b") { expect(sum.x * 100 + sum.y * 10 + sum.z).should_be(479); };          // (5, -3, 9)
    difference := a - b;
    test("a - b: x") { expect(difference.x).should_be(0 - 3); };
    test("a - b: y") { expect(difference.y).should_be(7); };
    test("a - b: z") { expect(difference.z).should_be(0 - 3); };
    negated := -a;
    test("-a: z") { expect(negated.z).should_be(0 - 3); };
    scaled := a * 3;
    test("a * 3") { expect(scaled.x * 100 + scaled.y * 10 + scaled.z).should_be(369); };
    halved := a / 2;
    test("a / 2: y") { expect(halved.y).should_be(1); };
    test("a / 2: z") { expect(halved.z).should_be(1.5); };
    test("==") { expect_true((a == new vector3(1, 2, 3))); };
    test("!=") { expect_true((a != b)); };
    test("a[2]") { expect(a[2]).should_be(3); };
    try {
        a[3];
        test("a[3]") { fail_test("no exception"); };
    } catch(e: out_of_bounds_exception) {
        test("a[3] throws") { };
    }
    try {
        a / 0;
        test("a / 0") { fail_test("no exception"); };
    } catch(e: division_by_zero_exception) {
        test("a / 0 throws") { };
    }

    test("dot") { expect(a.dot(b)).should_be(12); };                                      // 4 - 10 + 18
    cross := a.cross(b);
    test("cross x") { expect(cross.x).should_be(27); };                                   // 2*6 - 3*(-5)
    test("cross y") { expect(cross.y).should_be(6); };                                    // 3*4 - 1*6
    test("cross z") { expect(cross.z).should_be(0 - 13); };                               // 1*(-5) - 2*4
    test("cross is perpendicular to a") { expect(cross.dot(a)).should_be(0); };
    test("cross is perpendicular to b") { expect(cross.dot(b)).should_be(0); };
    z := vector3.unit_x().cross(vector3.unit_y());
    test("x cross y is z") { expect(z.z).should_be(1); };
    test("length") { expect(new vector3(2, 3, 6).length()).should_be(7); };
    test("length_squared") { expect(a.length_squared()).should_be(14); };
    test("distance_to") { expect(new vector3(1, 1, 1).distance_to(new vector3(3, 4, 7))).should_be(7); };
    test("distance_squared_to") { expect(a.distance_squared_to(b)).should_be(67); };     // 9 + 49 + 9
    test("is_zero") { expect_true(vector3.zero().is_zero()); };

    unit := new vector3(0, 3, 4).normalized();
    test("normalized y") { expect(unit.y).should_be_near(0.6, 0.000000000001); };
    test("normalized z") { expect(unit.z).should_be_near(0.8, 0.000000000001); };
    try {
        vector3.zero().normalized();
        test("normalize zero") { fail_test("no exception"); };
    } catch(e: arithmetic_exception) {
        test("normalize zero throws") { };
    }
    test("angle_to") { expect(vector3.unit_x().angle_to(vector3.unit_z())).should_be_near(HALF_PI, 0.000000000001); };
    test("angle_to itself") { expect(a.angle_to(a)).should_be_near(0, 0.000000000001); };

    middle := a.lerp(b, 0.5);
    test("lerp x") { expect(middle.x).should_be(2.5); };
    test("lerp y") { expect(middle.y).should_be(0 - 1.5); };
    test("lerp z") { expect(middle.z).should_be(4.5); };
    test("scaled_by y") { expect(a.scaled_by(b).y).should_be(0 - 10); };
    shadow := a.project_on(new vector3(0, 0, 2));
    test("project_on z") { expect(shadow.z).should_be(3); };
    test("project_on x") { expect(shadow.x).should_be(0); };
    bounced := new vector3(1, 0 - 1, 2).reflect(vector3.unit_y());
    test("reflect y") { expect(bounced.y).should_be(1); };
    test("reflect z") { expect(bounced.z).should_be(2); };
    test("abs") { expect(b.abs().y).should_be(5); };
    test("component_min y") { expect(a.component_min(b).y).should_be(0 - 5); };
    test("component_max y") { expect(a.component_max(b).y).should_be(2); };
    test("approx_equals") { expect_true(a.approx_equals(new vector3(1, 2, 3.0000001), 0.000001)); };
    test("to_vector2") { expect(a.to_vector2().y).should_be(2); };
    test("to_array") { expect(sizeof(a.to_array())).should_be(3); };
    test("to_string") { expect(a.to_string()!!).should_be("(1, 2, 3)"); };
}

def check_matrix() {
    m := new matrix(2, 3, new decimal[] { 1, 2, 3, 4, 5, 6 });
    test("rows") { expect(m.rows).should_be(2); };
    test("columns") { expect(m.columns).should_be(3); };
    test("at(0, 0)") { expect(m.at(0, 0)).should_be(1); };
    test("at(1, 2)") { expect(m.at(1, 2)).should_be(6); };
    test("at(1, 0)") { expect(m.at(1, 0)).should_be(4); };
    test("2 x 3 is not square") { expect_false(m.is_square()); };
    test("size_text") { expect(m.size_text()).should_be("2 x 3"); };
    test("to_string") { expect(m.to_string()!!).should_be("[[1, 2, 3], [4, 5, 6]]"); };

    empty := new matrix(2, 2);
    test("new matrix is zero") { expect(empty.at(1, 1)).should_be(0); };
    empty.put(1, 0, 9);
    test("put") { expect(empty.at(1, 0)).should_be(9); };
    empty.fill(3);
    test("fill") { expect(empty.at(0, 1) + empty.at(1, 0)).should_be(6); };
    test("filled") { expect(matrix.filled(2, 2, 7).at(1, 1)).should_be(7); };
    duplicate := new matrix(m);
    duplicate.put(0, 0, 100);
    test("a copy is independent") { expect(m.at(0, 0)).should_be(1); };

    id := matrix.identity(3);
    test("identity diagonal") { expect(id.at(0, 0) + id.at(1, 1) + id.at(2, 2)).should_be(3); };
    test("identity elsewhere") { expect(id.at(0, 1) + id.at(2, 0)).should_be(0); };
    diag := matrix.diagonal(new decimal[] { 2, 3 });
    test("diagonal") { expect(diag.at(0, 0) * 10 + diag.at(1, 1)).should_be(23); };
    test("diagonal off cells") { expect(diag.at(0, 1)).should_be(0); };

    row := m.row(1);
    test("row") { expect(row[0] * 100 + row[1] * 10 + row[2]).should_be(456); };
    column := m.column(2);
    test("column") { expect(column[0] * 10 + column[1]).should_be(36); };
    test("to_array") { expect(sizeof(m.to_array())).should_be(6); };

    t := m.transpose();
    test("transpose rows") { expect(t.rows).should_be(3); };
    test("transpose columns") { expect(t.columns).should_be(2); };
    test("transpose (2, 0)") { expect(t.at(2, 0)).should_be(3); };
    test("transpose (0, 1)") { expect(t.at(0, 1)).should_be(4); };

    a := new matrix(2, 2, new decimal[] { 1, 2, 3, 4 });
    b := new matrix(2, 2, new decimal[] { 5, 6, 7, 8 });
    sum := a + b;
    test("a + b") { expect(sum.at(0, 0) + sum.at(1, 1)).should_be(18); };
    difference := b - a;
    test("b - a") { expect(difference.at(0, 1)).should_be(4); };
    negated := -a;
    test("-a") { expect(negated.at(1, 1)).should_be(0 - 4); };
    doubled := a * 2;
    test("a * 2") { expect(doubled.at(1, 0)).should_be(6); };
    product := a * b;                                   // { 19, 22, 43, 50 }
    test("a * b (0, 0)") { expect(product.at(0, 0)).should_be(19); };
    test("a * b (0, 1)") { expect(product.at(0, 1)).should_be(22); };
    test("a * b (1, 0)") { expect(product.at(1, 0)).should_be(43); };
    test("a * b (1, 1)") { expect(product.at(1, 1)).should_be(50); };
    other := b * a;                                     // { 23, 34, 31, 46 }
    test("b * a differs") { expect(other.at(0, 0)).should_be(23); };
    wide := m * t;                                      // 2 x 2: { 14, 32, 32, 77 }
    test("(2 x 3) * (3 x 2) rows") { expect(wide.rows).should_be(2); };
    test("(2 x 3) * (3 x 2) cell") { expect(wide.at(1, 1)).should_be(77); };
    test("(2 x 3) * (3 x 2) cell 2") { expect(wide.at(0, 1)).should_be(32); };
    test("a * identity == a") { expect_true((a * matrix.identity(2) == a)); };
    test("==") { expect_true((a == new matrix(2, 2, new decimal[] { 1, 2, 3, 4 }))); };
    test("!=") { expect_true((a != b)); };
    test("== with another size") { expect_false((a == m)); };
    test("same_size") { expect_true(a.same_size(b)); };
    test("same_size differs") { expect_false(a.same_size(m)); };

    vector := m.multiply_vector(new decimal[] { 1, 0, 2 });
    test("multiply_vector [0]") { expect(vector[0]).should_be(7); };
    test("multiply_vector [1]") { expect(vector[1]).should_be(16); };

    test("trace") { expect(a.trace()).should_be(5); };
    test("determinant 2 x 2") { expect(a.determinant()).should_be(0 - 2); };
    c := new matrix(3, 3, new decimal[] { 2, 0, 1, 1, 3, 2, 1, 1, 1 });
    test("determinant 3 x 3") { expect(c.determinant()).should_be_near(0, 0.000000000001); };     // 2(3-2) - 0 + 1(1-3) = 0
    d := new matrix(3, 3, new decimal[] { 6, 1, 1, 4, 0 - 2, 5, 2, 8, 7 });
    test("determinant 3 x 3 (b)") { expect(d.determinant()).should_be_near(0 - 306, 0.000000001); };
    test("determinant of identity") { expect(matrix.identity(4).determinant()).should_be(1); };
    test("determinant needing a row swap") { expect(new matrix(2, 2, new decimal[] { 0, 1, 1, 0 }).determinant()).should_be(0 - 1); };

    e := new matrix(2, 2, new decimal[] { 4, 7, 2, 6 });
    inv := e.inverse();
    test("inverse (0, 0)") { expect(inv.at(0, 0)).should_be_near(0.6, 0.000000000001); };
    test("inverse (0, 1)") { expect(inv.at(0, 1)).should_be_near(0 - 0.7, 0.000000000001); };
    test("inverse (1, 0)") { expect(inv.at(1, 0)).should_be_near(0 - 0.2, 0.000000000001); };
    test("inverse (1, 1)") { expect(inv.at(1, 1)).should_be_near(0.4, 0.000000000001); };
    test("m * inverse is the identity") { expect_true((e * inv).approx_equals(matrix.identity(2), 0.000000000001)); };
    test("3 x 3 inverse") { expect_true((d * d.inverse()).approx_equals(matrix.identity(3), 0.000000000001)); };
    try {
        c.inverse();
        test("inverse of a singular matrix") { fail_test("no exception"); };
    } catch(e2: arithmetic_exception) {
        test("inverse of a singular matrix throws") { };
    }

    // 2x + y = 5, x + 3y = 10  ->  x = 1, y = 3
    solution := new matrix(2, 2, new decimal[] { 2, 1, 1, 3 }).solve(new decimal[] { 5, 10 });
    test("solve x") { expect(solution[0]).should_be_near(1, 0.000000000001); };
    test("solve y") { expect(solution[1]).should_be_near(3, 0.000000000001); };

    fib := new matrix(2, 2, new decimal[] { 1, 1, 1, 0 }).power(10);     // { F11, F10, F10, F9 }
    test("power: F11") { expect(fib.at(0, 0)).should_be(89); };
    test("power: F10") { expect(fib.at(0, 1)).should_be(55); };
    test("power: F9") { expect(fib.at(1, 1)).should_be(34); };
    test("power(0) is the identity") { expect_true((a.power(0) == matrix.identity(2))); };

    minor := d.minor(0, 0);
    test("minor size") { expect(minor.rows * 10 + minor.columns).should_be(22); };
    test("minor cells") { expect(minor.at(0, 0) * 1000 + minor.at(0, 1) * 100 + minor.at(1, 0) * 10 + minor.at(1, 1)).should_be(0 - 2000 + 500 + 80 + 7); };

    caught : decimal = 0;
    try { new matrix(0, 2); } catch(e3: illegal_argument_exception) { caught++; }
    try { new matrix(2, 2, new decimal[] { 1, 2, 3 }); } catch(e4: illegal_argument_exception) { caught++; }
    try { a + m; } catch(e5: illegal_argument_exception) { caught++; }
    try { a - m; } catch(e6: illegal_argument_exception) { caught++; }
    try { m * m; } catch(e7: illegal_argument_exception) { caught++; }
    try { m.determinant(); } catch(e8: illegal_argument_exception) { caught++; }
    try { m.inverse(); } catch(e9: illegal_argument_exception) { caught++; }
    try { m.trace(); } catch(e10: illegal_argument_exception) { caught++; }
    try { m.multiply_vector(new decimal[] { 1, 2 }); } catch(e11: illegal_argument_exception) { caught++; }
    try { a.power(0 - 1); } catch(e12: illegal_argument_exception) { caught++; }
    test("wrong sizes throw illegal_argument_exception") { expect(caught).should_be(10); };

    caught = 0;
    try { m.at(2, 0); } catch(e13: out_of_bounds_exception) { caught++; }
    try { m.at(0, 3); } catch(e14: out_of_bounds_exception) { caught++; }
    try { m.put(0 - 1, 0, 1); } catch(e15: out_of_bounds_exception) { caught++; }
    try { m.row(2); } catch(e16: out_of_bounds_exception) { caught++; }
    try { m.column(3); } catch(e17: out_of_bounds_exception) { caught++; }
    test("positions outside the matrix throw out_of_bounds_exception") { expect(caught).should_be(5); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_math_linear") {
        check_vector2();
        check_vector3();
        check_matrix();
    };
    finish_tests("lib_math_linear");
}
