mod main;

import ( testing, std.io, std.data )

/**
 * std.data CSV: csv_reader (quotes, separators and line breaks inside
 * fields, custom separator, header, malformed input), csv_row, csv_writer,
 * and round trips write -> read.
 *
 * Works only inside /tmp/sharp_suite_io_csv and removes it at the end.
 */

base_dir : string = "/tmp/sharp_suite_io_csv";

q : string = "\"";

/** the rows as text that shows the structure: fields in [brackets], rows separated by / */
def show(rows: list<csv_row>): string {
    buf := new char_buffer();
    count : decimal = rows.size().value;
    for(r : decimal = 0; r < count; r++) {
        if(r > 0) {
            buf.append_char('/');
        }
        row := rows.at(r);
        for(i : decimal = 0; i < row.size(); i++) {
            buf.append_char('[').append(row.at(i)).append_char(']');
        }
    }
    return buf.to_string()!!;
}

def expect_rows(name: string, text: string, expected: string) {
    expect_str(name, show(csv_reader.parse(text)), expected);
}

def expect_bad(name: string, text: string, line: decimal, column: decimal) {
    try {
        csv_reader.parse(text);
        fail(name, "no exception");
    } catch(e: csv_exception) {
        expect(name + " (line)", e.line, line);
        expect(name + " (column)", e.column, column);
    }
}

def row_of(a: string, b: string, c: string): csv_row {
    row := new csv_row();
    row.add(a).add(b).add(c);
    return row;
}

def test_reader() {
    expect_rows("simple", "a,b,c\n1,2,3\n", "[a][b][c]/[1][2][3]");
    expect_rows("no line end at the end", "a,b\n1,2", "[a][b]/[1][2]");
    expect_rows("crlf", "a,b\r\n1,2\r\n", "[a][b]/[1][2]");
    expect_rows("cr only", "a,b\r1,2\r", "[a][b]/[1][2]");
    expect_rows("empty fields", "a,,c\n,,\n", "[a][][c]/[][][]");
    expect_rows("empty field at the end of the text", "a,", "[a][]");
    expect_rows("one field", "alone", "[alone]");
    expect_rows("empty text", "", "");
    expect_rows("only line ends", "\n\r\n\n", "");
    expect_rows("empty lines skipped", "a\n\n\nb\n", "[a]/[b]");
    expect_rows("spaces kept", " a , b ", "[ a ][ b ]");
    expect_rows("ragged rows", "a\nb,c\nd,e,f\n", "[a]/[b][c]/[d][e][f]");

    expect_rows("quoted", q + "a" + q + "," + q + "b" + q, "[a][b]");
    expect_rows("separator in quotes", q + "Smith, John" + q + ",41", "[Smith, John][41]");
    expect_rows("doubled quote", q + "say " + q + q + "hi" + q + q + q, "[say " + q + "hi" + q + "]");
    expect_rows("only a doubled quote", q + q + q + q, "[" + q + "]");
    expect_rows("empty quoted field", q + q + ",x", "[][x]");
    expect_rows("line break in quotes", q + "line1\nline2" + q + ",x\nnext,y", "[line1\nline2][x]/[next][y]");
    expect_rows("crlf in quotes kept", q + "a\r\nb" + q, "[a\r\nb]");
    expect_rows("quote in the middle of an unquoted field", "5" + q + " disk,x", "[5" + q + " disk][x]");
    expect_rows("quoted spaces kept", q + "  x  " + q, "[  x  ]");
    expect_rows("quoted empty line is a row", q + q + "\n", "[]");

    expect_bad("unclosed quote", "a," + q + "open\nmore", 1, 3);
    expect_bad("text after closing quote", q + "ab" + q + "c,d", 1, 5);
    expect_bad("error on line 3", "a,b\nc,d\ne," + q + "x" + q + "y", 3, 6);
    expect_bad("line counted through quoted line breaks", q + "1\n2" + q + ",ok\n" + q + "bad", 3, 1);

    // custom separators and quotes
    expect_str("semicolon", show(csv_reader.parse("a;b,c;" + q + "d;e" + q, ';')), "[a][b,c][d;e]");
    expect_str("tab", show(csv_reader.parse("a\tb c\td", '\t')), "[a][b c][d]");
    apos := new csv_reader("'it''s',b");
    apos.set_quote(39);
    expect_str("single quote as quote", show(apos.read_all()), "[it's][b]");
    try { new csv_reader("x").set_separator('"'); fail("separator = quote", "no exception"); }
    catch(e: csv_exception) { pass("separator = quote"); }
    try { new csv_reader("x").set_separator('\n'); fail("separator = line end", "no exception"); }
    catch(e: csv_exception) { pass("separator = line end"); }
    try { new csv_reader("x").set_quote(','); fail("quote = separator", "no exception"); }
    catch(e: csv_exception) { pass("quote = separator"); }

    // options
    trimmed := new csv_reader(" a , b\t,  " + q + " c " + q + " ,d ");
    trimmed.set_trim(true);
    expect_str("trim", show(trimmed.read_all()), "[a][b][ c ][d]");
    keep := new csv_reader("a\n\nb");
    keep.set_skip_empty_lines(false);
    expect_str("empty lines kept", show(keep.read_all()), "[a]/[]/[b]");

    // row by row, with a header
    r := new csv_reader("name,age,city\nAda,36,London\nBob,41\n");
    expect_true("has_next", r.has_next().value);
    header := r.read_header();
    expect("header size", header.size().value, 3);
    expect("column_index", r.column_index("age"), 1);
    expect("column_index missing", r.column_index("Age"), 0 - 1);
    first := r.next_row();
    expect_str("field by name", first.field("city"), "London");
    expect_str("field by position", first.at(0), "Ada");
    expect("row size", first.size(), 3);
    expect_true("has_field", first.has_field("age").value);
    expect_false("has_field unknown", first.has_field("zip").value);
    expect_str("to_string", first.to_string()!!, "Ada, 36, London");
    second := r.next_row();
    expect("short row size", second.size(), 2);
    expect_false("has_field on short row", second.has_field("city").value);
    expect_str("at_or", second.at_or(2, "?"), "?");
    expect_str("at_or present", second.at_or(1, "?"), "41");
    try { second.field("city"); fail("field missing in short row", "no exception"); }
    catch(e: csv_exception) { pass("field missing in short row"); }
    try { second.field("zip"); fail("unknown column", "no exception"); }
    catch(e: csv_exception) { pass("unknown column"); }
    try { second.at(5); fail("at outside", "no exception"); }
    catch(e: out_of_bounds_exception) { pass("at outside"); }
    expect_false("no more rows", r.has_next().value);
    expect("rows read", r.get_rows_read(), 3);
    try { r.next_row(); fail("next_row at end", "no exception"); }
    catch(e: illegal_state_exception) { pass("next_row at end"); }
    no_header := new csv_reader("a,b");
    try { no_header.column_index("a"); fail("column_index without header", "no exception"); }
    catch(e: illegal_state_exception) { pass("column_index without header"); }
    plain := no_header.next_row();
    expect("column_index on a row without header", plain.column_index("a"), 0 - 1);
    try { plain.field("a"); fail("field without header", "no exception"); }
    catch(e: csv_exception) { pass("field without header"); }
    fields := new csv_reader("x,y\n").next_fields();
    expect("next_fields", fields.size().value, 2);
}

def test_writer() {
    out := new csv_writer();
    out.write_field("name").write_field("age").end_row();
    out.write_field("Smith, John").write_number(41).end_row();
    expect_str("basic", out.to_string()!!, "name,age\n" + q + "Smith, John" + q + ",41\n");
    expect("rows written", out.get_rows_written(), 2);
    out.clear();
    expect_str("clear", out.to_string()!!, "");

    out.write_row(row_of("plain", "with " + q + "quote" + q, "two\nlines"));
    expect_str("quoting", out.to_string()!!, "plain," + q + "with " + q + q + "quote" + q + q + q + "," + q + "two\nlines" + q + "\n");
    out.clear();
    out.write_row(row_of(" lead", "trail ", "in side"));
    expect_str("spaces at the edges are quoted", out.to_string()!!, q + " lead" + q + "," + q + "trail " + q + ",in side\n");
    out.clear();
    out.write_row(row_of("", "", ""));
    expect_str("empty fields", out.to_string()!!, ",,\n");
    out.clear();
    out.write_field("").end_row();
    expect_str("a single empty field is quoted", out.to_string()!!, q + q + "\n");
    out.clear();
    out.write_field("a");
    out.write_row(row_of("b", "c", "d"));
    expect_str("write_row finishes an open row", out.to_string()!!, "a\nb,c,d\n");
    out.clear();
    out.write_number(1.5).write_number(0 - 3).write_number(1000000).end_row();
    expect_str("numbers", out.to_string()!!, "1.5,-3,1000000\n");

    semi := new csv_writer();
    semi.set_separator(';').set_line_end("\r\n");
    semi.write_row(row_of("a;b", "c,d", "e"));
    expect_str("separator and line end", semi.to_string()!!, q + "a;b" + q + ";c,d;e\r\n");
    always := new csv_writer();
    always.set_always_quote(true);
    always.write_row(row_of("a", "", "1"));
    expect_str("always quote", always.to_string()!!, q + "a" + q + "," + q + q + "," + q + "1" + q + "\n");
    apostrophe := new csv_writer();
    apostrophe.set_quote(39);
    apostrophe.write_row(row_of("it's", "a,b", "c"));
    expect_str("other quote character", apostrophe.to_string()!!, "'it''s','a,b',c\n");
    try { new csv_writer().set_separator('\r'); fail("writer separator = line end", "no exception"); }
    catch(e: csv_exception) { pass("writer separator = line end"); }
    try { new csv_writer().set_quote(','); fail("writer quote = separator", "no exception"); }
    catch(e: csv_exception) { pass("writer quote = separator"); }

    list_row := new list<string>();
    list_row.add("x"); list_row.add("y");
    from_list := new csv_writer();
    from_list.write_row(list_row);
    expect_str("write_row from a list", from_list.to_string()!!, "x,y\n");
    expect("csv_row from a list", new csv_row(list_row).size(), 2);
}

def test_round_trip() {
    rows := new list<csv_row>();
    rows.add(row_of("id", "text", "note"));
    rows.add(row_of("1", "plain", ""));
    rows.add(row_of("2", "comma, inside", q + "quoted" + q));
    rows.add(row_of("3", "line\nbreak", "crlf\r\nbreak"));
    rows.add(row_of("4", "  spaces  ", "\ttab"));
    rows.add(row_of("5", q, q + q + q));
    rows.add(row_of("", "", ""));
    rows.add(row_of("7", "semi;colon", "last"));

    text := csv_writer.format(rows);
    back := csv_reader.parse(text);
    expect("round trip row count", back.size().value, 8);
    expect_str("round trip content", show(back), show(rows));
    expect_str("write again gives the same text", csv_writer.format(back), text);

    semi := csv_writer.format(rows, ';');
    expect_str("round trip with semicolon", show(csv_reader.parse(semi, ';')), show(rows));
    tab := csv_writer.format(rows, '\t');
    expect_str("round trip with tab", show(csv_reader.parse(tab, '\t')), show(rows));

    one := new list<csv_row>();
    empty_row := new csv_row();
    empty_row.add("");
    one.add(empty_row);
    expect("a row of one empty field survives", csv_reader.parse(csv_writer.format(one)).size().value, 1);

    // through a file
    target := new file(base_dir + "/data.csv");
    out := new csv_writer();
    out.write_rows(rows);
    out.save(target);
    from_file := csv_reader.parse_file(target);
    expect_str("file round trip", show(from_file), show(rows));
    try { csv_reader.parse_file(new file(base_dir + "/missing.csv")); fail("parse missing file", "no exception"); }
    catch(e: io_exception) { pass("parse missing file"); }

    // a larger table
    big := new csv_writer();
    for(i : decimal = 0; i < 3000; i++) {
        big.write_number(i).write_field("name " + io_strings.int_to_string(i)).write_field("a,b").end_row();
    }
    table := csv_reader.parse(big.to_string()!!);
    expect("3000 rows", table.size().value, 3000);
    expect_str("row 2999", show_one(table.at(2999)), "[2999][name 2999][a,b]");
}

def show_one(row: csv_row): string {
    rows := new list<csv_row>();
    rows.add(row);
    return show(rows);
}

def main(args: string[]) {
    start := new file(base_dir);
    start.delete_recursively();
    expect_true("test directory created", start.mkdirs().value);

    test_reader();
    test_writer();
    test_round_trip();

    expect_true("cleanup", start.delete_recursively().value);
    finish("lib_data_csv");
}
