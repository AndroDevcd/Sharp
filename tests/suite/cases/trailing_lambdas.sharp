mod main;

import ( testing )

/**
 * Trailing lambdas: a `{ ... }` block right after a call is its last argument.
 * Explicit parameters (`x -> ...`), no parameters, the implicit parameter `it`,
 * and a single expression as the result.
 */

class counter {
    value : decimal = 0;
    def add(n: decimal) { value += n; }
}

total := new counter();
log := new string_builder();

def run(block: ()()) { block(); }
def run_twice(block: ()()) { block(); block(); }
def repeat(times: decimal, block: ()()) { for(i : decimal = 0; i < times; i++) { block(); } }
def apply(x: decimal, f: (decimal)(decimal)) : decimal { return f(x); }
def apply2(a: decimal, b: decimal, f: (decimal, decimal)(decimal)) : decimal { return f(a, b); }
def each(items: decimal[], f: (decimal)()) { foreach(v in items) { f(v); } }
def count_if(items: decimal[], test: (decimal)(decimal)) : decimal {
    n : decimal = 0;
    foreach(v in items) { if(test(v)) { n++; } }
    return n;
}
def sum_by(items: decimal[], f: (decimal)(decimal)) : decimal {
    s : decimal = 0;
    foreach(v in items) { s += f(v); }
    return s;
}
def with_text(s: string, f: (string)(decimal)) : decimal { return f(s); }
def make(f: ()(decimal)) : decimal { return f(); }

class pipeline {
    items : decimal[];
    pipeline(a: decimal[]) { items = a; }

    def keep(test: (decimal)(decimal)) : pipeline {
        n : decimal = 0;
        foreach(v in items) { if(test(v)) { n++; } }
        result := new decimal[n];
        i : decimal = 0;
        foreach(v in items) { if(test(v)) { result[i] = v; i++; } }
        return new pipeline(result);
    }

    def change(f: (decimal)(decimal)) : pipeline {
        result := new decimal[sizeof(items)];
        for(i : decimal = 0; i < sizeof(items); i++) { result[i] = f(items[i]); }
        return new pipeline(result);
    }

    def for_each(f: (decimal)()) { foreach(v in items) { f(v); } }
    def sum() : decimal { s : decimal = 0; foreach(v in items) { s += v; } return s; }
}

def main(args: string[]) {
    numbers := new decimal[] { 1, 2, 3, 4, 5, 6 };

    // ---- no parentheses, no parameters
    total.value = 0;
    run { total.add(5); }
    expect("f { statement; }", total.value, 5);

    run { total.add(1); total.add(2); }
    expect("several statements", total.value, 8);

    run_twice { total.add(10) }
    expect("a single expression, result not wanted", total.value, 28);

    // ---- after an argument list
    total.value = 0;
    repeat(4) { total.add(3); }
    expect("f(a) { ... }", total.value, 12);

    // ---- the implicit parameter
    expect("it in a single expression", apply(5) { it * 2 }, 10);
    expect("it with a return statement", apply(5) { return it + 1; }, 6);
    expect("it used twice", apply(7) { it * it }, 49);
    expect("count_if { it > 3 }", count_if(numbers) { it > 3 }, 3);
    expect("sum_by { it * 10 }", sum_by(numbers) { it * 10 }, 210);
    expect("it of a string", with_text("hello") { it.size() }, 5);

    total.value = 0;
    each(numbers) { total.add(it); }
    expect("it in a statement body", total.value, 21);

    // ---- explicit parameters keep working
    expect("x -> expression statement body", apply(4) { x -> return x * 3; }, 12);
    expect("two parameters", apply2(3, 4) { a, b -> return a * b; }, 12);
    expect("typed parameters and return type", apply2(3, 4) { a: decimal, b: decimal -> (decimal) return a + b; }, 7);
    expect("no parameters with an arrow", make { -> return 42; }, 42);
    expect("no arrow, single expression result", make { 6 * 7 }, 42);

    // ---- the old way is unchanged
    expect("lambda inside the parentheses", apply(5, { x -> return x - 1; }), 4);
    total.value = 0;
    run({ -> total.add(9); });
    expect("lambda as the only argument in parentheses", total.value, 9);

    // ---- chains on objects
    p := new pipeline(numbers);
    expect("keep { }", p.keep { it % 2 == 0 }.sum(), 12);
    expect("keep { }.change { }", p.keep { it > 2 }.change { it * 2 }.sum(), 36);
    expect("three in a row", p.keep { it != 1 }.change { it + 1 }.keep { it % 2 == 1 }.sum(), 15);
    total.value = 0;
    p.change { it * 100 }.for_each { total.add(it); }
    expect("ending in a statement lambda", total.value, 2100);

    // ---- nested: each lambda has its own `it`
    total.value = 0;
    run {
        each(numbers) { total.add(it); }
        total.add(count_if(numbers) { it < 3 });
    }
    expect("an implicit lambda inside a lambda without it", total.value, 23);

    expect("a call with a trailing lambda inside an it lambda",
           apply(3) { it + count_if(new decimal[] { 1, 2, 3, 4 }) { it > 2 } }, 5);

    // ---- statements that are followed by a block are not lambdas
    hits : decimal = 0;
    if(count_if(numbers) { it > 0 } == 6) { hits++; }
    while(hits < 3) { hits++; }
    foreach(v in numbers) { hits++; }
    for(i : decimal = 0; i < apply(1) { it + 1 }; i++) { hits++; }
    when(hits) {
        11 -> { hits = 100; }
        else -> { hits = 0 - 1; }
    }
    expect("if / while / foreach / for / when still take their blocks", hits, 100);

    // ---- literals with braces are still literals
    arr := new decimal[] { 7, 8 };
    expect("vector array literal", arr[1], 8);
    dict := { "a" : 1, "b" : 2 };
    expect_not_null("dictionary literal", dict);

    finish("trailing_lambdas");
}
