mod main;
import ( std.testing, std.io )
def main(args: string[]) {
    show_only_failures();
    tests("lib_io_atomic_comparisons") {
        a := new atomic<int>(5);
        test("atomic 5 <= 7") { expect_true((a <= 7).value); };
        test("atomic 5 <= 3") { expect_false((a <= 3).value); };
        test("atomic 5 >= 3") { expect_true((a >= 3).value); };
    };
    finish_tests("lib_io_atomic_comparisons");
}
