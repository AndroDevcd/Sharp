mod main;

import ( std.testing )

/**
 * std.text - the `string` class, part 1:
 *   - string_core.sharp   length, is_empty / is_blank, char_at, first / last, chars, to_bytes
 *   - string_slice.sharp  substring(start), take / drop, substring_before / after,
 *                         remove_prefix / suffix / surrounding, remove_range, reversed, repeat
 *   - string_trim.sharp   trim, trim_chars, collapse_whitespace, pad_start / pad_end, center
 *
 * (Methods cannot be called on a literal, so the checks go through variables.)
 */

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_string_core") {
        hello : string = "hello";
        empty : string = "";
        one : string = "x";
        blank : string = " \t\n ";

        // ---- length, is_empty, is_blank
        test("length") { expect(hello.length()).should_be(5); };
        test("length of \"\"") { expect(empty.length()).should_be(0); };
        test("length of one character") { expect(one.length()).should_be(1); };
        test("\"\" is_empty") { expect_true(empty.is_empty()); };
        test("\"hello\" is_empty") { expect_false(hello.is_empty()); };
        test("\"hello\" is_not_empty") { expect_true(hello.is_not_empty()); };
        test("\"\" is_not_empty") { expect_false(empty.is_not_empty()); };
        test("\"\" is_blank") { expect_true(empty.is_blank()); };
        test("whitespace is_blank") { expect_true(blank.is_blank()); };
        test("\"hello\" is_blank") { expect_false(hello.is_blank()); };
        test("whitespace is_empty") { expect_false(blank.is_empty()); };
        test("\"hello\" is_not_blank") { expect_true(hello.is_not_blank()); };
        test("whitespace is_not_blank") { expect_false(blank.is_not_blank()); };

        // ---- char_at, first, last
        test("char_at(0)") { expect(hello.char_at(0)).should_be('h'); };
        test("char_at(4)") { expect(hello.char_at(4)).should_be('o'); };
        test("char_at_or inside") { expect(hello.char_at_or(1, '?')).should_be('e'); };
        test("char_at_or beyond the end") { expect(hello.char_at_or(5, '?')).should_be('?'); };
        test("char_at_or negative") { expect(hello.char_at_or(0 - 1, '?')).should_be('?'); };
        test("first") { expect(hello.first()).should_be('h'); };
        test("last") { expect(hello.last()).should_be('o'); };
        test("first of one character") { expect(one.first()).should_be('x'); };
        test("last of one character") { expect(one.last()).should_be('x'); };
        test("first_or on \"\"") { expect(empty.first_or('-')).should_be('-'); };
        test("last_or on \"\"") { expect(empty.last_or('-')).should_be('-'); };
        test("first_or on text") { expect(hello.first_or('-')).should_be('h'); };
        try {
            hello.char_at(5);
            test("char_at(length)") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("char_at(length)") { };
        }
        try {
            empty.first();
            test("first of \"\"") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("first of \"\"") { };
        }
        try {
            empty.last();
            test("last of \"\"") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("last of \"\"") { };
        }

        // ---- chars, to_bytes
        letters := hello.chars();
        test("chars: length") { expect(sizeof(letters)).should_be(5); };
        test("chars: first") { expect(letters[0].value).should_be('h'); };
        test("chars: last") { expect(letters[4].value).should_be('o'); };
        test("chars of \"\"") { expect(sizeof(empty.chars())).should_be(0); };
        bytes := hello.to_bytes();
        test("to_bytes: length") { expect(sizeof(bytes)).should_be(5); };
        test("to_bytes: element") { expect(bytes[1]).should_be('e'); };
        bytes[0] = 'j';
        test("to_bytes is a copy") { expect(hello.char_at(0)).should_be('h'); };

        // ---- substring(start), take, drop
        test("substring(2)") { expect(hello.substring(2)).should_be("llo"); };
        test("substring(0)") { expect(hello.substring(0)).should_be("hello"); };
        test("substring(length)") { expect(hello.substring(5)).should_be(""); };
        try {
            hello.substring(6);
            test("substring beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("substring beyond the end") { };
        }
        test("take(2)") { expect(hello.take(2)).should_be("he"); };
        test("take(0)") { expect(hello.take(0)).should_be(""); };
        test("take more than there is") { expect(hello.take(99)).should_be("hello"); };
        test("take_last(2)") { expect(hello.take_last(2)).should_be("lo"); };
        test("take_last more than there is") { expect(hello.take_last(99)).should_be("hello"); };
        test("drop(2)") { expect(hello.drop(2)).should_be("llo"); };
        test("drop everything") { expect(hello.drop(5)).should_be(""); };
        test("drop more than there is") { expect(hello.drop(99)).should_be(""); };
        test("drop_last(2)") { expect(hello.drop_last(2)).should_be("hel"); };
        test("drop_last(0)") { expect(hello.drop_last(0)).should_be("hello"); };
        test("take on \"\"") { expect(empty.take(3)).should_be(""); };
        try {
            hello.take(0 - 1);
            test("take(-1)") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("take(-1)") { };
        }

        // ---- substring_before / after
        pair : string = "key=value=more";
        test("substring_before") { expect(pair.substring_before("=")).should_be("key"); };
        test("substring_after") { expect(pair.substring_after("=")).should_be("value=more"); };
        test("substring_before_last") { expect(pair.substring_before_last("=")).should_be("key=value"); };
        test("substring_after_last") { expect(pair.substring_after_last("=")).should_be("more"); };
        test("substring_before, not found") { expect(pair.substring_before("#")).should_be("key=value=more"); };
        test("substring_after, not found") { expect(pair.substring_after("#")).should_be("key=value=more"); };
        test("substring_before with a missing value") { expect(pair.substring_before("#", "none")).should_be("none"); };
        test("substring_after with a missing value") { expect(pair.substring_after("#", "none")).should_be("none"); };
        test("substring_before_last with a missing value") { expect(pair.substring_before_last("#", "")).should_be(""); };
        test("substring_after_last with a missing value") { expect(pair.substring_after_last("#", "none")).should_be("none"); };
        test("substring_before with a char literal") { expect(pair.substring_before('=')).should_be("key"); };
        test("substring_after a longer delimiter") { expect(pair.substring_after("ue=")).should_be("more"); };
        test("substring_before a delimiter at the start") { expect(pair.substring_before("key")).should_be(""); };
        test("substring_after a delimiter at the end") { expect(pair.substring_after("more")).should_be(""); };

        // ---- remove_prefix / suffix / surrounding / range
        path : string = "src/main.sharp";
        test("remove_prefix") { expect(path.remove_prefix("src/")).should_be("main.sharp"); };
        test("remove_prefix that is not there") { expect(path.remove_prefix("lib/")).should_be("src/main.sharp"); };
        test("remove_suffix") { expect(path.remove_suffix(".sharp")).should_be("src/main"); };
        test("remove_suffix that is not there") { expect(path.remove_suffix(".cpp")).should_be("src/main.sharp"); };
        test("remove_prefix of the whole string") { expect(path.remove_prefix("src/main.sharp")).should_be(""); };
        test("remove_prefix \"\"") { expect(path.remove_prefix("")).should_be("src/main.sharp"); };
        quoted : string = "(abc)";
        test("remove_surrounding") { expect(quoted.remove_surrounding("(", ")")).should_be("abc"); };
        test("remove_surrounding, only one side present") { expect(quoted.remove_surrounding("(", "]")).should_be("(abc)"); };
        ticks : string = "'it'";
        test("remove_surrounding with one delimiter") { expect(ticks.remove_surrounding("'")).should_be("it"); };
        test("remove_surrounding must not overlap") { expect(one.remove_surrounding("x")).should_be("x"); };
        abcdef : string = "abcdef";
        test("remove_range") { expect(abcdef.remove_range(1, 3)).should_be("adef"); };
        test("remove_range of nothing") { expect(abcdef.remove_range(2, 2)).should_be("abcdef"); };
        test("remove_range of everything") { expect(abcdef.remove_range(0, 6)).should_be(""); };
        test("remove_range at the end") { expect(abcdef.remove_range(4, 6)).should_be("abcd"); };
        try {
            abcdef.remove_range(4, 7);
            test("remove_range beyond the end") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("remove_range beyond the end") { };
        }

        // ---- reversed, repeat
        test("reversed") { expect(hello.reversed()).should_be("olleh"); };
        test("reversed \"\"") { expect(empty.reversed()).should_be(""); };
        test("reversed one character") { expect(one.reversed()).should_be("x"); };
        test("reversed leaves the original alone") { expect(hello).should_be("hello"); };
        ab : string = "ab";
        test("repeat(3)") { expect(ab.repeat(3)).should_be("ababab"); };
        test("repeat(1)") { expect(ab.repeat(1)).should_be("ab"); };
        test("repeat(0)") { expect(ab.repeat(0)).should_be(""); };
        test("repeat of \"\"") { expect(empty.repeat(5)).should_be(""); };
        test("repeat: a long result") { expect(ab.repeat(5000).length()).should_be(10000); };
        try {
            ab.repeat(0 - 1);
            test("repeat(-1)") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("repeat(-1)") { };
        }

        // ---- trim
        padded : string = "  a b \t\n";
        test("trim") { expect(padded.trim()).should_be("a b"); };
        test("trim_start") { expect(padded.trim_start()).should_be("a b \t\n"); };
        test("trim_end") { expect(padded.trim_end()).should_be("  a b"); };
        test("trim with nothing to trim") { expect(hello.trim()).should_be("hello"); };
        test("trim of whitespace only") { expect(blank.trim()).should_be(""); };
        test("trim of \"\"") { expect(empty.trim()).should_be(""); };
        test("trim_start of whitespace only") { expect(blank.trim_start()).should_be(""); };
        test("trim_end of whitespace only") { expect(blank.trim_end()).should_be(""); };
        dashes : string = "--a-b--";
        test("trim_chars") { expect(dashes.trim_chars("-")).should_be("a-b"); };
        test("trim_start_chars") { expect(dashes.trim_start_chars("-")).should_be("a-b--"); };
        test("trim_end_chars") { expect(dashes.trim_end_chars("-")).should_be("--a-b"); };
        mixed : string = "xyAyx";
        test("trim_chars with a set") { expect(mixed.trim_chars("xy")).should_be("A"); };
        test("trim_chars with an empty set") { expect(mixed.trim_chars("")).should_be("xyAyx"); };
        test("trim_chars removing everything") { expect(dashes.trim_chars("-ab")).should_be(""); };
        messy : string = "  to   be \t\n or  not ";
        test("collapse_whitespace") { expect(messy.collapse_whitespace()).should_be("to be or not"); };
        test("collapse_whitespace of whitespace") { expect(blank.collapse_whitespace()).should_be(""); };
        test("collapse_whitespace with nothing to do") { expect(hello.collapse_whitespace()).should_be("hello"); };

        // ---- pad, center
        n42 : string = "42";
        test("pad_start") { expect(n42.pad_start(5)).should_be("   42"); };
        test("pad_start with a character") { expect(n42.pad_start(5, '0')).should_be("00042"); };
        test("pad_end") { expect(n42.pad_end(5)).should_be("42   "); };
        test("pad_end with a character") { expect(n42.pad_end(5, '.')).should_be("42..."); };
        test("pad_start never shortens") { expect(hello.pad_start(3)).should_be("hello"); };
        test("pad_end to the exact length") { expect(hello.pad_end(5)).should_be("hello"); };
        test("pad_start of \"\"") { expect(empty.pad_start(3, '*')).should_be("***"); };
        test("center, even padding") { expect(n42.center(6)).should_be("  42  "); };
        test("center, odd padding goes right") { expect(n42.center(5)).should_be(" 42  "); };
        test("center with a character") { expect(n42.center(6, '*')).should_be("**42**"); };
        test("center never shortens") { expect(hello.center(2)).should_be("hello"); };
        try {
            n42.pad_start(0 - 1);
            test("pad_start(-1)") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("pad_start(-1)") { };
        }
    };
    finish_tests();
}
