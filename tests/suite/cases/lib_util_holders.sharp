mod main;

import ( std.testing, std.util )

/**
 * std.util - the holder classes: optional<T>, either<L, R>, ref<T>, lazy<T>,
 * counter, id_generator and bit_flags, plus the preconditions checks.
 */

/* counts how often the lazy supplier below has run (a lambda can change an object, not a local) */
supplier_runs : decimal = 0;

def make_text(): string {
    supplier_runs++;
    return "computed";
}

/* run a lambda (lambdas are passed as arguments; a local needs its full function type written out) */
def call(action: ()()) {
    action();
}

def call_with(action: (int)(), n: int) {
    action(n);
}

def check_optional() {
    full := optional<string>.of("ada");
    none := optional<string>.empty();

    test("of: is_present") { expect_true(full.is_present().value); };
    test("of: is_empty") { expect_false(full.is_empty().value); };
    test("empty: is_present") { expect_false(none.is_present().value); };
    test("empty: is_empty") { expect_true(none.is_empty().value); };
    test("value") { expect(full.value()).should_be("ada"); };
    test("or_else on a value") { expect(full.or_else("nobody")).should_be("ada"); };
    test("or_else on empty") { expect(none.or_else("nobody")).should_be("nobody"); };
    test("or_else_get on a value") { expect(full.or_else_get({ -> (string) return "made"; })).should_be("ada"); };
    test("or_else_get on empty") { expect(none.or_else_get({ -> (string) return "made"; })).should_be("made"); };
    test("or_null on a value") { expect_not_null(full.or_null()); };
    test("or_null on empty") { expect_null(none.or_null()); };
    test("or_throw on a value") { expect(full.or_throw("missing")).should_be("ada"); };

    try {
        none.value();
        test("value() on empty") { fail_test("no exception"); };
    } catch(e: no_such_element_exception) {
        test("value() on empty throws") { };
    }
    try {
        none.or_throw("no user");
        test("or_throw on empty") { fail_test("no exception"); };
    } catch(e: no_such_element_exception) {
        test("or_throw carries the message") { expect(e.get_message()).should_be("no user"); };
    }

    maybe : string? = null;
    test("of_nullable(null) is empty") { expect_false(optional<string>.of_nullable(maybe).is_present().value); };
    test("of_nullable(value) is present") { expect_true(optional<string>.of_nullable("x").is_present().value); };

    shouted := full.map({ s: string -> (string) return s + "!"; });
    test("map") { expect(shouted.value()).should_be("ada!"); };
    test("map leaves the original alone") { expect(full.value()).should_be("ada"); };
    test("map on empty stays empty") { expect_false(none.map({ s: string -> (string) return s + "!"; }).is_present().value); };
    kept := full.filter({ s: string -> (bool) return s.size() == 3; });
    test("filter keeps a match") { expect_true(kept.is_present().value); };
    dropped := full.filter({ s: string -> (bool) return s.size() == 5; });
    test("filter drops a mismatch") { expect_false(dropped.is_present().value); };
    test("filter on empty stays empty") { expect_false(none.filter({ s: string -> (bool) return true; }).is_present().value); };
    test("or: the first when present") { expect(full.or(optional<string>.of("other")).value()).should_be("ada"); };
    test("or: the second when empty") { expect(none.or(optional<string>.of("other")).value()).should_be("other"); };

    seen := new ref<string>("");
    full.if_present({ s: string -> seen.value = s; });
    test("if_present runs for a value") { expect(seen.value).should_be("ada"); };
    seen.value = "untouched";
    none.if_present({ s: string -> seen.value = s; });
    test("if_present does not run for empty") { expect(seen.value).should_be("untouched"); };

    numbers := optional<int>.of(41);
    test("optional<int>") { expect(numbers.map({ n: int -> (int) return n + 1; }).value().value).should_be(42); };
}

def check_either() {
    good := either<string, int>.right(8080);
    bad := either<string, int>.left("no port");

    test("right: is_right") { expect_true(good.is_right().value); };
    test("right: is_left") { expect_false(good.is_left().value); };
    test("left: is_left") { expect_true(bad.is_left().value); };
    test("left: is_right") { expect_false(bad.is_right().value); };
    test("right_value") { expect(good.right_value().value).should_be(8080); };
    test("left_value") { expect(bad.left_value()).should_be("no port"); };
    test("right_or on a right") { expect(good.right_or(1).value).should_be(8080); };
    test("right_or on a left") { expect(bad.right_or(1).value).should_be(1); };
    test("left_or on a left") { expect(bad.left_or("fine")).should_be("no port"); };
    test("left_or on a right") { expect(good.left_or("fine")).should_be("fine"); };
    test("left_or_null on a right") { expect_null(good.left_or_null()); };
    test("right_or_null on a right") { expect_not_null(good.right_or_null()); };
    test("right_or_null on a left") { expect_null(bad.right_or_null()); };

    caught : decimal = 0;
    try { good.left_value(); } catch(e: no_such_element_exception) { caught++; }
    try { bad.right_value(); } catch(e: no_such_element_exception) { caught++; }
    test("the missing side throws") { expect(caught).should_be(2); };

    swapped := good.swap();
    test("swap turns a right into a left") { expect_true(swapped.is_left().value); };
    test("swap keeps the value") { expect(swapped.left_value().value).should_be(8080); };
    test("swap turns a left into a right") { expect_true(bad.swap().is_right().value); };
    test("swap twice gives the original back") { expect(swapped.swap().right_value().value).should_be(8080); };

    next_port := good.map_right({ n: int -> (int) return n + 1; });
    test("map_right") { expect(next_port.right_value().value).should_be(8081); };
    test("map_right leaves a left alone") { expect_true(bad.map_right({ n: int -> (int) return n + 1; }).is_left().value); };
    louder := bad.map_left({ s: string -> (string) return s + "!"; });
    test("map_left") { expect(louder.left_value()).should_be("no port!"); };
    test("map_left leaves a right alone") { expect(good.map_left({ s: string -> (string) return s + "!"; }).right_value().value).should_be(8080); };

    note := new ref<string>("");
    bad.if_left({ s: string -> note.value = s; });
    test("if_left") { expect(note.value).should_be("no port"); };
    good.if_left({ s: string -> note.value = "wrong"; });
    test("if_left does not run for a right") { expect(note.value).should_be("no port"); };
    good.if_right({ n: int -> note.value = "right"; });
    test("if_right") { expect(note.value).should_be("right"); };
    test("to_optional of a right") { expect_true(good.to_optional().is_present().value); };
    test("to_optional of a left") { expect_false(bad.to_optional().is_present().value); };
}

def check_ref() {
    holder := new ref<string>("first");
    test("value") { expect(holder.value).should_be("first"); };
    holder.value = "second";
    test("assign") { expect(holder.value).should_be("second"); };
    old := holder.replace("third");
    test("replace returns the old value") { expect(old).should_be("second"); };
    test("replace stores the new value") { expect(holder.value).should_be("third"); };
    other := new ref<string>("other");
    holder.swap(other);
    test("swap: this") { expect(holder.value).should_be("other"); };
    test("swap: other") { expect(other.value).should_be("third"); };
    test("update") { expect(holder.update({ s: string -> (string) return s + "+"; })).should_be("other+"); };
    test("update stores the result") { expect(holder.value).should_be("other+"); };
    shared := new ref<string>(holder.value);
    test("same_as") { expect_true(holder.same_as(shared).value); };
    test("same_as with another object") { expect_false(holder.same_as(other).value); };

    // the reason the class exists: a lambda changing something outside itself
    total := new ref<int>(0);
    call_with({ n: int -> total.value = total.value + n; }, 5);
    call_with({ n: int -> total.value = total.value + n; }, 7);
    test("a lambda can change what a ref holds") { expect(total.value.value).should_be(12); };
}

def check_lazy() {
    supplier_runs = 0;
    later := new lazy<string>(make_text);
    test("not initialized at first") { expect_false(later.is_initialized().value); };
    test("the supplier has not run") { expect(supplier_runs).should_be(0); };
    test("value") { expect(later.value()).should_be("computed"); };
    test("the supplier ran once") { expect(supplier_runs).should_be(1); };
    test("initialized after value()") { expect_true(later.is_initialized().value); };
    test("value again") { expect(later.value()).should_be("computed"); };
    test("the supplier did not run again") { expect(supplier_runs).should_be(1); };
    later.reset();
    test("reset forgets the value") { expect_false(later.is_initialized().value); };
    test("value after reset") { expect(later.value()).should_be("computed"); };
    test("the supplier ran a second time") { expect(supplier_runs).should_be(2); };

    ready := lazy<string>.of_value("given");
    test("of_value is initialized") { expect_true(ready.is_initialized().value); };
    test("of_value") { expect(ready.value()).should_be("given"); };
    ready.reset();
    test("of_value survives reset") { expect(ready.value()).should_be("given"); };

    from_lambda := new lazy<string>({ -> (string) return "from a lambda"; });
    test("a lambda as supplier") { expect(from_lambda.value()).should_be("from a lambda"); };
}

def check_preconditions() {
    preconditions.require(1 < 2, "never thrown");
    preconditions.require(true);
    preconditions.check(2 > 1, "never thrown");
    preconditions.check(true);
    test("true conditions do not throw") { };

    try {
        preconditions.require(1 > 2, "amount must be positive");
        test("require(false)") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("require message") { expect(e.get_message()).should_be("amount must be positive"); };
    }
    try {
        preconditions.require(false);
        test("require(false) without message") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("require default message") { expect(e.get_message()).should_be("requirement failed"); };
    }
    try {
        preconditions.check(false, "the account is closed");
        test("check(false)") { fail_test("no exception"); };
    } catch(e: illegal_state_exception) {
        test("check message") { expect(e.get_message()).should_be("the account is closed"); };
    }
    try {
        preconditions.check(false);
        test("check(false) without message") { fail_test("no exception"); };
    } catch(e: illegal_state_exception) {
        test("check default message") { expect(e.get_message()).should_be("check failed"); };
    }

    thing : string = "here";
    test("require_not_null returns the object") { expect_not_null(preconditions.require_not_null(thing, "missing")); };
    nothing : string? = null;
    try {
        preconditions.require_not_null(nothing, "name is missing");
        test("require_not_null(null)") { fail_test("no exception"); };
    } catch(e: nullptr_exception) {
        test("require_not_null message") { expect(e.get_message()).should_be("name is missing"); };
    }

    test("require_index returns the index") { expect(preconditions.require_index(2, 3)).should_be(2); };
    caught : decimal = 0;
    try { preconditions.require_index(3, 3); } catch(e: out_of_bounds_exception) { caught++; }
    try { preconditions.require_index(0 - 1, 3); } catch(e: out_of_bounds_exception) { caught++; }
    try { preconditions.require_index(0, 0); } catch(e: out_of_bounds_exception) { caught++; }
    test("require_index outside throws") { expect(caught).should_be(3); };
    try {
        preconditions.require_index(7, 3);
    } catch(e: out_of_bounds_exception) {
        test("require_index message") { expect(e.get_message()).should_be("index 7 is outside 0 .. 3 (exclusive)"); };
    }

    test("require_in_range returns the value") { expect(preconditions.require_in_range(5, 1, 10, "bad")).should_be(5); };
    test("require_in_range includes the ends") { expect(preconditions.require_in_range(10, 1, 10, "bad")).should_be(10); };
    try {
        preconditions.require_in_range(11, 1, 10, "volume must be 1 .. 10");
        test("require_in_range outside") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("require_in_range message") { expect(e.get_message()).should_be("volume must be 1 .. 10"); };
    }

    test("require_not_empty returns the text") { expect(preconditions.require_not_empty("abc", "empty")).should_be("abc"); };
    caught = 0;
    try { preconditions.require_not_empty("", "empty"); } catch(e: illegal_argument_exception) { caught++; }
    try { preconditions.require_not_empty(nothing, "empty"); } catch(e: illegal_argument_exception) { caught++; }
    test("require_not_empty throws for empty and null") { expect(caught).should_be(2); };

    try {
        preconditions.error("unknown shape");
        test("error()") { fail_test("no exception"); };
    } catch(e: illegal_state_exception) {
        test("error message") { expect(e.get_message()).should_be("unknown shape"); };
    }
    try {
        preconditions.todo("the export");
        test("todo()") { fail_test("no exception"); };
    } catch(e: not_implemented_error) {
        test("todo message") { expect(e.get_message()).should_be("not implemented: the export"); };
    }
    try {
        preconditions.todo();
        test("todo() without text") { fail_test("no exception"); };
    } catch(e: not_implemented_error) {
        test("todo default message") { expect(e.get_message()).should_be("not implemented"); };
    }
}

def check_counter() {
    c := new counter();
    test("starts at 0") { expect(c.value).should_be(0); };
    test("is_zero") { expect_true(c.is_zero().value); };
    test("increment returns the new value") { expect(c.increment()).should_be(1); };
    test("increment again") { expect(c.increment()).should_be(2); };
    test("decrement") { expect(c.decrement()).should_be(1); };
    test("add") { expect(c.add(10)).should_be(11); };
    test("add a negative fraction") { expect(c.add(0 - 0.5)).should_be(10.5); };
    c.value = 3;
    test("the field can be assigned") { expect(c.value).should_be(3); };
    test("next returns the old value") { expect(c.next()).should_be(3); };
    test("...and then counts up") { expect(c.value).should_be(4); };
    c.reset();
    test("reset") { expect(c.value).should_be(0); };
    test("to_string") { expect(c.to_string()!!).should_be("0"); };

    from_ten := new counter(10);
    from_ten.add(5);
    test("to_string of 15") { expect(from_ten.to_string()!!).should_be("15"); };
    from_ten.reset();
    test("reset returns to the start") { expect(from_ten.value).should_be(10); };

    // counting from inside a lambda
    calls := new counter();
    call({ -> calls.increment(); });
    call({ -> calls.increment(); });
    call({ -> calls.increment(); });
    test("a lambda can count") { expect(calls.value).should_be(3); };
}

def check_id_generator() {
    ids := new id_generator();
    test("peek") { expect(ids.peek()).should_be(1); };
    test("first id") { expect(ids.next_id()).should_be(1); };
    test("second id") { expect(ids.next_id()).should_be(2); };
    test("third id") { expect(ids.next_id()).should_be(3); };
    test("last_id") { expect(ids.last_id()).should_be(3); };
    test("issued") { expect(ids.issued()).should_be(3); };
    test("peek does not use an id up") { expect(ids.peek() + ids.peek()).should_be(8); };
    test("next_text without a prefix") { expect(ids.next_text()).should_be("4"); };
    ids.reset();
    test("reset") { expect(ids.next_id()).should_be(1); };

    from_100 := new id_generator(100);
    test("custom start") { expect(from_100.next_id()).should_be(100); };
    test("custom start continues") { expect(from_100.next_id()).should_be(101); };

    tickets := new id_generator("T-", 1000);
    test("prefixed text") { expect(tickets.next_text()).should_be("T-1000"); };
    test("prefixed text continues") { expect(tickets.next_text()).should_be("T-1001"); };
    test("text and numbers share one sequence") { expect(tickets.next_id()).should_be(1002); };
    test("issued with a custom start") { expect(tickets.issued()).should_be(3); };

    other := new id_generator();
    test("generators are independent") { expect(other.next_id()).should_be(1); };
    try {
        new id_generator(1.5);
        test("fractional start") { fail_test("no exception"); };
    } catch(e: illegal_argument_exception) {
        test("a fractional start throws") { };
    }
}

def check_bit_flags() {
    read : decimal = 1;
    write : decimal = 2;
    execute : decimal = 4;

    test("flag(0)") { expect(bit_flags.flag(0)).should_be(1); };
    test("flag(1)") { expect(bit_flags.flag(1)).should_be(2); };
    test("flag(5)") { expect(bit_flags.flag(5)).should_be(32); };
    test("flag(31)") { expect(bit_flags.flag(31)).should_be(2147483648); };

    access := new bit_flags();
    test("starts empty") { expect_true(access.is_empty().value); };
    test("value of the empty set") { expect(access.value).should_be(0); };
    access.add(read);
    access.add(write);
    test("add") { expect(access.value).should_be(3); };
    access.add(write);
    test("adding twice changes nothing") { expect(access.value).should_be(3); };
    test("has") { expect_true(access.has(write).value); };
    test("has all of two") { expect_true(access.has(read + write).value); };
    test("has not all") { expect_false(access.has(read + execute).value); };
    test("has_any") { expect_true(access.has_any(read + execute).value); };
    test("has_any of none") { expect_false(access.has_any(execute).value); };
    test("has_none") { expect_true(access.has_none(execute).value); };
    test("has_none when one is set") { expect_false(access.has_none(write + execute).value); };
    test("has the empty mask") { expect_true(access.has(0).value); };
    test("count") { expect(access.count()).should_be(2); };

    access.remove(read);
    test("remove") { expect(access.value).should_be(2); };
    access.remove(read);
    test("removing twice changes nothing") { expect(access.value).should_be(2); };
    access.toggle(execute);
    test("toggle on") { expect(access.value).should_be(6); };
    access.toggle(write);
    test("toggle off") { expect(access.value).should_be(4); };
    access.assign(read, true);
    test("assign true") { expect(access.value).should_be(5); };
    access.assign(execute, false);
    test("assign false") { expect(access.value).should_be(1); };
    test("chained calls") { expect(access.clear().add(write).add(execute).value).should_be(6); };
    test("to_string") { expect(access.to_string()!!).should_be("110"); };
    test("to_string of the empty set") { expect(new bit_flags().to_string()!!).should_be("0"); };

    start := new bit_flags(read + execute);
    test("constructor with a mask") { expect(start.value).should_be(5); };
    joined := start.union_with(access);
    test("union_with") { expect(joined.value).should_be(7); };
    common := start.intersection(access);
    test("intersection") { expect(common.value).should_be(4); };
    test("the operands are unchanged") { expect(start.value * 10 + access.value).should_be(56); };
    twin := start.copy_of();
    twin.add(write);
    test("copy_of is independent") { expect(start.value).should_be(5); };
    test("==") { expect_true((start == new bit_flags(5)).value); };
    test("!=") { expect_true((start != twin).value); };
    high := new bit_flags(bit_flags.flag(31));
    test("flag 31") { expect_true(high.has(2147483648).value); };
    test("count of all 32") { expect(new bit_flags(4294967295).count()).should_be(32); };

    caught : decimal = 0;
    try { access.add(0 - 1); } catch(e: illegal_argument_exception) { caught++; }
    try { access.has(1.5); } catch(e: illegal_argument_exception) { caught++; }
    try { new bit_flags(4294967296); } catch(e: illegal_argument_exception) { caught++; }
    try { bit_flags.flag(32); } catch(e: illegal_argument_exception) { caught++; }
    test("bad masks throw") { expect(caught).should_be(4); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_util_holders") {
        check_optional();
        check_either();
        check_ref();
        check_lazy();
        check_preconditions();
        check_counter();
        check_id_generator();
        check_bit_flags();
    };
    finish_tests("lib_util_holders");
}
