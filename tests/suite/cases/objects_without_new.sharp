mod main;

import ( testing, std.collections )

/**
 * Objects without `new`:  point(1, 2)  is  new point(1, 2).
 * A call whose name is a class constructs an object of it. Functions,
 * methods and function pointers of the same name still win.
 */

class point {
    x : decimal;
    y : decimal;
    point() { x = 0; y = 0; }
    point(a: decimal, b: decimal) { x = a; y = b; }
    point(other: point) { x = other.x; y = other.y; }

    def sum() : decimal { return x + y; }
    def moved(dx: decimal) : point { return point(x + dx, y); }      // inside its own class
    def twin() : point { return point(self); }
    def operator+(o: point) : point { return point(x + o.x, y + o.y); }
}

class named {
    text : string;
    count : int = 0;
    named(t: string) { text = t; }
    named(t: string, c: decimal) { text = t; count = c; }
}

class shape {
    def area() : decimal { return 0; }
}

class square base shape {
    side : decimal;
    square(s: decimal) { side = s; }
    def scaled(by: decimal) : square { return square(side * by); }
}

class holder {
    inside : point = point(7, 8);
    made : point?;
    holder() { made = point(1, 1); }
}

// a function with the same name as a class wins over the class
class gadget { size : decimal = 1; gadget() { } gadget(s: decimal) { size = s; } }
def gadget(a: decimal, b: decimal, c: decimal) : decimal { return a + b + c; }

def take(p: point) : decimal { return p.sum(); }
def make() : point { return point(4, 5); }

def main(args: string[]) {
    p := point(1, 2);
    expect("point(1, 2).x", p.x, 1);
    expect("point(1, 2).y", p.y, 2);

    q : point = point();
    expect("no arguments", q.sum(), 0);

    r := point(p);
    expect("another constructor (copy)", r.sum(), 3);

    expect("as an argument", take(point(10, 20)), 30);
    expect("as a return value", make().sum(), 9);
    expect("a method right after it", point(3, 4).sum(), 7);
    expect("a field right after it", point(3, 4).y, 4);
    expect("in an expression", point(1, 1).sum() + point(2, 2).sum(), 6);
    expect("operator on two of them", (point(1, 2) + point(3, 4)).sum(), 10);

    expect("inside its own class", p.moved(5).x, 6);
    expect("copy inside its own class", p.twin().sum(), 3);

    n := named("abc");
    expect_str("a string argument", n.text, "abc");
    m := named("xyz", 4);
    expect("two arguments, one converted to int", m.count.value, 4);

    s := square(3);
    expect("derived class", s.side, 3);
    expect("derived class inside itself", s.scaled(2).side, 6);

    h := holder();
    expect("as a field's initial value", h.inside.sum(), 15);
    expect("assigned in a constructor", h.made!!.sum(), 2);

    items := new point[3];
    items[0] = point(5, 5);
    expect("stored in an array", items[0].sum(), 10);

    expect("old syntax still works", new point(6, 6).sum(), 12);
    same := new point(2, 3);
    expect("new and no new give equal objects", same.sum(), point(2, 3).sum());

    expect("a function of the same name wins", gadget(1, 2, 3), 6);
    g := new gadget(9);
    expect("...and new still reaches the class", g.size, 9);

    total : decimal = 0;
    for(i : decimal = 0; i < 1000; i++) {
        total += point(i, 1).sum();
    }
    expect("in a loop", total, 500500);

    hit : decimal = 0;
    try { throw illegal_state_exception("made without new"); }
    catch(e: illegal_state_exception) { hit = 1; }
    expect("throw without new", hit, 1);

    finish("objects_without_new");
}
