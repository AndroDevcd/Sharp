mod main;

import ( testing )

/**
 * if / else if / else: which branch runs, chains, nesting, and every kind
 * of condition (numbers, comparisons, logic, function calls, objects).
 * The ?: expression is at the end.
 */

/** counts calls, to show that a condition was (or was not) evaluated */
calls : decimal = 0;

def touch(result: decimal): decimal {
    calls++;
    return result;
}

/** -1, 0 or 1 */
def sign(n: decimal): decimal {
    if(n < 0) {
        return 0 - 1;
    } else if(n > 0) {
        return 1;
    } else {
        return 0;
    }
}

/** a school grade as a number: 4 for 90 and up, 3 for 80 and up, ... */
def grade(score: decimal): decimal {
    if(score >= 90) {
        return 4;
    } else if(score >= 80) {
        return 3;
    } else if(score >= 70) {
        return 2;
    } else if(score >= 60) {
        return 1;
    }
    return 0;
}

/** an early return instead of an else */
def absolute(n: decimal): decimal {
    if(n < 0) {
        return 0 - n;
    }
    return n;
}

/** which quarter of the plane a point is in (1 to 4), 0 on an axis */
def quadrant(x: decimal, y: decimal): decimal {
    if(x > 0) {
        if(y > 0) {
            return 1;
        } else if(y < 0) {
            return 4;
        }
    } else if(x < 0) {
        if(y > 0) {
            return 2;
        } else if(y < 0) {
            return 3;
        }
    }
    return 0;
}

def is_even(n: decimal): decimal { return n % 2 == 0; }

def main(args: string[]) {
    r : decimal = 0;

    // ---- a lone if
    if(true) {
        r = 1;
    }
    expect("if(true) runs", r, 1);
    if(false) {
        r = 2;
    }
    expect("if(false) does not run", r, 1);

    // ---- if / else
    if(true) {
        r = 10;
    } else {
        r = 20;
    }
    expect("if(true) takes the if branch", r, 10);
    if(false) {
        r = 10;
    } else {
        r = 20;
    }
    expect("if(false) takes the else branch", r, 20);

    // ---- only one branch of a chain runs
    n : decimal = 5;
    r = 0;
    if(n == 5) {
        r += 1;
    } else if(n == 5) {
        r += 10;
    } else {
        r += 100;
    }
    expect("the first true branch wins", r, 1);
    r = 0;
    if(n == 1) {
        r += 1;
    } else if(n == 5) {
        r += 10;
    } else if(n == 5) {
        r += 100;
    } else {
        r += 1000;
    }
    expect("the second branch", r, 10);
    r = 0;
    if(n == 1) {
        r += 1;
    } else if(n == 2) {
        r += 10;
    } else if(n == 5) {
        r += 100;
    } else {
        r += 1000;
    }
    expect("the third branch", r, 100);
    r = 0;
    if(n == 1) {
        r += 1;
    } else if(n == 2) {
        r += 10;
    } else if(n == 3) {
        r += 100;
    } else {
        r += 1000;
    }
    expect("the else branch", r, 1000);
    r = 0;
    if(n == 1) {
        r += 1;
    } else if(n == 2) {
        r += 10;
    }
    expect("a chain with no else and nothing true does nothing", r, 0);

    // ---- conditions after the true one are not evaluated
    calls = 0;
    if(touch(0)) {
        r = 1;
    } else if(touch(1)) {
        r = 2;
    } else if(touch(1)) {
        r = 3;
    }
    expect("the second condition was true", r, 2);
    expect("the third condition was never evaluated", calls, 2);

    // ---- a number as a condition: 0 is false, anything else is true
    zero : decimal = 0;
    seven : decimal = 7;
    r = 0;
    if(seven) { r += 1; }
    if(zero) { r += 10; }
    if(seven - 7) { r += 100; }
    if(0 - seven) { r += 1000; }
    if(0.5) { r += 10000; }
    expect("numbers as conditions", r, 11001);

    // ---- comparisons as conditions
    r = 0;
    if(n == 5) { r += 1; }
    if(n != 5) { r += 10; }
    if(n < 6) { r += 100; }
    if(n > 6) { r += 1000; }
    if(n <= 5) { r += 10000; }
    if(n >= 6) { r += 100000; }
    expect("comparisons as conditions", r, 10101);

    // ---- logic as conditions
    r = 0;
    if(n > 0 && n < 10) { r += 1; }
    if(n > 0 && n < 3) { r += 10; }
    if(n < 0 || n == 5) { r += 100; }
    if(n < 0 || n > 10) { r += 1000; }
    if(!(n == 4)) { r += 10000; }
    if(!seven) { r += 100000; }
    if((n == 1 || n == 5) && seven == 7) { r += 1000000; }
    expect("logic as conditions", r, 1010101);

    // ---- function calls as conditions
    r = 0;
    if(is_even(4)) { r += 1; }
    if(is_even(5)) { r += 10; }
    if(!is_even(5)) { r += 100; }
    if(sign(0 - 3) < 0) { r += 1000; }
    if(is_even(2) && is_even(3)) { r += 10000; }
    expect("function calls as conditions", r, 1101);

    // ---- arithmetic as a condition
    r = 0;
    if(n - 5) { r += 1; }
    if(n - 4) { r += 10; }
    if(n * 0) { r += 100; }
    if(n % 5 == 0) { r += 1000; }
    expect("arithmetic as conditions", r, 1010);

    // ---- objects as conditions
    r = 0;
    yes : bool = true;
    no : bool = false;
    if(yes) { r += 1; }
    if(no) { r += 10; }
    if(yes.value) { r += 100; }
    count : int = 3;
    if(count == 3) { r += 1000; }
    if(count > 3) { r += 10000; }
    name := "sharp";
    if(name == "sharp") { r += 100000; }
    if(name == "blunt") { r += 1000000; }
    if(name != "blunt") { r += 10000000; }
    expect("objects as conditions", r, 10101101);

    // ---- null checks
    nothing : object = null;
    something : object = name;
    r = 0;
    if(nothing == null) { r += 1; }
    if(nothing != null) { r += 10; }
    if(something != null) { r += 100; }
    if(something == null) { r += 1000; }
    expect("null checks", r, 101);

    // ---- characters
    letter : decimal = 'm';
    r = 0;
    if(letter >= 'a' && letter <= 'z') { r += 1; }
    if(letter >= 'A' && letter <= 'Z') { r += 10; }
    if(letter == 'm') { r += 100; }
    expect("characters as conditions", r, 101);

    // ---- nesting
    a : decimal = 3;
    b : decimal = 8;
    r = 0;
    if(a < 5) {
        r += 1;
        if(b < 5) {
            r += 10;
        } else {
            r += 100;
            if(a + b == 11) {
                r += 1000;
            }
        }
        r += 10000;
    } else {
        r += 100000;
    }
    expect("three levels deep", r, 11101);

    r = 0;
    if(a > 5) {
        if(b > 5) {
            r = 1;
        } else {
            r = 2;
        }
    } else {
        if(b > 5) {
            r = 3;
        } else {
            r = 4;
        }
    }
    expect("an if / else in each branch", r, 3);

    // ---- an else belongs to the nearest if
    r = 0;
    if(a == 3) {
        if(b == 0) {
            r = 1;
        } else {
            r = 2;
        }
    }
    expect("the inner else", r, 2);

    // ---- without braces
    r = 0;
    if(a == 3) r = 5;
    expect("if without braces", r, 5);
    if(a == 4) r = 6; else r = 7;
    expect("if / else without braces", r, 7);
    if(a == 1) r = 1;
    else if(a == 3) r = 2;
    else r = 3;
    expect("a chain without braces", r, 2);

    // ---- empty branches
    r = 9;
    if(a == 3) {
    } else {
        r = 0;
    }
    expect("an empty if branch", r, 9);
    if(a == 4) {
        r = 0;
    } else {
    }
    expect("an empty else branch", r, 9);

    // ---- several ifs in a row all get their turn
    r = 0;
    if(a > 0) { r++; }
    if(a > 1) { r++; }
    if(a > 2) { r++; }
    if(a > 3) { r++; }
    if(a > 4) { r++; }
    expect("five ifs, three of them true", r, 3);

    // ---- a variable changed by one branch is seen by the next if
    step : decimal = 1;
    if(step == 1) { step = 2; }
    if(step == 2) { step = 3; }
    if(step == 1) { step = 100; }
    expect("branches in order", step, 3);

    // ---- an if inside a loop
    evens : decimal = 0;
    odds : decimal = 0;
    for(i : decimal = 1; i <= 10; i++) {
        if(i % 2 == 0) {
            evens += i;
        } else {
            odds += i;
        }
    }
    expect("sum of the even numbers to 10", evens, 30);
    expect("sum of the odd numbers to 10", odds, 25);

    // ---- returning from branches
    expect("sign(-8)", sign(0 - 8), 0 - 1);
    expect("sign(0)", sign(0), 0);
    expect("sign(0.5)", sign(0.5), 1);
    expect("grade(95)", grade(95), 4);
    expect("grade(90)", grade(90), 4);
    expect("grade(89)", grade(89), 3);
    expect("grade(75)", grade(75), 2);
    expect("grade(60)", grade(60), 1);
    expect("grade(59)", grade(59), 0);
    expect("absolute(-4)", absolute(0 - 4), 4);
    expect("absolute(4)", absolute(4), 4);
    expect("absolute(0)", absolute(0), 0);
    expect("quadrant(1, 1)", quadrant(1, 1), 1);
    expect("quadrant(-1, 1)", quadrant(0 - 1, 1), 2);
    expect("quadrant(-1, -1)", quadrant(0 - 1, 0 - 1), 3);
    expect("quadrant(1, -1)", quadrant(1, 0 - 1), 4);
    expect("quadrant(0, 5)", quadrant(0, 5), 0);
    expect("quadrant(5, 0)", quadrant(5, 0), 0);

    // ---- the ?: expression picks one of two values
    expect("true ? 1 : 2", true ? 1 : 2, 1);
    expect("false ? 1 : 2", false ? 1 : 2, 2);
    expect("a < b ? a : b", a < b ? a : b, 3);
    expect("a > b ? a : b", a > b ? a : b, 8);
    larger : decimal = a > b ? a : b;
    expect("stored in a variable", larger, 8);
    expect("in arithmetic", 10 + (a == 3 ? 5 : 0), 15);
    expect("nested", a > 5 ? 1 : (b > 5 ? 2 : 3), 2);
    calls = 0;
    r = a == 3 ? touch(1) : touch(2);
    expect("picks the first value", r, 1);
    expect("...and only evaluates that one", calls, 1);

    finish("if_else");
}
