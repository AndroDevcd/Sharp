mod main;

import ( std.testing, std.collections )

/**
 * std.collections - transforms<T, R>, the Kotlin style helpers that produce another
 * type: map, flat_map, fold, group_by, associate, zip, distinct_by.
 */

class person {
    name : string;
    age : decimal;
    city : string;
    person(name: string, age: decimal, city: string) {
        self->name = name;
        self->age = age;
        self->city = city;
    }
}

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def is_even(n: int) : bool { return n.value % 2 == 0; }
def is_big(n: int) : bool { return n.value > 100; }
def is_small(n: int) : bool { return n.value < 3; }
def value_of(n: int) : decimal { return n.value; }
def age_of(p: person) : decimal { return p.age; }
def city_of(p: person) : string { return p.city; }
def name_of(p: person) : string { return p.name; }

/** a list<int> with the numbers from..to (both included) */
def numbers(from: decimal, to: decimal) : list<int> {
    result := new list<int>();
    for(i : decimal = from; i <= to; i++) result.add(new int(i));
    return result;
}

/** "1,2,3" for a list of ints */
def join(items: list<int>) : string {
    return collections<int>.join_to_string(items, ",");
}

/** the names of a list of people: "ann,bob" */
def names(people: list<person>) : string {
    text := "";
    for(i : decimal = 0; i < people.size().value; i++) {
        if(i > 0) text = text + ",";
        text = text + people.at(i).name;
    }
    return text;
}

def people() : list<person> {
    result := new list<person>();
    result.add(new person("ann", 31, "oslo"));
    result.add(new person("bob", 25, "rome"));
    result.add(new person("cid", 42, "oslo"));
    result.add(new person("dee", 25, "bern"));
    result.add(new person("eve", 37, "rome"));
    return result;
}

def test_transforms() {
    n := numbers(1, 5);
    empty := new list<int>();
    crowd := people();

    doubled := transforms<int, int>.map(n, { x: int -> (int) return x.value * 2; });
    test("map") { expect(join(doubled)).should_be("2,4,6,8,10"); };
    test("map of empty") { expect(join(transforms<int, int>.map(empty, { x: int -> (int) return x.value * 2; }))).should_be(""); };
    cities := transforms<person, string>.map(crowd, city_of);
    test("map to another type") { expect(collections<string>.join_to_string(cities, ",")).should_be("oslo,rome,oslo,bern,rome"); };
    lengths := transforms<string, int>.map(cities, { s: string -> (int) return s.size(); });
    test("map string -> int") { expect(collections<int>.sum_of(lengths, value_of)).should_be(20); };
    test("map_indexed") { expect(join(transforms<int, int>.map_indexed(n, { i: int, x: int -> (int) return i.value * 10 + x.value; }))).should_be("1,12,23,34,45"); };

    test("flat_map") { expect(join(transforms<int, int>.flat_map(numbers(1, 3), { x: int -> (list<int>) return numbers(1, x.value); }))).should_be("1,1,2,1,2,3"); };
    test("flat_map empty") { expect(join(transforms<int, int>.flat_map(empty, { x: int -> (list<int>) return numbers(1, x.value); }))).should_be(""); };

    test("fold sum") { expect(transforms<int, int>.fold(n, 10, { sum: int, x: int -> (int) return sum.value + x.value; }).value).should_be(25); };
    test("fold of empty is the start value") { expect(transforms<int, int>.fold(empty, 10, { sum: int, x: int -> (int) return sum.value + x.value; }).value).should_be(10); };
    test("fold to another type") { expect(transforms<person, string>.fold(crowd, "", { text: string, p: person -> (string) return text + p.name; })).should_be("annbobciddeeeve"); };

    groups := transforms<person, string>.group_by(crowd, city_of);
    test("group_by number of groups") { expect(groups.size()).should_be(3); };
    test("group_by keys in first-seen order") { expect(collections<string>.join_to_string(groups.keys(), ",")).should_be("oslo,rome,bern"); };
    test("group_by oslo") { expect(names(groups.at("oslo")!!)).should_be("ann,cid"); };
    test("group_by rome") { expect(names(groups.at("rome")!!)).should_be("bob,eve"); };
    test("group_by bern") { expect(names(groups.at("bern")!!)).should_be("dee"); };
    test("group_by of empty") { expect(transforms<person, string>.group_by(new list<person>(), city_of).size()).should_be(0); };
    parity := transforms<int, int>.group_by(numbers(1, 7), { x: int -> (int) return x.value % 3; });
    test("group_by int keys: 1") { expect(join(parity.at(1)!!)).should_be("1,4,7"); };
    test("group_by int keys: 0") { expect(join(parity.at(0)!!)).should_be("3,6"); };

    by_name := transforms<person, string>.associate_by(crowd, name_of);
    test("associate_by size") { expect(by_name.size()).should_be(5); };
    test("associate_by lookup") { expect(by_name.at("cid")!!.age).should_be(42); };
    by_city := transforms<person, string>.associate_by(crowd, city_of);
    test("associate_by: equal keys collapse") { expect(by_city.size()).should_be(3); };
    test("associate_by: the last one wins") { expect(by_city.at("oslo")!!.name).should_be("cid"); };
    squares := transforms<int, int>.associate_with(n, { x: int -> (int) return x.value * x.value; });
    test("associate_with size") { expect(squares.size()).should_be(5); };
    test("associate_with lookup") { expect(squares.at(4)!!.value).should_be(16); };

    pairs := transforms<int, string>.zip(n, cities);
    test("zip size") { expect(pairs.size().value).should_be(5); };
    test("zip first.first") { expect(pairs.at(0).first.value).should_be(1); };
    test("zip first.second") { expect(pairs.at(0).second).should_be("oslo"); };
    test("zip last.second") { expect(pairs.at(4).second).should_be("rome"); };
    test("zip stops at the shorter one") { expect(transforms<int, int>.zip(n, numbers(1, 2)).size().value).should_be(2); };
    test("zip with empty") { expect(transforms<int, int>.zip(n, empty).size().value).should_be(0); };

    test("distinct_by") { expect(names(transforms<person, string>.distinct_by(crowd, city_of))).should_be("ann,bob,dee"); };

    // scale: group 6000 numbers by their remainder, map them back
    big := numbers(1, 6000);
    by_remainder := transforms<int, int>.group_by(big, { x: int -> (int) return x.value % 7; });
    test("group_by 6000: groups") { expect(by_remainder.size()).should_be(7); };
    test("group_by 6000: size of group 0") { expect(by_remainder.at(0)!!.size().value).should_be(857); };
    test("group_by 6000: size of group 1") { expect(by_remainder.at(1)!!.size().value).should_be(858); };
    total : decimal = 0;
    foreach(entry in by_remainder) { total += entry.value.size().value; }
    test("group_by 6000: nothing lost") { expect(total).should_be(6000); };
    test("map + fold 6000") { expect(transforms<int, int>.fold(transforms<int, int>.map(big, { x: int -> (int) return x.value * 2; }), 0, { sum: int, x: int -> (int) return sum.value + x.value; }).value).should_be(36006000); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_transforms") {
        test_transforms();
    };
    finish_tests();
}
