mod main;

import ( testing )

/**
 * Arrays of objects: class instances, strings, number boxes and `object`.
 *
 * An array of objects holds REFERENCES. A new array is full of nulls; putting
 * an object in a slot does not copy it, so the slot and every other variable
 * that refers to the object see the same fields.
 */

class item {
    name : string;
    weight : decimal;

    item(n: string, w: decimal) {
        name = n;
        weight = w;
    }

    override def to_string() : string? { return name; }
}

/** a class with array fields */
class shelf {
    items : item[] = new item[2];
    labels : string[];
}

def total_weight(items: item[]) : decimal {
    total : decimal = 0;
    foreach(it in items) {
        total += it.weight;
    }
    return total;
}

def heaviest(items: item[]) : item {
    best := items[0];
    foreach(it in items) {
        if(it.weight > best.weight) {
            best = it;
        }
    }
    return best;
}

def count_nulls(items: item[]) : decimal {
    count : decimal = 0;
    foreach(it in items) {
        if(it == null) { count++; }
    }
    return count;
}

/** changes the objects the caller's array refers to */
def double_weights(items: item[]) {
    foreach(it in items) {
        it.weight *= 2;
    }
}

/** puts a new object in the caller's array */
def put_first(items: item[], replacement: item) {
    items[0] = replacement;
}

def make_names(n: decimal) : string[] {
    result := new string[n];
    for(i : decimal = 0; i < n; i++) {
        index : int = i;
        result[i] = "name" + index;
    }
    return result;
}

def make_items() : item[] {
    return new item[] { new item("p", 1), new item("q", 2), new item("r", 3) };
}

def join(parts: string[]) : string {
    result := new string();
    foreach(part in parts) {
        result += part;
        result += ",";
    }
    return result;
}

def main(args: string[]) {
    // ---- a new array is all nulls
    items := new item[3];
    expect("sizeof", sizeof(items), 3);
    expect_null("element 0 before it is set", items[0]);
    expect_null("element 2 before it is set", items[2]);
    expect("count_nulls of a new array", count_nulls(items), 3);

    // ---- putting objects in and reading their members
    items[0] = new item("rock", 5);
    items[1] = new item("leaf", 1);
    expect_not_null("element 0 after it is set", items[0]);
    expect_str("field of an element", items[0].name, "rock");
    expect("number field of an element", items[1].weight, 1);
    expect_str("method of an element", items[1].to_string()!!, "leaf");
    expect("fields of two elements", items[0].weight + items[1].weight, 6);
    expect_null("element 2 is still null", items[2]);
    expect("count_nulls with two set", count_nulls(items), 1);

    // ---- changing an object through the array
    items[0].weight = 6;
    expect("field assigned through the element", items[0].weight, 6);
    items[0].weight += 2;
    expect("field += through the element", items[0].weight, 8);
    items[0].weight++;
    expect("field ++ through the element", items[0].weight, 9);

    // ---- the slot and a variable refer to one object
    rock := items[0];
    rock.weight = 50;
    expect("a change through the variable is seen in the array", items[0].weight, 50);
    items[0].weight = 51;
    expect("a change through the array is seen by the variable", rock.weight, 51);
    expect_true("element == the variable", items[0] == rock);
    expect_false("two different elements", items[0] == items[1]);

    // ---- two slots, one object
    items[2] = rock;
    expect_true("two slots refer to the same object", items[0] == items[2]);
    items[2].weight = 7;
    expect("a change through one slot is seen through the other", items[0].weight, 7);

    // ---- replacing an element leaves the old object alone
    items[0] = new item("gem", 9);
    expect_str("the slot has the new object", items[0].name, "gem");
    expect_str("the variable still has the old one", rock.name, "rock");
    expect_str("...and so does the other slot", items[2].name, "rock");
    expect_false("the slots are different objects now", items[0] == items[2]);

    // ---- foreach
    items[0] = new item("a", 1);
    items[1] = new item("b", 2);
    items[2] = new item("c", 3);
    expect("total_weight: 1 + 2 + 3", total_weight(items), 6);
    names := new string();
    foreach(it in items) {
        names += it.name;
    }
    expect_str("foreach visits the elements in order", names, "abc");
    visits : decimal = 0;
    foreach(it in new item[0]) {
        visits++;
    }
    expect("foreach over an empty array", visits, 0);

    // the loop variable refers to the object, so its fields can be changed
    foreach(it in items) {
        it.weight *= 10;
    }
    expect("fields changed inside foreach", items[0].weight + items[1].weight + items[2].weight, 60);

    // ---- a plain for loop with an index
    backwards := new string();
    for(i : decimal = sizeof(items) - 1; i >= 0; i--) {
        backwards += items[i].name;
    }
    expect_str("for loop from the end", backwards, "cba");

    // ---- arrays of objects as arguments
    items[1].weight = 500;
    expect_str("heaviest", heaviest(items).name, "b");
    expect_true("the result is the element itself", heaviest(items) == items[1]);
    double_weights(items);
    expect("a function changed the objects", items[0].weight, 20);
    expect("...all of them", items[1].weight, 1000);
    put_first(items, new item("new", 4));
    expect_str("a function replaced an element", items[0].name, "new");

    // ---- two variables, one array
    same := items;
    same[2] = new item("z", 26);
    expect_str("an element set through the other variable", items[2].name, "z");

    // ---- an array written as a list of objects
    listed := new item[] { new item("p", 1), new item("q", 2) };
    expect("list of objects: size", sizeof(listed), 2);
    expect_str("list of objects: second", listed[1].name, "q");
    made := make_items();
    expect("returned from a function: size", sizeof(made), 3);
    expect("returned from a function: total", total_weight(made), 6);
    expect_str("element of a function result", make_items()[2].name, "r");

    // ---- arrays of strings
    words := new string[] { "a", "bc", "def" };
    expect("string array size", sizeof(words), 3);
    expect_str("string element", words[1], "bc");
    expect("method on a string element", words[2].size(), 3);
    expect_str("join", join(words), "a,bc,def,");
    words[0] = "zz";
    expect_str("string element replaced", words[0], "zz");
    words[0] = words[1] + words[2];
    expect_str("element made from two others", words[0], "bcdef");
    expect_str("...which are unchanged", words[1] + "|" + words[2], "bc|def");

    empty_words := new string[2];
    expect_null("a new string array holds nulls, not empty strings", empty_words[0]);
    empty_words[0] = "x";
    expect_str("string stored in it", empty_words[0], "x");
    expect_null("the other element is still null", empty_words[1]);

    // two slots referring to one string object
    empty_words[1] = empty_words[0];
    empty_words[1] += "y";
    expect_str("+= through one slot changes the shared string", empty_words[0], "xy");

    generated := make_names(3);
    expect("string array from a function: size", sizeof(generated), 3);
    expect_str("string array from a function: first", generated[0], "name0");
    expect_str("string array from a function: last", generated[2], "name2");

    // the arguments of main are a string array too (none are given to a test)
    expect("sizeof(args)", sizeof(args), 0);

    // ---- arrays of number boxes
    boxes := new int[] { 1, 2, 3 };
    sum := new int(0);
    foreach(n in boxes) {
        sum += n;
    }
    expect("int boxes from a list: 1 + 2 + 3", sum.value, 6);
    boxes[0] += 10;
    expect("+= on a box element", boxes[0].value, 11);
    unset := new long[2];
    expect_null("a new array of boxes holds nulls, not zeros", unset[0]);

    // ---- object[] can hold anything
    mixed := new object[3];
    mixed[0] = new item("thing", 1);
    mixed[1] = new string("text");
    mixed[2] = new int(5);
    expect_str("object[]: an item", (mixed[0] as item).name, "thing");
    expect_str("object[]: a string", mixed[1] as string, "text");
    expect("object[]: an int", (mixed[2] as int).value, 5);

    // ---- array fields
    s := new shelf();
    expect("array field with a default: size", sizeof(s.items), 2);
    expect_null("array field without a default is null", s.labels);
    s.items[0] = new item("f", 4);
    expect("element of an array field", s.items[0].weight, 4);
    s.labels = words;
    expect_str("array field given an existing array", s.labels[1], "bc");
    words[1] = "changed";
    expect_str("...it is the same array", s.labels[1], "changed");
    other_shelf := new shelf();
    expect_null("each object has its own array", other_shelf.items[0]);

    // ---- outside the array
    try {
        items[3] = new item("x", 1);
        fail("write past the end", "no exception");
    } catch(e: out_of_bounds_exception) {
        pass("write past the end");
    }
    try {
        unreachable := items[10];
        fail("read past the end", "no exception");
    } catch(e: out_of_bounds_exception) {
        pass("read past the end");
    }
    expect("the array is intact afterwards", sizeof(items), 3);
    expect_str("...and so are its elements", items[2].name, "z");

    finish("arrays_objects");
}
