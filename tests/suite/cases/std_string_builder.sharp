mod main;

import ( std.testing )

/**
 * std string_builder: collects text piece by piece.
 *
 * This file reads what is in the builder one character at a time with at(),
 * through text_of() below (it was written when size(), to_string(), ==, +,
 * ends_with, substring and the copy constructor were wrong; those are checked
 * in std_string_builder_fixes.sharp).
 * Everything that is checked here is the content: appending
 * every supported type, replacing a character, starting again with `=`, and
 * building long texts.
 */

class version : printable {
    major : decimal = 0;

    version(m: decimal) { major = m; }

    override def to_string() : string? = new string("version");
}

/** the first `count` characters of the builder, as a string */
def text_of(builder: string_builder, count: decimal): string {
    text : string = "";
    for(i : decimal = 0; i < count; i++) {
        text = text + builder.at(i);
    }
    return text;
}

def main(args: string[]) {
    show_only_failures();
    tests("std_string_builder") {
        // ---- append a string
        sb := new string_builder();
        sb.append("abc");
        test("append(string)") { expect(text_of(sb, 3)).should_be("abc"); };
        sb.append("de");
        test("a second append goes after the first") { expect(text_of(sb, 5)).should_be("abcde"); };
        sb.append("");
        sb.append("f");
        test("appending an empty string adds nothing") { expect(text_of(sb, 6)).should_be("abcdef"); };

        // ---- at: one character
        test("at(0)") { expect(sb.at(0).value).should_be('a'); };
        test("at(3)") { expect(sb.at(3).value).should_be('d'); };
        test("at(5), the last character") { expect(sb.at(5).value).should_be('f'); };
        test("[] is the same as at") { expect(sb[1].value).should_be('b'); };

        // ---- append a character
        letters := new string_builder();
        letters.append('x');
        letters.append('y');
        boxed : char = 'z';
        letters.append(boxed);
        test("append of character literals and of a char object") { expect(text_of(letters, 3)).should_be("xyz"); };

        // ---- append a string variable and a string built at run time
        word : string = "left";
        other := "right";
        joined := new string_builder();
        joined.append(word);
        joined.append("-" + other);
        test("append of string variables") { expect(text_of(joined, 10)).should_be("left-right"); };
        test("the appended string itself is unchanged") { expect(word).should_be("left"); };

        // ---- append returns the builder, so calls can be chained
        chain := new string_builder();
        chain.append("one").append(",").append("two").append(',').append("three");
        test("chained appends") { expect(text_of(chain, 13)).should_be("one,two,three"); };
        returned := chain.append("!");
        returned.append("?");                       // goes into `chain`: append returned the builder itself
        test("append returns the builder: first append") { expect(chain.at(13).value).should_be('!'); };
        test("append returns the builder: append through the returned value") { expect(chain.at(14).value).should_be('?'); };

        // ---- += with a string
        plus := new string_builder();
        plus += "ab";
        plus += "cd";
        test("+= string") { expect(text_of(plus, 4)).should_be("abcd"); };

        // ---- += with numbers and other printable objects: their text is appended
        whole : int = 42;
        typed := new string_builder();
        typed += "n=";
        typed += whole;
        test("+= int") { expect(text_of(typed, 4)).should_be("n=42"); };

        negative : int = 0 - 7;
        typed += negative;
        test("+= negative int") { expect(text_of(typed, 6)).should_be("n=42-7"); };

        big_number : long = 1234567890;
        longs := new string_builder();
        longs += big_number;
        test("+= long") { expect(text_of(longs, 10)).should_be("1234567890"); };

        yes : bool = true;
        no : bool = false;
        flags := new string_builder();
        flags += yes;
        flags += "/";
        flags += no;
        test("+= bool") { expect(text_of(flags, 10)).should_be("true/false"); };

        fraction : double = 1.5;
        doubles := new string_builder();
        doubles += fraction;
        test("+= double starts with its digits") { expect(text_of(doubles, 3)).should_be("1.5"); };

        letter : char = 'q';
        chars := new string_builder();
        chars += "<";
        chars.append(letter);
        chars += ">";
        test("a char object between two strings") { expect(text_of(chars, 3)).should_be("<q>"); };

        custom := new string_builder();
        release : printable = new version(3);
        custom += release;
        test("+= an object of a printable class uses its to_string()") { expect(text_of(custom, 7)).should_be("version"); };

        // ---- += with another builder
        front := new string_builder("front");
        back := new string_builder("back");
        front += "+";
        test("constructor text followed by +=") { expect(text_of(front, 6)).should_be("front+"); };
        test("the other builder is not touched") { expect(text_of(back, 4)).should_be("back"); };

        // ---- constructors
        from_text := new string_builder("hello");
        test("string_builder(string)") { expect(text_of(from_text, 5)).should_be("hello"); };
        from_text.append(" world");
        test("append after the constructor text") { expect(text_of(from_text, 11)).should_be("hello world"); };

        from_variable := new string_builder(word);
        test("string_builder(string variable)") { expect(text_of(from_variable, 4)).should_be("left"); };

        // ---- starts_with
        test("starts_with: the first characters") { expect_true(from_text.starts_with("hello").value); };
        test("starts_with: one character") { expect_true(from_text.starts_with("h").value); };
        test("starts_with: the whole text") { expect_true(from_text.starts_with("hello world").value); };
        test("starts_with: other text") { expect_false(from_text.starts_with("world").value); };
        test("starts_with: a difference in the last character") { expect_false(from_text.starts_with("hellp").value); };
        test("starts_with: longer than the text") { expect_false(from_text.starts_with("hello world and more").value); };

        // ---- replace one character
        from_text.replace(0, 'J');
        test("replace(0)") { expect(text_of(from_text, 11)).should_be("Jello world"); };
        from_text.replace(10, 'D').replace(5, '_');
        test("replace is chainable") { expect(text_of(from_text, 11)).should_be("Jello_worlD"); };

        // ---- at past the end throws
        caught : decimal = 0;
        short_text := new string_builder("abc");
        try {
            short_text.at(10);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("at() far past the end throws out_of_bounds_exception") { expect(caught).should_be(1); };
        test("...and the builder is unchanged") { expect(text_of(short_text, 3)).should_be("abc"); };

        // ---- starting again with =
        reused := new string_builder("first text");
        reused = "second";
        test("= replaces the text") { expect(text_of(reused, 6)).should_be("second"); };
        reused.append("!");
        test("append after =") { expect(text_of(reused, 7)).should_be("second!"); };

        // ---- two builders are independent
        one := new string_builder();
        two := new string_builder();
        one.append("111");
        two.append("222");
        one.append("1");
        test("builder one") { expect(text_of(one, 4)).should_be("1111"); };
        test("builder two") { expect(text_of(two, 3)).should_be("222"); };

        // ---- building a long text: past the first capacity (255 characters)
        digits := new string_builder();
        for(i : decimal = 0; i < 1000; i++) {
            digits.append("0123456789");
        }
        test("long text: the start") { expect(text_of(digits, 12)).should_be("012345678901"); };
        test("long text: character 254") { expect(digits.at(254).value).should_be('4'); };
        test("long text: character 255 (first one past the first capacity)") { expect(digits.at(255).value).should_be('5'); };
        test("long text: character 256") { expect(digits.at(256).value).should_be('6'); };
        test("long text: character 5005") { expect(digits.at(5005).value).should_be('5'); };
        test("long text: the last character, 9999") { expect(digits.at(9999).value).should_be('9'); };

        // every one of the 10000 characters: 1000 times the digits 0..9, their sum is 45000
        sum : decimal = 0;
        for(i : decimal = 0; i < 10000; i++) {
            sum += digits.at(i).value - '0';
        }
        test("long text: every character is the right digit") { expect(sum).should_be(45000); };

        // ---- a long text built one character at a time
        stars := new string_builder();
        for(i : decimal = 0; i < 3000; i++) {
            stars.append('*');
        }
        stars.append('#');
        count : decimal = 0;
        for(i : decimal = 0; i < 3000; i++) {
            if(stars.at(i).value == '*') count++;
        }
        test("3000 single characters") { expect(count).should_be(3000); };
        test("...and the one after them") { expect(stars.at(3000).value).should_be('#'); };

        // ---- a long text made of long pieces
        piece : string = "The quick brown fox jumps over the lazy dog. ";      // 45 characters
        story := new string_builder();
        for(i : decimal = 0; i < 200; i++) {
            story.append(piece);
        }
        test("long pieces: first character") { expect(story.at(0).value).should_be('T'); };
        test("long pieces: start of the last piece (199 * 45)") { expect(story.at(8955).value).should_be('T'); };
        test("long pieces: the last full stop (9000 - 2)") { expect(story.at(8998).value).should_be('.'); };
        test("long pieces: starts_with") { expect_true(story.starts_with("The quick brown fox").value); };

        // ---- many builders
        made : decimal = 0;
        for(i : decimal = 0; i < 200; i++) {
            temp := new string_builder("item");
            temp.append("-ok");
            if(temp.at(6).value == 'k') made++;
        }
        test("200 short-lived builders") { expect(made).should_be(200); };
    };
    finish_tests();
}
