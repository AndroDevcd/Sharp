mod main;

import ( testing, std.collections )

/**
 * std.collections - the array backed queues: stack, queue, deque (a ring
 * buffer) and priority_queue (a binary heap).
 */

/** "1,2,3" for an array of ints ("" for null or empty) */
def join(items: int[]?) : string {
    text := "";
    if(items == null) return text;
    for(i : decimal = 0; i < sizeof(items); i++) {
        if(i > 0) text = text + ",";
        text = text + items[i];
    }
    return text;
}

/** "1,2,3" for everything an iterator still has to give */
def drain(it: iterator<int>) : string {
    text := "";
    first : decimal = 1;
    while(it.has_next()) {
        if(!first) text = text + ",";
        first = 0;
        text = text + it.next();
    }
    return text;
}

/** works with ANY collection of the module: that is the point of `iterable` */
def total(numbers: iterable<int>) : decimal {
    sum : decimal = 0;
    it := numbers.iterator();
    while(it.has_next()) sum += it.next().value;
    return sum;
}

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def descending(a: int, b: int) : decimal { return b.value - a.value; }

def test_stack() {
    s := new stack<int>();
    expect("stack new size", s.size(), 0);
    expect("stack new is_empty", s.is_empty(), 1);
    expect_null("stack peek_or_null empty", s.peek_or_null());
    expect_null("stack pop_or_null empty", s.pop_or_null());
    expect_null("stack empty get_elements", s.get_elements());
    try { s.pop(); fail("stack pop empty", "did not throw"); } catch(e: no_such_element_exception) { pass("stack pop empty"); }
    try { s.peek(); fail("stack peek empty", "did not throw"); } catch(e: no_such_element_exception) { pass("stack peek empty"); }

    s.push(1); s.push(2); s.push(3);
    expect("stack size", s.size(), 3);
    expect("stack peek", s.peek().value, 3);
    expect("stack peek keeps it", s.size(), 3);
    expect("stack search top", s.search(3), 0);
    expect("stack search bottom", s.search(1), 2);
    expect("stack search missing", s.search(9), 0 - 1);
    expect("stack contains", s.contains(2), 1);
    expect("stack contains missing", s.contains(7), 0);
    expect_str("stack to_array is top down", join(s.to_array()), "3,2,1");
    expect_str("stack iterator is top down", drain(s.iterator()), "3,2,1");
    digits : decimal = 0;
    foreach(x in s) { digits = digits * 10 + x.value; }
    expect("stack foreach is top down", digits, 321);
    expect("stack to_list first", s.to_list().at(0).value, 3);
    expect("stack through iterable", total(s), 6);

    expect("stack pop", s.pop().value, 3);
    expect("stack pop 2", s.pop().value, 2);
    expect("stack pop_or_null", s.pop_or_null()!!.value, 1);
    expect("stack empty after pops", s.is_empty(), 1);

    // growth past the first array (16) and LIFO order: push 0..999, pop gives 999..0
    for(i : decimal = 0; i < 1000; i++) s.push(i);
    expect("stack big size", s.size(), 1000);
    in_order : decimal = 1;
    for(i : decimal = 999; i >= 0; i--) {
        if(s.pop().value != i) in_order = 0;
    }
    expect("stack pops in reverse order", in_order, 1);
    expect("stack empty at the end", s.size(), 0);

    s.push(4); s.push(5);
    s.clear();
    expect("stack clear", s.size(), 0);
    s.push(6);
    expect("stack usable after clear", s.peek().value, 6);
}

def test_queue() {
    q := new queue<int>();
    expect("queue new size", q.size(), 0);
    expect("queue new is_empty", q.is_empty(), 1);
    expect_null("queue peek_or_null empty", q.peek_or_null());
    expect_null("queue dequeue_or_null empty", q.dequeue_or_null());
    expect_null("queue empty get_elements", q.get_elements());
    try { q.dequeue(); fail("queue dequeue empty", "did not throw"); } catch(e: no_such_element_exception) { pass("queue dequeue empty"); }
    try { q.peek(); fail("queue peek empty", "did not throw"); } catch(e: no_such_element_exception) { pass("queue peek empty"); }
    try { q.back(); fail("queue back empty", "did not throw"); } catch(e: no_such_element_exception) { pass("queue back empty"); }

    q.enqueue(1); q.enqueue(2); q.add(3);
    expect("queue size", q.size(), 3);
    expect("queue peek", q.peek().value, 1);
    expect("queue back", q.back().value, 3);
    expect("queue contains", q.contains(2), 1);
    expect("queue contains missing", q.contains(5), 0);
    expect_str("queue to_array", join(q.to_array()), "1,2,3");
    expect_str("queue iterator", drain(q.iterator()), "1,2,3");
    expect("queue to_list last", q.to_list().at(2).value, 3);
    digits : decimal = 0;
    foreach(x in q) { digits = digits * 10 + x.value; }
    expect("queue foreach", digits, 123);
    expect("queue dequeue", q.dequeue().value, 1);
    expect("queue dequeue 2", q.dequeue().value, 2);
    expect("queue dequeue_or_null", q.dequeue_or_null()!!.value, 3);
    expect("queue empty", q.is_empty(), 1);

    // the ring buffer wraps around many times: keep 5 waiting while 2000 pass through
    for(i : decimal = 0; i < 5; i++) q.enqueue(i);
    fifo : decimal = 1;
    for(i : decimal = 5; i < 2000; i++) {
        q.enqueue(i);
        if(q.dequeue().value != i - 5) fifo = 0;
    }
    expect("queue is first-in first-out", fifo, 1);
    expect("queue size after wrap", q.size(), 5);
    expect_str("queue rest", join(q.to_array()), "1995,1996,1997,1998,1999");
    expect("queue through iterable", total(q), 9985);
    q.clear();
    expect("queue clear", q.size(), 0);
}

def test_deque() {
    d := new deque<int>();
    expect("deque new size", d.size(), 0);
    expect("deque new is_empty", d.is_empty(), 1);
    expect("deque capacity", d.capacity(), 16);
    expect_null("deque first_or_null empty", d.first_or_null());
    expect_null("deque last_or_null empty", d.last_or_null());
    expect_null("deque empty get_elements", d.get_elements());
    try { d.remove_first(); fail("deque remove_first empty", "did not throw"); } catch(e: no_such_element_exception) { pass("deque remove_first empty"); }
    try { d.remove_last(); fail("deque remove_last empty", "did not throw"); } catch(e: no_such_element_exception) { pass("deque remove_last empty"); }
    try { d.first(); fail("deque first empty", "did not throw"); } catch(e: no_such_element_exception) { pass("deque first empty"); }
    try { d.last(); fail("deque last empty", "did not throw"); } catch(e: no_such_element_exception) { pass("deque last empty"); }

    d.add_last(2); d.add_last(3); d.add_first(1); d.add(4); d.add_first(0);
    expect_str("deque order", join(d.to_array()), "0,1,2,3,4");
    expect("deque size", d.size(), 5);
    expect("deque first", d.first().value, 0);
    expect("deque last", d.last().value, 4);
    expect("deque first_or_null", d.first_or_null()!!.value, 0);
    expect("deque last_or_null", d.last_or_null()!!.value, 4);
    expect("deque at 0", d.at(0).value, 0);
    expect("deque at 3", d.at(3).value, 3);
    expect("deque put returns old", d.put(3, 7).value, 3);
    expect("deque index_of", d.index_of(7), 3);
    expect("deque index_of missing", d.index_of(3), 0 - 1);
    expect("deque contains", d.contains(2), 1);
    expect("deque contains missing", d.contains(9), 0);
    try { d.at(5); fail("deque at(size)", "did not throw"); } catch(e: out_of_bounds_exception) { pass("deque at(size)"); }
    try { d.at(0 - 1); fail("deque at(-1)", "did not throw"); } catch(e: out_of_bounds_exception) { pass("deque at(-1)"); }
    try { d.put(5, 1); fail("deque put(size)", "did not throw"); } catch(e: out_of_bounds_exception) { pass("deque put(size)"); }

    expect("deque remove_first", d.remove_first().value, 0);
    expect("deque remove_last", d.remove_last().value, 4);
    expect_str("deque after removes", join(d.to_array()), "1,2,7");
    expect_str("deque iterator", drain(d.iterator()), "1,2,7");
    digits : decimal = 0;
    foreach(x in d) { digits = digits * 10 + x.value; }
    expect("deque foreach", digits, 127);
    expect("deque to_list", d.to_list().at(2).value, 7);
    expect("deque through iterable", total(d), 10);

    // growth while the contents are wrapped around the end of the array
    d.clear();
    for(i : decimal = 0; i < 10; i++) d.add_last(i);
    for(i : decimal = 0; i < 8; i++) d.remove_first();           // head is now at index 8
    for(i : decimal = 10; i < 50; i++) d.add_last(i);            // wraps, then grows twice
    expect("deque grown size", d.size(), 42);
    expect("deque grown first", d.first().value, 8);
    expect("deque grown last", d.last().value, 49);
    expect("deque grown at(20)", d.at(20).value, 28);
    expect("deque grown capacity", d.capacity(), 64);
    d.ensure_capacity(100);
    expect("deque ensure_capacity", d.capacity(), 100);
    expect("deque contents survive ensure_capacity", d.at(41).value, 49);

    // scale: used as a sliding window, 3000 in at the back, out at the front
    d.clear();
    sum : decimal = 0;
    for(i : decimal = 0; i < 3000; i++) {
        d.add_last(i);
        if(d.size() > 100) sum += d.remove_first().value;
    }
    expect("deque window size", d.size(), 100);
    expect("deque window sum (0..2899)", sum, 4203550);
    expect("deque window first", d.first().value, 2900);
    // and from the other side
    for(i : decimal = 0; i < 500; i++) d.add_first(0 - i);
    expect("deque add_first many", d.first().value, 0 - 499);
    expect("deque add_first size", d.size(), 600);
    expect("deque at across the wrap", d.at(500).value, 2900);
}

def test_priority_queue() {
    pq := new priority_queue<int>(ascending);
    expect("pq new size", pq.size(), 0);
    expect("pq new is_empty", pq.is_empty(), 1);
    expect_null("pq peek_or_null empty", pq.peek_or_null());
    expect_null("pq poll_or_null empty", pq.poll_or_null());
    expect_null("pq empty get_elements", pq.get_elements());
    try { pq.poll(); fail("pq poll empty", "did not throw"); } catch(e: no_such_element_exception) { pass("pq poll empty"); }
    try { pq.peek(); fail("pq peek empty", "did not throw"); } catch(e: no_such_element_exception) { pass("pq peek empty"); }

    pq.add(5); pq.add(1); pq.add(4); pq.add(2); pq.add(3);
    expect("pq size", pq.size(), 5);
    expect("pq peek is the smallest", pq.peek().value, 1);
    expect("pq contains", pq.contains(4), 1);
    expect("pq contains missing", pq.contains(9), 0);
    expect_str("pq to_sorted_array", join(pq.to_sorted_array()), "1,2,3,4,5");
    expect("pq to_sorted_array keeps the queue", pq.size(), 5);
    expect_str("pq iterator", drain(pq.iterator()), "1,2,3,4,5");
    digits : decimal = 0;
    foreach(x in pq) { digits = digits * 10 + x.value; }
    expect("pq foreach", digits, 12345);
    expect("pq to_list", pq.to_list().at(4).value, 5);
    expect("pq through iterable", total(pq), 15);

    expect("pq remove", pq.remove(3), 1);
    expect("pq remove missing", pq.remove(3), 0);
    expect("pq poll 1", pq.poll().value, 1);
    expect("pq poll 2", pq.poll().value, 2);
    expect("pq poll 4", pq.poll().value, 4);
    expect("pq poll_or_null 5", pq.poll_or_null()!!.value, 5);
    expect("pq empty", pq.is_empty(), 1);

    // largest first with the comparison turned around, and duplicates
    big_first := new priority_queue<int>(descending);
    extra := new list<int>();
    extra.add(7); extra.add(2); extra.add(9); extra.add(7);
    big_first.add_all(extra);
    expect_str("pq descending", join(big_first.to_sorted_array()), "9,7,7,2");
    expect("pq descending poll", big_first.poll().value, 9);

    // a lambda as the comparison: shortest string first
    by_length := new priority_queue<string>({ a: string, b: string -> (decimal) return a.size().value - b.size().value; });
    by_length.add("ccc"); by_length.add("a"); by_length.add("dddd"); by_length.add("bb");
    expect_str("pq<string> poll", by_length.poll(), "a");
    expect_str("pq<string> poll 2", by_length.poll(), "bb");
    expect_str("pq<string> peek", by_length.peek(), "ccc");

    // scale: 5000 pseudo random numbers must come out in ascending order
    seed : decimal = 12345;
    sum_in : decimal = 0;
    for(i : decimal = 0; i < 5000; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        pq.add(seed);
        sum_in += seed;
    }
    expect("pq big size", pq.size(), 5000);
    ordered : decimal = 1;
    sum_out : decimal = 0;
    previous : decimal = 0 - 1;
    polled : decimal = 0;
    while(!pq.is_empty()) {
        value : decimal = pq.poll().value;
        if(value < previous) ordered = 0;
        previous = value;
        sum_out += value;
        polled++;
    }
    expect("pq big polled all", polled, 5000);
    expect("pq big comes out ascending", ordered, 1);
    expect("pq big nothing lost", sum_out, sum_in);

    // removing from the middle keeps the heap valid
    for(i : decimal = 0; i < 200; i++) pq.add((i * 37) % 200);        // a permutation of 0..199
    for(i : decimal = 0; i < 200; i += 2) pq.remove(i);                // drop the even ones
    expect("pq after middle removes size", pq.size(), 100);
    odd_order : decimal = 1;
    for(i : decimal = 1; i < 200; i += 2) {
        if(pq.poll().value != i) odd_order = 0;
    }
    expect("pq after middle removes order", odd_order, 1);
    pq.add(3);
    pq.clear();
    expect("pq clear", pq.size(), 0);
}

def main(args: string[]) {
    test_stack();
    test_queue();
    test_deque();
    test_priority_queue();
    finish("lib_collections_queues");
}
