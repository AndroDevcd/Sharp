mod main;

import ( std.testing, std.text )

/**
 * std.text - matching text against patterns:
 *   - text_pattern   wildcards: * ? [abc] [a-z] [!abc] and \ to escape
 *   - regex          regular expressions: matches, contains, find, find_all,
 *                    replace_all / replace_first, split, count
 *   - regex_match    start / end / value / group
 *
 * Two things about writing patterns in Sharp source:
 *   - a backslash in a string literal is written twice ("\\d" is the pattern \d)
 *   - a dollar sign cannot be written in a string literal at all, so the
 *     end anchor is appended as a character:  "abc" + '$'
 */

def show(parts: string[]): string {
    joined := string.join("|", parts);
    if(joined.is_empty()) return string.of_int(sizeof(parts)) + ":";
    return string.of_int(sizeof(parts)) + ":" + joined;
}

/** the first match of `pattern` in `text` as "value@start", or "none" */
def first(pattern: string, text: string): string {
    m := new regex(pattern).find(text);
    if((m as object) == null) return "none";
    return m!!.value() + "@" + string.of_int(m!!.start());
}

/** all matches of `pattern` in `text`, as show() of their values */
def all(pattern: string, text: string): string {
    found := new regex(pattern).find_all(text);
    values := new string[sizeof(found)];
    for(i : decimal = 0; i < sizeof(found); i++) {
        values[i] = found[i].value();
    }
    return show(values);
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_text_patterns") {
        // ================================================================ text_pattern
        test("star") { expect_true(text_pattern.matches("*.sharp", "main.sharp")); };
        test("star, other ending") { expect_false(text_pattern.matches("*.sharp", "main.cpp")); };
        test("star matches nothing") { expect_true(text_pattern.matches("*.sharp", ".sharp")); };
        test("star alone matches everything") { expect_true(text_pattern.matches("*", "anything at all")); };
        test("star alone matches \"\"") { expect_true(text_pattern.matches("*", "")); };
        test("empty pattern matches \"\"") { expect_true(text_pattern.matches("", "")); };
        test("empty pattern does not match text") { expect_false(text_pattern.matches("", "a")); };
        test("literal") { expect_true(text_pattern.matches("abc", "abc")); };
        test("literal must match the whole text") { expect_false(text_pattern.matches("abc", "abcd")); };
        test("literal is case sensitive") { expect_false(text_pattern.matches("abc", "ABC")); };
        test("question mark") { expect_true(text_pattern.matches("data_??.csv", "data_07.csv")); };
        test("question mark needs a character") { expect_false(text_pattern.matches("data_??.csv", "data_7.csv")); };
        test("question mark does not match \"\"") { expect_false(text_pattern.matches("?", "")); };
        test("star in the middle") { expect_true(text_pattern.matches("a*z", "a to z")); };
        test("star in the middle matching nothing") { expect_true(text_pattern.matches("a*z", "az")); };
        test("two stars") { expect_true(text_pattern.matches("*ab*cd*", "xxabyycdzz")); };
        test("two stars, wrong order") { expect_false(text_pattern.matches("*ab*cd*", "xxcdyyabzz")); };
        test("several stars in a row") { expect_true(text_pattern.matches("a***b", "ab")); };
        test("star has to back up") { expect_true(text_pattern.matches("*aab", "aaaab")); };
        test("star with repeated text") { expect_true(text_pattern.matches("*.tar.gz", "a.tar.tar.gz")); };
        test("set") { expect_true(text_pattern.matches("[abc]at", "cat")); };
        test("set, not a member") { expect_false(text_pattern.matches("[abc]at", "rat")); };
        test("range") { expect_true(text_pattern.matches("file[0-9].txt", "file7.txt")); };
        test("range, outside") { expect_false(text_pattern.matches("file[0-9].txt", "fileA.txt")); };
        test("mixed set") { expect_true(text_pattern.matches("[a-cx-z_]", "y")); };
        test("mixed set, single member") { expect_true(text_pattern.matches("[a-cx-z_]", "_")); };
        test("mixed set, outside") { expect_false(text_pattern.matches("[a-cx-z_]", "m")); };
        test("negated set") { expect_true(text_pattern.matches("[!abc]at", "rat")); };
        test("negated set, member") { expect_false(text_pattern.matches("[!abc]at", "cat")); };
        test("negated set with ^") { expect_true(text_pattern.matches("[^0-9]", "x")); };
        test("']' first in a set is a member") { expect_true(text_pattern.matches("[]x]", "]")); };
        test("'-' last in a set is a member") { expect_true(text_pattern.matches("[a-]", "-")); };
        test("escaped star") { expect_true(text_pattern.matches("a\\*b", "a*b")); };
        test("escaped star is not a wildcard") { expect_false(text_pattern.matches("a\\*b", "axb")); };
        test("escaped question mark") { expect_true(text_pattern.matches("what\\?", "what?")); };
        test("ignore case") { expect_true(text_pattern.matches_ignore_case("*.TXT", "notes.txt")); };
        test("ignore case in a set") { expect_true(text_pattern.matches_ignore_case("[a-c]", "B")); };
        test("ignore case still needs the right letters") { expect_false(text_pattern.matches_ignore_case("*.TXT", "notes.md")); };
        long_text := character.repeat('a', 5000);
        test("many stars on a long text stay fast") { expect_false(text_pattern.matches("*a*a*a*a*a*b", long_text)); };
        test("a long text that matches") { expect_true(text_pattern.matches("*a*a*a*a*a", long_text)); };

        source_files := new text_pattern("*.sharp");
        names := new string[] { "a.sharp", "b.cpp", "c.sharp", "sharp" };
        test("filter") { expect(show(source_files.filter(names))).should_be("2:a.sharp|c.sharp"); };
        test("count_matches") { expect(source_files.count_matches(names)).should_be(2); };
        test("filter with no match") { expect(show(new text_pattern("*.md").filter(names))).should_be("0:"); };
        test("pattern") { expect(source_files.pattern()).should_be("*.sharp"); };
        test("is_literal with a wildcard") { expect_false(source_files.is_literal()); };
        test("is_literal") { expect_true(new text_pattern("plain.txt").is_literal()); };
        test("has_wildcards") { expect_true(text_pattern.has_wildcards("a?b")); };
        test("has_wildcards of plain text") { expect_false(text_pattern.has_wildcards("a.b")); };
        test("escape") { expect(text_pattern.escape("what?")).should_be("what\\?"); };
        test("an escaped text matches itself") { expect_true(text_pattern.matches(text_pattern.escape("[a]*?"), "[a]*?")); };
        try {
            new text_pattern("file[0-9");
            test("unclosed set") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("unclosed set") { };
        }
        try {
            new text_pattern("abc\\");
            test("backslash at the end") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("backslash at the end") { };
        }

        // ================================================================ regex: matches (the whole text)
        digits := new regex("\\d+");
        test("matches") { expect_true(digits.matches("12345")); };
        test("matches needs the whole text") { expect_false(digits.matches("123a")); };
        test("matches of \"\" with +") { expect_false(digits.matches("")); };
        test("matches of \"\" with *") { expect_true(new regex("\\d*").matches("")); };
        test("literal") { expect_true(regex.matches("abc", "abc")); };
        test("literal, longer text") { expect_false(regex.matches("abc", "abcd")); };
        test("dot") { expect_true(regex.matches("a.c", "axc")); };
        test("dot does not match a line feed") { expect_false(regex.matches("a.c", "a\nc")); };
        test("escaped dot") { expect_true(regex.matches("a\\.c", "a.c")); };
        test("escaped dot is literal") { expect_false(regex.matches("a\\.c", "axc")); };
        test("set") { expect_true(regex.matches("[abc]+", "abcabc")); };
        test("set, not a member") { expect_false(regex.matches("[abc]+", "abd")); };
        test("range") { expect_true(regex.matches("[a-f0-9]+", "c0ffee")); };
        test("negated set") { expect_true(regex.matches("[^0-9]+", "abc")); };
        test("negated set, member") { expect_false(regex.matches("[^0-9]+", "ab1")); };
        test("class in a set") { expect_true(regex.matches("[\\d.]+", "3.14")); };
        test("word class") { expect_true(regex.matches("\\w+", "snake_case1")); };
        test("word class, space") { expect_false(regex.matches("\\w+", "two words")); };
        test("space class") { expect_true(regex.matches("a\\s+b", "a \t\nb")); };
        test("negated classes") { expect_true(regex.matches("\\D\\W\\S", "a b")); };
        test("optional, present") { expect_true(regex.matches("colou?r", "colour")); };
        test("optional, absent") { expect_true(regex.matches("colou?r", "color")); };
        test("exact count") { expect_true(regex.matches("a{3}", "aaa")); };
        test("exact count, too few") { expect_false(regex.matches("a{3}", "aa")); };
        test("exact count, too many") { expect_false(regex.matches("a{3}", "aaaa")); };
        test("count range, low end") { expect_true(regex.matches("a{2,4}", "aa")); };
        test("count range, high end") { expect_true(regex.matches("a{2,4}", "aaaa")); };
        test("count range, above") { expect_false(regex.matches("a{2,4}", "aaaaa")); };
        test("open count range") { expect_true(regex.matches("a{2,}", "aaaaaaa")); };
        test("open count range, below") { expect_false(regex.matches("a{2,}", "a")); };
        test("a brace that is no count is literal") { expect_true(regex.matches("a{x}", "a{x}")); };
        test("alternation, first") { expect_true(regex.matches("cat|dog", "cat")); };
        test("alternation, second") { expect_true(regex.matches("cat|dog", "dog")); };
        test("alternation, neither") { expect_false(regex.matches("cat|dog", "cow")); };
        test("alternation in a group") { expect_true(regex.matches("(cat|dog)s", "dogs")); };
        test("empty alternative") { expect_true(regex.matches("ab(c|)", "ab")); };
        test("group with a count") { expect_true(regex.matches("(ab){2}c", "ababc")); };
        test("nested groups") { expect_true(regex.matches("((a|b)c)+", "acbc")); };
        test("ignore case") { expect_true(new regex("hello", true).matches("HeLLo")); };
        test("ignore case in a set") { expect_true(new regex("[a-c]+", true).matches("AbC")); };
        test("hex escape") { expect_true(regex.matches("\\x41+", "AAA")); };
        test("escaped tab") { expect_true(regex.matches("a\\tb", "a\tb")); };
        test("the empty pattern matches \"\"") { expect_true(regex.matches("", "")); };
        test("the empty pattern does not match text") { expect_false(regex.matches("", "a")); };

        // ================================================================ regex: searching
        test("contains") { expect_true(digits.contains("abc 42 def")); };
        test("contains, no match") { expect_false(digits.contains("no digits")); };
        test("is_match") { expect_true(regex.is_match("b+", "aabbcc")); };
        test("index_of") { expect(digits.index_of("abc 42 def")).should_be(4); };
        test("index_of, no match") { expect(digits.index_of("none")).should_be(0 - 1); };
        test("find") { expect(first("\\d+", "abc 42 def 7")).should_be("42@4"); };
        test("find, no match") { expect(first("\\d+", "none")).should_be("none"); };
        test("find is leftmost") { expect(first("b|ab", "xab")).should_be("ab@1"); };
        test("greedy") { expect(first("<.+>", "<a><b>")).should_be("<a><b>@0"); };
        test("lazy") { expect(first("<.+?>", "<a><b>")).should_be("<a>@0"); };
        test("lazy star") { expect(first("a*?b", "aaab")).should_be("aaab@0"); };
        test("lazy optional") { expect(first("ab??", "ab")).should_be("a@0"); };
        test("start anchor") { expect(first("^ab", "abab")).should_be("ab@0"); };
        test("start anchor fails later") { expect(first("^b", "ab")).should_be("none"); };
        test("end anchor") { expect(first("ab" + '$', "abab")).should_be("ab@2"); };
        test("both anchors") { expect(first("^a.c" + '$', "abc")).should_be("abc@0"); };
        test("word boundary") { expect(first("\\bcat\\b", "concat cat")).should_be("cat@7"); };
        test("not a word boundary") { expect(first("\\Bcat", "concat cat")).should_be("cat@3"); };
        test("an empty match") { expect(first("x*", "abc")).should_be("@0"); };
        test("backing out of a star") { expect(first("a*ab", "aaab")).should_be("aaab@0"); };
        later := digits.find("a1 b22 c333", 3);
        test("find from a start") { expect(later!!.value()).should_be("22"); };
        test("find from a start, nothing left") { expect_null(digits.find("a1 b", 2)); };
        test("find_all") { expect(all("\\d+", "a1 b22 c333")).should_be("3:1|22|333"); };
        test("find_all, no match") { expect(all("\\d+", "none")).should_be("0:"); };
        test("find_all does not overlap") { expect(all("aa", "aaaaa")).should_be("2:aa|aa"); };
        test("find_all with empty matches") { expect(sizeof(new regex("x*").find_all("abc"))).should_be(4); };
        test("count") { expect(digits.count("a1 b22 c333")).should_be(3); };
        test("count, no match") { expect(digits.count("none")).should_be(0); };

        // ================================================================ regex: groups
        pair := new regex("(\\w+)@(\\w+)");
        test("group_count") { expect(pair.group_count()).should_be(2); };
        found := pair.find("mail ada@example now");
        test("a match") { expect_not_null(found); };
        m := found!!;
        test("value") { expect(m.value()).should_be("ada@example"); };
        test("start") { expect(m.start()).should_be(5); };
        test("end") { expect(m.end()).should_be(16); };
        test("length") { expect(m.length()).should_be(11); };
        test("group(0) is the whole match") { expect(m.group(0)).should_be("ada@example"); };
        test("group(1)") { expect(m.group(1)).should_be("ada"); };
        test("group(2)") { expect(m.group(2)).should_be("example"); };
        test("group_start") { expect(m.group_start(2)).should_be(9); };
        test("group_end") { expect(m.group_end(2)).should_be(16); };
        test("match group_count") { expect(m.group_count()).should_be(2); };
        test("groups_array") { expect(show(m.groups_array())).should_be("3:ada@example|ada|example"); };
        try {
            m.group(3);
            test("group(3) of two") { fail_test("did not throw"); };
        } catch(e: out_of_bounds_exception) {
            test("group(3) of two") { };
        }
        either := new regex("a|(b)").find("a");
        test("a group that took no part") { expect_false(either!!.has_group(1)); };
        test("its start is -1") { expect(either!!.group_start(1)).should_be(0 - 1); };
        test("its text is \"\"") { expect(either!!.group(1)).should_be(""); };
        other := new regex("a|(b)").find("b");
        test("the same group when it took part") { expect_true(other!!.has_group(1)); };
        repeated := new regex("(a|b)+").find("abab");
        test("a repeated group keeps its last text") { expect(repeated!!.group(1)).should_be("b"); };
        inner := new regex("(a(b)?)+").find("aba");
        test("outer group") { expect(inner!!.group(1)).should_be("a"); };
        test("non-capturing groups are not counted") { expect(string.of_int(new regex("(?:a)(b)").group_count())).should_be("1"); };
        date := new regex("(\\d{4})-(\\d{2})-(\\d{2})").find("on 2024-03-15.");
        test("three groups") { expect(date!!.group(1) + "/" + date!!.group(2) + "/" + date!!.group(3)).should_be("2024/03/15"); };

        // ================================================================ regex: replace and split
        test("replace_all") { expect(digits.replace_all("a1 b22 c333", "#")).should_be("a# b# c#"); };
        test("replace_first") { expect(digits.replace_first("a1 b22 c333", "#")).should_be("a# b22 c333"); };
        test("replace_all, no match") { expect(digits.replace_all("none", "#")).should_be("none"); };
        test("replace_all with \"\"") { expect(digits.replace_all("a1b22", "")).should_be("ab"); };
        test("replace_all with groups") { expect(pair.replace_all("ada@example", "\\2 at \\1")).should_be("example at ada"); };
        test("replace_all with the whole match") { expect(digits.replace_all("7 8", "[\\0]")).should_be("[7] [8]"); };
        test("replace_all with an escaped backslash") { expect(digits.replace_all("7", "\\\\")).should_be("\\"); };
        test("replace_all with empty matches") { expect(new regex("x*").replace_all("abc", "-")).should_be("-a-b-c-"); };
        test("replace_all ignoring case") { expect(new regex("[a-c]+", true).replace_all("xabcABCx", "#")).should_be("x#x"); };
        test("replace_all of \"\"") { expect(digits.replace_all("", "#")).should_be(""); };
        try {
            digits.replace_all("7", "\\1");
            test("replacement with a missing group") { fail_test("did not throw"); };
        } catch(e: illegal_argument_exception) {
            test("replacement with a missing group") { };
        }
        commas := new regex("\\s*,\\s*");
        test("split") { expect(show(commas.split("a , b,c"))).should_be("3:a|b|c"); };
        test("split keeps empty parts") { expect(show(commas.split(",a,,b,"))).should_be("5:|a||b|"); };
        test("split, no match") { expect(show(commas.split("abc"))).should_be("1:abc"); };
        test("split of \"\"") { expect(show(commas.split(""))).should_be("1:"); };
        test("split with a limit") { expect(show(commas.split("a,b,c,d", 2))).should_be("2:a|b,c,d"); };
        test("split by the empty pattern") { expect(show(new regex("").split("abc"))).should_be("3:a|b|c"); };
        test("split by whitespace") { expect(show(new regex("\\s+").split("to  be\tor"))).should_be("3:to|be|or"); };

        // ================================================================ regex: bad patterns, hard patterns
        try {
            new regex("(ab");
            test("unclosed group") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("the message names the problem") { expect_true(e.get_message().contains("'(' without a matching ')'")); };
        }
        try {
            new regex("ab)");
            test("unopened group") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("unopened group") { };
        }
        try {
            new regex("[abc");
            test("unclosed set") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("unclosed set") { };
        }
        try {
            new regex("*a");
            test("nothing to repeat") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("nothing to repeat") { };
        }
        try {
            new regex("a{3,2}");
            test("count range backwards") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("count range backwards") { };
        }
        try {
            new regex("\\q");
            test("unknown escape") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("unknown escape") { };
        }
        try {
            new regex("(a)\\1");
            test("back-reference") { fail_test("did not throw"); };
        } catch(e: parse_exception) {
            test("back-reference") { };
        }
        many_a := character.repeat('a', 2000);
        test("nested stars do not blow up") { expect_false(new regex("(a*)*b").contains(many_a)); };
        test("alternation in a star does not blow up") { expect_false(new regex("(a|aa)+" + '$').matches(many_a + "b")); };
        test("a long match") { expect_true(new regex("a+").matches(many_a)); };
        test("find_all on a long text") { expect(sizeof(new regex("a{100}").find_all(many_a))).should_be(20); };
        test("escape") { expect(regex.escape("1+1=2?")).should_be("1\\+1=2\\?"); };
        test("an escaped text matches itself") { expect_true(regex.matches(regex.escape("a.b*(c)[d]"), "a.b*(c)[d]")); };
        test("pattern") { expect(digits.pattern()).should_be("\\d+"); };
    };
    finish_tests();
}
