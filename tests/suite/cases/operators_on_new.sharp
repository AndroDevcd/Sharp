mod main;

import ( testing )

/**
 * KNOWN BUG: this file is EXPECTED TO FAIL - it does not even compile.
 *
 * A `new` expression as the LEFT operand of an overloaded operator stops the
 * compiler with
 *
 *     <code-generator> fatal error: attempting to consume empty machine data!
 *
 * `new` on the right (`a + new money(2)`) and a variable on the left are
 * fine. Workaround: assign the new object to a variable first.
 */

class money {
    amount : decimal = 0;

    money(amount: decimal, unused: decimal) {
        self->amount = amount;
    }

    def operator+(other: money): money {
        return new money(amount + other.amount, 0);
    }

    def operator>(other: money): bool {
        return amount > other.amount;
    }
}

def main(args: string[]) {
    a := new money(1, 0);

    total := new money(5, 0) + a;                   // the compiler stops here
    expect("new on the left of +", total.amount, 6);
    expect_true("new on the left of >", (new money(5, 0) > a));

    finish("lib_math_new_operand");
}
