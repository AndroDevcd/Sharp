mod main;

import ( std.testing )

/**
 * std list<T>: a growable array. Tested with three kinds of element:
 * a user class (planet), string, and the number box int.
 *
 * (list<decimal> - a list of native numbers - is known not to work and is not used here.)
 */

class planet {
    name : string = "";
    moons : decimal = 0;

    planet(planet_name: string, moon_count: decimal) {
        name = planet_name;
        moons = moon_count;
    }
}

def more_moons(a: planet, b: planet): bool {
    return a.moons > b.moons;
}

def same_name(a: planet, b: planet): bool {
    return a.name == b.name;
}

/** adds up a list of int with foreach */
def total_of(numbers: list<int>): decimal {
    total : decimal = 0;
    foreach(n in numbers) {
        total += n.value;
    }
    return total;
}

/** the moons of every planet as digits, e.g. 0, 2, 1 -> 21 -> 021 */
def moon_digits(planets: list<planet>): decimal {
    digits : decimal = 0;
    for(i : decimal = 0; i < planets.size().value; i++) {
        digits = digits * 10 + planets.at(i).moons;
    }
    return digits;
}

def main(args: string[]) {
    show_only_failures();
    tests("std_list") {
        // ---- a new list is empty
        planets := new list<planet>();
        test("new list: size 0") { expect(planets.size().value).should_be(0); };
        test("new list: empty()") { expect_true(planets.empty()); };

        // ---- add, size, at
        mercury := new planet("mercury", 0);
        earth := new planet("earth", 1);
        mars := new planet("mars", 2);
        planets.add(mercury);
        test("size after one add") { expect(planets.size().value).should_be(1); };
        test("not empty after an add") { expect_false(planets.empty()); };
        planets.add(earth);
        planets.add(mars);
        test("size after three adds") { expect(planets.size().value).should_be(3); };
        test("at(0)") { expect(planets.at(0).name).should_be("mercury"); };
        test("at(1)") { expect(planets.at(1).name).should_be("earth"); };
        test("at(2)") { expect(planets.at(2).name).should_be("mars"); };
        test("field of an element") { expect(planets.at(2).moons).should_be(2); };
        test("at() gives the object that was added, not a copy") { expect_true(planets.at(1) == earth); };

        // ---- [] is the same as at
        test("list[0]") { expect(planets[0].name).should_be("mercury"); };
        test("list[2]") { expect(planets[2].name).should_be("mars"); };

        // ---- first and last
        test("first()") { expect(planets.first().name).should_be("mercury"); };
        test("last()") { expect(planets.last().name).should_be("mars"); };

        // ---- changing an element through the list changes the object
        planets.at(1).moons = 5;
        test("element changed through the list") { expect(earth.moons).should_be(5); };
        earth.moons = 1;

        // ---- put replaces an element and gives back the old one
        venus := new planet("venus", 0);
        old := planets.put(1, venus);
        test("put: the new element is there") { expect(planets.at(1).name).should_be("venus"); };
        test("put: returns the element that was replaced") { expect(old.name).should_be("earth"); };
        test("put does not change the size") { expect(planets.size().value).should_be(3); };
        planets.put(1, earth);

        // ---- indexof
        test("indexof the first element") { expect(planets.indexof(mercury).value).should_be(0); };
        test("indexof the last element") { expect(planets.indexof(mars).value).should_be(2); };
        test("indexof something that is not in the list") { expect(planets.indexof(venus).value).should_be(0 - 1); };
        test("indexof with a compare function") { expect(planets.indexof(new planet("earth", 0), same_name).value).should_be(1); };
        test("indexof with a compare function, no match") { expect(planets.indexof(new planet("pluto", 0), same_name).value).should_be(0 - 1); };

        // ---- find
        found := planets.find(new planet("mars", 0), same_name);
        test("find: a match") { expect_not_null(found); };
        test("find: it is the element in the list") { expect(found!!.moons).should_be(2); };
        test("find: no match") { expect_null(planets.find(new planet("pluto", 0), same_name)); };

        // ---- insert
        planets.insert(1, venus);                   // mercury venus earth mars
        test("insert: size") { expect(planets.size().value).should_be(4); };
        test("insert: the new element") { expect(planets.at(1).name).should_be("venus"); };
        test("insert: the element before") { expect(planets.at(0).name).should_be("mercury"); };
        test("insert: the elements after moved up") { expect(planets.at(2).name).should_be("earth"); };
        test("insert: the last element moved up") { expect(planets.at(3).name).should_be("mars"); };
        jupiter := new planet("jupiter", 9);
        planets.insert(4, jupiter);                 // at the end
        test("insert at size() appends") { expect(planets.last().name).should_be("jupiter"); };
        sun := new planet("sun", 8);
        planets.insert(0, sun);                     // sun mercury venus earth mars jupiter
        test("insert at 0") { expect(planets.first().name).should_be("sun"); };
        test("size after three inserts") { expect(planets.size().value).should_be(6); };
        test("order after the inserts (moons as digits)") { expect(moon_digits(planets)).should_be(800129); };

        // ---- remove_at
        planets.remove_at(0);                       // mercury venus earth mars jupiter
        test("remove_at(0): size") { expect(planets.size().value).should_be(5); };
        test("remove_at(0): the next element is first now") { expect(planets.first().name).should_be("mercury"); };
        planets.remove_at(4);                       // mercury venus earth mars
        test("remove_at(last)") { expect(planets.last().name).should_be("mars"); };
        planets.remove_at(1);                       // mercury earth mars
        test("remove_at(middle): size") { expect(planets.size().value).should_be(3); };
        test("remove_at(middle): element 1") { expect(planets.at(1).name).should_be("earth"); };
        test("remove_at(middle): element 2") { expect(planets.at(2).name).should_be("mars"); };

        // ---- remove by value
        planets.remove(earth);                      // mercury mars
        test("remove(element): size") { expect(planets.size().value).should_be(2); };
        test("remove(element): what is left, 0") { expect(planets.at(0).name).should_be("mercury"); };
        test("remove(element): what is left, 1") { expect(planets.at(1).name).should_be("mars"); };
        planets.remove(venus);                      // not in the list: nothing happens
        test("remove of something that is not there") { expect(planets.size().value).should_be(2); };
        planets.remove(new planet("mars", 0), same_name);
        test("remove with a compare function") { expect(planets.size().value).should_be(1); };
        test("...removed the right one") { expect(planets.at(0).name).should_be("mercury"); };

        // ---- pop_last, pop_first, pop_back
        planets.add(earth);
        planets.add(mars);
        planets.add(jupiter);                       // mercury earth mars jupiter
        test("pop_last gives the last element") { expect(planets.pop_last().name).should_be("jupiter"); };
        test("pop_last removes it") { expect(planets.size().value).should_be(3); };
        test("pop_first gives the first element") { expect(planets.pop_first().name).should_be("mercury"); };
        test("pop_first removes it") { expect(planets.size().value).should_be(2); };
        test("first after pop_first") { expect(planets.first().name).should_be("earth"); };
        planets.pop_back();
        test("pop_back removes the last element") { expect(planets.size().value).should_be(1); };
        test("what is left") { expect(planets.first().name).should_be("earth"); };

        // ---- clear
        planets.clear();
        test("clear: size 0") { expect(planets.size().value).should_be(0); };
        test("clear: empty()") { expect_true(planets.empty()); };
        planets.add(mars);
        test("add after clear") { expect(planets.size().value).should_be(1); };
        test("element added after clear") { expect(planets.at(0).name).should_be("mars"); };
        planets.clear();
        planets.clear();                            // clearing an empty list is fine
        test("clear twice") { expect(planets.size().value).should_be(0); };

        // ---- linear_sort: swap(a, b) says whether a must come after b
        planets.add(mars);                          // 2 moons
        planets.add(jupiter);                       // 9
        planets.add(mercury);                       // 0
        planets.add(earth);                         // 1
        planets.linear_sort(more_moons);
        test("sorted by moons") { expect(moon_digits(planets)).should_be(129); };
        test("sorted: first") { expect(planets.first().name).should_be("mercury"); };
        test("sorted: last") { expect(planets.last().name).should_be("jupiter"); };

        // ---- out of range access raises out_of_bounds_exception
        caught : decimal = 0;
        try {
            planets.at(4);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("at(size) throws") { expect(caught).should_be(1); };

        caught = 0;
        try {
            planets.at(0 - 1);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("at(-1) throws") { expect(caught).should_be(1); };

        caught = 0;
        try {
            planets[100];
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("list[100] throws") { expect(caught).should_be(1); };

        caught = 0;
        try {
            planets.put(4, venus);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("put past the end throws") { expect(caught).should_be(1); };

        caught = 0;
        try {
            planets.remove_at(4);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("remove_at past the end throws") { expect(caught).should_be(1); };

        caught = 0;
        try {
            planets.insert(6, venus);
        } catch(e: out_of_bounds_exception) {
            caught = 1;
        }
        test("insert past size() throws") { expect(caught).should_be(1); };
        test("the failed calls changed nothing") { expect(moon_digits(planets)).should_be(129); };

        // ---- an empty list: everything that needs an element throws
        nothing := new list<planet>();
        caught = 0;
        try { nothing.at(0); } catch(e: out_of_bounds_exception) { caught++; }
        try { nothing.first(); } catch(e: out_of_bounds_exception) { caught++; }
        try { nothing.last(); } catch(e: out_of_bounds_exception) { caught++; }
        try { nothing.pop_first(); } catch(e: out_of_bounds_exception) { caught++; }
        try { nothing.pop_last(); } catch(e: out_of_bounds_exception) { caught++; }
        try { nothing.remove_at(0); } catch(e: out_of_bounds_exception) { caught++; }
        test("at, first, last, pop_first, pop_last, remove_at on an empty list all throw") { expect(caught).should_be(6); };
        nothing.pop_back();                         // this one is allowed to do nothing
        test("pop_back on an empty list does nothing") { expect(nothing.size().value).should_be(0); };
        test("indexof on an empty list") { expect(nothing.indexof(mars).value).should_be(0 - 1); };
        test("get_elements of an empty list is null") { expect_null(nothing.get_elements()); };
        trips_through_nothing : decimal = 0;
        foreach(p in nothing) {
            trips_through_nothing++;
        }
        test("foreach over an empty list makes no trips") { expect(trips_through_nothing).should_be(0); };

        // ---- a list of strings
        words := new list<string>();
        words.add("alpha");
        words.add("beta");
        words.add("gamma");
        test("strings: size") { expect(words.size().value).should_be(3); };
        test("strings: at(0)") { expect(words.at(0)).should_be("alpha"); };
        test("strings: last()") { expect(words.last()).should_be("gamma"); };
        test("strings: indexof compares the characters") { expect(words.indexof("beta").value).should_be(1); };
        test("strings: indexof of a missing word") { expect(words.indexof("delta").value).should_be(0 - 1); };
        words.remove("alpha");
        test("strings: remove by value") { expect(words.size().value).should_be(2); };
        test("strings: first after remove") { expect(words.first()).should_be("beta"); };
        words.put(0, "BETA");
        test("strings: put") { expect(words.at(0)).should_be("BETA"); };

        sentence : string = "";
        foreach(word in words) {
            sentence = sentence + word + ".";
        }
        test("strings: foreach visits every element in order") { expect(sentence).should_be("BETA.gamma."); };

        // ---- a list of int (number boxes)
        numbers := new list<int>();
        numbers.add(10);
        numbers.add(20);
        numbers.add(30);
        test("ints: size") { expect(numbers.size().value).should_be(3); };
        test("ints: at(1)") { expect(numbers.at(1).value).should_be(20); };
        test("ints: first") { expect(numbers.first().value).should_be(10); };
        test("ints: last") { expect(numbers.last().value).should_be(30); };
        test("ints: indexof compares the numbers") { expect(numbers.indexof(30).value).should_be(2); };
        test("ints: indexof of a missing number") { expect(numbers.indexof(99).value).should_be(0 - 1); };
        test("ints: foreach total") { expect(total_of(numbers)).should_be(60); };
        numbers.put(0, 11);
        test("ints: put") { expect(numbers.at(0).value).should_be(11); };
        numbers.remove(20);
        test("ints: remove by value") { expect(numbers.size().value).should_be(2); };
        test("ints: total after put and remove") { expect(total_of(numbers)).should_be(41); };

        // ---- foreach counts exactly size() elements, also after removals
        trips : decimal = 0;
        foreach(n in numbers) {
            trips++;
        }
        test("foreach makes size() trips") { expect(trips).should_be(2); };

        // ---- growing: far more elements than the first capacity (10)
        big := new list<int>();
        for(i : decimal = 0; i < 1000; i++) {
            big.add(i * 2);
        }
        test("1000 adds: size") { expect(big.size().value).should_be(1000); };
        test("1000 adds: first") { expect(big.at(0).value).should_be(0); };
        test("1000 adds: element 10 (first one past the first capacity)") { expect(big.at(10).value).should_be(20); };
        test("1000 adds: element 500") { expect(big.at(500).value).should_be(1000); };
        test("1000 adds: last") { expect(big.last().value).should_be(1998); };
        test("1000 adds: total") { expect(total_of(big)).should_be(999000); };
        for(i : decimal = 0; i < 990; i++) {
            big.pop_back();
        }
        test("990 pop_back: size") { expect(big.size().value).should_be(10); };
        test("990 pop_back: last") { expect(big.last().value).should_be(18); };
        test("990 pop_back: total") { expect(total_of(big)).should_be(90); };

        // ---- a list with a starting capacity
        capacity : int = 500;
        roomy := new list<int>(capacity);
        test("starting capacity is not size") { expect(roomy.size().value).should_be(0); };
        roomy.add(1);
        test("add to a list with starting capacity") { expect(roomy.at(0).value).should_be(1); };

        // ---- add_all copies another list; append_all adds one list to the end of another
        copy_of_big := new list<int>();
        copy_of_big.add_all(big);
        test("add_all into an empty list: size") { expect(copy_of_big.size().value).should_be(10); };
        test("add_all: total") { expect(total_of(copy_of_big)).should_be(90); };
        copy_of_big.put(0, 100);
        test("add_all made a copy: the original is unchanged") { expect(big.at(0).value).should_be(0); };

        tail := new list<int>();
        tail.add(1);
        tail.add(2);
        tail.append_all(big);
        test("append_all: size") { expect(tail.size().value).should_be(12); };
        test("append_all: the old elements stay") { expect(tail.at(1).value).should_be(2); };
        test("append_all: the new ones follow") { expect(tail.at(2).value).should_be(0); };
        test("append_all: total") { expect(total_of(tail)).should_be(93); };

        // ---- two lists are independent
        one := new list<string>();
        two := new list<string>();
        one.add("only in one");
        test("adding to one list leaves another alone") { expect(two.size().value).should_be(0); };
    };
    finish_tests("std_list");
}
