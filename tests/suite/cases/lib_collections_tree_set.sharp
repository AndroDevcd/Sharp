mod main;

import ( std.testing, std.collections )

/**
 * std.collections - tree_set, and tree_map checked against a simple reference
 * through 2000 pseudo random inserts and removes.
 */

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def descending(a: int, b: int) : decimal { return b.value - a.value; }

/** "1,2,3" for a list of ints */
def join(items: list<int>) : string {
    text := "";
    for(i : decimal = 0; i < items.size().value; i++) {
        if(i > 0) text = text + ",";
        text = text + items.at(i);
    }
    return text;
}

/** "1,2,3" for the keys an entry iterator still has to give */
def drain_keys(it: iterator<map_entry<int, string> >) : string {
    text := "";
    first : decimal = 1;
    while(it.has_next()) {
        if(!first) text = text + ",";
        first = 0;
        text = text + it.next().key;
    }
    return text;
}

/** the value of a nullable int, or -1 for null */
def or_minus_one(value: int?) : decimal {
    if(value == null) return 0 - 1;
    return value!!.value;
}

/** 2000 pseudo random inserts and removes, checked against a plain array of flags */
def test_tree_map_against_reference() {
    present := new decimal[500];        // the reference: present[k] = 1 when key k is in the map
    stored := new decimal[500];         // ... and the value stored for it
    count : decimal = 0;

    m := new tree_map<int, int>(ascending);
    seed : decimal = 2024;
    agree : decimal = 1;
    for(step : decimal = 0; step < 2000; step++) {
        seed = (seed * 7919 + 104729) % 1000003;
        key : decimal = seed % 500;
        seed = (seed * 7919 + 104729) % 1000003;

        if(seed % 3 == 0) {
            // remove
            was_there : decimal = present[key];
            if(was_there) { present[key] = 0; count--; }
            if(m.remove(key) != was_there) agree = 0;
        } else {
            // insert or replace
            was_new : decimal = !present[key];
            if(was_new) { present[key] = 1; count++; }
            stored[key] = step;
            if(m.put(key, step) != was_new) agree = 0;
        }
        if(m.size() != count) agree = 0;
    }
    test("tree random put/remove results agree with the reference") { expect(agree).should_be(1); };
    test("tree random size") { expect(m.size()).should_be(count); };
    test("tree random height is logarithmic") { expect_true(m.height() <= 12); };

    // every key: contains, value
    for(key : decimal = 0; key < 500; key++) {
        if(m.contains_key(key) != present[key]) agree = 0;
        if(present[key]) {
            if(m.at(key)!!.value != stored[key]) agree = 0;
        }
    }
    test("tree random contents agree with the reference") { expect(agree).should_be(1); };

    // the iteration is exactly the present keys in ascending order
    expected_key : decimal = 0;
    walked : decimal = 0;
    foreach(entry in m) {
        while(expected_key < 500 && !present[expected_key]) expected_key++;
        if(entry.key.value != expected_key) agree = 0;
        expected_key++;
        walked++;
    }
    test("tree random iteration is sorted and complete") { expect(agree).should_be(1); };
    test("tree random iteration count") { expect(walked).should_be(count); };

    // floor / ceiling / lower / higher for every possible key, against a linear scan
    for(key : decimal = 0; key < 500; key++) {
        floor : decimal = 0 - 1;
        for(k : decimal = key; k >= 0; k--) { if(present[k]) { floor = k; break; } }
        ceiling : decimal = 0 - 1;
        for(k : decimal = key; k < 500; k++) { if(present[k]) { ceiling = k; break; } }
        lower : decimal = 0 - 1;
        for(k : decimal = key - 1; k >= 0; k--) { if(present[k]) { lower = k; break; } }
        higher : decimal = 0 - 1;
        for(k : decimal = key + 1; k < 500; k++) { if(present[k]) { higher = k; break; } }

        if(or_minus_one(m.floor_key(key)) != floor) agree = 0;
        if(or_minus_one(m.ceiling_key(key)) != ceiling) agree = 0;
        if(or_minus_one(m.lower_key(key)) != lower) agree = 0;
        if(or_minus_one(m.higher_key(key)) != higher) agree = 0;
    }
    test("tree random neighbours agree with a linear scan") { expect(agree).should_be(1); };

    // a range, counted both ways
    in_range : decimal = 0;
    for(k : decimal = 100; k < 300; k++) in_range += present[k];
    test("tree random range_keys") { expect(m.range_keys(100, 300).size().value).should_be(in_range); };
    it := m.range_iterator(100, 300);
    walked = 0;
    while(it.has_next()) { it.next(); walked++; }
    test("tree random range_iterator") { expect(walked).should_be(in_range); };

    // empty it from the front: keys must come out ascending
    previous : decimal = 0 - 1;
    while(!m.is_empty()) {
        key : decimal = m.poll_first().key.value;
        if(key <= previous) agree = 0;
        previous = key;
    }
    test("tree random poll_first order") { expect(agree).should_be(1); };
    test("tree random empty at the end") { expect(m.height()).should_be(0); };
}

def test_tree_set() {
    s := new tree_set<int>(ascending);
    test("tset new size") { expect(s.size()).should_be(0); };
    test("tset new is_empty") { expect(s.is_empty()).should_be(1); };
    test("tset empty get_elements") { expect_null(s.get_elements()); };
    test("tset floor on empty") { expect_null(s.floor(1)); };
    test("tset tail on empty") { expect(s.tail(1).size().value).should_be(0); };
    try { s.first(); test("tset first empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("tset first empty") { }; }
    try { s.last(); test("tset last empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("tset last empty") { }; }
    try { s.poll_first(); test("tset poll_first empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("tset poll_first empty") { }; }
    try { s.poll_last(); test("tset poll_last empty") { fail_test("did not throw"); }; } catch(e: no_such_element_exception) { test("tset poll_last empty") { }; }

    test("tset add") { expect(s.add(5)).should_be(1); };
    test("tset add 2") { expect(s.add(1)).should_be(1); };
    test("tset add 3") { expect(s.add(9)).should_be(1); };
    test("tset add duplicate") { expect(s.add(5)).should_be(0); };
    test("tset add 4") { expect(s.add(3)).should_be(1); };
    test("tset add 5") { expect(s.add(7)).should_be(1); };
    test("tset size") { expect(s.size()).should_be(5); };
    test("tset sorted") { expect(join(s.to_list())).should_be("1,3,5,7,9"); };
    test("tset to_array") { expect(s.to_array()[4].value).should_be(9); };
    test("tset contains") { expect(s.contains(7)).should_be(1); };
    test("tset contains missing") { expect(s.contains(6)).should_be(0); };
    test("tset first") { expect(s.first().value).should_be(1); };
    test("tset last") { expect(s.last().value).should_be(9); };
    test("tset floor") { expect(or_minus_one(s.floor(6))).should_be(5); };
    test("tset floor exact") { expect(or_minus_one(s.floor(7))).should_be(7); };
    test("tset ceiling") { expect(or_minus_one(s.ceiling(6))).should_be(7); };
    test("tset lower") { expect(or_minus_one(s.lower(5))).should_be(3); };
    test("tset lower none") { expect(or_minus_one(s.lower(1))).should_be(0 - 1); };
    test("tset higher") { expect(or_minus_one(s.higher(5))).should_be(7); };
    test("tset higher none") { expect(or_minus_one(s.higher(9))).should_be(0 - 1); };
    test("tset range") { expect(join(s.range(3, 9))).should_be("3,5,7"); };
    test("tset range empty") { expect(join(s.range(4, 5))).should_be(""); };
    test("tset head") { expect(join(s.head(5))).should_be("1,3"); };
    test("tset head of everything") { expect(join(s.head(100))).should_be("1,3,5,7,9"); };
    test("tset tail") { expect(join(s.tail(5))).should_be("5,7,9"); };
    test("tset tail between") { expect(join(s.tail(8))).should_be("9"); };
    test("tset tail of nothing") { expect(join(s.tail(10))).should_be(""); };

    digits : decimal = 0;
    foreach(x in s) { digits = digits * 10 + x.value; }
    test("tset foreach") { expect(digits).should_be(13579); };
    it := s.iterator();
    digits = 0;
    while(it.has_next()) digits = digits * 10 + it.next().value;
    test("tset iterator") { expect(digits).should_be(13579); };
    back := s.descending_iterator();
    digits = 0;
    while(back.has_next()) digits = digits * 10 + back.next().value;
    test("tset descending_iterator") { expect(digits).should_be(97531); };

    test("tset remove") { expect(s.remove(5)).should_be(1); };
    test("tset remove again") { expect(s.remove(5)).should_be(0); };
    test("tset poll_first") { expect(s.poll_first().value).should_be(1); };
    test("tset poll_last") { expect(s.poll_last().value).should_be(9); };
    test("tset after removes") { expect(join(s.to_list())).should_be("3,7"); };

    more := new list<int>();
    more.add(7); more.add(4); more.add(8); more.add(4);
    test("tset add_all counts the new ones") { expect(s.add_all(more)).should_be(2); };
    test("tset after add_all") { expect(join(s.to_list())).should_be("3,4,7,8"); };
    s.clear();
    test("tset clear") { expect(s.size()).should_be(0); };

    // scale: 3000 pseudo random numbers; the set must hold each once, sorted
    seen := new decimal[2000];
    distinct : decimal = 0;
    seed : decimal = 99;
    for(i : decimal = 0; i < 3000; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        value : decimal = seed % 2000;
        if(!seen[value]) { seen[value] = 1; distinct++; }
        s.add(value);
    }
    test("tset big size") { expect(s.size()).should_be(distinct); };
    sorted : decimal = 1;
    previous : decimal = 0 - 1;
    foreach(x in s) {
        if(x.value <= previous) sorted = 0;
        if(!seen[x.value]) sorted = 0;
        previous = x.value;
    }
    test("tset big is sorted and has no strangers") { expect(sorted).should_be(1); };
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_collections_tree_set") {
        test_tree_map_against_reference();
        test_tree_set();
    };
    finish_tests();
}
