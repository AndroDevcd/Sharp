mod main;

import ( std.testing, std.time )

/**
 * std.time.date_time_formatter (and date_time_fields): every pattern letter
 * when formatting, quoted literals, the predefined formatters, parsing with
 * fixed and variable width fields, names, AM/PM, offsets, redundant fields
 * that must agree, invalid patterns and text that does not match.
 */

def fmt(pattern: string, value: date_time): string {
    return date_time_formatter.of_pattern(pattern).format(value);
}

def fmt_offset(pattern: string, value: offset_date_time): string {
    return date_time_formatter.of_pattern(pattern).format(value);
}

/** 1 when the pattern itself is rejected */
def bad_pattern(pattern: string): decimal {
    try {
        date_time_formatter.of_pattern(pattern);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

/** 1 when parsing `text` as a date-time with `pattern` throws */
def rejects(pattern: string, text: string): decimal {
    f := date_time_formatter.of_pattern(pattern);
    try {
        f.parse_date_time(text);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def rejects_time(pattern: string, text: string): decimal {
    f := date_time_formatter.of_pattern(pattern);
    try {
        f.parse_time(text);
        return 0;
    } catch(e: date_time_exception) {
        return 1;
    }
}

def parse_date_text(pattern: string, text: string): string {
    return date_time_formatter.of_pattern(pattern).parse_date(text).to_string()!!;
}

def parse_time_text(pattern: string, text: string): string {
    return date_time_formatter.of_pattern(pattern).parse_time(text).to_string()!!;
}

def parse_dt_text(pattern: string, text: string): string {
    return date_time_formatter.of_pattern(pattern).parse_date_time(text).to_string()!!;
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_time_formatter") {
        // 2024-02-29 was a Thursday, day 60 of the year, in ISO week 9 and quarter 1
        dt := date_time.of(2024, 2, 29, 13, 5, 9, 250000000);
        morning := date_time.of(2005, 7, 4, 7, 8, 9);

        // ---- date letters
        test("yyyy-MM-dd") { expect(fmt("yyyy-MM-dd", dt)).should_be("2024-02-29"); };
        test("dd/MM/yy") { expect(fmt("dd/MM/yy", dt)).should_be("29/02/24"); };
        test("d.M.y") { expect(fmt("d.M.y", morning)).should_be("4.7.2005"); };
        test("dd.MM.yyyy") { expect(fmt("dd.MM.yyyy", morning)).should_be("04.07.2005"); };
        test("yy of 2005") { expect(fmt("yy", morning)).should_be("05"); };
        test("yyyy of year 5") { expect(fmt("yyyy", date_time.of(5, 1, 1, 0, 0))).should_be("0005"); };
        test("y of year 5") { expect(fmt("y", date_time.of(5, 1, 1, 0, 0))).should_be("5"); };
        test("yyyy of a negative year") { expect(fmt("yyyy", date_time.of(0 - 44, 3, 15, 0, 0))).should_be("-0044"); };
        test("yy of 1999") { expect(fmt("yy", date_time.of(1999, 1, 1, 0, 0))).should_be("99"); };
        test("MMM") { expect(fmt("d MMM yyyy", dt)).should_be("29 Feb 2024"); };
        test("MMMM") { expect(fmt("MMMM d, yyyy", dt)).should_be("February 29, 2024"); };
        test("EEE") { expect(fmt("EEE", dt)).should_be("Thu"); };
        test("E") { expect(fmt("E", dt)).should_be("Thu"); };
        test("EEEE") { expect(fmt("EEEE", dt)).should_be("Thursday"); };
        test("a full English date") { expect(fmt("EEEE, MMMM d, yyyy", dt)).should_be("Thursday, February 29, 2024"); };
        test("e") { expect(fmt("e", dt)).should_be("4"); };
        test("D") { expect(fmt("D", dt)).should_be("60"); };
        test("DDD") { expect(fmt("DDD", dt)).should_be("060"); };
        test("DDD in July") { expect(fmt("DDD", morning)).should_be("185"); };
        test("w") { expect(fmt("w", dt)).should_be("9"); };
        test("ww") { expect(fmt("ww", dt)).should_be("09"); };
        test("YYYY") { expect(fmt("YYYY", dt)).should_be("2024"); };
        test("Q") { expect(fmt("Q", dt)).should_be("1"); };
        test("Q in July") { expect(fmt("Q", morning)).should_be("3"); };
        test("week date of 2021-01-03") { expect(fmt("YYYY-'W'ww-e", date_time.of(2021, 1, 3, 0, 0))).should_be("2020-W53-7"); };
        test("week date of 2024-12-30") { expect(fmt("YYYY-'W'ww-e", date_time.of(2024, 12, 30, 0, 0))).should_be("2025-W01-1"); };

        // ---- time letters
        test("HH:mm:ss") { expect(fmt("HH:mm:ss", dt)).should_be("13:05:09"); };
        test("H:m:s") { expect(fmt("H:m:s", morning)).should_be("7:8:9"); };
        test("HH:mm:ss padded") { expect(fmt("HH:mm:ss", morning)).should_be("07:08:09"); };
        test("h:mm a in the afternoon") { expect(fmt("h:mm a", dt)).should_be("1:05 PM"); };
        test("hh:mm a in the morning") { expect(fmt("hh:mm a", morning)).should_be("07:08 AM"); };
        test("midnight is 12 AM") { expect(fmt("h a", date_time.of(2024, 1, 1, 0, 0))).should_be("12 AM"); };
        test("noon is 12 PM") { expect(fmt("h a", date_time.of(2024, 1, 1, 12, 0))).should_be("12 PM"); };
        test("23:59 is 11 PM") { expect(fmt("h:mm a", date_time.of(2024, 1, 1, 23, 59))).should_be("11:59 PM"); };
        test("SSS") { expect(fmt("HH:mm:ss.SSS", dt)).should_be("13:05:09.250"); };
        test("S") { expect(fmt("S", dt)).should_be("2"); };
        test("SS") { expect(fmt("SS", dt)).should_be("25"); };
        test("SSSSSS") { expect(fmt("SSSSSS", dt)).should_be("250000"); };
        test("SSSSSSSSS") { expect(fmt("SSSSSSSSS", date_time.of(2024, 1, 1, 0, 0, 0, 123456789))).should_be("123456789"); };
        test("SSS with no fraction") { expect(fmt("SSS", morning)).should_be("000"); };
        test("n") { expect(fmt("n", dt)).should_be("250000000"); };
        test("n of zero") { expect(fmt("n", morning)).should_be("0"); };

        // ---- literals
        test("quoted text") { expect(fmt("yyyy-MM-dd'T'HH:mm:ss", dt)).should_be("2024-02-29T13:05:09"); };
        test("a quoted word") { expect(fmt("'at' HH 'h'", dt)).should_be("at 13 h"); };
        test("two quotes are one quote") { expect(fmt("hh 'o''clock' a", dt)).should_be("01 o'clock PM"); };
        test("two quotes outside quotes") { expect(fmt("yy''MM", dt)).should_be("24'02"); };
        test("punctuation needs no quotes") { expect(fmt("[yyyy/MM/dd] (HH.mm)", dt)).should_be("[2024/02/29] (13.05)"); };
        test("digits are literal") { expect(fmt("yyyy 00 MM", dt)).should_be("2024 00 02"); };
        test("letters inside quotes are not pattern letters") { expect(fmt("'yyyy' yyyy", dt)).should_be("yyyy 2024"); };
        test("a pattern with no letters") { expect(fmt("--", dt)).should_be("--"); };
        test("an empty pattern") { expect(fmt("", dt)).should_be(""); };
        test("basic format") { expect(fmt("yyyyMMdd'T'HHmmss", dt)).should_be("20240229T130509"); };

        // ---- offsets
        plus2 := offset_date_time.of(dt, zone_offset.of_hours(2));
        at_utc := offset_date_time.of(dt, zone_offset.utc);
        india := offset_date_time.of(dt, zone_offset.of_hours_minutes(5, 30));
        west := offset_date_time.of(dt, zone_offset.of_hours(0 - 8));
        test("X") { expect(fmt_offset("X", plus2)).should_be("+02"); };
        test("XX") { expect(fmt_offset("XX", plus2)).should_be("+0200"); };
        test("XXX") { expect(fmt_offset("XXX", plus2)).should_be("+02:00"); };
        test("Z") { expect(fmt_offset("Z", plus2)).should_be("+0200"); };
        test("x") { expect(fmt_offset("x", plus2)).should_be("+02"); };
        test("xxx") { expect(fmt_offset("xxx", plus2)).should_be("+02:00"); };
        test("X at UTC") { expect(fmt_offset("X", at_utc)).should_be("Z"); };
        test("XX at UTC") { expect(fmt_offset("XX", at_utc)).should_be("Z"); };
        test("XXX at UTC") { expect(fmt_offset("XXX", at_utc)).should_be("Z"); };
        test("x at UTC") { expect(fmt_offset("x", at_utc)).should_be("+00"); };
        test("xx at UTC") { expect(fmt_offset("xx", at_utc)).should_be("+0000"); };
        test("xxx at UTC") { expect(fmt_offset("xxx", at_utc)).should_be("+00:00"); };
        test("Z at UTC") { expect(fmt_offset("Z", at_utc)).should_be("+0000"); };
        test("X with minutes") { expect(fmt_offset("X", india)).should_be("+0530"); };
        test("XXX with minutes") { expect(fmt_offset("XXX", india)).should_be("+05:30"); };
        test("XXX west of UTC") { expect(fmt_offset("XXX", west)).should_be("-08:00"); };
        test("X west of UTC") { expect(fmt_offset("X", west)).should_be("-08"); };
        test("a full timestamp") { expect(fmt_offset("yyyy-MM-dd'T'HH:mm:ss.SSSXXX", plus2)).should_be("2024-02-29T13:05:09.250+02:00"); };

        // ---- the other value types
        f := date_time_formatter.of_pattern("EEE d MMM yyyy");
        test("format(date)") { expect(f.format(date.of(2000, 1, 1))).should_be("Sat 1 Jan 2000"); };
        test("format(time_of_day)") { expect(date_time_formatter.of_pattern("h:mm a").format(time_of_day.of(18, 30))).should_be("6:30 PM"); };
        test("format(instant) is UTC") { expect(date_time_formatter.of_pattern("yyyy-MM-dd HH:mm:ss X").format(instant.of_epoch_second(1709211600))).should_be("2024-02-29 13:00:00 Z"); };
        test("pattern()") { expect(f.pattern()).should_be("EEE d MMM yyyy"); };
        test("to_string is the pattern") { expect(f.to_string()!!).should_be("EEE d MMM yyyy"); };
        test("a formatter can be reused") { expect(f.format(date.of(1970, 1, 1))).should_be("Thu 1 Jan 1970"); };

        // ---- predefined formatters
        test("iso_date") { expect(date_time_formatter.iso_date().format(dt)).should_be("2024-02-29"); };
        test("iso_time") { expect(date_time_formatter.iso_time().format(dt)).should_be("13:05:09"); };
        test("iso_date_time") { expect(date_time_formatter.iso_date_time().format(dt)).should_be("2024-02-29T13:05:09"); };
        test("iso_offset_date_time") { expect(date_time_formatter.iso_offset_date_time().format(plus2)).should_be("2024-02-29T13:05:09+02:00"); };
        test("iso_offset_date_time at UTC") { expect(date_time_formatter.iso_offset_date_time().format(at_utc)).should_be("2024-02-29T13:05:09Z"); };
        test("iso_offset_date_time_millis") { expect(date_time_formatter.iso_offset_date_time_millis().format(at_utc)).should_be("2024-02-29T13:05:09.250Z"); };
        test("basic_iso_date") { expect(date_time_formatter.basic_iso_date().format(dt)).should_be("20240229"); };
        test("iso_ordinal_date") { expect(date_time_formatter.iso_ordinal_date().format(dt)).should_be("2024-060"); };
        test("iso_week_date") { expect(date_time_formatter.iso_week_date().format(dt)).should_be("2024-W09-4"); };
        test("rfc_1123") { expect(date_time_formatter.rfc_1123().format(instant.of_epoch_second(1709211600))).should_be("Thu, 29 Feb 2024 13:00:00 GMT"); };
        test("rfc_1123 of the epoch") { expect(date_time_formatter.rfc_1123().format(instant.epoch)).should_be("Thu, 1 Jan 1970 00:00:00 GMT"); };

        // ---- a value that lacks what the pattern asks for
        caught : decimal = 0;
        try { date_time_formatter.of_pattern("yyyy HH").format(date.of(2024, 1, 1)); } catch(e: date_time_exception) { caught = 1; }
        test("a time letter with a date throws") { expect(caught).should_be(1); };
        caught = 0;
        try { date_time_formatter.of_pattern("HH:mm dd").format(time_of_day.noon); } catch(e: date_time_exception) { caught = 1; }
        test("a date letter with a time throws") { expect(caught).should_be(1); };
        caught = 0;
        try { date_time_formatter.of_pattern("HH:mm XXX").format(dt); } catch(e: date_time_exception) { caught = 1; }
        test("an offset letter with a date_time throws") { expect(caught).should_be(1); };

        // ---- invalid patterns
        test("an unknown letter") { expect_true(bad_pattern("yyyy-MM-dd q")); };
        test("an unquoted word") { expect_true(bad_pattern("yyyy at HH")); };
        test("too many d") { expect_true(bad_pattern("ddd")); };
        test("too many M") { expect_true(bad_pattern("MMMMM")); };
        test("too many H") { expect_true(bad_pattern("HHH")); };
        test("too many S") { expect_true(bad_pattern("SSSSSSSSSS")); };
        test("too many a") { expect_true(bad_pattern("aa")); };
        test("a quote that is not closed") { expect_true(bad_pattern("yyyy 'T")); };
        test("a quoted unknown letter is fine") { expect_false(bad_pattern("yyyy 'q'")); };
        try {
            date_time_formatter.of_pattern("yyyy-MM-dd q");
            test("message") { fail_test("no exception"); };
        } catch(e: date_time_exception) {
            test("message") { expect(e.get_message()).should_be("invalid pattern \"yyyy-MM-dd q\": unknown pattern letter 'q' (put literal text in single quotes) at index 11"); };
        }

        // ---- parsing dates
        test("parse yyyy-MM-dd") { expect(parse_date_text("yyyy-MM-dd", "2024-02-29")).should_be("2024-02-29"); };
        test("parse without separators") { expect(parse_date_text("yyyyMMdd", "20240229")).should_be("2024-02-29"); };
        test("parse dd/MM/yyyy") { expect(parse_date_text("dd/MM/yyyy", "09/03/2024")).should_be("2024-03-09"); };
        test("parse one-letter fields, one digit") { expect(parse_date_text("d/M/yyyy", "9/3/2024")).should_be("2024-03-09"); };
        test("parse one-letter fields, two digits") { expect(parse_date_text("d/M/yyyy", "29/12/2024")).should_be("2024-12-29"); };
        test("parse yy as 20yy") { expect(parse_date_text("dd.MM.yy", "29.02.24")).should_be("2024-02-29"); };
        test("parse y with any number of digits") { expect(parse_date_text("y-M-d", "987-6-5")).should_be("0987-06-05"); };
        test("parse a negative year") { expect(parse_date_text("yyyy-MM-dd", "-0044-03-15")).should_be("-0044-03-15"); };
        test("parse MMM") { expect(parse_date_text("d MMM yyyy", "29 Feb 2024")).should_be("2024-02-29"); };
        test("parse MMM in lower case") { expect(parse_date_text("d MMM yyyy", "29 feb 2024")).should_be("2024-02-29"); };
        test("parse MMMM") { expect(parse_date_text("MMMM d, yyyy", "February 29, 2024")).should_be("2024-02-29"); };
        test("parse March and May apart") { expect(parse_date_text("MMMM d, yyyy", "May 1, 2024")).should_be("2024-05-01"); };
        test("parse a date with its weekday") { expect(parse_date_text("EEEE, MMMM d, yyyy", "Thursday, February 29, 2024")).should_be("2024-02-29"); };
        test("parse EEE") { expect(parse_date_text("EEE d MMM yyyy", "Sat 1 Jan 2000")).should_be("2000-01-01"); };
        test("parse an ordinal date") { expect(parse_date_text("yyyy-DDD", "2024-060")).should_be("2024-02-29"); };
        test("parse an ordinal date, last day") { expect(parse_date_text("yyyy-DDD", "2023-365")).should_be("2023-12-31"); };
        test("parse with the predefined iso_date") { expect(date_time_formatter.iso_date().parse_date("2000-01-01").to_string()!!).should_be("2000-01-01"); };
        test("parse with basic_iso_date") { expect(date_time_formatter.basic_iso_date().parse_date("19991231").to_string()!!).should_be("1999-12-31"); };
        test("parse a quarter that agrees") { expect(parse_date_text("yyyy-MM-dd 'Q'Q", "2024-02-29 Q1")).should_be("2024-02-29"); };
        test("parse a week that agrees") { expect(parse_date_text("yyyy-MM-dd 'W'ww", "2024-02-29 W09")).should_be("2024-02-29"); };

        // ---- parsing times
        test("parse HH:mm") { expect(parse_time_text("HH:mm", "13:05")).should_be("13:05:00"); };
        test("parse HH:mm:ss") { expect(parse_time_text("HH:mm:ss", "13:05:09")).should_be("13:05:09"); };
        test("parse H:m:s") { expect(parse_time_text("H:m:s", "7:8:9")).should_be("07:08:09"); };
        test("parse without separators") { expect(parse_time_text("HHmmss", "130509")).should_be("13:05:09"); };
        test("parse SSS") { expect(parse_time_text("HH:mm:ss.SSS", "13:05:09.250")).should_be("13:05:09.250"); };
        test("parse S") { expect(parse_time_text("HH:mm:ss.S", "13:05:09.5")).should_be("13:05:09.500"); };
        test("parse nine fraction digits") { expect(parse_time_text("HH:mm:ss.SSSSSSSSS", "00:00:00.000000001")).should_be("00:00:00.000000001"); };
        test("parse h:mm a, PM") { expect(parse_time_text("h:mm a", "1:05 PM")).should_be("13:05:00"); };
        test("parse h:mm a, AM") { expect(parse_time_text("h:mm a", "7:08 AM")).should_be("07:08:00"); };
        test("parse 12 AM is midnight") { expect(parse_time_text("h:mm a", "12:00 AM")).should_be("00:00:00"); };
        test("parse 12 PM is noon") { expect(parse_time_text("h:mm a", "12:30 PM")).should_be("12:30:00"); };
        test("parse am in lower case") { expect(parse_time_text("hh:mm a", "11:59 pm")).should_be("23:59:00"); };
        test("parse with iso_time") { expect(date_time_formatter.iso_time().parse_time("23:59:59").to_string()!!).should_be("23:59:59"); };

        // ---- parsing date-times, offsets and instants
        test("parse a date-time") { expect(parse_dt_text("yyyy-MM-dd HH:mm:ss", "2024-02-29 13:05:09")).should_be("2024-02-29T13:05:09"); };
        test("parse a quoted T") { expect(parse_dt_text("yyyy-MM-dd'T'HH:mm", "2024-02-29T13:05")).should_be("2024-02-29T13:05:00"); };
        test("a date-only pattern gives midnight") { expect(parse_dt_text("yyyy-MM-dd", "2024-02-29")).should_be("2024-02-29T00:00:00"); };
        test("parse RFC 1123") { expect(date_time_formatter.rfc_1123().parse_date_time("Thu, 29 Feb 2024 13:00:00 GMT").to_string()!!).should_be("2024-02-29T13:00:00"); };
        test("parse an English date and time") { expect(parse_dt_text("EEEE, MMMM d, yyyy 'at' h:mm a", "Thursday, February 29, 2024 at 1:05 PM")).should_be("2024-02-29T13:05:00"); };
        iso := date_time_formatter.iso_offset_date_time();
        test("parse an offset date-time") { expect(iso.parse_offset_date_time("2024-02-29T15:00:00+02:00").to_epoch_second()).should_be(1709211600); };
        test("its offset") { expect(iso.parse_offset_date_time("2024-02-29T15:00:00+02:00").offset().total_seconds()).should_be(7200); };
        test("parse Z") { expect(iso.parse_instant("2024-02-29T13:00:00Z").epoch_second()).should_be(1709211600); };
        test("parse a basic offset with Z") { expect(date_time_formatter.of_pattern("yyyyMMdd HHmm Z").parse_instant("20240229 0800 -0500").epoch_second()).should_be(1709211600); };
        test("parse millis and offset") { expect(date_time_formatter.iso_offset_date_time_millis().parse_instant("1970-01-01T00:00:01.500Z").to_epoch_milli()).should_be(1500); };

        // ---- the raw fields
        fields := date_time_formatter.of_pattern("yyyy-MM-dd").parse("2024-02-29");
        test("has_date") { expect_true(fields.has_date()); };
        test("has_time") { expect_false(fields.has_time()); };
        test("has_offset") { expect(fields.has_offset).should_be(0); };
        test("year field") { expect(fields.year).should_be(2024); };
        test("month field") { expect(fields.month_value).should_be(2); };
        test("day field") { expect(fields.day).should_be(29); };
        time_fields := date_time_formatter.of_pattern("HH:mm").parse("13:05");
        test("a time has no date") { expect_false(time_fields.has_date()); };
        test("a time has_time") { expect_true(time_fields.has_time()); };
        test("hour field") { expect(time_fields.hour).should_be(13); };
        test("minute field") { expect(time_fields.minute).should_be(5); };
        test("no second field") { expect(time_fields.has_second).should_be(0); };

        // ---- round trips: format -> parse gives the value back
        round := date_time_formatter.of_pattern("EEEE d MMMM yyyy, hh:mm:ss.SSSSSSSSS a");
        odd := date_time.of(1969, 7, 20, 20, 17, 40, 123456789);
        test("what it looks like") { expect(round.format(odd)).should_be("Sunday 20 July 1969, 08:17:40.123456789 PM"); };
        test("date_time round trip") { expect_true(round.parse_date_time(round.format(odd)) == odd); };
        test("offset round trip") { expect_true(iso.parse_offset_date_time(iso.format(west)).same_fields(west.plus(duration.of_millis(0 - 250)))); };
        test("ordinal round trip") { expect_true(date_time_formatter.iso_ordinal_date().parse_date(date_time_formatter.iso_ordinal_date().format(date.of(2023, 12, 31))) == date.of(2023, 12, 31)); };

        // ---- text that does not match
        test("a date that does not exist") { expect_true(rejects("yyyy-MM-dd", "2024-02-30")); };
        test("month 13") { expect_true(rejects("yyyy-MM-dd", "2024-13-01")); };
        test("too few digits for a two-letter field") { expect_true(rejects("yyyy-MM-dd", "2024-2-29")); };
        test("a different separator") { expect_true(rejects("yyyy-MM-dd", "2024/02/29")); };
        test("text after the value") { expect_true(rejects("yyyy-MM-dd", "2024-02-29 extra")); };
        test("text that ends early") { expect_true(rejects("yyyy-MM-dd HH:mm", "2024-02-29")); };
        test("the empty string") { expect_true(rejects("yyyy-MM-dd", "")); };
        test("a name that is not a month") { expect_true(rejects("d MMM yyyy", "29 Foo 2024")); };
        test("the wrong weekday for the date") { expect_true(rejects("EEEE, MMMM d, yyyy", "Friday, February 29, 2024")); };
        test("the wrong quarter for the date") { expect_true(rejects("yyyy-MM-dd 'Q'Q", "2024-02-29 Q2")); };
        test("the wrong week for the date") { expect_true(rejects("yyyy-MM-dd 'W'ww", "2024-02-29 W10")); };
        test("a literal in the wrong case") { expect_true(rejects("yyyy-MM-dd'T'HH:mm", "2024-02-29t13:05")); };
        test("no year in the pattern") { expect_true(rejects("MM-dd", "02-29")); };
        test("hour 24") { expect_true(rejects_time("HH:mm", "24:00")); };
        test("minute 60") { expect_true(rejects_time("HH:mm", "13:60")); };
        test("a 12-hour value without AM/PM") { expect_true(rejects_time("h:mm", "1:05")); };
        test("hour 13 on the 12-hour clock") { expect_true(rejects_time("h:mm a", "13:05 PM")); };
        test("hour 0 on the 12-hour clock") { expect_true(rejects_time("h:mm a", "0:05 AM")); };
        test("neither AM nor PM") { expect_true(rejects_time("h:mm a", "1:05 XM")); };
        test("a time pattern without an hour") { expect_true(rejects_time("mm:ss", "05:09")); };
        caught = 0;
        try { iso.parse_offset_date_time("2024-02-29T15:00:00"); } catch(e: date_time_exception) { caught = 1; }
        test("a missing offset throws") { expect(caught).should_be(1); };
        caught = 0;
        try { date_time_formatter.iso_date().parse("2024-02-29").to_offset_date_time(); } catch(e: date_time_exception) { caught = 1; }
        test("to_offset_date_time without an offset field throws") { expect(caught).should_be(1); };
    };
    finish_tests("lib_time_formatter");
}
