mod main;

import ( std.testing )

/**
 * The small classes and functions of std:
 *
 *   pair, triplet, quad, quint     fixed groups of values
 *   result<T, E>                   a value together with a possible error
 *   unique                         interface: hash() and guid()
 *   deferred_init<T>               a value that is made the first time it is asked for
 *   char_array                     a wrapper around the characters of a text
 *   rand, rand_int, rand_double    random numbers - only what ALWAYS holds is
 *                                  checked: the range, and that the same seed
 *                                  gives the same numbers
 *   time                           only the unit conversions, which do not look
 *                                  at the clock
 */

class point {
    x : decimal = 0;
    y : decimal = 0;

    point(px: decimal, py: decimal) {
        x = px;
        y = py;
    }
}

// ---- a class that implements unique
class badge : unique {
    number : decimal = 0;

    badge(n: decimal) { number = n; }

    override def hash() : int { return number * 31; }
    override def guid() : int { return number; }
}

def hash_of(u: unique): decimal {
    return u.hash().value;
}

// ---- for deferred_init: a function that makes the value and counts how often it ran
class settings {
    port : decimal = 0;

    settings(p: decimal) { port = p; }
}

times_made := new int(0);

def make_settings(): settings {
    times_made.value++;
    return new settings(8080);
}

// ---- functions that give back several values at once
def min_and_max(a: decimal, b: decimal, c: decimal): pair<int, int> {
    low : decimal = a;
    high : decimal = a;
    if(b < low) low = b;
    if(c < low) low = c;
    if(b > high) high = b;
    if(c > high) high = c;
    return new pair<int, int>(low, high);
}

/** a division that reports a zero divisor as an error instead of throwing */
def checked_divide(a: decimal, b: decimal): result<double, exception> {
    if(b == 0) {
        return new result<double, exception>(0, new illegal_argument_exception("division by zero"));
    }
    no_error : exception;                       // stays null: no error
    return new result<double, exception>(a / b, no_error);
}

def main(args: string[]) {
    show_only_failures();
    tests("std_misc") {
        // ================= pair
        p := new pair<string, int>("apples", 3);
        test("pair.first") { expect(p.first).should_be("apples"); };
        test("pair.second") { expect(p.second.value).should_be(3); };

        // the fields can be changed
        p.first = "pears";
        p.second = 4;
        test("pair.first after assignment") { expect(p.first).should_be("pears"); };
        test("pair.second after assignment") { expect(p.second.value).should_be(4); };

        // objects as members: the pair holds the objects themselves
        origin := new point(0, 0);
        corner := new point(3, 4);
        line := new pair<point, point>(origin, corner);
        test("pair of objects: field of second") { expect(line.second.y).should_be(4); };
        test("pair holds the object, not a copy") { expect_true(line.first == origin); };
        corner.x = 30;
        test("a change of the object is seen through the pair") { expect(line.second.x).should_be(30); };

        // a pair as a return value
        range := min_and_max(7, 2, 9);
        test("pair returned from a function: first") { expect(range.first.value).should_be(2); };
        test("pair returned from a function: second") { expect(range.second.value).should_be(9); };
        range = min_and_max(5, 5, 5);
        test("all equal: first") { expect(range.first.value).should_be(5); };
        test("all equal: second") { expect(range.second.value).should_be(5); };

        // two pairs are independent
        other := new pair<string, int>("plums", 1);
        test("a second pair has its own values") { expect(other.first).should_be("plums"); };
        test("...and the first one is untouched") { expect(p.first).should_be("pears"); };

        // pairs inside a pair
        nested := new pair<pair<string, int>, string>(other, "outer");
        test("pair in a pair: inner first") { expect(nested.first.first).should_be("plums"); };
        test("pair in a pair: inner second") { expect(nested.first.second.value).should_be(1); };
        test("pair in a pair: outer second") { expect(nested.second).should_be("outer"); };

        // ================= triplet, quad, quint
        t := new triplet<string, int, point>("label", 2, corner);
        test("triplet.first") { expect(t.first).should_be("label"); };
        test("triplet.second") { expect(t.second.value).should_be(2); };
        test("triplet.third") { expect(t.third.y).should_be(4); };

        q := new quad<int, int, int, int>(10, 20, 30, 40);
        test("quad.first") { expect(q.first.value).should_be(10); };
        test("quad.second") { expect(q.second.value).should_be(20); };
        test("quad.third") { expect(q.third.value).should_be(30); };
        test("quad.fourth") { expect(q.fourth.value).should_be(40); };

        five := new quint<string, string, string, string, string>("a", "b", "c", "d", "e");
        test("quint.first") { expect(five.first).should_be("a"); };
        test("quint.third") { expect(five.third).should_be("c"); };
        test("quint.fifth") { expect(five.fifth).should_be("e"); };
        test("quint: all five in order") { expect(five.first + five.second + five.third + five.fourth + five.fifth).should_be("abcde"); };
        five.third = "C";
        test("quint: a field assigned") { expect(five.second + five.third + five.fourth).should_be("bCd"); };

        // ================= result
        good := checked_divide(10, 4);
        test("result without an error: is_success") { expect_true(good.is_success.value); };
        test("result without an error: data") { expect(good.data.value).should_be(2.5); };
        test("result without an error: error is null") { expect_null(good.error); };

        failed := checked_divide(1, 0);
        test("result with an error: is_success") { expect_false(failed.is_success.value); };
        test("result with an error: error") { expect_not_null(failed.error); };
        test("result with an error: its message") { expect(failed.error!!.get_message()).should_be("division by zero"); };
        test("result with an error: the data that was given") { expect(failed.data.value).should_be(0); };

        // a result with other types: text as data, text as error
        parsed := new result<string, string>("parsed", "unexpected end");
        test("result<string, string> with an error") { expect_false(parsed.is_success.value); };
        test("its data") { expect(parsed.data).should_be("parsed"); };
        test("its error") { expect(parsed.error!!).should_be("unexpected end"); };

        // ================= unique
        b := new badge(5);
        test("hash() of a class that implements unique") { expect(b.hash().value).should_be(155); };
        test("guid()") { expect(b.guid().value).should_be(5); };
        u : unique = new badge(2);
        test("called through the interface: hash()") { expect(u.hash().value).should_be(62); };
        test("called through the interface: guid()") { expect(u.guid().value).should_be(2); };
        test("passed to a function that takes a unique") { expect(hash_of(b)).should_be(155); };
        test("two objects, two hashes") { expect(hash_of(new badge(1)) + hash_of(new badge(10))).should_be(341); };

        // ================= deferred_init
        lazy := new deferred_init<settings>(make_settings);
        test("nothing is made when the deferred_init is created") { expect(times_made.value).should_be(0); };
        test("the first read of .value makes the object") { expect(lazy.value.port).should_be(8080); };
        test("the function ran once") { expect(times_made.value).should_be(1); };
        test("the second read gives the same value") { expect(lazy.value.port).should_be(8080); };
        test("...without running the function again") { expect(times_made.value).should_be(1); };
        first_read := lazy.value;
        second_read := lazy.value;
        test("every read gives the same object") { expect_true(first_read == second_read); };
        first_read.port = 9090;
        test("a change made through one read is seen by the next") { expect(lazy.value.port).should_be(9090); };

        another := new deferred_init<settings>(make_settings);
        test("a second deferred_init makes its own object") { expect(another.value.port).should_be(8080); };
        test("the function ran a second time for it") { expect(times_made.value).should_be(2); };

        never_read := new deferred_init<settings>(make_settings);
        test("one that is never read never runs the function") { expect(times_made.value).should_be(2); };

        // ================= char_array
        hello := new char_array("hello");
        test("char_array from a string: number of characters") { expect(sizeof(hello.data)).should_be(5); };
        test("first character") { expect(hello.data[0]).should_be('h'); };
        test("last character") { expect(hello.data[4]).should_be('o'); };
        test("to_string gives the text back") { expect(hello.to_string()).should_be("hello"); };

        // foreach goes through the characters: h + e + l + l + o = 104 + 101 + 108 + 108 + 111
        sum : decimal = 0;
        count : decimal = 0;
        foreach(c in hello) {
            sum += c;
            count++;
        }
        test("foreach over a char_array: trips") { expect(count).should_be(5); };
        test("foreach over a char_array: sum of the character codes") { expect(sum).should_be(532); };

        // from an array of numbers (character codes)
        codes := new decimal[3];
        codes[0] = 'a';
        codes[1] = 'b';
        codes[2] = 'c';
        abc := new char_array(codes);
        test("char_array from a number array: size") { expect(sizeof(abc.data)).should_be(3); };
        test("char_array from a number array: text") { expect(abc.to_string()).should_be("abc"); };
        codes[0] = 'z';
        test("it made its own copy of the numbers") { expect(abc.data[0]).should_be('a'); };

        // from another char_array
        again := new char_array(hello);
        test("char_array from a char_array") { expect(again.to_string()).should_be("hello"); };

        // get_elements is the same array as data
        test("get_elements: size") { expect(sizeof(hello.get_elements())).should_be(5); };
        test("get_elements: a character") { expect(hello.get_elements()[1]).should_be('e'); };

        // ================= time: unit conversions (whole numbers, the rest is cut off)
        test("nano_to_micro(5000000)") { expect(time.nano_to_micro(5000000).value).should_be(5000); };
        test("nano_to_micro(1000)") { expect(time.nano_to_micro(1000).value).should_be(1); };
        test("nano_to_micro(1999) cuts off") { expect(time.nano_to_micro(1999).value).should_be(1); };
        test("nano_to_micro(999)") { expect(time.nano_to_micro(999).value).should_be(0); };
        test("nano_to_micro(0)") { expect(time.nano_to_micro(0).value).should_be(0); };
        test("nano_to_mills(5000000)") { expect(time.nano_to_mills(5000000).value).should_be(5); };
        test("nano_to_mills(1000000)") { expect(time.nano_to_mills(1000000).value).should_be(1); };
        test("nano_to_mills(1999999) cuts off") { expect(time.nano_to_mills(1999999).value).should_be(1); };
        test("nano_to_mills(999999)") { expect(time.nano_to_mills(999999).value).should_be(0); };
        test("nano_to_secs(3000000000)") { expect(time.nano_to_secs(3000000000).value).should_be(3); };
        test("nano_to_secs(1000000000)") { expect(time.nano_to_secs(1000000000).value).should_be(1); };
        test("nano_to_secs(999999999)") { expect(time.nano_to_secs(999999999).value).should_be(0); };
        test("one hour of nanoseconds in seconds") { expect(time.nano_to_secs(3600000000000).value).should_be(3600); };
        test("one day of nanoseconds in milliseconds") { expect(time.nano_to_mills(86400000000000).value).should_be(86400000); };

        // the clock itself: only that it gives a positive number
        test("nano_time() is positive") { expect_true(time.nano_time().value > 0); };
        test("mills_time() is positive") { expect_true(time.mills_time().value > 0); };
        test("micro_time() is positive") { expect_true(time.micro_time().value > 0); };

        // the units are numbered in this order
        test("time_unit.seconds") { expect(time_unit.seconds.ordinal).should_be(0); };
        test("time_unit.milliseconds") { expect(time_unit.milliseconds.ordinal).should_be(1); };
        test("time_unit.microseconds") { expect(time_unit.microseconds.ordinal).should_be(2); };
        test("time_unit.nanoseconds") { expect(time_unit.nanoseconds.ordinal).should_be(3); };

        // ================= random numbers: always inside the range that was asked for
        outside : decimal = 0;
        fractions : decimal = 0;
        for(i : decimal = 0; i < 2000; i++) {
            r : decimal = rand().value;                         // 0 .. 1
            if(r < 0 || r > 1) outside++;

            k : decimal = rand_int(5, 10).value;                // a whole number, 5 .. 10
            if(k < 5 || k > 10) outside++;
            if(k % 1 != 0) fractions++;

            d : decimal = rand_double(2, 3).value;              // 2 .. 3
            if(d < 2 || d > 3) outside++;

            n : decimal = rand_int(0 - 3, 3).value;             // a range around zero
            if(n < 0 - 3 || n > 3) outside++;

            big : decimal = rand_int().value;                   // 0 .. 1e9
            if(big < 0 || big > 1000000000) outside++;

            wide : decimal = rand_double().value;               // 0 .. 1e9
            if(wide < 0 || wide > 1000000000) outside++;
        }
        test("12000 random numbers, none outside its range") { expect(outside).should_be(0); };
        test("rand_int gives whole numbers") { expect(fractions).should_be(0); };

        one_value : decimal = rand_int(7, 7).value;
        test("rand_int(7, 7) can only be 7") { expect(one_value).should_be(7); };

        // the same seed gives the same numbers again
        set_seed(1234);
        a1 : decimal = rand_int(0, 1000000).value;
        a2 : decimal = rand_int(0, 1000000).value;
        a3 : decimal = rand().value;
        set_seed(1234);
        b1 : decimal = rand_int(0, 1000000).value;
        b2 : decimal = rand_int(0, 1000000).value;
        b3 : decimal = rand().value;
        test("same seed: first number repeats") { expect_true(a1 == b1); };
        test("same seed: second number repeats") { expect_true(a2 == b2); };
        test("same seed: third number (a double) repeats") { expect_true(a3 == b3); };
    };
    finish_tests("std_misc");
}
