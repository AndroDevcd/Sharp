mod main;

import ( std.testing, std.io, std.net )

/**
 * std.net: tcp_server and tcp_socket, talking to each other inside one
 * program over this machine's own address ("127.0.0.1") - a server thread
 * that answers, the main thread as its guest.
 *
 * Nothing leaves the machine and no fixed port is used: the server asks for
 * any free port and the client is told which.
 */

class shared {
    static server : tcp_server?;
    static served : decimal = 0;
    static problem : string = "";
}

/**
 * The server: for each guest, lines are answered until the guest says
 * "bye" or closes. "big <n>" is answered with n bytes; "close" ends the server.
 */
def serve(args: object[]) : decimal {
    try {
        while(true) {
            guest := shared.server!!.accept();
            shared.served++;
            stop : bool = false;
            while(true) {
                line := guest.read_line();
                if(line == null || line!! == "bye") { break; }
                said : string = line!!;
                if(said == "close") { stop = true; break; }
                if(said.starts_with("big ")) {
                    count : _int64 = io_strings.parse_int(io_strings.slice_from(said, 4));
                    block := new _int8[count];
                    for(i : _int64 = 0; i < count; i++) { block[i] = 'a' + (i % 26); }
                    guest.write(block);
                } else if(said == "silent") {
                    // (answers nothing: the guest's read has to time out)
                } else {
                    guest.write_text("you said: " + said + "\n");
                }
            }
            guest.close();
            if(stop) { break; }
        }
    } catch(problem: throwable) {
        shared.problem = problem.get_message();
    }
    shared.server!!.close();
    return 0;
}

def main(args: string[]) {
    show_only_failures();
    tests("lib_net_tcp") {
        server := new tcp_server(0, true);
        shared.server = server;
        port : _int64 = server.port();
        test("the server got a port") { expect_true(port > 0 && port < 65536); };
        test("the server is open") { expect_true(server.is_open()); };

        worker := new thread("server", serve);
        worker.start();

        // ---- one conversation
        guest := tcp_socket.connect("127.0.0.1", port);
        test("connected") { expect_true(guest.is_open()); };
        test("host") { expect(guest.host()).should_be("127.0.0.1"); };
        test("port") { expect(guest.port()).should_be(port); };
        test("write_text returns the bytes sent") { expect(guest.write_text("hello\n")).should_be(6); };
        test("the answer, as a line") { expect(guest.read_line()!!).should_be("you said: hello"); };
        guest.write_text("one\r\ntwo\n");
        test("two lines in one write: the first") { expect(guest.read_line()!!).should_be("you said: one"); };
        test("... the second") { expect(guest.read_line()!!).should_be("you said: two"); };

        // ---- more bytes than one read brings
        guest.write_text("big 100000\n");
        block := guest.read_exactly(100000);
        test("read_exactly: the count") { expect(sizeof(block)).should_be(100000); };
        test("... the first byte") { expect(block[0]).should_be('a'); };
        test("... the last byte") { expect(block[99999]).should_be('a' + (99999 % 26)); };
        right : decimal = 1;
        for(i : _int64 = 0; i < 100000; i = i + 997) { if(block[i] != 'a' + (i % 26)) { right = 0; } }
        test("... and those between") { expect_true(right); };

        // ---- a read that takes too long
        guest.set_timeout(200);
        guest.write_text("silent\n");
        timed_out : decimal = 0;
        try { guest.read(10); } catch(late: socket_timeout) { timed_out = 1; }
        test("a read gives up after the timeout") { expect_true(timed_out); };
        guest.set_timeout(0);
        guest.write_text("after\n");
        test("the connection still works after a timeout") { expect(guest.read_line()!!).should_be("you said: after"); };

        // ---- the guest says bye: the server closes, the guest reads "closed"
        guest.write_text("bye\n");
        test("read after the other side closed: nothing") { expect(sizeof(guest.read(10))).should_be(0); };
        test("read_line after the other side closed: null") { expect_null(guest.read_line()); };
        guest.close();
        test("closed") { expect_false(guest.is_open()); };
        guest.close();
        closed_refused : decimal = 0;
        try { guest.write_text("x"); } catch(gone: socket_exception) { closed_refused = 1; }
        test("a closed socket refuses a write") { expect_true(closed_refused); };

        // ---- a second guest: read_all takes everything up to the close
        second := tcp_socket.connect("127.0.0.1", port);
        second.write_text("big 5000\nbye\n");
        everything := second.read_all();
        test("read_all") { expect(sizeof(everything)).should_be(5000); };
        second.close();
        test("the server saw both guests") { expect(shared.served).should_be(2); };

        // ---- what cannot be connected to
        refused : decimal = 0;
        try {
            spare := new tcp_server(0, true);
            free_port : _int64 = spare.port();
            spare.close();
            tcp_socket.connect("127.0.0.1", free_port);
        } catch(nobody: socket_exception) { refused = 1; }
        test("nobody listens there") { expect_true(refused); };
        unknown : decimal = 0;
        try { tcp_socket.connect("no-such-host.invalid", 80); } catch(nobody: socket_exception) { unknown = 1; }
        test("a host nobody knows") { expect_true(unknown); };
        bad_port : decimal = 0;
        try { tcp_socket.connect("127.0.0.1", 70000); } catch(wrong: illegal_argument_exception) { bad_port = 1; }
        test("a port that is not one") { expect_true(bad_port); };
        taken : decimal = 0;
        try { new tcp_server(port, true); } catch(busy: socket_exception) { taken = 1; }
        test("a port that is taken") { expect_true(taken); };

        // ---- the server is told to end
        last := tcp_socket.connect("127.0.0.1", port);
        last.write_text("close\n");
        last.read_all();
        last.close();
        worker.join();
        test("the server thread ended without a problem") { expect(shared.problem).should_be(""); };
        test("the server is closed") { expect_false(server.is_open()); };
    };
    finish_tests("lib_net_tcp");
}
