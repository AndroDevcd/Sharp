mod suite.jit.constants;

import ( std.testing )

/**
 * A constant as one side of a comparison or an operation - `if(i < 10)`, `x & 0xff`, `x >> 2` -
 * and tests of null, each in a loop that runs a few times (the interpreter does it) and many
 * times (machine code does): both must count the same per turn. The compiler writes these as
 * one instruction with the constant inside it, and "not a number" must keep its rules there:
 * every comparison with it is false, except != which is true.
 */

class box {
    value : _int64;
}

/** per turn: 4 of these 8 comparisons with "not a number" hold */
def not_a_number(turns: _int64) : _int64 {
    zero : decimal = 0;
    nan : decimal = zero / zero;
    hits : _int64 = 0;
    for(i : _int64 = 0; i < turns; i++) {
        if(nan < 1) { hits += 100; }
        if(nan > 1) { hits += 100; }
        if(nan <= 1) { hits += 100; }
        if(nan >= 1) { hits += 100; }
        if(nan == 1) { hits += 100; }
        if(nan != 1) { hits += 1; }
        if(!(nan < 1)) { hits += 1; }
        if(!(nan >= 1)) { hits += 1; }
        if(nan != nan) { hits += 1; }
    }
    return hits;
}

/** per 8 turns (i = 0 .. 7 and so on): whole numbers and decimals against small constants */
def against_constants(turns: _int64) : _int64 {
    hits : _int64 = 0;
    for(i : _int64 = 0; i < turns; i++) {
        k : _int64 = i % 8 - 3;             // -3 .. 4
        d : decimal = k;
        if(k < 0) { hits += 1; }            // 3 of 8
        if(k <= 0 - 3) { hits += 10; }      // 1 of 8
        if(k > 3) { hits += 100; }          // 1 of 8
        if(k >= 1) { hits += 1000; }        // 4 of 8
        if(k == 2) { hits += 10000; }       // 1 of 8
        if(k != 2) { hits += 100000; }      // 7 of 8
        if(d < 0) { hits += 1; }            // the same again for the decimal
        if(d <= 0 - 3) { hits += 10; }
        if(d > 3) { hits += 100; }
        if(d >= 1) { hits += 1000; }
        if(d == 2) { hits += 10000; }
        if(d != 2) { hits += 100000; }
        if(2 > k) { hits += 1000000; }      // the constant on the left: 5 of 8
    }
    return hits;
}

/** per 4 turns: bit operations and shifts with constants, and narrowing */
def bits(turns: _int64) : _int64 {
    total : _int64 = 0;
    for(i : _int64 = 0; i < turns; i++) {
        x : _int64 = (i % 4) * 1000 - 1500;         // -1500, -500, 500, 1500
        total += x & 255;                           // 36, 12, 244, 220
        total += x | 16;                            // -1484, -484, 500, 1500
        total += x ^ 5;                             // -1503, -503, 497, 1497
        total += x << 3;                            // -12000, -4000, 4000, 12000
        total += x >> 2;                            // -375, -125, 125, 375
        small : _int8 = x as _int8;                 // 36, 12, -12, -36
        total += small;
    }
    return total;
}

/** per 2 turns: one null, one not */
def nulls(turns: _int64) : _int64 {
    filled := new box();
    filled.value = 5;
    hits : _int64 = 0;
    for(i : _int64 = 0; i < turns; i++) {
        current : box? = null;
        if(i % 2 == 0) { current = filled; }
        if(current == null) { hits += 1; }
        if(current != null) { hits += 10 + current!!.value; }
    }
    return hits;
}

def constants_tests() {
    tests("constants") {
        test("not a number, 10 turns") { expect(not_a_number(10)).should_be(40); };
        test("not a number, 50000 turns") { expect(not_a_number(50000)).should_be(200000); };

        // per 8 turns: (3 + 10 + 100 + 4000 + 10000 + 700000) twice, and 5000000
        test("constants, 8 turns") { expect(against_constants(8)).should_be(6428226); };
        test("constants, 80000 turns") { expect(against_constants(80000)).should_be(64282260000); };

        // per 4 turns: 512 + 32 - 12 + 0 + 0 + 0
        test("bits, 4 turns") { expect(bits(4)).should_be(532); };
        test("bits, 40000 turns") { expect(bits(40000)).should_be(5320000); };

        test("nulls, 2 turns") { expect(nulls(2)).should_be(16); };
        test("nulls, 60000 turns") { expect(nulls(60000)).should_be(480000); };

    };
}
