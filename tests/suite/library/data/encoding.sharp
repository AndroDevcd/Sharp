mod suite.library.data.encoding;

import ( std.testing, std.io, std.data )

/**
 * std.data encodings: base64 (standard and URL safe), hex (encode, decode,
 * numbers, hex dump) and url_codec (percent encoding, query strings).
 */

/** a string of the given byte values */
def bytes3(a: decimal, b: decimal, c: decimal): string {
    raw := new _int8[3];
    raw[0] = a; raw[1] = b; raw[2] = c;
    return new string(raw);
}

/** all 256 byte values in order */
def all_bytes(): string {
    buf := new char_buffer(256);
    for(i : decimal = 0; i < 256; i++) {
        buf.append_char(i);
    }
    return buf.build();
}

/** true when both strings hold the same bytes (compared as 0..255) */
def same_bytes(a: string, b: string): decimal {
    if(io_strings.length(a) != io_strings.length(b)) {
        return 0;
    }
    for(i : decimal = 0; i < io_strings.length(a); i++) {
        if((a.data[i] & 0xff) != (b.data[i] & 0xff)) {
            return 0;
        }
    }
    return 1;
}

/** the bytes "hi" */
def hi_bytes(): _int8[] {
    raw := new _int8[2];
    raw[0] = 'h'; raw[1] = 'i';
    return raw;
}

/** the query of four pairs, one with signs that need encoding and one empty */
def sample_keys(): list<string> {
    keys := new list<string>();
    keys.add("q"); keys.add("page"); keys.add("a&b"); keys.add("empty");
    return keys;
}

def sample_values(): list<string> {
    values := new list<string>();
    values.add("sharp lang"); values.add("2"); values.add("x=y"); values.add("");
    return values;
}

def sample_query(): string {
    return url_codec.build_query(sample_keys(), sample_values());
}

def encoding_tests() {
    tests("encoding") {
        tests("base64") {
            // the test vectors of RFC 4648
            test("empty") { expect(base64.encode("")).should_be(""); };
            test("f") { expect(base64.encode("f")).should_be("Zg=="); };
            test("fo") { expect(base64.encode("fo")).should_be("Zm8="); };
            test("foo") { expect(base64.encode("foo")).should_be("Zm9v"); };
            test("foob") { expect(base64.encode("foob")).should_be("Zm9vYg=="); };
            test("fooba") { expect(base64.encode("fooba")).should_be("Zm9vYmE="); };
            test("foobar") { expect(base64.encode("foobar")).should_be("Zm9vYmFy"); };
            test("hello") { expect(base64.encode("hello")).should_be("aGVsbG8="); };
            test("decode empty") { expect(base64.decode("")).should_be(""); };
            test("decode f") { expect(base64.decode("Zg==")).should_be("f"); };
            test("decode fo") { expect(base64.decode("Zm8=")).should_be("fo"); };
            test("decode foo") { expect(base64.decode("Zm9v")).should_be("foo"); };
            test("decode foobar") { expect(base64.decode("Zm9vYmFy")).should_be("foobar"); };
            test("decode without padding") { expect(base64.decode("Zm9vYg")).should_be("foob"); };
            test("decode with line breaks") { expect(base64.decode("Zm9v\r\nYmFy\n")).should_be("foobar"); };
            test("decode with spaces") { expect(base64.decode(" Zm9v YmE= ")).should_be("fooba"); };

            // the two alphabets differ in the last two characters
            test("standard uses + and /") { expect(base64.encode(bytes3(0xfb, 0xff, 0xbf))).should_be("+/+/"); };
            test("url safe uses - and _") { expect(base64.encode_url(bytes3(0xfb, 0xff, 0xbf))).should_be("-_-_"); };
            test("url safe has no padding") { expect(base64.encode_url("f")).should_be("Zg"); };
            test("url safe two bytes") { expect(base64.encode_url("fo")).should_be("Zm8"); };
            test("decode standard alphabet") { expect_true(same_bytes(base64.decode("+/+/"), bytes3(0xfb, 0xff, 0xbf))); };
            test("decode url alphabet") { expect_true(same_bytes(base64.decode("-_-_"), bytes3(0xfb, 0xff, 0xbf))); };

            test("256 bytes give 344 characters") { expect(io_strings.length(base64.encode(all_bytes()))).should_be(344); };
            test("all byte values round trip") { expect_true(same_bytes(base64.decode(base64.encode(all_bytes())), all_bytes())); };
            test("all byte values round trip (url)") { expect_true(same_bytes(base64.decode(base64.encode_url(all_bytes())), all_bytes())); };
            test("zero bytes") { expect(base64.encode(bytes3(0, 0, 0))).should_be("AAAA"); };
            test("decoded zero bytes length") { expect(io_strings.length(base64.decode("AAAA"))).should_be(3); };

            test("encode_bytes") { expect(base64.encode_bytes(hi_bytes())).should_be("aGk="); };
            test("encode_url_bytes") { expect(base64.encode_url_bytes(hi_bytes())).should_be("aGk"); };
            test("encode_bytes null") { expect(base64.encode_bytes(null)).should_be(""); };
            test("decode_bytes") {
                decoded := base64.decode_bytes("aGk=");
                expect(sizeof(decoded)).named("decode_bytes size").should_be(2);
                expect(decoded[1]).named("decode_bytes content").should_be('i');
            };
            test("decode_bytes of nothing") { expect_null(base64.decode_bytes("")); };

            test("encode_lines") { expect(base64.encode_lines("foobarfoobar", 8)).should_be("Zm9vYmFy\r\nZm9vYmFy"); };
            test("encode_lines uneven") { expect(base64.encode_lines("foobarf", 8)).should_be("Zm9vYmFy\r\nZg=="); };
            test("encode_lines short text") { expect(base64.encode_lines("foo", 76)).should_be("Zm9v"); };
            test("lines decode again") { expect(base64.decode(base64.encode_lines("foobarfoobar", 4))).should_be("foobarfoobar"); };
            test("line length too small") { expect_throws<illegal_argument_exception>() { base64.encode_lines("x", 3); }; };

            // malformed input
            test("illegal character") { expect_throws<parse_exception>() { base64.decode("Zm9v!"); }; };
            test("one character") { expect_throws<parse_exception>() { base64.decode("Z"); }; };
            test("five characters") { expect_throws<parse_exception>() { base64.decode("Zm9vY"); }; };
            test("data after padding") { expect_throws<parse_exception>() { base64.decode("Zg==Zg=="); }; };
            test("too little padding") { expect_throws<parse_exception>() { base64.decode("Zg="); }; };
            test("too much padding") { expect_throws<parse_exception>() { base64.decode("Zm8=="); }; };
            test("only padding") { expect_throws<parse_exception>() { base64.decode("===="); }; };
            test("stray bits") { expect_throws<parse_exception>() { base64.decode("Zh=="); }; };
            test("is_valid") { expect_true(base64.is_valid("Zm9vYmFy")); };
            test("is_valid bad") { expect_false(base64.is_valid("Zm9v*mFy")); };
        };

        tests("hex") {
            test("encode") { expect(hex.encode("Hi!")).should_be("486921"); };
            test("encode empty") { expect(hex.encode("")).should_be(""); };
            test("encode_upper") { expect(hex.encode_upper(bytes3(0xab, 0xcd, 0xef))).should_be("ABCDEF"); };
            test("encode high bytes") { expect(hex.encode(bytes3(0, 0x80, 0xff))).should_be("0080ff"); };
            test("encode_separated") { expect(hex.encode_separated("Hi!", ':')).should_be("48:69:21"); };
            test("encode_bytes") {
                raw := new _int8[2];
                raw[0] = 1; raw[1] = 0x7f;
                expect(hex.encode_bytes(raw)).should_be("017f");
            };
            test("encode_bytes null") { expect(hex.encode_bytes(null)).should_be(""); };

            test("decode") { expect(hex.decode("486921")).should_be("Hi!"); };
            test("decode upper case") { expect(hex.decode("4A4B")).should_be("JK"); };
            test("decode mixed case") { expect(hex.decode("4a4B")).should_be("JK"); };
            test("decode with spaces") { expect(hex.decode("48 69 21")).should_be("Hi!"); };
            test("decode with colons") { expect(hex.decode("48:69:21")).should_be("Hi!"); };
            test("decode with 0x") { expect(hex.decode("0x4869")).should_be("Hi"); };
            test("decode empty") { expect(hex.decode("")).should_be(""); };
            test("decode high bytes") { expect_true(same_bytes(hex.decode("0080ff"), bytes3(0, 0x80, 0xff))); };
            test("decode_bytes of nothing") { expect_null(hex.decode_bytes("")); };
            test("decode_bytes size") { expect(sizeof(hex.decode_bytes("0102"))).should_be(2); };
            test("256 bytes give 512 digits") { expect(io_strings.length(hex.encode(all_bytes()))).should_be(512); };
            test("all byte values round trip") { expect_true(same_bytes(hex.decode(hex.encode(all_bytes())), all_bytes())); };
            test("upper case round trip") { expect_true(same_bytes(hex.decode(hex.encode_upper(all_bytes())), all_bytes())); };

            test("odd digits") { expect_throws<parse_exception>() { hex.decode("486"); }; };
            test("illegal digit") { expect_throws<parse_exception>() { hex.decode("48zz"); }; };
            test("byte cut in two") { expect_throws<parse_exception>() { hex.decode("4 8"); }; };
            test("is_valid") { expect_true(hex.is_valid("00ff")); };
            test("is_valid bad") { expect_false(hex.is_valid("0g")); };

            test("from_number") { expect(hex.from_number(255, 0)).should_be("ff"); };
            test("from_number padded") { expect(hex.from_number(255, 4)).should_be("00ff"); };
            test("from_number zero") { expect(hex.from_number(0, 2)).should_be("00"); };
            test("to_number") { expect(hex.to_number("ff")).should_be(255); };
            test("to_number upper") { expect(hex.to_number("FF")).should_be(255); };
            test("to_number 0x") { expect(hex.to_number("0x10")).should_be(16); };
            test("to_number large") { expect(hex.to_number("ffffffff")).should_be(4294967295); };
            test("to_number 2^52") { expect(hex.to_number("10000000000000")).should_be(4503599627370496); };
            test("to_number empty") { expect_throws<parse_exception>() { hex.to_number(""); }; };
            test("to_number bad digit") { expect_throws<parse_exception>() { hex.to_number("12g"); }; };
            test("to_number prefix only") { expect_throws<parse_exception>() { hex.to_number("0x"); }; };

            test("dump empty") { expect(hex.dump("")).should_be(""); };
            test("dump short") { expect(hex.dump("Hi!")).should_be("00000000  48 69 21                                          |Hi!|\n"); };
            test("dump two lines") { expect(hex.dump("Hello, world! 123")).should_be("00000000  48 65 6c 6c 6f 2c 20 77  6f 72 6c 64 21 20 31 32  |Hello, world! 12|\n"
                + "00000010  33                                                |3|\n"); };
            test("dump unprintable") { expect(hex.dump(bytes3(0, 'A', 0xff))).should_be("00000000  00 41 ff                                          |.A.|\n"); };
            test("dump of 256 bytes has 16 lines") { expect(io_strings.split_lines(hex.dump(all_bytes())).size()).should_be(16); };
            test("dump_bytes null") { expect(hex.dump_bytes(null)).should_be(""); };
        };

        tests("url") {
            test("encode") { expect(url_codec.encode("a b&c=d/e")).should_be("a%20b%26c%3Dd%2Fe"); };
            test("encode unreserved untouched") { expect(url_codec.encode("AZaz09-._~")).should_be("AZaz09-._~"); };
            test("encode empty") { expect(url_codec.encode("")).should_be(""); };
            test("encode reserved") { expect(url_codec.encode("?#[]@!+,;")).should_be("%3F%23%5B%5D%40%21%2B%2C%3B"); };
            test("encode percent") { expect(url_codec.encode("100%")).should_be("100%25"); };
            test("encode high bytes") { expect(url_codec.encode(bytes3(0xc3, 0xa9, 0x00))).should_be("%C3%A9%00"); };
            test("encode_path") { expect(url_codec.encode_path("/my files/a&b.txt")).should_be("/my%20files/a%26b.txt"); };
            test("encode_form") { expect(url_codec.encode_form("a b+c")).should_be("a+b%2Bc"); };

            test("decode") { expect(url_codec.decode("a%20b%26c")).should_be("a b&c"); };
            test("decode lower case digits") { expect(url_codec.decode("%3f%2f")).should_be("?/"); };
            test("decode keeps plus") { expect(url_codec.decode("a+b")).should_be("a+b"); };
            test("decode_form") { expect(url_codec.decode_form("a+b%2Bc")).should_be("a b+c"); };
            test("decode plain") { expect(url_codec.decode("plain-text_1.0~")).should_be("plain-text_1.0~"); };
            test("decode at the end") { expect(url_codec.decode("x%21")).should_be("x!"); };
            test("decode empty") { expect(url_codec.decode("")).should_be(""); };
            test("decode high bytes") { expect_true(same_bytes(url_codec.decode("%C3%A9%00"), bytes3(0xc3, 0xa9, 0x00))); };
            test("all byte values round trip") { expect_true(same_bytes(url_codec.decode(url_codec.encode(all_bytes())), all_bytes())); };
            test("all byte values round trip (form)") { expect_true(same_bytes(url_codec.decode_form(url_codec.encode_form(all_bytes())), all_bytes())); };

            test("percent at the end") { expect_throws<parse_exception>() { url_codec.decode("100%"); }; };
            test("one digit") { expect_throws<parse_exception>() { url_codec.decode("%4"); }; };
            test("no hex digits") { expect_throws<parse_exception>() { url_codec.decode("%zz"); }; };
            test("form: cut off") { expect_throws<parse_exception>() { url_codec.decode_form("a%2"); }; };

            // query strings
            test("build_query") { expect(sample_query()).should_be("q=sharp+lang&page=2&a%26b=x%3Dy&empty="); };
            test("build_query of nothing") { expect(url_codec.build_query(new list<string>(), new list<string>())).should_be(""); };
            test("parse_query gives back the keys and values") {
                back_keys := new list<string>();
                back_values := new list<string>();
                expect(url_codec.parse_query(sample_query(), back_keys, back_values)).named("parse_query count").should_be(4);
                expect(io_strings.join(back_keys, "|")).named("parsed keys").should_be("q|page|a&b|empty");
                expect(io_strings.join(back_values, "|")).named("parsed values").should_be("sharp lang|2|x=y|");
            };
            test("uneven lists") {
                values := sample_values();
                values.pop_back();
                expect_throws<illegal_argument_exception>() { url_codec.build_query(sample_keys(), values); };
            };

            tests("parse_query") {
                k : list<string>;
                v : list<string>;
                before_each {
                    k = new list<string>();
                    v = new list<string>();
                };

                test("parse a whole url") {
                    expect(url_codec.parse_query("http://host/path?a=1&b=two%20words#frag", k, v)).should_be(2);
                    expect(io_strings.join(k, "|")).named("url keys").should_be("a|b");
                    expect(io_strings.join(v, "|")).named("url values").should_be("1|two words");
                };
                test("leading question mark") { expect(url_codec.parse_query("?x=1", k, v)).should_be(1); };
                test("empty pieces skipped") { expect(url_codec.parse_query("a=1&&b=2&", k, v)).should_be(2); };
                test("key without value, repeated key, semicolon") {
                    expect(url_codec.parse_query("flag&k=1;k=2&e=", k, v)).should_be(4);
                    expect(io_strings.join(k, "|")).named("those keys").should_be("flag|k|k|e");
                    expect(io_strings.join(v, "|")).named("those values").should_be("|1|2|");
                };
                test("value with equals sign keeps the rest") {
                    expect(url_codec.parse_query("expr=a=b", k, v)).should_be(1);
                    expect(v.at(0)).named("...keeps the rest").should_be("a=b");
                };
                test("empty query") { expect(url_codec.parse_query("", k, v)).should_be(0); };
                test("bad escape in query") { expect_throws<parse_exception>() { url_codec.parse_query("a=%G1", k, v); }; };
            };

            test("a `?` inside a value is part of the value") {
                expect(url_codec.query_value("a=1&next=/x?y=2", "a")!! + "|" + url_codec.query_value("a=1&next=/x?y=2", "next")!!).should_be("1|/x?y=2");
            };
            test("a whole address: what stands behind its `?`") { expect(url_codec.query_value("http://h.example/p?a=1&b=2", "a")!!).should_be("1"); };
            test("query_value") { expect(url_codec.query_value(sample_query(), "q")!!).should_be("sharp lang"); };
            test("query_value of encoded key") { expect(url_codec.query_value(sample_query(), "a&b")!!).should_be("x=y"); };
            test("query_value empty") { expect(url_codec.query_value(sample_query(), "empty")!!).should_be(""); };
            test("query_value missing is null") { expect_true(io_strings.is_null(url_codec.query_value(sample_query(), "nope"))); };
            test("query_value takes the first") { expect(url_codec.query_value("k=1&k=2", "k")!!).should_be("1"); };
        };
    };
}
