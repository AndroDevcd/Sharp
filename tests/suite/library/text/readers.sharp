mod suite.library.text.readers;

import ( std.testing, std.text, std.io )

/**
 * std.text - characters and reading text piece by piece:
 *   - character         is_digit, is_letter, to_upper, digit_value, for_digit ...
 *   - ascii, char_sets  names of control characters, ready-made character sets
 *   - char_buffer       the append-only buffer the package builds strings with
 *   - string_joiner     separator / prefix / suffix
 *   - string_tokenizer  tokens between delimiter characters
 *   - string_reader     a cursor: peek, next, match, read_while_in, read_until ...
 *   - scanner           next word / int / double / line
 */

def show(parts: string[]): string {
    joined := string.join("|", parts);
    if(joined.is_empty()) return string.of_int(sizeof(parts)) + ":";
    return string.of_int(sizeof(parts)) + ":" + joined;
}

def is_not_semicolon(c: char): bool {
    return c.value != ';';
}

/** appends 10000 letters, a..z over and over */
def grow(buffer: char_buffer) {
    for(i : decimal = 0; i < 10000; i++) {
        buffer.append_char('a' + i % 26);
    }
}

/** a "-" joiner with the pieces x, "", y, p and q */
def dashed_joiner(): string_joiner {
    plain := new string_joiner("-");
    plain.add("x");
    plain.add("").add("y");
    plain.add_all({ "p", "q" });
    return plain;
}

/** reads "width = " of "width = 42;\nnext" */
def to_the_number(reader: string_reader) {
    reader.read_identifier();
    reader.skip_whitespace();
    reader.match("=");
    reader.skip_whitespace();
}

/** reads "width = 42;" of "width = 42;\nnext" */
def to_the_line_end(reader: string_reader) {
    to_the_number(reader);
    reader.read_digits();
    reader.match_char(';');
}

/** reads the four words of the first line of "width 42 3.5 true\nsecond line\n" */
def read_the_words(input: scanner) {
    input.next();
    input.next_int();
    input.next_double();
    input.next_bool();
}

/** reads both lines of "width 42 3.5 true\nsecond line\n" */
def read_all_lines(input: scanner) {
    read_the_words(input);
    input.next_line();
    input.next_line();
}

/** adds up the whole numbers at the front of the scanner */
def sum_ints(numbers: scanner): decimal {
    total : decimal = 0;
    while(numbers.has_next_int()) {
        total = total + numbers.next_int();
    }
    return total;
}

def readers_tests() {
    tests("readers") {
        // ---- character
        test("is_digit") { expect_true(character.is_digit('7')); };
        test("is_digit of a letter") { expect_false(character.is_digit('a')); };
        test("is_digit just below '0'") { expect_false(character.is_digit('/')); };
        test("is_digit just above '9'") { expect_false(character.is_digit(':')); };
        test("is_letter small") { expect_true(character.is_letter('z')); };
        test("is_letter capital") { expect_true(character.is_letter('A')); };
        test("is_letter of a digit") { expect_false(character.is_letter('1')); };
        test("is_letter between Z and a") { expect_false(character.is_letter('[')); };
        test("is_letter_or_digit") { expect_true(character.is_letter_or_digit('0')); };
        test("is_letter_or_digit of '_'") { expect_false(character.is_letter_or_digit('_')); };
        test("is_whitespace space") { expect_true(character.is_whitespace(' ')); };
        test("is_whitespace tab") { expect_true(character.is_whitespace('\t')); };
        test("is_whitespace newline") { expect_true(character.is_whitespace('\n')); };
        test("is_whitespace of a letter") { expect_false(character.is_whitespace('x')); };
        test("is_upper") { expect_true(character.is_upper('Q')); };
        test("is_upper of small") { expect_false(character.is_upper('q')); };
        test("is_lower") { expect_true(character.is_lower('q')); };
        test("is_lower of a digit") { expect_false(character.is_lower('5')); };
        test("to_upper") { expect(character.to_upper('a')).should_be('A'); };
        test("to_upper of a capital") { expect(character.to_upper('A')).should_be('A'); };
        test("to_upper of a digit") { expect(character.to_upper('1')).should_be('1'); };
        test("to_lower") { expect(character.to_lower('Z')).should_be('z'); };
        test("to_lower of punctuation") { expect(character.to_lower('!')).should_be('!'); };
        test("is_hex_digit") { expect_true(character.is_hex_digit('F')); };
        test("is_hex_digit of 'g'") { expect_false(character.is_hex_digit('g')); };
        test("is_octal_digit") { expect_true(character.is_octal_digit('7')); };
        test("is_octal_digit of '8'") { expect_false(character.is_octal_digit('8')); };
        test("is_binary_digit") { expect_true(character.is_binary_digit('1')); };
        test("is_binary_digit of '2'") { expect_false(character.is_binary_digit('2')); };
        test("is_punctuation") { expect_true(character.is_punctuation('!')); };
        test("is_punctuation of '~'") { expect_true(character.is_punctuation('~')); };
        test("is_punctuation of a space") { expect_false(character.is_punctuation(' ')); };
        test("is_punctuation of a letter") { expect_false(character.is_punctuation('a')); };
        test("is_control") { expect_true(character.is_control('\n')); };
        test("is_control of a letter") { expect_false(character.is_control('a')); };
        test("is_printable") { expect_true(character.is_printable(' ')); };
        test("is_printable of a tab") { expect_false(character.is_printable('\t')); };
        test("is_ascii") { expect_true(character.is_ascii('a')); };
        test("is_vowel") { expect_true(character.is_vowel('E')); };
        test("is_vowel of a consonant") { expect_false(character.is_vowel('x')); };
        test("is_identifier_start") { expect_true(character.is_identifier_start('_')); };
        test("is_identifier_start of a digit") { expect_false(character.is_identifier_start('1')); };
        test("is_identifier_part of a digit") { expect_true(character.is_identifier_part('1')); };
        test("digit_value") { expect(character.digit_value('7')).should_be(7); };
        test("digit_value of a letter") { expect(character.digit_value('a')).should_be(0 - 1); };
        test("digit_value in radix 16") { expect(character.digit_value('f', 16)).should_be(15); };
        test("digit_value in radix 16, capital") { expect(character.digit_value('F', 16)).should_be(15); };
        test("digit_value outside of the radix") { expect(character.digit_value('8', 8)).should_be(0 - 1); };
        test("for_digit") { expect(character.for_digit(7, 10)).should_be('7'); };
        test("for_digit in radix 16") { expect(character.for_digit(11, 16)).should_be('b'); };
        test("equals_ignore_case") { expect_true(character.equals_ignore_case('a', 'A')); };
        test("equals_ignore_case of different letters") { expect_false(character.equals_ignore_case('a', 'b')); };
        test("to_string") { expect(character.to_string('x')).should_be("x"); };
        test("repeat") { expect(character.repeat('-', 4)).should_be("----"); };
        test("repeat zero times") { expect(character.repeat('-', 0)).should_be(""); };
        test("a char_at value is accepted") {
            hello : string = "hello";
            expect_true(character.is_letter(hello.char_at(0)));
        };
        test("the value of a char object") {
            hello : string = "hello";
            expect_true(character.is_letter(hello[0].value));
        };
        test("for_digit(10, 10)") { expect_throws<illegal_argument_exception>() { character.for_digit(10, 10); }; };
        test("digit_value with radix 1") { expect_throws<illegal_argument_exception>() { character.digit_value('1', 1); }; };

        // ---- ascii, char_sets
        test("ascii.tab") { expect(ascii.tab).should_be(9); };
        test("ascii.line_feed") { expect(ascii.line_feed).should_be('\n'); };
        test("ascii.dollar") { expect(ascii.dollar).should_be(36); };
        test("name_of a control character") { expect(ascii.name_of(10)).should_be("LF"); };
        test("name_of NUL") { expect(ascii.name_of(0)).should_be("NUL"); };
        test("name_of the space") { expect(ascii.name_of(' ')).should_be("SPACE"); };
        test("name_of a letter") { expect(ascii.name_of('A')).should_be("A"); };
        test("name_of delete") { expect(ascii.name_of(127)).should_be("DEL"); };
        test("caret") { expect(ascii.caret(3)).should_be("^C"); };
        test("caret of a letter") { expect(ascii.caret('x')).should_be("x"); };
        test("is_ascii_text") { expect_true(ascii.is_ascii_text("plain")); };
        test("printable") { expect(ascii.printable("a\tb\n", '.')).should_be("a.b."); };
        test("digits") { expect(char_sets.digits()).should_be("0123456789"); };
        test("letters: how many") { expect(char_sets.letters().length()).should_be(52); };
        test("punctuation: how many") { expect(char_sets.punctuation().length()).should_be(32); };
        test("whitespace: how many") { expect(char_sets.whitespace().length()).should_be(6); };
        test("range") { expect(char_sets.range('a', 'f')).should_be("abcdef"); };
        test("range of one") { expect(char_sets.range('x', 'x')).should_be("x"); };
        test("contains") { expect_true(char_sets.contains(char_sets.hex_digits(), 'F')); };
        test("contains, not there") { expect_false(char_sets.contains(char_sets.digits(), 'a')); };
        test("union") { expect(char_sets.union("abc", "cde")).should_be("abcde"); };
        test("union removes repeats") { expect(char_sets.union("aab", "")).should_be("ab"); };
        test("difference") { expect(char_sets.difference("abcd", "bd")).should_be("ac"); };
        test("intersection") { expect(char_sets.intersection("abcd", "dbx")).should_be("bd"); };
        test("all_in") { expect_true(char_sets.all_in("2024", char_sets.digits())); };
        test("all_in with a stranger") { expect_false(char_sets.all_in("20x4", char_sets.digits())); };
        test("none_in") { expect_true(char_sets.none_in("abc", char_sets.digits())); };
        test("count_in") { expect(char_sets.count_in("a1b22", char_sets.digits())).should_be(3); };
        test("range backwards") { expect_throws<illegal_argument_exception>() { char_sets.range('z', 'a'); }; };

        // ---- char_buffer
        test("a new buffer is empty") { expect(new char_buffer().length()).should_be(0); };
        test("a new buffer builds \"\"") { expect(new char_buffer().build()).should_be(""); };
        test("last of an empty buffer") { expect(new char_buffer().last()).should_be(0 - 1); };
        tests("buffer") {
            buffer : char_buffer;
            before_each {
                buffer = new char_buffer();
                buffer.append("ab").append_char('c').append_repeated('.', 3);
            };

            test("append, append_char, append_repeated") { expect(buffer.build()).should_be("abc..."); };
            test("length") { expect(buffer.length()).should_be(6); };
            test("char_at") { expect(buffer.char_at(2)).should_be('c'); };
            test("last") { expect(buffer.last()).should_be('.'); };
            test("drop_last") {
                buffer.drop_last();
                expect(buffer.build()).should_be("abc..");
            };
            test("growing") {
                buffer.drop_last();
                grow(buffer);
                expect(buffer.length()).should_be(10005);
                expect(buffer.last()).named("the last appended character").should_be('a' + 9999 % 26);
            };
            test("clear") {
                grow(buffer);
                buffer.clear();
                expect_true(buffer.is_empty());
            };
            test("reuse after clear") {
                grow(buffer);
                buffer.clear();
                buffer.append("again");
                expect(buffer.build()).should_be("again");
            };
        };

        // ---- string_joiner
        tests("joiner") {
            joiner : string_joiner;
            before_each { joiner = new string_joiner(", ", "[", "]"); };

            test("an empty joiner") { expect(joiner.build()).should_be("[]"); };
            test("is_empty") { expect_true(joiner.is_empty()); };
            test("three pieces") {
                joiner.add("a").add("b").add("c");
                expect(joiner.build()).should_be("[a, b, c]");
                expect(joiner.count()).named("count").should_be(3);
                expect(joiner.length()).named("length").should_be(9);
            };
            test("add_int") {
                joiner.add("a").add("b").add("c");
                joiner.add_int(4);
                expect(joiner.build()).should_be("[a, b, c, 4]");
            };
        };
        test("one piece has no separator") {
            plain := new string_joiner("-");
            plain.add("x");
            expect(plain.build()).should_be("x");
        };
        test("an empty piece still counts") {
            plain := new string_joiner("-");
            plain.add("x").add("").add("y");
            expect(plain.build()).should_be("x--y");
        };
        test("add_all") { expect(dashed_joiner().build()).should_be("x--y-p-q"); };
        test("merge adds the other pieces as one") {
            outer := new string_joiner(" | ", "<", ">");
            outer.add("first").merge(dashed_joiner());
            expect(outer.build()).should_be("<first | x--y-p-q>");
        };
        tests("empty_value") {
            nothing : string_joiner;
            before_each {
                nothing = new string_joiner(", ", "{", "}");
                nothing.set_empty_value("none");
            };

            test("set_empty_value") { expect(nothing.build()).should_be("none"); };
            test("the empty value is only for an empty joiner") {
                nothing.add("x");
                expect(nothing.build()).should_be("{x}");
            };
            test("clear") {
                nothing.add("x");
                nothing.clear();
                expect(nothing.build()).should_be("none");
            };
        };

        // ---- string_tokenizer
        tests("tokens") {
            tokens : string_tokenizer;
            before_each { tokens = new string_tokenizer("  to be\tor  not "); };

            test("count_tokens") { expect(tokens.count_tokens()).should_be(4); };
            test("has_more_tokens") { expect_true(tokens.has_more_tokens()); };
            test("next_token, and again") {
                expect(tokens.next_token()).named("the first").should_be("to");
                expect(tokens.next_token()).named("the second").should_be("be");
            };
            test("count_tokens after two") {
                tokens.next_token();
                tokens.next_token();
                expect(tokens.count_tokens()).should_be(2);
            };
            test("remaining") {
                tokens.next_token();
                tokens.next_token();
                expect(tokens.remaining()).should_be("\tor  not ");
            };
            test("to_array") {
                tokens.next_token();
                tokens.next_token();
                expect(show(tokens.to_array())).should_be("2:or|not");
            };
            test("has_more_tokens at the end") {
                tokens.to_array();
                expect_false(tokens.has_more_tokens());
            };
            test("next_token_or at the end") {
                tokens.to_array();
                expect(tokens.next_token_or("-")).should_be("-");
            };
            test("next_token at the end") {
                tokens.to_array();
                expect_throws<no_such_element_exception>() { tokens.next_token(); };
            };
            test("reset") {
                tokens.to_array();
                tokens.reset();
                expect(tokens.next_token()).should_be("to");
            };
        };
        test("several delimiters give no empty tokens") { expect(show(new string_tokenizer("a, b;;c", ",; ").to_array())).should_be("3:a|b|c"); };
        test("return_delimiters") { expect(show(new string_tokenizer("12+3*4", "+*", true).to_array())).should_be("5:12|+|3|*|4"); };
        test("count_tokens of \"\"") { expect(new string_tokenizer("").count_tokens()).should_be(0); };
        test("only delimiters: no tokens") { expect_false(new string_tokenizer(",,,", ",").has_more_tokens()); };
        test("first token by whitespace, the next with new delimiters") {
            switching := new string_tokenizer("a b,c d");
            expect(switching.next_token()).named("first token by whitespace").should_be("a");
            expect(switching.next_token(",")).named("next_token with new delimiters").should_be(" b");
        };

        // ---- string_reader
        tests("reader") {
            reader : string_reader;
            before_each { reader = new string_reader("width = 42;\nnext"); };

            test("peek") { expect(reader.peek()).should_be('w'); };
            test("peek(1)") { expect(reader.peek(1)).should_be('i'); };
            test("position at the start") { expect(reader.position()).should_be(0); };
            test("read_identifier, and the position after the name") {
                expect(reader.read_identifier()).should_be("width");
                expect(reader.position()).named("position after the name").should_be(5);
            };
            test("skip_whitespace") {
                reader.read_identifier();
                expect(reader.skip_whitespace()).should_be(1);
            };
            test("match takes only the text that is there") {
                reader.read_identifier();
                reader.skip_whitespace();
                expect_false(reader.match(":="));
                expect_true(reader.match("="));
            };
            test("looking_at, read_digits, and read_digits when there are none") {
                to_the_number(reader);
                expect_true(reader.looking_at("42"));
                expect(reader.read_digits()).named("read_digits").should_be("42");
                expect(reader.read_digits()).named("read_digits when there are none").should_be("");
            };
            test("match_char, then line and column before the line end") {
                to_the_number(reader);
                reader.read_digits();
                expect_true(reader.match_char(';'));
                expect(reader.line()).named("line before the line end").should_be(1);
                expect(reader.column()).named("column before the line end").should_be(12);
            };
            test("next over the line end, then line, column and remaining") {
                to_the_line_end(reader);
                expect(reader.next()).named("next").should_be('\n');
                expect(reader.line()).named("line after the line end").should_be(2);
                expect(reader.column()).named("column after the line end").should_be(1);
                expect(reader.remaining()).named("remaining").should_be(4);
            };
            test("read_rest, and what there is at the end") {
                to_the_line_end(reader);
                reader.next();
                reader.mark();
                expect(reader.read_rest()).named("read_rest").should_be("next");
                expect_true(reader.at_end());
                expect(reader.peek()).named("peek at the end").should_be(0 - 1);
                expect(reader.next()).named("next at the end").should_be(0 - 1);
                expect(reader.read_line()).named("read_line at the end").should_be("");
            };
            test("reset goes back to the mark, back one more") {
                to_the_line_end(reader);
                reader.next();
                reader.mark();
                reader.read_rest();
                reader.reset();
                expect(reader.rest()).named("reset goes back to the mark").should_be("next");
                reader.back();
                expect(reader.peek()).named("back").should_be('\n');
            };
            test("from the start: read_until, read_until_any, read_while_in, skip, read, skip beyond the end") {
                to_the_line_end(reader);
                reader.seek(0);
                expect(reader.read_until(" = ")).named("read_until").should_be("width");
                expect(reader.read_until_any(";\n")).named("read_until_any").should_be(" = 42");
                expect(reader.read_while_in(";")).named("read_while_in").should_be(";");
                expect(reader.skip(1)).named("skip").should_be(1);
                expect(reader.read(2)).named("read").should_be("ne");
                expect(reader.skip(99)).named("skip beyond the end").should_be(2);
            };
        };
        test("read_line reads one line after another, \\r\\n and empty lines too") {
            lines := new string_reader("one\r\ntwo\n\nlast");
            expect(lines.read_line()).named("read_line").should_be("one");
            expect(lines.read_line()).named("read_line after \\r\\n").should_be("two");
            expect(lines.read_line()).named("read_line of an empty line").should_be("");
            expect(lines.read_line()).named("read_line of the last line").should_be("last");
            expect_false(lines.has_next());
        };
        test("read_while with a function, skip_while with a lambda, read_until without the delimiter") {
            fields := new string_reader("abc;def");
            expect(fields.read_while(is_not_semicolon)).named("read_while with a function").should_be("abc");
            expect(fields.skip_while({ c: char -> (bool) return c.value == ';'; })).named("skip_while with a lambda").should_be(1);
            expect(fields.read_until("#")).named("read_until without the delimiter reads to the end").should_be("def");
        };
        tests("strict") {
            strict : string_reader;
            before_each {
                strict = new string_reader("a b");
                strict.expect("a");
            };

            test("the message has line and column") {
                try {
                    strict.expect("x");
                    fail_test("did not throw");
                } catch(e: parse_exception) {
                    expect_true(e.get_message().contains("line 1, column 2"));
                }
            };
            test("seek beyond the end") { expect_throws<out_of_bounds_exception>() { strict.seek(4); }; };
        };
        test("reset without a mark") { expect_throws<illegal_state_exception>() { new string_reader("x").reset(); }; };

        // ---- scanner
        tests("input") {
            input : scanner;
            before_each { input = new scanner("width 42 3.5 true\nsecond line\n"); };

            test("has_next") { expect_true(input.has_next()); };
            test("peek") { expect(input.peek()).should_be("width"); };
            test("has_next_int on a word") { expect_false(input.has_next_int()); };
            test("next, then has_next_int and next_int") {
                expect(input.next()).named("next").should_be("width");
                expect_true(input.has_next_int());
                expect(input.next_int()).named("next_int").should_be(42);
            };
            test("a fraction: has_next_int no, has_next_double yes, next_double") {
                input.next();
                input.next_int();
                expect_false(input.has_next_int());
                expect_true(input.has_next_double());
                expect(input.next_double()).should_be(3.5);
            };
            test("has_next_bool and next_bool") {
                input.next();
                input.next_int();
                input.next_double();
                expect_true(input.has_next_bool());
                expect(input.next_bool()).should_be(1);
            };
            test("next_line gives the rest of the line, then the next line") {
                read_the_words(input);
                expect(input.next_line()).named("the rest of the line").should_be("");
                expect_true(input.has_next_line());
                expect(input.next_line()).named("next_line").should_be("second line");
            };
            test("at the end: has_next_line, has_next, next_or, next_int_or") {
                read_all_lines(input);
                expect_false(input.has_next_line());
                expect_false(input.has_next());
                expect(input.next_or("none")).named("next_or at the end").should_be("none");
                expect(input.next_int_or(0 - 1)).named("next_int_or at the end").should_be(0 - 1);
            };
            test("next at the end") {
                read_all_lines(input);
                expect_throws<no_such_element_exception>() { input.next(); };
            };
        };
        tests("numbers") {
            numbers : scanner;
            before_each { numbers = new scanner("1 2 x 4"); };

            test("summing ints stops at the word") { expect(sum_ints(numbers)).should_be(3); };
            test("next_int on a word throws, and the word is still there") {
                sum_ints(numbers);
                expect_throws<number_format_exception>() { numbers.next_int(); };
                expect(numbers.next()).named("the word is still there").should_be("x");
            };
            test("next_double_or on an int") {
                sum_ints(numbers);
                numbers.next();
                expect(numbers.next_double_or(0.5)).should_be(4);
            };
        };
        test("scanner with separators") { expect(show(new scanner("a,b;c", ",;").to_array())).should_be("3:a|b|c"); };
        tests("cmd") {
            cmd : scanner;
            before_each { cmd = new scanner("set x 1"); };

            test("skip of the expected word, and of another word") {
                expect_true(cmd.skip("set"));
                expect_false(cmd.skip("y"));
            };
            test("remaining and position after the skips") {
                cmd.skip("set");
                cmd.skip("y");
                expect(cmd.remaining()).named("remaining").should_be(" x 1");
                expect(cmd.position()).named("position").should_be(3);
            };
            test("reset") {
                cmd.skip("set");
                cmd.reset();
                expect(cmd.next()).should_be("set");
            };
        };
    };
}
