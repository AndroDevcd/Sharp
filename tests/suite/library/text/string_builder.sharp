mod suite.library.text.string_builder;

import ( std.testing )

/**
 * string_builder and char_array - the rewritten core and the added operations:
 *   - std/string_builder.sharp                   append, size, to_string / build, ==, at,
 *                                                starts_with / ends_with / find, substring
 *   - std/text/builder/string_builder_edit.sharp   insert, delete, replace_range, reverse, clear,
 *                                                set_length, append_line / _int / _number / _repeat
 *   - std/text/builder/string_builder_query.sharp  length, capacity, char_at, index_of, contains, slice
 *   - std/char_array.sharp                       at, put, fill, reverse, sort, slice ...
 *
 * NEEDS the corrected std/string_builder.sharp and std/char_array.sharp (the
 * old builder counted one character too many: "abc" had size 4 and its
 * to_string() ended in a NUL character).
 */

/** "abcdefghi!", appended piece by piece (the last piece is "") */
def ten_characters(): string_builder {
    sb := new string_builder();
    sb.append("abc");
    sb.append("def");
    sb.append('g');
    text : string = "hi";
    sb.append(text).append_char('!');
    empty : string = "";
    sb.append(empty);
    return sb;
}

def string_builder_tests() {
    tests("string_builder") {
        // ---- the core: size and text are exact
        test("a new builder is empty") { expect(new string_builder().size()).should_be(0); };
        test("a new builder builds \"\"") { expect(new string_builder().build()).should_be(""); };
        test("is_empty") { expect_true(new string_builder().is_empty()); };
        tests("two_appends") {
            sb : string_builder;
            before_each {
                sb = new string_builder();
                sb.append("abc");
                sb.append("def");
            };

            test("size after two appends") { expect(sb.size()).should_be(6); };
            test("length") { expect(sb.length()).should_be(6); };
            test("build") { expect(sb.build()).should_be("abcdef"); };
            test("to_string") { expect(sb.to_string()!!).should_be("abcdef"); };
            test("the built string has no extra character") { expect(sb.build().size()).should_be(6); };
            test("is_empty with text") { expect_false(sb.is_empty()); };
            test("is_not_empty") { expect_true(sb.is_not_empty()); };
            test("append of a character") {
                sb.append('g');
                expect(sb.build()).should_be("abcdefg");
            };
            test("append of a string and append_char") {
                sb.append('g');
                text : string = "hi";
                sb.append(text).append_char('!');
                expect(sb.build()).should_be("abcdefghi!");
            };
        };
        tests("ten_characters") {
            sb : string_builder;
            before_each { sb = ten_characters(); };

            test("appending \"\" changes nothing") { expect(sb.length()).should_be(10); };
            test("== with a literal") { expect_true((sb == "abcdefghi!")); };
            test("== with other text") { expect_false((sb == "abcdefghi")); };
            test("!= with other text") { expect_true((sb != "abc")); };
            test("at") { expect(sb.at(0).value).should_be('a'); };
            test("[] ") { expect(sb[9].value).should_be('!'); };
            test("char_at") { expect(sb.char_at(1)).should_be('b'); };
            test("first") { expect(sb.first()).should_be('a'); };
            test("last") { expect(sb.last()).should_be('!'); };
            test("at(length)") { expect_throws<out_of_bounds_exception>() { sb.at(10); }; };
            test("char_at(-1)") { expect_throws<out_of_bounds_exception>() { sb.char_at(0 - 1); }; };
        };

        // ---- growing far beyond the first buffer
        tests("big") {
            big : string_builder;
            before_each {
                big = new string_builder();
                for(i : decimal = 0; i < 5000; i++) {
                    big.append("0123456789");
                }
            };

            test("50000 characters appended") { expect(big.length()).should_be(50000); };
            test("the last one is right") { expect(big.char_at(49999)).should_be('9'); };
            test("one in the middle is right") { expect(big.char_at(25003)).should_be('3'); };
            test("capacity covers the text") { expect_true(big.capacity() >= 50000); };
            test("trim_to_size, and it keeps the text") {
                big.trim_to_size();
                expect(big.capacity()).named("capacity").should_be(50000);
                expect(big.char_at(49999)).named("the last character").should_be('9');
            };
            test("ensure_capacity, and it keeps the length") {
                big.trim_to_size();
                big.ensure_capacity(60000);
                expect_true(big.capacity() >= 60000);
                expect(big.length()).named("length").should_be(50000);
            };
        };

        // ---- searching
        tests("words") {
            words : string_builder;
            before_each { words = new string_builder("one two one"); };

            test("starts_with") { expect_true(words.starts_with("one")); };
            test("starts_with other text") { expect_false(words.starts_with("two")); };
            test("ends_with") { expect_true(words.ends_with("one")); };
            test("ends_with the whole text") { expect_true(words.ends_with("one two one")); };
            test("ends_with other text") { expect_false(words.ends_with("two")); };
            // (find(...) with a literal is ambiguous between find(string) and find(string_builder))
            test("find") {
                two : string = "two";
                expect_true(words.find(two));
            };
            test("find, not there") {
                three : string = "three";
                expect_false(words.find(three));
            };
            test("index_of") { expect(words.index_of("one")).should_be(0); };
            test("index_of with a start") { expect(words.index_of("one", 1)).should_be(8); };
            test("index_of, not found") { expect(words.index_of("x")).should_be(0 - 1); };
            test("last_index_of") { expect(words.last_index_of("one")).should_be(8); };
            test("last_index_of, not found") { expect(words.last_index_of("x")).should_be(0 - 1); };
            test("contains") { expect_true(words.contains(" two ")); };
            test("contains, not there") { expect_false(words.contains("twoo")); };
            test("equals_text") { expect_true(words.equals_text("one two one")); };
            test("equals_text of a prefix") { expect_false(words.equals_text("one two")); };
            test("slice") { expect(words.slice(4, 7)).should_be("two"); };
            test("slice of nothing") { expect(words.slice(3, 3)).should_be(""); };
            test("substring gives a builder") { expect(words.substring(4, 7).build()).should_be("two"); };
            test("slice beyond the end") { expect_throws<out_of_bounds_exception>() { words.slice(4, 99); }; };
        };

        // ---- editing (each test starts from the text the edit before it made)
        test("insert") {
            ed := new string_builder("held");
            ed.insert(3, "lo wor");
            expect(ed.build()).should_be("hello word");
        };
        test("insert at the start") {
            ed := new string_builder("hello word");
            ed.insert(0, ">> ");
            expect(ed.build()).should_be(">> hello word");
        };
        test("insert at the end") {
            ed := new string_builder(">> hello word");
            ed.insert(ed.length(), "!");
            expect(ed.build()).should_be(">> hello word!");
        };
        test("insert_char") {
            ed := new string_builder(">> hello word!");
            ed.insert_char(3, '[');
            expect(ed.build()).should_be(">> [hello word!");
        };
        test("delete") {
            ed := new string_builder(">> [hello word!");
            ed.delete(0, 4);
            expect(ed.build()).should_be("hello word!");
        };
        test("delete of nothing") {
            ed := new string_builder("hello word!");
            ed.delete(5, 5);
            expect(ed.build()).should_be("hello word!");
        };
        test("delete_char_at") {
            ed := new string_builder("hello word!");
            ed.delete_char_at(10);
            expect(ed.build()).should_be("hello word");
        };
        test("replace_range with longer text") {
            ed := new string_builder("hello word");
            ed.replace_range(6, 10, "there");
            expect(ed.build()).should_be("hello there");
        };
        test("replace_range with shorter text") {
            ed := new string_builder("hello there");
            ed.replace_range(0, 5, "hi");
            expect(ed.build()).should_be("hi there");
        };
        test("replace_range with the same length") {
            ed := new string_builder("hi there");
            ed.replace_range(2, 3, "_");
            expect(ed.build()).should_be("hi_there");
        };
        test("set_char_at") {
            ed := new string_builder("hi_there");
            ed.set_char_at(0, 'H');
            expect(ed.build()).should_be("Hi_there");
        };
        test("reverse") {
            ed := new string_builder("Hi_there");
            ed.reverse();
            expect(ed.build()).should_be("ereht_iH");
        };
        test("set_length cuts") {
            ed := new string_builder("ereht_iH");
            ed.set_length(5);
            expect(ed.build()).should_be("ereht");
        };
        test("set_length fills") {
            // (cut first: the characters cut off are still in the buffer, and must not come back)
            ed := new string_builder("ereht_iH");
            ed.set_length(5);
            ed.set_length(8, '.');
            expect(ed.build()).should_be("ereht...");
        };
        test("clear") {
            ed := new string_builder("ereht...");
            ed.clear();
            expect(ed.length()).should_be(0);
        };
        test("clear builds \"\"") {
            ed := new string_builder("ereht...");
            ed.clear();
            expect(ed.build()).should_be("");
        };
        test("a cleared builder can be reused") {
            ed := new string_builder("ereht...");
            ed.clear();
            ed.append("again");
            expect(ed.build()).should_be("again");
        };
        tests("again") {
            ed : string_builder;
            // a cleared builder with room for more than its text: the limit is the text, not the room
            before_each {
                ed = new string_builder("ereht...");
                ed.clear();
                ed.append("again");
            };

            test("insert beyond the end") { expect_throws<out_of_bounds_exception>() { ed.insert(6, "x"); }; };
            test("delete with end before start") { expect_throws<out_of_bounds_exception>() { ed.delete(3, 2); }; };
            test("delete_char_at(length)") { expect_throws<out_of_bounds_exception>() { ed.delete_char_at(5); }; };
        };

        // ---- the extra appends, chained
        test("append_int, append_line, append_number, append_bool") {
            report := new string_builder();
            report.append("n=").append_int(42).append_line().append_number(3.14159, 2).append_line("!").append_bool(1);
            expect(report.build()).should_be("n=42\n3.14!\ntrue");
        };
        test("append_repeat") {
            rule := new string_builder();
            rule.append_repeat("-=", 3).append_repeat("x", 0);
            expect(rule.build()).should_be("-=-=-=");
        };
        tests("listing") {
            listing : string_builder;
            before_each {
                listing = new string_builder();
                listing.append_all({ "a", "b", "c" }, ", ");
            };

            test("append_all") { expect(listing.build()).should_be("a, b, c"); };
            test("a copy is independent, and has the new text") {
                copy_of := new string_builder(listing);
                copy_of.append("!");
                expect(listing.build()).named("the original").should_be("a, b, c");
                expect(copy_of.build()).named("the copy").should_be("a, b, c!");
            };
            test("+ makes a new builder, and leaves the original alone") {
                sum := listing + "?";
                expect(sum.build()).named("the new builder").should_be("a, b, c?");
                expect(listing.build()).named("the original").should_be("a, b, c");
            };
            test("+=") {
                listing += " d";
                expect(listing.build()).should_be("a, b, c d");
            };
        };

        // ---- char_array
        tests("chars") {
            chars : char_array;
            before_each { chars = new char_array("hello"); };

            test("char_array length") { expect(chars.length()).should_be(5); };
            test("char_array at") { expect(chars.at(1)).should_be('e'); };
            test("char_array index_of") { expect(chars.index_of('l')).should_be(2); };
            test("char_array last_index_of") { expect(chars.last_index_of('l')).should_be(3); };
            test("char_array index_of, not found") { expect(chars.index_of('z')).should_be(0 - 1); };
            test("char_array contains") { expect_true(chars.contains('o')); };
            test("char_array count") { expect(chars.count('l')).should_be(2); };
            test("char_array put") {
                own := chars.duplicate();
                own.put(0, 'j');
                expect(own.to_string()).should_be("jello");
            };
            test("duplicate is independent") {
                own := chars.duplicate();
                own.put(0, 'j');
                expect(chars.to_string()).should_be("hello");
            };
            test("char_array content_equals") { expect_true(chars.content_equals(new char_array("hello"))); };
            test("char_array content_equals, different") { expect_false(chars.content_equals(new char_array("ojlle"))); };
            test("char_array to_chars") { expect(sizeof(chars.to_chars())).should_be(5); };
            test("char_array at(length)") { expect_throws<out_of_bounds_exception>() { chars.at(5); }; };
            test("char_array slice beyond the end") { expect_throws<out_of_bounds_exception>() { chars.slice(2, 9); }; };
        };
        // (each starts from the text the change before it made)
        test("char_array reverse") {
            own := new char_array("jello");
            own.reverse();
            expect(own.to_string()).should_be("ollej");
        };
        test("char_array sort") {
            own := new char_array("ollej");
            own.sort();
            expect(own.to_string()).should_be("ejllo");
        };
        test("char_array to_upper") {
            own := new char_array("ejllo");
            own.to_upper();
            expect(own.to_string()).should_be("EJLLO");
        };
        test("char_array to_lower and swap") {
            own := new char_array("EJLLO");
            own.to_lower().swap(0, 4);
            expect(own.to_string()).should_be("ojlle");
        };
        test("char_array slice") { expect(new char_array("ojlle").slice(1, 3).to_string()).should_be("jl"); };
        test("char_array slice of nothing") { expect(new char_array("ojlle").slice(2, 2).length()).should_be(0); };
        test("char_array fill") {
            own := new char_array("ojlle");
            own.fill('z');
            expect(own.to_string()).should_be("zzzzz");
        };
        test("char_array sort of a longer text") {
            unsorted := new char_array("the quick brown fox jumps over the lazy dog");
            unsorted.sort();
            expect(unsorted.to_string()).should_be("        abcdeeefghhijklmnoooopqrrsttuuvwxyz");
        };
        tests("empty_char_array") {
            nothing : char_array;
            before_each { nothing = new char_array(new string()); };

            test("empty char_array length") { expect(nothing.length()).should_be(0); };
            test("empty char_array is_empty") { expect_true(nothing.is_empty()); };
            test("empty char_array survives reverse and sort") {
                nothing.reverse().sort();
                expect(nothing.length()).should_be(0);
            };
        };
    };
}
