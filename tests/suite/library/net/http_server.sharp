mod suite.library.net.http_server;

import ( std.testing, std.io, std.net, std.data )

/**
 * std.net: http_server and web_socket - a server inside this program on
 * this machine's own address (any free port), asked by the HTTP client of
 * the same library, and websockets between the two.
 *
 * The files it serves are in /tmp/sharp_suite_http_server, made for each
 * test and removed after it.
 */

base_dir : string = "/tmp/sharp_suite_http_server";

class user {
    id : _int64 = 0;
    name : string = "";
}

class new_user {
    name : string = "";
    age : _int64 = 0;
}

class store {
    static users : list<user> = new list<user>();
    static before_seen : decimal = 0;
    static socket_said : string = "";
}

def add_user(name: string) : user {
    made := new user();
    made.id = store.users.size() + 1;
    made.name = name;
    store.users.add(made);
    return made;
}

def find_user(id: _int64) : user? {
    for(i : _int64 = 0; i < store.users.size(); i++) {
        if(store.users.at(i).id == id) { return store.users.at(i); }
    }
    return null;
}

/** the store as each test begins: ann and bob, nothing seen yet */
def fresh_store() {
    store.users = new list<user>();
    store.before_seen = 0;
    store.socket_said = "";
    add_user("ann");
    add_user("bob");
}

/** a folder of files to serve (base_dir/files), and a file beside it that must not be served */
def make_files() {
    new file(base_dir).delete_recursively();
    new file(base_dir + "/files").mkdirs();
    new file(base_dir + "/files/hello.txt").write_text("a file");
    new file(base_dir + "/files/index.html").write_text("<h1>index</h1>");
    new file(base_dir + "/outside.txt").write_text("not to be served");
}

/** the server of these tests, with all its routes; not started */
def suite_server() : http_server {
    server := new http_server();
    server.show_errors = false;
    server.workers = 4;
    server.before {
        store.before_seen++;
        if(it.path() == "/secret" && it.header("Authorization") == null) { it.status(401).text("who are you?"); }
    };
    server.after { it.header("X-Server", "suite"); };
    server.GET("/hello") { it.text("hello"); };
    server.GET("/page") { it.html("<p>hi</p>"); };
    server.GET("/users") { it.json(store.users); };
    server.GET("/users/{id}") {
        found := find_user(it.number("id"));
        if(found == null) { throw new http_error(404, "no such user"); }
        it.json(found!!);
    };
    server.POST("/users") {
        wanted := it.body<new_user>();
        if(sizeof(wanted.name.data) == 0) { throw new http_error(422, "a user needs a name"); }
        it.status(201).json(add_user(wanted.name));
    };
    server.DELETE("/users/{id}") { it.status(204); };
    server.PUT("/echo/{first}/{second}") {
        it.text(it.method() + "|" + it.path("first") + "|" + it.path("second") + "|" + it.query_or("q", "-") + "|" + it.body_text() + "|" + it.header("X-Mine")!!);
    };
    server.GET("/secret") { it.text("the secret"); };
    server.GET("/broken") { numbers := new _int64[1]; index : _int64 = 5; numbers[index] = 1; it.text("never"); };
    server.GET("/away") { it.redirect("/hello"); };
    server.GET("/nothing") { };
    server.GET("/bytes") { raw := new _int8[3]; raw[0] = 1; raw[1] = 2; raw[2] = 3; it.bytes(raw, "application/octet-stream"); };
    server.files("/static", base_dir + "/files");
    server.socket("/echo-socket/{room}") {
        store.socket_said = "open";
        while(true) {
            message := it.receive();
            if(message == null) { break; }
            if(message!!.is_text()) { it.send("you said: " + message!!.text()); }
            else { it.send_bytes(message!!.bytes()); }
        }
        store.socket_said = "closed";
    };
    return server;
}

/** a text of `count` characters: a, b, c ... z, a, b ... */
def letters(count: _int64) : string {
    made := new char_buffer();
    for(i : _int64 = 0; i < count; i++) { made.append_char('a' + (i % 26)); }
    return made.build();
}

def http_server_tests() {
    tests("http_server") {
        // each test: a fresh store, the files, and the server started on a free port; stopped after it
        server : http_server?;
        port : _int64 = 0;
        root : string = "";
        before_each {
            fresh_store();
            make_files();
            server = suite_server();
            port = server!!.start(0, true);
            root = "http://127.0.0.1:" + port;
        }
        after_each {
            server!!.stop();
            http.use(new http_client());                // (no kept connection to the server that stopped)
            new file(base_dir).delete_recursively();
        }

        test("the server has a port, says so, and is running") {
            expect_true(port > 0);
            expect(server!!.port()).should_be(port);
            expect_true(server!!.is_running());
        };

        // ---------------------------------------------------------------- routes
        test("text: status, the body and its type; the after hook's header") {
            hello := http.GET(root + "/hello");
            expect(hello.status).named("status").should_be(200);
            expect(hello.text()).named("the body").should_be("hello");
            expect(hello.header("Content-Type")!!).named("its type").should_be("text/plain; charset=utf-8");
            expect(hello.header("X-Server")!!).named("the after hook's header").should_be("suite");
        };
        test("html") { expect(http.GET(root + "/page").header("Content-Type")!!).should_be("text/html; charset=utf-8"); };
        test("a list as json, and its type") {
            everyone := http.GET(root + "/users");
            expect(everyone.text()).should_be("[{\"id\":1,\"name\":\"ann\"},{\"id\":2,\"name\":\"bob\"}]");
            expect(everyone.header("Content-Type")!!).should_be("application/json");
        };
        test("a part in braces") { expect(http.GET(root + "/users/2").json().string_or("name", "")).should_be("bob"); };
        test("http_error: the status and the message") {
            missing := http.GET(root + "/users/9");
            expect(missing.status).should_be(404);
            expect(missing.json().string_or("error", "")).should_be("no such user");
        };
        test("a part that is not a number") { expect(http.GET(root + "/users/abc").status).should_be(400); };
        test("POST: the status the handler set, the body as an object and an object back, and it was stored") {
            made := http.POST(root + "/users") { it.json("name", "cy"); it.json("age", 30); };
            expect(made.status).should_be(201);
            expect(made.text()).should_be("{\"id\":3,\"name\":\"cy\"}");
            expect(store.users.size()).should_be(3);
        };
        test("a body that does not fit: 422 from the handler") { expect(http.POST(root + "/users") { it.json("age", 1); }.status).should_be(422); };
        test("a body that is not json: 400") { expect(http.POST(root + "/users") { it.body("not json"); }.status).should_be(400); };
        test("a body of the wrong kind: 400") { expect(http.POST(root + "/users") { it.body("{\"age\":\"old\"}", "application/json"); }.status).should_be(400); };
        test("204") { expect(http.DELETE(root + "/users/1").status).should_be(204); };
        test("a handler that answers nothing: 204") { expect(http.GET(root + "/nothing").status).should_be(204); };
        test("everything of a request") {
            echoed := http.PUT(root + "/echo/one/two%20words?q=a%26b") { it.header("X-Mine", "mine"); it.body("the body"); };
            expect(echoed.text()).should_be("PUT|one|two words|a&b|the body|mine");
        };
        test("bytes") { expect(sizeof(http.GET(root + "/bytes").bytes())).should_be(3); };
        test("HEAD: no body, and the length the body would have") {
            expect(sizeof(http.HEAD(root + "/hello").bytes())).should_be(0);
            expect(http.HEAD(root + "/hello").header("Content-Length")!!).should_be("5");
        };

        // ---------------------------------------------------------------- what does not fit
        test("no route: 404") { expect(http.GET(root + "/nowhere").status).should_be(404); };
        test("another method: 405") { expect(http.POST(root + "/hello").status).should_be(405); };
        test("a handler that throws: 500, and says nothing of the inside") {
            broken := http.GET(root + "/broken");
            expect(broken.status).should_be(500);
            expect(broken.json().string_or("error", "")).should_be("the server failed to answer");
        };
        test("the server goes on after it") {
            http.GET(root + "/broken");
            expect(http.GET(root + "/hello").text()).should_be("hello");
        };

        // ---------------------------------------------------------------- hooks
        test("before: answers in the handler's place") { expect(http.GET(root + "/secret").status).should_be(401); };
        test("before: lets the request through") { expect(http.GET(root + "/secret") { it.bearer("t"); }.text()).should_be("the secret"); };
        test("before: saw every request") {
            for(i : _int64 = 0; i < 21; i++) { http.GET(root + "/hello"); }
            http.GET(root + "/nowhere");
            http.POST(root + "/hello");
            expect_true(store.before_seen > 20);
        };
        test("redirect") { expect(http.GET(root + "/away").text()).should_be("hello"); };
        test("redirect: the status") { expect(http.GET(root + "/away") { it.follow_redirects(false); }.status).should_be(302); };

        // ---------------------------------------------------------------- files
        test("a file, and its type") {
            file_answer := http.GET(root + "/static/hello.txt");
            expect(file_answer.text()).should_be("a file");
            expect(file_answer.header("Content-Type")!!).should_be("text/plain; charset=utf-8");
        };
        test("a folder gives its index.html") { expect(http.GET(root + "/static").text()).should_be("<h1>index</h1>"); };
        test("a file that is not there") { expect(http.GET(root + "/static/none.txt").status).should_be(404); };
        test("climbing out of the folder") { expect(http.GET(root + "/static/%2E%2E/outside.txt").status).should_be(404); };

        // ---------------------------------------------------------------- many at once, on one connection after another
        test("fifty requests") {
            for(i : _int64 = 0; i < 50; i++) {
                expect(http.GET(root + "/users/2").json().number_or("id", 0)).named("request " + i).should_be(2);
            }
        };

        // ---------------------------------------------------------------- a websocket
        tests("websocket") {
            live : web_socket?;
            before_each { live = web_socket.connect("ws://127.0.0.1:" + port + "/echo-socket/7"); }
            after_each { live!!.close(); }              // (closing twice does nothing)

            test("websocket: open") { expect_true(live!!.is_open()); };
            test("websocket: a text message") {
                live!!.send("hello");
                expect(live!!.receive_text()!!).should_be("you said: hello");
            };
            test("websocket: an empty message") {
                live!!.send("");
                expect(live!!.receive_text()!!).should_be("you said: ");
            };
            test("websocket: a message of 70000 characters, whole") {
                live!!.send(letters(70000));
                back := live!!.receive()!!;
                expect(back.size()).should_be(70000 + 10);
                expect_true(io_strings.ends_with(back.text(), io_strings.slice(letters(70000), 69990, 70000)));
            };
            test("websocket: a message of 300") {
                middle := new char_buffer();
                for(i : _int64 = 0; i < 300; i++) { middle.append_char('m'); }
                live!!.send(middle.build());
                expect(live!!.receive()!!.size()).should_be(310);
            };
            test("websocket: bytes are bytes, the same ones") {
                raw := new _int8[4];
                raw[0] = 0; raw[1] = (255) as _int8; raw[2] = 7; raw[3] = 0;
                live!!.send_bytes(raw);
                bytes_back := live!!.receive()!!;
                expect_false(bytes_back.is_text());
                expect_true(bytes_back.size() == 4 && (bytes_back.bytes()[1] & 0xFF) == 255 && bytes_back.bytes()[2] == 7);
            };
            test("websocket: a ping is answered out of sight") {
                live!!.ping();
                live!!.send("after a ping");
                expect(live!!.receive_text()!!).should_be("you said: after a ping");
            };
            test("websocket: closed, and the server's block saw the close") {
                live!!.send("hello");
                live!!.receive_text();                  // (the server's block is running)
                live!!.close();
                expect_false(live!!.is_open());
                waited : _int64 = 0;
                while(store.socket_said != "closed" && waited < 200) { thread.sleep(10); waited++; }
                expect(store.socket_said).should_be("closed");
            };
        };
        test("websocket: a path that is not one") { expect_throws<web_socket_exception>() { web_socket.connect("ws://127.0.0.1:" + port + "/hello"); }; };
        test("websocket: an address that is not ws://") { expect_throws<illegal_argument_exception>() { web_socket.connect("http://127.0.0.1/"); }; };

        // ---------------------------------------------------------------- stop
        test("stopped, and nobody answers after stop") {
            server!!.stop();
            expect_false(server!!.is_running());
            http.use(new http_client());                // (no kept connection to the server that stopped)
            expect_throws<http_exception>() { http.GET(root + "/hello") { it.timeout(1000); }; };
        };
    };
}
