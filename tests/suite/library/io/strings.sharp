mod suite.library.io.strings;

import ( std.testing, std.io )

/**
 * std.io text helpers: char_buffer (growable character buffer) and
 * io_strings (slicing, searching, trimming, splitting, joining, sorting,
 * numbers to text and back).
 */

/** the characters w x y z */
def wxyz(): _int8[] {
    chars := new _int8[4];
    chars[0] = 'w'; chars[1] = 'x'; chars[2] = 'y'; chars[3] = 'z';
    return chars;
}

/** a buffer made with room for one character, used, emptied, and given "xy" by append_range */
def xy_buffer(): char_buffer {
    small := new char_buffer(1);
    small.append("0123456789012345678901234567890123456789");
    small.clear();
    small.append_repeated('-', 5).append_number(2.5).append_number(3);
    small.clear();
    small.append("");
    small.append_repeated('x', 0);
    small.append_range(wxyz(), 1, 3);
    return small;
}

def strings_tests() {
    tests("strings") {
        tests("char_buffer") {
            buf : char_buffer;
            before_each { buf = new char_buffer(); };

            test("new buffer is empty") { expect(buf.length()).should_be(0); };
            test("is_empty") { expect_true(buf.is_empty()); };
            test("empty to_string") { expect(buf.build()).should_be(""); };
            test("empty to_array") { expect_null(buf.to_array()); };

            tests("filled") {
                before_each { buf.append("x = ").append_int(42).append_char('\n'); };

                test("chained appends") { expect(buf.build()).should_be("x = 42\n"); };
                test("length") { expect(buf.length()).should_be(7); };
                test("char_at") { expect(buf.char_at(0)).should_be('x'); };
                test("not empty") { expect_false(buf.is_empty()); };
                test("set_char") {
                    buf.set_char(0, 'y');
                    expect(buf.substring(0, 1)).should_be("y");
                };
                test("truncate") {
                    buf.set_char(0, 'y');
                    buf.truncate(1);
                    expect(buf.build()).should_be("y");
                };
                test("clear") {
                    buf.clear();
                    expect(buf.length()).should_be(0);
                };

                // growth far beyond the first capacity
                test("a cleared buffer grows far beyond the first capacity") {
                    buf.clear();
                    for(i : decimal = 0; i < 1000; i++) {
                        buf.append_char('a' + (i % 26));
                    }
                    expect(buf.length()).named("1000 appended").should_be(1000);
                    expect(buf.char_at(999)).named("char 999").should_be('l');
                    expect(buf.substring(26, 30)).named("substring in grown buffer").should_be("abcd");
                };
            };

            test("string larger than capacity") {
                small := new char_buffer(1);
                small.append("0123456789012345678901234567890123456789");
                expect(small.length()).should_be(40);
            };
            test("append_repeated and numbers") {
                small := new char_buffer(1);
                small.append("0123456789012345678901234567890123456789");
                small.clear();
                small.append_repeated('-', 5).append_number(2.5).append_number(3);
                expect(small.build()).should_be("-----2.53");
            };
            test("empty appends") {
                small := new char_buffer(1);
                small.append("0123456789012345678901234567890123456789");
                small.clear();
                small.append("");
                small.append_repeated('x', 0);
                expect(small.length()).should_be(0);
            };
            test("append_range") { expect(xy_buffer().build()).should_be("xy"); };
            test("to_array") {
                arr := xy_buffer().to_array();
                expect(sizeof(arr)).named("to_array size").should_be(2);
                expect(arr[1]).named("to_array content").should_be('y');
            };

            test("char_at past end") { expect_throws<out_of_bounds_exception>() { xy_buffer().char_at(2); }; };
            test("truncate longer") { expect_throws<illegal_argument_exception>() { xy_buffer().truncate(3); }; };
            test("append_range outside") { expect_throws<illegal_argument_exception>() { xy_buffer().append_range(wxyz(), 3, 5); }; };
            test("substring reversed") { expect_throws<illegal_argument_exception>() { xy_buffer().substring(1, 0); }; };
        };

        tests("slicing") {
            s : string;
            before_each { s = "hello world"; };

            test("length") { expect(io_strings.length(s)).should_be(11); };
            test("length of empty") { expect(io_strings.length("")).should_be(0); };
            test("slice") { expect(io_strings.slice(s, 0, 5)).should_be("hello"); };
            test("slice clipped") { expect(io_strings.slice(s, 6, 99)).should_be("world"); };
            test("slice empty range") { expect(io_strings.slice(s, 5, 5)).should_be(""); };
            test("slice reversed") { expect(io_strings.slice(s, 7, 3)).should_be(""); };
            test("slice negative start") { expect(io_strings.slice(s, 0 - 4, 2)).should_be("he"); };
            test("slice_from") { expect(io_strings.slice_from(s, 6)).should_be("world"); };
            test("slice_from at end") { expect(io_strings.slice_from(s, 11)).should_be(""); };

            test("index_of") { expect(io_strings.index_of(s, 'o')).should_be(4); };
            test("index_of from") { expect(io_strings.index_of(s, 'o', 5)).should_be(7); };
            test("index_of missing") { expect(io_strings.index_of(s, 'z')).should_be(0 - 1); };
            test("last_index_of") { expect(io_strings.last_index_of(s, 'o')).should_be(7); };
            test("last_index_of missing") { expect(io_strings.last_index_of(s, 'z')).should_be(0 - 1); };
            test("index_of_text") { expect(io_strings.index_of_text(s, "wor", 0)).should_be(6); };
            test("index_of_text at end") { expect(io_strings.index_of_text(s, "ld", 0)).should_be(9); };
            test("index_of_text missing") { expect(io_strings.index_of_text(s, "worm", 0)).should_be(0 - 1); };
            test("index_of_text empty needle") { expect(io_strings.index_of_text(s, "", 3)).should_be(3); };
            test("contains") { expect_true(io_strings.contains(s, "lo w")); };
            test("contains not") { expect_false(io_strings.contains(s, "low")); };

            test("starts_with") { expect_true(io_strings.starts_with(s, "hell")); };
            test("starts_with itself") { expect_true(io_strings.starts_with(s, s)); };
            test("starts_with empty") { expect_true(io_strings.starts_with(s, "")); };
            test("starts_with longer") { expect_false(io_strings.starts_with("ab", "abc")); };
            test("ends_with") { expect_true(io_strings.ends_with(s, "world")); };
            test("ends_with itself") { expect_true(io_strings.ends_with(s, s)); };
            test("ends_with not") { expect_false(io_strings.ends_with(s, "worl")); };

            test("equals") { expect_true(io_strings.equals("abc", "abc")); };
            test("equals different") { expect_false(io_strings.equals("abc", "abd")); };
            test("equals different length") { expect_false(io_strings.equals("abc", "ab")); };
            test("equals empty") { expect_true(io_strings.equals("", "")); };
            test("equals_ignore_case") { expect_true(io_strings.equals_ignore_case("HeLLo", "hEllO")); };
            test("equals_ignore_case not") { expect_false(io_strings.equals_ignore_case("hello", "hallo")); };
            test("compare less") { expect(io_strings.compare("abc", "abd")).should_be(0 - 1); };
            test("compare greater") { expect(io_strings.compare("b", "abc")).should_be(1); };
            test("compare equal") { expect(io_strings.compare("abc", "abc")).should_be(0); };
            test("compare prefix") { expect(io_strings.compare("ab", "abc")).should_be(0 - 1); };
            test("compare upper before lower") { expect(io_strings.compare("Z", "a")).should_be(0 - 1); };
        };

        tests("changing") {
            test("trim") { expect(io_strings.trim("  hi there \t\n")).should_be("hi there"); };
            test("trim nothing") { expect(io_strings.trim("x")).should_be("x"); };
            test("trim all space") { expect(io_strings.trim("   ")).should_be(""); };
            test("trim empty") { expect(io_strings.trim("")).should_be(""); };
            test("to_lower") { expect(io_strings.to_lower("Hello World 9")).should_be("hello world 9"); };
            test("to_upper") { expect(io_strings.to_upper("Hello World 9")).should_be("HELLO WORLD 9"); };
            test("replace_char") { expect(io_strings.replace_char("a-b-c", '-', '+')).should_be("a+b+c"); };
            test("replace_text") { expect(io_strings.replace_text("one two one", "one", "1")).should_be("1 two 1"); };
            test("replace_text longer") { expect(io_strings.replace_text("aaa", "a", "bb")).should_be("bbbbbb"); };
            test("replace_text none") { expect(io_strings.replace_text("abc", "x", "y")).should_be("abc"); };
            test("replace_text to nothing") { expect(io_strings.replace_text("a,b,c", ",", "")).should_be("abc"); };
            test("replace empty") { expect_throws<illegal_argument_exception>() { io_strings.replace_text("abc", "", "y"); }; };
            test("repeat") { expect(io_strings.repeat("ab", 3)).should_be("ababab"); };
            test("repeat zero") { expect(io_strings.repeat("ab", 0)).should_be(""); };
            test("pad_left") { expect(io_strings.pad_left("7", 3, '0')).should_be("007"); };
            test("pad_left long enough") { expect(io_strings.pad_left("1234", 3, '0')).should_be("1234"); };
            test("pad_right") { expect(io_strings.pad_right("ab", 5, '.')).should_be("ab..."); };
            test("from_char") { expect(io_strings.from_char('q')).should_be("q"); };
            test("lower_char") { expect(character.to_lower('Q')).should_be('q'); };
            test("upper_char") { expect(character.to_upper('q')).should_be('Q'); };
            test("upper_char of digit") { expect(character.to_upper('5')).should_be('5'); };
            test("digit_value in base 16: digit") { expect(character.digit_value('7', 16)).should_be(7); };
            test("digit_value in base 16: lower") { expect(character.digit_value('f', 16)).should_be(15); };
            test("digit_value in base 16: upper") { expect(character.digit_value('A', 16)).should_be(10); };
            test("digit_value in base 16: none") { expect(character.digit_value('g', 16)).should_be(0 - 1); };
            test("is_space tab") { expect_true(character.is_whitespace('\t')); };
            test("is_space letter") { expect_false(character.is_whitespace('a')); };
            test("is_digit") { expect_true(character.is_digit('0')); };
            test("is_digit letter") { expect_false(character.is_digit('a')); };
            test("is_letter") { expect_true(character.is_letter('Z')); };
            test("is_letter digit") { expect_false(character.is_letter('1')); };
        };

        tests("split_join_sort") {
            test("split keeps empty pieces") {
                parts := io_strings.split("a,,b", ',');
                expect(parts.size()).should_be(3);
                expect(parts.at(0)).named("split 0").should_be("a");
                expect(parts.at(1)).named("split 1").should_be("");
                expect(parts.at(2)).named("split 2").should_be("b");
            };
            test("split empty string") { expect(io_strings.split("", ',').size()).should_be(1); };
            test("split no separator") { expect(io_strings.split("abc", ',').size()).should_be(1); };
            test("split trailing separator") { expect(io_strings.split("a,", ',').size()).should_be(2); };
            test("join") { expect(io_strings.join(io_strings.split("a,,b", ','), "|")).should_be("a||b"); };
            test("join empty list") { expect(io_strings.join(new list<string>(), ",")).should_be(""); };

            test("split_lines: every kind of line end, and none at the end") {
                lines := io_strings.split_lines("one\ntwo\r\nthree\rfour");
                expect(lines.size()).named("split_lines count").should_be(4);
                expect(lines.at(0)).named("line 0").should_be("one");
                expect(lines.at(1)).named("line 1 (crlf)").should_be("two");
                expect(lines.at(2)).named("line 2 (cr)").should_be("three");
                expect(lines.at(3)).named("line 3 (no end)").should_be("four");
            };
            test("trailing newline adds no line") { expect(io_strings.split_lines("a\nb\n").size()).should_be(2); };
            test("empty text has no lines") { expect(io_strings.split_lines("").size()).should_be(0); };
            test("blank line kept, and empty") {
                blank := io_strings.split_lines("a\n\nb");
                expect(blank.size()).should_be(3);
                expect(blank.at(1)).named("blank line is empty").should_be("");
            };

            test("sorted") {
                names := new list<string>();
                names.add("pear"); names.add("Apple"); names.add("fig"); names.add("apple"); names.add("figs"); names.add("banana");
                io_strings.sort(names);
                expect(io_strings.join(names, " ")).should_be("Apple apple banana fig figs pear");
            };
            test("200 strings sorted") {
                many := new list<string>();
                for(i : decimal = 0; i < 200; i++) {
                    many.add(io_strings.pad_left(io_strings.int_to_string((i * 37) % 200), 3, '0'));
                }
                io_strings.sort(many);
                for(i : decimal = 1; i < 200; i++) {
                    expect(io_strings.compare(many.at(i - 1), many.at(i))).named("strings " + (i - 1) + " and " + i).should_be_at_most(0);
                }
                expect(many.at(0)).named("first of 200").should_be("000");
                expect(many.at(199)).named("last of 200").should_be("199");
            };
        };

        tests("numbers") {
            test("int 0") { expect(io_strings.int_to_string(0)).should_be("0"); };
            test("int 42") { expect(io_strings.int_to_string(42)).should_be("42"); };
            test("int negative") { expect(io_strings.int_to_string(0 - 1234567890123)).should_be("-1234567890123"); };
            test("int cuts fraction") { expect(io_strings.int_to_string(2.9)).should_be("2"); };
            test("int cuts negative fraction") { expect(io_strings.int_to_string(0 - 2.9)).should_be("-2"); };
            test("int 2^53") { expect(io_strings.int_to_string(9007199254740992)).should_be("9007199254740992"); };
            test("hex") { expect(io_strings.int_to_hex(255, 0)).should_be("ff"); };
            test("hex padded") { expect(io_strings.int_to_hex(255, 4)).should_be("00ff"); };
            test("hex zero") { expect(io_strings.int_to_hex(0, 0)).should_be("0"); };
            test("hex large") { expect(io_strings.int_to_hex(4294967295, 0)).should_be("ffffffff"); };
            test("hex negative") { expect_throws<illegal_argument_exception>() { io_strings.int_to_hex(0 - 1, 0); }; };

            test("number whole") { expect(io_strings.number_to_string(3)).should_be("3"); };
            test("number negative whole") { expect(io_strings.number_to_string(0 - 120)).should_be("-120"); };
            test("number zero") { expect(io_strings.number_to_string(0)).should_be("0"); };
            test("number 0.1") { expect(io_strings.number_to_string(0.1)).should_be("0.1"); };
            test("number 2.5") { expect(io_strings.number_to_string(2.5)).should_be("2.5"); };
            test("number -0.75") { expect(io_strings.number_to_string(0 - 0.75)).should_be("-0.75"); };
            test("number pi") { expect(io_strings.number_to_string(3.141592653589793)).should_be("3.141592653589793"); };
            test("number 1e15") { expect(io_strings.number_to_string(1000000000000000)).should_be("1000000000000000"); };
            test("number large") { expect(io_strings.number_to_string(1.5e300)).should_be("1.5e+300"); };
            test("number small") { expect(io_strings.number_to_string(2e-9)).should_be("2e-9"); };
            test("number 1e21") { expect(io_strings.number_to_string(1e21)).should_be("1e+21"); };
            test("NaN") { expect(io_strings.number_to_string(0.0 / 0.0)).should_be("NaN"); };
            test("Infinity") { expect(io_strings.number_to_string(1.0 / 0.0)).should_be("Infinity"); };
            test("-Infinity") { expect(io_strings.number_to_string(0 - 1.0 / 0.0)).should_be("-Infinity"); };
            test("fixed 2") { expect(io_strings.fixed_to_string(3.14159, 2)).should_be("3.14"); };
            test("fixed pads") { expect(io_strings.fixed_to_string(2, 1)).should_be("2.0"); };
            test("fixed 0 rounds") { expect(io_strings.fixed_to_string(2.6, 0)).should_be("3"); };

            test("is_int") { expect_true(io_strings.is_int("123")); };
            test("is_int signed") { expect_true(io_strings.is_int("-5")); };
            test("is_int empty") { expect_false(io_strings.is_int("")); };
            test("is_int sign only") { expect_false(io_strings.is_int("-")); };
            test("is_int fraction") { expect_false(io_strings.is_int("1.5")); };
            test("is_int spaces") { expect_false(io_strings.is_int(" 1")); };
            test("parse_int") { expect(io_strings.parse_int("12345")).should_be(12345); };
            test("parse_int negative") { expect(io_strings.parse_int("-17")).should_be(0 - 17); };
            test("parse_int plus") { expect(io_strings.parse_int("+8")).should_be(8); };
            test("parse_int bad") { expect_throws<number_format_exception>() { io_strings.parse_int("12x"); }; };

            test("is_number int") { expect_true(io_strings.is_number("12")); };
            test("is_number fraction") { expect_true(io_strings.is_number("-0.5")); };
            test("is_number exponent") { expect_true(io_strings.is_number("2.5E-3")); };
            test("is_number leading dot") { expect_true(io_strings.is_number(".5")); };
            test("is_number empty") { expect_false(io_strings.is_number("")); };
            test("is_number word") { expect_false(io_strings.is_number("abc")); };
            test("is_number open exponent") { expect_false(io_strings.is_number("1e")); };
            test("is_number two signs") { expect_false(io_strings.is_number("--1")); };
            test("is_number hex") { expect_false(io_strings.is_number("0x10")); };
            test("is_number dot only") { expect_false(io_strings.is_number(".")); };
            test("parse_number") { expect(io_strings.parse_number("2.5")).should_be(2.5); };
            test("parse_number exponent") { expect(io_strings.parse_number("1e3")).should_be(1000); };
            test("parse_number negative") { expect(io_strings.parse_number("-0.25")).should_be(0 - 0.25); };
            test("parse_number bad") { expect_throws<number_format_exception>() { io_strings.parse_number("1.2.3"); }; };

            // number -> text -> number gives the same number
            test("numbers survive text round trip") {
                values := new decimal[6];
                values[0] = 0.3; values[1] = 123456.789; values[2] = 1.0 / 3.0; values[3] = 6.02214076e23; values[4] = 1e-7; values[5] = 0 - 987654321.125;
                for(i : decimal = 0; i < 6; i++) {
                    expect(io_strings.parse_number(io_strings.number_to_string(values[i])))
                        .named("round trip of " + io_strings.number_to_string(values[i])).should_be(values[i]);
                }
            };
        };

        test("is_null of null") { expect_true(io_strings.is_null(null)); };
        test("is_null of empty") { expect_false(io_strings.is_null("")); };
        // single quotes on unix (one inside becomes '\''), double quotes on windows
        test("shell_quote plain") {
            windows : bool = std.io#path.separator() != '/';
            expect(io_strings.shell_quote("a b")).should_be(windows ? "\"a b\"" : "'a b'");
        };
        test("shell_quote with quote length") {
            windows : bool = std.io#path.separator() != '/';
            expect(io_strings.length(io_strings.shell_quote("it's"))).should_be(windows ? 6 : 9);
        };

        // string.starts_with / ends_with with nothing to compare
        test("every text starts with the empty text") {
            empty := new string("");
            expect_true("hello".starts_with(empty) && "hello".ends_with(empty) && empty.starts_with(empty));
        };
        test("starts_with") { expect_true("hello".starts_with("he") && !"hello".starts_with("lo") && !"he".starts_with("hello")); };
    };
}
