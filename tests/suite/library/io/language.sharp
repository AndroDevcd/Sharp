mod suite.library.io.language;

import ( std.testing )

/**
 * Behaviour of the compiler / runtime / base library that the I/O library
 * (std.io, std.data, std.system) had to work around. Every check below
 * used to FAIL and passes now; the workaround named in its comment was
 * what the library did until then.
 */

calls : decimal = 0;

def counted_true(): bool {
    calls++;
    return true;
}

def boxed(v: decimal): int {
    return v;
}

def language_tests() {
    tests("language") {
        before_each { calls = 0; };

        // 1. `&&` and `||` did not stop early when the LEFT side was an object (bool, int ...):
        //    the right side was always evaluated. Workaround: `.value` on the left, or nested ifs.
        test("&& with an object on the left skips the right side") {
            if(boxed(0) > 0 && counted_true()) { }
            expect(calls).should_be(0);
        };
        test("|| with an object on the left skips the right side") {
            if(counted_true() || counted_true()) { }
            expect(calls).should_be(1);
        };

        // 2. a number above 127 stored from a `decimal` into an _int8 array element was kept as it
        //    was (128, 129 ...) instead of wrapping to -128, -127 ..., so the element no longer
        //    compared equal to the same byte read from a file.
        //    Workaround: byte_buffer converts by hand, readers compare with `& 0xff`.
        test("129 stored in _int8 wraps") {
            bytes := new _int8[2];
            v : decimal = 129;
            bytes[1] = v;
            expect(bytes[1]).should_be(0 - 127);
        };
        test("128 stored in _int8 wraps") {
            bytes := new _int8[2];
            v : decimal = 128;
            bytes[0] = v;
            expect(bytes[0]).should_be(0 - 128);
        };

        // 3. string + empty string appended "null" (string.operator+(string?) took an empty
        //    string for null). Workaround: build with char_buffer.
        test("text + empty string") {
            empty : string = "";
            expect("abc" + empty).should_be("abc");
        };

        // 4. `s == null` asks only whether there is an object: an empty string is not null.
        //    (It used to call string.operator== and answer true.)
        test("empty string == null") {
            empty : string = "";
            expect_false(empty == null);
        };
    };
}
