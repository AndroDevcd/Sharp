mod suite.library.math.numbers;

import ( std.testing, std.math )

/**
 * std.math - the number classes complex and fraction
 * (stdlib/std/math/numbers/). big_integer has its own file.
 */

def check_complex() {
    tests("complex") {
        a : complex;
        b : complex;
        before_each {
            a = new complex(3, 4);
            b = new complex(1, 0 - 2);
        };

        test("default constructor") { expect(new complex().re + new complex().im).should_be(0); };
        test("copy constructor") { expect(new complex(a).im).should_be(4); };
        test("zero") { expect(complex.zero().re).should_be(0); };
        test("one") { expect(complex.one().re).should_be(1); };
        test("i") { expect(complex.i().im).should_be(1); };
        test("of_real") { expect(complex.of_real(7).re).should_be(7); };
        test("of_real has no imaginary part") { expect(complex.of_real(7).im).should_be(0); };

        test("a + b") {
            sum := a + b;
            expect(sum.re).named("re").should_be(4);
            expect(sum.im).named("im").should_be(2);
        };
        test("a - b") {
            difference := a - b;
            expect(difference.re).named("re").should_be(2);
            expect(difference.im).named("im").should_be(6);
        };
        test("a * b") {
            product := a * b;                                   // 3 - 6i + 4i - 8i^2 = 11 - 2i
            expect(product.re).named("re").should_be(11);
            expect(product.im).named("im").should_be(0 - 2);
        };
        test("a / b") {
            quotient := a / b;                                  // (3 + 4i)(1 + 2i) / 5 = (-5 + 10i) / 5
            expect(quotient.re).named("re").should_be(0 - 1);
            expect(quotient.im).named("im").should_be(2);
        };
        test("-a") {
            negated := -a;
            expect(negated.re).named("re").should_be(0 - 3);
            expect(negated.im).named("im").should_be(0 - 4);
        };
        test("a + 2") { expect((a + 2).re).should_be(5); };
        test("a + 2 keeps im") { expect((a + 2).im).should_be(4); };
        test("a - 2") { expect((a - 2).re).should_be(1); };
        test("a * 2") {
            expect((a * 2).re).named("re").should_be(6);
            expect((a * 2).im).named("im").should_be(8);
        };
        test("a / 2") {
            expect((a / 2).re).named("re").should_be(1.5);
            expect((a / 2).im).named("im").should_be(2);
        };
        test("i * i") {
            i_squared := complex.i() * complex.i();
            expect(i_squared.re).named("re").should_be(0 - 1);
            expect(i_squared.im).named("im").should_be(0);
        };
        test("==") { expect_true((a == new complex(3, 4))); };
        test("== different") { expect_false((a == b)); };
        test("!=") { expect_true((a != b)); };
        test("approx_equals") { expect_true(a.approx_equals(new complex(3.0000001, 4), 0.000001)); };

        test("division by zero throws") {
            expect_throws<division_by_zero_exception>() { a / complex.zero(); };
            expect_throws<division_by_zero_exception>() { a / 0; };
            expect_throws<division_by_zero_exception>() { complex.zero().reciprocal(); };
        };

        test("magnitude") { expect(a.magnitude()).should_be(5); };
        test("magnitude_squared") { expect(a.magnitude_squared()).should_be(25); };
        test("phase of i") { expect(complex.i().phase()).should_be_near(HALF_PI, 0.000000000001); };
        test("phase of -1") { expect(new complex(0 - 1, 0).phase()).should_be_near(PI_VALUE, 0.000000000001); };
        test("conjugate re") { expect(a.conjugate().re).should_be(3); };
        test("conjugate im") { expect(a.conjugate().im).should_be(0 - 4); };
        test("a * conjugate is |a|^2") { expect((a * a.conjugate()).re).should_be(25); };
        test("reciprocal") {
            r := a.reciprocal();                                // (3 - 4i) / 25
            expect(r.re).named("re").should_be_near(0.12, 0.000000000001);
            expect(r.im).named("im").should_be_near(0 - 0.16, 0.000000000001);
        };
        test("is_real") { expect_true(complex.of_real(2).is_real()); };
        test("is_real of a") { expect_false(a.is_real()); };
        test("is_zero") { expect_true(complex.zero().is_zero()); };
        test("is_zero of a") { expect_false(a.is_zero()); };

        test("from_polar") {
            polar := complex.from_polar(2, HALF_PI);
            expect(polar.re).named("re").should_be_near(0, 0.000000000001);
            expect(polar.im).named("im").should_be_near(2, 0.000000000001);
        };

        test("e^(i pi) is -1") {
            euler := new complex(0, PI_VALUE).exp();
            expect(euler.re).named("re").should_be_near(0 - 1, 0.000000000001);
            expect(euler.im).named("im").should_be_near(0, 0.000000000001);
        };
        test("log(-1) is i pi") {
            log := new complex(0 - 1, 0).log();
            expect(log.re).named("re").should_be_near(0, 0.000000000001);
            expect(log.im).named("im").should_be_near(PI_VALUE, 0.000000000001);
        };
        test("log(0) throws") { expect_throws<arithmetic_exception>() { complex.zero().log(); }; };

        test("(3 + 4i)^2") {
            squared := a.pow(2);                                // 9 - 16 + 24i
            expect(squared.re).named("re").should_be_near(0 - 7, 0.00000000001);
            expect(squared.im).named("im").should_be_near(24, 0.00000000001);
        };
        test("0^0") { expect(complex.zero().pow(0).re).should_be(1); };
        test("0^3") { expect(complex.zero().pow(3).re).should_be(0); };
        test("sqrt(3 + 4i) is 2 + i") {
            root := a.sqrt();
            expect(root.re).named("re").should_be_near(2, 0.000000000001);
            expect(root.im).named("im").should_be_near(1, 0.000000000001);
        };
        test("sqrt(-4) is 2i") {
            imaginary_root := new complex(0 - 4, 0).sqrt();
            expect(imaginary_root.re).named("re").should_be_near(0, 0.000000000001);
            expect(imaginary_root.im).named("im").should_be_near(2, 0.000000000001);
        };
        test("sqrt(3 - 4i): im") {
            low_root := new complex(3, 0 - 4).sqrt();           // 2 - i
            expect(low_root.im).should_be_near(0 - 1, 0.000000000001);
        };

        test("to_string") { expect(a.to_string()!!).should_be("3 + 4i"); };
        test("to_string negative im") { expect(b.to_string()!!).should_be("1 - 2i"); };
        test("to_string fractions") { expect(new complex(0.5, 0 - 1.25).to_string()!!).should_be("0.5 - 1.25i"); };
        test("equal numbers have equal hashes") { expect_true((a.hash() == new complex(3, 4).hash())); };
    };
}

def check_fraction() {
    tests("fraction") {
        half : fraction;
        third : fraction;
        before_each {
            half = new fraction(1, 2);
            third = new fraction(1, 3);
        };

        // ---- normalisation
        test("6/8 is 3/4") {
            f := new fraction(6, 8);
            expect(f.numerator).named("numerator").should_be(3);
            expect(f.denominator).named("denominator").should_be(4);
        };
        test("1/-2 is -1/2") {
            g := new fraction(1, 0 - 2);
            expect(g.numerator).named("numerator").should_be(0 - 1);
            expect(g.denominator).named("denominator").should_be(2);
        };
        test("-4/-6 is 2/3") {
            h := new fraction(0 - 4, 0 - 6);
            expect(h.numerator).named("numerator").should_be(2);
            expect(h.denominator).named("denominator").should_be(3);
        };
        test("0/5 is 0/1") {
            z := new fraction(0, 5);
            expect(z.numerator).named("numerator").should_be(0);
            expect(z.denominator).named("denominator").should_be(1);
        };
        test("a whole number is n/1") {
            whole := fraction.of(7);
            expect(whole.numerator).named("numerator").should_be(7);
            expect(whole.denominator).named("denominator").should_be(1);
        };
        test("copy") { expect(new fraction(new fraction(6, 8)).denominator).should_be(4); };
        test("zero") { expect(fraction.zero().numerator).should_be(0); };
        test("one") { expect(fraction.one().numerator).should_be(1); };

        test("misuse throws") {
            expect_throws<division_by_zero_exception>() { new fraction(1, 0); };
            expect_throws<illegal_argument_exception>() { new fraction(1.5, 2); };
            expect_throws<illegal_argument_exception>() { fraction.of(2.5); };
            expect_throws<division_by_zero_exception>() { half / fraction.zero(); };
            expect_throws<division_by_zero_exception>() { fraction.zero().reciprocal(); };
            expect_throws<division_by_zero_exception>() { fraction.zero().pow(0 - 1); };
            expect_throws<illegal_argument_exception>() { half.pow(0.5); };
        };

        // ---- arithmetic
        test("1/2 + 1/3 is 5/6") {
            sum := half + third;
            expect(sum.numerator).named("numerator").should_be(5);
            expect(sum.denominator).named("denominator").should_be(6);
        };
        test("1/3 + 1/6 == 1/2") {
            exact := third + new fraction(1, 6);
            expect_true((exact == half));
        };
        test("1/2 - 1/3 is 1/6") {
            difference := half - third;
            expect(difference.numerator).named("numerator").should_be(1);
            expect(difference.denominator).named("denominator").should_be(6);
        };
        test("2/3 * 3/4 is 1/2") {
            product := new fraction(2, 3) * new fraction(3, 4);
            expect(product.numerator).named("numerator").should_be(1);
            expect(product.denominator).named("denominator").should_be(2);
        };
        test("1/2 / 1/3 is 3/2") {
            quotient := half / third;
            expect(quotient.numerator).named("numerator").should_be(3);
            expect(quotient.denominator).named("denominator").should_be(2);
        };
        test("-(1/2)") { expect((-half).numerator).should_be(0 - 1); };
        test("1/2 + 1") { expect((half + 1).numerator).should_be(3); };
        test("1/2 * 4 is 2, a whole number") {
            times_four := half * 4;
            expect(times_four.numerator).named("numerator").should_be(2);
            expect_true(times_four.is_whole());
        };

        // ten times one tenth is exactly one (it is not in floating point)
        test("ten tenths are exactly one") {
            total := fraction.zero();
            tenth := new fraction(1, 10);
            for(i : decimal = 0; i < 10; i++) {
                total = total + tenth;
            }
            expect_true((total == fraction.one()));
        };

        // ---- comparison
        test("compare_to smaller") { expect(third.compare_to(half)).should_be(0 - 1); };
        test("compare_to larger") { expect(half.compare_to(third)).should_be(1); };
        test("compare_to equal") { expect(half.compare_to(new fraction(2, 4))).should_be(0); };
        test("==") { expect_true((half == new fraction(2, 4))); };
        test("!=") { expect_true((half != third)); };
        test("<") { expect_true((third < half)); };
        test("< reversed") { expect_false((half < third)); };
        test(">") { expect_true((half > third)); };
        test("<=") { expect_true((half <= new fraction(1, 2))); };
        test(">=") { expect_true((half >= third)); };
        test("negative < positive") {
            minus_half := new fraction(0 - 1, 2);
            expect_true((minus_half < third));
        };

        // ---- other operations
        test("reciprocal") { expect(new fraction(3, 4).reciprocal().numerator).should_be(4); };
        test("reciprocal of a negative keeps the sign on top") { expect(new fraction(0 - 3, 4).reciprocal().numerator).should_be(0 - 4); };
        test("abs") { expect(new fraction(0 - 3, 4).abs().numerator).should_be(3); };
        test("(2/3)^2 is 4/9") {
            squared := new fraction(2, 3).pow(2);
            expect(squared.numerator).named("numerator").should_be(4);
            expect(squared.denominator).named("denominator").should_be(9);
        };
        test("(2/3)^-2 is 9/4") {
            inverted := new fraction(2, 3).pow(0 - 2);
            expect(inverted.numerator).named("numerator").should_be(9);
            expect(inverted.denominator).named("denominator").should_be(4);
        };
        test("anything^0") { expect(new fraction(5, 7).pow(0).numerator).should_be(1); };
        test("sign negative") { expect(new fraction(0 - 1, 2).sign()).should_be(0 - 1); };
        test("sign zero") { expect(fraction.zero().sign()).should_be(0); };
        test("sign positive") { expect(half.sign()).should_be(1); };
        test("is_zero") { expect_true(fraction.zero().is_zero()); };
        test("is_whole of 1/2") { expect_false(half.is_whole()); };
        test("to_var") { expect(new fraction(3, 8).to_var()).should_be(0.375); };
        test("floor(7/2)") { expect(new fraction(7, 2).floor()).should_be(3); };
        test("floor(-7/2)") { expect(new fraction(0 - 7, 2).floor()).should_be(0 - 4); };
        test("ceil(7/2)") { expect(new fraction(7, 2).ceil()).should_be(4); };
        test("ceil(-7/2)") { expect(new fraction(0 - 7, 2).ceil()).should_be(0 - 3); };
        test("round(5/2)") { expect(new fraction(5, 2).round()).should_be(3); };
        test("round(-5/2)") { expect(new fraction(0 - 5, 2).round()).should_be(0 - 3); };
        test("round(7/3)") { expect(new fraction(7, 3).round()).should_be(2); };
        test("whole_part(7/4)") { expect(new fraction(7, 4).whole_part()).should_be(1); };
        test("whole_part(-7/4)") { expect(new fraction(0 - 7, 4).whole_part()).should_be(0 - 1); };

        // ---- text
        test("to_string") { expect(new fraction(3, 4).to_string()!!).should_be("3/4"); };
        test("to_string negative") { expect(new fraction(3, 0 - 4).to_string()!!).should_be("-3/4"); };
        test("to_string whole") { expect(new fraction(10, 2).to_string()!!).should_be("5"); };
        test("to_mixed_string") { expect(new fraction(7, 4).to_mixed_string()).should_be("1 3/4"); };
        test("to_mixed_string negative") { expect(new fraction(0 - 7, 4).to_mixed_string()).should_be("-1 3/4"); };
        test("to_mixed_string proper") { expect(new fraction(3, 4).to_mixed_string()).should_be("3/4"); };
        test("to_mixed_string whole") { expect(new fraction(8, 4).to_mixed_string()).should_be("2"); };

        test("parse 3/4") {
            p := fraction.parse("3/4");
            expect(p.numerator * 10 + p.denominator).should_be(34);
        };
        test("parse -6/8 is -3/4") {
            q := fraction.parse("-6/8");
            expect(q.numerator).named("numerator").should_be(0 - 3);
            expect(q.denominator).named("denominator").should_be(4);
        };
        test("parse whole") { expect(fraction.parse("5").numerator).should_be(5); };
        test("parse +12/-4") { expect(fraction.parse("+12/-4").numerator).should_be(0 - 3); };
        test("bad text throws") {
            expect_throws<number_format_exception>() { fraction.parse("abc"); };
            expect_throws<number_format_exception>() { fraction.parse("1/"); };
            expect_throws<number_format_exception>() { fraction.parse("/2"); };
            expect_throws<number_format_exception>() { fraction.parse("1.5/2"); };
            expect_throws<division_by_zero_exception>() { fraction.parse("1/0"); };
        };

        test("from_decimal(0.75)") {
            d := fraction.from_decimal(0.75, 100);
            expect(d.numerator * 10 + d.denominator).should_be(34);
        };
        test("pi is about 355/113") {
            pi := fraction.from_decimal(3.14159265358979, 1000);
            expect(pi.numerator).named("numerator").should_be(355);
            expect(pi.denominator).named("denominator").should_be(113);
        };
        test("pi with denominator <= 10 is 22/7") {
            coarse := fraction.from_decimal(3.14159265358979, 10);
            expect(coarse.numerator * 10 + coarse.denominator).should_be(227);
        };
        test("from_decimal(-0.125) is -1/8") {
            minus := fraction.from_decimal(0 - 0.125, 1000);
            expect(minus.numerator).named("numerator").should_be(0 - 1);
            expect(minus.denominator).named("denominator").should_be(8);
        };
        test("from_decimal of a whole number") { expect(fraction.from_decimal(4, 10).numerator).should_be(4); };
        test("from_decimal(NaN) throws") { expect_throws<illegal_argument_exception>() { fraction.from_decimal(NaN, 10); }; };
        test("equal fractions have equal hashes") { expect_true((half.hash() == new fraction(2, 4).hash())); };
    };
}

def numbers_tests() {
    tests("numbers") {
        check_complex();
        check_fraction();
    };
}
