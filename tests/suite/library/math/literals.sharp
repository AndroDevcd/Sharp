mod suite.library.math.literals;

import ( std.testing )

/**
 * BUGS found while writing std.math and std.util, all fixed; the checks below
 * guard against them. Each section names the bug and the workaround the
 * library used. All of them behaved the same with and without -O, with and
 * without the JIT.
 *
 * (Two more bugs CRASHED THE COMPILER and so could not share a file with
 * anything else: see language/operators_on_new.sharp and library/math/lambda_concat.sharp.)
 */

def literals_tests() {
    tests("literals") {
        // ---- BUG 1 (fixed): the constant expression -1.0 / 0.0 was folded to -2147483648
        // instead of negative infinity (1.0 / 0.0 was folded correctly).
        // NEGATIVE_INFINITY in std/math/math.sharp was written that way and so
        // was -2147483648. Workaround: divide two VARIABLES at run time.
        test("-1.0 / 0.0 is below every finite number") {
            folded : decimal = -1.0 / 0.0;
            expect_true(folded < 0 - 1000000000000);        // before the fix: false
        };
        test("0 - (1.0 / 0.0) is below every finite number") {
            folded : decimal = 0 - (1.0 / 0.0);
            expect_true(folded < 0 - 1000000000000);        // before the fix: false
        };

        // ---- BUG 2 (fixed): a large literal after a minus sign (also as `0 - literal`)
        // was folded to -2147483648. Workaround: put the literal in a variable
        // first, or negate at run time (see negated() in std/math/constants.sharp).
        test("0 - 9007199254740991") {
            limit : decimal = 9007199254740991;
            wrong : decimal = 0 - 9007199254740991;
            expect(wrong + limit).should_be(0);             // before the fix: 9007197107257343
        };

        // ---- BUG 3 (fixed): `number<T, NT>` had operator==(double) but no operator!=(double),
        // so `a != b` on two double OBJECTS did not compare the values:
        // is_nan(v: double), written as `return (v != v);`, returned false for NaN.
        // (math.sharp now compares v.value.)
        test("NaN != NaN on double objects") {
            zero : decimal = 0;
            nan : double = zero / zero;
            different : bool = nan != nan;
            expect_true(different);                         // before the fix: false
        };

        // ---- BUG 4 (fixed): string_builder kept a stray trailing character: "ab" then 'c'
        // gave "abc" plus one more character. (The library built text with
        // string + string or an _int8[] instead.)
        test("string_builder size after ab + c") {
            sb := new string_builder();
            sb += "ab";
            sb.append('c');
            built : string = sb.to_string()!!;
            expect(built.size()).should_be(3);              // before the fix: 4
        };
    };
}
