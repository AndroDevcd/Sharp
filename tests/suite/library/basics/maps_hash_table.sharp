mod suite.library.basics.maps_hash_table;

import ( std.testing )

/**
 * std hash_table<k, v>: the key/value container whose every operation runs
 * inside lock(self) - put, at, contains_key, remove, size, clear, keys, values.
 *
 * (It used to not compile at all: the constructors were spelled `hashtable`.)
 * hash_map, the container without the lock, is in maps.sharp.
 */

class city {
    name : string = "";
    population : decimal = 0;

    city(city_name: string, people: decimal) {
        name = city_name;
        population = people;
    }
}

def maps_hash_table_tests() {
    tests("maps_hash_table") {
        // ================= string keys, number values
        test("a new table has size 0") { expect(new hash_table<string, int>().size()).should_be(0); };
        test("a new table contains no key") { expect_false(new hash_table<string, int>().contains_key("ann")); };

        // ---- put says whether the key is new
        test("put of a new key returns true, for each new key") {
            ages := new hash_table<string, int>();
            expect_true(ages.put("ann", 31));
            expect_true(ages.put("bob", 45));
            expect_true(ages.put("cy", 8));
        };

        tests("string_keys") {
            ages : hash_table<string, int>;
            before_each {
                ages = new hash_table<string, int>();
                ages.put("ann", 31);
                ages.put("bob", 45);
                ages.put("cy", 8);
            };

            test("size after three puts") { expect(ages.size()).should_be(3); };

            // ---- at and contains_key
            test("at(ann)") { expect(ages.at("ann")!!.value).should_be(31); };
            test("at(bob)") { expect(ages.at("bob")!!.value).should_be(45); };
            test("at(cy)") { expect(ages.at("cy")!!.value).should_be(8); };
            test("contains_key of a key that was put") { expect_true(ages.contains_key("bob")); };
            test("contains_key of another key") { expect_false(ages.contains_key("dora")); };
            test("a key built at run time finds the entry") {
                built := "a" + "nn";
                expect(ages.at(built)!!.value).should_be(31);
            };

            // ---- overwrite
            test("put of an existing key returns false") { expect_false(ages.put("bob", 46)); };
            test("overwriting replaces the value, not the size or the other entries") {
                ages.put("bob", 46);
                expect(ages.at("bob")!!.value).named("the value").should_be(46);
                expect(ages.size()).named("size").should_be(3);
                expect(ages.at("ann")!!.value + ages.at("cy")!!.value).named("the other entries").should_be(39);
            };

            // ---- remove
            test("remove of an existing key returns true") { expect_true(ages.remove("bob")); };
            test("remove makes the table smaller, and the key is gone") {
                ages.remove("bob");
                expect(ages.size()).named("size").should_be(2);
                expect_false(ages.contains_key("bob"));
                expect_null(ages.at("bob"));
            };
            test("remove of a key that is not there returns false and changes nothing") {
                ages.remove("bob");
                expect_false(ages.remove("bob"));
                expect(ages.size()).named("size").should_be(2);
            };
            test("the other keys survive a remove") {
                ages.remove("bob");
                expect(ages.at("ann")!!.value).should_be(31);
            };
            test("a removed key can be put again as a new key, with its new value") {
                ages.remove("bob");
                expect_true(ages.put("bob", 50));
                expect(ages.at("bob")!!.value).should_be(50);
            };

            // ---- clear
            test("clear: size 0, the keys are gone") {
                ages.clear();
                expect(ages.size()).should_be(0);
                expect_false(ages.contains_key("ann"));
            };
            test("after clear a key is new again") {
                ages.clear();
                expect_true(ages.put("ann", 1));
                expect(ages.at("ann")!!.value).named("value put after clear").should_be(1);
            };
        };

        // ================= object values
        tests("object_values") {
            cities : hash_table<string, city>;
            paris : city;
            before_each {
                cities = new hash_table<string, city>();
                paris = new city("paris", 2100000);
                cities.put("fr", paris);
                cities.put("it", new city("rome", 2800000));
            };

            test("object values: field of at(fr)") { expect(cities.at("fr")!!.name).should_be("paris"); };
            test("object values: field of at(it)") { expect(cities.at("it")!!.population).should_be(2800000); };
            test("at gives the object that was put, not a copy") { expect_true(cities.at("fr") == paris); };
            test("a missing key gives null") { expect_null(cities.at("de")); };
            test("looking up a missing key adds nothing") {
                cities.at("de");
                expect(cities.size()).should_be(2);
            };
        };

        // ================= int keys, also ones that share a bucket (1, 129, 257)
        tests("int_keys") {
            names : hash_table<int, string>;
            before_each {
                names = new hash_table<int, string>();
                names.put(1, "one");
                names.put(129, "one hundred twenty nine");
                names.put(257, "two hundred fifty seven");
                names.put(0, "zero");
                names.put(0 - 7, "minus seven");
            };

            test("int keys: size") { expect(names.size()).should_be(5); };
            test("first key of the bucket") { expect(names.at(1)!!).should_be("one"); };
            test("second key of the bucket") { expect(names.at(129)!!).should_be("one hundred twenty nine"); };
            test("third key of the bucket") { expect(names.at(257)!!).should_be("two hundred fifty seven"); };
            test("key 0") { expect(names.at(0)!!).should_be("zero"); };
            test("key -7") { expect(names.at(0 - 7)!!).should_be("minus seven"); };
            test("a missing key of the same bucket is not contained") { expect_false(names.contains_key(385)); };
            test("remove of the middle key of a bucket") { expect_true(names.remove(129)); };
            test("remove of the middle key of a bucket keeps the ones around it") {
                names.remove(129);
                expect(names.at(1)!!).named("the one before it").should_be("one");
                expect(names.at(257)!!).named("the one after it").should_be("two hundred fifty seven");
                expect_false(names.contains_key(129));
            };
        };

        // ================= many entries
        test("500 puts: every key was new") {
            squares := new hash_table<int, int>();
            new_keys : decimal = 0;
            for(i : decimal = 0; i < 500; i++) {
                if(squares.put(i, i * i)) new_keys++;
            }
            expect(new_keys).should_be(500);
        };

        tests("squares") {
            squares : hash_table<int, int>;
            before_each {
                squares = new hash_table<int, int>();
                for(i : decimal = 0; i < 500; i++) {
                    squares.put(i, i * i);
                }
            };

            test("500 puts: size") { expect(squares.size()).should_be(500); };
            test("500 puts: at(0)") { expect(squares.at(0)!!.value).should_be(0); };
            test("500 puts: at(321)") { expect(squares.at(321)!!.value).should_be(103041); };
            test("500 puts: at(499)") { expect(squares.at(499)!!.value).should_be(249001); };
            test("500 puts: the sum of all values") {
                sum : decimal = 0;
                for(i : decimal = 0; i < 500; i++) {
                    sum += squares.at(i)!!.value;
                }
                expect(sum).should_be(41541750);
            };

            // remove every second key
            test("250 removes: all found their key, 250 entries are left") {
                removed : decimal = 0;
                for(i : decimal = 0; i < 500; i += 2) {
                    if(squares.remove(i)) removed++;
                }
                expect(removed).named("removes that found their key").should_be(250);
                expect(squares.size()).named("entries left").should_be(250);
                expect_false(squares.contains_key(200));
                expect(squares.at(201)!!.value).named("a key that was kept").should_be(40401);
            };
        };

        // ================= keys() and values()
        tests("keys_and_values") {
            small : hash_table<string, int>;
            before_each {
                small = new hash_table<string, int>();
                small.put("a", 1);
                small.put("b", 2);
                small.put("c", 3);
            };

            test("keys(): one per entry") { expect(small.keys().size()).should_be(3); };
            test("values(): one per entry") { expect(small.values().size()).should_be(3); };
            test("values(): 1 + 2 + 3") {
                total : decimal = 0;
                foreach(v in small.values()) {
                    total += v.value;
                }
                expect(total).should_be(6);
            };
            test("keys(): every key is one that was put") {
                found : decimal = 0;
                foreach(k in small.keys()) {
                    if(k == "a" || k == "b" || k == "c") found++;
                }
                expect(found).should_be(3);
            };
        };

        // ================= two tables are independent
        test("same key in two tables") {
            first := new hash_table<string, int>();
            second := new hash_table<string, int>();
            first.put("k", 1);
            second.put("k", 2);
            expect(first.at("k")!!.value).named("first").should_be(1);
            expect(second.at("k")!!.value).named("second").should_be(2);
        };
    };
}
