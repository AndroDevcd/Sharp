mod suite.library.time.measure;

import ( std.testing, std.time, std.io )

/**
 * std.time: measure_time and measure_millis (std/time/clocks/measure.sharp).
 *
 * With a manual_clock the numbers are exact; the real clock is only checked
 * for what always holds.
 */

def nothing() {
}

def measure_tests() {
    tests("measure") {
        // ---- by a clock the test moves itself
        tests("manual_clock") {
            hand : manual_clock;
            took : duration;
            before_each {
                hand = new manual_clock();
                took = measure_time(hand, { -> hand.advance_millis(1250); });
            };

            test("exactly what the clock moved") { expect(took.to_millis()).should_be(1250); };
            test("as text") { expect(took.to_string()!!).should_be("1.25s"); };
            test("in other units") { expect_true(took.to_micros() == 1250000 && took.to_nanos() == 1250000000 && took.to_seconds() == 1); };
            test("a block that takes no time") { expect_true(measure_time(hand, { -> nothing(); }).is_zero()); };
            test("the block runs once") {
                ran : decimal = 0;
                measure_time(hand, { -> ran = ran + 1; });
                expect(ran).should_be(1);
            };
            test("what the block throws comes out") {
                expect_throws<illegal_state_exception>() {
                    measure_time(hand, { -> throw new illegal_state_exception("inside"); });
                };
            };
        };

        // ---- by the real clock
        test("the real clock: not negative, far below a minute") {
            real := measure_time { nothing(); };
            expect_true(!real.is_negative() && real.to_seconds() < 60);
        };
        test("a sleep of 30 ms takes at least about that") {
            slept := measure_time { thread.sleep(30); };
            expect_true(slept.to_millis() >= 25 && slept.to_seconds() < 60);
        };
        test("measure_millis") {
            millis : decimal = measure_millis { thread.sleep(30); };
            expect_true(millis >= 25 && millis < 60000);
        };

        // the readings of the system clock agree with each other
        test("system_clock: millis, micros and nanos are one clock") {
            clock_ms : decimal = system_clock.instance.millis();
            expect_true(clock_ms > 1577836800000 && system_clock.instance.micros() >= clock_ms * 1000 && system_clock.instance.nanos() >= clock_ms * 1000000);
        };
        test("system_clock.local_field") {
            hour : decimal = system_clock.local_field(system_clock.local_hour);
            month : decimal = system_clock.local_field(system_clock.local_month);
            expect_true(hour >= 0 && hour < 24 && month >= 0 && month < 12 && system_clock.local_field(system_clock.local_year) >= 120);
        };
    };
}
