mod suite.library.collections.arrays;

import ( std.testing, std.collections )

/**
 * std.collections - the static array helpers: arrays<T> for arrays of
 * objects and var_arrays for arrays of native numbers.
 */

def ascending(a: int, b: int) : decimal { return a.value - b.value; }
def descending(a: int, b: int) : decimal { return b.value - a.value; }

/** "1,2,3" for an array of ints */
def join(items: int[]) : string {
    text := "";
    for(i : decimal = 0; i < sizeof(items); i++) {
        if(i > 0) text = text + ",";
        text = text + items[i];
    }
    return text;
}

/** "1,2,3" for an array of whole native numbers */
def join_vars(items: decimal[]) : string {
    text := "";
    for(i : decimal = 0; i < sizeof(items); i++) {
        if(i > 0) text = text + ",";
        text = text + new int(items[i]);
    }
    return text;
}

/** an int[] from native numbers */
def ints(a: decimal, b: decimal, c: decimal, d: decimal, e: decimal) : int[] {
    return new int[] { new int(a), new int(b), new int(c), new int(d), new int(e) };
}

/** a decimal[] from native numbers */
def vars(a: decimal, b: decimal, c: decimal, d: decimal, e: decimal) : decimal[] {
    result := new decimal[5];
    result[0] = a; result[1] = b; result[2] = c; result[3] = d; result[4] = e;
    return result;
}

/** 2,1 and 3,1,2: arrays of two and of three */
def two_ints() : int[] { return new int[] { new int(2), new int(1) }; }
def three_ints() : int[] { return new int[] { new int(3), new int(1), new int(2) }; }

/** `n` pseudo random numbers, the same every time for the same seed */
def random_ints(n: decimal, start: decimal) : int[] {
    big := new int[n];
    seed : decimal = start;
    for(i : decimal = 0; i < n; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        big[i] = new int(seed);
    }
    return big;
}

def random_vars(n: decimal, start: decimal) : decimal[] {
    big := new decimal[n];
    seed : decimal = start;
    for(i : decimal = 0; i < n; i++) {
        seed = (seed * 7919 + 104729) % 1000003;
        big[i] = seed;
    }
    return big;
}

/** something to sort by one field while watching the order of the other */
class card {
    rank : decimal;
    label : string;
    card(rank: decimal, label: string) { self->rank = rank; self->label = label; }
}

def by_rank(a: card, b: card) : decimal { return a.rank - b.rank; }

def arrays_tests() {
    tests("arrays") {
        tests("object_arrays") {
            test("sort ascending, then descending") {
                a := ints(5, 3, 9, 1, 4);
                arrays<int>.sort(a, ascending);
                expect(join(a)).named("ascending").should_be("1,3,4,5,9");
                arrays<int>.sort(a, descending);
                expect(join(a)).named("descending").should_be("9,5,4,3,1");
            };
            test("is_sorted") {
                a := ints(9, 5, 4, 3, 1);
                expect(arrays<int>.is_sorted(a, descending)).named("descending").should_be(1);
                expect(arrays<int>.is_sorted(a, ascending)).named("ascending").should_be(0);
            };

            // edge sizes
            test("sort of an empty array") {
                none := new int[0];
                arrays<int>.sort(none, ascending);
                expect(sizeof(none)).should_be(0);
            };
            test("is_sorted empty") { expect(arrays<int>.is_sorted(new int[0], ascending)).should_be(1); };
            test("sort of one element") {
                one := new int[] { new int(7) };
                arrays<int>.sort(one, ascending);
                expect(one[0].value).should_be(7);
            };
            test("sort of two elements") {
                two := two_ints();
                arrays<int>.sort(two, ascending);
                expect(join(two)).should_be("1,2");
            };
            test("sort of three elements (odd number of merge passes)") {
                three := three_ints();
                arrays<int>.sort(three, ascending);
                expect(join(three)).should_be("1,2,3");
            };
            test("sort with duplicates") {
                dup := ints(2, 1, 2, 1, 2);
                arrays<int>.sort(dup, ascending);
                expect(join(dup)).should_be("1,1,2,2,2");
            };

            // sorted() leaves the original alone
            test("sorted gives a sorted copy and leaves the original") {
                b := ints(4, 2, 5, 1, 3);
                c := arrays<int>.sorted(b, ascending);
                expect(join(c)).named("the copy").should_be("1,2,3,4,5");
                expect(join(b)).named("the original").should_be("4,2,5,1,3");
            };

            // stable: cards with the same rank keep their order
            test("sort is stable") {
                cards := new card[] {
                    new card(2, "a"), new card(1, "b"), new card(2, "c"), new card(1, "d"), new card(2, "e"), new card(0, "f")
                };
                arrays<card>.sort(cards, by_rank);
                order := "";
                for(i : decimal = 0; i < sizeof(cards); i++) order = order + cards[i].label;
                expect(order).should_be("fbdace");
            };

            // binary_search on 1,2,3,4,5
            tests("binary_search") {
                c : int[];
                before_each { c = ints(1, 2, 3, 4, 5); };

                test("binary_search first") { expect(arrays<int>.binary_search(c, 1, ascending)).should_be(0); };
                test("binary_search middle") { expect(arrays<int>.binary_search(c, 3, ascending)).should_be(2); };
                test("binary_search last") { expect(arrays<int>.binary_search(c, 5, ascending)).should_be(4); };
                test("binary_search below all: -(0) - 1") { expect(arrays<int>.binary_search(c, 0, ascending)).should_be(0 - 1); };
                test("binary_search above all: -(5) - 1") { expect(arrays<int>.binary_search(c, 9, ascending)).should_be(0 - 6); };
            };
            test("binary_search between: -(2) - 1") {
                gaps := ints(10, 20, 30, 40, 50);
                expect(arrays<int>.binary_search(gaps, 25, ascending)).should_be(0 - 3);
            };
            test("binary_search in an empty array") { expect(arrays<int>.binary_search(new int[0], 1, ascending)).should_be(0 - 1); };

            // reverse / reversed / swap / fill
            test("reverse") {
                c := ints(1, 2, 3, 4, 5);
                arrays<int>.reverse(c);
                expect(join(c)).should_be("5,4,3,2,1");
            };
            test("reverse with an even length") {
                even := new int[] { new int(1), new int(2), new int(3), new int(4) };
                arrays<int>.reverse(even);
                expect(join(even)).should_be("4,3,2,1");
            };
            test("reversed gives a copy and leaves the original") {
                c := ints(5, 4, 3, 2, 1);
                expect(join(arrays<int>.reversed(c))).named("the copy").should_be("1,2,3,4,5");
                expect(join(c)).named("the original").should_be("5,4,3,2,1");
            };
            test("swap") {
                c := ints(5, 4, 3, 2, 1);
                arrays<int>.swap(c, 0, 4);
                expect(join(c)).should_be("1,4,3,2,5");
            };
            test("swap out of range") {
                c := ints(1, 4, 3, 2, 5);
                expect_throws<out_of_bounds_exception>() { arrays<int>.swap(c, 0, 5); };
            };
            test("fill") {
                filled := new int[3];
                arrays<int>.fill(filled, 8);
                expect(join(filled)).should_be("8,8,8");
            };

            // copies, from 4,2,5,1,3
            tests("copies") {
                b : int[];
                before_each { b = ints(4, 2, 5, 1, 3); };

                test("copy_of same length") { expect(join(arrays<int>.copy_of(b, 5))).should_be("4,2,5,1,3"); };
                test("copy_of shorter") { expect(join(arrays<int>.copy_of(b, 2))).should_be("4,2"); };
                test("copy_of longer: length, kept elements, empty extra slots") {
                    longer := arrays<int>.copy_of(b, 7);
                    expect(sizeof(longer)).named("length").should_be(7);
                    expect(longer[4].value).named("kept elements").should_be(3);
                    expect_null(longer[6]);
                };
                test("copy_of zero") { expect(sizeof(arrays<int>.copy_of(b, 0))).should_be(0); };
                test("copy_of negative") { expect_throws<illegal_argument_exception>() { arrays<int>.copy_of(b, 0 - 1); }; };
                test("copy_of_range") { expect(join(arrays<int>.copy_of_range(b, 1, 4))).should_be("2,5,1"); };
                test("copy_of_range empty") { expect(sizeof(arrays<int>.copy_of_range(b, 2, 2))).should_be(0); };
                test("copy_of_range past the end") { expect_throws<out_of_bounds_exception>() { arrays<int>.copy_of_range(b, 3, 6); }; };
                test("copy_of_range from > to") { expect_throws<out_of_bounds_exception>() { arrays<int>.copy_of_range(b, 3, 2); }; };
            };
            test("concat") {
                two := two_ints();
                three := three_ints();
                arrays<int>.sort(two, ascending);
                arrays<int>.sort(three, ascending);
                expect(join(arrays<int>.concat(two, three))).should_be("1,2,1,2,3");
            };
            test("concat with empty") {
                two := two_ints();
                arrays<int>.sort(two, ascending);
                expect(join(arrays<int>.concat(new int[0], two))).should_be("1,2");
            };

            // searching and aggregates, in 7,3,7,5,3
            tests("searching") {
                d : int[];
                words : string[];
                before_each {
                    d = ints(7, 3, 7, 5, 3);
                    words = new string[] { "pear", "fig", "apple" };
                };

                test("index_of") { expect(arrays<int>.index_of(d, 3)).should_be(1); };
                test("index_of first element") { expect(arrays<int>.index_of(d, 7)).should_be(0); };
                test("index_of missing") { expect(arrays<int>.index_of(d, 9)).should_be(0 - 1); };
                test("last_index_of") { expect(arrays<int>.last_index_of(d, 7)).should_be(2); };
                test("last_index_of missing") { expect(arrays<int>.last_index_of(d, 9)).should_be(0 - 1); };
                test("contains") { expect(arrays<int>.contains(d, 5)).should_be(1); };
                test("contains missing") { expect(arrays<int>.contains(d, 6)).should_be(0); };
                test("count") { expect(arrays<int>.count(d, 7)).should_be(2); };
                test("count missing") { expect(arrays<int>.count(d, 8)).should_be(0); };
                test("index_of compares strings by value") { expect(arrays<string>.index_of(words, "f" + "ig")).should_be(1); };

                // aggregates
                test("min") { expect(arrays<int>.min(d, ascending).value).should_be(3); };
                test("max") { expect(arrays<int>.max(d, ascending).value).should_be(7); };
                test("min with the comparison turned around") { expect(arrays<int>.min(d, descending).value).should_be(7); };
                test("max by length") { expect(arrays<string>.max(words, { x: string, y: string -> (decimal) return x.size() - y.size(); })).should_be("apple"); };
                test("sum_of") { expect(arrays<int>.sum_of(d, { n: int -> (decimal) return n.value; })).should_be(25); };

                // to and from list
                test("to_list") {
                    as_list := arrays<int>.to_list(d);
                    expect(as_list.size()).named("size").should_be(5);
                    expect(as_list.at(3).value).named("[3]").should_be(5);
                };
                test("from_list") { expect(join(arrays<int>.from_list(arrays<int>.to_list(d)))).should_be("7,3,7,5,3"); };
            };
            test("sum_of empty") { expect(arrays<int>.sum_of(new int[0], { n: int -> (decimal) return n.value; })).should_be(0); };
            test("min of empty") { expect_throws<illegal_argument_exception>() { arrays<int>.min(new int[0], ascending); }; };
            test("max of empty") { expect_throws<illegal_argument_exception>() { arrays<int>.max(new int[0], ascending); }; };

            // equals
            test("equals same contents") { expect(arrays<int>.equals(ints(1, 2, 3, 4, 5), ints(1, 2, 3, 4, 5))).should_be(1); };
            test("equals one difference") { expect(arrays<int>.equals(ints(1, 2, 3, 4, 5), ints(1, 2, 3, 4, 6))).should_be(0); };
            test("equals different length") { expect(arrays<int>.equals(two_ints(), three_ints())).should_be(0); };
            test("equals both empty") { expect(arrays<int>.equals(new int[0], new int[0])).should_be(1); };

            test("from_list of an empty list") { expect(sizeof(arrays<int>.from_list(new list<int>()))).should_be(0); };

            // scale: 5000 pseudo random numbers
            tests("sort_5000") {
                big : int[];
                before_each {
                    big = random_ints(5000, 31337);
                    arrays<int>.sort(big, ascending);
                };

                test("sort 5000: ascending, nothing lost or invented") {
                    sum_before : decimal = 0;
                    unsorted := random_ints(5000, 31337);
                    for(i : decimal = 0; i < 5000; i++) sum_before += unsorted[i].value;
                    sum_after : decimal = big[0].value;
                    for(i : decimal = 1; i < 5000; i++) {
                        expect(big[i].value).named("element " + i).should_be_at_least(big[i - 1].value);
                        sum_after += big[i].value;
                    }
                    expect(sum_after).named("sum").should_be(sum_before);
                };
                test("sort 5000: is_sorted") { expect(arrays<int>.is_sorted(big, ascending)).should_be(1); };
                test("sort 5000: binary_search finds elements") {
                    for(i : decimal = 0; i < 5000; i += 97) {
                        at : decimal = arrays<int>.binary_search(big, big[i], ascending);
                        expect(at).named("search for element " + i).should_be_at_least(0);
                        expect(big[at].value).named("what the search for element " + i + " found").should_be(big[i].value);
                    }
                };
                // already sorted and reversed input
                test("sort 5000: sorted input stays sorted") {
                    arrays<int>.sort(big, ascending);
                    expect(arrays<int>.is_sorted(big, ascending)).should_be(1);
                };
                test("sort 5000: reversed, largest first") {
                    arrays<int>.sort(big, descending);
                    expect(arrays<int>.is_sorted(big, descending)).should_be(1);
                    expect_true(big[0].value >= big[4999].value);
                };
            };
        };

        tests("var_arrays") {
            test("var sort, and is_sorted") {
                a := vars(5, 3, 9, 1, 4);
                var_arrays.sort(a);
                expect(join_vars(a)).should_be("1,3,4,5,9");
                expect(var_arrays.is_sorted(a)).named("is_sorted").should_be(1);
            };
            test("var sort_descending, and is_sorted after it") {
                a := vars(5, 3, 9, 1, 4);
                var_arrays.sort(a);
                var_arrays.sort_descending(a);
                expect(join_vars(a)).should_be("9,5,4,3,1");
                expect(var_arrays.is_sorted(a)).named("is_sorted").should_be(0);
            };

            test("var sort empty") {
                none := new decimal[0];
                var_arrays.sort(none);
                expect(sizeof(none)).should_be(0);
            };
            test("var is_sorted empty") { expect(var_arrays.is_sorted(new decimal[0])).should_be(1); };
            test("var sort of three (odd number of merge passes)") {
                three := new decimal[3];
                three[0] = 3; three[1] = 1; three[2] = 2;
                var_arrays.sort(three);
                expect(join_vars(three)).should_be("1,2,3");
            };

            // fractions and negatives
            test("var sort fractions") {
                f := vars(0.5, 0 - 2, 0.25, 0 - 2.5, 0);
                var_arrays.sort(f);
                expect(f[0]).named("[0]").should_be(0 - 2.5);
                expect(f[1]).named("[1]").should_be(0 - 2);
                expect(f[2]).named("[2]").should_be(0);
                expect(f[3]).named("[3]").should_be(0.25);
                expect(f[4]).named("[4]").should_be(0.5);
            };
            test("var min of negatives") { expect(var_arrays.min(vars(0.5, 0 - 2, 0.25, 0 - 2.5, 0))).should_be(0 - 2.5); };

            test("var sorted gives a sorted copy and leaves the original") {
                b := vars(4, 2, 5, 1, 3);
                c := var_arrays.sorted(b);
                expect(join_vars(c)).named("the copy").should_be("1,2,3,4,5");
                expect(join_vars(b)).named("the original").should_be("4,2,5,1,3");
            };

            tests("binary_search") {
                c : decimal[];
                before_each { c = vars(1, 2, 3, 4, 5); };

                test("var binary_search first") { expect(var_arrays.binary_search(c, 1)).should_be(0); };
                test("var binary_search middle") { expect(var_arrays.binary_search(c, 3)).should_be(2); };
                test("var binary_search last") { expect(var_arrays.binary_search(c, 5)).should_be(4); };
                test("var binary_search between: -(2) - 1") { expect(var_arrays.binary_search(c, 2.5)).should_be(0 - 3); };
                test("var binary_search below all") { expect(var_arrays.binary_search(c, 0)).should_be(0 - 1); };
                test("var binary_search above all") { expect(var_arrays.binary_search(c, 6)).should_be(0 - 6); };
                test("var reverse") {
                    var_arrays.reverse(c);
                    expect(join_vars(c)).should_be("5,4,3,2,1");
                };
            };
            test("var binary_search empty") { expect(var_arrays.binary_search(new decimal[0], 6)).should_be(0 - 1); };

            test("var fill") {
                filled := new decimal[3];
                var_arrays.fill(filled, 7);
                expect(join_vars(filled)).should_be("7,7,7");
            };

            // copies, searching and aggregates, in 4,2,5,1,3
            tests("unsorted") {
                b : decimal[];
                before_each { b = vars(4, 2, 5, 1, 3); };

                test("var copy_of shorter") { expect(join_vars(var_arrays.copy_of(b, 2))).should_be("4,2"); };
                test("var copy_of longer is padded with 0") { expect(join_vars(var_arrays.copy_of(b, 7))).should_be("4,2,5,1,3,0,0"); };
                test("var copy_of negative") { expect_throws<illegal_argument_exception>() { var_arrays.copy_of(b, 0 - 1); }; };
                test("var copy_of_range") { expect(join_vars(var_arrays.copy_of_range(b, 1, 4))).should_be("2,5,1"); };
                test("var copy_of_range empty") { expect(sizeof(var_arrays.copy_of_range(b, 5, 5))).should_be(0); };
                test("var copy_of_range past the end") { expect_throws<out_of_bounds_exception>() { var_arrays.copy_of_range(b, 2, 6); }; };

                test("var index_of") { expect(var_arrays.index_of(b, 5)).should_be(2); };
                test("var index_of missing") { expect(var_arrays.index_of(b, 6)).should_be(0 - 1); };
                test("var contains") { expect(var_arrays.contains(b, 1)).should_be(1); };
                test("var contains missing") { expect(var_arrays.contains(b, 1.5)).should_be(0); };

                test("var min") { expect(var_arrays.min(b)).should_be(1); };
                test("var max") { expect(var_arrays.max(b)).should_be(5); };
                test("var sum") { expect(var_arrays.sum(b)).should_be(15); };
                test("var average") { expect(var_arrays.average(b)).should_be(3); };
                test("var average with a fraction") { expect(var_arrays.average(var_arrays.copy_of(b, 2))).should_be(3); };
                test("var equals different length") { expect(var_arrays.equals(b, new decimal[0])).should_be(0); };
                test("var to_list") {
                    boxed := var_arrays.to_list(b);
                    expect(boxed.size()).named("size").should_be(5);
                    expect(boxed.at(2).value).named("[2]").should_be(5);
                };
            };
            test("var sum empty") { expect(var_arrays.sum(new decimal[0])).should_be(0); };
            test("var min of empty") { expect_throws<illegal_argument_exception>() { var_arrays.min(new decimal[0]); }; };
            test("var max of empty") { expect_throws<illegal_argument_exception>() { var_arrays.max(new decimal[0]); }; };
            test("var average of empty") { expect_throws<illegal_argument_exception>() { var_arrays.average(new decimal[0]); }; };

            test("var equals") { expect(var_arrays.equals(vars(1, 2, 3, 4, 5), vars(1, 2, 3, 4, 5))).should_be(1); };
            test("var equals one difference") { expect(var_arrays.equals(vars(1, 2, 3, 4, 5), vars(1, 2, 0, 4, 5))).should_be(0); };

            // scale: 5000 pseudo random numbers, checked for order and for the same sum
            tests("sort_5000") {
                big : decimal[];
                before_each {
                    big = random_vars(5000, 777);
                    var_arrays.sort(big);
                };

                test("var sort 5000: ascending") {
                    for(i : decimal = 1; i < 5000; i++) {
                        expect(big[i]).named("element " + i).should_be_at_least(big[i - 1]);
                    }
                };
                test("var sort 5000: same sum") {
                    sum_before : decimal = 0;
                    unsorted := random_vars(5000, 777);
                    for(i : decimal = 0; i < 5000; i++) sum_before += unsorted[i];
                    expect(var_arrays.sum(big)).should_be(sum_before);
                };
                test("var sort 5000: min is first") { expect(var_arrays.min(big)).should_be(big[0]); };
                test("var sort 5000: max is last") { expect(var_arrays.max(big)).should_be(big[4999]); };
                test("var sort 5000: binary_search finds an element") { expect_true(var_arrays.binary_search(big, big[1234]) >= 0); };
                test("var sort 5000: descending") {
                    var_arrays.sort_descending(big);
                    expect_true(big[0] >= big[1] && big[4998] >= big[4999]);
                };
            };
        };
    };
}
