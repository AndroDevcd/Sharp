mod suite.library.coroutines.channels;

import (
    std.testing,
    std.io.coroutines,
    std.io.coroutines.channels,
    std.io
)

/**
 * std.io.coroutines.channels: channel<t> with its four capacities, close and
 * cancel, cancellation of waiting senders and receivers, for_each / to_list,
 * produce, and pipelines that move 20,000 elements across worker threads.
 *
 * Asserted are only things that hold for every schedule: what one sender sent
 * arrives in its order, totals and counts after everything was joined, the
 * state of a channel after close.
 *
 * Coroutine blocks cannot see locals of the function that created them (the
 * closure rule), so every coroutine here is given its channels in a state
 * object (class link) or uses globals. The blocks of run_blocking and
 * coroutine_scope run in-line, on the main fiber: they write what they saw into
 * the test's locals, and the test checks it after the scope has ended.
 */

class link {
    input : channel<int>?;
    output : channel<int>?;
    count : decimal = 0;
    first : decimal = 0;
}

class flag {
    value : decimal = 0;
}

received_total := new atomic_counter();
received_count := new atomic_counter();
out_of_order := new atomic_counter();
never_reached := new atomic_counter();
closed_seen := new atomic_counter();
warmed_up : decimal = 0;          // warm_up() runs once in the program, before the first test of this file

def send_range(l: link) {
    out := l.output!!;
    for(i : decimal = 0; i < l.count; i++) {
        out.send(l.first + i);
    }
}

def drain(l: link) {
    source := l.input!!;
    for( ;; ) {
        n := source.receive_or_null();
        if(n == null) { break; }
        received_total.add(n!!.value);
        received_count.increment();
    }
}

/** receives everything and counts elements that are not exactly previous + 1 */
def drain_in_order(l: link) {
    source := l.input!!;
    expected : decimal = l.first;
    for( ;; ) {
        n := source.receive_or_null();
        if(n == null) { break; }
        if(n!!.value != expected) { out_of_order.increment(); }
        expected++;
        received_count.increment();
    }
}

def square_stage(l: link) {
    source := l.input!!;
    out := l.output!!;
    for( ;; ) {
        n := source.receive_or_null();
        if(n == null) { break; }
        out.send(n!!.value * 2);
    }
    out.close();
}

/** a buffered channel of capacity 3, filled with 1, 2, 3 */
def full_buffer() : channel<int> {
    b := new channel<int>(3);
    b.try_send(1);
    b.try_send(2);
    b.try_send(3);
    return b;
}

/**
 * Runs the coroutine machinery on ONE thread before any worker thread exists,
 * so that the library functions are compiled by the JIT before several threads
 * are inside them (see core.sharp warm_up() and jit_fiber_frames.sharp in
 * this folder). It checks nothing itself,
 * and it is needed only once in the program: the before_each of the file calls
 * it, and it runs the first time.
 */
def warm_up() {
    if(warmed_up == 1) { return; }
    warmed_up = 1;
    run_blocking({ ->
        for(i : decimal = 0; i < 30; i++) {
            w := async<int>.start({ -> (int) delay(1); return 10; });
            w.await();
            k := launch({ -> yield(); delay(1); });
            k.join();
            c := launch({ -> delay(1000000); });
            yield();
            c.cancel_and_join();
            coroutine_scope({ -> launch({ -> yield(); }); });
        }
    });

    // the channel itself, without any coroutine
    ch := new channel<int>(4);
    for(i : decimal = 0; i < 30; i++) {
        ch.send(i);
        ch.try_send(i);
        ch.receive();
        ch.receive_or_null();
        ch.try_receive();
    }
}

def channels_tests() {
    tests("channels") {
        before_each { warm_up(); };

        tests("capacities") {
            // ---- buffered
            test("a new buffered channel has its capacity and is empty") {
                b := new channel<int>(3);
                expect(b.get_capacity()).named("capacity").should_be(3);
                expect_true(b.is_empty());
            };

            test("try_send fills a buffer up to its capacity, then refuses") {
                b := new channel<int>(3);
                expect_true(b.try_send(1));
                expect_true(b.try_send(2));
                expect_true(b.try_send(3));
                expect_false(b.try_send(4));
                expect(b.size()).named("size of a full buffer").should_be(3);
            };

            test("receive and try_receive give the oldest first and make room again, in order, until it is empty") {
                b := full_buffer();
                expect(b.receive().value).named("receive gives the oldest").should_be(1);
                expect(b.try_receive()!!.value).named("try_receive gives the next").should_be(2);
                expect_true(b.try_send(5));
                expect(b.receive().value).named("order kept").should_be(3);
                expect(b.receive().value).named("order kept (2)").should_be(5);
                expect_null(b.try_receive());
                expect_true(b.is_empty());
            };

            // ---- rendezvous
            test("a rendezvous channel is the default, and has nothing to give or take without the other side") {
                r := new channel<int>();
                expect(r.get_capacity()).named("default capacity").should_be(channels.RENDEZVOUS);
                expect_false(r.try_send(1));
                expect_null(r.try_receive());
            };

            test("rendezvous: the elements of one sender arrive in order, and it finished after its last one was taken") {
                r := new channel<int>();
                got := new decimal[5];
                producer : job? = null;
                run_blocking({ ->
                    l := new link();
                    l.output = r;
                    l.count = 5;
                    l.first = 10;
                    p := launch(l, { s: object -> send_range(s as link); });
                    producer = p;
                    for(i : decimal = 0; i < 5; i++) { got[i] = r.receive().value; }
                    p.join();
                });
                expect(got[0]).named("rendezvous 1").should_be(10);
                expect(got[1]).named("rendezvous 2").should_be(11);
                expect(got[2]).named("rendezvous 3").should_be(12);
                expect(got[3]).named("rendezvous 4").should_be(13);
                expect(got[4]).named("rendezvous 5").should_be(14);
                expect_true(producer!!.is_completed());
            };

            // a sender that waits does not finish before a receiver comes
            test("a rendezvous sender waits until try_receive takes its element") {
                r := new channel<int>();
                still_waiting : decimal = 0;
                taken : decimal = 0;
                sender : job? = null;
                run_blocking({ ->
                    l := new link();
                    l.output = r;
                    l.count = 1;
                    l.first = 77;
                    s := launch(l, { st: object -> send_range(st as link); });
                    sender = s;
                    yield();
                    yield();
                    if(s.is_active()) { still_waiting = 1; }
                    taken = r.try_receive()!!.value;
                    s.join();
                });
                expect(still_waiting).named("rendezvous sender is still waiting").should_be(1);
                expect(taken).named("try_receive takes from a waiting sender").should_be(77);
                expect_true(sender!!.is_completed());
            };

            // ---- unlimited
            test("an unlimited channel takes 1000 elements without waiting, and gives them all back") {
                u := new channel<int>(channels.UNLIMITED);
                sent : decimal = 0;
                for(i : decimal = 0; i < 1000; i++) {
                    if(u.try_send(i)) { sent++; }
                }
                expect(sent).named("taken without waiting").should_be(1000);
                expect(u.size()).named("unlimited size").should_be(1000);
                sum : decimal = 0;
                for(i : decimal = 0; i < 1000; i++) { sum += u.receive().value; }
                expect(sum).named("unlimited sum").should_be(499500);
            };

            // ---- conflated
            test("a conflated channel keeps one element, the newest") {
                c := new channel<int>(channels.CONFLATED);
                c.send(1);
                c.send(2);
                c.send(3);
                expect(c.size()).named("elements kept").should_be(1);
                expect(c.receive().value).named("the one kept").should_be(3);
                expect_null(c.try_receive());
            };

            test("negative capacity refused") {
                expect_throws<illegal_argument_exception>() { bad := new channel<int>(0 - 7); };
            };
        };

        tests("close") {
            test("a closed channel is closed for send, not yet for receive while elements remain, and refuses new elements") {
                ch := new channel<int>(4);
                ch.send(1);
                ch.send(2);
                expect_false(ch.is_closed_for_send());
                ch.close();
                expect_true(ch.is_closed_for_send());
                expect_false(ch.is_closed_for_receive());
                expect_false(ch.try_send(3));
                expect_throws<closed_channel_exception>() { ch.send(3); };
            };

            test("the elements sent before close arrive, then the channel is closed for receive") {
                ch := new channel<int>(4);
                ch.send(1);
                ch.send(2);
                ch.close();
                expect(ch.receive().value).named("element sent before close (1)").should_be(1);
                expect(ch.receive_or_null()!!.value).named("element sent before close (2)").should_be(2);
                expect_true(ch.is_closed_for_receive());
                expect_null(ch.receive_or_null());
                expect_throws<closed_channel_exception>() { ch.receive(); };
            };

            test("close twice is harmless") {
                ch := new channel<int>(4);
                ch.close();
                ch.close();
            };

            // close wakes receivers that are waiting
            test("close woke both waiting receivers") {
                closed_seen.write(0);
                quiet := new channel<int>();
                run_blocking({ ->
                    a := launch(quiet, { s: object ->
                        c := s as channel<int>;
                        try { c.receive(); never_reached.increment(); } catch(e: closed_channel_exception) { closed_seen.increment(); }
                    });
                    b := launch(quiet, { s: object ->
                        c := s as channel<int>;
                        if(c.receive_or_null() == null) { closed_seen.add(10); }
                    });
                    yield();
                    yield();
                    quiet.close();
                    a.join();
                    b.join();
                });
                expect(closed_seen.read()).should_be(11);
            };

            // a sender that is waiting when close() is called still delivers
            test("the element of a sender waiting at close survives, then the channel is finished") {
                late := new channel<int>();
                got : decimal = 0;
                finished : decimal = 0;
                run_blocking({ ->
                    l := new link();
                    l.output = late;
                    l.count = 1;
                    l.first = 5;
                    sender := launch(l, { s: object -> send_range(s as link); });
                    yield();
                    yield();
                    late.close();
                    got = late.receive().value;
                    if(late.receive_or_null() == null) { finished = 1; }
                    sender.join();
                });
                expect(got).named("element of a waiting sender survives close").should_be(5);
                expect(finished).named("then the channel is finished").should_be(1);
            };

            // cancel throws the buffer away and fails waiting senders
            test("cancel fails the waiting sender, discards the buffer and closes the channel for receive") {
                gone := new channel<int>(1);
                gone.send(1);
                closed_seen.write(0);
                run_blocking({ ->
                    blocked := launch(gone, { s: object ->
                        c := s as channel<int>;
                        try { c.send(2); never_reached.increment(); } catch(e: closed_channel_exception) { closed_seen.increment(); }
                    });
                    yield();
                    yield();
                    gone.cancel();
                    blocked.join();
                });
                expect(closed_seen.read()).named("cancel failed the waiting sender").should_be(1);
                expect_true(gone.is_cancelled());
                expect_null(gone.receive_or_null());
                expect_true(gone.is_closed_for_receive());
            };
        };

        tests("cancellation") {
            before_each { never_reached.write(0); };

            // a receiver that is cancelled while it waits
            test("a waiting receiver was cancelled, and the channel offers nothing to it") {
                ch := new channel<int>();
                receiver := launch(ch, { s: object -> c := s as channel<int>; c.receive(); never_reached.increment(); });
                delay(5);
                receiver.cancel_and_join();
                expect_true(receiver.is_cancelled());
                expect_false(ch.try_send(1));
                expect(never_reached.read()).named("cancelled waits that continued").should_be(0);
            };

            // a sender that is cancelled while it waits takes its element back
            test("a waiting sender was cancelled, and its element is gone") {
                ch := new channel<int>();
                sender := launch(ch, { s: object -> c := s as channel<int>; c.send(9); never_reached.increment(); });
                delay(5);
                sender.cancel_and_join();
                expect_true(sender.is_cancelled());
                expect_null(ch.try_receive());
                expect(never_reached.read()).named("cancelled waits that continued").should_be(0);
            };

            test("the channel still works after cancelled waits") {
                ch := new channel<int>();
                receiver := launch(ch, { s: object -> c := s as channel<int>; c.receive(); never_reached.increment(); });
                delay(5);
                receiver.cancel_and_join();
                sender := launch(ch, { s: object -> c := s as channel<int>; c.send(9); never_reached.increment(); });
                delay(5);
                sender.cancel_and_join();

                first : decimal = 0;
                second : decimal = 0;
                run_blocking({ ->
                    l := new link();
                    l.output = ch;
                    l.count = 2;
                    l.first = 40;
                    p := launch(l, { s: object -> send_range(s as link); });
                    first = ch.receive().value;
                    second = ch.receive().value;
                    p.join();
                });
                expect(first).named("channel works after cancelled waits (1)").should_be(40);
                expect(second).named("channel works after cancelled waits (2)").should_be(41);
            };

            // send and receive check for cancellation on entry
            test("a coroutine that never waits is cancelled at a channel operation") {
                full := new channel<int>(channels.UNLIMITED);
                busy := launch(full, { s: object ->
                    c := s as channel<int>;
                    for( ;; ) { c.send(1); c.receive(); }
                    never_reached.increment();
                });
                delay(5);
                busy.cancel_and_join();
                expect_true(busy.is_cancelled());
                expect(never_reached.read()).named("cancelled waits that continued").should_be(0);
            };

            // with_timeout around a receive that never gets anything
            test("a receive under a time limit gives null, and leaves no stale receiver behind") {
                ch := new channel<int>();
                r := with_timeout_or_null(20, { -> (object) return ch.receive(); });
                expect_null(r);
                expect_false(ch.try_send(3));
            };
        };

        tests("iteration") {
            test("for_each visited every element") {
                ch := new channel<int>(channels.UNLIMITED);
                for(i : decimal = 1; i <= 10; i++) { ch.send(i); }
                ch.close();
                total := new flag();
                ch.for_each({ n: int -> total.value = total.value + n.value; });
                expect(total.value).should_be(55);
            };

            test("to_list gives every element in order") {
                other := new channel<int>(channels.UNLIMITED);
                for(i : decimal = 1; i <= 4; i++) { other.send(i * i); }
                other.close();
                items := other.to_list();
                expect(items.size()).named("to_list size").should_be(4);
                expect(items.at(0).value).named("to_list first").should_be(1);
                expect(items.at(3).value).named("to_list last").should_be(16);
            };

            // for_each waits for elements that come later
            test("for_each over a live channel") {
                live := new channel<int>();
                count := new flag();
                run_blocking({ ->
                    l := new link();
                    l.output = live;
                    l.count = 100;
                    p := launch(l, { s: object -> x := s as link; send_range(x); x.output!!.close(); });
                    live.for_each({ n: int -> count.value = count.value + 1; });
                    p.join();
                });
                expect(count.value).should_be(100);
            };

            // an exception of the action ends for_each
            test("for_each passed the exception of its action on, and the element after the failing one is still there") {
                broken := new channel<int>(channels.UNLIMITED);
                broken.send(1);
                broken.send(2);
                expect_throws<illegal_state_exception>() {
                    broken.for_each({ n: int -> throw new illegal_state_exception("stop"); });
                };
                expect(broken.receive().value).named("the element after the failing one").should_be(2);
            };
        };

        tests("produce") {
            test("produce sends its elements in order, and closes its channel at the end") {
                got := new decimal[5];
                at_end : decimal = 0;
                closed : decimal = 0;
                run_blocking({ ->
                    squares := produce<int>.start({ out: send_channel<int> ->
                        for(i : decimal = 1; i <= 5; i++) { out.send(i * i); }
                    });
                    for(i : decimal = 0; i < 5; i++) { got[i] = squares.receive().value; }
                    if(squares.receive_or_null() == null) { at_end = 1; }
                    if(squares.is_closed_for_receive()) { closed = 1; }
                });
                expect(got[0]).named("produce 1").should_be(1);
                expect(got[1]).named("produce 2").should_be(4);
                expect(got[2]).named("produce 3").should_be(9);
                expect(got[3]).named("produce 4").should_be(16);
                expect(got[4]).named("produce 5").should_be(25);
                expect(at_end).named("produce closes its channel at the end").should_be(1);
                expect(closed).named("produced channel is closed").should_be(1);
            };

            // with a buffer and a state object
            test("produce with state and buffer") {
                seed := new link();
                seed.first = 100;
                seed.count = 50;
                sum := new flag();
                run_blocking({ ->
                    source := produce<int>.start(8, seed, { out: send_channel<int>, s: object ->
                        l := s as link;
                        for(i : decimal = 0; i < l.count; i++) { out.send(l.first + i); }
                    });
                    source.for_each({ n: int -> sum.value = sum.value + n.value; });
                });
                expect(sum.value).should_be(6225);
            };

            // the consumer walks away: the producer ends and the scope can finish
            test("an endless producer ended when its consumer cancelled") {
                taken := new flag();
                run_blocking({ ->
                    endless := produce<int>.start({ out: send_channel<int> ->
                        for(i : decimal = 0; ; i++) { out.send(i); }
                    });
                    taken.value = endless.receive().value + endless.receive().value + endless.receive().value;
                    endless.cancel();
                });
                expect(taken.value).should_be(3);
            };

            // a producer that fails closes the channel and fails the scope
            test("a failing producer: the element sent before the failure arrived, and its exception reached the scope") {
                taken := new flag();
                message : string = "";
                try {
                    coroutine_scope({ ->
                        failing := produce<int>.start({ out: send_channel<int> ->
                            out.send(1);
                            throw new illegal_state_exception("producer failed");
                        });
                        failing.for_each({ n: int -> taken.value = 1000 + n.value; });
                    });
                    fail_test("the scope of a failing producer returned normally");
                } catch(e: illegal_state_exception) {
                    message = e.get_message();
                }
                expect(message).named("the producer's exception reached the scope").should_be("producer failed");
                expect(taken.value).named("the element sent before the failure arrived").should_be(1001);
            };
        };

        tests("pipelines") {
            before_each {
                received_total.write(0);
                received_count.write(0);
                out_of_order.write(0);
            };

            // ---- one producer, one consumer, 20,000 elements through a buffer of 64, on the pool
            test("20,000 elements arrived, in the order they were sent") {
                pipe := new channel<int>(channels.BUFFERED);
                l := new link();
                l.input = pipe;
                l.output = pipe;
                l.count = 20000;
                coroutine_scope({ ->
                    launch_on(dispatchers.default_pool(), l, { s: object -> drain_in_order(s as link); });
                    launch_on(dispatchers.default_pool(), l, { s: object -> x := s as link; send_range(x); x.output!!.close(); });
                });
                expect(received_count.read()).named("elements that arrived").should_be(20000);
                expect(out_of_order.read()).named("elements out of order").should_be(0);
            };

            // ---- 4 producers, 4 consumers, 5,000 elements each, rendezvous
            test("4x4: every element was received exactly once") {
                shared := new channel<int>();
                coroutine_scope({ ->
                    consumers := new job[4];
                    producers := new job[4];
                    for(i : decimal = 0; i < 4; i++) {
                        c := new link();
                        c.input = shared;
                        consumers[i] = launch_on(dispatchers.default_pool(), c, { s: object -> drain(s as link); });
                    }
                    for(i : decimal = 0; i < 4; i++) {
                        p := new link();
                        p.output = shared;
                        p.count = 5000;
                        p.first = 1;
                        producers[i] = launch_on(dispatchers.default_pool(), p, { s: object -> send_range(s as link); });
                    }
                    join_all(producers);
                    shared.close();
                    join_all(consumers);
                });
                expect(received_count.read()).named("count").should_be(20000);
                expect(received_total.read()).named("sum").should_be(50010000);
            };

            // ---- three stages: numbers -> doubled -> summed
            test("three stage pipeline") {
                first := new channel<int>(32);
                second := new channel<int>(32);
                gen := new link();
                gen.output = first;
                gen.count = 20000;
                gen.first = 1;
                mid := new link();
                mid.input = first;
                mid.output = second;
                last := new link();
                last.input = second;
                coroutine_scope({ ->
                    launch_on(dispatchers.default_pool(), last, { s: object -> drain(s as link); });
                    launch_on(dispatchers.default_pool(), mid, { s: object -> square_stage(s as link); });
                    launch_on(dispatchers.default_pool(), gen, { s: object -> x := s as link; send_range(x); x.output!!.close(); });
                });
                expect(received_count.read()).named("count").should_be(20000);
                expect(received_total.read()).named("sum").should_be(400020000);
            };

            // ---- ping pong on one thread
            test("2,000 round trips through two rendezvous channels") {
                ping := new channel<int>();
                pong := new channel<int>();
                echo := new link();
                echo.input = ping;
                echo.output = pong;
                rounds := new flag();
                run_blocking({ ->
                    launch(echo, { s: object ->
                        x := s as link;
                        for( ;; ) {
                            n := x.input!!.receive_or_null();
                            if(n == null) { break; }
                            x.output!!.send(n!!.value + 1);
                        }
                    });
                    value : decimal = 0;
                    for(i : decimal = 0; i < 2000; i++) {
                        ping.send(value);
                        value = pong.receive().value;
                    }
                    rounds.value = value;
                    ping.close();
                });
                expect(rounds.value).should_be(2000);
            };
        };
    };
}
