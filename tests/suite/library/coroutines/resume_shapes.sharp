mod suite.library.coroutines.resume_shapes;

import (
    std.testing,
    std.io.fiber,
    std.io.coroutines
)

/**
 * Coroutines that wait at a lock while the functions they are waiting in get
 * compiled by the JIT - in every shape the call stack can have - must go on
 * with the right locals, the right return values and the right exceptions.
 *
 * This is the wider companion of resume_after_compile.sharp
 * (read that one first: it explains the bug, fixed 2026-11-14 with
 * continues_in_machine_code in runtime/virtual_machine.cpp). The rule of
 * the VM is: a function is continued in the form it was in when it made its
 * call - interpreted stays interpreted until it returns, machine code gets
 * its machine frame back. Each shape below puts a different mix on the stack
 * of the waiting coroutine:
 *
 *   A  both_hot -> middle -> wait_here      both compiled BEFORE the call:
 *                                           two machine frames are rebuilt
 *   B  deep(6) -> ... -> deep(0) -> wait    seven frames of one function,
 *                                           compiled while they wait
 *   C  top                                  the function that holds the lock
 *                                           statement itself is compiled
 *                                           while it waits (it is on top of
 *                                           the stack: it may continue in
 *                                           machine code)
 *   D  looper -> wait_here, then a loop     after the wait the interpreter
 *                                           moves into compiled code at the
 *                                           bottom of a hot loop, and uses a
 *                                           local set before the wait
 *   E  catcher -> thrower -> wait, throw    an exception thrown after the
 *                                           wait travels through functions
 *                                           compiled meanwhile to a catch
 *   F  hot_caller -> late -> wait_here      hot_caller is machine code when
 *                                           it calls, late is interpreted and
 *                                           compiled while it waits: a machine
 *                                           frame BELOW an interpreted one
 *
 * How the timing is made certain: the test holds `guard` while it launches the
 * coroutines, sleeps so that each has reached the lock, and then calls every
 * function 25 times on its quick path (the JIT compiles a function at its
 * tenth call). Only then does it let go of the lock.
 *
 * EXPECTED: the test passes. With -nojit nothing is compiled and the
 * test passes trivially. A runtime from before the fix, built with the
 * address sanitizer, stops with a heap-buffer-overflow in main_vm_loop.
 *
 * (Everything the coroutines add up goes through record(), under a lock:
 * they finish on several worker threads at once.)
 */

/**
 * A count that is changed in place, through its setter. (A number object - `int` - is not
 * for that: its setter is private to it.)
 */
class running_count {
    value : _int64 = 0;
        set value -> { self->value = value; }
}

guard := new string("guard");
waited := new running_count();
sum_a := new running_count();
sum_b := new running_count();
sum_c := new running_count();
sum_d := new running_count();
sum_e := new running_count();
sum_f := new running_count();
caught := new running_count();

/** adds `amount` to a counter that several threads share */
def record(counter: running_count, amount: decimal) {
    lock(counter) {
        counter.value = counter.value + amount;
    }
}

/** blocks while the test holds `guard` */
def wait_here() {
    lock(guard) {
        waited.value = waited.value + 1;
    }
}

/** A (second frame), and the callee of both_hot */
def middle(n: decimal) : decimal {
    before : decimal = n * 3 + 1;
    if(n == 0) {
        wait_here();
        return before + 10;
    }
    return before;
}

/** A: compiled, together with middle, before any coroutine calls it */
def both_hot(n: decimal) : decimal {
    x : decimal = middle(n);
    return x + 100;
}

/** B: seven frames of the same function wait; each has its own local */
def deep(level: decimal, wait: decimal) : decimal {
    mine : decimal = level * 2;
    if(level == 0) {
        if(wait == 1) { wait_here(); }
        return 1;
    }
    return deep(level - 1, wait) + mine;
}

/** C: the lock statement is in the function that gets compiled */
def top(n: decimal) : decimal {
    before : decimal = n + 7;
    if(n == 0) {
        lock(guard) {
            waited.value = waited.value + 1;
        }
        return before * 2;
    }
    return before;
}

/** D: a hot loop after the wait */
def looper(n: decimal) : decimal {
    start : decimal = n + 5;
    if(n != 0) {
        return start;
    }
    wait_here();
    sum : decimal = 0;
    for(i : decimal = 0; i < 5000; i++) {
        sum = sum + i;
    }
    return sum + start;
}

/** E: throws once it has the lock */
def thrower(n: decimal) : decimal {
    if(n == 0) {
        wait_here();
        throw new exception("after the wait");
    }
    return 3;
}

/** E: catches what thrower throws; `marker` must have survived the wait */
def catcher(n: decimal) : decimal {
    marker : decimal = 40 + n;
    try {
        return thrower(n);
    } catch(e: exception) {
        record(caught, 1);
        return marker + 2;
    }
}

/** F: interpreted when the coroutines call it, compiled while they wait */
def late(n: decimal) : decimal {
    before : decimal = n + 20;
    if(n == 0) {
        wait_here();
        return before + 1;
    }
    return before;
}

/** F: compiled before the coroutines call it; it only calls late for n == 0 */
def hot_caller(n: decimal) : decimal {
    if(n == 0) {
        return late(0) + 1000;
    }
    return n;
}

def resume_shapes_tests() {
    tests("resume_shapes") {
        // one scenario: the six shapes wait at the same lock while their functions are compiled
        test("coroutines in every shape of call stack go on correctly after their functions were compiled") {
            waited.value = 0;
            sum_a.value = 0;
            sum_b.value = 0;
            sum_c.value = 0;
            sum_d.value = 0;
            sum_e.value = 0;
            sum_f.value = 0;
            caught.value = 0;

            // A and F: these are machine code before any coroutine exists
            for(i : decimal = 1; i <= 30; i++) {
                both_hot(i);
                hot_caller(i);
            }

            jobs := new list<job>();
            lock(guard) {
                for(i : decimal = 0; i < 4; i++) {
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_a, both_hot(0)); }));
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_b, deep(6, 1)); }));
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_c, top(0)); }));
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_d, looper(0)); }));
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_e, catcher(0)); }));
                    jobs.add(launch_on(dispatchers.default_pool(), { -> record(sum_f, hot_caller(0)); }));
                }

                // let every coroutine reach the lock and wait for it
                delay(300);

                // compile what they are waiting in
                for(i : decimal = 0; i < 25; i++) {
                    deep(6, 0);
                    top(1);
                    looper(1);
                    catcher(1);
                    late(1);
                }
            }

            foreach(j in jobs) {
                j.join();
            }

            expect(sum_a.value).named("A two machine frames").should_be(4 * 111);
            expect(sum_b.value).named("B seven frames of one function").should_be(4 * 43);
            expect(sum_c.value).named("C the function on top").should_be(4 * 14);
            expect(sum_d.value).named("D a hot loop after the wait").should_be(4 * 12497505);
            expect(sum_e.value).named("E an exception after the wait").should_be(4 * 42);
            expect(caught.value).named("E every exception was caught").should_be(4);
            expect(sum_f.value).named("F a machine frame below an interpreted one").should_be(4 * 1021);
            expect(waited.value).named("every coroutine got the lock").should_be(24);
        };
    };
}
