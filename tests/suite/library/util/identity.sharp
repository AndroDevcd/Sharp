mod suite.library.util.identity;

import ( std.testing, std.util )

/**
 * std.util - hashing (fnv1a, djb2, crc32, adler32, combine), uuid and
 * version (semantic versions).
 *
 * The expected hash values are the published test vectors of the
 * algorithms (e.g. crc32("123456789") == 0xCBF43926) or were computed with
 * an independent implementation.
 */

/* four bytes, including bytes above 127 (stored as negative _int8 values) */
def some_bytes() : _int8[] {
    data := new _int8[4];
    data[0] = (200) as _int8;
    data[1] = (255) as _int8;
    data[2] = 0;
    data[3] = (128) as _int8;
    return data;
}

def check_hashing() {
    tests("hashing") {
        test("fnv1a of nothing") { expect(hashing.fnv1a("")).should_be(2166136261); };
        test("fnv1a(a)") { expect(hashing.fnv1a("a")).should_be(3826002220); };                 // 0xE40C292C
        test("fnv1a(hello)") { expect(hashing.fnv1a("hello")).should_be(1335831723); };
        test("fnv1a(foobar)") { expect(hashing.fnv1a("foobar")).should_be(3214735720); };       // 0xBF9CF968
        test("fnv1a(123456789)") { expect(hashing.fnv1a("123456789")).should_be(3146166556); };
        test("fnv1a(pangram)") { expect(hashing.fnv1a("The quick brown fox jumps over the lazy dog")).should_be(76545936); };

        test("djb2 of nothing") { expect(hashing.djb2("")).should_be(5381); };
        test("djb2(a)") { expect(hashing.djb2("a")).should_be(177670); };                       // 5381 * 33 + 97
        test("djb2(hello)") { expect(hashing.djb2("hello")).should_be(261238937); };
        test("djb2(foobar)") { expect(hashing.djb2("foobar")).should_be(4259602622); };
        test("djb2(pangram)") { expect(hashing.djb2("The quick brown fox jumps over the lazy dog")).should_be(885799134); };

        test("crc32 of nothing") { expect(hashing.crc32("")).should_be(0); };
        test("crc32(a)") { expect(hashing.crc32("a")).should_be(3904355907); };                 // 0xE8B7BE43
        test("crc32(123456789)") { expect(hashing.crc32("123456789")).should_be(3421780262); }; // 0xCBF43926, the standard check value
        test("crc32(hello)") { expect(hashing.crc32("hello")).should_be(907060870); };
        test("crc32(pangram)") { expect(hashing.crc32("The quick brown fox jumps over the lazy dog")).should_be(1095738169); };   // 0x414FA339

        test("adler32 of nothing") { expect(hashing.adler32("")).should_be(1); };
        test("adler32(a)") { expect(hashing.adler32("a")).should_be(6422626); };                // 0x00620062
        test("adler32(Wikipedia)") { expect(hashing.adler32("Wikipedia")).should_be(300286872); };     // 0x11E60398
        test("adler32(123456789)") { expect(hashing.adler32("123456789")).should_be(152961502); };
        test("adler32(pangram)") { expect(hashing.adler32("The quick brown fox jumps over the lazy dog")).should_be(1541148634); };

        // byte arrays, including bytes above 127 (stored as negative _int8 values)
        test("fnv1a of bytes") { expect(hashing.fnv1a(some_bytes())).should_be(1494859608); };
        test("djb2 of bytes") { expect(hashing.djb2(some_bytes())).should_be(2093938828); };
        test("crc32 of bytes") { expect(hashing.crc32(some_bytes())).should_be(3248336440); };
        test("adler32 of bytes") { expect(hashing.adler32(some_bytes())).should_be(111215176); };
        test("fnv1a of no bytes") { expect(hashing.fnv1a(new _int8[0])).should_be(2166136261); };
        test("crc32 of no bytes") { expect(hashing.crc32(new _int8[0])).should_be(0); };
        test("adler32 of no bytes") { expect(hashing.adler32(new _int8[0])).should_be(1); };
        test("djb2 of no bytes") { expect(hashing.djb2(new _int8[0])).should_be(5381); };
        test("a text and its bytes hash the same") {
            text : string = "hello";
            expect(hashing.crc32(text.data!!)).should_be(907060870);
        };

        test("different texts, different hashes") { expect_true(hashing.fnv1a("abc") != hashing.fnv1a("acb")); };
        test("hashing is repeatable") { expect(hashing.fnv1a("repeat")).should_be(hashing.fnv1a("repeat")); };

        test("multiply small") { expect(hashing.multiply(6, 7)).should_be(42); };
        test("multiply wraps at 2^32") { expect(hashing.multiply(65537, 65537)).should_be(131073); };
        test("multiply large") { expect(hashing.multiply(4000000000, 3000000000)).should_be(3635412992); };
        test("multiply largest") { expect(hashing.multiply(4294967295, 4294967295)).should_be(1); };
        test("multiply by 0") { expect(hashing.multiply(4294967295, 0)).should_be(0); };

        test("combine") { expect(hashing.combine(17, 5)).should_be(532); };                     // 17 * 31 + 5
        test("combine twice") { expect(hashing.combine(hashing.combine(17, 5), 7)).should_be(16499); };
        test("combine wraps") { expect(hashing.combine(4294967295, 4294967295)).should_be(4294967264); };
        test("combine ignores the sign of the value") { expect(hashing.combine(17, 0 - 5)).should_be(532); };
        test("combine depends on the order") { expect_true(hashing.combine(hashing.combine(17, 1), 2) != hashing.combine(hashing.combine(17, 2), 1)); };
        test("combine_all") { expect(hashing.combine_all(new decimal[] { 1, 2, 3 })).should_be(507473); };
        test("combine_all of nothing") { expect(hashing.combine_all(new decimal[0])).should_be(17); };

        test("to_hex") { expect(hashing.to_hex(3421780262)).should_be("cbf43926"); };
        test("to_hex pads with zeros") { expect(hashing.to_hex(255)).should_be("000000ff"); };
        test("to_hex(0)") { expect(hashing.to_hex(0)).should_be("00000000"); };
        test("to_hex of the largest word") { expect(hashing.to_hex(4294967295)).should_be("ffffffff"); };
        test("to_hex of a crc") { expect(hashing.to_hex(hashing.crc32("The quick brown fox jumps over the lazy dog"))).should_be("414fa339"); };
        test("to_hex outside a word throws") {
            expect_throws<illegal_argument_exception>() { hashing.to_hex(0 - 1); };
            expect_throws<illegal_argument_exception>() { hashing.to_hex(4294967296); };
            expect_throws<illegal_argument_exception>() { hashing.to_hex(1.5); };
        };
    };
}

def check_uuid() {
    tests("uuid") {
        id : uuid;
        same : uuid;
        later : uuid;
        before_each {
            id = uuid.parse("123e4567-e89b-42d3-a456-426614174000");
            same = uuid.parse("123E4567-E89B-42D3-A456-426614174000");
            later = uuid.parse("123e4567-e89b-42d3-a456-426614174001");
        };

        test("parse and to_string") { expect(id.to_string()!!).should_be("123e4567-e89b-42d3-a456-426614174000"); };
        test("version_number") { expect(id.version_number()).should_be(4); };
        test("variant") { expect(id.variant()).should_be(2); };
        test("is_nil") { expect_false(id.is_nil()); };
        test("capital letters are accepted and printed small") { expect(uuid.parse("ABCDEF01-2345-6789-ABCD-EF0123456789").to_string()!!).should_be("abcdef01-2345-6789-abcd-ef0123456789"); };
        test("version 1 is recognised") { expect(uuid.parse("c232ab00-9414-11ec-b3c8-9f6bdeced846").version_number()).should_be(1); };
        test("the old NCS variant") { expect(uuid.parse("00000000-0000-0000-7000-000000000000").variant()).should_be(0); };
        test("the Microsoft variant") { expect(uuid.parse("00000000-0000-0000-c000-000000000000").variant()).should_be(6); };
        test("the reserved variant") { expect(uuid.parse("00000000-0000-0000-e000-000000000000").variant()).should_be(7); };

        test("the nil uuid") {
            zero := uuid.nil_uuid();
            expect(zero.to_string()!!).named("nil").should_be("00000000-0000-0000-0000-000000000000");
            expect_true(zero.is_nil());
            expect(zero.version_number()).named("nil has version 0").should_be(0);
        };

        test("to_bytes") {
            bytes := id.to_bytes();
            expect(sizeof(bytes)).named("to_bytes size").should_be(16);
            expect(bytes[0]).named("to_bytes first").should_be(18);          // 0x12
            expect(bytes[3]).named("to_bytes byte 3").should_be(103);        // 0x67
            expect(bytes[15]).named("to_bytes last").should_be(0);
        };
        test("to_bytes is a copy") {
            bytes := id.to_bytes();
            bytes[0] = 255;
            expect(id.to_string()!!).should_be("123e4567-e89b-42d3-a456-426614174000");
        };
        test("from_bytes") {
            rebuilt := uuid.from_bytes(id.to_bytes());
            expect_true((rebuilt == id));
        };
        test("from_bytes text") {
            counting := new decimal[16];
            for(i : decimal = 0; i < 16; i++) { counting[i] = i * 17; }
            expect(uuid.from_bytes(counting).to_string()!!).should_be("00112233-4455-6677-8899-aabbccddeeff");
        };

        test("==") { expect_true((id == same)); };
        test("== different") { expect_false((id == later)); };
        test("!=") { expect_true((id != later)); };
        test("compare_to smaller") { expect(id.compare_to(later)).should_be(0 - 1); };
        test("compare_to larger") { expect(later.compare_to(id)).should_be(1); };
        test("compare_to equal") { expect(id.compare_to(same)).should_be(0); };
        test("<") { expect_true((id < later)); };
        test(">") { expect_true((later > id)); };
        test("the first byte decides") { expect_true((uuid.parse("10000000-0000-0000-0000-000000000000") > uuid.parse("0fffffff-ffff-ffff-ffff-ffffffffffff"))); };
        test("equal uuids have equal hashes") { expect_true((id.hash() == same.hash())); };

        test("is_valid") { expect_true(uuid.is_valid("123e4567-e89b-42d3-a456-426614174000")); };
        test("is_valid: too short") { expect_false(uuid.is_valid("123e4567-e89b-42d3-a456-42661417400")); };
        test("is_valid: no dashes") { expect_false(uuid.is_valid("123e4567e89b42d3a456426614174000xxxx")); };
        test("is_valid: a dash in the wrong place") { expect_false(uuid.is_valid("123e45678-e89-42d3-a456-426614174000")); };
        test("is_valid: not hexadecimal") { expect_false(uuid.is_valid("123e4567-e89b-42d3-a456-42661417400g")); };
        test("is_valid: empty") { expect_false(uuid.is_valid("")); };
        test("parse_or_null of bad text") { expect_null(uuid.parse_or_null("nope")); };
        test("parse_or_null of good text") { expect_not_null(uuid.parse_or_null("123e4567-e89b-42d3-a456-426614174000")); };
        test("bad text throws parse_exception") {
            expect_throws<parse_exception>() { uuid.parse("nope"); };
            expect_throws<parse_exception>() { uuid.parse("123e4567-e89b-42d3-a456_426614174000"); };
            expect_throws<parse_exception>() { uuid.parse("z23e4567-e89b-42d3-a456-426614174000"); };
        };
        test("bad bytes throw") {
            expect_throws<illegal_argument_exception>() { uuid.from_bytes(new decimal[15]); };
            wrong := new decimal[16];
            wrong[5] = 256;
            expect_throws<illegal_argument_exception>() { uuid.from_bytes(wrong); };
        };

        // random uuids from a seeded generator are an exact, reproducible sequence
        test("seeded uuids, seed 1") {
            rng := new seeded_random(1);
            expect(uuid.random(rng).to_string()!!).named("seeded uuid 1").should_be("00049d12-8e2c-4519-b7ad-9e59b40405c9");
            expect(uuid.random(rng).to_string()!!).named("seeded uuid 2").should_be("35c613ff-8ee3-42d9-825d-91133da503cb");
        };
        test("seeded uuids after seeding the generator again with 42") {
            rng := new seeded_random(1);
            uuid.random(rng);
            uuid.random(rng);
            rng.seed(42);
            expect(uuid.random(rng).to_string()!!).named("seeded uuid, seed 42").should_be("00a91cd9-e055-4d90-b93f-b2c9b6427440");
            expect(uuid.random(rng).to_string()!!).named("seeded uuid 2, seed 42").should_be("2002cfa1-c090-4f92-b615-c18390452656");
        };

        // random uuids from the runtime's generator: only what always holds
        test("50 random uuids are well formed version 4 ids") {
            well_formed : decimal = 1;
            for(i : decimal = 0; i < 50; i++) {
                made := uuid.random();
                text := made.to_string()!!;
                if(made.version_number() != 4 || made.variant() != 2) well_formed = 0;
                if(text.size() != 36 || text.at(14).value != '4') well_formed = 0;
                if(!uuid.is_valid(text)) well_formed = 0;
                if((uuid.parse(text) != made)) well_formed = 0;
            }
            expect_true(well_formed);
        };
    };
}

def v(text: string): version {
    return version.parse(text);
}

/* -1, 0 or 1 for a pair of version texts */
def order(a: string, b: string): decimal {
    return v(a).compare_to(v(b));
}

def check_version() {
    tests("version") {
        plain : version;
        full : version;
        a : version;
        b : version;
        before_each {
            plain = v("1.4.2");
            full = v("2.0.0-rc.1+build.42");
            a = v("1.2.3");
            b = v("1.3.0");
        };

        test("major") { expect(plain.major).should_be(1); };
        test("minor") { expect(plain.minor).should_be(4); };
        test("patch") { expect(plain.patch).should_be(2); };
        test("no pre-release") { expect(plain.pre_release).should_be(""); };
        test("no build") { expect(plain.build).should_be(""); };
        test("to_string") { expect(plain.to_string()!!).should_be("1.4.2"); };
        test("is_pre_release") { expect_false(plain.is_pre_release()); };
        test("is_stable") { expect_true(plain.is_stable()); };

        test("full: major") { expect(full.major).should_be(2); };
        test("full: pre_release") { expect(full.pre_release).should_be("rc.1"); };
        test("full: build") { expect(full.build).should_be("build.42"); };
        test("full: to_string") { expect(full.to_string()!!).should_be("2.0.0-rc.1+build.42"); };
        test("full: is_pre_release") { expect_true(full.is_pre_release()); };
        test("full: is_stable") { expect_false(full.is_stable()); };
        test("0.x is not stable") { expect_false(v("0.9.5").is_stable()); };
        test("build without pre-release") { expect(v("1.0.0+exp.sha.5114f85").build).should_be("exp.sha.5114f85"); };
        test("build without pre-release has no pre-release") { expect(v("1.0.0+exp.sha.5114f85").pre_release).should_be(""); };
        test("a dash inside an identifier") { expect(v("1.0.0-x-y.z--").pre_release).should_be("x-y.z--"); };
        test("large numbers") { expect(v("10.200.3000").patch).should_be(3000); };
        test("zeros") { expect(v("0.0.0").to_string()!!).should_be("0.0.0"); };

        test("constructor") {
            built := new version(3, 1, 4);
            expect(built.to_string()!!).should_be("3.1.4");
        };
        test("constructor with a pre-release") { expect(new version(1, 0, 0, "alpha.1").to_string()!!).should_be("1.0.0-alpha.1"); };
        test("constructor with an empty pre-release") { expect(new version(1, 0, 0, "").to_string()!!).should_be("1.0.0"); };

        // ---- precedence: the example chain from the specification
        test("1.0.0-alpha < 1.0.0-alpha.1") { expect(order("1.0.0-alpha", "1.0.0-alpha.1")).should_be(0 - 1); };
        test("1.0.0-alpha.1 < 1.0.0-alpha.beta") { expect(order("1.0.0-alpha.1", "1.0.0-alpha.beta")).should_be(0 - 1); };
        test("1.0.0-alpha.beta < 1.0.0-beta") { expect(order("1.0.0-alpha.beta", "1.0.0-beta")).should_be(0 - 1); };
        test("1.0.0-beta < 1.0.0-beta.2") { expect(order("1.0.0-beta", "1.0.0-beta.2")).should_be(0 - 1); };
        test("1.0.0-beta.2 < 1.0.0-beta.11") { expect(order("1.0.0-beta.2", "1.0.0-beta.11")).should_be(0 - 1); };
        test("1.0.0-beta.11 < 1.0.0-rc.1") { expect(order("1.0.0-beta.11", "1.0.0-rc.1")).should_be(0 - 1); };
        test("1.0.0-rc.1 < 1.0.0") { expect(order("1.0.0-rc.1", "1.0.0")).should_be(0 - 1); };
        test("1.0.0 > 1.0.0-rc.1") { expect(order("1.0.0", "1.0.0-rc.1")).should_be(1); };

        test("numbers, not text: 1.9.0 < 1.10.0") { expect(order("1.9.0", "1.10.0")).should_be(0 - 1); };
        test("major decides first") { expect(order("2.0.0", "1.99.99")).should_be(1); };
        test("minor decides second") { expect(order("1.2.9", "1.3.0")).should_be(0 - 1); };
        test("patch decides third") { expect(order("1.2.4", "1.2.3")).should_be(1); };
        test("equal") { expect(order("1.2.3", "1.2.3")).should_be(0); };
        test("the build part is ignored") { expect(order("1.0.0+a", "1.0.0+b")).should_be(0); };
        test("the build part is ignored with a pre-release") { expect(order("1.0.0-rc.1+x", "1.0.0-rc.1")).should_be(0); };
        test("equal pre-releases") { expect(order("1.0.0-rc.1", "1.0.0-rc.1")).should_be(0); };
        test("a number comes before a word") { expect(order("1.0.0-1", "1.0.0-a")).should_be(0 - 1); };
        test("numeric identifiers of equal length") { expect(order("1.0.0-rc.12", "1.0.0-rc.13")).should_be(0 - 1); };
        test("words by character code") { expect(order("1.0.0-Beta", "1.0.0-alpha")).should_be(0 - 1); };
        test("a longer word is not a number") { expect(order("1.0.0-rc1", "1.0.0-rc.1")).should_be(1); };

        test("<") { expect_true((a < b)); };
        test("< reversed") { expect_false((b < a)); };
        test(">") { expect_true((b > a)); };
        test("<=") { expect_true((a <= v("1.2.3"))); };
        test(">=") { expect_true((b >= a)); };
        test("==") { expect_true((a == v("1.2.3+meta"))); };
        test("!=") { expect_true((a != b)); };
        test("equal versions have equal hashes") { expect_true((a.hash() == v("1.2.3+meta").hash())); };

        test("next_major") { expect(a.next_major().to_string()!!).should_be("2.0.0"); };
        test("next_minor") { expect(a.next_minor().to_string()!!).should_be("1.3.0"); };
        test("next_patch") { expect(a.next_patch().to_string()!!).should_be("1.2.4"); };
        test("next_patch drops the pre-release") { expect(full.next_patch().to_string()!!).should_be("2.0.1"); };
        test("release") { expect(full.release().to_string()!!).should_be("2.0.0"); };
        test("the original is unchanged") {
            a.next_major();
            a.next_minor();
            a.next_patch();
            expect(a.to_string()!!).should_be("1.2.3");
        };

        test("compatible: same major, newer") { expect_true(v("1.4.0").is_compatible_with(v("1.2.3"))); };
        test("compatible: the same version") { expect_true(v("1.2.3").is_compatible_with(v("1.2.3"))); };
        test("not compatible: older") { expect_false(v("1.2.2").is_compatible_with(v("1.2.3"))); };
        test("not compatible: another major") { expect_false(v("2.0.0").is_compatible_with(v("1.2.3"))); };
        test("0.x: the same minor") { expect_true(v("0.3.5").is_compatible_with(v("0.3.1"))); };
        test("0.x: another minor") { expect_false(v("0.4.0").is_compatible_with(v("0.3.1"))); };

        test("is_valid") { expect_true(version.is_valid("1.2.3-beta+build")); };
        test("parse_or_null of bad text") { expect_null(version.parse_or_null("1.2")); };
        test("parse_or_null of good text") { expect_not_null(version.parse_or_null("1.2.3")); };
        test("14 malformed versions are rejected") {
            bad := new string[14];
            bad[0] = new string("");
            bad[1] = new string("1.2");
            bad[2] = new string("1.2.3.4");
            bad[3] = new string("01.2.3");
            bad[4] = new string("1.2.x");
            bad[5] = new string("1.2.3-");
            bad[6] = new string("1.2.3-a..b");
            bad[7] = new string("v1.2.3");
            bad[8] = new string("1.2.3+");
            bad[9] = new string("1.2.3-01");
            bad[10] = new string("1..3");
            bad[11] = new string("1.2.3-beta!");
            bad[12] = new string("1.2.3 ");
            bad[13] = new string("-1.2.3");
            rejected : decimal = 0;
            for(i : decimal = 0; i < 14; i++) {
                if(!version.is_valid(bad[i])) {
                    rejected++;
                } else {
                    fail_test("accepted: " + bad[i]);
                }
            }
            expect(rejected).should_be(14);
        };
        test("a leading zero is fine in a word") { expect_true(version.is_valid("1.2.3-0a")); };
        test("a leading zero is fine in the build part") { expect_true(version.is_valid("1.2.3+001")); };
        test("a single zero is a valid number") { expect_true(version.is_valid("1.2.3-0")); };

        test("parse_exception") {
            expect_throws<parse_exception>() { version.parse("1.2"); };
            expect_throws<parse_exception>() { new version(1, 0, 0, "a..b"); };
        };
        test("bad numbers throw illegal_argument_exception") {
            expect_throws<illegal_argument_exception>() { new version(0 - 1, 0, 0); };
            expect_throws<illegal_argument_exception>() { new version(1, 2.5, 0); };
        };
    };
}

def identity_tests() {
    tests("identity") {
        check_hashing();
        check_uuid();
        check_version();
    };
}
