mod suite.control.foreach_over_new;

import ( std.testing )

/**
 * THE BUG THIS GUARDS (compiler, fixed): `foreach` over a `new` expression
 * did not compile; it stopped the code generator with "fatal error:
 * attempting to consume empty machine data!".
 * Workaround that was needed: assign the object to a local variable and loop
 * over that.
 */

class three_numbers : loopable<decimal> {
    override def get_elements() : decimal[]? {
        numbers := new decimal[3];
        numbers[0] = 1; numbers[1] = 2; numbers[2] = 3;
        return numbers;
    }
}

def foreach_over_new_tests() {
    tests("foreach_over_new") {
        test("foreach over a new expression") {
            total : decimal = 0;
            foreach(n in new three_numbers()) {
                total += n;
            }
            expect(total).should_be(6);
        };
    };
}
