mod suite.classes.interfaces_base_calls;
import ( std.testing )
interface named {
    def name(): string;
}
class rectangle : named {
    override def name(): string { return "rectangle"; }
    def describe(): string { return "a " + name(); }
}
class labelled_rectangle base rectangle {
    override def name(): string { return "label of " + base->name(); }
}
class deep_rectangle base labelled_rectangle {
    override def name(): string { return "deep " + base->name(); }
}
def interfaces_base_calls_tests() {
    tests("interfaces_base_calls") {
        test("base call inside the override") {
            r : rectangle = new labelled_rectangle();
            expect(r.name()).should_be("label of rectangle");
        };
        test("inherited method sees the override") {
            r : rectangle = new labelled_rectangle();
            expect(r.describe()).should_be("a label of rectangle");
        };
        test("two levels") {
            d : rectangle = new deep_rectangle();
            expect(d.name()).should_be("deep label of rectangle");
        };
        test("through the middle class") {
            l : labelled_rectangle = new deep_rectangle();
            expect(l.describe()).should_be("a deep label of rectangle");
        };
        test("the base object itself") { expect(new rectangle().describe()).should_be("a rectangle"); };
    };
}
