mod suite.classes.static_members;

import ( std.testing )

/**
 * Static members and globals: a static field exists once for the class (not
 * once per object), a static method is called on the class and has no `self`,
 * and a variable or function written outside every class is global to the
 * module.
 */

/* every ticket takes the next number from the one counter the class has */
class ticket {
    static next_number : decimal = 1;
    static issued : decimal = 0;

    number : decimal = 0;

    ticket() {
        number = next_number;
        next_number++;
        issued++;
    }

    static def start_again() {
        next_number = 1;
        issued = 0;
    }

    static def upcoming(): decimal {
        return next_number;
    }

    /* an ordinary method reading a static field */
    def is_newest(): decimal {
        return number == next_number - 1;
    }

    /* an ordinary method writing a static field */
    def skip_ahead(by: decimal) {
        next_number += by;
    }
}

/* a class used only as a place to keep functions */
class calc {
    static def square(x: decimal): decimal {
        return x * x;
    }

    static def largest(a: decimal, b: decimal): decimal {
        if(a > b) {
            return a;
        }
        return b;
    }

    static def total(numbers: decimal[]): decimal {
        sum : decimal = 0;
        for(i : decimal = 0; i < sizeof(numbers); i++) {
            sum += numbers[i];
        }
        return sum;
    }

    /* a static method calling other static methods of its class */
    static def largest_square(a: decimal, b: decimal): decimal {
        return largest(square(a), square(b));
    }

    /* overloads */
    static def describe(a: decimal): decimal { return 1; }
    static def describe(a: decimal, b: decimal): decimal { return 2; }
    static def describe(s: string): decimal { return 3; }

    /* recursion */
    static def factorial(n: decimal): decimal {
        if(n <= 1) {
            return 1;
        }
        return n * factorial(n - 1);
    }
}

/* static fields of several types, each with an initial value */
class settings {
    static level : decimal = 3;
    static ratio : decimal = 0.75;
    static negative : decimal = 0 - 40;
    static from_expression : decimal = 6 * 7;
    static title : string = "untitled";
    static sizes : decimal[] = new decimal[] { 10, 20, 30 };
    static not_set : decimal;
    static no_object : settings?;
}

class point {
    x : decimal = 0;
    y : decimal = 0;

    /* static fields holding objects of the class itself */
    static made : decimal = 0;
    static last_made : point?;

    point(px: decimal, py: decimal) {
        x = px;
        y = py;
        made++;
        last_made = self;
    }

    /* static methods that build objects */
    static def origin(): point {
        return new point(0, 0);
    }

    static def diagonal(n: decimal): point {
        return new point(n, n);
    }

    /* a static method working on objects it is given */
    static def distance_squared(a: point, b: point): decimal {
        dx : decimal = a.x - b.x;
        dy : decimal = a.y - b.y;
        return dx * dx + dy * dy;
    }
}

/* one shared object, made the first time it is asked for */
class shared_log {
    static instance : shared_log?;
    static times_created : decimal = 0;

    lines : decimal = 0;

    shared_log() {
        times_created++;
    }

    static def the_one(): shared_log {
        if(instance == null) {
            instance = new shared_log();
        }
        return instance!!;
    }
}

/* two classes with a static field of the same name do not share it */
class left_side {
    static count : decimal = 100;
    static def bump(): decimal {
        count++;
        return count;
    }
}

class right_side {
    static count : decimal = 200;
    static def bump(): decimal {
        count += 10;
        return count;
    }
}

// ---- globals: variables and functions outside every class
global_number : decimal = 5;
global_fraction : decimal = 1.5;
global_from_expression : decimal = 3 * 4 + 1;
global_text : string = "global";
global_numbers : decimal[] = new decimal[] { 7, 8, 9 };
global_object : point = new point(11, 22);
global_not_set : decimal;
global_nothing : point?;
global_boxed := 9;                  // an int object, like a local declared with :=

def add_to_global(amount: decimal) {
    global_number += amount;
}

def read_global(): decimal {
    return global_number;
}

def append_to_global_text(more: string) {
    global_text = global_text + more;
}

def set_global_number_at(index: decimal, value: decimal) {
    global_numbers[index] = value;
}

def next_id(): decimal {
    id_counter++;
    return id_counter;
}

id_counter : decimal = 1000;            // declared after the function that uses it

def static_members_tests() {
    tests("static_members") {
        // Static fields and globals live as long as the program. The tests that change them
        // are in groups whose after_each puts back the initial values, so the tests that read
        // the initial values pass whatever ran before them.

        // ---- static fields have their initial value before any object exists
        test("static number") { expect(settings.level).should_be(3); };
        test("static fraction") { expect(settings.ratio).should_be(0.75); };
        test("static negative number") { expect(settings.negative).should_be(0 - 40); };
        test("static set from an expression") { expect(settings.from_expression).should_be(42); };
        test("static string") { expect(settings.title).should_be("untitled"); };
        test("static array: its length") { expect(sizeof(settings.sizes)).should_be(3); };
        test("static array: an element") { expect(settings.sizes[1]).should_be(20); };
        test("static without a value starts at 0") { expect(settings.not_set).should_be(0); };
        test("static object without a value starts as null") { expect_null(settings.no_object); };

        // ---- static fields can be written through the class name
        tests("writing") {
            after_each {
                settings.level = 3;
                settings.ratio = 0.75;
                settings.title = "untitled";
                settings.sizes[1] = 20;
                settings.not_set = 0;
                settings.no_object = null;
            };

            test("write a static number") {
                settings.level = 9;
                expect(settings.level).should_be(9);
            };
            test("+= on a static") {
                settings.ratio += 0.25;
                expect(settings.ratio).should_be(1);
            };
            test("write a static string") {
                settings.title = "named";
                expect(settings.title).should_be("named");
            };
            test("write an element of a static array, the other elements stay") {
                settings.sizes[1] = 25;
                expect(settings.sizes[1]).named("the element written").should_be(25);
                expect(settings.sizes[2]).named("the next element").should_be(30);
            };
            test("++ on a static") {
                settings.not_set++;
                expect(settings.not_set).should_be(1);
            };
            test("write a static object") {
                settings.no_object = new settings();
                expect_not_null(settings.no_object);
            };
        };

        // ---- static methods
        test("a static method") { expect(calc.square(9)).should_be(81); };
        test("a static method with two parameters") { expect(calc.largest(3, 8)).should_be(8); };
        test("...the other way round") { expect(calc.largest(8, 3)).should_be(8); };
        test("a static method taking an array") { expect(calc.total(new decimal[] { 1, 2, 3, 4, 5 })).should_be(15); };
        test("a static method calling static methods") { expect(calc.largest_square(0 - 5, 4)).should_be(25); };
        test("static overload with one number") {
            one : decimal = 1;
            expect(calc.describe(one)).should_be(1);
        };
        test("static overload with two numbers") {
            one : decimal = 1;
            expect(calc.describe(one, one)).should_be(2);
        };
        test("static overload with a string") { expect(calc.describe("text")).should_be(3); };
        test("a recursive static method") { expect(calc.factorial(6)).should_be(720); };
        test("static calls inside an expression") { expect(calc.square(3) + calc.square(4)).should_be(25); };
        test("a static call as an argument of another") { expect(calc.square(calc.largest(2, 3))).should_be(9); };

        // ---- one static field shared by every object
        tests("one_shared_field") {
            after_each {
                ticket.next_number = 1;
                ticket.issued = 0;
            };

            test("before any ticket") {
                expect(ticket.issued).named("issued").should_be(0);
                expect(ticket.upcoming()).named("the first number waiting").should_be(1);
            };
            test("every ticket takes the next number, and the class counts them") {
                t1 := new ticket();
                t2 := new ticket();
                t3 := new ticket();
                expect(t1.number).named("first ticket").should_be(1);
                expect(t2.number).named("second ticket").should_be(2);
                expect(t3.number).named("third ticket").should_be(3);
                expect(ticket.issued).named("the class counted all three").should_be(3);
                expect(ticket.next_number).named("the next number").should_be(4);
            };
            test("a method comparing its field with the static") {
                t1 := new ticket();
                t2 := new ticket();
                t3 := new ticket();
                expect(t3.is_newest()).named("newest").should_be(1);
                expect(t1.is_newest()).named("older").should_be(0);
            };
            test("an object changed the static field, and the next object sees it") {
                t1 := new ticket();
                t2 := new ticket();
                t3 := new ticket();
                t1.skip_ahead(10);
                expect(ticket.upcoming()).named("upcoming").should_be(14);
                t4 := new ticket();
                expect(t4.number).named("the next object").should_be(14);
                expect(t2.number).named("an existing object keeps its own field").should_be(2);
            };
            test("a static method reset the static fields, and numbering starts again") {
                t1 := new ticket();
                t2 := new ticket();
                t3 := new ticket();
                t1.skip_ahead(10);
                t4 := new ticket();
                ticket.start_again();
                expect(ticket.issued).named("issued").should_be(0);
                expect(ticket.next_number).named("next").should_be(1);
                t5 := new ticket();
                expect(t5.number).named("numbering starts again").should_be(1);
                expect(t4.number).named("old objects are untouched").should_be(14);
            };
            test("a static written from outside is used by the next object") {
                ticket.next_number = 500;
                expect(new ticket().number).should_be(500);
            };
        };

        // ---- statics and objects of the same class
        tests("objects_of_the_class") {
            after_each {
                point.made = 1;
                point.last_made = global_object;
            };

            test("one point exists already: the global made before main started") { expect(point.made).should_be(1); };
            test("a static method that builds an object, which counted itself") {
                o := point.origin();
                expect(o.x).named("x").should_be(0);
                expect(point.made).named("made").should_be(2);
            };
            test("a static method with a parameter that builds an object") {
                g := point.diagonal(7);
                expect(g.x + g.y).should_be(14);
            };
            test("a static field holding the newest object, and not the one before") {
                o := point.origin();
                g := point.diagonal(7);
                expect(point.last_made == g).named("the newest").should_be(1);
                expect(point.last_made == o).named("the one before").should_be(0);
            };
            test("a static method taking two objects, which made one more") {
                o := point.origin();
                g := point.diagonal(7);
                expect(point.distance_squared(o, new point(3, 4))).named("distance squared").should_be(25);
                expect(point.made).named("made").should_be(4);
            };
        };

        // ---- one shared object
        tests("one_shared_object") {
            after_each {
                shared_log.instance = null;
                shared_log.times_created = 0;
            };

            test("nothing made before it is asked for") { expect(shared_log.times_created).should_be(0); };
            test("asked twice, made once: both variables are the same object") {
                log_a := shared_log.the_one();
                log_b := shared_log.the_one();
                expect(shared_log.times_created).named("times created").should_be(1);
                expect(log_a == log_b).named("the same object").should_be(1);
            };
            test("a change through one is seen through the other, and through the class") {
                log_a := shared_log.the_one();
                log_b := shared_log.the_one();
                log_a.lines = 12;
                expect(log_b.lines).named("through the other").should_be(12);
                expect(shared_log.the_one().lines).named("through the class").should_be(12);
            };
        };

        // ---- static fields with the same name in two classes
        tests("same_name_in_two_classes") {
            after_each {
                left_side.count = 100;
                right_side.count = 200;
            };

            test("left starts at its own value") { expect(left_side.count).should_be(100); };
            test("right starts at its own value") { expect(right_side.count).should_be(200); };
            test("left bump") { expect(left_side.bump()).should_be(101); };
            test("right bump") { expect(right_side.bump()).should_be(210); };
            test("left bump again, and right is not changed by left") {
                left_side.bump();
                right_side.bump();
                expect(left_side.bump()).named("left bump again").should_be(102);
                expect(right_side.count).named("right").should_be(210);
            };
        };

        // ---- globals
        test("global number") { expect(global_number).should_be(5); };
        test("global fraction") { expect(global_fraction).should_be(1.5); };
        test("global set from an expression") { expect(global_from_expression).should_be(13); };
        test("global string") { expect(global_text).should_be("global"); };
        test("global array") { expect(global_numbers[2]).should_be(9); };
        test("global object") { expect(global_object.x + global_object.y).should_be(33); };
        test("global without a value starts at 0") { expect(global_not_set).should_be(0); };
        test("global object without a value starts as null") { expect_null(global_nothing); };
        test("global declared with := is an int object") { expect(global_boxed.value).should_be(9); };

        // ---- globals written here and in functions
        tests("globals_written") {
            after_each {
                global_number = 5;
                global_text = "global";
                global_numbers[0] = 7;
                global_object.x = 11;
                global_nothing = null;
                id_counter = 1000;
            };

            test("write a global") {
                global_number = 6;
                expect(global_number).should_be(6);
            };
            test("a function changed the global, and a function reads it") {
                global_number = 6;
                add_to_global(10);
                expect(global_number).named("the global").should_be(16);
                expect(read_global()).named("read by a function").should_be(16);
            };
            test("++ on a global") {
                global_number = 16;
                global_number++;
                expect(read_global()).should_be(17);
            };
            test("a function changed the global string") {
                append_to_global_text(" text");
                expect(global_text).should_be("global text");
            };
            test("a function changed the global array, the other elements stay") {
                set_global_number_at(0, 70);
                expect(global_numbers[0]).named("the element written").should_be(70);
                expect(global_numbers[1]).named("the next element").should_be(8);
            };
            test("a field of a global object") {
                global_object.x = 1;
                expect(global_object.x).should_be(1);
            };
            test("a global pointed at an object") {
                global_nothing = global_object;
                expect(global_nothing == global_object).should_be(1);
            };
            test("a global declared below the function using it") {
                expect(next_id()).named("first call").should_be(1001);
                expect(next_id()).named("second call").should_be(1002);
                expect(id_counter).named("the global itself").should_be(1002);
            };

            // ---- a local variable does not disturb a global of another name
            test("a local computed from a global, the global is unchanged") {
                global_number = 17;
                local_number : decimal = global_number * 2;
                local_number++;
                expect(local_number).named("the local").should_be(35);
                expect(global_number).named("the global").should_be(17);
            };
        };
    };
}
