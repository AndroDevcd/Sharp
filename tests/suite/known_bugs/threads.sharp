mod main;

import ( testing, std.io )

/**
 * Threads - only what must come out the same on every run:
 *
 *   - a thread is started, the main thread waits until it has finished, and the
 *     result the thread left behind is checked
 *   - several threads each work on their OWN object; the results are added up
 *     after all of them have finished
 *   - several threads change ONE shared counter inside lock(...) { }; the final
 *     total is checked
 *
 * Nothing here depends on which thread runs first or how long anything takes.
 *
 * WHY THIS FILE IS IN known_bugs - three runtime bugs:
 *
 * BUG 1 (the reason the whole file is here): about one run in 40 HANGS, in
 * every configuration, at a different place each time. It is a deadlock inside
 * the runtime, not in this program: the thread that starts a thread sits in
 *     exec_interrupt() -> get_thread()             waiting for unsched_mutex
 * while the scheduler thread sits in
 *     run_scheduler() -> sched_unsched_threads()   waiting for thread_mutex
 * - each holds the lock the other one wants (seen with gdb on a hung process).
 * A hung VM also ignores SIGTERM; it has to be killed with SIGKILL.
 * Every check before the last section passes on the runs that do not hang; when
 * the deadlock is fixed, everything except that last section belongs in
 * cases/threads.sharp.
 *
 * BUG 2: thread.join() does not wait. It returns result_ill_thread_join (6)
 * at once (vm.thread_join in platform/kernel/vm.sharp hands the VM the int
 * OBJECT of the native handle instead of its number: `.value` is missing).
 * So the main thread waits with wait_for() below: it gives up its turn until
 * the thread reports is_exited().
 *
 * BUG 3: thread.start() returns result_max_spin (255) nearly always, although
 * the thread runs; result_ok (0) only now and then.
 *
 * Bugs 2 and 3 are checked in the last section of main().
 */

/** a place for one thread to leave its result */
class slot {
    value : var = 0;
    text : string = "";
}

class tally {
    count : var = 0;
}

/** remembers the exception a thread died of */
class catcher : uncaught_exception_handler {
    message : string = "";
    calls : var = 0;

    override def uncaught_exception(err: throwable) {
        calls++;
        message = "" + err.get_message();
    }
}

shared := new tally();          // changed by many threads, always inside lock(shared)
unguarded := new slot();        // written by exactly one thread at a time
hits := new atomic<int>(0);     // the std counter that locks by itself

def wait_for(t: thread) {
    while(t.is_exited().value == 0) {
        thread.yield();
    }
}

def wait_for_all(threads: thread[]) {
    for(i : var = 0; i < sizeof(threads); i++) {
        wait_for(threads[i]);
    }
}

// ---- thread bodies. A thread body takes object[] and returns a number.

/** args[0] is a slot: leaves 1 + 2 + ... + 1000 in it */
def sum_to_thousand(args: object[]) : var {
    out := args[0] as slot;
    total : var = 0;
    for(i : var = 1; i <= 1000; i++) {
        total += i;
    }
    out.value = total;
    return 0;
}

/** args[0] is a slot holding n: replaces it by n * n */
def square_own_slot(args: object[]) : var {
    own := args[0] as slot;
    own.value = own.value * own.value;
    return 0;
}

/** args[0] is a slot: adds 1 to it 10000 times (nobody else touches that slot) */
def count_in_own_slot(args: object[]) : var {
    own := args[0] as slot;
    for(i : var = 0; i < 10000; i++) {
        own.value++;
    }
    return 0;
}

/** adds 1 to the shared tally 20000 times, each time inside the lock */
def count_in_shared(args: object[]) : var {
    for(i : var = 0; i < 20000; i++) {
        lock(shared) {
            shared.count++;
        }
    }
    return 0;
}

/** the same, but the lock is taken by a function that is called, and left by return */
def bump_shared(): var {
    lock(shared) {
        shared.count += 2;
        return shared.count;
    }
}

def count_in_shared_through_calls(args: object[]) : var {
    for(i : var = 0; i < 5000; i++) {
        bump_shared();
    }
    return 0;
}

/** an exception thrown and caught inside the lock, on every trip */
def count_in_shared_with_exceptions(args: object[]) : var {
    for(i : var = 0; i < 2000; i++) {
        try {
            lock(shared) {
                shared.count++;
                throw new illegal_state_exception("out of the lock");
            }
        } catch(e: illegal_state_exception) {
        }
    }
    return 0;
}

/** args: a slot, then two strings; joins the strings into the slot */
def join_words(args: object[]) : var {
    out := args[0] as slot;
    first := args[1] as string;
    second := args[2] as string;
    out.text = first + " " + second;
    out.value = sizeof(args);
    return 0;
}

def count_with_atomic(args: object[]) : var {
    for(i : var = 0; i < 5000; i++) {
        hits++;
    }
    return 0;
}

def always_fails(args: object[]) : var {
    throw new illegal_state_exception("thread failed on purpose");
}

/** a thread that handles its own exception and still leaves a result */
def recovers(args: object[]) : var {
    out := args[0] as slot;
    try {
        throw new illegal_argument_exception("inside the thread");
    } catch(e: illegal_argument_exception) {
        out.text = "" + e.get_message();
    } finally {
        out.value = 1;
    }
    return 0;
}

def one_argument(value: object): object[] {
    args := new object[1];
    args[0] = value;
    return args;
}

def main(args: string[]) {
    // ================= one thread
    result := new slot();
    worker := new thread("worker", sum_to_thousand);
    expect_false("a new thread has not started", worker.is_started().value);
    expect_false("a new thread has not exited", worker.is_exited().value);
    expect("nothing has run yet", result.value, 0);

    worker.start(one_argument(result));
    wait_for(worker);
    expect_true("after waiting: the thread has exited", worker.is_exited().value);
    expect_false("a finished thread is not active", worker.is_active().value);
    expect("the result the thread left behind: 1 + ... + 1000", result.value, 500500);

    // ---- the main thread goes on as usual afterwards
    own : var = 0;
    for(i : var = 1; i <= 100; i++) {
        own += i;
    }
    expect("the main thread still computes", own, 5050);

    // ================= a thread whose body is written in place
    unguarded.value = 0;
    inline_thread := new thread("inline", { args: object[] -> (var)
        unguarded.value = 77;
        unguarded.text = "from a lambda";
        return 0;
    });
    inline_thread.start();
    wait_for(inline_thread);
    expect("a lambda as the thread body: number", unguarded.value, 77);
    expect_str("a lambda as the thread body: text", unguarded.text, "from a lambda");

    // ================= arguments
    words := new slot();
    word_args := new object[3];
    word_args[0] = words;
    hello : string = "hello";                   // (a bare "hello" would go into the array as raw characters, not as a string)
    word_args[1] = hello;
    name : string = "thread";
    word_args[2] = name;
    talker := new thread("talker", join_words);
    talker.start(word_args);
    wait_for(talker);
    expect_str("two strings passed to a thread", words.text, "hello thread");
    expect("the thread saw all three arguments", words.value, 3);

    // ================= one thread after the other, 20 times
    chain := new slot();
    chain.value = 2;
    for(i : var = 0; i < 4; i++) {
        t := new thread("squarer", square_own_slot);
        t.start(one_argument(chain));
        wait_for(t);                            // the next one starts only after this one is done
    }
    expect("four threads in a row, each squaring: 2 -> 4 -> 16 -> 256 -> 65536", chain.value, 65536);

    finished : var = 0;
    for(i : var = 0; i < 20; i++) {
        t := new thread("short", sum_to_thousand);
        s := new slot();
        t.start(one_argument(s));
        wait_for(t);
        if(s.value == 500500) finished++;
    }
    expect("20 short threads one after the other, all with the right result", finished, 20);

    // ================= several threads at once, each with its own slot
    slots := new slot[4];
    counters := new thread[4];
    for(i : var = 0; i < 4; i++) {
        slots[i] = new slot();
        counters[i] = new thread("counter", count_in_own_slot);
    }
    for(i : var = 0; i < 4; i++) {
        counters[i].start(one_argument(slots[i]));
    }
    wait_for_all(counters);
    expect("own slot of thread 0", slots[0].value, 10000);
    expect("own slot of thread 1", slots[1].value, 10000);
    expect("own slot of thread 2", slots[2].value, 10000);
    expect("own slot of thread 3", slots[3].value, 10000);
    expect("the four slots added up", slots[0].value + slots[1].value + slots[2].value + slots[3].value, 40000);

    // ---- each thread squares its own number
    numbers := new slot[5];
    squarers := new thread[5];
    for(i : var = 0; i < 5; i++) {
        numbers[i] = new slot();
        numbers[i].value = i + 1;               // 1 2 3 4 5
        squarers[i] = new thread("squarer", square_own_slot);
        squarers[i].start(one_argument(numbers[i]));
    }
    wait_for_all(squarers);
    expect("thread 0 squared 1", numbers[0].value, 1);
    expect("thread 2 squared 3", numbers[2].value, 9);
    expect("thread 4 squared 5", numbers[4].value, 25);
    expect("1 + 4 + 9 + 16 + 25", numbers[0].value + numbers[1].value + numbers[2].value + numbers[3].value + numbers[4].value, 55);

    // ================= a shared counter protected by lock
    shared.count = 0;
    lockers := new thread[4];
    for(i : var = 0; i < 4; i++) {
        lockers[i] = new thread("locker", count_in_shared);
        lockers[i].start();
    }
    wait_for_all(lockers);
    expect("4 threads x 20000 increments inside lock", shared.count, 80000);

    // ---- the main thread takes part too
    shared.count = 0;
    helpers := new thread[2];
    for(i : var = 0; i < 2; i++) {
        helpers[i] = new thread("helper", count_in_shared);
        helpers[i].start();
    }
    for(i : var = 0; i < 20000; i++) {
        lock(shared) {
            shared.count++;
        }
    }
    wait_for_all(helpers);
    expect("2 threads and the main thread, 20000 each", shared.count, 60000);

    // ---- the lock is taken in a called function and left by return
    shared.count = 0;
    callers := new thread[3];
    for(i : var = 0; i < 3; i++) {
        callers[i] = new thread("caller", count_in_shared_through_calls);
        callers[i].start();
    }
    wait_for_all(callers);
    expect("3 threads x 5000 calls adding 2, lock left by return", shared.count, 30000);

    // ---- the lock is left by an exception on every trip
    shared.count = 0;
    throwers := new thread[3];
    for(i : var = 0; i < 3; i++) {
        throwers[i] = new thread("thrower", count_in_shared_with_exceptions);
        throwers[i].start();
    }
    wait_for_all(throwers);
    expect("3 threads x 2000 increments, lock left by an exception", shared.count, 6000);
    lock(shared) {
        shared.count++;
    }
    expect("the main thread can still take the lock afterwards", shared.count, 6001);

    // ================= atomic<int>: a counter that needs no lock statement
    atomics := new thread[4];
    for(i : var = 0; i < 4; i++) {
        atomics[i] = new thread("atomic", count_with_atomic);
        atomics[i].start();
    }
    wait_for_all(atomics);
    expect("4 threads x 5000 increments of an atomic", hits.read().value, 20000);

    // ================= exceptions in a thread
    // ---- handled inside the thread: the thread finishes normally
    recovered := new slot();
    careful := new thread("careful", recovers);
    careful.start(one_argument(recovered));
    wait_for(careful);
    expect_str("try/catch inside a thread", recovered.text, "inside the thread");
    expect("finally inside a thread", recovered.value, 1);

    // ---- not handled inside the thread: it goes to the thread's exception handler
    handler := new catcher();
    failing := new thread("failing", always_fails);
    failing.set_exception_handler(handler);
    failing.start();
    wait_for(failing);
    expect("the exception handler of the thread was called once", handler.calls, 1);
    expect_str("...with the exception the thread threw", handler.message, "thread failed on purpose");
    expect_true("the failed thread has exited", failing.is_exited().value);

    // ---- and the program carries on, other threads still work
    after := new slot();
    late := new thread("late", sum_to_thousand);
    late.start(one_argument(after));
    wait_for(late);
    expect("a thread started after another one failed", after.value, 500500);

    // ================= the main thread itself
    expect_not_null("thread.current() in main", thread.current());
    expect_true("the main thread is started", thread.current().is_started().value);
    expect_false("the main thread has not exited", thread.current().is_exited().value);

    // ================= BUG 2 and BUG 3: the values start() and join() give back
    answer := new slot();
    joined := new thread("joined", sum_to_thousand);
    started := joined.start(one_argument(answer));
    expect("start() returns result_ok (0)", started.ordinal, 0);
    waited := joined.join();
    expect("join() returns result_ok (0)", waited.ordinal, 0);
    expect_true("after join() the thread has exited", joined.is_exited().value);
    wait_for(joined);

    finish("threads");
}
