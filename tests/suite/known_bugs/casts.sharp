mod main;

import ( testing )

/**
 * KNOWN BUGS around casts - this file is expected to FAIL until they are fixed.
 * The checks say what the language SHOULD do.
 *
 * 1. A cast to an unrelated class is not checked. `a_dog as cat` raises
 *    nothing and gives a `cat` reference to a dog object; methods of cat can
 *    then be called on it. (Only a cast between an array and a class is
 *    checked - that one is in cases/casts.sharp.)
 *    The same goes for `object as <wrong class>`.
 *
 * 2. `is` answers true for any class: `a_dog is cat` is true.
 *
 * 3. A number passed to a sized PARAMETER is not cut to its size:
 *    `def f(x: _int8)` called with 200 sees 200, although a local, a field
 *    and a return value of type _int8 all hold -56.
 */

class animal {
    name : string;
    animal(n: string) { name = n; }
}

class dog base animal {
    dog(n: string) -> base(n) {}
    def fetch() : decimal { return 1; }
}

class cat base animal {
    cat(n: string) -> base(n) {}
    def purr() : decimal { return 2; }
}

class unrelated {
    v : decimal;
}

def through_int8(x: _int8) : decimal { return x; }
def through_uint8(x: _uint8) : decimal { return x; }
def through_int16(x: _int16) : decimal { return x; }

def main(args: string[]) {
    a_dog : animal = new dog("rex");

    // ---- 1. casts to the wrong class must raise an exception
    try {
        wrong := a_dog as cat;
        fail("dog as cat", "no exception was raised (and purr() gives ${wrong.purr()})");
    } catch(e: exception) {
        pass("dog as cat");
    }

    anything : object = a_dog;
    try {
        wrong := anything as cat;
        fail("object holding a dog, as cat", "no exception was raised");
    } catch(e: exception) {
        pass("object holding a dog, as cat");
    }

    anything = new unrelated();
    try {
        wrong := anything as dog;
        fail("object holding an unrelated class, as dog", "no exception was raised");
    } catch(e: exception) {
        pass("object holding an unrelated class, as dog");
    }

    anything = new string("text");
    try {
        wrong := anything as dog;
        fail("object holding a string, as dog", "no exception was raised");
    } catch(e: exception) {
        pass("object holding a string, as dog");
    }

    // ---- 2. `is`
    expect_true("a dog is a dog", a_dog is dog);
    expect_true("a dog is an animal", a_dog is animal);
    expect_false("a dog is not a cat", a_dog is cat);

    // ---- 3. sized parameters
    expect("200 passed to an _int8 parameter", through_int8(200), 0 - 56);
    expect("300 passed to a _uint8 parameter", through_uint8(300), 44);
    expect("70000 passed to an _int16 parameter", through_int16(70000), 4464);

    finish("casts");
}
