mod main;

import ( testing )

/**
 * KNOWN BUG in comparing fractions. This file is expected to FAIL.
 * (Same result with and without -O, with and without the JIT.)
 *
 * The compiler works out `0.1 + 0.2 == 0.3` itself when all three are
 * literals, and gets a different answer from the running program:
 *
 *     0.1 + 0.2 == 0.3     written with literals   -> 1 (true)
 *     x + y == z           the same numbers in var -> 0 (false)
 *
 * 0 is the usual floating point answer (0.1 + 0.2 is a hair above 0.3).
 * Whichever is meant, the two must agree.
 */

def same(a: var, b: var): var { return a == b; }

def main(args: string[]) {
    x : var = 0.1;
    y : var = 0.2;
    z : var = 0.3;

    expect("x + y == z (variables)", x + y == z, 0);
    expect("same(x + y, z)", same(x + y, z), 0);
    expect("0.1 + 0.2 == 0.3 (literals)", 0.1 + 0.2 == 0.3, 0);
    expect("0.1 + 0.2 != 0.3 (literals)", 0.1 + 0.2 != 0.3, 1);

    finish("comparison");
}
