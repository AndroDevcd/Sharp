mod main;

import ( testing )

/**
 * Known bugs found while writing cases/init_blocks.sharp. This file is
 * EXPECTED to fail.
 *
 * BUG 1 - init blocks run BEFORE the fields get their initial values.
 *   An init block therefore sees 0 / null instead of the value written
 *   next to the field, and whatever it stores in such a field is then
 *   overwritten by the initial value. Expected order: initial values, init
 *   blocks, constructor. (Fields without an initial value work: see the
 *   cases file.) The same holds for `static init` and static fields.
 *
 * BUG 2 - assigning a string literal to a null string field throws
 *         nullptr_exception (in std#string.operator=):
 *       text : string?;
 *       init { text = "set by init"; }
 *   Not special to init blocks; it is the usual way such a field gets its
 *   first value there. (kept as a comment below, it ends the program)
 *
 * BUG 3 - the compiler crashes (segmentation fault, no message) when a
 *         class has two init blocks and the FIRST one declares a local
 *         variable (also a `for(i : var = 0; ...)` counter):
 *       class c {
 *           a : var;
 *           b : var;
 *           init { i : var = 4; a = i; }
 *           init { b = 2; }
 *           c() { }
 *       }
 *   A local in the last init block, or a single init block, is fine.
 *   (kept as a comment below, or nothing in this file could compile)
 *
 * BUG 4 - `new coffee {}` / `new coffee { water_left = 100 }`, the "inline
 *         initialization" shown in examples/new_class.sharp, does not parse:
 *       error S807: expected '[' or '(' or '{' after new expression
 *   (kept as a comment below)
 *
 * Bug 1 is the same in the four configurations ({no -O, -O} x {JIT, -nojit}).
 */

class order {
    width : var = 80;
    seen_width : var;
    doubled : var = 1;

    init {
        seen_width = width;         // expected 80, sees 0
        doubled = 2;                // expected to stay 2, is overwritten with 1
    }

    order() {
    }
}

class static_order {
    static level : var = 5;
    static seen_level : var;

    static init {
        seen_level = level;         // expected 5, sees 0
        level = 11;                 // expected to stay 11, is overwritten with 5
    }
}

def main(args: string[]) {
    // ---- bug 1
    o := new order();
    expect("an init block sees a field's initial value", o.seen_width, 80);
    expect("what an init block stores is kept", o.doubled, 2);
    expect("a static init block sees a static field's initial value", static_order.seen_level, 5);
    expect("what a static init block stores is kept", static_order.level, 11);

    // ---- bug 2 (nullptr_exception)
    //   class with_text { text : string?;  init { text = "set by init"; }  with_text() { } }
    //   expect_str("a string set by an init block", new with_text().text!!, "set by init");

    // ---- bug 3 (compiler segmentation fault): see the class in the comment above

    // ---- bug 4 (does not parse)
    //   o2 := new order { width = 132 };
    //   expect("inline initialization", o2.width, 132);

    finish("init_blocks");
}
