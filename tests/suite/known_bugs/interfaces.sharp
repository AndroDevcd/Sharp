mod main;

import ( testing )

/**
 * Known bug found while writing cases/interfaces.sharp. This file is
 * EXPECTED to fail.
 *
 * A method that comes from an interface can be overridden again in a class
 * further down. Called through the INTERFACE type the object's own override
 * runs, as it should. Called through a variable of the class in between (or
 * from a method inherited from that class) the override is ignored and the
 * in-between class's version runs: the same object gives two different
 * answers to the same call.
 *
 *     n : named = l;       n.name()    gives "label"       (right)
 *     r : rectangle = l;   r.name()    gives "rectangle"   (expected "label")
 *
 * Same result in all four configurations ({no -O, -O} x {JIT, -nojit}).
 */

interface named {
    def name(): string;
}

class rectangle : named {
    override def name(): string {
        return "rectangle";
    }

    /* inherited by labelled_rectangle; calls name() on the object itself */
    def describe(): string {
        return "a " + name();
    }
}

class labelled_rectangle base rectangle {
    override def name(): string {
        return "label";
    }
}

def name_through_interface(n: named): string {
    return n.name();
}

def name_through_class(r: rectangle): string {
    return r.name();
}

def main(args: string[]) {
    l := new labelled_rectangle();

    // ---- these are right
    expect_str("called on the object's own type", l.name(), "label");
    as_interface : named = l;
    expect_str("called through the interface", as_interface.name(), "label");
    expect_str("passed as the interface", name_through_interface(l), "label");

    // ---- these give "rectangle"
    as_rectangle : rectangle = l;
    expect_str("called through the class in between", as_rectangle.name(), "label");
    expect_str("passed as the class in between", name_through_class(l), "label");
    expect_str("called from an inherited method", l.describe(), "a label");

    finish("interfaces");
}
