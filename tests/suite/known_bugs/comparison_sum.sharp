mod main;

import ( testing )

/**
 * KNOWN BUG. This file is EXPECTED TO FAIL.
 *
 * Adding two comparison results directly gives a wrong number when the
 * operands are variables or calls:
 *      two : decimal = 2;
 *      (two < 3) + (4 > two)        is 3 (or prints as "21"), expected 2
 * With literals, or with each comparison stored in a variable first, the
 * result is right. Same in all four configurations.
 */
def plain(a: decimal) : decimal { return a + 1; }

def main(args: string[]) {
    two : decimal = 2;
    expect("(two < 3) + (4 > two)", (two < 3) + (4 > two), 2);
    expect("with calls", (plain(1) < 3) + (4 > plain(1)), 2);
    finish("comparison_sum");
}
