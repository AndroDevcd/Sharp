mod main;

import ( testing )

/**
 * KNOWN BUGS found while writing std.math and std.util. This file is
 * EXPECTED TO FAIL. Each section names the bug and the workaround the
 * library uses; move a section to a file in cases/ when it is fixed.
 * All of them behave the same with and without -O, with and without the JIT.
 *
 * (Two more bugs CRASH THE COMPILER and so cannot share a file with
 * anything else: see lib_math_new_operand.sharp and lib_math_lambda_concat.sharp.)
 */

def main(args: string[]) {
    // ---- BUG 1: the constant expression -1.0 / 0.0 is folded to -2147483648
    // instead of negative infinity (1.0 / 0.0 is folded correctly).
    // NEGATIVE_INFINITY in std/math/math.sharp was written that way and so
    // was -2147483648. Workaround: divide two VARIABLES at run time.
    folded : var = -1.0 / 0.0;
    expect_true("-1.0 / 0.0 is below every finite number", folded < 0 - 1000000000000);        // actual: false
    folded = 0 - (1.0 / 0.0);
    expect_true("0 - (1.0 / 0.0) is below every finite number", folded < 0 - 1000000000000);   // actual: false

    // ---- BUG 2: a large literal after a minus sign (also as `0 - literal`)
    // is folded to -2147483648. Workaround: put the literal in a variable
    // first, or negate at run time (see negated() in std/math/constants.sharp).
    limit : var = 9007199254740991;
    wrong : var = 0 - 9007199254740991;
    expect("0 - 9007199254740991", wrong + limit, 0);                                           // actual: 9007197107257343

    // ---- BUG 3: `number<T, NT>` has operator==(double) but no operator!=(double),
    // so `a != b` on two double OBJECTS does not compare the values:
    // is_nan(v: double), written as `return (v != v);`, returned false for NaN.
    // (math.sharp now compares v.value.)
    zero : var = 0;
    nan : double = zero / zero;
    different : bool = nan != nan;
    expect_true("NaN != NaN on double objects", different.value);                               // actual: false

    // ---- BUG 4: string_builder keeps a stray trailing character: "ab" then 'c'
    // gives "abc" plus one more character. (The library builds text with
    // string + string or an _int8[] instead.)
    sb := new string_builder();
    sb += "ab";
    sb.append('c');
    built : string = sb.to_string()!!;
    expect("string_builder size after ab + c", built.size().value, 3);                          // actual: 4

    finish("lib_math_literals");
}
