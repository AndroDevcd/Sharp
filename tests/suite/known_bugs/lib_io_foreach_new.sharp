mod main;

import ( testing )

/**
 * Does not COMPILE today: `foreach` over a `new` expression stops the code
 * generator with "fatal error: attempting to consume empty machine data!".
 * Workaround: assign the object to a local variable and loop over that.
 */

class three_numbers : loopable<var> {
    override def get_elements() : var[]? {
        numbers := new var[3];
        numbers[0] = 1; numbers[1] = 2; numbers[2] = 3;
        return numbers;
    }
}

def main(args: string[]) {
    total : var = 0;
    foreach(n in new three_numbers()) {
        total += n;
    }
    expect("foreach over a new expression", total, 6);
    finish("lib_io_foreach_new");
}
