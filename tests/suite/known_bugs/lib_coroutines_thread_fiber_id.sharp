mod main;

import (
    testing,
    std.io,
    std.io.fiber
)

/**
 * KNOWN BUG (runtime): the first fiber of every thread reports id 0, the id
 * of the MAIN fiber. fiber.current().suspend() / unsuspend() / kill() on such
 * a fiber therefore act on the main fiber of the program.
 *
 * WHERE
 *   lib/runtime/multitasking/thread/thread_controller.cpp, setup_thread():
 *       assign_numeric_class_field(resolve_field("id", fib->o)->o, thread->task->id);
 *   assign_numeric_class_field expects a number OBJECT (it looks for a field
 *   called "value"), but fiber.id is a native `var`, so nothing is written and
 *   the field keeps its zero. assign_numeric_field(..., 0, id) would be right.
 *
 * WHAT THE LIBRARY DOES ABOUT IT
 *   std.io.fiber waiter cannot park such a fiber by id; it notices the case
 *   (id 0 on a thread that is not the main thread) and waits in short timed
 *   naps instead (waiter.polling). The dispatcher threads of std.coroutines
 *   keep their first fiber asleep and do all work in fibers they start.
 *
 * EXPECTED: the id seen on the second thread is not 0.
 * ACTUAL:   it is 0.
 */

class box { value : var = 0; }

id_on_thread := new box();
finished := new box();

def thread_main(args: object[]) : int {
    id_on_thread.value = fiber.current().id;
    finished.value = 1;
    return 0;
}

def main(args: string[]) {
    expect("the main fiber has id 0", fiber.current().id, 0);

    t := new thread("second", thread_main);
    t.start();
    for(i : var = 0; i < 400 && finished.value == 0; i++) {
        delay(5);
    }

    expect("the thread ran", finished.value, 1);
    expect_true("the first fiber of another thread has its own id", id_on_thread.value != 0);

    finish("lib_coroutines_thread_fiber_id");
}
