mod main;

import ( testing )

/**
 * Known bugs found while writing cases/enums.sharp. This file is EXPECTED
 * to fail.
 *
 * BUG 1 - the member after one with an explicit value gets the SAME value.
 *       enum mixed { first = 5, second, third }
 *   gives first = 5, second = 5, third = 6 (expected 5, 6, 7): `second`
 *   cannot be told from `first` by its ordinal, and == says they are equal.
 *
 * BUG 2 (or a rule that needs writing down) - members without a value do
 *       not start at 0. `enum color { red, green, blue }` numbers its
 *       members from an internal compiler counter (30987, 30988, 30989 in
 *       one build), so an ordinal cannot be used as an index or stored.
 *
 * BUG 3 - an enum declared inside a class cannot be named from outside it:
 *       holder.inner.off
 *       error S8017: could not resolve symbol `inner` did you possibly mean: `main#holder.inner`?
 *   (kept as a comment below, or nothing else in this file could run)
 *
 * All the same in the four configurations ({no -O, -O} x {JIT, -nojit}).
 */

enum mixed {
    first = 5,
    second,
    third
}

enum color {
    red,
    green,
    blue
}

class holder {
    enum inner { on, off }
}

def main(args: string[]) {
    // ---- bug 1
    expect("explicit value", mixed.first.ordinal, 5);
    expect("the member after it is one higher", mixed.second.ordinal, 6);       // 5
    expect("...and the next one higher again", mixed.third.ordinal, 7);         // 6
    expect("first and second are different members", (mixed.first == mixed.second).value, 0);   // 1

    // ---- bug 2
    expect("members without a value start at 0", color.red.ordinal, 0);
    expect("...and count up", color.blue.ordinal, 2);

    // ---- bug 3 (does not compile)
    // expect("an enum inside a class", holder.inner.off.ordinal - holder.inner.on.ordinal, 1);

    finish("enums");
}
