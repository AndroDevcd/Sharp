mod main;

import ( testing )

/**
 * Known bug (or a rule that needs writing down) found while writing the
 * functions-and-classes tests. This file is EXPECTED to fail.
 *
 * The operands of a binary operator are evaluated RIGHT TO LEFT.
 *   In `f() + g()` g is called before f. It only shows when the calls have
 *   side effects, e.g. `box.swap(x) + box.take()`. Expected: left to right,
 *   as the expression is read.
 *   Same result in all four configurations ({no -O, -O} x {JIT, -nojit}).
 */

trace : var = 0;

/* appends its digit to trace, so trace shows the order of the calls */
def mark(digit: var): var {
    trace = trace * 10 + digit;
    return digit;
}

def main(args: string[]) {
    x : var = mark(1) + mark(2);
    expect("a + b evaluates a first", trace, 12);                   // 21

    trace = 0;
    x = mark(1) - mark(2) * mark(3);
    expect("a - b * c evaluates a, then b, then c", trace, 123);    // 321

    finish("operators");
}
