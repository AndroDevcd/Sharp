mod main;

// output:
// 42
// 610
// 2
// 1
// 3
// 3
// 4
// 34
// 15
// 44
// 7

/*
 * Calls (doc/codegen.md 6.0, 6.6, 5.3): results, recursion, the ORDER of
 * evaluation - the right operand of `+` runs first, the arguments of a call
 * left to right - the old value of a local handed over when a later argument
 * changes it (`pair(i, i = 5)`), and an argument narrowed to its parameter's
 * type (300 given to an _int8 is 44, probed: Q3).
 */
def twice(n: _int64) : _int64 {
    return n * 2;
}

def fib(n: _int64) : _int64 {
    if(n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

def say(n: _int64) : _int64 {
    show(n);
    return n;
}

def pair(a: _int64, b: _int64) {
    show(a * 10 + b);
}

def tiny(x: _int8) : _int64 {
    return x;
}

def seven() : _int64 = 7;

def main() {
    show(twice(21));
    show(fib(15));
    r : _int64 = say(1) + say(2);
    show(r);
    pair(say(3), say(4));
    i : _int64 = 1;
    pair(i, i = 5);
    big : _int64 = 300;
    show(tiny(big as _int8));
    show(seven());
}
