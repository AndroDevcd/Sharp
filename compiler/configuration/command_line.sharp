mod configuration;

import (
    std.io,
    std.io.coroutines,
    backend.optimizer
)

/*
 * THE COMMAND LINE: what `sharpc <options> <files>` asks for.
 *
 *      sharpc main.sharp -o app -L /usr/include/sharp/0.4.0 -O
 *
 * `read_command_line` walks the arguments once, left to right, and writes
 * what each option means into `options` (options.sharp); the driver
 * (main.sharp in the folder above) then does what `options` says. Nothing is compiled here.
 *
 * The rules, the same as the C++ compiler's:
 *   - an option starts with `-`; some take the NEXT argument as their value
 *     (`-o app`); a value that is missing is an error that names the option.
 *     So is an empty value (`-o ""`, an unset variable in a build script) and
 *     one that is itself an option (`-o -c` would silently write a file
 *     named `-c`, `-v -c` would swallow the `-c`): `value_after`;
 *   - a number (`-j`, `-errlmt`) is a whole number written in digits; "00",
 *     "1.5" and a number too large to hold are refused (`whole_number`);
 *   - everything else is a source file; files and options may be mixed;
 *   - an option nobody knows is an error, never ignored: a misspelt `-O` that
 *     silently did nothing would be worse than no build;
 *   - an error on the command line ends the compiler with exit code 1 before
 *     anything is compiled (`error`, configuration.sharp).
 *
 * An option of the C++ compiler that this compiler does not act on yet is
 * still ACCEPTED, so that a build script written for one runs with the other,
 * and says so once in a warning (`not_supported_yet`): today there is none.
 *
 *      C++ comparison: lib/grammar/main.cpp, _bootstrap(): the same chain of
 *      `if(opt("-o"))`, writing into the same `options` structure
 *      (lib/grammar/settings/settings.h). doc/codegen.md 8.2 lists every
 *      option of both compilers side by side.
 *
 * In this file:
 *      read_command_line       the walk
 *      value_after             the argument after an option, or the error
 *      whole_number            the number a value of `-j` / `-errlmt` writes, or -1
 *      help, help_warning      the text of --h and --hw
 */

/**
 * Read every argument into `options`. Returns nothing: a command line that
 * cannot be understood ends the compiler (`error`).
 */
def read_command_line(args: string[]) {
    for(i := 0; i < sizeof(args); i++) {

        arg := args[i];
        if(!debug_compiler && is_debug_option(arg)) {
            // (configuration/build_kind.sharp: the standard compiler has no options that look inside it)
            error_with_help("option `" + arg + "` is only in the debug compiler",
                            "run the debug compiler with the same arguments:  sharpc --debug ...");
        }
        if(arg == "-a"){
            // (the C++ compiler filters follow-on errors and -a shows them all the same; this
            //  compiler reports one message per mistake and hides none, so there is nothing to add)
            enable_show_all_errors(true);
        }
        else if(arg == "-c"){
            enable_compile_only(true);
        }
        else if(arg == "-o"){
            set_output_file(value_after(args, i, "the name of the output file"));
            i++;
            options.out_given = true;
        }
        else if(arg == "-L"){
            add_library_path(value_after(args, i, "a library folder"));
            i++;
        }
        else if(arg == "-j"){
            // how many worker threads parse the files (C++: `-j`, set_target_threads). The
            // suite runner and the benchmark scripts pass `-j 1`.
            threads := value_after(args, i, "a number of threads");
            i++;
            count : _int64 = whole_number(threads);
            if(count < 1)
                error_with_help("option `-j` needs a whole number of threads of at least 1, not `$threads`",
                                "write for example `-j 4`; without `-j` the compiler picks the number itself");
            dispatchers.set_parallelism(count as _int32);
        }
        else if(arg == "-V"){
            print_version();
            exit();
        }
        else if(arg == "-O" || arg == "-O1" || arg == "-O2" || arg == "-O3"){
            set_optimization_level(optimization_level.high_performance);
            options.optimize = true;
        }
        else if(arg == "-O0"){
            set_optimization_level(optimization_level.none);
            options.optimize = false;
        }
        else if(arg == "-Oreport"){
            options.optimizer_report_wanted = true;     // print what the optimizer did
        }
        else if(arg == "-Otrace"){
            // print the IR of one function after each pass of the optimizer that changed it
            options.optimizer_trace = value_after(args, i, "the full name of a function (as -ir prints it)");
            i++;
        }
        else if(arg == "--h" || arg == "-?"){
            help();
            exit();
        }
        else if(arg == "--hw"){
            help_warning();
            exit();
        }
        else if(arg == "-R" || arg == "-release"){
            enable_release_mode();
        }
        else if(arg == "-magic"){
            enable_magic_mode(true);
        }
        else if(arg == "-dbg" || arg == "-debug") {
            enable_debug_mode(true);
            options.debug_file = true;
        }
        else if(arg == "-showvers" || arg == "-showversion"){
            print_version();
            println();
        }
        else if(arg == "-target"){
            set_target_platform(value_after(args, i, "the name of a platform"));
            i++;
            options.target_given = true;
        }
        else if(arg == "-w"){
            enable_warnings(false);
        }
        else if(arg == "-waccess" || arg == "-wambig" || arg == "-wdecl"
          || arg == "-wmain" || arg == "-wcast" || arg == "-winit"
          || arg == "-wnull" || arg == "-wdep"){
            enable_warning_type(arg, false);
        }
        else if(arg == "-p"){
            options.compile_mode = compilation_mode.project_mode;
        }
        else if(arg == "-run"){
            options.run_source = true;
        }
        else if(arg == "-watch"){
            options.watch = true;
        }
        else if(arg == "--clean"){
            options.clean_build = true;
        }
        else if(arg == "-cacheoff"){
            options.file_caching = false;       // do not keep or read the build cache (cache/)
        }
        else if(arg == "-cache"){
            set_cache_folder(value_after(args, i, "a folder for the build cache"));
            i++;
        }
        else if(arg == "-cxx"){
            // the C++ compiler that builds a project's native libraries, for this build (native_build.sharp)
            options.cxx = value_after(args, i, "a C++ compiler: the path of g++ or clang++, or the name of one on the PATH");
            i++;
        }
        else if(arg == "-sni"){
            // the C++ files of the program's `native` functions go here (backend/finalizer/sni)
            options.sni_folder = value_after(args, i, "a folder for the C++ files of the native functions");
            i++;
            options.sni_folder_given = true;
        }
        else if(arg == "-g" || arg == "-green"){
            enable_green_mode(true);
        }
        else if(arg == "--new-project" || arg == "--create-project"){
            options.new_project_dir = value_after(args, i, "the name of the project folder to make");
            i++;
        }
        else if(arg == "-v"){
            options.version = value_after(args, i, "the version of the application");
            i++;
        }
        else if(arg == "-files"){
            // the source files, named in a text file instead of on the command line
            add_listed_files(value_after(args, i, "a text file that names the source files, one on each line"));
            i++;
        }
        else if(arg == "-ignore"){
            add_ignored_file(value_after(args, i, "the path of a file to leave out"));
            i++;
        }
        else if(arg == "-ignoredir"){
            add_ignored_directory(value_after(args, i, "the path of a folder to leave out"));
            i++;
        }
        else if(arg == "-P"){
            set_project_directory(value_after(args, i, "the folder of the project"));
            i++;
        }
        else if(arg == "-tests"){
            options.tests = true;           // the project's tests, not the program (project.sharp)
        }
        else if(arg == "-test-only"){
            options.tests_only.add(value_after(args, i, "the group, or \"group > test\", to run"));
            i++;
        }
        else if(arg == "-testdir"){
            set_tests_directory(value_after(args, i, "the folder that holds the tests"));
            i++;
        }
        else if(arg == "-wlib"){
            options.library_warnings = true;  // also the warnings located in the standard library
        }
        else if(arg == "-wextra"){
            options.extra_warnings = true;  // also the warnings that are off by default (unused names, fields without a value)
        }
        else if(arg == "-werror"){
            enable_warnings_as_errors();
        }
        else if(arg == "-errlmt") {
            set_error_limit(value_after(args, i, "the number of errors to show"));
            i++;
        }
        else if(arg == "-lexstats") {
            options.lexer_stats_only = true;    // tokenize the files, print what was found, stop
        }
        else if(arg == "-parsestats") {
            options.parser_stats_only = true;   // tokenize and parse the files, print what was found, stop
        }
        else if(arg == "-timings") {
            options.show_timings = true;    // print how long every stage took
        }
        else if(arg == "-analysis") {
            options.show_analysis = true;       // print the typed tree of the functions of the last file given
        }
        else if(arg == "-analysis-stats") {
            options.show_analysis_stats = true; // print how much was analysed and what later stages still build
        }
        else if(arg == "-ide") {
            // also write the errors and an index of the program into this folder, as files
            // an editor plugin reads (backend/ide)
            options.ide_folder = value_after(args, i, "a folder to write into:  -ide <folder>");
            i++;
        }
        else if(arg == "-declarations") {
            options.show_declarations = true;   // print the objects the backend built: classes, fields, functions
        }
        else if(arg == "-parsetree") {
            options.parser_tree_only = true;    // print the syntax tree of each file, stop
        }
        else if(arg == "-eager") {
            options.keep_everything = true;     // keep every analysed function and class in the executable
        }
        else if(arg == "-listing" || arg == "-d") {
            options.write_listing_file = true;  // write <output>.listing: the executable as readable text
        }
        else if(arg == "-obf") {
            options.obfuscate_names = true;
        }
        else if(arg == "-ir") {
            options.show_ir = true;             // print the intermediate form of the functions of the last file given
        }
        else if(sizeof(arg.data) > 2 && arg.at(1) == 'n' && arg.at(0) == '-'){
            // -n<optimization>: with -O, leave that optimization out (-nloop-rotation), as in the C++ compiler
            name := text_after(arg, 2);
            if(!is_optimization_name(name))
                error("unknown optimization `" + name + "` in option `" + arg + "`. Optimizations are:" + optimization_names_text());
            options.left_out_optimizations.add(name);
        }
        else if(sizeof(arg.data) == 0) {
            // (an empty argument, `sharpc "" main.sharp`: neither a file nor an option)
            error("an empty argument is neither a source file nor an option");
        }
        else if(arg.at(0) == '-'){
            error("invalid option `" + arg + "`, try $program_name --h");
        }
        else {
            // add the source files, up to the next option (or the end)
            more_options := false;
            while(i < sizeof(args) && !more_options) {
                arg = args[i];
                if(sizeof(arg.data) > 0 && arg.at(0) == '-') {
                    more_options = true;
                } else {
                    if(!contains(options.source_files, arg))
                        options.source_files.add(arg);
                    i++;
                }
            }

            if(!more_options)
                break;
            i--;    // the loop moves on to that option
        }
    }
}

/**
 * `-files <list>`: every line of the text file `list` is the path of a source
 * file, exactly as if it had been written on the command line (spaces and a
 * `` around a line are not part of the path; an empty line is skipped).
 *
 * WHY IT EXISTS. A command line has a length limit - 32,767 characters on
 * Windows - and a program of a few hundred files with long paths passes it.
 * An editor that starts the compiler writes the list to a file instead (the
 * CLion plugin does: tools/clion-plugin). Any number of `-files` may be
 * given, with files on the command line beside them.
 *
 *      C++ comparison: the "response file" of gcc and MSVC (`@list.txt`).
 */
def add_listed_files(list_path: string) {
    listing := new file(list_path);
    if(!listing.exists())
        error_with_help("the file list `$list_path` of option `-files` does not exist",
                        "`-files` takes a text file with one source file on each line");
    text : string? = file_natives.read(listing.path);
    if(text == null) { return; }                // an empty list names no file
    data : _int8[]? = text!!.data;
    size : _int64 = sizeof(data);
    start : _int64 = 0;
    for(i : _int64 = 0; i <= size; i++) {
        if(i == size || data!![i] == 10) {
            first : _int64 = start;
            last : _int64 = i;
            while(first < last && (data!![first] == ' ' || data!![first] == 13 || data!![first] == 9)) { first++; }
            while(last > first && (data!![last - 1] == ' ' || data!![last - 1] == 13 || data!![last - 1] == 9)) { last--; }
            if(last > first) {
                named := new string(data!!, first, last);
                if(!contains(options.source_files, named)) { options.source_files.add(named); }
            }
            start = i + 1;
        }
    }
}

/**
 * The value of the option at `args[at]`: the argument after it. The
 * compiler stops (exit code 1) with a message that names the option when
 * there is none, when it is empty, or when it is another option - which a
 * value never is, so taking it would lose that option without a word.
 *
 * @param what  what the option wants, for the message: "the name of the output file"
 */
def value_after(args: string[], option_at: int, what: string) : string {
    at : _int64 = option_at.value;     // (the walk counts with an `int` object)
    option : string = args[at];
    if(at + 1 >= sizeof(args))
        error_with_help("option `$option` needs $what after it, and nothing follows",
                        "write `$option <value>`");
    value : string = args[at + 1];
    if(sizeof(value.data) == 0)
        error_with_help("option `$option` was given an empty value; it needs $what",
                        "in a build script this is usually a variable that is not set, as in `$option \"$$NAME\"` with NAME unset");
    if(sizeof(value.data) > 1 && value.at(0) == '-')
        error_with_help("option `$option` needs $what, but the argument after it, `$value`, is an option",
                        "write the value right after `$option`; a file whose name starts with `-` is written `./$value`");
    return value;
}

/**
 * The whole number `text` writes in digits ("4", "0012" is 12), or -1 when it
 * is not one: empty, a sign, a point, a letter, or more than 9 digits after
 * the leading zeros (a number that large is never a sensible count, and
 * `int.parse` would overflow).
 */
def whole_number(text: string) : _int64 {
    if(sizeof(text.data) == 0 || !is_number(text)) { return 0 - 1; }
    value : _int64 = 0;
    digits : _int64 = 0;
    foreach(c in text) {
        if(digits > 0 || c != '0') { digits++; }
        if(digits > 9) { return 0 - 1; }
        value = value * 10 + (c - '0');
    }
    return value;
}

/** the characters of `text` from position `start` to its end ("-nloop-rotation", 2 -> "loop-rotation") */
def text_after(text: string, start: _int64) : string {
    rest := new string_builder("");
    characters : _int8[] = text.data!!;
    for(i : _int64 = start; i < sizeof(characters); i++) { rest.append(characters[i]); }
    return rest.build();
}

/** 1 when every character of the text is a digit */
def is_number(str: string) : decimal {
    foreach(c in str) {
        if(!character.is_digit(c))
            return false;
    }
    return true;
}

def print_version() {
    if(debug_compiler) { println(program_name + " " + program_vers + " (debug)"); }
    else { println(program_name + " " + program_vers); }
}

def help() {
    println("Usage: sharpc " + "{OPTIONS} SOURCE FILE(S)");
    println("Source file must have a .sharp extension to be compiled.\n");
    println("[-options]\n\n    -V                print compiler version and exit"                           );
    println(              "    -showversion      print compiler version and continue"                       );
    println(              "    -o <file>         set the output file (default: out; in a project: build/outputs/<output>)" );
    println(              "    -c                compile only and do not generate exe"                      );
    println(              "    -run              run the program after a successful compile (with `sharp` from the PATH)" );
    println(              "    -watch            build, then build again whenever a file of the program is saved (Ctrl+C stops)" );
    println(              "    -a                show every error (this compiler always does; accepted for scripts)" );
    println(              "    -L <path>         library directory path: every .sharp file in it and below" );
    println(              "    -files <list>     more source files: a text file with one path on each line"  );
    println(              "    -j <amount>       how many threads parse the source files"                   );
    println(              "    -w                disable all warnings"                                      );
    println(              "    -g -green         run compiler in \"green\" mode to consume less power"      );
    println(              "    -dbg -debug       keep the source text in the executable (stack traces print the lines)" );
    println(              "    -release -R       generate a release build exe (no source text)"            );
    println(              "    -obf              obfuscate the names in the executable (map: <output>.names)" );
    println(              "    -O                optimize the generated code (every optimization; -O1 .. -O3 mean the same)" );
    println(              "    -O0               do not optimize (the default)"                             );
    println(              "    -n<optimization>  with -O: leave one optimization out, e.g. -nloop-rotation" );
    println(              "                      optimizations:" + optimization_names_text()                );
    if(debug_compiler) {
        // the debug compiler's own (configuration/build_kind.sharp)
        println(          "    -Oreport          print what the optimizer did"                              );
        println(          "    -Otrace <fn>      print the IR of one function after each optimizer pass"     );
        println(          "    -eager            keep every analysed function and class in the executable"  );
        println(          "    -listing -d       also write <output>.listing: the executable as text"       );
        println(          "    -ir               print the intermediate code of the last file given"       );
        println(          "    -timings          print how long each stage of the compile took"             );
        println(          "    -parsetree -declarations -analysis -analysis-stats -lexstats -parsestats"    );
        println(          "                      print what a stage of the compiler made of the program"    );
    }
    println(              "    -ignoredir <dir>  include a directory to ignore"                             );
    println(              "    -ignore <file>    include a file to ignore"                                  );
    println(              "    -p                enable project mode compilation (the current folder)"      );
    println(              "    -P <path>         enable project mode compilation on a specific path"        );
    println(              "    -tests            build the project's tests (its `tests` folder) with the program;" );
    println(              "                      the tests' main is where it starts: build/outputs/<name>_tests" );
    println(              "    -test-only <name> with -tests -run: run only this group, or \"group > test\" (may be repeated)" );
    println(              "    -testdir <dir>    the folder whose main is where the program starts (an editor's check)" );
    println(              "    --new-project <name> create a new sharp project"                             );
    println(              "    --clean           flush the build cache and compile the project fresh"       );
    println(              "    -cache <folder>   folder for the build cache (default: <project>/build/cache)" );
    println(              "    -cacheoff         do not use the build cache"                                );
    println(              "    -sni <folder>     write the C++ files of the `native` functions there (sni.h, <group>_sni.h/.cpp);" );
    println(              "                      a project needs no -sni: they go to build/outputs/sni" );
    println(              "    -cxx <compiler>   the C++ compiler that builds a project's native libraries (g++ or clang++:" );
    println(              "                      a path, or a name on the PATH); else settings.json, SHARP_CXX, a search" );
    println(              "    -errlmt <count>   set max errors the compiler allows before quitting"        );
    println(              "    -v <version>      set the application version"                               );
    println(              "    -target <name>    target the specified platform of sharp to run on"          );
    println(              "    --hw              display help message for warning options"                  );
    println(              "    --h -?            display this help message"                                 );
}

def help_warning() {
    println( "Usage: sharpc {OPTIONS} SOURCE FILE(S)");
    println( "Source file must have a .sharp extension to be compiled.\n");
    println( "Please note that not all warnings will be able to be disabled individually.\n");
    println( "[-options]\n\n    -w                disable all warnings"                                     );
    println(               "    -winit            disable class initialization warnings"                    );
    println(               "    -waccess          disable access modifier warnings (public, static, etc.)"  );
    println(               "    -wambig           disable ambiguous symbol warnings"                        );
    println(               "    -wdecl            disable object declaration warnings"                      );
    println(               "    -wmain            disable multiple main method warnings"                    );
    println(               "    -wcast            disable type cast warnings"                               );
    println(               "    -wnull            disable null type warnings"                               );
    println(               "    -wdep             disable dependency injection warnings"                    );
    println(               "    -wextra           also the warnings that are off by default (unused names ...)");
    println(               "    -wlib             also the warnings located in the standard library");
    println(               "    -werror           enable warnings as errors"                                );
    println(               "    --hw               display this help message"                               );
}
