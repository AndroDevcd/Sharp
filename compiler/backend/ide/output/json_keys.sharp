mod backend.ide.output;

import (
    std.io
)

/**
 * THE NAMES OF THE JSON MEMBERS, MADE ONCE
 *
 * Every member of a JSON object has a name: `"name"`, `"flags"`, `"at"`. The
 * natural way to write one is `w.key("name")` - but on this VM a string
 * literal is not free: every time a line with `"name"` in it RUNS, a new
 * string object is made (three objects, about a hundred bytes). The index of
 * the standard library has some 6,500 members with a dozen names each, so the
 * literals alone were 800,000 objects and 39 MB on every run: more than
 * everything else the editor files cost, and enough to bring on a pause of the
 * garbage collector (a quarter of a second) in the middle of the writing.
 *
 * A constant is made once, when the program starts, and reading it makes
 * nothing. So the names are constants here, and the writers say
 *
 *      w.key(KEY_NAME);  w.text(field.name);
 *
 * `KEY_X` is always the text `x`, in the spelling of doc/ide.md section 4;
 * there is nothing else to know about this file. A name that is new to the
 * format gets a line here.
 *
 * (Measured on the standard library: 43 MB and 920,000 objects per run before,
 * see doc/ide.md 4.8 for the figures after.)
 *
 *      C++ comparison: `static const std::string` members instead of
 *      constructing a std::string from a literal at every call.
 */
const KEY_ALIASES       : string = "aliases";
const KEY_ARGS          : string = "args";
const KEY_ARRAY         : string = "array";
const KEY_AT            : string = "at";
const KEY_BASE          : string = "base";
const KEY_BODIES        : string = "bodies";
const KEY_BODY          : string = "body";
const KEY_BOUND         : string = "bound";
