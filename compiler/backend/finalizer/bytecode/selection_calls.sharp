mod backend.finalizer.bytecode;

import (
    std.io,
    backend.types.declarations,
    backend.types.type_system,
    backend.finalizer.ir,
    backend.finalizer.layout
)

/**
 * SELECTION: CALLS, ASM INSTRUCTIONS, STUBS (doc/codegen.md 4.4, 4.6, 5.8, 6.6, 6.17)
 *
 *      call %4, f(%1, %2)          ->  ipushl 1;  pushl 2;  call <address of f>;  ipopl 4
 *      call virtual %4, s.sound()  ->  pushl <s>;  invoke_delegate <root of sound>, 0, 0;  ipopl 4
 *      call_value %4, %f(%1)       ->  pushl <f>;  ipushl 1;  calld 1;  ipopl 4
 *
 * The caller pushes the object (when the function has one) and the
 * arguments; the callee leaves its result as the top slot, which is taken
 * into the target (`ipopl` a number, `popl` a reference) or dropped (`pop`).
 * Also here: one instruction of an `asm` block (already resolved, only its
 * labels become pcs).
 */

/**
 * A call: the arguments onto the operand stack (`self` first for a function
 * that has an object; a number into the slot's number half with `ipushl`, a
 * reference into its reference half with `pushl`), then the call. A function
 * that returns a value leaves it as the top slot (codegen.md 4.4): taken into
 * the target, or dropped with `pop` when nobody uses it.
 */
def select_call(out: code_emitter, made: ir_instruction, context: selection_context) {
    arguments : number_list = made.arguments!!;
    for(i : _int64 = 0; i < arguments.count; i++) {
        slot : _int64 = arguments.at(i);
        if(context.is_reference(slot)) { out.class_d(OP_PUSHL, slot); }
        else { out.class_d(OP_IPUSHL, slot); }
    }
    function := made.declaration as sharp_function;
    if(made.number == CALL_HOW_VIRTUAL) {
        // the object is under the arguments; invoke_delegate's count does not include it
        out.invoke_delegate(made.detail, arguments.count - 1, 0);
    } else if(made.number == CALL_HOW_NATIVE) {
        out.invoke_delegate(function.address, arguments.count, 1);
    } else {
        out.class_d(OP_CALL, function.address);
    }
    result := function.result_type;
    if(result == null || result!!.is_nil()) { return; }
    if(made.target < 0) { out.class_e(OP_POP); return; }
    if(context.is_reference(made.target)) { out.class_d(OP_POPL, made.target); }
    else { out.class_d(OP_IPOPL, made.target); }
}

/**
 * A call of a function VALUE (codegen.md 4.6): the value, then the
 * arguments, onto the operand stack; `calld n` takes the value out from
 * under the n arguments, adds the value's captured record as a hidden last
 * argument when it has one, and calls the function the value names like a
 * static function. The result, when the function has one, is the top slot as
 * for any call. Whether there is one is not in the word: it is noted for the
 * verifier (`value_calls_returning`).
 */
def select_call_value(out: code_emitter, made: ir_instruction, context: selection_context) {
    out.class_d(OP_PUSHL, made.first);
    arguments : number_list = made.arguments!!;
    for(i : _int64 = 0; i < arguments.count; i++) {
        slot : _int64 = arguments.at(i);
        if(context.is_reference(slot)) { out.class_d(OP_PUSHL, slot); }
        else { out.class_d(OP_IPUSHL, slot); }
    }
    if(made.detail == 1) { out.value_calls_returning.add(out.pc()); }
    out.class_d(OP_CALLD, arguments.count);
    if(made.detail != 1) { return; }
    if(made.target < 0) { out.class_e(OP_POP); return; }
    if(context.is_reference(made.target)) { out.class_d(OP_POPL, made.target); }
    else { out.class_d(OP_IPOPL, made.target); }
}

/** one asm instruction, its label operands turned into pcs */
def select_asm(out: code_emitter, made: ir_instruction) {
    values := new number_list();
    for(i : _int64 = 0; i < made.arguments!!.count; i++) {
        value : _int64 = made.arguments!!.at(i);
        if(made.label_operands!!.at(i) == 1) { value = out.label_pc(value); }
        values.add(value);
    }
    emit_asm(out, asm_spec_at(made.number), values);
}
