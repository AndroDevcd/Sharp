mod backend.compiler.lambdas;

import (
    std.io,
    frontend.lexer,
    frontend.syntax.tree,
    backend.types.type_system,
    backend.types.typed_tree,
    backend.compiler.context,
    backend.compiler.conversions,
    backend.compiler.overloads
)

/**
 * STAGE 9, PART ONE: LAMBDAS AND FUNCTION VALUES
 *
 *      double := { x: decimal -> (decimal) return x * 2; };    a lambda with every type written
 *      apply(5, { x -> return x + 1; });                        its types taken from `apply`'s parameter
 *      items.each { println(it); }                              a trailing lambda, `it` its one parameter
 *      f := twice;                                              a function named as a value
 *      counter := make_counter(); counter();                    a closure: it keeps `total` alive
 *
 * A lambda is a function written in place. Analysing one means:
 *
 *   1. reading what is written (lambda_form.sharp);
 *   2. completing its type from the function type EXPECTED where it stands
 *      (lambda_signature.sharp: E0800 - E0803, E0809 is reported by name lookup);
 *   3. making it a function of its own and analysing its body - the
 *      variables it uses from around it become CAPTURED
 *      (lambda_body.sharp; the bookkeeping is context/closures.sharp).
 *
 * In a CALL the lambda's types depend on which overload is chosen, and the
 * choice may depend on the lambda (`{ a: string -> ... }` fits only one).
 * So the call stage reads the lambda's form first (`describe_waiting_argument`):
 * overload resolution compares its parameter count and written types with
 * each candidate; once the function is chosen the lambda is analysed against
 * that parameter (`finish_waiting_argument`). A lambda with every type
 * written has a type of its own and takes part like any other argument. A
 * function NAME passed as an argument waits the same way: which overload of
 * it is meant is decided by the parameter it is given to.
 *
 * Where a lambda may stand: as an argument, the value of a variable, field
 * or `return`, the right side of `=`, an item of an array, either side of
 * `==` / `!=`, the value of a component definition, and in front of `( )` to
 * be called at once (`{ -> (int) return 7; }()`). Anywhere else - the operand
 * of `+`, a condition, the object of a `.` - it is E0808.
 *
 * The files of this package (module `backend.compiler.lambdas`):
 *
 *      lambdas.sharp               this front door: analyse_lambda; lambdas and function names as
 *                                  arguments of a call; where a lambda may stand (E0808)
 *      lambda_form.sharp           what a lambda looks like as written: parameters, result, body
 *      lambda_signature.sharp      its parameter and result types from what is written and what is
 *                                  expected (E0800 - E0803)
 *      lambda_body.sharp           the lambda as a function of its own: its context, its body, its
 *                                  result worked out from its `return`s
 *      function_references.sharp   a function named as a value (E0804, E0805, W1011)
 *
 * The lambda's body is analysed by the expression and statement packages,
 * which in turn reach lambdas inside it: like the expression packages, this
 * one is part of the recursive walk over the tree.
 *
 *      C++ comparison: compiler/expressions/primary/lambda_expression.cpp,
 *      dependency/closure_capture.cpp, and the function-address code of
 *      dependency/dependency.cpp.
 */
def analyse_lambda(context: analysis_context, node: _int64, wanted: resolved_type?) : bound_expression {
    return analyse_lambda_as(context, node, wanted, 0);
}

/**
 * The same, telling whether the lambda is an ARGUMENT of a call: there a
 * written result that differs from the parameter's is accepted (W1029), as
 * the C++ compiler compares only the parameters of a function passed as an
 * argument (conversions/conversion_messages.sharp, `warn_result_ignored`).
 */
def analyse_lambda_as(context: analysis_context, node: _int64, wanted: resolved_type?, as_argument: _int64) : bound_expression {
    misplaced : _int64 = report_if_misplaced(context, node);
    form := read_lambda_form(context, node);
    signature := lambda_signature_of(context, form, function_type_expected(wanted), as_argument);
    made := build_lambda(context, form, signature);
    if(misplaced == 1 || signature.mismatch == 1) {
        // reported: the lambda's body was still checked, but its value is not used further
        failed := new bound_error(context.unit, node, context.session.types.error_type);
        failed.inner = made;
        return failed;
    }
    return made;
}

/**
 * E0808: a lambda where no function value can stand. Returns 1 when
 * reported. The place is read off the syntax tree: what the lambda is a part
 * of (parentheses looked through).
 */
def report_if_misplaced(context: analysis_context, node: _int64) : _int64 {
    tree : syntax_tree = context.tree;
    child : _int64 = node;
    parent : _int64 = tree.parents!![node];
    while(parent >= 0 && tree.kinds!![parent] == N_PAREN) {
        child = parent;
        parent = tree.parents!![parent];
    }
    if(parent < 0) { return 0; }
    kind : _int64 = tree.kinds!![parent];
    if(kind == N_INITIALIZER || kind == N_ARGUMENTS || kind == N_CALL || kind == N_RETURN || kind == N_ARRAY_LITERAL
       || kind == N_NEW_ARRAY || kind == N_DICTIONARY_PAIR || kind == N_COMPONENT_TYPE || kind == N_ELVIS
       || kind == N_EXPRESSION_STATEMENT || kind == N_EXPRESSION_BODY || kind == N_CAST || kind == N_VARIABLE) {
        return 0;
    }
    if(kind == N_ASSIGN && tree.first_child!![parent] != child) { return 0; }
    if(kind == N_TERNARY && tree.first_child!![parent] != child) { return 0; }
    if(kind == N_BINARY) {
        operation : _int64 = token_kind_at(context, parent);
        if(operation == P_EQEQ || operation == P_NOTEQ) { return 0; }
    }

    d := problem_at(context, "E0808", "a lambda cannot be used here", node);
    d.with_label("a function value " + misplaced_role(context, parent, child));
    d.with_note("a lambda is a value of a function type: it can be passed, stored, returned, compared with `==` and called - nothing else");
    d.with_help("store it first (`f := { ... };`) or call it (`{ ... }()`), and use the result");
    report(context, d);
    return 1;
}

/** "cannot be added", "cannot be a condition" ...: what the lambda was asked to be */
def misplaced_role(context: analysis_context, parent: _int64, child: _int64) : string {
    kind : _int64 = context.tree.kinds!![parent];
    if(kind == N_BINARY || kind == N_UNARY || kind == N_POSTFIX) { return "has no `" + name_at(context, parent) + "`"; }
    if(kind == N_MEMBER || kind == N_INDEX) { return "has no members and no items"; }
    if(kind == N_IF || kind == N_WHILE || kind == N_DO_WHILE || kind == N_FOR_CONDITION || kind == N_TERNARY) { return "is not a condition"; }
    return "cannot stand here";
}

/**
 * A lambda or a function name passed to a call, before the function is
 * chosen: what overload resolution can know of it without its body - how
 * many parameters it is written with, the types written for them, the
 * result written. Function names: the functions the name has.
 */
def describe_waiting_lambda(context: analysis_context, node: _int64, argument: call_argument) {
    form := read_lambda_form(context, node);
    argument.is_lambda = 1;
    argument.lambda_parameters = form.parameter_count();
    if(form.has_arrow == 1) {
        types := new list<resolved_type>();
        for(i : _int64 = 0; i < form.written_types.size(); i++) { types.add(form.written_types.at(i)); }
        argument.lambda_parameter_types = types;    // the error type where none is written: it fits anything
    }
    if(form.has_result == 1) { argument.lambda_result = form.result; }
}

/**
 * The function is chosen: the waiting argument becomes a value of the
 * parameter's type - the lambda is analysed against it, or the function
 * name picks the overload that fits it.
 *
 * @param purpose  what the value is for, for a message: "argument 2 of `apply`"
 */
def finish_waiting_argument(context: analysis_context, argument: call_argument, wanted: resolved_type, purpose: string) : bound_expression {
    value : bound_expression = argument.value;
    if(argument.named != null) { value = function_value_of(context, argument.named!!, wanted); }
    else { value = analyse_lambda_as(context, lambda_node_of(context, argument.node), wanted, 1); }
    return loosely_converted(context, value, wanted, purpose);
}

/**
 * A function value given as an argument: converted to the parameter, or -
 * when only the parameters of the two function types agree - passed with
 * W1029 (conversions/conversion_messages.sharp).
 */
def loosely_converted(context: analysis_context, value: bound_expression, wanted: resolved_type, purpose: string) : bound_expression {
    if(value.type.kind == RT_FUNCTION && !find_conversion(context.session, value.type, wanted, 0).converts()) {
        loose := result_ignored_conversion(value.type, wanted);
        if(loose != null) { return apply_conversion(context, value, loose!!); }
    }
    return convert(context, value, wanted, purpose);
}

/** the N_LAMBDA at `node`, looking through parentheses */
def lambda_node_of(context: analysis_context, node: _int64) : _int64 {
    current : _int64 = node;
    while(current >= 0 && context.tree.kinds!![current] == N_PAREN) { current = context.tree.first_child!![current]; }
    return current;
}

/** is the expression at `node` a lambda (perhaps in parentheses)? */
def is_lambda_at(context: analysis_context, node: _int64) : _int64 {
    current := lambda_node_of(context, node);
    return current >= 0 && context.tree.kinds!![current] == N_LAMBDA;
}
