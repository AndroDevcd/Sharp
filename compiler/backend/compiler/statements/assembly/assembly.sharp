mod backend.compiler.statements.assembly;

import (
    std.io,
    frontend.syntax.tree,
    backend.types.typed_tree,
    backend.types.typed_tree.statements,
    backend.compiler.context
)

/**
 * `asm { }` BLOCKS: instructions of the virtual machine, written by hand
 *
 *      def stop_the_world() {
 *          asm {
 *              .again:                 a label
 *              movi ebx, [count]       a register and a local variable
 *              movi adx, $thread       a class
 *              jne @again              a jump to the label
 *          }
 *      }
 *
 * The parser has already checked each instruction's name and the number and
 * kind of its operands against the instruction table
 * (frontend/syntax/assembly/asm_instructions.sharp). What is left to check
 * is what the operands NAME (asm_operands.sharp) and the labels
 * (asm_labels.sharp):
 *
 *      [name]          a local or parameter, else a field, else a function of the class
 *                      the code is in (its address), else a global - E0920 when none
 *      $type           a class - E0923 when the type is not one
 *      $type[name]     a field or a function of that class - E0923 when it has none
 *      .name:          a label, defined once per block - E0921 when twice
 *      @name           a label of the same block - E0922 when there is none
 *
 * For the flow analysis an `asm` block simply completes: whatever its jumps
 * do stays inside the block (nothing else can name its labels).
 *
 * The files of this package (module `backend.compiler.statements.assembly`):
 *
 *      assembly.sharp          this front door: analyse_asm
 *      asm_labels.sharp        the labels of a block (E0921, E0922)
 *      asm_operands.sharp      the operands: registers, numbers (E0926: wider than 32 bits), and
 *                              the ones that name something (E0920, E0923 - E0925)
 *      asm_globals.sharp       $module#__srt_global[name]: the globals of a module (E0923);
 *                              the address of an overloaded function (W1042)
 *
 *      C++ comparison: compiler/functions/statements/asm_statement.cpp
 *      (`compile_asm_member_address`, `compile_asm_literal`). It creates a
 *      label on its first mention, so a label used and never defined is not
 *      reported there, nor one defined twice: neither has a meaning, so both
 *      are errors here.
 */
def analyse_asm(context: analysis_context, node: _int64) : bound_statement {
    tree : syntax_tree = context.tree;
    block := new bound_asm(context.unit, node);
    collect_labels(context, node, block);

    line : _int64 = tree.first_child!![node];
    while(line >= 0) {
        kind : _int64 = tree.kinds!![line];
        instruction := new bound_asm_instruction(context.unit, line, name_at(context, line));
        if(kind == N_ASM_LABEL) {
            instruction.is_label = 1;
        } else if(kind == N_ASM_INSTRUCTION) {
            operand : _int64 = tree.first_child!![line];
            while(operand >= 0) {
                instruction.operands.add(asm_operand(context, operand, block));
                operand = tree.next_sibling!![operand];
            }
        }
        block.instructions.add(instruction);
        line = tree.next_sibling!![line];
    }
    return block;
}
