mod backend.optimizer.analysis;

import (
    std.io,
    backend.finalizer.ir
)

/**
 * WHERE AN OBJECT COMES FROM, AND WHERE IT GOES  (escape analysis, the small kind)
 *
 * Two questions about one value in one function, both answered by walking
 * the flow graph (control_flow.sharp). Box elimination, native returns, pure
 * function detection, devirtualization and bounds check elimination ask them:
 *
 *      reaching_definitions    BACKWARDS from a read: which instructions can
 *                              have written what the slot holds here?
 *                              (the textbook "reaching definitions", the dragon
 *                              book 9.2.4 - found on demand for one read
 *                              instead of as tables for the whole function)
 *
 *      object_stays_here       FORWARDS from where an object is made: on every
 *                              path, until its slot is written again, is it
 *                              only ever the OBJECT of a field read or write?
 *                              If so no other part of the program can have a
 *                              reference to it: it does not "escape".
 *
 * WHY NOT SIMPLY "THE SLOT IS WRITTEN ONCE". That was the first rule, and it
 * fails where it matters: the inliner hands every body it copies in the same
 * extra slots, and copy coalescing merges slots, so in a function of any size
 * one slot holds many values one after another. The questions are about a
 * VALUE - this one `new_object` - not about a slot.
 *
 * Neither walk follows the edges into `catch` handlers, so both are only for
 * functions without a `try` (the callers see to that).
 *
 *      C++ comparison: what a compiler front end calls use-def and def-use
 *      chains (LLVM keeps them on every value). Here they are worked out when
 *      asked for, for the few values the question is about.
 */

/**
 * Every instruction that can have written what `slot` holds just before
 * instruction `at`, added to `found` (each once). Returns 1 when every path
 * back from `at` meets a write; 0 when one path reaches the start of the
 * function without any - then the slot can also hold what the caller put
 * there (a parameter), or nothing.
 */
def reaching_definitions(code: ir_function, graph: flow_graph, at: _int64, slot: _int64, found: number_list) : _int64 {
    seen := new _int64[graph.blocks + 1];
    waiting := new number_list();           // blocks to look through from their end
    complete : _int64 = definition_in_block(code, graph, graph.block_of[at], at - 1, slot, found, waiting);
    while(waiting.count > 0) {
        block : _int64 = waiting.pop_last();
        if(seen[block] == 1) { continue; }
        seen[block] = 1;
        if(!definition_in_block(code, graph, block, graph.ends[block] - 1, slot, found, waiting)) { complete = 0; }
    }
    return complete;
}

/**
 * Backwards through one block from instruction `from`: the nearest write of
 * `slot` is noted. When the block has none, the blocks that lead into it are
 * added to `waiting`; 0 when there are none to add because this is where the
 * function starts.
 */
def definition_in_block(code: ir_function, graph: flow_graph, block: _int64, from: _int64, slot: _int64,
                        found: number_list, waiting: number_list) : _int64 {
    for(i : _int64 = from; i >= graph.starts[block]; i--) {
        if(slot_written(code.instructions.at(i)) != slot) { continue; }
        known : _int64 = 0;
        for(d : _int64 = 0; d < found.count; d++) { if(found.at(d) == i) { known = 1; } }
        if(known == 0) { found.add(i); }
        return 1;
    }
    if(block == 0) { return 0; }            // the start of the function
    first : _int64 = graph.first_predecessor[block];
    last : _int64 = graph.first_predecessor[block + 1];
    if(first == last) { return 0; }         // (a block nothing leads to: say nothing about it)
    for(k : _int64 = first; k < last; k++) { waiting.add(graph.predecessors[k]); }
    return 1;
}

/**
 * The object written into `slot` by instruction `made_at`: on every path from
 * there, until the slot is written again, is every read of the slot a field
 * read or write with the slot as the OBJECT? With `may_be_returned` = 1 a
 * `return_value` of it is allowed too (native returns: the object leaves, but
 * only to one caller that is known to take nothing but a number out of it).
 *
 * Anything else - stored into a field or an array, passed to a call, copied,
 * compared, locked, thrown - and somebody else may hold a reference: 0.
 *
 * `uses`, when given, collects the instructions that read the object (each
 * once: a block is walked once).
 */
def object_stays_here(code: ir_function, graph: flow_graph, made_at: _int64, slot: _int64, may_be_returned: _int64,
                      uses: number_list?) : _int64 {
    seen := new _int64[graph.blocks + 1];
    waiting := new number_list();           // blocks to look through from their start
    block : _int64 = graph.block_of[made_at];
    from : _int64 = made_at + 1;
    more : _int64 = 1;
    while(more == 1) {
        overwritten : _int64 = 0;
        for(i : _int64 = from; i < graph.ends[block] && overwritten == 0; i++) {
            made := code.instructions.at(i);
            k : _int64 = 0;
            read : _int64 = slot_read(made, 0);
            while(read >= 0) {
                if(read == slot && !(k == 0 && (made.kind == IR_GET_FIELD || made.kind == IR_SET_FIELD))
                   && !(may_be_returned == 1 && made.kind == IR_RETURN_VALUE)) {
                    return 0;
                }
                k++;
                read = slot_read(made, k);
            }
            if(uses != null && reads_slot(made, slot)) { uses!!.add(i); }
            if(slot_written(made) == slot) { overwritten = 1; }
        }
        if(overwritten == 0) {
            for(k : _int64 = 0; k < 2; k++) {
                next : _int64 = graph.successor(block, k);
                if(next >= 0 && seen[next] == 0) { seen[next] = 1; waiting.add(next); }
            }
        }
        if(waiting.count == 0) {
            more = 0;
        } else {
            block = waiting.pop_last();
            from = graph.starts[block];
        }
    }
    return 1;
}

/**
 * Is `slot` written by any instruction that can run after instruction `from`
 * and before `from` runs again? (Then what `from` learned about the slot's
 * value - the length of the array in it, say - may no longer be true later.)
 */
def written_after(code: ir_function, graph: flow_graph, from: _int64, slot: _int64) : _int64 {
    seen := new _int64[graph.blocks + 1];
    waiting := new number_list();
    block : _int64 = graph.block_of[from];
    start : _int64 = from + 1;
    more : _int64 = 1;
    while(more == 1) {
        again : _int64 = 0;                 // the walk came back to `from`: it runs again, the walk ends here
        for(i : _int64 = start; i < graph.ends[block] && again == 0; i++) {
            if(i == from) { again = 1; }
            else if(slot_written(code.instructions.at(i)) == slot) { return 1; }
        }
        if(again == 0) {
            for(k : _int64 = 0; k < 2; k++) {
                next : _int64 = graph.successor(block, k);
                if(next >= 0 && seen[next] == 0) { seen[next] = 1; waiting.add(next); }
            }
        }
        if(waiting.count == 0) {
            more = 0;
        } else {
            block = waiting.pop_last();
            start = graph.starts[block];
        }
    }
    return 0;
}
