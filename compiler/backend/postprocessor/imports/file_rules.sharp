mod backend.postprocessor.imports;

import (
    std.io,
    frontend.lexer,
    frontend.syntax.tree,
    frontend.diagnostics,
    backend.types.program,
    backend.types.declarations,
    backend.types.type_system
)

/**
 * THE `mod` LINE OF A FILE
 * (the C++ compiler: "module declaration must be first in every file" and
 * "file module cannot be declared more than once", in class_preprocessor.cpp)
 *
 *      mod shop.orders;        first in the file, once
 *
 *      import ( std.io )
 *      class order { }
 *
 * Every declaration of a file belongs to the module its `mod` line names.
 * The parser reads a `mod` line wherever it stands, so that these two
 * mistakes get a proper message here instead of a syntax error:
 *
 *      E0390   the `mod` line is not the first thing in the file - or the file has none
 *      E0391   a second `mod` line
 */
def check_file_rules(prog: sharp_program, problems: list<diagnostic>) {
    for(i : _int64 = 0; i < prog.files.size(); i++) {
        check_module_line(prog.files.at(i), problems);
    }
}

/** E0390 / E0391 for one file */
def check_module_line(file: sharp_file, problems: list<diagnostic>) {
    unit := file.unit;
    tree : syntax_tree = unit.parsed!!.tree;

    first : _int64 = tree.first_child!![0];
    if(first < 0) { return; }       // an empty file declares nothing

    first_module : _int64 = tree.child_of_kind(0, N_MODULE);
    if(tree.kinds!![first] != N_MODULE) {
        if(first_module >= 0) {
            problems.add(error_at_node("E0390", "the `mod` line must be the first thing in the file", unit, first_module)
                .with_label("move this line to the top")
                .with_related_place(place_of_node(unit, first, "this comes before it"))
                .with_note("the module is what everything in the file belongs to, so it is said before anything is declared or imported"));
        } else {
            problems.add(error_at_node("E0390", "this file does not say which module it belongs to", unit, first)
                .with_label("a `mod` line must come before this")
                .with_note("every file starts with the module its declarations belong to; files with the same `mod` line form one module")
                .with_help("add as the first line:  mod main;   (or the name of the module this file is part of)"));
        }
    }

    // a second one
    seen : _int64 = 0;
    child : _int64 = first;
    while(child >= 0) {
        if(tree.kinds!![child] == N_MODULE) {
            if(seen == 1) {
                problems.add(error_at_node("E0391", "a file can only have one `mod` line", unit, child)
                    .with_label("a second `mod`")
                    .with_related_place(place_of_node(unit, first_module, "the file is in module `" + file.module.name + "`, said here"))
                    .with_note("one file belongs to one module")
                    .with_help("remove this line, or move what follows it into a file of its own"));
                break;
            }
            seen = 1;
        }
        child = tree.next_sibling!![child];
    }
}
