mod main;

import (
    std.io,
    platform,
    configuration,
    frontend.diagnostics
)

/*
 * WHICH FILES ARE COMPILED: the files named, and the Sharp files below a folder.
 *
 * Two options hand the compiler a FOLDER instead of files:
 *
 *      sharpc main.sharp -L /usr/include/sharp/0.4.0      a library: every .sharp file in it
 *      sharpc -p my_project                               a project: every .sharp file in it
 *
 * and "in it" means in the folder and in every folder below it, at any
 * depth (the standard library is std/..., std/io/..., platform/kernel/...).
 *
 * How the files are found: ONE call of the runtime, `file_natives.tree_files`
 * (interrupt 0x2a), which reads the whole tree and gives back the path of
 * every regular file. It leaves out every name that starts with a dot - a
 * file or a whole folder - so `.git`, `.idea` and a `.cache` folder are never
 * taken for source. The runtime gives the paths in the order the disk has
 * them, which differs from machine to machine, so they are sorted here: the
 * files reach the compiler in the same order on every compile, and the
 * compiler writes the same executable every time.
 *
 * Why not `file.walk()`: it lists each folder by running a command (`ls`)
 * whose output goes to a temporary file, named after the clock and a counter.
 * Two compilers started in the same millisecond pick the SAME temporary name
 * and read each other's listing: with 8 compiles started at once, 18 of 48
 * stopped with "file `.../std/data/csv/critical_section.sharp` doesnt exist!"
 * (a name from one folder under the path of another) and others silently
 * compiled with library files missing. A build tool starts compilers side by
 * side, so the compiler must not depend on that. It also cost one process per
 * folder (43 for the standard library) on every compile.
 *
 *      C++ comparison: File::list (runtime/interrupts/native/file_system.cpp, get_file_list):
 *      opendir / readdir, down into every folder, names starting with '.'
 *      skipped - the same call the runtime makes for 0x2a - and then
 *      `File::endswith(".sharp", file)` (settings_processor.cpp,
 *      validate_and_add_source_files). The C++ compiler does not sort.
 *
 * In this file:
 *      sharp_files_below, path_order   the .sharp files below a folder, sorted
 *      add_project_files               -p / -P: the files of a project
 *      add_library_files               the installed standard library and every -L folder
 *      check_source_files              every file is there, is a .sharp FILE (not a folder),
 *                                      is named once; a missing one gets did-you-mean
 *      check_output_is_not_a_source    -o must not name a file that is being compiled
 *      remove_ignored_files            -ignore, -ignoredir
 */

/**
 * The path of every `.sharp` file below `folder`, at any depth, sorted by
 * character code. Empty when the folder has none.
 *
 * Throws io_exception when `folder` is not a folder that exists, so the
 * caller can say which option named it.
 */
def sharp_files_below(folder: string) : list<string> {
    found := new list<string>();

    directory := new file(folder);
    if(!directory.is_directory())
        throw new io_exception("not a directory: " + folder);

    paths := file_natives.tree_files(directory.absolute_path());
    // (`paths == null` would call the == operator of string on an array of strings)
    paths_object : object = paths;
    if(paths_object == null)
        return found;       // a folder without files

    foreach(path in paths) {
        if(path.ends_with(".sharp"))
            found.add(path);
    }

    found.sort({ a: string, b: string -> (decimal) return path_order(a, b); });
    return found;
}

/**
 * The order of two paths: negative when `a` comes first, 0 when they are the
 * same text, positive when `b` comes first. By character code, character by
 * character; a path that is the beginning of another comes before it.
 */
def path_order(a: string, b: string) : decimal {
    a_size : _int64 = sizeof(a.data);
    b_size : _int64 = sizeof(b.data);

    for(i : _int64 = 0; i < a_size && i < b_size; i++) {
        if(a.data[i] != b.data[i])
            return a.data[i] - b.data[i];
    }
    return a_size - b_size;
}

/**
 * -p / -P <folder>: every .sharp file of the project joins the sources, in
 * whatever folder of the project it is. Without a folder named, the project
 * is the folder the compiler was started in.
 */
def add_project_files(files: list<string>) {
    if(options.project_dir == "") {
        options.project_dir = file.current_directory();
    }

    proj_dir := new file(options.project_dir);
    try {
       foreach(found in sharp_files_below(proj_dir.absolute_path())) {
           if(!contains(files, found)) { files.add(found); }
       }
    } catch(io_exception) {
        /* support files not found */
        error("could not access project directory files in: $proj_dir");
    }
}

/**
 * Every file that is to be compiled must be there and be a `.sharp` file; a
 * file that is not stops the compiler (`error`). A FOLDER whose name ends in
 * `.sharp` is refused like a missing file (reading it as source made both
 * compilers loop for ever, using more and more memory). The paths become
 * absolute - messages, the build cache and the executable's debug
 * information all name a file the same way wherever the compiler was
 * started - and a file that was named twice is compiled once.
 */
def check_source_files(files: list<string>) {
    for(i := 0; i < files.size(); i++) {
        fp := new file(files[i]);

        if(!(fp.exists()))
            report_missing_source(files.at(i));

        if(fp.is_directory())
            error_with_help("`${files.at(i)}` is a folder, not a source file",
                            "the .sharp files of a folder are compiled with `-L ${files.at(i)}` (a library) or `-P <project folder>` (a project)");

        if(!files[i].ends_with(".sharp"))
            error_with_help("file `${files.at(i)}` is not a Sharp file: its name does not end in .sharp",
                            "a source file of this compiler is named `<name>.sharp`");
        files[i] = fp.absolute_path();
    }

    // remove duplicate files
    for(i := 0; i < files.size(); i++) {

        if(count(files, files[i]) > 1) {
           files.remove_at(i); i--;
        }
    }
}

/**
 * A source file that is not there: the error, with the nearest names of the
 * .sharp files in the folder it was looked for in (`main.sharp` for
 * `mian.sharp`). Only the files directly in that folder are offered, and a
 * folder with very many files below it is not searched (the listing reads
 * the whole tree below it).
 */
def report_missing_source(written: string) {
    folder : string = ".";
    parent : string = std.io#path.parent(written);
    if(sizeof(parent.data) > 0) { folder = parent; }
    hint : string = "";
    try {
        listed := new file(folder);
        if(listed.is_directory()) {
            names := new list<string>();
            paths := file_natives.tree_files(listed.absolute_path());
            paths_object : object = paths;
            if(paths_object != null && sizeof(paths) < 20000) {
                listed_folder : string = listed.absolute_path();
                foreach(path in paths) {
                    if(!path.ends_with(".sharp")) { continue; }
                    if(std.io#path.parent(path) != listed_folder) { continue; }
                    names.add(new file(path).name());
                }
            }
            own_name : string = new file(written).name();
            hint = did_you_mean(closest_names(own_name, names, 3));
        }
    } catch(e: throwable) {
        hint = "";      // the folder cannot be listed: the message without suggestions
    }
    if(sizeof(hint.data) > 0)
        error_with_help("file `$written` does not exist", hint);
    error("file `$written` does not exist");
}

/**
 * `-o` naming one of the files being compiled (`sharpc app.sharp -o app.sharp`)
 * would overwrite that source with the executable, and the source is gone.
 * Refused before anything is compiled, as gcc refuses it ("input file is the
 * same as output file"). The paths are compared absolute, so `./app.sharp`
 * and `app.sharp` are the same file. (The C++ compiler overwrites the source.)
 */
def check_output_is_not_a_source(files: list<string>, output: string) {
    written := new file(output);
    output_absolute : string = written.absolute_path();
    foreach(source in files) {
        if(source == output_absolute) {
            error_with_help("the output file `$output` is one of the source files being compiled: writing it would overwrite that source",
                            "give the executable another name: `-o " + name_without_sharp(output) + "`");
        }
    }
}

/** "app.sharp" -> "app" (for the help of check_output_is_not_a_source) */
def name_without_sharp(path: string) : string {
    if(!path.ends_with(".sharp")) { return path + ".out"; }
    kept := new string_builder("");
    characters : _int8[] = path.data!!;
    for(i : _int64 = 0; i < sizeof(characters) - 6; i++) { kept.append(characters[i]); }
    return kept.build();
}

/**
 * The library files join the sources: the standard library of the version
 * asked for, when it is installed on this machine (/usr/include/sharp/<version>,
 * on Windows C:\Program Files\Sharp\include\<version>), then every folder
 * `-L` (or "extern_lib" in settings.json) named.
 *
 *      C++ comparison: process_library_files (settings_processor.cpp). A
 *      folder that is not there adds nothing and is not an error there either:
 *      a machine without an installed library passes it with -L.
 */
def add_library_files(version_num: string) {
    is_supported := false;
    foreach(vers in supported_versions) {
       if(version_num == vers) {
          is_supported = true;
       }
    }

    if(!is_supported) {
        err_msg : string = "Library api version: $version_num is not supported! Supported versions are: {";
        foreach(vers in supported_versions) {
           err_msg += " $vers";
        }
        err_msg += " }";
        error(err_msg);
    }

    files := options.source_files;
    path : string = "";
    if(build.is_windows()) {
        path = "C:\\Program Files\\Sharp\\include\\$version_num";
    } else {
        path = "/usr/include/sharp/$version_num";
    }

    installed := new file(path);
    if(installed.is_directory()) {
        try {
            foreach(found in sharp_files_below(path)) {
                if(!contains(files, found)) { files.add(found); }
            }
        } catch(io_exception) {
            warning("could not access the installed library in path `$path`");
        }
    }

    // -L <folder>: every .sharp file in the folder AND in the folders below it, as the C++
    // compiler takes a library (the standard library is std/..., platform/...), sorted, so
    // the files come in the same order on every compile (source_folders.sharp says how they
    // are found, and why not with file.walk()).
    settle_standard_library();          // (the one standard library first; a second one is refused: settings.sharp)
    for(i := 0; i < options.libraries.size(); i++) {
        library_folder := options.libraries.at(i);

        try {
            foreach(found in sharp_files_below(library_folder)) {
                if(!contains(files, found)) { files.add(found); }
            }
        } catch(io_exception) {
            /* support files not found */
            warning("could not access library files in path `$library_folder`");
        }

    }
}

def count(files: list<string>, file: string) : decimal {
    amount := 0;
    foreach(f in files) {
        if(f == file)
            amount++;
    }

    return amount.value;
}

def in_ignored_folder(fullpath: string) : decimal {
   foreach(path in options.ignored_directories) {
      if(fullpath.starts_with(path))
        return true;
   }

   return false;
}

def is_ignored_file(fullpath: string) : decimal {
   foreach(path in options.ignored_files) {
      if(fullpath == path)
        return true;
   }

   return false;
}

/**
 * -ignore / -ignoredir: the files named, and every file below a folder named,
 * leave the build. Each is remembered (left_out_modules.sharp): when the
 * program then imports a module only they declare, the message can say so.
 */
def remove_ignored_files(files: list<string>) {
    for(i := 0; i < files.size(); i++) {
      if(in_ignored_folder(files[i]) || is_ignored_file(files[i])) {
         note_file_left_out(files[i]);
         files.remove_at(i); i--;
      }
    }
}
